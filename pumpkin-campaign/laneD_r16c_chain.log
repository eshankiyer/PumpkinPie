   356	   private Vec3 calculateSlopeSpeed(final Vec3 deltaMovement, final RailShape shape) {
   357	      double slideSpeed = Math.max(0.0078125, deltaMovement.horizontalDistance() * 0.02);
   358	      if (this.minecart.isInWater()) {
   359	         slideSpeed *= 0.2;
   360	      }
   361	      return switch (shape) {
   362	         case ASCENDING_EAST -> deltaMovement.add(-slideSpeed, 0.0, 0.0);
   363	         case ASCENDING_WEST -> deltaMovement.add(slideSpeed, 0.0, 0.0);
   364	         case ASCENDING_NORTH -> deltaMovement.add(0.0, 0.0, slideSpeed);
   365	         case ASCENDING_SOUTH -> deltaMovement.add(0.0, 0.0, -slideSpeed);
   366	         default -> deltaMovement;
   367	      };
   368	   }

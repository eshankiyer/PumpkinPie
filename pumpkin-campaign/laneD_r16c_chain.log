    94	fn random_sequence_seed(world_seed: u64, key: &str) -> (u64, u64) {
    95	    // `RandomSequences.createSequence` upgrades the world seed, xors the key hash, and mixes
    96	    // the result before constructing the Xoroshiro source (`RandomSequences.java:50-58`;
    97	    // `RandomSequence.java:29-40`).
    98	    let low = world_seed ^ 0x6a09_e667_f3bc_c909u64;
    99	    let high = low.wrapping_add((-7_046_029_254_386_353_131i64) as u64);
   100	    let hash = md5::compute(key.as_bytes());
   101	    let key_low = u64::from_be_bytes(hash[0..8].try_into().unwrap_or([0; 8]));
   102	    let key_high = u64::from_be_bytes(hash[8..16].try_into().unwrap_or([0; 8]));
   103	    (low ^ key_low, high ^ key_high)
   104	}

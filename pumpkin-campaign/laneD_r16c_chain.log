   218	
   219	    pub(super) fn is_room_id(&self, x: i32, y: i32, floor: usize, room_id: i32) -> bool {
   220	        self.floor_rooms[floor].get(x, y) & ROOM_ID_MASK == room_id
   221	    }
   222	
   223	    pub(super) fn room_direction(
   224	        &self,
   225	        x: i32,
   226	        y: i32,
   227	        floor: usize,
   228	        room_id: i32,
   229	    ) -> Option<Direction> {
   230	        Direction::HORIZONTAL.into_iter().find(|direction| {
   231	            self.is_room_id(
   232	                x + direction.step_x(),
   233	                y + direction.step_z(),

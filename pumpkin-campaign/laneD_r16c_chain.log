   194	    pub async fn damage_with_context(&self, amount: f32, source: Option<&dyn EntityBase>) -> bool {
   195	        if !self.entity.is_alive() {
   196	            return true;
   197	        }
   198	
   199	        let attacker_id = source.map(|s| s.get_entity().entity_id);
   200	        let mut damage_event =
   201	            crate::plugin::api::events::vehicle::vehicle_damage::VehicleDamageEvent::new(
   202	                self.entity.entity_id,
   203	                amount,
   204	                attacker_id,
   205	            );
   206	        if let Some(server) = self.entity.world.load().server.upgrade() {
   207	            server.plugin_manager.fire(&server, &mut damage_event).await;
   208	        }
   209	        if damage_event.cancelled {
   210	            return false;
   211	        }
   212	
   213	        let new_strength = self.apply_damage_wobble(amount);
   214	
   215	        let is_creative = source
   216	            .and_then(|s| s.get_player())
   217	            .is_some_and(|p| p.gamemode.load() == GameMode::Creative);
   218	
   219	        if is_creative || new_strength > 40.0 {
   220	            let mut destroy_event =
   221	                crate::plugin::api::events::vehicle::vehicle_destroy::VehicleDestroyEvent::new(
   222	                    self.entity.entity_id,
   223	                    attacker_id,
   224	                );
   225	            if let Some(server) = self.entity.world.load().server.upgrade() {
   226	                server
   227	                    .plugin_manager
   228	                    .fire(&server, &mut destroy_event)
   229	                    .await;
   230	            }
   231	            if destroy_event.cancelled {
   232	                return false;
   233	            }
   234	
   235	            if is_creative {
   236	                self.entity.remove().await;
   237	            } else {
   238	                self.kill_and_drop_self().await;
   239	            }
   240	        }
   241	
   242	        true
   243	    }
   244	
   245	    /// Applies the standard minecart damage wobble without destroying the vehicle.
   246	    /// TNT minecarts use this before deciding whether damage primes or breaks them.
   247	    pub fn apply_damage_wobble(&self, amount: f32) -> f32 {
   248	        let current_side = self.get_hurt_dir();
   249	        self.set_hurt_dir(-current_side);
   250	        self.set_hurt_time(10);
   251	        // `VehicleEntity.hurtServer` calls `Entity.markHurt` after updating the wobble fields
   252	        // (`VehicleEntity.java:42-49`).
   253	        self.entity.mark_hurt();
   254	
   255	        let current_strength = self.get_damage();
   256	        let new_strength = current_strength + amount * 10.0;
   257	        self.set_damage(new_strength);
   258	
   259	        self.send_wobble_metadata();
   260	        new_strength
   261	    }
   262	}

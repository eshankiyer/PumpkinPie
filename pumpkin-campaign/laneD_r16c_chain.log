   510	    #[expect(clippy::too_many_arguments)]
   511	    fn traverse_outer_walls(
   512	        &mut self,
   513	        data: &mut PlacementData,
   514	        grid: &SimpleGrid,
   515	        mut direction: Direction,
   516	        start_x: i32,
   517	        start_y: i32,
   518	        end_x: i32,
   519	        end_y: i32,
   520	    ) {
   521	        let (mut grid_x, mut grid_y) = (start_x, start_y);
   522	        let start_direction = direction;
   523	        loop {
   524	            if !MansionGrid::is_house(
   525	                grid,
   526	                grid_x + direction.step_x(),
   527	                grid_y + direction.step_z(),
   528	            ) {
   529	                self.traverse_turn(data);
   530	                direction = direction.clockwise();
   531	                if grid_x != end_x || grid_y != end_y || start_direction != direction {
   532	                    self.traverse_wall_piece(data);
   533	                }
   534	            } else if MansionGrid::is_house(
   535	                grid,
   536	                grid_x + direction.step_x() + direction.counterclockwise().step_x(),
   537	                grid_y + direction.step_z() + direction.counterclockwise().step_z(),
   538	            ) {
   539	                Self::traverse_inner_turn(data);
   540	                grid_x += direction.step_x();
   541	                grid_y += direction.step_z();
   542	                direction = direction.counterclockwise();
   543	            } else {
   544	                grid_x += direction.step_x();
   545	                grid_y += direction.step_z();
   546	                if grid_x != end_x || grid_y != end_y || start_direction != direction {
   547	                    self.traverse_wall_piece(data);
   548	                }
   549	            }
   550	            if grid_x == end_x && grid_y == end_y && start_direction == direction {
   551	                break;
   552	            }
   553	        }
   554	    }

  1351	/// Generates a list of items from a `ChestLootTable` using a deterministic seed.
  1352	#[must_use]
  1353	pub fn generate_chest_loot(
  1354	    table: &pumpkin_util::chest_loot_table::ChestLootTable,
  1355	    seed: i64,
  1356	) -> Vec<ItemStack> {
  1357	    use pumpkin_util::random::RandomImpl;
  1358	
  1359	    let mut rng = Xoroshiro::from_seed(seed as u64);
  1360	    let mut items_to_place: Vec<ItemStack> = Vec::new();
  1361	
  1362	    for pool in table.pools {
  1363	        let range = pool.max_rolls - pool.min_rolls;
  1364	        let rolls = pool.min_rolls
  1365	            + if range > 0 {
  1366	                rng.next_bounded_i32(range + 1)
  1367	            } else {
  1368	                0
  1369	            };
  1370	
  1371	        for _ in 0..rolls {
  1372	            let entry_weight: i32 = pool.entries.iter().map(|e| e.weight).sum();
  1373	            let total_weight = entry_weight + pool.empty_weight;
  1374	            if total_weight == 0 {
  1375	                continue;
  1376	            }
  1377	
  1378	            let mut pick = rng.next_bounded_i32(total_weight);
  1379	
  1380	            // Subtract empty weight first (if the pick lands here, it yields nothing).
  1381	            pick -= pool.empty_weight;
  1382	            if pick < 0 {
  1383	                continue;
  1384	            }
  1385	
  1386	            for entry in pool.entries {
  1387	                pick -= entry.weight;
  1388	                if pick < 0 {
  1389	                    let count_range = entry.max_count - entry.min_count;
  1390	                    let count = entry.min_count
  1391	                        + if count_range > 0 {
  1392	                            rng.next_bounded_i32(count_range + 1)
  1393	                        } else {
  1394	                            0
  1395	                        };
  1396	
  1397	                    // Strip "minecraft:" prefix because from_registry_key uses short keys.
  1398	                    let item_key = entry.item.strip_prefix("minecraft:").unwrap_or(entry.item);
  1399	
  1400	                    if let Some(item) = Item::from_registry_key(item_key) {
  1401	                        let mut stack = ItemStack::new(count as u8, item);
  1402	                        if let Some(options) = entry.enchant_randomly {
  1403	                            apply_enchant_randomly(&mut stack, options, &mut rng);
  1404	                        }
  1405	                        items_to_place.push(stack);
  1406	                    }
  1407	                    break;
  1408	                }
  1409	            }
  1410	        }
  1411	    }
  1412	
  1413	    items_to_place

   236	            )
   237	        })
   238	    }
   239	
   240	    fn recursive_corridor(
   241	        random: &mut RandomGenerator,
   242	        grid: &mut SimpleGrid,
   243	        x: i32,
   244	        y: i32,
   245	        heading: Direction,
   246	        depth: i32,
   247	    ) {
   248	        if depth <= 0 {
   249	            return;
   250	        }
   251	        grid.set(x, y, CORRIDOR);
   252	        grid.set_if(x + heading.step_x(), y + heading.step_z(), 0, CORRIDOR);
   253	        for _ in 0..8 {
   254	            let next = Direction::from_2d_index(random.next_bounded_i32(4));
   255	            if next == heading.opposite() || (next == Direction::East && random.next_bool()) {
   256	                continue;
   257	            }
   258	            let next_x = x + heading.step_x();
   259	            let next_y = y + heading.step_z();
   260	            if grid.get(next_x + next.step_x(), next_y + next.step_z()) != 0
   261	                || grid.get(next_x + next.step_x() * 2, next_y + next.step_z() * 2) != 0
   262	            {
   263	                continue;
   264	            }
   265	            Self::recursive_corridor(
   266	                random,
   267	                grid,
   268	                next_x + next.step_x(),
   269	                next_y + next.step_z(),
   270	                next,
   271	                depth - 1,
   272	            );
   273	            break;
   274	        }
   275	
   276	        let clockwise = heading.clockwise();
   277	        let counterclockwise = heading.counterclockwise();
   278	        for (offset_x, offset_y) in [
   279	            (clockwise.step_x(), clockwise.step_z()),
   280	            (counterclockwise.step_x(), counterclockwise.step_z()),
   281	            (
   282	                heading.step_x() + clockwise.step_x(),
   283	                heading.step_z() + clockwise.step_z(),
   284	            ),
   285	            (
   286	                heading.step_x() + counterclockwise.step_x(),
   287	                heading.step_z() + counterclockwise.step_z(),
   288	            ),
   289	            (heading.step_x() * 2, heading.step_z() * 2),
   290	            (clockwise.step_x() * 2, clockwise.step_z() * 2),
   291	            (counterclockwise.step_x() * 2, counterclockwise.step_z() * 2),
   292	        ] {
   293	            grid.set_if(x + offset_x, y + offset_y, 0, ROOM);
   294	        }
   295	    }
   296	
   297	    fn clean_edges(grid: &mut SimpleGrid) -> bool {
   298	        let mut touched = false;
   299	        for y in 0..grid.height() {
   300	            for x in 0..grid.width() {
   301	                if grid.get(x, y) != 0 {
   302	                    continue;
   303	                }
   304	                let direct_neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
   305	                    .into_iter()
   306	                    .filter(|&(x, y)| Self::is_house(grid, x, y))
   307	                    .count();
   308	                if direct_neighbors >= 3 {
   309	                    grid.set(x, y, ROOM);
   310	                    touched = true;
   311	                } else if direct_neighbors == 2 {
   312	                    let diagonal_neighbors = [
   313	                        (x + 1, y + 1),
   314	                        (x - 1, y + 1),
   315	                        (x + 1, y - 1),
   316	                        (x - 1, y - 1),
   317	                    ]
   318	                    .into_iter()
   319	                    .filter(|&(x, y)| Self::is_house(grid, x, y))
   320	                    .count();
   321	                    if diagonal_neighbors <= 1 {
   322	                        grid.set(x, y, ROOM);
   323	                        touched = true;
   324	                    }
   325	                }
   326	            }
   327	        }
   328	        touched
   329	    }
   330	
   331	    fn setup_third_floor(&mut self, random: &mut RandomGenerator) {
   332	        let mut potential_rooms = Vec::new();
   333	        for y in 0..self.third_floor.height() {
   334	            for x in 0..self.third_floor.width() {
   335	                let room_data = self.floor_rooms[1].get(x, y);
   336	                if room_data & ROOM_TYPE_MASK == ROOM_1X2
   337	                    && room_data & ROOM_DOOR_FLAG == ROOM_DOOR_FLAG
   338	                {
   339	                    potential_rooms.push((x, y));
   340	                }
   341	            }
   342	        }
   343	        if potential_rooms.is_empty() {
   344	            self.third_floor.set_rect(0, 0, 11, 11, BLOCKED);
   345	            return;
   346	        }
   347	
   348	        let (room_x, room_y) =
   349	            potential_rooms[random.next_bounded_i32(potential_rooms.len() as i32) as usize];
   350	        let room_data = self.floor_rooms[1].get(room_x, room_y);
   351	        self.floor_rooms[1].set(room_x, room_y, room_data | ROOM_STAIRS_FLAG);
   352	        let Some(room_direction) = self.room_direction(room_x, room_y, 1, room_data & ROOM_ID_MASK)
   353	        else {
   354	            self.third_floor.set_rect(0, 0, 11, 11, BLOCKED);
   355	            self.floor_rooms[1].set(room_x, room_y, room_data);
   356	            return;
   357	        };
   358	        let room_end_x = room_x + room_direction.step_x();
   359	        let room_end_y = room_y + room_direction.step_z();
   360	
   361	        for y in 0..self.third_floor.height() {
   362	            for x in 0..self.third_floor.width() {
   363	                if !Self::is_house(&self.base, x, y) {
   364	                    self.third_floor.set(x, y, BLOCKED);
   365	                } else if x == room_x && y == room_y {
   366	                    self.third_floor.set(x, y, START_ROOM);
   367	                } else if x == room_end_x && y == room_end_y {
   368	                    self.third_floor.set(x, y, START_ROOM);
   369	                    self.floor_rooms[2].set(x, y, ROOM_CORRIDOR_FLAG);
   370	                }
   371	            }
   372	        }
   373	
   374	        let potential_corridors = Direction::HORIZONTAL
   375	            .into_iter()
   376	            .filter(|direction| {
   377	                self.third_floor.get(
   378	                    room_end_x + direction.step_x(),
   379	                    room_end_y + direction.step_z(),
   380	                ) == 0
   381	            })
   382	            .collect::<Vec<_>>();
   383	        if potential_corridors.is_empty() {
   384	            self.third_floor.set_rect(0, 0, 11, 11, BLOCKED);
   385	            self.floor_rooms[1].set(room_x, room_y, room_data);
   386	            return;
   387	        }
   388	        let direction =
   389	            potential_corridors[random.next_bounded_i32(potential_corridors.len() as i32) as usize];
   390	        Self::recursive_corridor(
   391	            random,
   392	            &mut self.third_floor,
   393	            room_end_x + direction.step_x(),
   394	            room_end_y + direction.step_z(),
   395	            direction,
   396	            4,
   397	        );
   398	        while Self::clean_edges(&mut self.third_floor) {}
   399	    }
   400	
   401	    fn identify_rooms(
   402	        random: &mut RandomGenerator,
   403	        from_grid: &SimpleGrid,
   404	        room_grid: &mut SimpleGrid,
   405	    ) {
   406	        let mut room_positions = Vec::new();
   407	        for y in 0..from_grid.height() {
   408	            for x in 0..from_grid.width() {
   409	                if from_grid.get(x, y) == ROOM {
   410	                    room_positions.push((x, y));
   411	                }
   412	            }
   413	        }
   414	        for index in (1..room_positions.len()).rev() {
   415	            let swap = random.next_bounded_i32((index + 1) as i32) as usize;
   416	            room_positions.swap(index, swap);
   417	        }
   418	
   419	        let mut room_id = 10;
   420	        for (x, y) in room_positions {
   421	            if room_grid.get(x, y) != 0 {
   422	                continue;
   423	            }
   424	            let (mut x0, mut x1, mut y0, mut y1) = (x, x, y, y);
   425	            let mut room_type = ROOM_1X1;
   426	            if room_grid.get(x + 1, y) == 0
   427	                && room_grid.get(x, y + 1) == 0
   428	                && room_grid.get(x + 1, y + 1) == 0
   429	                && from_grid.get(x + 1, y) == ROOM
   430	                && from_grid.get(x, y + 1) == ROOM
   431	                && from_grid.get(x + 1, y + 1) == ROOM
   432	            {
   433	                x1 += 1;
   434	                y1 += 1;
   435	                room_type = ROOM_2X2;
   436	            } else if room_grid.get(x - 1, y) == 0
   437	                && room_grid.get(x, y + 1) == 0
   438	                && room_grid.get(x - 1, y + 1) == 0
   439	                && from_grid.get(x - 1, y) == ROOM
   440	                && from_grid.get(x, y + 1) == ROOM
   441	                && from_grid.get(x - 1, y + 1) == ROOM
   442	            {
   443	                x0 -= 1;
   444	                y1 += 1;
   445	                room_type = ROOM_2X2;
   446	            } else if room_grid.get(x - 1, y) == 0
   447	                && room_grid.get(x, y - 1) == 0
   448	                && room_grid.get(x - 1, y - 1) == 0
   449	                && from_grid.get(x - 1, y) == ROOM
   450	                && from_grid.get(x, y - 1) == ROOM
   451	                && from_grid.get(x - 1, y - 1) == ROOM
   452	            {
   453	                x0 -= 1;
   454	                y0 -= 1;
   455	                room_type = ROOM_2X2;
   456	            } else if room_grid.get(x + 1, y) == 0 && from_grid.get(x + 1, y) == ROOM {
   457	                x1 += 1;
   458	                room_type = ROOM_1X2;
   459	            } else if room_grid.get(x, y + 1) == 0 && from_grid.get(x, y + 1) == ROOM {
   460	                y1 += 1;
   461	                room_type = ROOM_1X2;
   462	            } else if room_grid.get(x - 1, y) == 0 && from_grid.get(x - 1, y) == ROOM {
   463	                x0 -= 1;
   464	                room_type = ROOM_1X2;
   465	            } else if room_grid.get(x, y - 1) == 0 && from_grid.get(x, y - 1) == ROOM {
   466	                y0 -= 1;
   467	                room_type = ROOM_1X2;
   468	            }
   469	
   470	            let mut door_x = if random.next_bool() { x0 } else { x1 };
   471	            let mut door_y = if random.next_bool() { y0 } else { y1 };
   472	            let mut door_flag = ROOM_DOOR_FLAG;
   473	            if !from_grid.edges_to(door_x, door_y, CORRIDOR) {
   474	                door_x = if door_x == x0 { x1 } else { x0 };
   475	                door_y = if door_y == y0 { y1 } else { y0 };
   476	                if !from_grid.edges_to(door_x, door_y, CORRIDOR) {
   477	                    door_y = if door_y == y0 { y1 } else { y0 };
   478	                    if !from_grid.edges_to(door_x, door_y, CORRIDOR) {
   479	                        door_x = if door_x == x0 { x1 } else { x0 };
   480	                        door_y = if door_y == y0 { y1 } else { y0 };
   481	                        if !from_grid.edges_to(door_x, door_y, CORRIDOR) {
   482	                            door_flag = 0;
   483	                            door_x = x0;
   484	                            door_y = y0;
   485	                        }
   486	                    }
   487	                }
   488	            }
   489	
   490	            for room_y in y0..=y1 {
   491	                for room_x in x0..=x1 {
   492	                    let flags = if room_x == door_x && room_y == door_y {
   493	                        ROOM_ORIGIN_FLAG | door_flag
   494	                    } else {
   495	                        0
   496	                    };
   497	                    room_grid.set(room_x, room_y, flags | room_type | room_id);
   498	                }
   499	            }
   500	            room_id += 1;
   501	        }
   502	    }
   503	}

   108	#[derive(Clone, Copy, Debug, Eq, PartialEq)]
   109	enum Direction {
   110	    North,
   111	    South,
   112	    West,
   113	    East,
   114	    Up,
   115	}
   116	
   117	impl Direction {
   118	    const HORIZONTAL: [Self; 4] = [Self::North, Self::East, Self::South, Self::West];
   119	
   120	    const fn from_2d_index(index: i32) -> Self {
   121	        [Self::South, Self::West, Self::North, Self::East][index as usize]
   122	    }
   123	
   124	    fn from_name(name: &str) -> Option<Self> {
   125	        match name {
   126	            "north" => Some(Self::North),
   127	            "south" => Some(Self::South),
   128	            "west" => Some(Self::West),
   129	            "east" => Some(Self::East),
   130	            "up" => Some(Self::Up),
   131	            _ => None,
   132	        }
   133	    }
   134	
   135	    const fn step_x(self) -> i32 {
   136	        match self {
   137	            Self::West => -1,
   138	            Self::East => 1,
   139	            _ => 0,
   140	        }
   141	    }
   142	
   143	    const fn step_z(self) -> i32 {
   144	        match self {
   145	            Self::North => -1,
   146	            Self::South => 1,
   147	            _ => 0,
   148	        }
   149	    }
   150	
   151	    const fn name(self) -> &'static str {
   152	        match self {
   153	            Self::North => "north",
   154	            Self::South => "south",
   155	            Self::West => "west",
   156	            Self::East => "east",
   157	            Self::Up => "up",
   158	        }
   159	    }
   160	
   161	    const fn clockwise(self) -> Self {
   162	        match self {
   163	            Self::North => Self::East,
   164	            Self::East => Self::South,
   165	            Self::South => Self::West,
   166	            Self::West => Self::North,
   167	            Self::Up => Self::Up,
   168	        }
   169	    }
   170	
   171	    const fn counterclockwise(self) -> Self {
   172	        match self {
   173	            Self::North => Self::West,
   174	            Self::West => Self::South,
   175	            Self::South => Self::East,
   176	            Self::East => Self::North,
   177	            Self::Up => Self::Up,
   178	        }
   179	    }
   180	
   181	    const fn opposite(self) -> Self {
   182	        match self {
   183	            Self::North => Self::South,
   184	            Self::South => Self::North,
   185	            Self::West => Self::East,
   186	            Self::East => Self::West,
   187	            Self::Up => Self::Up,
   188	        }
   189	    }
   190	
   191	    const fn rotate(self, rotation: Rotation) -> Self {
   192	        match rotation {
   193	            Rotation::None => self,
   194	            Rotation::Clockwise90 => self.clockwise(),
   195	            Rotation::Rotate180 => self.opposite(),
   196	            Rotation::CounterClockwise90 => self.counterclockwise(),
   197	        }
   198	    }
   199	}

   106	/// Resolves an item tag's members. Shared by `TagEntry.createItemStack` (`TagEntry.java:46-48`,
   107	/// `expand: false`) below and by the pool-level `expand: true` fan-out
   108	/// (`TagEntry.expandTag`, `TagEntry.java:50-65`) in `LootTableExt::get_loot`.
   109	fn resolve_tag_items(name: &str) -> Vec<&'static Item> {
   110	    // `get_tag_values` keys its map by the full namespaced id (e.g. `"minecraft:wool"`,
   111	    // `crates/pumpkin-data/src/generated/tag.rs`), unlike `Item::from_registry_key` below,
   112	    // which wants the bare path with no namespace.
   113	    pumpkin_data::tag::get_tag_values(tag::RegistryKey::Item, name)
   114	        .unwrap_or_default()
   115	        .iter()
   116	        .filter_map(|registry_key| {
   117	            let item_key = registry_key
   118	                .strip_prefix("minecraft:")
   119	                .unwrap_or(registry_key);
   120	            Item::from_registry_key(item_key)
   121	        })
   122	        .collect()
   123	}

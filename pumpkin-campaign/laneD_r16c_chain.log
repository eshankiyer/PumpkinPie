   513	fn set_property(palette: &mut PaletteEntry, name: &str, value: &str) {
   514	    if let Some((_, current)) = palette.properties.iter_mut().find(|(key, _)| key == name) {
   515	        value.clone_into(current);
   516	    }
   517	}

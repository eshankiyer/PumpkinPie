   145	                if let Some(conditions) = pool.conditions
   146	                    && !conditions.iter().all(|cond| cond.is_fulfilled(&params))
   147	                {
   148	                    continue;
   149	                }
   150	
   151	                let rolls = pool.rolls.get(&mut random) as i32
   152	                    + (pool.bonus_rolls.get(&mut random) * params.luck).floor() as i32;
   153	
   154	                for _ in 0..rolls {
   155	                    let mut total_weight = 0;
   156	                    // `Option<&Item>` fans an `expand: true` tag entry out into one candidate
   157	                    // per tag item, each carrying the entry's own weight (`LootPool.addRandomItem`
   158	                    // calling `LootPoolEntryContainer.expand`, `LootPool.java:70-77`, driven by
   159	                    // `TagEntry.expandTag`, `TagEntry.java:50-65`), rather than contributing the
   160	                    // entry's weight once and choosing an item internally.
   161	                    let mut valid_entries: Vec<(&LootPoolEntry, i32, Option<&Item>)> = Vec::new();
   162	
   163	                    for entry in pool.entries {
   164	                        if entry
   165	                            .conditions
   166	                            .as_ref()
   167	                            .is_none_or(|c| c.iter().all(|cond| cond.is_fulfilled(&params)))
   168	                        {
   169	                            let weight = (entry.weight as f32 + entry.quality as f32 * params.luck)
   170	                                .floor() as i32;
   171	                            let weight = weight.max(0);
   172	
   173	                            if let LootPoolEntryTypes::Tag(tag) = &entry.content
   174	                                && tag.expand
   175	                            {
   176	                                for item in resolve_tag_items(tag.name) {
   177	                                    total_weight += weight;
   178	                                    valid_entries.push((entry, weight, Some(item)));
   179	                                }
   180	                            } else {
   181	                                total_weight += weight;
   182	                                valid_entries.push((entry, weight, None));
   183	                            }
   184	                        }
   185	                    }
   186	
   187	                    if total_weight == 0 || valid_entries.is_empty() {
   188	                        continue;
   189	                    }
   190	
   191	                    let mut r = random.next_bounded_i32(total_weight);
   192	
   193	                    for (entry, weight, forced_item) in valid_entries {
   194	                        r -= weight;
   195	                        if r < 0 {
   196	                            let loot = forced_item.map_or_else(
   197	                                || entry.get_loot(&params),
   198	                                |item| {
   199	                                    let mut item_stacks = vec![ItemStack::new(1, item)];
   200	                                    if let Some(functions) = entry.functions {
   201	                                        for function in functions {
   202	                                            function.apply(&mut item_stacks, &params);
   203	                                        }
   204	                                    }
   205	                                    Some(item_stacks)

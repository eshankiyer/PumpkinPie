    57	fn container_from_block_entity(entity: &dyn BlockEntity) -> Option<ContainerImpl> {
    58	    // `ShulkerBoxBlock.getDrops` (`ShulkerBoxBlock.java:129-135`) copies the block entity's
    59	    // dynamic contents into the replacement shulker box item.
    60	    let nbt = entity.chunk_data_nbt()?;
    61	    let items = nbt
    62	        .get_list("Items")?
    63	        .iter()
    64	        .filter_map(|tag| {
    65	            let item = tag.extract_compound()?;
    66	            let slot = item.get_byte("Slot")? as u8;
    67	            Some((slot, ItemStack::read_item_stack(item)?))
    68	        })
    69	        .collect();
    70	    Some(ContainerImpl { items })
    71	}

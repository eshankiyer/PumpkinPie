    51	) -> Option<StructurePosition> {
    52	    match key {
    53	        StructureKeys::BuriedTreasure => {
    54	            BuriedTreasureGenerator::get_structure_position(&BuriedTreasureGenerator, context)
    55	        }
    56	        StructureKeys::SwampHut => {
    57	            SwampHutGenerator::get_structure_position(&SwampHutGenerator, context)
    58	        }
    59	        StructureKeys::Stronghold => {
    60	            StrongholdGenerator::get_structure_position(&StrongholdGenerator, context)
    61	        }
    62	        StructureKeys::Fortress => {
    63	            NetherFortressGenerator::get_structure_position(&NetherFortressGenerator, context)
    64	        }
    65	        StructureKeys::NetherFossil => {
    66	            NetherFossilGenerator::get_structure_position(&NetherFossilGenerator, context)
    67	        }
    68	        StructureKeys::Igloo => IglooGenerator::get_structure_position(&IglooGenerator, context),
    69	        StructureKeys::DesertPyramid => DesertPyramidGenerator.get_structure_position(context),
    70	        StructureKeys::JunglePyramid => JungleTempleGenerator.get_structure_position(context),
    71	        StructureKeys::VillagePlains
    72	        | StructureKeys::VillageDesert
    73	        | StructureKeys::VillageSavanna
    74	        | StructureKeys::VillageSnowy
    75	        | StructureKeys::VillageTaiga
    76	        | StructureKeys::AncientCity
    77	        | StructureKeys::BastionRemnant
    78	        | StructureKeys::PillagerOutpost
    79	        | StructureKeys::TrailRuins
    80	        | StructureKeys::TrialChambers => {
    81	            let (Some(start_pool), Some(size)) = (structure.start_pool, structure.size) else {
    82	                return None;
    83	            };
    84	            let mut generator =
    85	                JigsawGenerator::new(start_pool, size).with_pool_aliases(structure.pool_aliases);
    86	            if structure.use_expansion_hack.unwrap_or(false) {
    87	                generator = generator.with_expansion_hack(true);
    88	            }
    89	            if let Some(start_jigsaw_name) = structure.start_jigsaw_name {
    90	                generator = generator.with_start_jigsaw(start_jigsaw_name);
    91	            }
    92	            generator.get_structure_position(context)
    93	        }
    94	        StructureKeys::Shipwreck | StructureKeys::ShipwreckBeached => {
    95	            let generator = ShipwreckGenerator {
    96	                is_beached: structure
    97	                    .is_beached
    98	                    .unwrap_or(*key == StructureKeys::ShipwreckBeached),
    99	            };
   100	            generator.get_structure_position(context)
   101	        }
   102	        StructureKeys::RuinedPortal
   103	        | StructureKeys::RuinedPortalDesert
   104	        | StructureKeys::RuinedPortalJungle
   105	        | StructureKeys::RuinedPortalSwamp
   106	        | StructureKeys::RuinedPortalMountain
   107	        | StructureKeys::RuinedPortalOcean
   108	        | StructureKeys::RuinedPortalNether => {
   109	            let generator = RuinedPortalGenerator { variant: *key };
   110	            generator.get_structure_position(context)
   111	        }
   112	        StructureKeys::OceanRuinCold | StructureKeys::OceanRuinWarm => {
   113	            let generator = OceanRuinGenerator {
   114	                is_warm: structure
   115	                    .biome_temp
   116	                    .map_or(*key == StructureKeys::OceanRuinWarm, |t| t == "warm"),
   117	            };
   118	            generator.get_structure_position(context)
   119	        }
   120	        StructureKeys::EndCity => EndCityGenerator.get_structure_position(context),
   121	        StructureKeys::Mansion => MansionGenerator.get_structure_position(context),
   122	        StructureKeys::Monument => OceanMonumentGenerator.get_structure_position(context),
   123	        StructureKeys::Mineshaft | StructureKeys::MineshaftMesa => {
   124	            let generator = MineshaftGenerator {
   125	                is_mesa: structure
   126	                    .mineshaft_type
   127	                    .map_or(*key == StructureKeys::MineshaftMesa, |t| t == "mesa"),
   128	            };
   129	            generator.get_structure_position(context)
   130	        }
   131	    }
   132	}

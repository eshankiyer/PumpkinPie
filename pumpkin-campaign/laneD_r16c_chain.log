    35	pub struct MansionGenerator;
    36	
    37	impl StructureGenerator for MansionGenerator {
    38	    fn get_structure_position(
    39	        &self,
    40	        mut context: StructureGeneratorContext<'_>,
    41	    ) -> Option<StructurePosition> {
    42	        let rotation = Rotation::from_index(context.random.next_bounded_i32(4) as u8);
    43	        let x = context.chunk_x * 16 + 7;
    44	        let z = context.chunk_z * 16 + 7;
    45	        let (offset_x, offset_z) = match rotation {
    46	            Rotation::None => (5, 5),
    47	            Rotation::Clockwise90 => (-5, 5),
    48	            Rotation::Rotate180 => (-5, -5),
    49	            Rotation::CounterClockwise90 => (5, -5),
    50	        };
    51	        let y = {
    52	            let sampler = context.height_sampler.as_deref_mut()?;
    53	            [
    54	                sampler.estimate_height(x, z),
    55	                sampler.estimate_height(x, z + offset_z),
    56	                sampler.estimate_height(x + offset_x, z),
    57	                sampler.estimate_height(x + offset_x, z + offset_z),
    58	            ]
    59	            .into_iter()
    60	            .min()?
    61	        };
    62	        if y < 60 {
    63	            return None;
    64	        }
    65	
    66	        let origin = Vector3::new(x, y, z);
    67	        let grid = MansionGrid::new(&mut context.random);
    68	        let descriptors = MansionPiecePlacer::create(&mut context.random, origin, rotation, &grid);
    69	        let mut pieces = Vec::with_capacity(descriptors.len());
    70	        for descriptor in descriptors {
    71	            pieces.push(MansionTemplatePiece::new(&descriptor)?);
    72	        }
    73	        let piece_boxes = pieces
    74	            .iter()
    75	            .map(|piece| piece.piece.bounding_box)
    76	            .collect::<Vec<_>>();
    77	        let mut collector = StructurePiecesCollector::default();
    78	        for piece in pieces {
    79	            collector.add_piece(Box::new(piece));
    80	        }
    81	        collector.add_piece(Box::new(MansionFoundationPiece::new(piece_boxes)?));
    82	
    83	        Some(StructurePosition {
    84	            start_pos: BlockPos::new(x, y, z),
    85	            collector: Arc::new(Mutex::new(collector)),
    86	        })
    87	    }
    88	}

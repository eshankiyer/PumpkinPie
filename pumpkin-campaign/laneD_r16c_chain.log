   556	    fn entrance(&mut self, data: &mut PlacementData) {
   557	        let position = relative(data.position, data.rotation.rotate(Direction::West), 9);
   558	        self.add("entrance", position, data.rotation);
   559	        data.position = relative(data.position, data.rotation.rotate(Direction::South), 16);
   560	    }
   561	
   562	    fn traverse_wall_piece(&mut self, data: &mut PlacementData) {
   563	        let position = relative(data.position, data.rotation.rotate(Direction::East), 7);
   564	        self.add(data.wall, position, data.rotation);
   565	        data.position = relative(data.position, data.rotation.rotate(Direction::South), 8);
   566	    }
   567	
   568	    fn traverse_turn(&mut self, data: &mut PlacementData) {
   569	        data.position = relative(data.position, data.rotation.rotate(Direction::South), -1);
   570	        self.add("wall_corner", data.position, data.rotation);
   571	        data.position = relative(data.position, data.rotation.rotate(Direction::South), -7);
   572	        data.position = relative(data.position, data.rotation.rotate(Direction::West), -6);
   573	        data.rotation = data.rotation.then(Rotation::Clockwise90);
   574	    }
   575	
   576	    fn traverse_inner_turn(data: &mut PlacementData) {
   577	        data.position = relative(data.position, data.rotation.rotate(Direction::South), 6);
   578	        data.position = relative(data.position, data.rotation.rotate(Direction::East), 8);
   579	        data.rotation = data.rotation.then(Rotation::CounterClockwise90);
   580	    }
   581	}

   267	    fn add_corridors(
   268	        &mut self,
   269	        floor: usize,
   270	        floor_origin: Vector3<i32>,
   271	        rotation: Rotation,
   272	        rooms: &SimpleGrid,
   273	        grid: &SimpleGrid,
   274	    ) {
   275	        let south_carpet = if floor == 0 {
   276	            "carpet_south_1"
   277	        } else {
   278	            "carpet_south_2"
   279	        };
   280	        let west_carpet = if floor == 0 {
   281	            "carpet_west_1"
   282	        } else {
   283	            "carpet_west_2"
   284	        };
   285	        for y in 0..grid.height() {
   286	            for x in 0..grid.width() {
   287	                if grid.get(x, y) != CORRIDOR {
   288	                    continue;
   289	                }
   290	                let mut position = relative(
   291	                    floor_origin,
   292	                    rotation.rotate(Direction::South),
   293	                    8 + (y - self.start_y) * 8,
   294	                );
   295	                position = relative(
   296	                    position,
   297	                    rotation.rotate(Direction::East),
   298	                    (x - self.start_x) * 8,
   299	                );
   300	                self.add("corridor_floor", position, rotation);
   301	                if grid.get(x, y - 1) == CORRIDOR
   302	                    || rooms.get(x, y - 1) & ROOM_CORRIDOR_FLAG == ROOM_CORRIDOR_FLAG
   303	                {
   304	                    let position = offset(
   305	                        relative(position, rotation.rotate(Direction::East), 1),
   306	                        0,
   307	                        1,
   308	                        0,
   309	                    );
   310	                    self.add("carpet_north", position, rotation);
   311	                }
   312	                if grid.get(x + 1, y) == CORRIDOR
   313	                    || rooms.get(x + 1, y) & ROOM_CORRIDOR_FLAG == ROOM_CORRIDOR_FLAG
   314	                {
   315	                    let position = relative(
   316	                        relative(position, rotation.rotate(Direction::South), 1),
   317	                        rotation.rotate(Direction::East),
   318	                        5,
   319	                    );
   320	                    self.add("carpet_east", offset(position, 0, 1, 0), rotation);
   321	                }
   322	                if grid.get(x, y + 1) == CORRIDOR
   323	                    || rooms.get(x, y + 1) & ROOM_CORRIDOR_FLAG == ROOM_CORRIDOR_FLAG
   324	                {
   325	                    let position = relative(
   326	                        relative(position, rotation.rotate(Direction::South), 5),
   327	                        rotation.rotate(Direction::West),
   328	                        1,
   329	                    );
   330	                    self.add(south_carpet, position, rotation);
   331	                }
   332	                if grid.get(x - 1, y) == CORRIDOR
   333	                    || rooms.get(x - 1, y) & ROOM_CORRIDOR_FLAG == ROOM_CORRIDOR_FLAG
   334	                {
   335	                    let position = relative(
   336	                        relative(position, rotation.rotate(Direction::West), 1),
   337	                        rotation.rotate(Direction::North),
   338	                        1,
   339	                    );
   340	                    self.add(west_carpet, position, rotation);
   341	                }
   342	            }
   343	        }
   344	    }

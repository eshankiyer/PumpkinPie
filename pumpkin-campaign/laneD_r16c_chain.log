   613	                let position = self.roof_position(origin, rotation, x, y);
   614	                let covered = above.is_some_and(|above| MansionGrid::is_house(above, x, y));
   615	                if !MansionGrid::is_house(grid, x, y) || covered {
   616	                    continue;
   617	                }

   457	impl StructurePieceBase for MansionFoundationPiece {
   458	    fn as_any(&self) -> &dyn std::any::Any {
   459	        self
   460	    }
   461	
   462	    fn get_structure_piece(&self) -> &StructurePiece {
   463	        &self.piece
   464	    }
   465	
   466	    fn get_structure_piece_mut(&mut self) -> &mut StructurePiece {
   467	        &mut self.piece
   468	    }
   469	
   470	    fn place(
   471	        &mut self,
   472	        chunk: &mut ProtoChunk,
   473	        _block_registry: &dyn WorldPortalExt,
   474	        _random: &mut RandomGenerator,
   475	        _seed: i64,
   476	        chunk_box: &BlockBox,
   477	    ) {
   478	        let min_x = self.piece.bounding_box.min.x.max(chunk_box.min.x);
   479	        let max_x = self.piece.bounding_box.max.x.min(chunk_box.max.x);
   480	        let min_z = self.piece.bounding_box.min.z.max(chunk_box.min.z);
   481	        let max_z = self.piece.bounding_box.max.z.min(chunk_box.max.z);
   482	        let bottom = i32::from(chunk.bottom_y()) + 1;
   483	        for x in min_x..=max_x {
   484	            for z in min_z..=max_z {
   485	                let position = Vector3::new(x, self.y, z);
   486	                if chunk.get_block_state(&position).to_state().is_air()
   487	                    || !self
   488	                        .mansion_pieces
   489	                        .iter()
   490	                        .any(|piece| piece.contains_pos(&position))
   491	                {
   492	                    continue;
   493	                }
   494	                for y in (bottom..self.y).rev() {
   495	                    let state = chunk.get_block_state(&Vector3::new(x, y, z)).to_state();
   496	                    if !state.is_air() && !state.is_liquid() {
   497	                        break;
   498	                    }
   499	                    chunk.set_block_state(x, y, z, Block::COBBLESTONE.default_state);
   500	                }
   501	            }
   502	        }
   503	    }
   504	}

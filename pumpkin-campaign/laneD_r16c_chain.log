  1154	   private static class SimpleGrid {
  1155	      private final int[][] grid;
  1156	      private final int width;
  1157	      private final int height;
  1158	      private final int valueIfOutside;
  1159	
  1160	      public SimpleGrid(final int width, final int height, final int valueIfOutside) {
  1161	         this.width = width;
  1162	         this.height = height;
  1163	         this.valueIfOutside = valueIfOutside;
  1164	         this.grid = new int[width][height];
  1165	      }
  1166	
  1167	      public void set(final int x, final int y, final int value) {
  1168	         if (x >= 0 && x < this.width && y >= 0 && y < this.height) {
  1169	            this.grid[x][y] = value;
  1170	         }
  1171	      }
  1172	
  1173	      public void set(final int x0, final int y0, final int x1, final int y1, final int value) {
  1174	         for (int y = y0; y <= y1; y++) {
  1175	            for (int x = x0; x <= x1; x++) {
  1176	               this.set(x, y, value);
  1177	            }
  1178	         }
  1179	      }
  1180	
  1181	      public int get(final int x, final int y) {
  1182	         return x >= 0 && x < this.width && y >= 0 && y < this.height ? this.grid[x][y] : this.valueIfOutside;
  1183	      }
  1184	
  1185	      public void setif(final int x, final int y, final int ifValue, final int value) {
  1186	         if (this.get(x, y) == ifValue) {
  1187	            this.set(x, y, value);
  1188	         }
  1189	      }
  1190	
  1191	      public boolean edgesTo(final int x, final int y, final int ifValue) {
  1192	         return this.get(x - 1, y) == ifValue || this.get(x + 1, y) == ifValue || this.get(x, y + 1) == ifValue || this.get(x, y - 1) == ifValue;
  1193	      }
  1194	   }

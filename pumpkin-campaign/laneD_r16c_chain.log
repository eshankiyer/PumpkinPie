   211	                                if let Some(functions) = pool.functions {
   212	                                    for function in functions {
   213	                                        function.apply(&mut loot, &params);
   214	                                    }
   215	                                }
   216	                                for stack in loot {
   217	                                    if stack.item_count > 0 {
   218	                                        push_split_stack(&mut stacks, stack);
   219	                                    }
   220	                                }
   221	                            }

   387	   private Vec3 calculateHaltTrackSpeed(final Vec3 deltaMovement, final BlockState state) {
   388	      if (state.is(Blocks.POWERED_RAIL) && !state.getValue(PoweredRailBlock.POWERED)) {
   389	         return deltaMovement.length() < 0.03 ? Vec3.ZERO : deltaMovement.scale(0.5);
   390	      } else {
   391	         return deltaMovement;
   392	      }
   393	   }
   394	
   395	   private Vec3 calculateBoostTrackSpeed(final Vec3 deltaMovement, final BlockPos pos, final BlockState state) {
   396	      if (state.is(Blocks.POWERED_RAIL) && state.getValue(PoweredRailBlock.POWERED)) {
   397	         if (deltaMovement.length() > 0.01) {

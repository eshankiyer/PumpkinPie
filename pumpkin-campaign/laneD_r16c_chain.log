    73	/// Vanilla `LootTable.createStackSplitter` (`LootTable.java:66-82`): a roll whose count is at
    74	/// or above the item's max stack size is emitted as several stacks of at most `max_stack_size`
    75	/// rather than one oversized stack.
    76	///
    77	/// The `isItemEnabled` feature-flag half of the vanilla lambda has no analogue here and is
    78	/// deliberately not modelled.
    79	fn push_split_stack(stacks: &mut Vec<ItemStack>, stack: ItemStack) {
    80	    let max = stack.get_max_stack_size().max(1);
    81	    if stack.item_count < max {
    82	        stacks.push(stack);
    83	        return;
    84	    }
    85	
    86	    let mut remaining = stack.item_count;
    87	    while remaining > 0 {
    88	        let count = max.min(remaining);
    89	        stacks.push(stack.copy_with_count(count));
    90	        remaining -= count;
    91	    }
    92	}

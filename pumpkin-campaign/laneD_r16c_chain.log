   169	    pub async fn kill_and_drop_self(&self) {
   170	        let world = self.entity.world.load();
   171	        let entity_drops = world.level_info.load().game_rules.entity_drops;
   172	
   173	        if entity_drops && let Some(loot_table) = &self.entity.entity_type.loot_table {
   174	            let pos = self.entity.block_pos.load();
   175	            let is_raining = world.is_raining().await;
   176	            let is_thundering = world.is_thundering().await;
   177	            let params = LootContextParameters {
   178	                is_raining: Some(is_raining),
   179	                is_thundering: Some(is_thundering),
   180	                world_time: world.level_info.load().day_time as u64,
   181	                // `LootContext.Builder.create` resolves named sequences with the server world
   182	                // seed (`LootContext.java:138-142`; `MinecraftServer.java:1766-1767`).
   183	                world_seed: world.level.seed.0,
   184	                ..Default::default()
   185	            };
   186	            for stack in loot_table.get_loot(params) {
   187	                world.drop_stack(&pos, stack).await;
   188	            }
   189	        }
   190	
   191	        self.entity.remove().await;
   192	    }

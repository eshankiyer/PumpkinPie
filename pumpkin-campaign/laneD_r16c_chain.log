   106	    )]
   107	    pub(super) fn new(random: &mut RandomGenerator) -> Self {
   108	        let entrance_x = 7;
   109	        let entrance_y = 4;
   110	        let mut base = SimpleGrid::new(BLOCKED);
   111	        base.set_rect(
   112	            entrance_x,
   113	            entrance_y,
   114	            entrance_x + 1,
   115	            entrance_y + 1,
   116	            START_ROOM,
   117	        );
   118	        base.set_rect(
   119	            entrance_x - 1,
   120	            entrance_y,
   121	            entrance_x - 1,
   122	            entrance_y + 1,
   123	            ROOM,
   124	        );
   125	        base.set_rect(
   126	            entrance_x + 2,
   127	            entrance_y - 2,
   128	            entrance_x + 3,
   129	            entrance_y + 3,
   130	            BLOCKED,
   131	        );
   132	        base.set_rect(
   133	            entrance_x + 1,
   134	            entrance_y - 2,
   135	            entrance_x + 1,
   136	            entrance_y - 1,
   137	            CORRIDOR,
   138	        );
   139	        base.set_rect(
   140	            entrance_x + 1,
   141	            entrance_y + 2,
   142	            entrance_x + 1,
   143	            entrance_y + 3,
   144	            CORRIDOR,
   145	        );
   146	        base.set(entrance_x - 1, entrance_y - 1, CORRIDOR);
   147	        base.set(entrance_x - 1, entrance_y + 2, CORRIDOR);
   148	        base.set_rect(0, 0, 11, 1, BLOCKED);
   149	        base.set_rect(0, 9, 11, 11, BLOCKED);
   150	
   151	        Self::recursive_corridor(
   152	            random,
   153	            &mut base,
   154	            entrance_x,
   155	            entrance_y - 2,
   156	            Direction::West,
   157	            6,
   158	        );
   159	        Self::recursive_corridor(
   160	            random,
   161	            &mut base,
   162	            entrance_x,
   163	            entrance_y + 3,
   164	            Direction::West,
   165	            6,
   166	        );
   167	        Self::recursive_corridor(
   168	            random,
   169	            &mut base,
   170	            entrance_x - 2,
   171	            entrance_y - 1,
   172	            Direction::West,
   173	            3,
   174	        );
   175	        Self::recursive_corridor(
   176	            random,
   177	            &mut base,
   178	            entrance_x - 2,
   179	            entrance_y + 2,
   180	            Direction::West,
   181	            3,
   182	        );
   183	        while Self::clean_edges(&mut base) {}
   184	
   185	        let mut floor_rooms = std::array::from_fn(|_| SimpleGrid::new(BLOCKED));
   186	        Self::identify_rooms(random, &base, &mut floor_rooms[0]);
   187	        Self::identify_rooms(random, &base, &mut floor_rooms[1]);
   188	        floor_rooms[0].set_rect(
   189	            entrance_x + 1,
   190	            entrance_y,
   191	            entrance_x + 1,
   192	            entrance_y + 1,
   193	            ROOM_CORRIDOR_FLAG,
   194	        );
   195	        floor_rooms[1].set_rect(
   196	            entrance_x + 1,
   197	            entrance_y,
   198	            entrance_x + 1,
   199	            entrance_y + 1,
   200	            ROOM_CORRIDOR_FLAG,
   201	        );
   202	
   203	        let mut mansion = Self {
   204	            base,
   205	            third_floor: SimpleGrid::new(BLOCKED),
   206	            floor_rooms,
   207	            entrance_x,
   208	            entrance_y,

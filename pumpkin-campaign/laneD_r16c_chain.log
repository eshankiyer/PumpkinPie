   377	               return deltaMovement.add(new Vec3(riderMovement.x, 0.0, riderMovement.z).normalize().scale(0.001));
   378	            }
   379	         }
   380	
   381	         return deltaMovement;
   382	      } else {
   383	         return deltaMovement;
   384	      }
   385	   }

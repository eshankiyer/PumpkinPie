   440	    piece: StructurePiece,
   441	    mansion_pieces: Vec<BlockBox>,
   442	    y: i32,
   443	}
   444	
   445	impl MansionFoundationPiece {
   446	    fn new(mansion_pieces: Vec<BlockBox>) -> Option<Self> {
   447	        let bounding_box = BlockBox::encompass_all(mansion_pieces.iter().copied())?;
   448	        let y = bounding_box.min.y;
   449	        Some(Self {
   450	            piece: StructurePiece::new(StructurePieceType::WoodlandMansion, bounding_box, 0),
   451	            mansion_pieces,
   452	            y,
   453	        })
   454	    }
   455	}

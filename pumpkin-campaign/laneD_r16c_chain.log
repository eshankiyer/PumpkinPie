   161	    fn create_mansion(&mut self, origin: Vector3<i32>, rotation: Rotation, mansion: &MansionGrid) {
   162	        let mut ground = PlacementData {
   163	            position: origin,
   164	            rotation,
   165	            wall: "wall_flat",
   166	        };
   167	        self.entrance(&mut ground);
   168	        let mut second = PlacementData {
   169	            position: offset(ground.position, 0, 8, 0),
   170	            rotation: ground.rotation,
   171	            wall: "wall_window",
   172	        };
   173	        let end_x = mansion.entrance_x + 1;
   174	        let end_y = mansion.entrance_y;
   175	        self.traverse_outer_walls(
   176	            &mut ground,
   177	            &mansion.base,
   178	            Direction::South,
   179	            self.start_x,
   180	            self.start_y,
   181	            end_x,
   182	            end_y,
   183	        );
   184	        self.traverse_outer_walls(
   185	            &mut second,
   186	            &mansion.base,
   187	            Direction::South,
   188	            self.start_x,
   189	            self.start_y,
   190	            end_x,
   191	            end_y,
   192	        );
   193	
   194	        let mut third = PlacementData {
   195	            position: offset(ground.position, 0, 19, 0),
   196	            rotation: ground.rotation,
   197	            wall: "wall_window",
   198	        };
   199	        'find_start: for y in 0..mansion.third_floor.height() {
   200	            for x in (0..mansion.third_floor.width()).rev() {
   201	                if !MansionGrid::is_house(&mansion.third_floor, x, y) {
   202	                    continue;
   203	                }
   204	                third.position = relative(
   205	                    third.position,
   206	                    rotation.rotate(Direction::South),
   207	                    8 + (y - self.start_y) * 8,
   208	                );
   209	                third.position = relative(
   210	                    third.position,
   211	                    rotation.rotate(Direction::East),
   212	                    (x - self.start_x) * 8,
   213	                );
   214	                self.traverse_wall_piece(&mut third);
   215	                self.traverse_outer_walls(
   216	                    &mut third,
   217	                    &mansion.third_floor,
   218	                    Direction::South,
   219	                    x,
   220	                    y,
   221	                    x,
   222	                    y,
   223	                );
   224	                break 'find_start;
   225	            }
   226	        }
   227	
   228	        self.create_roof(
   229	            offset(origin, 0, 16, 0),
   230	            rotation,
   231	            &mansion.base,
   232	            Some(&mansion.third_floor),
   233	        );
   234	        self.create_roof(
   235	            offset(origin, 0, 27, 0),
   236	            rotation,
   237	            &mansion.third_floor,
   238	            None,
   239	        );
   240	
   241	        for floor in 0..3 {
   242	            let floor_origin = offset(origin, 0, 8 * floor as i32 + i32::from(floor == 2) * 3, 0);
   243	            let rooms = &mansion.floor_rooms[floor];
   244	            let grid = if floor == 2 {
   245	                &mansion.third_floor
   246	            } else {
   247	                &mansion.base
   248	            };
   249	            let room_collection = if floor == 0 {
   250	                FloorRooms::First
   251	            } else {
   252	                FloorRooms::Upper
   253	            };
   254	            self.add_corridors(floor, floor_origin, rotation, rooms, grid);
   255	            self.add_rooms(
   256	                floor,
   257	                floor_origin,
   258	                rotation,
   259	                mansion,
   260	                rooms,
   261	                grid,
   262	                room_collection,
   263	            );
   264	        }
   265	    }

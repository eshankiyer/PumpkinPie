   273	    fn place_blocks(
   274	        &self,
   275	        chunk: &mut ProtoChunk,
   276	        random: &mut RandomGenerator,
   277	        chunk_box: &BlockBox,
   278	    ) {
   279	        for template_block in &self.template.blocks {
   280	            let palette = &self.template.palette[template_block.state as usize];
   281	            let position = self.world_position(template_block.pos);
   282	            if !chunk_box.contains_pos(&position) {
   283	                continue;
   284	            }
   285	            if palette.name == "minecraft:structure_void" {
   286	                continue;
   287	            }
   288	            if palette.name == "minecraft:structure_block" {
   289	                if let Some(marker) = template_block
   290	                    .nbt
   291	                    .as_ref()
   292	                    .and_then(|nbt| nbt.get_string("metadata"))
   293	                {
   294	                    self.handle_marker(chunk, random, marker, position);
   295	                }
   296	                continue;
   297	            }
   298	
   299	            let mut transformed = palette.clone();
   300	            if chunk.get_block_state(&position).to_block_id() == Block::WATER.id
   301	                && property(&transformed, "waterlogged").is_some()
   302	            {
   303	                set_property(&mut transformed, "waterlogged", "true");
   304	            }
   305	            let Some(state) = BlockStateResolver::resolve(
   306	                &transformed,
   307	                self.rotation,
   308	                self.mirror.state_mirror(),
   309	            ) else {
   310	                continue;
   311	            };
   312	            chunk.set_block_state(position.x, position.y, position.z, state);
   313	            Self::place_block_entity(
   314	                chunk,
   315	                palette,
   316	                template_block.nbt.as_ref(),
   317	                position,
   318	                random,
   319	            );
   320	        }
   321	    }
   322	
   323	    fn place_block_entity(
   324	        chunk: &mut ProtoChunk,
   325	        palette: &PaletteEntry,
   326	        template_nbt: Option<&NbtCompound>,
   327	        position: Vector3<i32>,
   328	        random: &mut RandomGenerator,
   329	    ) {
   330	        let block_entity_id = get_block_entity_id(&palette.name);
   331	        if template_nbt.is_none() && block_entity_id.is_none() {
   332	            return;
   333	        }
   334	        let mut nbt = NbtCompound::new();
   335	        nbt.put_string("id", block_entity_id.unwrap_or(&palette.name).to_string());
   336	        nbt.put_int("x", position.x);
   337	        nbt.put_int("y", position.y);
   338	        nbt.put_int("z", position.z);
   339	        if let Some(template_nbt) = template_nbt {
   340	            for (key, value) in &template_nbt.child_tags {
   341	                if !matches!(key.as_ref(), "x" | "y" | "z" | "id") {
   342	                    nbt.child_tags.insert(key.clone(), value.clone());
   343	                }
   344	            }
   345	        }
   346	        if nbt.get_string("LootTable").is_some() && nbt.get_long("LootTableSeed").is_none() {
   347	            nbt.put_long("LootTableSeed", random.next_i64());
   348	        }
   349	        chunk.add_block_entity(nbt);
   350	    }
   351	
   352	    fn handle_marker(
   353	        &self,
   354	        chunk: &mut ProtoChunk,
   355	        random: &mut RandomGenerator,
   356	        marker: &str,
   357	        position: Vector3<i32>,
   358	    ) {
   359	        if let Some(facing) = marker.strip_prefix("Chest") {
   360	            let direction = match facing {
   361	                "West" => Direction::West,
   362	                "East" => Direction::East,
   363	                "South" => Direction::South,
   364	                _ => Direction::North,
   365	            };
   366	            let target = self.rotation.rotate(direction);
   367	            let chest = PaletteEntry::with_properties(
   368	                "minecraft:chest".to_string(),
   369	                vec![("facing".to_string(), target.name().to_string())],
   370	            );
   371	            if let Some(state) = BlockStateResolver::resolve_simple(&chest) {
   372	                chunk.set_block_state(position.x, position.y, position.z, state);
   373	            }
   374	            let mut nbt = NbtCompound::new();
   375	            nbt.put_string("id", "minecraft:chest".to_string());
   376	            nbt.put_int("x", position.x);
   377	            nbt.put_int("y", position.y);
   378	            nbt.put_int("z", position.z);
   379	            nbt.put_string("LootTable", LOOT_TABLE.to_string());
   380	            nbt.put_long("LootTableSeed", random.next_i64());
   381	            chunk.add_block_entity(nbt);
   382	            return;
   383	        }
   384	
   385	        let (entity, count) = match marker {
   386	            "Mage" => ("minecraft:evoker", 1),
   387	            "Warrior" => ("minecraft:vindicator", 1),
   388	            "Group of Allays" => ("minecraft:allay", random.next_bounded_i32(3) + 1),
   389	            _ => return,
   390	        };
   391	        chunk.set_block_state(position.x, position.y, position.z, Block::AIR.default_state);
   392	        for _ in 0..count {
   393	            let mut nbt = NbtCompound::new();
   394	            nbt.put_string("id", entity.to_string());
   395	            nbt.put_list(
   396	                "Pos",
   397	                vec![
   398	                    (f64::from(position.x) + 0.5).into(),
   399	                    f64::from(position.y).into(),
   400	                    (f64::from(position.z) + 0.5).into(),
   401	                ],
   402	            );
   403	            nbt.put(
   404	                "Motion",
   405	                NbtTag::List(vec![0.0.into(), 0.0.into(), 0.0.into()]),
   406	            );
   407	            nbt.put("Rotation", NbtTag::List(vec![0.0f32.into(), 0.0f32.into()]));
   408	            nbt.put_bool("PersistenceRequired", true);
   409	            chunk.add_structure_entity(nbt);
   410	        }
   411	    }
   412	}

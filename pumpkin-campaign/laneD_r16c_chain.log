   519	const fn transform(
   520	    position: Vector3<i32>,
   521	    mirror: TemplateMirror,
   522	    rotation: Rotation,
   523	) -> Vector3<i32> {
   524	    let x = if matches!(mirror, TemplateMirror::FrontBack) {
   525	        -position.x
   526	    } else {
   527	        position.x
   528	    };
   529	    let z = if matches!(mirror, TemplateMirror::LeftRight) {
   530	        -position.z
   531	    } else {
   532	        position.z
   533	    };
   534	    let (x, z) = rotation.rotate_offset(x, z);
   535	    Vector3::new(x, position.y, z)
   536	}

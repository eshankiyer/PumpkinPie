   231	
   232	impl MansionTemplatePiece {
   233	    fn new(descriptor: &PieceDescriptor) -> Option<Self> {
   234	        let template = get_template(&format!("woodland_mansion/{}", descriptor.template))?;
   235	        let max = Vector3::new(
   236	            template.size.x - 1,
   237	            template.size.y - 1,
   238	            template.size.z - 1,
   239	        );
   240	        let first = transform(
   241	            Vector3::new(0, 0, 0),
   242	            descriptor.mirror,
   243	            descriptor.rotation,
   244	        );
   245	        let second = transform(max, descriptor.mirror, descriptor.rotation);
   246	        let bounding_box = BlockBox::new(
   247	            descriptor.position.x + first.x.min(second.x),
   248	            descriptor.position.y,
   249	            descriptor.position.z + first.z.min(second.z),
   250	            descriptor.position.x + first.x.max(second.x),
   251	            descriptor.position.y + max.y,
   252	            descriptor.position.z + first.z.max(second.z),
   253	        );
   254	        Some(Self {
   255	            piece: StructurePiece::new(StructurePieceType::WoodlandMansion, bounding_box, 0),
   256	            template,
   257	            template_position: descriptor.position,
   258	            rotation: descriptor.rotation,
   259	            mirror: descriptor.mirror,
   260	        })
   261	    }
   262	
   263	    const fn world_position(&self, local: Vector3<i32>) -> Vector3<i32> {
   264	        let transformed = transform(local, self.mirror, self.rotation);
   265	        offset(
   266	            self.template_position,
   267	            transformed.x,
   268	            transformed.y,
   269	            transformed.z,
   270	        )
   271	    }

    29	    pub fn tick(&self) {
    30	        let current_hurt = self.hurt_time.load(Ordering::Relaxed);
    31	        if current_hurt > 0 {
    32	            self.hurt_time.store(current_hurt - 1, Ordering::Relaxed);
    33	        }
    34	
    35	        let current_damage = self.damage.load();
    36	        if current_damage > 0.0 {
    37	            self.damage.store(current_damage - 1.0);
    38	        }
    39	
    40	        let mut update_event =
    41	            crate::plugin::api::events::vehicle::vehicle_update::VehicleUpdateEvent::new(
    42	                self.entity.entity_id,
    43	            );
    44	        if let Some(server) = self.entity.world.load().server.upgrade() {
    45	            tokio::task::block_in_place(|| {
    46	                tokio::runtime::Handle::current().block_on(async {
    47	                    server.plugin_manager.fire(&server, &mut update_event).await;
    48	                });
    49	            });
    50	        }
    51	
    52	        // `VehicleEntity.hurtServer` marks a damaged vehicle (`VehicleEntity.java:44-48`),
    53	        // and `ServerEntity.sendChanges` resends its motion after the entity update
    54	        // (`ServerEntity.java:224-228`).
    55	        if self.entity.hurt_marked.swap(false, Ordering::Relaxed) {
    56	            self.entity.send_velocity_forced();
    57	        }
    58	    }

   370	   private Vec3 calculatePlayerInputSpeed(final Vec3 deltaMovement) {
   371	      if (this.minecart.getFirstPassenger() instanceof ServerPlayer player) {
   372	         Vec3 moveIntent = player.getLastClientMoveIntent();
   373	         if (moveIntent.lengthSqr() > 0.0) {
   374	            Vec3 riderMovement = moveIntent.normalize();

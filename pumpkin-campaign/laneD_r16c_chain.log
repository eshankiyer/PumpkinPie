   368	            for x in 0..grid.width() {
   369	                let third_floor_start = floor == 2 && grid.get(x, y) == START_ROOM;
   370	                if grid.get(x, y) != ROOM && !third_floor_start {
   371	                    continue;
   372	                }
   373	                let room_data = rooms.get(x, y);
   374	                let room_type = room_data & ROOM_TYPE_MASK;
   375	                let room_id = room_data & ROOM_ID_MASK;
   376	                let corridor_start =
   377	                    third_floor_start && room_data & ROOM_CORRIDOR_FLAG == ROOM_CORRIDOR_FLAG;
   378	                let door_directions = if room_data & ROOM_DOOR_FLAG == ROOM_DOOR_FLAG {
   379	                    Direction::HORIZONTAL
   380	                        .into_iter()
   381	                        .filter(|direction| {
   382	                            grid.get(x + direction.step_x(), y + direction.step_z()) == CORRIDOR
   383	                        })
   384	                        .collect::<Vec<_>>()
   385	                } else {
   386	                    Vec::new()
   387	                };
   388	                let door_direction = if door_directions.is_empty() {
   389	                    (room_data & ROOM_ORIGIN_FLAG == ROOM_ORIGIN_FLAG).then_some(Direction::Up)
   390	                } else {
   391	                    Some(
   392	                        door_directions
   393	                            [self.random.next_bounded_i32(door_directions.len() as i32) as usize],
   394	                    )
   395	                };
   396	
   397	                let mut room_position = relative(
   398	                    floor_origin,
   399	                    rotation.rotate(Direction::South),
   400	                    8 + (y - self.start_y) * 8,
   401	                );
   402	                room_position = relative(
   403	                    room_position,
   404	                    rotation.rotate(Direction::East),
   405	                    -1 + (x - self.start_x) * 8,
   406	                );
   407	
   408	                if MansionGrid::is_house(grid, x - 1, y)
   409	                    && !mansion.is_room_id(x - 1, y, floor, room_id)
   410	                {
   411	                    self.add(
   412	                        if door_direction == Some(Direction::West) {
   413	                            door
   414	                        } else {
   415	                            wall
   416	                        },
   417	                        room_position,
   418	                        rotation,
   419	                    );
   420	                }
   421	                if grid.get(x + 1, y) == CORRIDOR && !corridor_start {
   422	                    self.add(
   423	                        if door_direction == Some(Direction::East) {
   424	                            door
   425	                        } else {
   426	                            wall
   427	                        },
   428	                        relative(room_position, rotation.rotate(Direction::East), 8),
   429	                        rotation,
   430	                    );
   431	                }
   432	                if MansionGrid::is_house(grid, x, y + 1)
   433	                    && !mansion.is_room_id(x, y + 1, floor, room_id)
   434	                {
   435	                    let position = relative(
   436	                        relative(room_position, rotation.rotate(Direction::South), 7),
   437	                        rotation.rotate(Direction::East),
   438	                        7,
   439	                    );
   440	                    self.add(
   441	                        if door_direction == Some(Direction::South) {
   442	                            door
   443	                        } else {
   444	                            wall
   445	                        },
   446	                        position,
   447	                        rotation.then(Rotation::Clockwise90),
   448	                    );
   449	                }
   450	                if grid.get(x, y - 1) == CORRIDOR && !corridor_start {
   451	                    let position = relative(
   452	                        relative(room_position, rotation.rotate(Direction::North), 1),
   453	                        rotation.rotate(Direction::East),
   454	                        7,
   455	                    );
   456	                    self.add(
   457	                        if door_direction == Some(Direction::North) {
   458	                            door
   459	                        } else {
   460	                            wall
   461	                        },
   462	                        position,
   463	                        rotation.then(Rotation::Clockwise90),
   464	                    );
   465	                }
   466	
   467	                match (room_type, door_direction) {
   468	                    (ROOM_1X1, direction) => {
   469	                        self.add_room_1x1(room_position, rotation, direction, room_collection);
   470	                    }
   471	                    (ROOM_1X2, Some(door_direction)) => {
   472	                        if let Some(room_direction) = mansion.room_direction(x, y, floor, room_id) {
   473	                            self.add_room_1x2(
   474	                                room_position,
   475	                                rotation,
   476	                                room_direction,
   477	                                door_direction,
   478	                                room_collection,
   479	                                room_data & ROOM_STAIRS_FLAG == ROOM_STAIRS_FLAG,
   480	                            );
   481	                        }
   482	                    }
   483	                    (ROOM_2X2, Some(Direction::Up)) => {
   484	                        self.add_room_2x2_secret(room_position, rotation);
   485	                    }
   486	                    (ROOM_2X2, Some(door_direction)) => {
   487	                        let mut room_direction = door_direction.clockwise();
   488	                        if !mansion.is_room_id(
   489	                            x + room_direction.step_x(),
   490	                            y + room_direction.step_z(),
   491	                            floor,
   492	                            room_id,
   493	                        ) {
   494	                            room_direction = room_direction.opposite();
   495	                        }
   496	                        self.add_room_2x2(
   497	                            room_position,
   498	                            rotation,
   499	                            room_direction,
   500	                            door_direction,
   501	                            room_collection,
   502	                        );
   503	                    }
   504	                    _ => {}
   505	                }
   506	            }
   507	        }
   508	    }

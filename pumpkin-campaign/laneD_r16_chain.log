   281	/// `MapItemSavedData.clampMapCoordinate` (`MapItemSavedData.java:355-362`) preserves the
   282	/// protocol's asymmetric `-128..127` map-coordinate range.
   283	fn clamp_map_coordinate(delta: f64) -> i8 {
   284	    if delta <= -63.0 {
   285	        -128
   286	    } else if delta >= 63.0 {
   287	        127
   288	    } else {
   289	        (delta * 2.0 + 0.5) as i8
   290	    }
   291	}

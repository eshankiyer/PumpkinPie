    43	    pub async fn read_nbt(&self, nbt: &NbtCompound) {
    44	        let loot_table = nbt.get_string("LootTable").map(|loot_table| {
    45	            (
    46	                loot_table.to_owned(),
    47	                nbt.get_long("LootTableSeed").unwrap_or(0),
    48	            )
    49	        });
    50	        let has_loot_table = loot_table.is_some();
    51	        *self.loot_table.lock().await = loot_table;
    52	
    53	        if !has_loot_table {
    54	            let mut items = self.items.write().await;
    55	            items.fill_with(|| ItemStack::EMPTY.clone());
    56	            self.read_data(nbt, &mut items);
    57	        }
    58	    }
    59	
    60	    pub async fn write_nbt(&self, nbt: &mut NbtCompound) {
    61	        let loot_table = self.loot_table.lock().await.clone();
    62	        if let Some((loot_table, seed)) = loot_table {
    63	            nbt.put_string("LootTable", loot_table);
    64	            if seed != 0 {
    65	                nbt.put_long("LootTableSeed", seed);
    66	            }
    67	        } else {
    68	            self.write_inventory_nbt(nbt, true).await;
    69	        }
    70	    }
    71	
    72	    pub async fn has_loot_table(&self) -> bool {
    73	        self.loot_table.lock().await.is_some()
    74	    }
    75	
    76	    pub async fn unpack_loot(self: &Arc<Self>) {
    77	        let loot_table = self.loot_table.lock().await.take();
    78	        let Some((loot_table, seed)) = loot_table else {
    79	            return;
    80	        };
    81	        let Some(table) = get_chest_loot_table(&loot_table) else {
    82	            *self.loot_table.lock().await = Some((loot_table, seed));
    83	            return;
    84	        };
    85	
    86	        let inventory: Arc<dyn Inventory> = self.clone();
    87	        fill_chest_inventory(&inventory, table, seed).await;
    88	    }
    89	}

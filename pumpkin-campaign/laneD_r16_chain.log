   498	   public class HoldingPlayer {
   499	      public final Player player;
   500	      private boolean dirtyData = true;
   501	      private int minDirtyX;
   502	      private int minDirtyY;
   503	      private int maxDirtyX = 127;
   504	      private int maxDirtyY = 127;
   505	      private boolean dirtyDecorations = true;
   506	      private int tick;
   507	      public int step;
   508	
   509	      private HoldingPlayer(final Player player) {
   510	         this.player = player;
   511	      }
   512	
   513	      private MapItemSavedData.MapPatch createPatch() {
   514	         int startX = this.minDirtyX;
   515	         int startY = this.minDirtyY;
   516	         int width = this.maxDirtyX + 1 - this.minDirtyX;
   517	         int height = this.maxDirtyY + 1 - this.minDirtyY;
   518	         byte[] patch = new byte[width * height];
   519	
   520	         for (int x = 0; x < width; x++) {
   521	            for (int y = 0; y < height; y++) {
   522	               patch[x + y * width] = MapItemSavedData.this.colors[startX + x + (startY + y) * 128];
   523	            }
   524	         }
   525	
   526	         return new MapItemSavedData.MapPatch(startX, startY, width, height, patch);
   527	      }
   528	
   529	      private @Nullable Packet<?> nextUpdatePacket(final MapId id) {
   530	         MapItemSavedData.MapPatch patch;
   531	         if (this.dirtyData) {
   532	            this.dirtyData = false;
   533	            patch = this.createPatch();
   534	         } else {
   535	            patch = null;
   536	         }
   537	
   538	         Collection<MapDecoration> decorations;
   539	         if (this.dirtyDecorations && this.tick++ % 5 == 0) {
   540	            this.dirtyDecorations = false;
   541	            decorations = MapItemSavedData.this.decorations.values();
   542	         } else {
   543	            decorations = null;
   544	         }
   545	
   546	         return decorations == null && patch == null
   547	            ? null
   548	            : new ClientboundMapItemDataPacket(id, MapItemSavedData.this.scale, MapItemSavedData.this.locked, decorations, patch);
   549	      }
   550	
   551	      private void markColorsDirty(final int x, final int y) {
   552	         if (this.dirtyData) {
   553	            this.minDirtyX = Math.min(this.minDirtyX, x);
   554	            this.minDirtyY = Math.min(this.minDirtyY, y);
   555	            this.maxDirtyX = Math.max(this.maxDirtyX, x);
   556	            this.maxDirtyY = Math.max(this.maxDirtyY, y);
   557	         } else {
   558	            this.dirtyData = true;
   559	            this.minDirtyX = x;
   560	            this.minDirtyY = y;
   561	            this.maxDirtyX = x;
   562	            this.maxDirtyY = y;
   563	         }
   564	      }
   565	
   566	      private void markDecorationsDirty() {
   567	         this.dirtyDecorations = true;
   568	      }
   569	   }
   570	
   571	   private record MapDecorationLocation(Holder<MapDecorationType> type, byte x, byte y, byte rot) {
   572	   }
   573	
   574	   public record MapPatch(int startX, int startY, int width, int height, byte[] mapColors) {
   575	      public static final StreamCodec<ByteBuf, Optional<MapItemSavedData.MapPatch>> STREAM_CODEC = StreamCodec.of(
   576	         MapItemSavedData.MapPatch::write, MapItemSavedData.MapPatch::read
   577	      );
   578	
   579	      private static void write(final ByteBuf output, final Optional<MapItemSavedData.MapPatch> optional) {
   580	         if (optional.isPresent()) {
   581	            MapItemSavedData.MapPatch patch = optional.get();
   582	            output.writeByte(patch.width);
   583	            output.writeByte(patch.height);
   584	            output.writeByte(patch.startX);
   585	            output.writeByte(patch.startY);
   586	            FriendlyByteBuf.writeByteArray(output, patch.mapColors);
   587	         } else {
   588	            output.writeByte(0);
   589	         }
   590	      }
   591	
   592	      private static Optional<MapItemSavedData.MapPatch> read(final ByteBuf input) {
   593	         int width = input.readUnsignedByte();
   594	         if (width > 0) {
   595	            int height = input.readUnsignedByte();
   596	            int startX = input.readUnsignedByte();
   597	            int startY = input.readUnsignedByte();
   598	            byte[] mapColors = FriendlyByteBuf.readByteArray(input);
   599	            return Optional.of(new MapItemSavedData.MapPatch(startX, startY, width, height, mapColors));
   600	         } else {
   601	            return Optional.empty();
   602	         }
   603	      }
   604	
   605	      public void applyToMap(final MapItemSavedData map) {

   249	   private void removeDecoration(final String string) {
   250	      MapDecoration decoration = this.decorations.remove(string);
   251	      if (decoration != null && decoration.type().value().trackCount()) {
   252	         this.trackedDecorationCount--;
   253	      }
   254	
   255	      this.setDecorationsDirty();
   256	   }

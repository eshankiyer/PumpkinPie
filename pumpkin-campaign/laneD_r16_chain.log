   229	    pub fn update(&mut self, player: &Player) {
   230	        let world = player.world();
   231	        let scale = 1 << self.scale;
   232	        let center_x = self.center_x;
   233	        let center_z = self.center_z;
   234	
   235	        let player_pos = player.position();
   236	        let player_x = player_pos.x as i32;
   237	        let player_z = player_pos.z as i32;
   238	
   239	        let start_img_x = ((player_x - center_x) / scale + 64).clamp(0, 127) as usize;
   240	        let start_img_z = ((player_z - center_z) / scale + 64).clamp(0, 127) as usize;
   241	
   242	        let radius = 16;
   243	        let (range_x, range_z) = if self.fully_updated {
   244	            (
   245	                (start_img_x.saturating_sub(radius))..(start_img_x + radius).min(128),
   246	                (start_img_z.saturating_sub(radius))..(start_img_z + radius).min(128),
   247	            )
   248	        } else {
   249	            self.fully_updated = true;
   250	            (0..128, 0..128)
   251	        };
   252	
   253	        for img_x in range_x {
   254	            let mut prev_y = -1;
   255	            for img_z in range_z.clone() {
   256	                let world_x = (img_x as i32 - 64) * scale + center_x;
   257	                let world_z = (img_z as i32 - 64) * scale + center_z;
   258	
   259	                let top_y = world.get_top_block(Vector2::new(world_x, world_z));
   260	                let block = world.get_block(&BlockPos::new(world_x, top_y, world_z));
   261	
   262	                let color_base = block.map_color;
   263	
   264	                let mut brightness = 2; // Normal
   265	                if prev_y != -1 {
   266	                    if top_y > prev_y {
   267	                        brightness = 3; // High
   268	                    } else if top_y < prev_y {
   269	                        brightness = 1; // Low
   270	                    }
   271	                }
   272	                prev_y = top_y;
   273	
   274	                let color = color_base * 4 + brightness;
   275	                self.set_color(img_x, img_z, color);
   276	            }
   277	        }
   278	    }
   279	}

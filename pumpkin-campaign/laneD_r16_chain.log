   158	   private void spawnOminousOminousItemSpawner(final ServerLevel level, final BlockPos trialSpawnerPos, final TrialSpawner trialSpawner) {
   159	      TrialSpawnerStateData data = trialSpawner.getStateData();
   160	      TrialSpawnerConfig config = trialSpawner.activeConfig();
   161	      ItemStack itemToDispense = data.getDispensingItems(level, config, trialSpawnerPos).getRandom(level.getRandom()).orElse(ItemStack.EMPTY);
   162	      if (!itemToDispense.isEmpty()) {
   163	         if (this.timeToSpawnItemSpawner(level, data)) {
   164	            calculatePositionToSpawnSpawner(level, trialSpawnerPos, trialSpawner, data).ifPresent(pos -> {
   165	               OminousItemSpawner itemSpawner = OminousItemSpawner.create(level, itemToDispense);
   166	               itemSpawner.snapTo(pos);
   167	               level.addFreshEntity(itemSpawner);
   168	               float pitch = (level.getRandom().nextFloat() - level.getRandom().nextFloat()) * 0.2F + 1.0F;
   169	               level.playSound(null, BlockPos.containing(pos), SoundEvents.TRIAL_SPAWNER_SPAWN_ITEM_BEGIN, SoundSource.BLOCKS, 1.0F, pitch);
   170	               data.cooldownEndsAt = level.getGameTime() + trialSpawner.ominousConfig().ticksBetweenItemSpawners();
   171	            });
   172	         }
   173	      }
   174	   }

   258	   public static void addTargetDecoration(final ItemStack itemStack, final BlockPos position, final String key, final Holder<MapDecorationType> decorationType) {
   259	      MapDecorations.Entry newDecoration = new MapDecorations.Entry(decorationType, position.getX(), position.getZ(), 180.0F);
   260	      itemStack.update(DataComponents.MAP_DECORATIONS, MapDecorations.EMPTY, decorations -> decorations.withDecoration(key, newDecoration));
   261	      if (decorationType.value().hasMapColor()) {
   262	         itemStack.set(DataComponents.MAP_COLOR, new MapItemColor(decorationType.value().mapColor()));
   263	      }
   264	   }
   265	
   266	   private void addDecoration(
   267	      final Holder<MapDecorationType> type,
   268	      final @Nullable LevelAccessor level,
   269	      final String key,
   270	      final double xPos,
   271	      final double zPos,
   272	      final double yRot,
   273	      final @Nullable Component name
   274	   ) {
   275	      int scaling = 1 << this.scale;
   276	      float xDeltaFromCenter = (float)(xPos - this.centerX) / scaling;
   277	      float yDeltaFromCenter = (float)(zPos - this.centerZ) / scaling;
   278	      MapItemSavedData.MapDecorationLocation locationAndType = this.calculateDecorationLocationAndType(type, level, yRot, xDeltaFromCenter, yDeltaFromCenter);
   279	      if (locationAndType == null) {
   280	         this.removeDecoration(key);
   281	      } else {
   282	         MapDecoration newDecoration = new MapDecoration(
   283	            locationAndType.type(), locationAndType.x(), locationAndType.y(), locationAndType.rot(), Optional.ofNullable(name)
   284	         );
   285	         MapDecoration previousDecoration = this.decorations.put(key, newDecoration);
   286	         if (!newDecoration.equals(previousDecoration)) {
   287	            if (previousDecoration != null && previousDecoration.type().value().trackCount()) {
   288	               this.trackedDecorationCount--;
   289	            }
   290	
   291	            if (locationAndType.type().value().trackCount()) {
   292	               this.trackedDecorationCount++;
   293	            }
   294	
   295	            this.setDecorationsDirty();
   296	         }
   297	      }
   298	   }
   299	
   300	   private MapItemSavedData.@Nullable MapDecorationLocation calculateDecorationLocationAndType(
   301	      final Holder<MapDecorationType> type, final @Nullable LevelAccessor level, final double yRot, final float xDeltaFromCenter, final float yDeltaFromCenter
   302	   ) {
   303	      byte clampedXDeltaFromCenter = clampMapCoordinate(xDeltaFromCenter);
   304	      byte clampedYDeltaFromCenter = clampMapCoordinate(yDeltaFromCenter);
   305	      if (type.is(MapDecorationTypes.PLAYER)) {
   306	         Pair<Holder<MapDecorationType>, Byte> typeAndRotation = this.playerDecorationTypeAndRotation(type, level, yRot, xDeltaFromCenter, yDeltaFromCenter);
   307	         return typeAndRotation == null
   308	            ? null
   309	            : new MapItemSavedData.MapDecorationLocation(
   310	               typeAndRotation.getFirst(), clampedXDeltaFromCenter, clampedYDeltaFromCenter, typeAndRotation.getSecond()
   311	            );
   312	      } else {
   313	         return !isInsideMap(xDeltaFromCenter, yDeltaFromCenter) && !this.unlimitedTracking
   314	            ? null
   315	            : new MapItemSavedData.MapDecorationLocation(type, clampedXDeltaFromCenter, clampedYDeltaFromCenter, this.calculateRotation(level, yRot));
   316	      }
   317	   }
   318	
   319	   private @Nullable Pair<Holder<MapDecorationType>, Byte> playerDecorationTypeAndRotation(
   320	      final Holder<MapDecorationType> type, final @Nullable LevelAccessor level, final double yRot, final float xDeltaFromCenter, final float yDeltaFromCenter
   321	   ) {
   322	      if (isInsideMap(xDeltaFromCenter, yDeltaFromCenter)) {
   323	         return Pair.of(type, this.calculateRotation(level, yRot));
   324	      }
   325	
   326	      Holder<MapDecorationType> outsideMapDecorationType = this.decorationTypeForPlayerOutsideMap(xDeltaFromCenter, yDeltaFromCenter);
   327	      return outsideMapDecorationType == null ? null : Pair.of(outsideMapDecorationType, (byte)0);
   328	   }
   329	
   330	   private byte calculateRotation(final @Nullable LevelAccessor level, final double yRot) {
   331	      if (this.dimension == Level.NETHER && level != null) {
   332	         int s = (int)(level.getGameTime() / 10L);
   333	         return (byte)(s * s * 34187121 + s * 121 >> 15 & 15);
   334	      } else {
   335	         double adjustedYRot = yRot < 0.0 ? yRot - 8.0 : yRot + 8.0;
   336	         return (byte)(adjustedYRot * 16.0 / 360.0);
   337	      }
   338	   }
   339	
   340	   private static boolean isInsideMap(final float xd, final float yd) {
   341	      int halfSize = 63;
   342	      return xd >= -63.0F && yd >= -63.0F && xd <= 63.0F && yd <= 63.0F;
   343	   }
   344	
   345	   private @Nullable Holder<MapDecorationType> decorationTypeForPlayerOutsideMap(final float xDeltaFromCenter, final float yDeltaFromCenter) {
   346	      int rangeLimit = 320;
   347	      boolean isWithinLimits = Math.abs(xDeltaFromCenter) < 320.0F && Math.abs(yDeltaFromCenter) < 320.0F;
   348	      if (isWithinLimits) {
   349	         return MapDecorationTypes.PLAYER_OFF_MAP;
   350	      } else {
   351	         return this.unlimitedTracking ? MapDecorationTypes.PLAYER_OFF_LIMITS : null;
   352	      }
   353	   }
   354	
   355	   private static byte clampMapCoordinate(final float deltaFromCenter) {
   356	      int halfSize = 63;
   357	      if (deltaFromCenter <= -63.0F) {
   358	         return -128;
   359	      } else {
   360	         return deltaFromCenter >= 63.0F ? 127 : (byte)(deltaFromCenter * 2.0F + 0.5);
   361	      }
   362	   }

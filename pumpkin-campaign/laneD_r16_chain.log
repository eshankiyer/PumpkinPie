   203	pub async fn velocity(
   204	    entity: &Entity,
   205	    inventory: &MinecartInventory,
   206	    velocity: Vector3<f64>,
   207	) -> Vector3<f64> {
   208	    let signal = crate::block::calculate_comparator_output(inventory).await;
   209	    let mut friction = if inventory.has_loot_table().await {
   210	        0.98
   211	    } else {
   212	        0.98 + f64::from(15 - signal) * 0.001
   213	    };
   214	    if entity
   215	        .touching_water
   216	        .load(std::sync::atomic::Ordering::Relaxed)
   217	    {
   218	        friction *= 0.95;
   219	    }
   220	    velocity.multiply(friction, 0.0, friction)
   221	}

   392	   public boolean toggleBanner(final LevelAccessor level, final BlockPos pos) {
   393	      double xPos = pos.getX() + 0.5;
   394	      double zPos = pos.getZ() + 0.5;
   395	      int scale = 1 << this.scale;
   396	      double xd = (xPos - this.centerX) / scale;
   397	      double yd = (zPos - this.centerZ) / scale;
   398	      int halfSize = 63;
   399	      if (xd >= -63.0 && yd >= -63.0 && xd <= 63.0 && yd <= 63.0) {
   400	         MapBanner banner = MapBanner.fromWorld(level, pos);
   401	         if (banner == null) {
   402	            return false;
   403	         }
   404	
   405	         if (this.bannerMarkers.remove(banner.getId(), banner)) {
   406	            this.removeDecoration(banner.getId());
   407	            this.setDirty();
   408	            return true;
   409	         }
   410	
   411	         if (!this.isTrackedCountOverLimit(256)) {
   412	            this.bannerMarkers.put(banner.getId(), banner);
   413	            this.addDecoration(banner.getDecoration(), level, banner.getId(), xPos, zPos, 180.0, banner.name().orElse(null));
   414	            this.setDirty();
   415	            return true;
   416	         }
   417	      }
   418	
   419	      return false;
   420	   }

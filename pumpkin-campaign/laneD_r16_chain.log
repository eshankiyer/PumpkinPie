   176	pub async fn open(
   177	    entity: &Entity,
   178	    player: &Arc<Player>,
   179	    inventory: &Arc<MinecartInventory>,
   180	    title: TextComponent,
   181	    hopper: bool,
   182	) -> bool {
   183	    if player.is_spectator() && inventory.has_loot_table().await {
   184	        return false;
   185	    }
   186	    if !player.is_spectator() {
   187	        inventory.unpack_loot().await;
   188	    }
   189	
   190	    player
   191	        .open_handled_screen(
   192	            &MinecartScreenFactory {
   193	                inventory: inventory.clone(),
   194	                title: entity.custom_name.load().as_ref().clone().unwrap_or(title),
   195	                hopper,
   196	            },
   197	            None,
   198	        )
   199	        .await
   200	        .is_some()
   201	}

   183	        let z_pos = f64::from(position.0.z) + 0.5;
   184	        let x_delta = (x_pos - f64::from(self.center_x)) / f64::from(scale);
   185	        let z_delta = (z_pos - f64::from(self.center_z)) / f64::from(scale);
   186	        if !(-63.0..=63.0).contains(&x_delta) || !(-63.0..=63.0).contains(&z_delta) {
   187	            return false;
   188	        }
   189	
   190	        let key = format!("banner-{},{},{}", position.0.x, position.0.y, position.0.z);
   191	        if let Some(index) = self
   192	            .decorations
   193	            .iter()
   194	            .position(|decoration| decoration.key == key)
   195	        {
   196	            if self.decorations[index].icon_type == decoration_type.id as i32
   197	                && self.decorations[index].display_name.as_ref() == display_name.as_ref()
   198	            {
   199	                self.decorations.remove(index);
   200	            } else {
   201	                self.decorations[index] = MapDecoration {
   202	                    key,
   203	                    icon_type: decoration_type.id as i32,
   204	                    x: clamp_map_coordinate(x_delta),

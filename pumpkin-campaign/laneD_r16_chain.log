   176	   private static Optional<Vec3> calculatePositionToSpawnSpawner(
   177	      final ServerLevel level, final BlockPos trialSpawnerPos, final TrialSpawner trialSpawner, final TrialSpawnerStateData data
   178	   ) {
   179	      List<Player> nearbyPlayers = data.detectedPlayers
   180	         .stream()
   181	         .map(level::getPlayerByUUID)
   182	         .filter(Objects::nonNull)
   183	         .filter(
   184	            player -> !player.isCreative()
   185	               && !player.isSpectator()
   186	               && player.isAlive()
   187	               && player.distanceToSqr(Vec3.atCenterOf(trialSpawnerPos)) <= Mth.square(trialSpawner.getRequiredPlayerRange())
   188	         )
   189	         .toList();
   190	      if (nearbyPlayers.isEmpty()) {
   191	         return Optional.empty();
   192	      }
   193	
   194	      Entity entity = selectEntityToSpawnItemAbove(nearbyPlayers, data.currentMobs, trialSpawner, trialSpawnerPos, level);
   195	      return entity == null ? Optional.empty() : calculatePositionAbove(entity, level);
   196	   }

    85	   private MapItemSavedData(
    86	      final int centerX,
    87	      final int centerZ,
    88	      final byte scale,
    89	      final boolean trackingPosition,
    90	      final boolean unlimitedTracking,
    91	      final boolean locked,
    92	      final ResourceKey<Level> dimension
    93	   ) {
    94	      this.scale = scale;
    95	      this.centerX = centerX;
    96	      this.centerZ = centerZ;
    97	      this.dimension = dimension;

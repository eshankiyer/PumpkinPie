   166	   private static Predicate<ItemStack> mapMatcher(final ItemStack mapStack) {
   167	      MapId mapId = mapStack.get(DataComponents.MAP_ID);
   168	      return stack -> stack == mapStack ? true : stack.is(mapStack.getItem()) && Objects.equals(mapId, stack.get(DataComponents.MAP_ID));
   169	   }
   170	
   171	   public void tickCarriedBy(final Player tickingPlayer, final ItemStack itemStack, final @Nullable ItemFrame placedInFrame) {
   172	      if (!this.carriedByPlayers.containsKey(tickingPlayer)) {
   173	         MapItemSavedData.HoldingPlayer holdingPlayer = new MapItemSavedData.HoldingPlayer(tickingPlayer);
   174	         this.carriedByPlayers.put(tickingPlayer, holdingPlayer);
   175	         this.carriedBy.add(holdingPlayer);
   176	      }
   177	
   178	      Predicate<ItemStack> mapMatcher = mapMatcher(itemStack);
   179	      if (!tickingPlayer.getInventory().contains(mapMatcher)) {
   180	         this.removeDecoration(tickingPlayer.getPlainTextName());
   181	      }
   182	
   183	      for (int i = 0; i < this.carriedBy.size(); i++) {
   184	         MapItemSavedData.HoldingPlayer otherHoldingPlayer = this.carriedBy.get(i);
   185	         Player otherPlayer = otherHoldingPlayer.player;
   186	         String otherPlayerName = otherPlayer.getPlainTextName();
   187	         if (!otherPlayer.isRemoved() && (placedInFrame != null || otherPlayer.getInventory().contains(mapMatcher))) {
   188	            if (placedInFrame == null && otherPlayer.level().dimension() == this.dimension && this.trackingPosition) {
   189	               this.addDecoration(
   190	                  MapDecorationTypes.PLAYER, otherPlayer.level(), otherPlayerName, otherPlayer.getX(), otherPlayer.getZ(), otherPlayer.getYRot(), null
   191	               );
   192	            }
   193	         } else {
   194	            this.carriedByPlayers.remove(otherPlayer);
   195	            this.carriedBy.remove(otherHoldingPlayer);
   196	            this.removeDecoration(otherPlayerName);
   197	         }
   198	
   199	         if (!otherPlayer.equals(tickingPlayer) && hasMapInvisibilityItemEquipped(otherPlayer)) {
   200	            this.removeDecoration(otherPlayerName);
   201	         }
   202	      }
   203	
   204	      if (placedInFrame != null && this.trackingPosition) {
   205	         BlockPos pos = placedInFrame.getPos();
   206	         MapFrame existingFrame = this.frameMarkers.get(MapFrame.frameId(pos));
   207	         if (existingFrame != null && placedInFrame.getId() != existingFrame.entityId() && this.frameMarkers.containsKey(existingFrame.getId())) {
   208	            this.removeDecoration(getFrameKey(existingFrame.entityId()));
   209	         }
   210	
   211	         MapFrame mapFrame = new MapFrame(pos, placedInFrame.getDirection().get2DDataValue() * 90, placedInFrame.getId());
   212	         this.addDecoration(
   213	            MapDecorationTypes.FRAME,
   214	            tickingPlayer.level(),
   215	            getFrameKey(placedInFrame.getId()),
   216	            pos.getX(),
   217	            pos.getZ(),
   218	            placedInFrame.getDirection().get2DDataValue() * 90,
   219	            null
   220	         );
   221	         MapFrame oldFrame = this.frameMarkers.put(mapFrame.getId(), mapFrame);
   222	         if (!mapFrame.equals(oldFrame)) {
   223	            this.setDirty();
   224	         }
   225	      }
   226	
   227	      MapDecorations staticDecorations = itemStack.getOrDefault(DataComponents.MAP_DECORATIONS, MapDecorations.EMPTY);
   228	      if (!this.decorations.keySet().containsAll(staticDecorations.decorations().keySet())) {
   229	         staticDecorations.decorations().forEach((id, entry) -> {
   230	            if (!this.decorations.containsKey(id)) {
   231	               this.addDecoration(entry.type(), tickingPlayer.level(), id, entry.x(), entry.z(), entry.rotation(), null);
   232	            }
   233	         });
   234	      }
   235	   }
   236	
   237	   private static boolean hasMapInvisibilityItemEquipped(final Player player) {
   238	      for (EquipmentSlot equipmentSlot : EquipmentSlot.values()) {
   239	         if (equipmentSlot != EquipmentSlot.MAINHAND
   240	            && equipmentSlot != EquipmentSlot.OFFHAND
   241	            && player.getItemBySlot(equipmentSlot).is(ItemTags.MAP_INVISIBILITY_EQUIPMENT)) {
   242	            return true;
   243	         }
   244	      }
   245	
   246	      return false;
   247	   }

   103	   private MapItemSavedData(
   104	      final ResourceKey<Level> dimension,
   105	      final int centerX,
   106	      final int centerZ,
   107	      final byte scale,
   108	      final ByteBuffer colors,
   109	      final boolean trackingPosition,
   110	      final boolean unlimitedTracking,
   111	      final boolean locked,
   112	      final List<MapBanner> banners,
   113	      final List<MapFrame> frames
   114	   ) {
   115	      this(centerX, centerZ, (byte)Mth.clamp(scale, 0, 4), trackingPosition, unlimitedTracking, locked, dimension);
   116	      if (colors.array().length == 16384) {
   117	         this.colors = colors.array();
   118	      }
   119	
   120	      for (MapBanner banner : banners) {
   121	         this.bannerMarkers.put(banner.getId(), banner);
   122	         this.addDecoration(banner.getDecoration(), null, banner.getId(), banner.pos().getX(), banner.pos().getZ(), 180.0, banner.name().orElse(null));
   123	      }
   124	
   125	      for (MapFrame frame : frames) {
   126	         this.frameMarkers.put(frame.getId(), frame);
   127	         this.addDecoration(MapDecorationTypes.FRAME, null, getFrameKey(frame.entityId()), frame.pos().getX(), frame.pos().getZ(), frame.rotation(), null);
   128	      }
   129	   }

    67	pub struct MinecartEntity {
    68	    pub vehicle: VehicleEntity,
    69	    kind: MinecartKind,
    70	}
    71	
    72	enum MinecartKind {
    73	    Rideable(RideableMinecart),
    74	    Chest(ChestMinecart),
    75	    Furnace(FurnaceMinecart),
    76	    Hopper(HopperMinecart),
    77	    Tnt(TntMinecart),
    78	    Spawner(SpawnerMinecart),
    79	    CommandBlock(CommandBlockMinecart),
    80	    Other,
    81	}
    82	
    83	impl MinecartEntity {
    84	    pub fn new(entity: Entity) -> Self {
    85	        let kind = match entity.entity_type.id {
    86	            id if id == EntityType::MINECART.id => MinecartKind::Rideable(RideableMinecart),
    87	            id if id == EntityType::CHEST_MINECART.id => MinecartKind::Chest(ChestMinecart::new()),
    88	            id if id == EntityType::FURNACE_MINECART.id => {
    89	                MinecartKind::Furnace(FurnaceMinecart::new())
    90	            }
    91	            id if id == EntityType::HOPPER_MINECART.id => {
    92	                MinecartKind::Hopper(HopperMinecart::new())
    93	            }
    94	            id if id == EntityType::TNT_MINECART.id => MinecartKind::Tnt(TntMinecart::new()),
    95	            id if id == EntityType::SPAWNER_MINECART.id => {
    96	                MinecartKind::Spawner(SpawnerMinecart::new())
    97	            }
    98	            id if id == EntityType::COMMAND_BLOCK_MINECART.id => {
    99	                MinecartKind::CommandBlock(CommandBlockMinecart::new())
   100	            }
   101	            _ => MinecartKind::Other,
   102	        };
   103	        Self {
   104	            vehicle: VehicleEntity::new(entity),
   105	            kind,
   106	        }
   107	    }
   108	
   109	    const fn container(&self) -> Option<&Arc<MinecartInventory>> {
   110	        match &self.kind {
   111	            MinecartKind::Chest(minecart) => Some(minecart.inventory()),
   112	            MinecartKind::Hopper(minecart) => Some(minecart.inventory()),
   113	            _ => None,
   114	        }
   115	    }
   116	
   117	    const fn drop_item(&self) -> Option<&'static Item> {
   118	        match &self.kind {
   119	            MinecartKind::Chest(_) => Some(&Item::CHEST_MINECART),
   120	            MinecartKind::Furnace(_) => Some(&Item::FURNACE_MINECART),
   121	            MinecartKind::Hopper(_) => Some(&Item::HOPPER_MINECART),
   122	            MinecartKind::Tnt(_) => Some(&Item::TNT_MINECART),
   123	            // `MinecartSpawner.getDropItem` (MinecartSpawner.java:31-33): a broken
   124	            // spawner minecart drops a plain minecart, not a minecart-with-spawner item.
   125	            // `MinecartCommandBlock.getDropItem` (MinecartCommandBlock.java:41-43)
   126	            // does the same for the command block variant.
   127	            MinecartKind::Spawner(_) | MinecartKind::CommandBlock(_) => Some(&Item::MINECART),
   128	            _ => None,
   129	        }
   130	    }
   131	
   132	    /// `DetectorRailBlock.getAnalogOutputSignal` (DetectorRailBlock.java:145-159) reads the
   133	    /// command minecart's success count before checking container minecarts.
   134	    pub async fn comparator_output(&self) -> u8 {
   135	        match &self.kind {
   136	            MinecartKind::CommandBlock(minecart) => comparator_signal_from_success_count(
   137	                minecart.command_block.success_count.load(Ordering::Relaxed),
   138	            ),
   139	            MinecartKind::Chest(minecart) => {
   140	                crate::block::calculate_comparator_output(minecart.inventory().as_ref()).await
   141	            }
   142	            MinecartKind::Hopper(minecart) => {
   143	                crate::block::calculate_comparator_output(minecart.inventory().as_ref()).await
   144	            }
   145	            MinecartKind::Rideable(_)
   146	            | MinecartKind::Furnace(_)
   147	            | MinecartKind::Tnt(_)
   148	            | MinecartKind::Spawner(_)
   149	            | MinecartKind::Other => 0,
   150	        }
   151	    }
   152	}
   153	
   154	/// `DetectorRailBlock.getAnalogOutputSignal` (DetectorRailBlock.java:145-159) is exposed through
   155	/// the redstone signal's 0-15 range even though a command block stores an integer success count.
   156	const fn comparator_signal_from_success_count(success_count: u32) -> u8 {
   157	    if success_count > 15 {
   158	        15
   159	    } else {
   160	        success_count as u8
   161	    }
   162	}

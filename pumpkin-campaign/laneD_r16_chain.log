   164	impl NBTStorage for MinecartEntity {
   165	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   166	        Box::pin(async move {
   167	            self.vehicle.entity.write_nbt(nbt).await;
   168	            match &self.kind {
   169	                MinecartKind::Chest(minecart) => minecart.write_nbt(nbt).await,
   170	                MinecartKind::Furnace(minecart) => minecart.write_nbt(nbt),
   171	                MinecartKind::Hopper(minecart) => minecart.write_nbt(nbt).await,
   172	                MinecartKind::Tnt(minecart) => minecart.write_nbt(nbt),
   173	                MinecartKind::Spawner(minecart) => minecart.write_nbt(nbt),
   174	                // `MinecartCommandBlock.addAdditionalSaveData`
   175	                // (MinecartCommandBlock.java:66-69) saves the carried command block.
   176	                MinecartKind::CommandBlock(minecart) => minecart.write_nbt(nbt).await,
   177	                MinecartKind::Rideable(_) | MinecartKind::Other => {}
   178	            }
   179	        })
   180	    }
   181	
   182	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   183	        Box::pin(async move {
   184	            self.vehicle.entity.read_nbt_non_mut(nbt).await;
   185	            match &self.kind {
   186	                MinecartKind::Chest(minecart) => minecart.read_nbt(nbt).await,
   187	                MinecartKind::Furnace(minecart) => minecart.read_nbt(nbt),
   188	                MinecartKind::Hopper(minecart) => minecart.read_nbt(nbt).await,
   189	                MinecartKind::Tnt(minecart) => minecart.read_nbt(nbt),
   190	                MinecartKind::Spawner(minecart) => minecart.read_nbt(nbt),
   191	                // `MinecartCommandBlock.readAdditionalSaveData`
   192	                // (MinecartCommandBlock.java:58-63) loads the carried command block.
   193	                MinecartKind::CommandBlock(minecart) => minecart.read_nbt(nbt).await,
   194	                MinecartKind::Rideable(_) | MinecartKind::Other => {}
   195	            }
   196	        })
   197	    }
   198	}

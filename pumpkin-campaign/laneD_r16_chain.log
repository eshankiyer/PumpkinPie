   422	   public void checkBanners(final BlockGetter level, final int x, final int z) {
   423	      Iterator<MapBanner> iterator = this.bannerMarkers.values().iterator();
   424	
   425	      while (iterator.hasNext()) {
   426	         MapBanner expected = iterator.next();
   427	         if (expected.pos().getX() == x && expected.pos().getZ() == z) {
   428	            MapBanner current = MapBanner.fromWorld(level, expected.pos());
   429	            if (!expected.equals(current)) {
   430	               iterator.remove();
   431	               this.removeDecoration(expected.getId());
   432	               this.setDirty();
   433	            }
   434	         }
   435	      }
   436	   }

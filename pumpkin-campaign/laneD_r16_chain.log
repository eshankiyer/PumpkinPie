   207	   private static @Nullable Entity selectEntityToSpawnItemAbove(
   208	      final List<Player> nearbyPlayers, final Set<UUID> mobIds, final TrialSpawner trialSpawner, final BlockPos spawnerPos, final ServerLevel level
   209	   ) {
   210	      Stream<Entity> nearbyMobs = mobIds.stream()
   211	         .map(level::getEntity)
   212	         .filter(Objects::nonNull)
   213	         .filter(target -> target.isAlive() && target.distanceToSqr(Vec3.atCenterOf(spawnerPos)) <= Mth.square(trialSpawner.getRequiredPlayerRange()));
   214	      RandomSource random = level.getRandom();
   215	      List<? extends Entity> eligibleEntities = random.nextBoolean() ? nearbyMobs.toList() : nearbyPlayers;
   216	      if (eligibleEntities.isEmpty()) {
   217	         return null;
   218	      } else {
   219	         return eligibleEntities.size() == 1 ? eligibleEntities.getFirst() : Util.getRandom(eligibleEntities, random);
   220	      }
   221	   }

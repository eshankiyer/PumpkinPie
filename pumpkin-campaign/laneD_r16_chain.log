    53	/// Applies the map item post-processing marker before a crafted result is delivered.
    54	///
    55	/// `MapItem.onCraftedPostProcess` (`MapItem.java:289-303`) creates a fresh saved map for
    56	/// SCALE or LOCK and replaces the result's map id.
    57	pub async fn process_crafted_map(stack: &mut ItemStack, world: &Arc<World>) {
    58	    let Some(processing) = stack
    59	        .get_data_component::<MapPostProcessingImpl>()
    60	        .map(|value| value.processing)
    61	    else {
    62	        return;
    63	    };
    64	    // `MapItem.onCraftedPostProcess` removes the marker before looking up the source map
    65	    // (`MapItem.java:289-303`), so failed lookups do not leave a one-shot marker behind.
    66	    stack
    67	        .patch
    68	        .retain(|(id, _)| *id != DataComponent::MapPostProcessing);
    69	    let Some(map_id) = stack
    70	        .get_data_component::<MapIdImpl>()
    71	        .map(|value| value.id)
    72	    else {
    73	        return;
    74	    };
    75	    let Some(server) = world.server.upgrade() else {
    76	        return;
    77	    };
    78	    let Some(source) = server.map_manager.get_map(map_id) else {
    79	        return;
    80	    };
    81	    let source = source.lock().await;
    82	    let new_data = match processing {
    83	        MapPostProcessing::Lock => source.locked_copy(),
    84	        MapPostProcessing::Scale => source.scaled(),
    85	    };
    86	    drop(source);
    87	
    88	    let new_id = server.next_map_id();
    89	    server
    90	        .map_manager
    91	        .maps
    92	        .insert(new_id, Arc::new(Mutex::new(new_data)));
    93	    stack.patch.retain(|(id, _)| *id != DataComponent::MapId);
    94	    stack.patch.push((
    95	        DataComponent::MapId,
    96	        Some(MapIdImpl { id: new_id }.to_dyn()),
    97	    ));
    98	}

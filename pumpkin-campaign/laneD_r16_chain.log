   153	impl ScreenHandlerFactory for MinecartScreenFactory {
   154	    fn create_screen_handler<'a>(
   155	        &'a self,
   156	        sync_id: u8,
   157	        player_inventory: &'a Arc<PlayerInventory>,
   158	        _player: &'a dyn InventoryPlayer,
   159	    ) -> BoxFuture<'a, Option<SharedScreenHandler>> {

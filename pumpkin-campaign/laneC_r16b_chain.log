   111	/// `MultifaceSpreader.getSpreadFromFaceTowardDirection`.
   112	///
   113	/// Uses the config's own `canSpreadInto` as the spread predicate (vanilla also exposes
   114	/// a variant taking an arbitrary predicate, e.g. for `canSpreadInAnyDirection`'s dry-run
   115	/// check; here that's just this same function reused, since our `can_spread_into`
   116	/// already takes the same arguments as vanilla's `SpreadPredicate`).
   117	#[must_use]
   118	pub fn get_spread_from_face_toward_direction(
   119	    config: &dyn SpreadConfig,
   120	    accessor: &dyn BlockAccessor,
   121	    faces: FaceSet,
   122	    pos: BlockPos,
   123	    starting_face: BlockDirection,
   124	    spread_direction: BlockDirection,
   125	) -> Option<SpreadPos> {
   126	    if spread_direction.to_axis() == starting_face.to_axis() {
   127	        return None;
   128	    }
   129	
   130	    let can_spread = config.is_other_block_valid_as_source(faces)
   131	        || (config.has_face(faces, starting_face) && !config.has_face(faces, spread_direction));
   132	    if !can_spread {
   133	        return None;
   134	    }
   135	
   136	    for &spread_type in config.spread_types() {
   137	        let candidate = spread_type.spread_pos(pos, spread_direction, starting_face);
   138	        if config.can_spread_into(accessor, &pos, candidate) {
   139	            return Some(candidate);
   140	        }
   141	    }
   142	    None
   143	}

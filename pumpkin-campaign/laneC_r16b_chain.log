    20	impl LevelCache {
    21	    fn clean(&mut self, pos: ChunkPos, level: i8) {
    22	        let dst = ChunkLoading::MAX_LEVEL - level + 1;
    23	        self.0 = pos.x - dst as i32;
    24	        self.1 = pos.y - dst as i32;
    25	        self.2 = (dst as usize) << 1 | 1;
    26	        self.3[..self.2 * self.2].fill((-127, -127));
    27	    }
    28	    fn get(&mut self, map: &ChunkLevel, pos: ChunkPos) -> i8 {
    29	        let dx = (pos.x - self.0) as usize;
    30	        let dy = (pos.y - self.1) as usize;
    31	        debug_assert!(pos.x >= self.0 && pos.y >= self.1);
    32	        let value = &mut self.3[dx * self.2 + dy];
    33	        if value.0 == -127 {
    34	            value.0 = *map.get(&pos).unwrap_or(&ChunkLoading::MAX_LEVEL);
    35	            value.1 = value.0;
    36	        }
    37	        value.1
    38	    }
    39	    fn set(&mut self, map: &ChunkLevel, pos: ChunkPos, level: i8) {
    40	        let dx = (pos.x - self.0) as usize;
    41	        let dy = (pos.y - self.1) as usize;
    42	        debug_assert!(pos.x >= self.0 && pos.y >= self.1);
    43	        let value = &mut self.3[dx * self.2 + dy];
    44	        if value.0 == -127 {
    45	            value.0 = *map.get(&pos).unwrap_or(&ChunkLoading::MAX_LEVEL);
    46	        }
    47	        value.1 = level;
    48	    }
    49	    fn write(
    50	        &self,
    51	        map: &mut ChunkLevel,
    52	        change: &mut HashMapType<ChunkPos, (StagedChunkEnum, StagedChunkEnum)>,
    53	    ) {
    54	        for i in 0..self.2 {
    55	            for j in 0..self.2 {
    56	                let value = self.3[i * self.2 + j];
    57	                if value.0 != value.1 {
    58	                    let pos = ChunkPos::new(i as i32 + self.0, j as i32 + self.1);
    59	                    if value.1 == ChunkLoading::MAX_LEVEL {
    60	                        map.remove(&pos);
    61	                    } else {
    62	                        map.insert(pos, value.1);
    63	                    }
    64	                    let value = (
    65	                        StagedChunkEnum::level_to_stage(value.0),
    66	                        StagedChunkEnum::level_to_stage(value.1),
    67	                    );
    68	                    if value.0 == value.1 {
    69	                        continue;
    70	                    }
    71	                    match change.entry(pos) {
    72	                        Entry::Occupied(mut entry) => {
    73	                            let i = entry.get_mut();
    74	                            debug_assert_eq!(i.1, value.0);
    75	                            if i.0 == value.1 {
    76	                                entry.remove();
    77	                            } else {
    78	                                i.1 = value.1;
    79	                            }
    80	                        }
    81	                        Entry::Vacant(entry) => {
    82	                            entry.insert(value);
    83	                        }
    84	                    }
    85	                }
    86	            }
    87	        }
    88	    }
    89	}

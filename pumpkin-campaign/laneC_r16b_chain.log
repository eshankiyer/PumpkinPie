   625	    pub fn clean_up(&mut self, level: &Arc<Level>) {
   626	        let mut lock = level
   627	            .chunk_loading
   628	            .lock()
   629	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   630	        if let Some((view_level, sim_level)) = self.held_tickets.take() {
   631	            lock.remove_ticket(self.center, view_level);
   632	            lock.remove_ticket(self.center, sim_level);
   633	        }
   634	        lock.send_change();
   635	        level.should_unload.store(true, Ordering::Relaxed);
   636	        level.level_channel.notify();
   637	        let (_rx, tx) = crossbeam::channel::unbounded();
   638	        // drop old channel
   639	        self.chunk_listener = tx;
   640	
   641	        // Drop any held chunk references to allow chunks to be unloaded.
   642	        self.chunk_sent.clear();
   643	        self.chunk_queue.clear();
   644	        self.entity_chunk_queue.clear();
   645	        self.batches_sent_since_ack = 0;
   646	        self.last_chunk_batch_sent_at = Instant::now();
   647	        self.view_distance = 0;
   648	    }

    85	/// Returns the server-side step/fall sounds and the vanilla sound volume/pitch modifiers.
    86	/// `BlockBehaviour.getSoundType` returns the registered `SoundType` (`BlockBehaviour.java:405-407`);
    87	/// common material registrations are in `SoundType.java:10-46` and
    88	/// `Blocks.java:83-98,315-324,547-552,557-563`.
    89	#[must_use]
    90	#[expect(clippy::too_many_lines)]
    91	pub(crate) fn block_sound_type(block: &Block) -> (Sound, Sound, f32, f32) {
    92	    let name = block.name;
    93	    match name {
    94	        "anvil" => (Sound::BlockAnvilStep, Sound::BlockAnvilFall, 0.3, 1.0),
    95	        "slime_block" => (
    96	            Sound::BlockSlimeBlockStep,
    97	            Sound::BlockSlimeBlockFall,
    98	            1.0,
    99	            1.0,
   100	        ),
   101	        "honey_block" => (
   102	            Sound::BlockHoneyBlockStep,
   103	            Sound::BlockHoneyBlockFall,
   104	            1.0,
   105	            1.0,
   106	        ),
   107	        "powder_snow" => (
   108	            Sound::BlockPowderSnowStep,
   109	            Sound::BlockPowderSnowFall,
   110	            1.0,
   111	            1.0,
   112	        ),
   113	        "snow" | "snow_block" => (Sound::BlockSnowStep, Sound::BlockSnowFall, 1.0, 1.0),
   114	        "sand" | "red_sand" => (Sound::BlockSandStep, Sound::BlockSandFall, 1.0, 1.0),
   115	        "suspicious_sand" => (
   116	            Sound::BlockSuspiciousSandStep,
   117	            Sound::BlockSuspiciousSandFall,
   118	            1.0,
   119	            1.0,
   120	        ),
   280	            || name.ends_with("copper_grate") =>
   281	        {
   282	            false
   283	        }
   284	        name if name == "shulker_box" || name.ends_with("_shulker_box") => shulker_closed,
   285	        "piston" | "sticky_piston" => !block.properties(state.id).is_some_and(|properties| {
   286	            properties
   287	                .to_props()
   288	                .iter()
   289	                .any(|(key, value)| *key == "extended" && *value == "true")
   290	        }),
   291	        _ => blocks_movement(state, block.id) && state.is_full_cube(),
   292	    }
   293	}

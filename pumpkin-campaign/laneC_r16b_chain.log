   117	                    let level_from_source = level + dx.abs().max(dy.abs());
   118	                    let i = temp.entry(new_pos).or_insert(Self::MAX_LEVEL);
   119	                    *i = min(*i, level_from_source);
   120	                }
   121	            }
   122	        }
   123	        if temp.len() != self.pos_level.len() {
   124	            debug!("temp: \n{temp:?}");
   125	            debug!("pos_level: \n{:?}", self.pos_level);

   254	
   255	    fn check_then_push(&mut self, pos: ChunkPos, level: i8) {
   256	        debug_assert!(level < Self::MAX_LEVEL);
   257	        let old = self.cache.get(&self.pos_level, pos);
   258	        if old <= level {
   259	            return;
   260	        }
   261	        self.cache.set(&self.pos_level, pos, level);
   262	        self.increase_update.push_back((pos, level));
   263	    }
   264	
   265	    fn run_decrease_update(&mut self, pos: ChunkPos, range: i32) {
   266	        while let Some((pos, level)) = self.decrease_update.pop_front() {
   267	            debug_assert!(level < Self::MAX_LEVEL);
   268	            let spread_level = level + 1;
   269	            for dx in -1..2 {
   270	                for dy in -1..2 {
   271	                    let new_pos = pos.add_raw(dx, dy);
   272	                    if new_pos == pos {
   273	                        continue;
   274	                    }
   275	                    let new_pos_level = self.cache.get(&self.pos_level, new_pos);
   276	                    if new_pos_level == Self::MAX_LEVEL {
   277	                        continue;
   278	                    }
   279	                    debug_assert!(new_pos_level <= spread_level);
   280	                    if new_pos_level == spread_level {
   281	                        self.cache.set(&self.pos_level, new_pos, Self::MAX_LEVEL);
   282	                        if spread_level < Self::MAX_LEVEL {
   283	                            self.decrease_update.push_back((new_pos, spread_level));
   284	                        }
   285	                    } else {
   286	                        self.increase_update.push_back((new_pos, new_pos_level));
   287	                    }
   288	                }
   289	            }
   290	        }
   291	
   292	        for (ticket_pos, levels) in &self.ticket {
   293	            if (ticket_pos.x - pos.x).abs() <= range && (ticket_pos.y - pos.y).abs() <= range {
   294	                let Some(&level) = levels.iter().min() else {
   295	                    continue;
   296	                };
   297	                debug_assert!(level < Self::MAX_LEVEL);
   298	                let old = self.cache.get(&self.pos_level, *ticket_pos);
   299	                if old <= level {
   300	                    continue;
   301	                }
   302	                self.cache.set(&self.pos_level, *ticket_pos, level);
   303	                self.increase_update.push_back((*ticket_pos, level));
   304	            }
   305	        }
   306	        self.run_increase_update();
   307	    }

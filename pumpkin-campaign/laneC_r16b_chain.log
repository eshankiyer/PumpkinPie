    27	import net.minecraft.world.phys.shapes.Shapes;
    28	import net.minecraft.world.phys.shapes.VoxelShape;
    29	import org.jspecify.annotations.Nullable;
    30	
    31	public class MultifaceBlock extends Block implements SimpleWaterloggedBlock {
    32	   public static final MapCodec<MultifaceBlock> CODEC = simpleCodec(MultifaceBlock::new);
    33	   public static final BooleanProperty WATERLOGGED = BlockStateProperties.WATERLOGGED;
    34	   private static final Map<Direction, BooleanProperty> PROPERTY_BY_DIRECTION = PipeBlock.PROPERTY_BY_DIRECTION;
    35	   protected static final Direction[] DIRECTIONS = Direction.values();
    36	   private final Function<BlockState, VoxelShape> shapes;
    37	   private final boolean canRotate;
    38	   private final boolean canMirrorX;
    39	   private final boolean canMirrorZ;
    40	
    41	   @Override
    42	   protected MapCodec<? extends MultifaceBlock> codec() {
    43	      return CODEC;
    44	   }
    45	
    46	   public MultifaceBlock(final BlockBehaviour.Properties properties) {
    47	      super(properties);
    48	      this.registerDefaultState(getDefaultMultifaceState(this.stateDefinition));
    49	      this.shapes = this.makeShapes();
    50	      this.canRotate = Direction.Plane.HORIZONTAL.stream().allMatch(this::isFaceSupported);
    51	      this.canMirrorX = Direction.Plane.HORIZONTAL.stream().filter(Direction.Axis.X).filter(this::isFaceSupported).count() % 2L == 0L;
    52	      this.canMirrorZ = Direction.Plane.HORIZONTAL.stream().filter(Direction.Axis.Z).filter(this::isFaceSupported).count() % 2L == 0L;
    53	   }
    54	
    55	   private Function<BlockState, VoxelShape> makeShapes() {
    56	      Map<Direction, VoxelShape> shapes = Shapes.rotateAll(Block.boxZ(16.0, 0.0, 1.0));
    57	      return this.getShapeForEachState(state -> {
    58	         VoxelShape shape = Shapes.empty();
    59	
    60	         for (Direction direction : DIRECTIONS) {
    61	            if (hasFace(state, direction)) {
    62	               shape = Shapes.or(shape, shapes.get(direction));
    63	            }
    64	         }
    65	
    66	         return shape.isEmpty() ? Shapes.block() : shape;
    67	      }, WATERLOGGED);
    68	   }
    69	
    70	   public static Set<Direction> availableFaces(final BlockState state) {
    71	      if (!(state.getBlock() instanceof MultifaceBlock)) {
    72	         return Set.of();
    73	      }
    74	
    75	      Set<Direction> faces = EnumSet.noneOf(Direction.class);
    76	
    77	      for (Direction direction : Direction.values()) {
    78	         if (hasFace(state, direction)) {
    79	            faces.add(direction);
    80	         }
    81	      }
    82	
    83	      return faces;
    84	   }
    85	
    86	   public static Set<Direction> unpack(final byte data) {
    87	      Set<Direction> presentDirections = EnumSet.noneOf(Direction.class);
    88	
    89	      for (Direction direction : Direction.values()) {
    90	         if ((data & (byte)(1 << direction.ordinal())) > 0) {
    91	            presentDirections.add(direction);
    92	         }
    93	      }
    94	
    95	      return presentDirections;
    96	   }
    97	
    98	   public static byte pack(final Collection<Direction> directions) {
    99	      byte code = 0;
   100	
   101	      for (Direction direction : directions) {
   102	         code = (byte)(code | 1 << direction.ordinal());
   103	      }
   104	
   105	      return code;
   106	   }
   107	
   108	   protected boolean isFaceSupported(final Direction faceDirection) {
   109	      return true;
   110	   }
   111	
   112	   @Override
   113	   protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
   114	      for (Direction direction : DIRECTIONS) {
   115	         if (this.isFaceSupported(direction)) {
   116	            builder.add(getFaceProperty(direction));
   117	         }
   118	      }
   119	
   120	      builder.add(WATERLOGGED);
   121	   }
   122	
   123	   @Override
   124	   protected BlockState updateShape(
   125	      final BlockState state,
   126	      final LevelReader level,
   127	      final ScheduledTickAccess ticks,
   128	      final BlockPos pos,
   129	      final Direction directionToNeighbour,
   130	      final BlockPos neighbourPos,
   131	      final BlockState neighbourState,
   132	      final RandomSource random
   133	   ) {
   134	      if (state.getValue(WATERLOGGED)) {
   135	         ticks.scheduleTick(pos, Fluids.WATER, Fluids.WATER.getTickDelay(level));
   136	      }
   137	
   138	      if (!hasAnyFace(state)) {
   139	         return Blocks.AIR.defaultBlockState();
   140	      } else {
   141	         return hasFace(state, directionToNeighbour) && !canAttachTo(level, directionToNeighbour, neighbourPos, neighbourState)
   142	            ? removeFace(state, getFaceProperty(directionToNeighbour))
   143	            : state;
   144	      }
   145	   }
   146	
   147	   @Override
   148	   protected FluidState getFluidState(final BlockState state) {
   149	      return state.getValue(WATERLOGGED) ? Fluids.WATER.getSource(false) : super.getFluidState(state);
   150	   }
   151	
   152	   @Override
   153	   protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
   154	      return this.shapes.apply(state);
   155	   }
   156	
   157	   @Override
   158	   protected boolean canSurvive(final BlockState state, final LevelReader level, final BlockPos pos) {
   159	      boolean hasAtLeastOneFace = false;
   160	
   161	      for (Direction directionToNeighbour : DIRECTIONS) {
   162	         if (hasFace(state, directionToNeighbour)) {
   163	            if (!canAttachTo(level, pos, directionToNeighbour)) {
   164	               return false;
   165	            }
   166	
   167	            hasAtLeastOneFace = true;
   168	         }
   169	      }
   170	
   171	      return hasAtLeastOneFace;
   172	   }
   173	
   174	   @Override
   175	   protected boolean canBeReplaced(final BlockState state, final BlockPlaceContext context) {
   176	      return !context.getItemInHand().is(this.asItem()) || hasAnyVacantFace(state);
   177	   }
   178	
   179	   @Override
   180	   public @Nullable BlockState getStateForPlacement(final BlockPlaceContext context) {
   181	      Level level = context.getLevel();
   182	      BlockPos placePos = context.getClickedPos();
   183	      BlockState oldState = level.getBlockState(placePos);
   184	      return Arrays.stream(context.getNearestLookingDirections())
   185	         .map(direction -> this.getStateForPlacement(oldState, level, placePos, direction))
   186	         .filter(Objects::nonNull)
   187	         .findFirst()
   188	         .orElse(null);
   189	   }
   190	
   191	   public boolean isValidStateForPlacement(final BlockGetter level, final BlockState oldState, final BlockPos placementPos, final Direction placementDirection) {
   192	      if (this.isFaceSupported(placementDirection) && (!oldState.is(this) || !hasFace(oldState, placementDirection))) {
   193	         BlockPos neighbourPos = placementPos.relative(placementDirection);
   194	         return canAttachTo(level, placementDirection, neighbourPos, level.getBlockState(neighbourPos));
   195	      } else {
   196	         return false;
   197	      }
   198	   }
   199	
   200	   public @Nullable BlockState getStateForPlacement(
   201	      final BlockState oldState, final BlockGetter level, final BlockPos placementPos, final Direction placementDirection
   202	   ) {
   203	      if (!this.isValidStateForPlacement(level, oldState, placementPos, placementDirection)) {
   204	         return null;
   205	      }
   206	
   207	      BlockState newState;
   208	      if (oldState.is(this)) {
   209	         newState = oldState;
   210	      } else if (oldState.getFluidState().isSourceOfType(Fluids.WATER)) {
   211	         newState = this.defaultBlockState().setValue(BlockStateProperties.WATERLOGGED, true);
   212	      } else {
   213	         newState = this.defaultBlockState();
   214	      }
   215	
   216	      return newState.setValue(getFaceProperty(placementDirection), true);
   217	   }
   218	
   219	   @Override
   220	   protected BlockState rotate(final BlockState state, final Rotation rotation) {
   221	      return !this.canRotate ? state : this.mapDirections(state, rotation::rotate);
   222	   }
   223	
   224	   @Override
   225	   protected BlockState mirror(final BlockState state, final Mirror mirror) {
   226	      if (mirror == Mirror.FRONT_BACK && !this.canMirrorX) {
   227	         return state;
   228	      } else {
   229	         return mirror == Mirror.LEFT_RIGHT && !this.canMirrorZ ? state : this.mapDirections(state, mirror::mirror);
   230	      }
   231	   }
   232	
   233	   private BlockState mapDirections(final BlockState state, final Function<Direction, Direction> mapping) {
   234	      BlockState newState = state;
   235	
   236	      for (Direction direction : DIRECTIONS) {
   237	         if (this.isFaceSupported(direction)) {
   238	            newState = newState.setValue(getFaceProperty(mapping.apply(direction)), state.getValue(getFaceProperty(direction)));
   239	         }
   240	      }
   241	
   242	      return newState;
   243	   }
   244	
   245	   public static boolean hasFace(final BlockState state, final Direction faceDirection) {
   246	      BooleanProperty property = getFaceProperty(faceDirection);
   247	      return state.getValueOrElse(property, false);
   248	   }
   249	
   250	   public static boolean canAttachTo(final BlockGetter level, final BlockPos pos, final Direction directionTowardsNeighbour) {
   251	      BlockPos neighbourPos = pos.relative(directionTowardsNeighbour);
   252	      BlockState blockState = level.getBlockState(neighbourPos);
   253	      return canAttachTo(level, directionTowardsNeighbour, neighbourPos, blockState);
   254	   }
   255	
   256	   public static boolean canAttachTo(
   257	      final BlockGetter level, final Direction directionTowardsNeighbour, final BlockPos neighbourPos, final BlockState neighbourState
   258	   ) {
   259	      return Block.isFaceFull(neighbourState.getBlockSupportShape(level, neighbourPos), directionTowardsNeighbour.getOpposite())
   260	         || Block.isFaceFull(neighbourState.getCollisionShape(level, neighbourPos), directionTowardsNeighbour.getOpposite());
   261	   }
   262	
   263	   private static BlockState removeFace(final BlockState state, final BooleanProperty property) {
   264	      BlockState newState = state.setValue(property, false);
   265	      return hasAnyFace(newState) ? newState : Blocks.AIR.defaultBlockState();
   266	   }
   267	
   268	   public static BooleanProperty getFaceProperty(final Direction faceDirection) {
   269	      return PROPERTY_BY_DIRECTION.get(faceDirection);
   270	   }
   271	
   272	   private static BlockState getDefaultMultifaceState(final StateDefinition<Block, BlockState> stateDefinition) {
   273	      BlockState state = stateDefinition.any().setValue(WATERLOGGED, false);
   274	
   275	      for (BooleanProperty faceProperty : PROPERTY_BY_DIRECTION.values()) {
   276	         state = state.trySetValue(faceProperty, false);
   277	      }
   278	
   279	      return state;
   280	   }
   281	
   282	   protected static boolean hasAnyFace(final BlockState state) {
   283	      for (Direction direction : DIRECTIONS) {
   284	         if (hasFace(state, direction)) {
   285	            return true;
   286	         }
   287	      }
   288	
   289	      return false;
   290	   }
   291	
   292	   private static boolean hasAnyVacantFace(final BlockState state) {
   293	      for (Direction direction : DIRECTIONS) {
   294	         if (!hasFace(state, direction)) {
   295	            return true;
   296	         }
   297	      }
   298	
   299	      return false;
   300	   }
   301	}

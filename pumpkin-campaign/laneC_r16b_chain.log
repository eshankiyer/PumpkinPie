   488	            lerp_time: persisted_level_info.border_size_lerp_time,
   489	            lerp_target: persisted_level_info.border_size_lerp_target,
   490	        });
   491	        drop(persisted_level_info);
   492	
   493	        // Load portal POI from disk (PoiStorage::new automatically loads from disk if files exist)
   494	        let portal_poi = portal::PortalPoiStorage::new(level.level_folder.poi_folder.clone());
   495	        let dragon_fight = (dimension.minecraft_name == Dimension::THE_END.minecraft_name)
   496	            .then(|| Mutex::new(dragon_fight::DragonFight::new()));
   497	
   498	        let custom_data_path = level
   499	            .level_folder
   500	            .root_folder
   501	            .join("pumpkin_custom_data.nbt");
   502	        let custom_data = if custom_data_path.exists()
   503	            && let Ok(bytes) = std::fs::read(&custom_data_path)
   504	            && let Ok(nbt) = pumpkin_nbt::Nbt::read_unnamed(

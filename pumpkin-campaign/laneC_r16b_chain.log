   234	fn count_bamboo_below(world: &World, pos: &BlockPos) -> usize {
   235	    let mut bamboo_count = 0;
   236	    let mut found_bamboo_below = true;
   237	    let mut current_position = pos.down();
   238	    while found_bamboo_below && bamboo_count < 16 {
   239	        found_bamboo_below = false;
   240	        if world.get_block(&current_position) == &Block::BAMBOO {
   241	            current_position = current_position.down();
   242	            bamboo_count += 1;
   243	            found_bamboo_below = true;
   244	        }
   245	    }
   246	    bamboo_count
   247	}
   248	
   249	fn count_bamboo_above(world: &World, pos: &BlockPos) -> usize {
   250	    let mut bamboo_count = 0;
   251	    let mut found_bamboo_below = true;
   252	    let mut current_position = pos.up();
   253	    while found_bamboo_below && bamboo_count < 16 {
   254	        found_bamboo_below = false;
   255	        if world.get_block(&current_position) == &Block::BAMBOO {
   256	            current_position = current_position.up();
   257	            bamboo_count += 1;
   258	            found_bamboo_below = true;
   259	        }
   260	    }
   261	    bamboo_count
   262	}
   263	
   264	async fn bone_meal(world: Arc<World>, position: &BlockPos) {
   265	    let bamboo_below = count_bamboo_below(&world, position);
   266	
   267	    let growth_amount = rand::rng().random_range(1..=2);
   268	
   269	    for (bamboo_above, _) in (count_bamboo_above(&world, position)..).zip(0..growth_amount) {
   270	        let current_total_height = bamboo_above + bamboo_below + 1;
   271	
   272	        // `next_pos` is the topmost bamboo of the stalk, so the free space we grow into is the
   273	        // block above it. Vanilla reads `STAGE` from the top stalk and grows from there too.
   274	        let next_pos = position.up_height(bamboo_above as i32);
   275	        let next_state = world.get_block_state(&next_pos);
   276	
   277	        if current_total_height >= 16
   278	            || !world.is_in_height_limit(next_pos.up().0.y)
   279	            || !world.get_block_state(&next_pos.up()).is_air()
   280	        {
   281	            return;
   282	        }
   283	
   284	        let next_props = BambooLikeProperties::from_state_id(next_state.id, &Block::BAMBOO);
   285	        if next_props.stage == 1 {
   286	            return;
   287	        }
   288	
   289	        update_leaves_and_grow(Arc::clone(&world), &next_pos).await;
   290	    }
   291	}

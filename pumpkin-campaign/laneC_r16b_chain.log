   445	        z: i32,
   446	    ) -> i32 {
   447	        let chunk_pos = Vector2::new(x >> 4, z >> 4);
   448	        self.level
   449	            .get_or_fetch_chunk(chunk_pos, |chunk| {
   450	                chunk
   451	                    .heightmap
   452	                    .lock()
   453	                    .unwrap_or_else(std::sync::PoisonError::into_inner)
   454	                    .get(height_map, x, z, self.min_y)
   455	            })
   456	            .await
   457	    }

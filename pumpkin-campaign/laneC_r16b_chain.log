   163	async fn update_leaves_and_grow(world: Arc<World>, position: &BlockPos) {
   164	    let above_pos = position.up();
   165	    let below_pos = position.down();
   166	    let two_below_pos = position.down_height(2);
   167	
   168	    let (block, state_id) = world.get_block_and_state_id(position);
   169	    let state_above = world.get_block_state(&above_pos);
   170	
   171	    if !state_above.is_air() {
   172	        return;
   173	    }
   174	
   175	    let mut props = BambooLikeProperties::from_state_id(state_id, block);
   176	    if props.stage != 0 {
   177	        return;
   178	    }
   179	
   180	    // `growBamboo`'s `height` argument: the stalk blocks below plus this one
   181	    // (`BambooStalkBlock.randomTick` passes `getHeightBelowUpToMax(level, pos) + 1`).
   182	    let height = count_bamboo_below(&world, position) + 1;
   183	    if height >= MAX_STALK_HEIGHT {
   184	        return;
   185	    }
   186	    let (block_below, state_id_below) = world.get_block_and_state_id(&below_pos);
   187	    let (block_two_below, state_id_two_below) = world.get_block_and_state_id(&two_below_pos);
   188	
   189	    let mut props_below = BambooLikeProperties::from_state_id(state_id_below, block_below);
   190	
   191	    if height >= 1 {
   192	        let below_is_bamboo = block_below == &Block::BAMBOO;
   193	        let below_has_leaves = props_below.leaves != BambooLeaves::None;
   194	
   195	        props.leaves = if !below_is_bamboo || !below_has_leaves {
   196	            BambooLeaves::Small
   197	        } else {
   198	            BambooLeaves::Large
   199	        };
   200	
   201	        if props.leaves == BambooLeaves::Large && block_two_below == &Block::BAMBOO {
   202	            props_below.leaves = BambooLeaves::Small;
   203	
   204	            let mut props_two_below =
   205	                BambooLikeProperties::from_state_id(state_id_two_below, block_two_below);
   206	            props_two_below.leaves = BambooLeaves::None;
   207	
   208	            world
   209	                .set_block_state(
   210	                    &below_pos,
   211	                    props_below.to_state_id(block_below),
   212	                    BlockFlags::NOTIFY_ALL,
   213	                )
   214	                .await;
   215	            world
   216	                .set_block_state(
   217	                    &two_below_pos,
   218	                    props_two_below.to_state_id(block_two_below),
   219	                    BlockFlags::NOTIFY_ALL,
   220	                )
   221	                .await;
   222	        }
   223	    }
   224	
   225	    props.age = u8::from(!(props.age != 1 && block_two_below == &Block::BAMBOO));
   226	
   227	    props.stage = grown_stage(height, rand::rng().random::<f32>());
   228	
   229	    world
   230	        .set_block_state(&above_pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
   231	        .await;
   232	}
   233	
   234	fn count_bamboo_below(world: &World, pos: &BlockPos) -> usize {
   235	    let mut bamboo_count = 0;
   236	    let mut found_bamboo_below = true;
   237	    let mut current_position = pos.down();
   238	    while found_bamboo_below && bamboo_count < 16 {
   239	        found_bamboo_below = false;
   240	        if world.get_block(&current_position) == &Block::BAMBOO {
   241	            current_position = current_position.down();
   242	            bamboo_count += 1;
   243	            found_bamboo_below = true;
   244	        }
   245	    }
   246	    bamboo_count
   247	}
   248	
   249	fn count_bamboo_above(world: &World, pos: &BlockPos) -> usize {
   250	    let mut bamboo_count = 0;
   251	    let mut found_bamboo_below = true;
   252	    let mut current_position = pos.up();
   253	    while found_bamboo_below && bamboo_count < 16 {
   254	        found_bamboo_below = false;
   255	        if world.get_block(&current_position) == &Block::BAMBOO {
   256	            current_position = current_position.up();
   257	            bamboo_count += 1;
   258	            found_bamboo_below = true;
   259	        }
   260	    }
   261	    bamboo_count
   262	}
   263	
   264	async fn bone_meal(world: Arc<World>, position: &BlockPos) {
   265	    let bamboo_below = count_bamboo_below(&world, position);
   266	
   267	    let growth_amount = rand::rng().random_range(1..=2);
   268	
   269	    for (bamboo_above, _) in (count_bamboo_above(&world, position)..).zip(0..growth_amount) {
   270	        let current_total_height = bamboo_above + bamboo_below + 1;
   271	
   272	        // `next_pos` is the topmost bamboo of the stalk, so the free space we grow into is the
   273	        // block above it. Vanilla reads `STAGE` from the top stalk and grows from there too.
   274	        let next_pos = position.up_height(bamboo_above as i32);
   275	        let next_state = world.get_block_state(&next_pos);
   276	
   277	        if current_total_height >= 16
   278	            || !world.is_in_height_limit(next_pos.up().0.y)
   279	            || !world.get_block_state(&next_pos.up()).is_air()
   280	        {
   281	            return;
   282	        }
   283	
   284	        let next_props = BambooLikeProperties::from_state_id(next_state.id, &Block::BAMBOO);
   285	        if next_props.stage == 1 {
   286	            return;
   287	        }
   288	
   289	        update_leaves_and_grow(Arc::clone(&world), &next_pos).await;
   290	    }
   291	}

   563	    pub async fn unregister_game_event_listener_at(&self, pos: &BlockPos) {
   564	        self.game_event_listeners.lock().await.retain(|listener| {
   565	            !matches!(listener.listener_source(), game_event::PositionSource::Block(listener_pos) if listener_pos == *pos)

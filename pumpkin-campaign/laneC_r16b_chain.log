    31	// Checks if the target chunk is within the view distance
    32	// of the center chunk. Uses Chebyshev distance.
    33	#[must_use]
    34	#[inline]
    35	pub fn is_within_view_distance(
    36	    center: Vector2<i32>,
    37	    target: Vector2<i32>,
    38	    view_distance: i32,
    39	) -> bool {
    40	    (target.x - center.x).abs().max((target.y - center.y).abs()) <= view_distance
    41	}

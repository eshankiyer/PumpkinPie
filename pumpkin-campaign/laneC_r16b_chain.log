  6940	    pub fn get_fluid_and_fluid_state(
  6941	        &self,
  6942	        position: &BlockPos,
  6943	    ) -> (&'static Fluid, &'static FluidState) {
  6944	        let id = self.get_block_state_id(position);
  6945	
  6946	        let Some(raw_fluid) = Fluid::from_state_id(id) else {
  6947	            let block = Block::from_state_id(id);
  6948	            if block == &Block::BUBBLE_COLUMN {
  6949	                return crate::block::blocks::bubble_column::BubbleColumnBlock::fluid_state();
  6950	            }
  6951	            // `SeagrassBlock.getFluidState` (SeagrassBlock.java:85-88) and
  6952	            // `TallSeagrassBlock.getFluidState` (TallSeagrassBlock.java:78-80) always report a
  6953	            // full water source; neither block has a `waterlogged` property, so mirror the
  6954	            // waterlogged branch below by reporting the source WATER fluid state.
  6955	            if block.name == "seagrass" || block.name == "tall_seagrass" {
  6956	                return (&Fluid::WATER, &Fluid::WATER.states[0]);
  6957	            }
  6958	            if let Some(properties) = block.properties(id) {
  6959	                for (name, value) in properties.to_props() {
  6960	                    if name == "waterlogged" {
  6961	                        if value == "true" {
  6962	                            let state = &Fluid::WATER.states[0];
  6963	                            return (&Fluid::WATER, state);
  6964	                        }
  6965	
  6966	                        break;
  6967	                    }
  6968	                }
  6969	            }
  6970	
  6971	            let state = &Fluid::EMPTY.states[0];
  6972	            return (&Fluid::EMPTY, state);
  6973	        };
  6974	
  6975	        // Air is represented by the EMPTY fluid registry entry. It has no
  6976	        // fluid properties, so asking it for an indexed state would panic.
  6977	        if raw_fluid == &Fluid::EMPTY {
  6978	            return (&Fluid::EMPTY, &Fluid::EMPTY.states[0]);
  6979	        }
  6980	
  6981	        // Keep the state variant selected by the block state.  Converting source water/lava
  6982	        // to its flowing registry entry and then taking states[0] loses the level/height of
  6983	        // partial fluid blocks, which is observable by entity eye-fluid checks. Only the
  6984	        // flowing fluids carry a level property; `Fluid::properties` panics for the others,
  6985	        // and air maps to `Fluid::EMPTY`, which every entity tick asks about.
  6986	        let state = if raw_fluid == &Fluid::FLOWING_WATER || raw_fluid == &Fluid::FLOWING_LAVA {
  6987	            let index = raw_fluid.properties(id).to_index() as usize;
  6988	            &raw_fluid.states[index]
  6989	        } else {
  6990	            &raw_fluid.states[0]
  6991	        };
  6992	
  6993	        (raw_fluid, state)
  6994	    }

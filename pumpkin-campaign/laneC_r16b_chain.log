   241	   private class PlayerTicketTracker extends DistanceManager.FixedPlayerDistanceChunkTracker {
   242	      private int viewDistance;
   243	      private final Long2IntMap queueLevels = Long2IntMaps.synchronize(new Long2IntOpenHashMap());
   244	      private final LongSet toUpdate = new LongOpenHashSet();
   245	
   246	      protected PlayerTicketTracker(final int maxDistance) {
   247	         super(maxDistance);
   248	         this.viewDistance = 0;
   249	         this.queueLevels.defaultReturnValue(maxDistance + 2);
   250	      }
   251	
   252	      @Override
   253	      protected void onLevelChange(final long node, final int oldLevel, final int level) {
   254	         this.toUpdate.add(node);
   255	      }
   256	
   257	      public void updateViewDistance(final int viewDistance) {
   258	         for (Entry entry : this.chunks.long2ByteEntrySet()) {
   259	            byte level = entry.getByteValue();
   260	            long key = entry.getLongKey();
   261	            this.onLevelChange(key, level, this.haveTicketFor(level), level <= viewDistance);
   262	         }
   263	
   264	         this.viewDistance = viewDistance;
   265	      }
   266	
   267	      private void onLevelChange(final long key, final int level, final boolean saw, final boolean sees) {
   268	         if (saw != sees) {
   269	            Ticket ticket = new Ticket(TicketType.PLAYER_LOADING, DistanceManager.PLAYER_TICKET_LEVEL);
   270	            if (sees) {
   271	               DistanceManager.this.ticketDispatcher.submit(() -> DistanceManager.this.mainThreadExecutor.execute(() -> {
   272	                  if (this.haveTicketFor(this.getLevel(key))) {
   273	                     DistanceManager.this.ticketStorage.addTicket(key, ticket);
   274	                     DistanceManager.this.ticketsToRelease.add(key);
   275	                  } else {
   276	                     DistanceManager.this.ticketDispatcher.release(key, () -> {}, false);
   277	                  }
   278	               }), key, () -> level);
   279	            } else {
   280	               DistanceManager.this.ticketDispatcher
   281	                  .release(key, () -> DistanceManager.this.mainThreadExecutor.execute(() -> DistanceManager.this.ticketStorage.removeTicket(key, ticket)), true);
   282	            }
   283	         }
   284	      }
   285	
   286	      @Override
   287	      public void runAllUpdates() {
   288	         super.runAllUpdates();
   289	         if (!this.toUpdate.isEmpty()) {
   290	            LongIterator iterator = this.toUpdate.iterator();
   291	
   292	            while (iterator.hasNext()) {
   293	               long node = iterator.nextLong();
   294	               int oldLevel = this.queueLevels.get(node);
   295	               int level = this.getLevel(node);
   296	               if (oldLevel != level) {
   297	                  DistanceManager.this.ticketDispatcher.onLevelChange(ChunkPos.unpack(node), () -> this.queueLevels.get(node), level, l -> {
   298	                     if (l >= this.queueLevels.defaultReturnValue()) {
   299	                        this.queueLevels.remove(node);
   300	                     } else {
   301	                        this.queueLevels.put(node, l);
   302	                     }
   303	                  });
   304	                  this.onLevelChange(node, level, this.haveTicketFor(oldLevel), this.haveTicketFor(level));
   305	               }
   306	            }
   307	
   308	            this.toUpdate.clear();
   309	         }
   310	      }
   311	
   312	      private boolean haveTicketFor(final int level) {
   313	         return level <= this.viewDistance;
   314	      }
   315	   }

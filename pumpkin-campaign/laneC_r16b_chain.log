   283	            target,
   284	            faces,
   285	            pos,
   286	            starting_face,
   287	            spread_direction,
   288	        )
   289	        .await
   290	        .is_some()
   291	        {
   292	            count += 1;
   293	        }
   294	    }
   295	    count
   296	}

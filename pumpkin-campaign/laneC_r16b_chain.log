   190	
   191	    fn on_neighbor_update<'a>(
   192	        &'a self,
   193	        world: &'a Arc<World>,
   194	        fluid: &'a Fluid,
   195	        block_pos: &'a BlockPos,
   196	        _notify: bool,
   197	    ) -> BlockFuture<'a, ()> {
   198	        Box::pin(async move {
   199	            if Self::receive_neighbor_fluids(world, fluid, block_pos).await {
   200	                let flow_speed = self.get_flow_speed(world);

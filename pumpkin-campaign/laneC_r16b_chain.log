   650	    pub fn change_world(&mut self, old_level: &Arc<Level>, new_world: Arc<World>) {
   651	        let mut lock = old_level
   652	            .chunk_loading
   653	            .lock()
   654	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   655	        if let Some((view_level, sim_level)) = self.held_tickets.take() {
   656	            lock.remove_ticket(self.center, view_level);
   657	            lock.remove_ticket(self.center, sim_level);
   658	        }
   659	        lock.send_change();
   660	        old_level.should_unload.store(true, Ordering::Relaxed);
   661	        old_level.level_channel.notify();
   662	        drop(lock);
   663	        self.chunk_listener = new_world.level.chunk_listener.add_global_chunk_listener();
   664	        self.chunk_sent.clear();
   665	        self.chunk_queue.clear();
   666	        self.entity_chunk_queue.clear();
   667	        self.view_distance = 0;
   668	        self.world = new_world;
   669	        // Reset batch state so chunks can be sent immediately in the new dimension
   670	        self.batches_sent_since_ack = 0;
   671	        self.last_chunk_batch_sent_at = Instant::now();

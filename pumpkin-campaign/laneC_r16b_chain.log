    43	pub async fn update_position(player: &Arc<Player>) {
    44	    let entity = &player.get_entity();
    45	    let new_chunk_center = entity.chunk_pos.load();
    46	    let old_cylindrical = player.watched_section.load();
    47	
    48	    // This does break when a new player spawns
    49	    // if old_cylindrical.center == new_chunk_center {
    50	    //     return;
    51	    // }
    52	
    53	    let view_distance = get_view_distance(player);
    54	    let new_cylindrical = Cylindrical::new(new_chunk_center, view_distance);
    55	
    56	    if old_cylindrical == new_cylindrical {
    57	        return;
    58	    }
    59	
    60	    match player.client.as_ref() {
    61	        ClientPlatform::Java(java_client) => {
    62	            java_client
    63	                .send_packet(&CCenterChunk {
    64	                    chunk_x: new_chunk_center.x.into(),
    65	                    chunk_z: new_chunk_center.y.into(),
    66	                })
    67	                .await;
    68	        }
    69	        ClientPlatform::Bedrock(bedrock_client) => {
    70	            bedrock_client
    71	                .send_packet(&CNetworkChunkPublisherUpdate::new(
    72	                    player.get_entity().block_pos.load(),
    73	                    u32::from(view_distance.get()) * 16,
    74	                ))
    75	                .await;
    76	        }
    77	    }
    78	    let (loading_iter, unloading_iter) =
    79	        Cylindrical::changed_chunks(old_cylindrical, new_cylindrical);
    80	    let loading_chunks: Vec<_> = loading_iter.collect();
    81	    let unloading_chunks: Vec<_> = unloading_iter.collect();
    82	
    83	    // Use the chunk_manager's world reference, which is updated on dimension change.
    84	    // This ensures we load chunks from the correct world after portal teleportation.
    85	    let world = {
    86	        let mut chunk_manager = player.chunk_manager.lock().await;
    87	        let world = chunk_manager.world().clone();
    88	        chunk_manager.update_center_and_view_distance(
    89	            new_chunk_center,
    90	            view_distance.into(),
    91	            &world.level,
    92	            &loading_chunks,
    93	            &unloading_chunks,
    94	        );
    95	        world
    96	    };
    97	    player.watched_section.store(new_cylindrical);
    98	
    99	    if let ClientPlatform::Java(client) = player.client.as_ref() {
   100	        for chunk in &unloading_chunks {
   101	            client
   102	                .enqueue_client_packet(&CUnloadChunk::new(chunk.x, chunk.y))
   103	                .await;
   104	        }
   105	    }
   106	
   107	    // Make sure the watched section and the chunk watcher updates are async atomic. We want to
   108	    // ensure what we unload when the player disconnects is correct.
   109	    world
   110	        .level
   111	        .mark_chunks_as_newly_watched(&loading_chunks)
   112	        .await;
   113	    let chunks_to_clean = world
   114	        .level
   115	        .mark_chunks_as_not_watched(&unloading_chunks)
   116	        .await;
   117	
   118	    if !chunks_to_clean.is_empty() {
   119	        world.remove_entities_in_chunks(&chunks_to_clean).await;
   120	        world.level.clean_entity_chunks(&chunks_to_clean);
   121	    }
   122	
   123	    if !loading_chunks.is_empty() {
   124	        world.spawn_world_entity_chunks(player.clone(), loading_chunks, new_chunk_center);
   125	    }
   126	}

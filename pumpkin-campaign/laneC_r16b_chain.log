   223	impl BlockBehaviour for SculkVeinBlock {
   224	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   225	        Box::pin(async move {
   226	            let existing_faces = match args.replacing {
   227	                BlockIsReplacing::Itself(state_id) => {
   228	                    Some(GlowLichenLikeProperties::from_state_id(state_id, args.block).faces())
   229	                }
   230	                _ => None,
   231	            };
   232	
   233	            let mut candidates: Vec<BlockDirection> = args
   234	                .player
   235	                .get_entity()
   236	                .get_entity_facing_order()
   237	                .into_iter()
   238	                .map(|f| f.to_block_direction())
   239	                .collect();
   240	            if let Some(idx) = candidates.iter().position(|&d| d == args.direction) {
   241	                candidates.remove(idx);
   242	            }
   243	            candidates.insert(0, args.direction);
   244	
   245	            for direction in candidates {
   246	                if let Some(new_faces) =
   247	                    self.faces_for_placement(args.world, existing_faces, args.position, direction)
   248	                {
   249	                    let mut props = if existing_faces.is_some() {
   250	                        GlowLichenLikeProperties::from_state_id(
   251	                            args.world.get_block_state_id(args.position),
   252	                            args.block,
   253	                        )
   254	                    } else {
   255	                        let mut default_props = GlowLichenLikeProperties::default(args.block);
   256	                        default_props.r#waterlogged = args.replacing.water_source();
   257	                        default_props
   258	                    };
   259	                    props.set_faces(new_faces);
   260	                    return props.to_state_id(args.block);
   261	                }
   262	            }
   263	
   264	            Block::AIR.default_state.id
   265	        })

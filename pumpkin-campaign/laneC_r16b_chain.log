   404	fn extend_active_chunks(
   405	    active_chunks: &mut FxHashSet<Vector2<i32>>,
   406	    center: Vector2<i32>,
   407	    simulation_distance: i32,
   408	) {
   409	    for dx in -simulation_distance..=simulation_distance {
   410	        for dz in -simulation_distance..=simulation_distance {
   411	            active_chunks.insert(center.add_raw(dx, dz));
   412	        }
   413	    }
   414	}

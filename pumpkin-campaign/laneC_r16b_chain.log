   581	    pub fn update_active_chunks(self: &Arc<Self>) {
   582	        let mut active_chunks = FxHashSet::default();
   583	        let server = self.server.upgrade();
   584	        for player in self.players.load().iter() {
   585	            let center = player.get_entity().chunk_pos.load();
   586	            let simulation_distance =
   587	                server
   588	                    .as_ref()
   589	                    .map_or(10, |server| match player.client.as_ref() {
   590	                        ClientPlatform::Java(_) => server
   591	                            .advanced_config
   592	                            .networking
   593	                            .java
   594	                            .simulation_distance
   595	                            .get(),
   596	                        ClientPlatform::Bedrock(_) => server
   597	                            .advanced_config
   598	                            .networking
   599	                            .bedrock
   600	                            .simulation_distance
   601	                            .get(),
   602	                    });
   603	            extend_active_chunks(&mut active_chunks, center, i32::from(simulation_distance));
   604	        }
   605	        self.level.extend_with_forced_chunks(&mut active_chunks);
   606	
   607	        let mut spawnable_chunks = 0;
   608	        for pos in &active_chunks {
   609	            if self.level.is_chunk_loaded(pos) {
   610	                spawnable_chunks += 1;
   611	                self.migrate_pending_block_entities(*pos);
   612	            }
   613	        }
   614	
   615	        self.active_chunks.store(Arc::new(active_chunks));
   616	
   617	        self.spawn_state.store(Arc::new(SpawnState::new(
   618	            spawnable_chunks,
   619	            &self.entities,
   620	            self,
   621	        )));
   622	    }

   139	    pos: &BlockPos,
   140	    direction_towards_neighbour: BlockDirection,
   141	) -> bool {
   142	    let neighbour_pos = pos.offset(direction_towards_neighbour.to_offset());
   143	    let neighbour_state = accessor.get_block_state(&neighbour_pos);
   144	    can_attach_to(neighbour_state, direction_towards_neighbour)
   145	}

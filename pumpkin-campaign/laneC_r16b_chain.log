    12	/// Bitmask of the six `BlockDirection`s a multiface block currently occupies.
    13	///
    14	/// Mirrors vanilla's `MultifaceBlock.pack`/`unpack`, which key a single byte off
    15	/// `1 << direction.ordinal()`. `BlockDirection::to_index()` uses the same
    16	/// Down/Up/North/South/West/East ordering as Java's `Direction.values()`, so this
    17	/// bitmask is byte-identical to vanilla's (see `test_pack_matches_vanilla_ordinal`).
    18	#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
    19	pub struct FaceSet(u8);
    20	
    21	impl FaceSet {
    22	    pub const EMPTY: Self = Self(0);
    23	    pub const ALL: Self = Self(0b0011_1111);
    24	
    25	    #[must_use]
    26	    const fn bit(direction: BlockDirection) -> u8 {
    27	        1 << direction.to_index()
    28	    }
    29	
    30	    #[must_use]
    31	    pub const fn contains(self, direction: BlockDirection) -> bool {
    32	        self.0 & Self::bit(direction) != 0
    33	    }
    34	
    35	    #[must_use]
    36	    pub const fn with(self, direction: BlockDirection) -> Self {
    37	        Self(self.0 | Self::bit(direction))
    38	    }
    39	
    40	    #[must_use]
    41	    pub const fn without(self, direction: BlockDirection) -> Self {
    42	        Self(self.0 & !Self::bit(direction))
    43	    }
    44	
    45	    #[must_use]
    46	    pub const fn is_empty(self) -> bool {
    47	        self.0 == 0
    48	    }
    49	
    50	    #[must_use]
    51	    pub fn from_directions(directions: impl IntoIterator<Item = BlockDirection>) -> Self {
    52	        directions.into_iter().fold(Self::EMPTY, Self::with)
    53	    }
    54	
    55	    pub fn iter(self) -> impl Iterator<Item = BlockDirection> {
    56	        BlockDirection::all()
    57	            .into_iter()
    58	            .filter(move |&d| self.contains(d))
    59	    }
    60	
    61	    /// `MultifaceBlock.pack`.
    62	    #[must_use]
    63	    pub const fn pack(self) -> u8 {
    64	        self.0
    65	    }
    66	
    67	    /// `MultifaceBlock.unpack`.
    68	    #[must_use]
    69	    pub const fn unpack(data: u8) -> Self {
    70	        Self(data & Self::ALL.0)
    71	    }
    72	}

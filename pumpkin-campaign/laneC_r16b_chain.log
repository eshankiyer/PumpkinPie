   304	    #[test]
   305	    fn face_set_pack_matches_vanilla_ordinal() {
   306	        // Java `Direction.values()` ordinal order: DOWN, UP, NORTH, SOUTH, WEST, EAST.
   307	        // `BlockDirection::to_index()` must use the same order for the sculk charge
   308	        // particle level-event byte (`numParticles << 6 | pack(faces)`) to render
   309	        // correctly on vanilla clients.
   310	        assert_eq!(BlockDirection::Down.to_index(), 0);
   311	        assert_eq!(BlockDirection::Up.to_index(), 1);
   312	        assert_eq!(BlockDirection::North.to_index(), 2);
   313	        assert_eq!(BlockDirection::South.to_index(), 3);
   314	        assert_eq!(BlockDirection::West.to_index(), 4);
   315	        assert_eq!(BlockDirection::East.to_index(), 5);
   316	
   317	        let faces = FaceSet::from_directions([BlockDirection::Up, BlockDirection::South]);
   318	        assert_eq!(faces.pack(), (1 << 1) | (1 << 3));
   319	        assert_eq!(FaceSet::unpack(faces.pack()), faces);
   320	    }

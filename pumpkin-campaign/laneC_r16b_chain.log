   167	/// `Direction.allShuffled(random)`: a Fisher-Yates shuffle of the six directions.
   168	#[must_use]
   169	pub fn shuffled_directions(random: &mut RandomGenerator) -> [BlockDirection; 6] {
   170	    let mut dirs = BlockDirection::all();
   171	    for i in (1..dirs.len()).rev() {
   172	        let j = random.next_bounded_i32(i as i32 + 1) as usize;
   173	        dirs.swap(i, j);
   174	    }
   175	    dirs
   176	}

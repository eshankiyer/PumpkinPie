   568	
   569	    /// Removes any registered listener whose `PositionSource` is the given entity. Entity-backed
   570	    /// listeners (e.g. Warden/Allay vibration listeners) have no other removal hook, unlike
   571	    /// block-backed ones which are unregistered when their block entity is torn down; without
   572	    /// this, a despawned mob's listener would sit dead but never removed from the flat registry
   573	    /// (see `game_event/mod.rs` module doc comment on the vanilla per-chunk-section registry this
   574	    /// replaces). Called from `remove_entity` below.
   575	    pub async fn unregister_game_event_listener_for_entity(&self, uuid: uuid::Uuid) {
   576	        self.game_event_listeners.lock().await.retain(|listener| {
   577	            !matches!(listener.listener_source(), game_event::PositionSource::Entity(listener_uuid) if listener_uuid == uuid)
   578	        });
   579	    }

   159	/// Shared face-attachment behaviour for a multiface block.
   160	///
   161	/// Every method here operates on a plain `FaceSet` rather than a concrete
   162	/// block-properties struct, so a consumer converts to/from its own generated
   163	/// properties type (see `MultifaceProperties`) around calls into this trait.
   164	pub trait MultifaceBlockBase: Send + Sync {
   165	    /// `MultifaceBlock.isFaceSupported`. Default: every face is supported.
   166	    fn is_face_supported(&self, _direction: BlockDirection) -> bool {
   167	        true
   168	    }
   169	
   170	    /// `MultifaceBlock.isValidStateForPlacement`.
   171	    ///
   172	    /// `existing_faces` is `Some` when the position being placed into already holds
   173	    /// this same block (vanilla's `oldState.is(this)`), `None` otherwise.
   174	    fn is_valid_state_for_placement(
   175	        &self,
   176	        accessor: &dyn BlockAccessor,
   177	        existing_faces: Option<FaceSet>,
   178	        placement_pos: &BlockPos,
   179	        placement_direction: BlockDirection,
   180	    ) -> bool {
   181	        if !self.is_face_supported(placement_direction) {
   182	            return false;
   183	        }
   184	        if existing_faces.is_some_and(|faces| faces.contains(placement_direction)) {
   185	            return false;
   186	        }
   187	        can_attach_to_pos(accessor, placement_pos, placement_direction)
   188	    }
   189	
   190	    /// `MultifaceBlock.getStateForPlacement`, reduced to the face-set delta: returns
   191	    /// the faces the placed block should end up with, or `None` if placement is invalid.
   192	    fn faces_for_placement(
   193	        &self,
   194	        accessor: &dyn BlockAccessor,
   195	        existing_faces: Option<FaceSet>,
   196	        placement_pos: &BlockPos,
   197	        placement_direction: BlockDirection,
   198	    ) -> Option<FaceSet> {
   199	        if !self.is_valid_state_for_placement(
   200	            accessor,
   201	            existing_faces,
   202	            placement_pos,
   203	            placement_direction,
   204	        ) {
   205	            return None;
   206	        }
   207	        Some(
   208	            existing_faces
   209	                .unwrap_or(FaceSet::EMPTY)
   210	                .with(placement_direction),
   211	        )
   212	    }
   213	
   214	    /// `MultifaceBlock.canSurvive`.
   215	    fn can_survive(&self, accessor: &dyn BlockAccessor, pos: &BlockPos, faces: FaceSet) -> bool {
   216	        has_any_face(faces) && faces.iter().all(|d| can_attach_to_pos(accessor, pos, d))
   217	    }
   218	
   219	    /// `MultifaceBlock.updateShape`, reduced to the face-set delta (the waterlogged
   220	    /// re-scheduling side effect is the caller's responsibility, since it depends on
   221	    /// the consumer's own block state, not on this framework).
   222	    ///
   223	    /// Returns `None` if the block should revert to air (no faces remain), otherwise
   224	    /// the (possibly unchanged) face set.
   225	    fn update_faces_for_neighbor(
   226	        &self,
   227	        faces: FaceSet,
   228	        neighbour_state: &BlockState,
   229	        direction_to_neighbour: BlockDirection,
   230	    ) -> Option<FaceSet> {
   231	        if faces.contains(direction_to_neighbour)
   232	            && !can_attach_to(neighbour_state, direction_to_neighbour)
   233	        {
   234	            let updated = faces.without(direction_to_neighbour);
   235	            has_any_face(updated).then_some(updated)
   236	        } else {
   237	            Some(faces)
   238	        }
   239	    }
   240	}

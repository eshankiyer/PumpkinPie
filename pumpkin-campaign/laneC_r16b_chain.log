    95	                  }
    96	
    97	                  CompletableFuture<ChunkResult<LevelChunk>> future = chunk.getEntityTickingChunkFuture();
    98	                  future.thenAccept(c -> this.mainThreadExecutor.execute(() -> this.ticketDispatcher.release(pos, () -> {}, false)));
    99	               }
   100	            }
   101	
   102	            this.ticketsToRelease.clear();
   103	         }
   104	
   105	         return updated;
   106	      }
   107	   }

    72	      }
    73	
    74	      if (!this.chunksToUpdateFutures.isEmpty()) {
    75	         for (ChunkHolder chunksToUpdateFuture : this.chunksToUpdateFutures) {
    76	            chunksToUpdateFuture.updateHighestAllowedStatus(scheduler);
    77	         }
    78	
    79	         for (ChunkHolder chunkHolder : this.chunksToUpdateFutures) {
    80	            chunkHolder.updateFutures(scheduler, this.mainThreadExecutor);
    81	         }
    82	
    83	         this.chunksToUpdateFutures.clear();
    84	         return true;
    85	      } else {
    86	         if (!this.ticketsToRelease.isEmpty()) {
    87	            LongIterator iterator = this.ticketsToRelease.iterator();
    88	
    89	            while (iterator.hasNext()) {
    90	               long pos = iterator.nextLong();
    91	               if (this.ticketStorage.getTickets(pos).stream().anyMatch(t -> t.getType() == TicketType.PLAYER_LOADING)) {
    92	                  ChunkHolder chunk = scheduler.getUpdatingChunkIfPresent(pos);
    93	                  if (chunk == null) {

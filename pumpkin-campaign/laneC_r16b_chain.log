   103	#[must_use]
   104	pub fn waterlogged_replacement_state(
   105	    block_state: &BlockState,
   106	    block: &Block,
   107	    fluid: &Fluid,
   108	) -> Option<BlockStateId> {
   109	    if fluid.matches_type(&Fluid::WATER)
   110	        && block.has_tag(&tag::Block::MINECRAFT_SLABS)
   111	        && !crate::block::blocks::slabs::can_place_liquid(block, block_state.id)
   112	    {
   113	        return None;
   114	    }
   115	
   116	    fluid
   117	        .matches_type(&Fluid::WATER)
   118	        .then(|| block.with_waterlogged(block_state.id))
   119	        .flatten()
   120	        .map(|state| {
   121	            if block.has_tag(&tag::Block::MINECRAFT_CANDLES) {
   122	                // The live fluid path calls `CandleBlock::place_liquid` first so it can perform
   123	                // the vanilla extinguish side effects. This pure helper still clears `lit` for
   124	                // callers that only need the resulting waterlogged state.
   125	                let mut props = block
   126	                    .properties(state.id)
   127	                    .expect("waterlogged candle state has properties")
   128	                    .to_props();
   129	                if let Some((_, value)) = props.iter_mut().find(|(key, _)| *key == "lit") {
   130	                    *value = "false";
   131	                }
   132	                block.from_properties(&props).to_state_id(block)
   133	            } else {
   134	                state.id
   135	            }
   136	        })
   137	}

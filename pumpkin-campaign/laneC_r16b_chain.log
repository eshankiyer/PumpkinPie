    66	      this.simulationChunkTracker.runAllUpdates();
    67	      this.playerTicketManager.runAllUpdates();
    68	      int updates = Integer.MAX_VALUE - this.loadingChunkTracker.runDistanceUpdates(Integer.MAX_VALUE);
    69	      boolean updated = updates != 0;

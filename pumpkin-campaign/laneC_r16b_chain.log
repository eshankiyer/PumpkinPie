   156	      int heightAbove = this.getHeightAboveUpToMax(level, pos);
   157	      int heightBelow = this.getHeightBelowUpToMax(level, pos);
   158	      BlockPos growthPos = pos.above(heightAbove + 1);
   159	      return heightAbove + heightBelow + 1 < 16
   160	         && level.getBlockState(pos.above(heightAbove)).getValue(STAGE) != 1
   161	         && level.isInsideBuildHeight(growthPos)
   162	         && level.isEmptyBlock(growthPos);

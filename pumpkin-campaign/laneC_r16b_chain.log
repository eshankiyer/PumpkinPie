    71	/// Extracts this position's vein faces if (and only if) it currently holds
    72	/// `sculk_vein`, mirroring vanilla's repeated `oldState.is(this)`/`state.is(Blocks.SCULK_VEIN)`
    73	/// guards before treating a state as carrying face data.
    74	pub(crate) fn existing_vein_faces(state: &BlockState) -> Option<FaceSet> {
    75	    (Block::from_state_id(state.id) == &Block::SCULK_VEIN)

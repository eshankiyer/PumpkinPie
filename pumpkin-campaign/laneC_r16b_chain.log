   515	fn block_item_place_sound(block: &Block) -> (Sound, f32, f32) {
   516	    // BlockItem gets the sound and its volume/pitch from the placed state's SoundType
   517	    // (`BlockItem.java:86-87`; `SoundType.java:1-11, 47-54`). The generated block data does not
   518	    // retain SoundType, so use exact generated sound names first and the shared families used by
   519	    // the vanilla block definitions (`Blocks.java:96-99, 627-638, 1038-1050`).
   520	    let direct_name = format!("block.{}.place", block.name);
   521	    let family_name = match block.name {
   522	        "anvil" => "block.anvil.place",
   523	        name if name.ends_with("_wool") || name.ends_with("_carpet") => "block.wool.place",
   524	        "glass" | "glass_pane" => "block.glass.place",
   525	        "iron_block" => "block.iron.place",
   526	        "gold_block" => "block.metal.place",
   527	        name if name.starts_with("copper") => "block.copper.place",
   528	        name if name.starts_with("deepslate") => "block.deepslate.place",
   529	        name if name.ends_with("_planks")
   530	            || name.ends_with("_log")
   531	            || name.ends_with("_wood")
   532	            || name.ends_with("_hyphae")
   533	            || name.ends_with("_stem") =>
   534	        {
   535	            "block.wood.place"
   536	        }
   537	        _ => "block.stone.place",
   538	    };
   539	    let sound = Sound::from_name(&direct_name)
   540	        .or_else(|| Sound::from_name(family_name))
   900	            custom_data_applied,
   901	        )
   902	        .await;
   903	
   904	        player
   905	            .trigger_advancement(
   906	                crate::entity::player::advancement::trigger::AdvancementTrigger::PlacedBlock {
   907	                    block_id: format!("minecraft:{}", placed_block.name),
   908	                },
   909	            )
   910	            .await;
   911	
   912	        Ok(Some((final_block_pos, new_state)))
   913	    }

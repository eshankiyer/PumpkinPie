    79	/// `existingState.is(Blocks.WATER) && existingState.getFluidState().isSource()`.
    80	fn is_water_source(state: &BlockState) -> bool {
    81	    let block = Block::from_state_id(state.id);
    82	    block == &Block::WATER && WaterLikeProperties::from_state_id(state.id, block).level == 0

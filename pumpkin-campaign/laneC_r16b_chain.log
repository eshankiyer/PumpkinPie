   170	   @Override
   171	   public void performBonemeal(final ServerLevel level, final RandomSource random, final BlockPos pos, final BlockState state) {
   172	      int heightAbove = this.getHeightAboveUpToMax(level, pos);
   173	      int heightBelow = this.getHeightBelowUpToMax(level, pos);
   174	      int totalHeight = heightAbove + heightBelow + 1;
   175	      int newBamboo = 1 + random.nextInt(2);
   176	
   177	      for (int i = 0; i < newBamboo; i++) {
   178	         BlockPos topPos = pos.above(heightAbove);
   179	         BlockState topState = level.getBlockState(topPos);
   180	         BlockPos growthPos = topPos.above();
   181	         if (totalHeight >= 16 || topState.getValue(STAGE) == 1 || !level.isEmptyBlock(growthPos) || level.isOutsideBuildHeight(growthPos)) {
   182	            return;
   183	         }
   184	
   185	         this.growBamboo(topState, level, topPos, random, totalHeight);
   186	         heightAbove++;
   187	         totalHeight++;
   188	      }
   189	   }
   190	
   191	   protected void growBamboo(final BlockState state, final Level level, final BlockPos pos, final RandomSource random, final int height) {
   192	      BlockState belowState = level.getBlockState(pos.below());
   193	      BlockPos twoBelowPos = pos.below(2);
   194	      BlockState twoBelowState = level.getBlockState(twoBelowPos);
   195	      BambooLeaves leaves = BambooLeaves.NONE;
   196	      if (height >= 1) {
   197	         if (!belowState.is(Blocks.BAMBOO) || belowState.getValue(LEAVES) == BambooLeaves.NONE) {
   198	            leaves = BambooLeaves.SMALL;
   199	         } else if (belowState.is(Blocks.BAMBOO) && belowState.getValue(LEAVES) != BambooLeaves.NONE) {
   200	            leaves = BambooLeaves.LARGE;
   201	            if (twoBelowState.is(Blocks.BAMBOO)) {
   202	               level.setBlock(pos.below(), belowState.setValue(LEAVES, BambooLeaves.SMALL), 3);
   203	               level.setBlock(twoBelowPos, twoBelowState.setValue(LEAVES, BambooLeaves.NONE), 3);
   204	            }
   205	         }
   206	      }
   207	
   208	      int age = state.getValue(AGE) != 1 && !twoBelowState.is(Blocks.BAMBOO) ? 0 : 1;
   209	      int stage = (height < 11 || !(random.nextFloat() < 0.25F)) && height != 15 ? 0 : 1;
   210	      level.setBlock(pos.above(), this.defaultBlockState().setValue(AGE, age).setValue(LEAVES, leaves).setValue(STAGE, stage), 3);
   211	   }
   212	
   213	   protected int getHeightAboveUpToMax(final BlockGetter level, final BlockPos pos) {
   214	      int height = 0;
   215	
   216	      while (height < 16 && level.getBlockState(pos.above(height + 1)).is(Blocks.BAMBOO)) {
   217	         height++;
   218	      }
   219	
   220	      return height;
   221	   }
   222	
   223	   protected int getHeightBelowUpToMax(final BlockGetter level, final BlockPos pos) {
   224	      int height = 0;
   225	
   226	      while (height < 16 && level.getBlockState(pos.below(height + 1)).is(Blocks.BAMBOO)) {
   227	         height++;
   228	      }
   229	
   230	      return height;
   231	   }
   232	}

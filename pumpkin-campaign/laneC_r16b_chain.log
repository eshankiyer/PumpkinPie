   205	
   206	    fn on_entity_collision<'a>(&'a self, entity: &'a dyn EntityBase) -> BlockFuture<'a, ()> {
   207	        Box::pin(async move {
   208	            let base_entity = entity.get_entity();
   209	            if !base_entity.entity_type.fire_immune
   210	                && !base_entity.fire_immune.load(Ordering::Relaxed)
   211	            {
   212	                entity.set_on_fire_for(15.0);
   213	
   214	                // Also apply lava damage and the vanilla burn sound.
   215	                let damaged = base_entity.damage(entity, 4.0, DamageType::LAVA).await;
   216	                if damaged && base_entity.should_play_lava_hurt_sound() && !base_entity.is_silent()
   217	                {
   218	                    let world = base_entity.world.load();
   219	                    world.play_sound_fine(
   220	                        Sound::EntityGenericBurn,
   221	                        SoundCategory::Neutral,
   222	                        &base_entity.pos.load(),
   223	                        0.4,
   224	                        2.0 + rand::random::<f32>() * 0.4,
   225	                    );
   226	                }
   227	            }
   228	        })
   229	    }
   230	
   231	    fn random_tick<'a>(
   232	        &'a self,
   233	        _fluid: &'a Fluid,
   234	        world: &'a Arc<World>,
   235	        block_pos: &'a BlockPos,
   236	    ) -> BlockFuture<'a, ()> {
   237	        Box::pin(async move {
   238	            if !Self::can_spread_fire_around(world, block_pos) {
   239	                return;
   240	            }
   241	
   242	            let passes = rand::random_range(0..3);
   243	            if passes > 0 {
   244	                let mut test_pos = *block_pos;
   245	
   246	                for _ in 0..passes {
   247	                    test_pos = test_pos.offset(Vector3::new(
   248	                        rand::random_range(-1..=1),
   249	                        1,
   250	                        rand::random_range(-1..=1),
   251	                    ));
   252	
   253	                    if !world.is_loaded(&test_pos) {
   254	                        return;
   255	                    }
   256	
   257	                    let Some(block_state) = world.get_block_state_if_loaded(&test_pos) else {
   258	                        return;
   259	                    };
   260	
   261	                    if block_state.is_air() {
   262	                        if Self::has_flammable_neighbours(world, &test_pos) {
   263	                            Self::ignite_fire_if_possible(world, &test_pos).await;
   264	                            return;
   265	                        }
   266	                    } else if blocks_movement(block_state, block_state.id.to_block_id()) {
   267	                        return;
   268	                    }
   269	                }
   270	            } else {
   271	                for _ in 0..3 {
   272	                    let test_pos = block_pos.offset(Vector3::new(
   273	                        rand::random_range(-1..=1),
   274	                        0,
   275	                        rand::random_range(-1..=1),
   276	                    ));
   277	
   278	                    if !world.is_loaded(&test_pos) {
   279	                        return;
   280	                    }
   281	
   282	                    let above_pos = test_pos.up();
   283	                    if !world.is_loaded(&above_pos) {
   284	                        return;
   285	                    }
   286	
   287	                    if world
   288	                        .get_block_state_if_loaded(&above_pos)
   289	                        .is_some_and(BlockState::is_air)
   290	                        && Self::is_flammable(world, &test_pos)
   291	                    {
   292	                        Self::ignite_fire_if_possible(world, &above_pos).await;
   293	                    }
   294	                }
   295	            }
   296	        })
   297	    }
   298	}

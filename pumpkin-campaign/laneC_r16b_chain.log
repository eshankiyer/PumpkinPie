   284	    fn can_update_at(&self, args: CanUpdateAtArgs<'_>) -> bool {
   285	        // `SculkVeinBlock` has no `canBeReplaced` override, so it falls back to
   286	        // `MultifaceBlock.canBeReplaced`: `!itemInHand.is(this) || hasAnyVacantFace(state)`.
   287	        // Since this hook only fires when the clicked block already is this block (see
   288	        // `BlockRegistry::place_block`'s `clicked_block == placed_block` guard), the
   289	        // item-in-hand half is always true here, so this reduces to a vacant-face check.
   290	        // Deliberately not direction-specific: `registry.rs`'s two call sites hand this
   291	        // hook the clicked face un-flipped in one case and pre-flipped in the other, so a
   292	        // direction-based gate here would be call-site-dependent rather than matching
   293	        // vanilla. `on_place` (which walks the full facing order) is what actually picks
   294	        // a workable face.
   295	        let existing_faces =
   296	            GlowLichenLikeProperties::from_state_id(args.state_id, args.block).faces();

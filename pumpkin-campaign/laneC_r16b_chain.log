     1	//! Multiface growth blocks: `glow_lichen` and `resin_clump`.
     2	//!
     3	//! `GlowLichenBlock` (`net/minecraft/world/level/block/GlowLichenBlock.java:14`) and the plain
     4	//! `MultifaceBlock` registration used by `resin_clump`
     5	//! (`net/minecraft/world/level/block/Blocks.java:2425-2435`, `MultifaceBlock::new`).
     6	//!
     7	//! Both share `MultifaceBlock`'s placement/support/neighbour behaviour
     8	//! (`net/minecraft/world/level/block/MultifaceBlock.java:30`); only glow lichen adds
     9	//! `BonemealableBlock`, driven by a `MultifaceSpreader` with the default config
    10	//! (`MultifaceSpreader.DefaultSpreaderConfig`, `MultifaceSpreader.java:117-143`).
    11	//!
    12	//! This is the second consumer of `abstract_multiface.rs`/`multiface_spreader.rs`, after
    13	//! `sculk_vein.rs`, and follows that file's structure.
    14	
    15	use std::sync::Arc;
    16	
    17	use pumpkin_data::block_properties::{
    18	    BlockProperties, GlowLichenLikeProperties, WaterLikeProperties,
    19	};
    20	use pumpkin_data::{Block, BlockDirection, BlockId, BlockState, BlockStateId, FacingExt};
    21	use pumpkin_util::math::position::BlockPos;
    22	use pumpkin_util::random::{RandomGenerator, get_seed, xoroshiro128::Xoroshiro};
    23	use pumpkin_world::tick::TickPriority;
    24	use pumpkin_world::world::{BlockAccessor, BlockFlags};
    25	
    26	use crate::block::blocks::abstract_multiface::{
    27	    FaceSet, MultifaceBlockBase, MultifaceProperties, has_any_vacant_face,
    28	};
    29	use crate::block::blocks::multiface_spreader::{
    30	    self, SpreadConfig, SpreadPos, SpreadTarget, can_spread_in_any_direction,
    31	};
    32	use crate::block::{
    33	    BlockBehaviour, BlockFuture, BlockIsReplacing, BlockMetadata, BonemealArgs, CanPlaceAtArgs,
    34	    CanUpdateAtArgs, GetStateForNeighborUpdateArgs, OnPlaceArgs,
    35	};
    36	use crate::entity::EntityBase;
    37	use crate::world::World;
    38	
    39	/// Behaviour shared by `glow_lichen` and `resin_clump`.
    40	///
    41	/// `glow_lichen` is a `GlowLichenBlock` and `resin_clump` a bare `MultifaceBlock`. Everything
    42	/// except the bonemeal hooks is identical between them, and those hooks are gated on the block
    43	/// id below, so a single behaviour can own both ids.
    44	pub struct MultifaceGrowthBlock;
    45	
    46	impl BlockMetadata for MultifaceGrowthBlock {
    47	    fn ids() -> Box<[BlockId]> {
    48	        [BlockId::GLOW_LICHEN, BlockId::RESIN_CLUMP].into()
    49	    }
    50	}
    51	
    52	/// Neither `GlowLichenBlock` nor `resin_clump`'s `MultifaceBlock` overrides `isFaceSupported`
    53	/// (MultifaceBlock.java:105-107 returns true for all six), so the default impl is correct.
    54	impl MultifaceBlockBase for MultifaceGrowthBlock {}
    55	
    56	/// `existingState.is(Blocks.WATER) && existingState.getFluidState().isSource()`
    57	/// (`MultifaceSpreader.DefaultSpreaderConfig#stateCanBeReplaced`, MultifaceSpreader.java:134).
    58	fn is_water_source(state: &BlockState) -> bool {
    59	    let block = Block::from_state_id(state.id);
    60	    block == &Block::WATER && WaterLikeProperties::from_state_id(state.id, block).level == 0
    61	}
    62	
    63	/// `MultifaceSpreader.DefaultSpreaderConfig` (MultifaceSpreader.java:117-143), bound to one
    64	/// concrete multiface block id.
    65	struct DefaultSpreaderConfig {
    66	    block: &'static Block,
    67	}
    68	
    69	impl SpreadConfig for DefaultSpreaderConfig {
    70	    /// `DefaultSpreaderConfig#canSpreadInto` (MultifaceSpreader.java:137-142).
    71	    fn can_spread_into(
    72	        &self,
    73	        accessor: &dyn BlockAccessor,
    74	        _source_pos: &BlockPos,
    75	        spread_pos: SpreadPos,
    76	    ) -> bool {
    77	        let existing_state = accessor.get_block_state(&spread_pos.pos);
    78	        // `stateCanBeReplaced` (MultifaceSpreader.java:131-135).
    79	        let replaceable = existing_state.is_air()
    80	            || Block::from_state_id(existing_state.id) == self.block
    81	            || is_water_source(existing_state);
    82	        if !replaceable {
    83	            return false;
    84	        }
    85	        MultifaceGrowthBlock.is_valid_state_for_placement(
    86	            accessor,
    87	            existing_faces(existing_state, self.block),
    88	            &spread_pos.pos,
    89	            spread_pos.face,
    90	        )
    91	    }
    92	}
    93	
    94	/// Vanilla's repeated `oldState.is(this)` guard before reading face properties off a state.
    95	fn existing_faces(state: &BlockState, block: &'static Block) -> Option<FaceSet> {
    96	    (Block::from_state_id(state.id) == block)
    97	        .then(|| GlowLichenLikeProperties::from_state_id(state.id, block).faces())
    98	}
    99	
   100	/// `MultifaceBlock#getStateForPlacement(BlockState, BlockGetter, BlockPos, Direction)`
   101	/// (MultifaceBlock.java:200-216), reduced to a state id.
   102	fn state_for_placement(
   103	    accessor: &dyn BlockAccessor,
   104	    block: &'static Block,
   105	    old_state: &BlockState,
   106	    placement_pos: &BlockPos,
   107	    placement_direction: BlockDirection,
   108	) -> Option<BlockStateId> {
   109	    let old_faces = existing_faces(old_state, block);
   110	    let new_faces = MultifaceGrowthBlock.faces_for_placement(
   111	        accessor,
   112	        old_faces,
   113	        placement_pos,
   114	        placement_direction,
   115	    )?;
   116	
   117	    let mut props = if old_faces.is_some() {
   118	        GlowLichenLikeProperties::from_state_id(old_state.id, block)
   119	    } else {
   120	        let mut default_props = GlowLichenLikeProperties::default(block);
   121	        default_props.r#waterlogged = is_water_source(old_state);
   122	        default_props
   123	    };
   124	    props.set_faces(new_faces);
   125	    Some(props.to_state_id(block))
   126	}
   127	
   128	/// A `SpreadTarget` writing into a live `World`, mirroring `DefaultSpreaderConfig#placeBlock`'s
   129	/// inherited `SpreadConfig.placeBlock` default (`level.setBlock(spreadPos.pos(), state, 2)`,
   130	/// i.e. `NOTIFY_LISTENERS` only).
   131	struct WorldSpreadTarget<'a> {
   132	    world: &'a Arc<World>,
   133	    block: &'static Block,
   134	}
   135	
   136	impl SpreadTarget for WorldSpreadTarget<'_> {
   137	    fn accessor(&self) -> &dyn BlockAccessor {
   138	        self.world.as_ref()
   139	    }
   140	
   141	    fn place(&self, spread_pos: SpreadPos) -> BlockFuture<'_, bool> {
   142	        Box::pin(async move {
   143	            let existing_state = self.world.get_block_state(&spread_pos.pos);
   144	            let Some(new_state_id) = state_for_placement(
   145	                self.world.as_ref(),
   146	                self.block,
   147	                existing_state,
   148	                &spread_pos.pos,
   149	                spread_pos.face,
   150	            ) else {
   151	                return false;
   152	            };
   153	            self.world
   154	                .set_block_state(&spread_pos.pos, new_state_id, BlockFlags::NOTIFY_LISTENERS)
   155	                .await;
   156	            true
   157	        })
   158	    }
   159	}
   160	
   161	impl BlockBehaviour for MultifaceGrowthBlock {
   162	    /// `MultifaceBlock#getStateForPlacement(BlockPlaceContext)` (MultifaceBlock.java:179-189):
   163	    /// try the player's nearest looking directions in order and take the first that works.
   164	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   165	        Box::pin(async move {
   166	            let old_state = args.world.get_block_state(args.position);
   167	            let existing = match args.replacing {
   168	                BlockIsReplacing::Itself(state_id) => {
   169	                    Some(GlowLichenLikeProperties::from_state_id(state_id, args.block).faces())
   170	                }
   171	                _ => None,
   172	            };
   173	
   174	            let mut candidates: Vec<BlockDirection> = args
   175	                .player
   176	                .get_entity()
   177	                .get_entity_facing_order()
   178	                .into_iter()
   179	                .map(|f| f.to_block_direction())
   180	                .collect();
   181	            if let Some(idx) = candidates.iter().position(|&d| d == args.direction) {
   182	                candidates.remove(idx);
   183	            }
   184	            candidates.insert(0, args.direction);
   185	
   186	            for direction in candidates {
   187	                if let Some(new_faces) =
   188	                    self.faces_for_placement(args.world, existing, args.position, direction)
   189	                {
   190	                    let mut props = if existing.is_some() {
   191	                        GlowLichenLikeProperties::from_state_id(old_state.id, args.block)
   192	                    } else {
   193	                        let mut default_props = GlowLichenLikeProperties::default(args.block);
   194	                        default_props.r#waterlogged = args.replacing.water_source();
   195	                        default_props
   196	                    };
   197	                    props.set_faces(new_faces);
   198	                    return props.to_state_id(args.block);
   199	                }
   200	            }
   201	
   202	            Block::AIR.default_state.id
   203	        })
   204	    }
   205	
   206	    /// `MultifaceBlock#canSurvive` (MultifaceBlock.java:154-167).
   207	    fn can_place_at(&self, args: CanPlaceAtArgs<'_>) -> bool {
   208	        if let Some(direction) = args.direction
   209	            && self.is_valid_state_for_placement(
   210	                args.block_accessor,
   211	                None,
   212	                args.position,
   213	                direction,
   214	            )
   215	        {
   216	            return true;
   217	        }
   218	        BlockDirection::all().into_iter().any(|direction| {
   219	            self.is_valid_state_for_placement(args.block_accessor, None, args.position, direction)
   220	        })
   221	    }
   222	
   223	    /// `MultifaceBlock#canBeReplaced` (MultifaceBlock.java:169-172). This hook only fires when
   224	    /// the clicked block already is this block, so the `!itemInHand.is(this)` half is always
   225	    /// true here and it reduces to a vacant-face check - same reasoning as `sculk_vein.rs`.
   226	    fn can_update_at(&self, args: CanUpdateAtArgs<'_>) -> bool {
   227	        let faces = GlowLichenLikeProperties::from_state_id(args.state_id, args.block).faces();
   228	        has_any_vacant_face(faces)
   229	    }
   230	
   231	    /// `MultifaceBlock#updateShape` (MultifaceBlock.java:118-141).
   232	    fn get_state_for_neighbor_update<'a>(
   233	        &'a self,
   234	        args: GetStateForNeighborUpdateArgs<'a>,
   235	    ) -> BlockFuture<'a, BlockStateId> {
   236	        Box::pin(async move {
   237	            let mut props = GlowLichenLikeProperties::from_state_id(args.state_id, args.block);
   238	            if props.r#waterlogged {
   239	                args.world.schedule_fluid_tick(
   240	                    &pumpkin_data::fluid::Fluid::WATER,
   241	                    *args.position,
   242	                    pumpkin_data::fluid::Fluid::WATER.flow_speed as u8,
   243	                    TickPriority::Normal,
   244	                );
   245	            }
   246	
   247	            let faces = props.faces();
   248	            let neighbor_state = args.neighbor_state_id.to_state();
   249	            self.update_faces_for_neighbor(faces, neighbor_state, args.direction)
   250	                .map_or(Block::AIR.default_state.id, |new_faces| {
   251	                    props.set_faces(new_faces);
   252	                    props.to_state_id(args.block)
   253	                })
   254	        })
   255	    }
   256	
   257	    /// `GlowLichenBlock#isValidBonemealTarget` (GlowLichenBlock.java:31-34). `resin_clump` is a
   258	    /// bare `MultifaceBlock` and implements no `BonemealableBlock`, so it is never a target.
   259	    fn is_valid_bonemeal_target(&self, args: BonemealArgs<'_>) -> bool {
   260	        if args.block != &Block::GLOW_LICHEN {
   261	            return false;
   262	        }
   263	        let faces = GlowLichenLikeProperties::from_state_id(args.state_id, args.block).faces();
   264	        let config = DefaultSpreaderConfig {
   265	            block: &Block::GLOW_LICHEN,
   266	        };
   267	        BlockDirection::all().into_iter().any(|face| {
   268	            can_spread_in_any_direction(
   269	                &config,
   270	                args.world.as_ref(),
   271	                faces,
   272	                *args.position,
   273	                face.opposite(),
   274	            )
   275	        })
   276	    }
   277	
   278	    /// `GlowLichenBlock#performBonemeal` (GlowLichenBlock.java:41-44):
   279	    /// `spreader.spreadFromRandomFaceTowardRandomDirection(state, level, pos, random)`.
   280	    fn perform_bonemeal<'a>(&'a self, args: BonemealArgs<'a>) -> BlockFuture<'a, ()> {
   281	        Box::pin(async move {
   282	            if args.block != &Block::GLOW_LICHEN {
   283	                return;
   284	            }
   285	            let faces = GlowLichenLikeProperties::from_state_id(args.state_id, args.block).faces();
   286	            let config = DefaultSpreaderConfig {
   287	                block: &Block::GLOW_LICHEN,
   288	            };
   289	            let target = WorldSpreadTarget {
   290	                world: args.world,
   291	                block: &Block::GLOW_LICHEN,
   292	            };
   293	            let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(get_seed()));
   294	            multiface_spreader::spread_from_random_face_toward_random_direction(
   295	                &config,
   296	                &target,
   297	                faces,
   298	                *args.position,
   299	                &mut random,
   300	            )
   301	            .await;
   302	        })
   303	    }
   304	}

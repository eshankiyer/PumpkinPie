   140	mod tests {
   141	    use pumpkin_data::{Block, fluid::Fluid};
   142	
   143	    use super::{can_be_replaced, can_be_replaced_with, waterlogged_replacement_state};
   144	
   145	    // Covers `FluidState.canBeReplacedWith` and the water/lava overrides read at
   146	    // `FluidState.java:116-118`, `WaterFluid.java:117-119`, and `LavaFluid.java:170-172`.
   147	    #[test]
   148	    fn fluid_state_replacement_matches_water_and_lava_rules() {
   149	        assert!(can_be_replaced_with(
   150	            &Fluid::EMPTY,
   151	            &Fluid::EMPTY.states[0],
   152	            &Fluid::LAVA,
   153	            pumpkin_data::BlockDirection::North,
   154	        ));
   155	        assert!(can_be_replaced_with(
   156	            &Fluid::WATER,
   157	            &Fluid::WATER.states[0],
   158	            &Fluid::LAVA,
   159	            pumpkin_data::BlockDirection::Down,
   160	        ));
   161	        assert!(!can_be_replaced_with(
   162	            &Fluid::WATER,
   163	            &Fluid::WATER.states[0],
   164	            &Fluid::LAVA,
   165	            pumpkin_data::BlockDirection::North,
   166	        ));
   167	        assert!(!can_be_replaced_with(
   168	            &Fluid::FLOWING_LAVA,
   169	            &Fluid::FLOWING_LAVA.states[2],
   170	            &Fluid::WATER,
   171	            pumpkin_data::BlockDirection::North,
   172	        ));
   173	        assert!(can_be_replaced_with(
   174	            &Fluid::FLOWING_LAVA,
   175	            &Fluid::FLOWING_LAVA.states[3],
   176	            &Fluid::WATER,
   177	            pumpkin_data::BlockDirection::North,
   178	        ));
   179	    }

    74	/// Bridges a real generated block-properties struct to the six face flags.
    75	///
    76	/// This is what `MultifaceBlockBase` logic operates through, so it never has to know
    77	/// which concrete `BlockProperties` type a consumer block uses.
    78	pub trait MultifaceProperties: BlockProperties {
    79	    fn face(&self, direction: BlockDirection) -> bool;
    80	    fn set_face(&mut self, direction: BlockDirection, value: bool);
    81	
    82	    fn faces(&self) -> FaceSet {
    83	        FaceSet::from_directions(BlockDirection::all().into_iter().filter(|&d| self.face(d)))
    84	    }
    85	
    86	    fn set_faces(&mut self, faces: FaceSet) {
    87	        for direction in BlockDirection::all() {
    88	            self.set_face(direction, faces.contains(direction));
    89	        }
    90	    }
    91	}

    33	/// Check if a specific block can be replaced by fluid (based on block properties)
    34	#[must_use]
    35	pub fn can_be_replaced(block_state: &BlockState, block: &Block, fluid: &Fluid) -> bool {
    36	    if fluid.matches_type(&Fluid::WATER)
    37	        && block.has_tag(&tag::Block::MINECRAFT_SLABS)
    38	        && !crate::block::blocks::slabs::can_place_liquid(block, block_state.id)
    39	    {
    40	        return false;
    41	    }
    42	
    43	    // An already waterlogged block retains its host state and is not replaceable.
    44	    if block.is_waterlogged(block_state.id) {
    45	        return false;
    46	    }
    47	
    48	    // Vanilla `LiquidBlockContainer` accepts water into a dry waterloggable block. The caller
    49	    // must change it to the waterlogged state rather than replace the block with a fluid state.
    50	    if fluid.matches_type(&Fluid::WATER) && block.with_waterlogged(block_state.id).is_some() {
    51	        return true;
    52	    }
    53	
    54	    // Fluid Logic
    55	    if let Some(other_fluid) = Fluid::from_state_id(block_state.id) {
    56	        if !fluid.matches_type(other_fluid) {
    57	            return true;
    58	        }
    59	        // Replace current fluid if it is a falling source
    60	        if other_fluid.is_source(block_state.id) && other_fluid.is_falling(block_state.id) {
    61	            return true;
    62	        }
    63	    }
    64	
    65	    let id = block.id;
    66	
    67	    // Blocks that fluid should never replace
    68	    if block.has_tag(&tag::Block::MINECRAFT_DOORS)
    69	        || block.has_tag(&tag::Block::MINECRAFT_BEDS)
    70	        || block.has_tag(&tag::Block::MINECRAFT_LEAVES)
    71	        || block.has_tag(&tag::Block::MINECRAFT_PRESSURE_PLATES)
    72	        || block.has_tag(&tag::Block::C_CLUSTERS)
    73	        || block.has_tag(&tag::Block::MINECRAFT_WALL_CORALS)
    74	        || block.has_tag(&tag::Block::MINECRAFT_SHULKER_BOXES)
    75	        || block.has_tag(&tag::Block::MINECRAFT_PORTALS)
    76	        || id == Block::BELL.id
    77	        || id == Block::BIG_DRIPLEAF.id
    78	        || id == Block::BIG_DRIPLEAF_STEM.id
    79	        || id == Block::SMALL_DRIPLEAF.id
    80	        || id == Block::CAKE.id
    81	        || id == Block::CONDUIT.id
    82	        || id == Block::CAMPFIRE.id
    83	        || id == Block::DRAGON_EGG.id
    84	        || id == Block::KELP.id
    85	        || id == Block::KELP_PLANT.id
    86	        || id == Block::SEAGRASS.id
    87	        || id == Block::TALL_SEAGRASS.id
    88	        || id == Block::LADDER.id
    89	        || id == Block::POINTED_DRIPSTONE.id
    90	        || id == Block::SCAFFOLDING.id
    91	    {
    92	        return false;
    93	    }
    94	
    95	    // Only replace air, explicitly replaceable blocks, or carpets
    96	    block_state.replaceable()
    97	        || id == Block::AIR.id
    98	        || block.has_tag(&tag::Block::MINECRAFT_WOOL_CARPETS)
    99	        // Only use PistonBehavior::Destroy if it didn't pass the checks above
   100	        || block_state.piston_behavior == pumpkin_data::block_state::PistonBehavior::Destroy
   101	}

   163	async fn update_leaves_and_grow(world: Arc<World>, position: &BlockPos) {
   164	    let above_pos = position.up();
   165	    let below_pos = position.down();
   166	    let two_below_pos = position.down_height(2);
   167	
   168	    let (block, state_id) = world.get_block_and_state_id(position);
   169	    let state_above = world.get_block_state(&above_pos);
   170	
   171	    if !state_above.is_air() {
   172	        return;
   173	    }
   174	
   175	    let mut props = BambooLikeProperties::from_state_id(state_id, block);
   176	    if props.stage != 0 {
   177	        return;
   178	    }
   179	
   180	    // `growBamboo`'s `height` argument: the stalk blocks below plus this one
   181	    // (`BambooStalkBlock.randomTick` passes `getHeightBelowUpToMax(level, pos) + 1`).
   182	    let height = count_bamboo_below(&world, position) + 1;
   183	    if height >= MAX_STALK_HEIGHT {
   184	        return;
   185	    }
   186	    let (block_below, state_id_below) = world.get_block_and_state_id(&below_pos);
   187	    let (block_two_below, state_id_two_below) = world.get_block_and_state_id(&two_below_pos);
   188	
   189	    let mut props_below = BambooLikeProperties::from_state_id(state_id_below, block_below);
   190	
   191	    if height >= 1 {
   192	        let below_is_bamboo = block_below == &Block::BAMBOO;
   193	        let below_has_leaves = props_below.leaves != BambooLeaves::None;
   194	
   195	        props.leaves = if !below_is_bamboo || !below_has_leaves {
   196	            BambooLeaves::Small
   197	        } else {
   198	            BambooLeaves::Large
   199	        };
   200	
   201	        if props.leaves == BambooLeaves::Large && block_two_below == &Block::BAMBOO {
   202	            props_below.leaves = BambooLeaves::Small;
   203	
   204	            let mut props_two_below =
   205	                BambooLikeProperties::from_state_id(state_id_two_below, block_two_below);
   206	            props_two_below.leaves = BambooLeaves::None;
   207	
   208	            world
   209	                .set_block_state(
   210	                    &below_pos,
   211	                    props_below.to_state_id(block_below),
   212	                    BlockFlags::NOTIFY_ALL,
   213	                )
   214	                .await;
   215	            world
   216	                .set_block_state(
   217	                    &two_below_pos,
   218	                    props_two_below.to_state_id(block_two_below),
   219	                    BlockFlags::NOTIFY_ALL,
   220	                )
   221	                .await;
   222	        }
   223	    }
   224	
   225	    props.age = u8::from(!(props.age != 1 && block_two_below == &Block::BAMBOO));
   226	
   227	    props.stage = grown_stage(height, rand::rng().random::<f32>());
   228	
   229	    world
   230	        .set_block_state(&above_pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
   231	        .await;
   232	}

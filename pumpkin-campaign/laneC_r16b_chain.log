   240	            let spread_level = level + 1;
   241	            if spread_level >= Self::MAX_LEVEL {
   242	                continue;
   243	            }
   244	            for dx in -1..2 {
   245	                for dy in -1..2 {
   246	                    let new_pos = pos.add_raw(dx, dy);

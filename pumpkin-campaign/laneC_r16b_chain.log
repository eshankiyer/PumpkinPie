    32	impl FlowingLava {
    33	    fn can_spread_fire_around(world: &Arc<World>, pos: &BlockPos) -> bool {
    34	        let spread_radius = world
    35	            .level_info
    36	            .load()
    37	            .game_rules
    38	            .fire_spread_radius_around_player;
    39	
    40	        if spread_radius == 0 {
    41	            return false;
    42	        }
    43	        if spread_radius == -1 {
    44	            return true;
    45	        }
    46	
    47	        world
    48	            .get_closest_player(pos.to_centered_f64(), spread_radius as f64)
    49	            .is_some()
    50	    }
    51	
    52	    fn is_flammable_state(block_state: &BlockState) -> bool {
    53	        let block = Block::from_state_id(block_state.id);
    54	        // `LavaFluid.isFlammable` delegates to `BlockState.ignitedByLava` (`LavaFluid.java:125-137`),
    55	        // which is distinct from the fire-spread odds and waterlogged check used by FireBlock.
    56	        block.ignited_by_lava()
    57	    }
    58	
    59	    fn is_flammable(world: &Arc<World>, pos: &BlockPos) -> bool {
    60	        world
    61	            .get_block_state_if_loaded(pos)
    62	            .is_some_and(Self::is_flammable_state)
    63	    }
    64	
    65	    fn has_flammable_neighbours(world: &Arc<World>, pos: &BlockPos) -> bool {
    66	        BlockDirection::all()
    67	            .iter()
    68	            .any(|dir| Self::is_flammable(world, &pos.offset(dir.to_offset())))
    69	    }
    70	
    71	    fn can_resolve_fire_state_without_loading(world: &Arc<World>, pos: &BlockPos) -> bool {
    72	        if !world.is_loaded(pos) || !world.is_loaded(&pos.down()) {
    73	            return false;
    74	        }
    75	
    76	        BlockDirection::all()
    77	            .iter()
    78	            .all(|dir| world.is_loaded(&pos.offset(dir.to_offset())))
    79	    }
    80	
    81	    async fn ignite_fire_if_possible(world: &Arc<World>, pos: &BlockPos) {
    82	        if !Self::can_resolve_fire_state_without_loading(world, pos) {
    83	            return;
    84	        }
    85	
    86	        let fire_state_id = FireBlock.get_state_for_position(world.as_ref(), &Block::FIRE, pos);
    87	        world
    88	            .set_block_state(pos, fire_state_id, BlockFlags::NOTIFY_ALL)
    89	            .await;
    90	    }
    91	
    92	    async fn receive_neighbor_fluids(
    93	        world: &Arc<World>,
    94	        _fluid: &Fluid,
    95	        block_pos: &BlockPos,
    96	    ) -> bool {
    97	        // Logic to determine if we should replace the fluid with any of (cobble, obsidian, stone, etc.)
    98	        let below_is_soul_soil = world
    99	            .get_block(&block_pos.offset(BlockDirection::Down.to_offset()))
   100	            == &Block::SOUL_SOIL;
   101	        let is_still = world.get_block_state_id(block_pos) == Block::LAVA.default_state.id;
   102	
   103	        // `LiquidBlock.shouldSpreadLiquid` walks POSSIBLE_FLOW_DIRECTIONS and dereferences the
   104	        // OPPOSITE of each, so the neighbours it tests are up, north, south, west and east. The
   105	        // block below is deliberately never tested, and the test is on the neighbour's fluid
   106	        // state, so a waterlogged slab or stairs counts as water.
   107	        for dir in BlockDirection::all() {
   108	            if dir == BlockDirection::Down {
   109	                continue;
   110	            }
   111	            let neighbor_pos = block_pos.offset(dir.to_offset());
   112	            let (neighbor_fluid, _) = world.get_fluid_and_fluid_state(&neighbor_pos);
   113	            if neighbor_fluid == &Fluid::WATER || neighbor_fluid == &Fluid::FLOWING_WATER {
   114	                let block = if is_still {
   115	                    Block::OBSIDIAN
   116	                } else {
   117	                    Block::COBBLESTONE
   118	                };
   119	                world
   120	                    .set_block_state(
   121	                        block_pos,
   122	                        block.default_state.id,
   123	                        BlockFlags::NOTIFY_NEIGHBORS,
   124	                    )
   125	                    .await;
   126	                world.sync_world_event(WorldEvent::LavaFizz, *block_pos, 0);
   127	                return false;
   128	            }
   129	            if below_is_soul_soil && world.get_block(&neighbor_pos) == &Block::BLUE_ICE {
   130	                if let Some(server) = world.server.upgrade() {
   131	                    let mut event =
   132	                        crate::plugin::api::events::block::block_form::BlockFormEvent::new(
   133	                            *block_pos,
   134	                            &Block::BASALT,
   135	                        );
   136	                    server.plugin_manager.fire(&server, &mut event).await;
   137	                    if event.cancelled {
   138	                        return false;
   139	                    }
   140	                }
   141	                world
   142	                    .set_block_state(
   143	                        block_pos,
   144	                        Block::BASALT.default_state.id,
   145	                        BlockFlags::NOTIFY_NEIGHBORS,
   146	                    )
   147	                    .await;
   148	                world.sync_world_event(WorldEvent::LavaFizz, *block_pos, 0);
   149	                return false;
   150	            }
   151	        }
   152	        true
   153	    }
   154	}

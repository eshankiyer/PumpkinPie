   181	    #[test]
   182	    fn water_flows_into_dry_waterloggable_blocks_without_replacing_them() {
   183	        let block = &Block::OAK_SLAB;
   184	        let dry = block.default_state;
   185	        let waterlogged_id = waterlogged_replacement_state(dry, block, &Fluid::WATER)
   186	            .expect("oak slabs have a waterlogged state");
   187	
   188	        assert!(can_be_replaced(dry, block, &Fluid::WATER));
   189	        assert!(block.is_waterlogged(waterlogged_id));
   190	        assert!(waterlogged_replacement_state(dry, block, &Fluid::LAVA).is_none());
   191	    }
   192	}

    15	pub fn get_view_distance(player: &Player) -> NonZero<u8> {
    16	    let fallback = NonZero::new(2).unwrap_or(NonZero::<u8>::MIN);
    17	    let Some(server) = player.world().server.upgrade() else {
    18	        return fallback;
    19	    };
    20	    let max_view_distance = match player.client.as_ref() {
    21	        ClientPlatform::Java(_) => server.advanced_config.networking.java.view_distance,
    22	        ClientPlatform::Bedrock(_) => server.advanced_config.networking.bedrock.view_distance,
    23	    };
    24	    player
    25	        .config
    26	        .load()
    27	        .view_distance
    28	        .clamp(fallback, max_view_distance)
    29	}

   127	pub const fn can_attach_to(
   128	    neighbour_state: &BlockState,
   129	    direction_towards_neighbour: BlockDirection,
   130	) -> bool {
   131	    neighbour_state.is_side_solid(direction_towards_neighbour.opposite())
   132	}

    11	/// `FluidState.canBeReplacedWith` (`FluidState.java:116-118`) delegates to the owning fluid;
    12	/// water and lava provide the live rules in `WaterFluid.java:117-119` and `LavaFluid.java:170-172`.
    13	#[must_use]
    14	pub fn can_be_replaced_with(
    15	    fluid: &Fluid,
    16	    state: &FluidState,
    17	    other: &Fluid,
    18	    direction: BlockDirection,
    19	) -> bool {
    20	    if fluid == &Fluid::EMPTY {
    21	        return true;
    22	    }
    23	
    24	    if fluid.matches_type(&Fluid::WATER) {
    25	        return direction == BlockDirection::Down && !other.matches_type(&Fluid::WATER);
    26	    }
    27	
    28	    fluid.matches_type(&Fluid::LAVA)
    29	        && state.height >= 0.444_444_45
    30	        && other.matches_type(&Fluid::WATER)
    31	}

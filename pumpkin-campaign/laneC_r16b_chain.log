   189	/// (`LevelAccessor` reads and writes go through the same mutable level object).
   190	pub trait SpreadTarget: Send + Sync {
   191	    fn accessor(&self) -> &dyn BlockAccessor;
   192	
   193	    /// Attempts to place at `spread_pos`, returning whether it succeeded.
   194	    fn place(&self, spread_pos: SpreadPos) -> BlockFuture<'_, bool>;
   195	}

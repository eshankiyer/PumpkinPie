   460	    pub fn load(
   461	        level: Arc<Level>,
   462	        level_info: Arc<ArcSwap<LevelData>>,
   463	        scoreboard: Arc<tokio::sync::Mutex<Scoreboard>>,
   464	        dimension: Dimension,
   465	        block_registry: Arc<BlockRegistry>,
   466	        server: Weak<Server>,
   467	    ) -> Self {
   468	        let generation_settings = GenerationSettings::from_dimension(&dimension);
   469	        let persisted_level_info = level_info.load();
   470	        let level_time = LevelTime::with_time_of_day(persisted_level_info.day_time);
   471	        let weather = Weather::from_persisted(
   472	            persisted_level_info.clear_weather_time,
   473	            persisted_level_info.rain_time,
   474	            persisted_level_info.raining,
   475	            persisted_level_info.thunder_time,
   476	            persisted_level_info.thundering,
   477	        );
   478	        // Vanilla stores the border as the `minecraft:world_border` saved data
   479	        // (`WorldBorder.java:25-27`); `LevelData` carries it in from there.
   480	        let worldborder = Worldborder::from_settings(&WorldBorderData {
   481	            center_x: persisted_level_info.border_center_x,
   482	            center_z: persisted_level_info.border_center_z,
   483	            damage_per_block: persisted_level_info.border_damage_per_block,
   484	            safe_zone: persisted_level_info.border_safe_zone,

    89	async fn grow_bamboo(world: &std::sync::Arc<crate::world::World>, position: &BlockPos) {
    90	    let mut props =
    91	        BambooLikeProperties::from_state_id(Block::BAMBOO.default_state.id, &Block::BAMBOO);
    92	    props.leaves = BambooLeaves::Small;

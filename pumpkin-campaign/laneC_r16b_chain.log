   155	/// `SpreadConfig.placeBlock`'s state-computation half (the write itself is the
   156	/// caller's responsibility, since it differs between a live `World` and a test double):
   157	/// given the position's current state and a spread target, returns the new
   158	/// `sculk_vein` state id to write, or `None` if placement is not valid there (mirrors
   159	/// `MultifaceBlock.getStateForPlacement` returning `null`).
   160	fn compute_spread_placement_state(
   161	    accessor: &dyn BlockAccessor,
   162	    existing_state: &BlockState,
   163	    spread_pos: SpreadPos,
   164	) -> Option<BlockStateId> {
   165	    let existing_faces = existing_vein_faces(existing_state);
   166	    let new_faces = SculkVeinBlock.faces_for_placement(
   167	        accessor,
   168	        existing_faces,
   169	        &spread_pos.pos,
   170	        spread_pos.face,
   171	    )?;
   172	
   173	    let mut props = if existing_faces.is_some() {
   174	        GlowLichenLikeProperties::from_state_id(existing_state.id, &Block::SCULK_VEIN)
   175	    } else {
   176	        let mut default_props = GlowLichenLikeProperties::default(&Block::SCULK_VEIN);
   177	        default_props.r#waterlogged = is_water_source(existing_state);
   178	        default_props
   179	    };
   180	    props.set_faces(new_faces);
   181	    Some(props.to_state_id(&Block::SCULK_VEIN))
   182	}
   183	
   184	/// `SculkVeinBlock.SculkVeinSpreaderConfig#stateCanBeReplaced`.
   185	fn state_can_be_replaced(
   186	    accessor: &dyn BlockAccessor,
   187	    source_pos: BlockPos,
   188	    spread_pos: SpreadPos,
   189	) -> bool {
   190	    let against_pos = spread_pos.pos.offset(spread_pos.face.to_offset());
   191	    let against_block = accessor.get_block(&against_pos);
   192	    if against_block == &Block::SCULK
   193	        || against_block == &Block::SCULK_CATALYST
   194	        || against_block == &Block::MOVING_PISTON
   195	    {
   196	        return false;
   197	    }
   198	
   199	    if source_pos.manhattan_distance(spread_pos.pos) == 2 {
   200	        let neighbour_pos = source_pos.offset(spread_pos.face.opposite().to_offset());
   201	        let neighbour_state = accessor.get_block_state(&neighbour_pos);
   202	        if neighbour_state.is_side_solid(spread_pos.face) {
   203	            return false;
   204	        }
   205	    }
   206	
   207	    let existing_fluid = accessor.get_fluid(&spread_pos.pos);
   208	    if existing_fluid != pumpkin_data::fluid::Fluid::EMPTY
   209	        && !existing_fluid.has_tag(&tag::Fluid::MINECRAFT_WATER)
   210	    {
   211	        return false;
   212	    }
   213	
   214	    let existing_state = accessor.get_block_state(&spread_pos.pos);
   215	    let existing_block = Block::from_state_id(existing_state.id);
   216	    if existing_block.has_tag(&tag::Block::MINECRAFT_FIRE) {
   217	        return false;
   218	    }
   219	
   220	    existing_state.replaceable() || default_state_can_be_replaced(existing_state)
   221	}

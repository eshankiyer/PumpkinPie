   506	                    bytes,
   507	                )),
   508	            ) {
   509	            nbt.root_tag
   510	        } else {
   511	            NbtCompound::new()
   512	        };
   513	
   514	        Self {
   515	            uuid: Uuid::new_v4(),
   516	            level,
   517	            level_info,
   518	            players: ArcSwap::new(Arc::new(Vec::new())),
   519	            entities: ArcSwap::new(Arc::new(Vec::new())),
   520	            scoreboard,
   521	            worldborder: Mutex::new(worldborder),
   522	            level_time: Mutex::new(level_time),
   523	            sky_darken: AtomicU8::new(0),
   524	            dimension,
   525	            weather: Mutex::new(weather),
   526	            block_registry,
   527	            sea_level: generation_settings.sea_level,
   528	            min_y: i32::from(generation_settings.shape.min_y),
   529	            synced_block_event_queue: Mutex::new(Vec::new()),
   530	            unsent_block_changes: Mutex::new(HashMap::new()),
   531	            block_mutation_versions: DashMap::new(),
   532	            portal_poi: Mutex::new(portal_poi),
   533	            villager_poi: Mutex::new(villager_poi::VillagerPoiStorage::default()),
   534	            dragon_fight,
   535	            raids: Mutex::new(raid::RaidManager::new()),
   536	            spawn_state: ArcSwap::new(Arc::new(SpawnState::empty())),
   537	            active_chunks: ArcSwap::new(Arc::new(FxHashSet::default())),
   538	            server,
   539	            block_entities: DashMap::new(),
   540	            game_event_listeners: Mutex::new(Vec::new()),
   541	            block_ticks_this_tick: std::sync::Mutex::new(FxHashSet::default()),
   542	            redstone_torch_toggles: Mutex::new(
   543	                crate::block::blocks::redstone::redstone_torch::RecentToggles::default(),
   544	            ),
   545	            phantom_spawn_tick: AtomicI32::new(0),
   546	            cat_spawn_tick: AtomicI32::new(0),
   547	            trader_tick_delay: AtomicI32::new(1200),
   548	            trader_spawn_delay: AtomicI32::new(24000),
   549	            trader_spawn_chance: AtomicI32::new(25),
   550	            village_siege: custom_spawners::VillageSiegeState::new(),
   551	            custom_data: std::sync::Mutex::new(custom_data),
   552	            custom_block_entity_data: DashMap::new(),

    83	    /// a bamboo sapling yields a bamboo stalk rather than the (unobtainable) sapling block.
    84	    fn get_clone_item_stack(&self, _args: GetCloneItemStackArgs<'_>) -> Option<ItemStack> {
    85	        Some(ItemStack::new(1, &Item::BAMBOO))
    86	    }

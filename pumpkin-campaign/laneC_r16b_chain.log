   350	    }
   351	
   352	    fn push_entities_up(&self, pos: BlockPos) {
   353	        // Simplified `Block.pushEntitiesUp`, matching the existing approximation in
   354	        // `farmland.rs`/`dirt_path.rs`: teleport entities in this 1x1x1 column up by one
   355	        // block rather than diffing old/new collision shapes.
   356	        let min = Vector3::new(f64::from(pos.0.x), f64::from(pos.0.y), f64::from(pos.0.z));
   357	        let max = Vector3::new(min.x + 1.0, min.y + 1.0, min.z + 1.0);
   358	        let aabb = BoundingBox::new(min, max);
   359	        for entity in self.world.get_entities_at_box(&aabb) {
   360	            let entity = entity.get_entity();
   361	            let entity_pos = entity.pos.load();
   362	            entity
   363	                .pos
   364	                .store(Vector3::new(entity_pos.x, entity_pos.y + 1.0, entity_pos.z));
   365	        }
   366	    }
   367	}

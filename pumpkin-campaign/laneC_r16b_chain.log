   420	    pub async fn get_block_state_id_async(&self, position: &BlockPos) -> BlockStateId {
   421	        if !self.is_in_build_limit(*position) {
   422	            return Block::AIR.default_state.id;
   423	        }
   424	
   425	        let (chunk_coordinate, relative) = position.chunk_and_chunk_relative_position();
   426	        self.level
   427	            .get_or_fetch_chunk(chunk_coordinate, |chunk| {
   428	                chunk
   429	                    .section
   430	                    .get_block_absolute_y(relative.x as usize, relative.y, relative.z as usize)
   431	                    .unwrap_or(Block::AIR.default_state.id)
   432	            })
   433	            .await
   434	    }
   435	
   436	    pub async fn get_block_state_async(&self, position: &BlockPos) -> &'static BlockState {
   437	        let id = self.get_block_state_id_async(position).await;
   438	        BlockState::from_id(id)
   439	    }

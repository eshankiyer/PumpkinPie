  2680	    /// or `f64::NEG_INFINITY` if no valid surface exists.
  2681	    pub fn get_dismount_height(&self, pos: &BlockPos) -> f64 {
  2682	        let state = self.get_block_state(pos);
  2683	        let max_y = state
  2684	            .get_block_collision_shapes_at(pos)
  2685	            .map(|s| s.max.y)
  2686	            .fold(f64::NEG_INFINITY, f64::max);
  2687	        if max_y != f64::NEG_INFINITY {
  2688	            return max_y;
  2689	        }
  2690	        // No collision at pos — check block below
  2691	        let below = BlockPos(Vector3::new(pos.0.x, pos.0.y - 1, pos.0.z));
  2692	        let below_state = self.get_block_state(&below);
  2693	        let below_max_y = below_state
  2694	            .get_block_collision_shapes_at(&below)
  2695	            .map(|s| s.max.y)
  2696	            .fold(f64::NEG_INFINITY, f64::max);
  2697	        if below_max_y >= 1.0 {
  2698	            below_max_y - 1.0
  2699	        } else {
  2700	            f64::NEG_INFINITY
  2701	        }
  2702	    }

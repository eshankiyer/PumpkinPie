    39	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
    40	        Box::pin(async move {
    41	            if args.block == &Block::BAMBOO_SAPLING
    42	                && args.world.get_block(&args.position.up()) == &Block::BAMBOO
    43	            {
    44	                args.world
    45	                    .set_block_state(
    46	                        args.position,
    47	                        Block::BAMBOO.default_state.id,
    48	                        BlockFlags::NOTIFY_NEIGHBORS,
    49	                    )
    50	                    .await;
    51	            }
    52	        })
    53	    }
    54	
    55	    fn get_state_for_neighbor_update<'a>(
    56	        &'a self,
    57	        args: GetStateForNeighborUpdateArgs<'a>,
    58	    ) -> BlockFuture<'a, BlockStateId> {
    59	        Box::pin(async move {
    60	            if !<Self as PlantBlockBase>::can_place_at(self, args.world, args.position) {
    61	                return Block::AIR.default_state.id;
    62	            }
    63	            if args.direction == BlockDirection::Up
    64	                && args.world.get_block(args.neighbor_position) == &Block::BAMBOO
    65	            {
    66	                return Block::BAMBOO.default_state.id;
    67	            }
    68	            args.state_id
    69	        })
    70	    }
    71	
    72	    fn random_tick<'a>(&'a self, args: crate::block::RandomTickArgs<'a>) -> BlockFuture<'a, ()> {
    73	        Box::pin(async move {
    74	            let state_above = args.world.get_block_state(&args.position.up());
    75	            if !state_above.is_air() || rand::rng().random_range(0..3) > 0 {
    76	                return;
    77	            }
    78	            grow_bamboo(args.world, args.position).await;
    79	        })
    80	    }

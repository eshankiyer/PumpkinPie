   279	                            // PistonMovingBlockEntity.tick: the moved block can no longer
   280	                            // exist at its destination (e.g. an attached block lost its
   281	                            // support). Vanilla places it, then destroys it properly
   282	                            // (drops, block-break side effects) instead of it vanishing.
   283	                            world
   284	                                .clone()
   285	                                .set_block_state(
   286	                                    &pos,
   287	                                    self.pushed_block_state.id,
   288	                                    BlockFlags::FORCE_STATE | BlockFlags::MOVED,
   289	                                )
   290	                                .await;
   291	                            world
   292	                                .clone()
   293	                                .break_block(&pos, None, BlockFlags::MOVED)
   294	                                .await;
   295	                        } else {
   296	                            // PistonMovingBlockEntity.tick: a piston-moved block never
   297	                            // arrives waterlogged, even if update_from_neighbor_shapes
   298	                            // recomputed it that way.
   299	                            let block = Block::from_state_id(updated_state);
   300	                            let final_state = if block.is_waterlogged(updated_state) {
   301	                                let mut props = block.properties(updated_state).unwrap().to_props();
   302	                                if let Some(entry) =
   303	                                    props.iter_mut().find(|(k, _)| *k == "waterlogged")
   304	                                {
   305	                                    entry.1 = "false";
   306	                                }
   307	                                block.from_properties(&props).to_state_id(block)
   308	                            } else {
   309	                                updated_state
   310	                            };
   311	                            world
   312	                                .clone()
   313	                                .set_block_state(
   314	                                    &pos,
   315	                                    final_state,
   316	                                    BlockFlags::NOTIFY_ALL | BlockFlags::MOVED,
   317	                                )
   318	                                .await;
   319	                            world.clone().update_neighbors(&pos, None).await;
   320	                        }
   321	                    }
   322	                }
   323	                return;
   324	            }
   325	            let new_progress = (current_progress + 0.5).min(1.0);
   326	            self.push_entities(world, new_progress).await;
   327	            self.current_progress.store(new_progress);
   328	        })
   329	    }

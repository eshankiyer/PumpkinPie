    63	            .mob_entity
    64	            .living_entity
    65	            .attributes
    66	            .write()
    67	            .unwrap()
    68	            .get_mut(&Attributes::MAX_HEALTH.id)
    69	        {
    70	            attribute.base_value = 25.0;
    71	            attribute.dirty.store(true, Relaxed);
    72	        }
    73	        mob_arc.mob_entity.living_entity.health.store(25.0);
    74	        AbstractHorse::randomize_attributes(mob_arc.as_ref(), &mut rand::rng());
    75	
    76	        let mob_weak: Weak<dyn Mob> = {

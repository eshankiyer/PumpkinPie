   200	    fn mob_init_data_tracker(&self) -> EntityBaseFuture<'_, ()> {
   201	        Box::pin(async move {
   202	            let entity = self.get_entity();
   203	            // Re-sends `BABY_ID` (dropped by overriding `mob_init_data_tracker`), matching the
   204	            // blanket `Mob` `EntityBase` impl's default behavior (`mob/mod.rs`) -- same reason
   205	            // `CatEntity` re-sends it manually.
   206	            if entity.age.load(std::sync::atomic::Ordering::Relaxed) < 0 {
   207	                entity.send_meta_data(&[Metadata::new(tracked_data::camel::BABY_ID, true)], None);
   208	            }
   209	            entity.send_meta_data(&[Metadata::new(tracked_data::camel::DASH, false)], None);
   210	        })
   211	    }
   212	
   213	    /// `Camel.aiStep`'s dash-cooldown handling (`Camel.java:187-193`): once dashing, the flag
   214	    /// clears as soon as the cooldown drops under 50 ticks and the camel is grounded, in liquid,
   215	    /// or carrying a passenger; the cooldown itself always ticks down to zero regardless.
   216	    fn mob_tick<'a>(&'a self, _caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   217	        Box::pin(async move {
   218	            let entity = self.get_entity();
   219	            let cooldown = self.dash_cooldown.load(Relaxed);
   220	
   221	            if self.is_dashing() && cooldown < DASH_CLEAR_THRESHOLD {
   222	                let grounded =
   223	                    entity.on_ground.load(Relaxed) || entity.touching_water.load(Relaxed);
   224	                let carrying_passenger = !entity.passengers.lock().await.is_empty();
   225	                if grounded || carrying_passenger {
   226	                    self.set_dashing(false);
   227	                }
   228	            }
   229	
   230	            if cooldown > 0 {
   231	                self.dash_cooldown.store(cooldown - 1, Relaxed);
   232	            }
   233	        })
   234	    }
   235	}


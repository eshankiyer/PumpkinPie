   279	    /// clears as soon as the cooldown drops under 50 ticks and the camel is grounded, in liquid,
   280	    /// or carrying a passenger; the cooldown itself always ticks down to zero regardless.
   281	    fn mob_tick<'a>(&'a self, _caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   282	        Box::pin(async move {
   283	            let entity = self.get_entity();
   284	            let cooldown = self.dash_cooldown.load(Relaxed);
   285	
   286	            if self.is_dashing() && cooldown < DASH_CLEAR_THRESHOLD {
   287	                let grounded =
   288	                    entity.on_ground.load(Relaxed) || entity.touching_water.load(Relaxed);
   289	                let carrying_passenger = !entity.passengers.lock().await.is_empty();
   290	                if grounded || carrying_passenger {
   291	                    self.set_dashing(false);
   292	                }
   293	            }
   294	
   295	            if cooldown > 0 {
   296	                if cooldown == 1 {
   297	                    self.get_entity().play_sound(self.dash_ready_sound());
   298	                }
   299	                self.dash_cooldown.store(cooldown - 1, Relaxed);
   300	            }
   301	        })
   302	    }

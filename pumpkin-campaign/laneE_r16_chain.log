    60	/// `AbstractHorse.equipBodyArmor` uses the animal-body equipment component and
    61	/// its allowed-entity predicate. Keep this separate from the generic mob helper,
    62	/// whose tag handling is intentionally more limited.
    63	pub(crate) fn is_valid_body_armor_item(stack: &ItemStack, entity_type: &EntityType) -> bool {
    64	    stack
    65	        .get_data_component::<EquippableImpl>()
    66	        .is_some_and(|equippable| {
    67	            *equippable.slot == EquipmentSlot::BODY
    68	                && equippable
    69	                    .allowed_entities
    70	                    .as_ref()
    71	                    .is_none_or(|allowed| match allowed {
    72	                        IDSet::Tag(tag) => entity_type.is_tagged_with(tag).unwrap_or(false),
    73	                        IDSet::IDs(ids) => ids.iter().any(|allowed| allowed.id == entity_type.id),
    74	                    })
    75	        })
    76	}

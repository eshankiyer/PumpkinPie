   256	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   257	        Box::pin(async move {
   258	            let current_progress = self.current_progress.load();
   259	            self.last_progress.store(current_progress);
   260	            if current_progress >= 1.0 {
   261	                let pos = self.position;
   262	                world.remove_block_entity(&pos);
   263	                if world.get_block(&pos) == &Block::MOVING_PISTON {
   264	                    if self.pushed_block_state.is_air() {
   265	                        world
   266	                            .clone()
   267	                            .set_block_state(
   268	                                &pos,
   269	                                self.pushed_block_state.id,
   270	                                BlockFlags::FORCE_STATE | BlockFlags::MOVED,
   271	                            )
   272	                            .await;
   273	                    } else {
   274	                        let updated_state = world
   275	                            .clone()
   276	                            .update_from_neighbor_shapes(self.pushed_block_state.id, &pos)
   277	                            .await;

   443	impl NBTStorage for ZombieNautilusEntity {
   444	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   445	        Box::pin(async move {
   446	            self.mob_entity.living_entity.write_nbt(nbt).await;
   447	            self.write_animal_nbt(nbt);
   448	            nbt.put_bool("IsTame", self.is_tame.load(Ordering::Relaxed));
   449	            nbt.put_bool("Saddled", self.is_saddled.load(Ordering::Relaxed));
   450	            nbt.put_int("DashCooldown", self.dash_cooldown.load(Ordering::Relaxed));
   451	            nbt.put_string(
   452	                "variant",
   453	                variant_name_from_id(self.get_variant()).to_string(),
   454	            );
   455	            if let Some(owner) = self.owner.load() {
   456	                nbt.put_uuid("Owner", owner);
   457	            }
   458	        })
   459	    }
   460	
   461	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   462	        Box::pin(async move {
   463	            self.mob_entity.living_entity.read_nbt_non_mut(nbt).await;
   464	            self.read_animal_nbt(nbt);
   465	            if let Some(is_tame) = nbt.get_bool("IsTame") {
   466	                self.is_tame.store(is_tame, Ordering::Relaxed);
   467	            }
   468	            if let Some(saddled) = nbt.get_bool("Saddled") {
   469	                self.is_saddled.store(saddled, Ordering::Relaxed);
   470	            }
   471	            if let Some(dash) = nbt.get_int("DashCooldown") {
   472	                self.dash_cooldown.store(dash, Ordering::Relaxed);
   473	            }
   474	            if let Some(variant) = nbt.get_string("variant") {
   475	                self.variant
   476	                    .store(variant_id_from_name(variant), Ordering::Relaxed);
   477	            }
   478	            if let Some(owner) = nbt.get_uuid("Owner") {
   479	                self.owner.store(Some(owner));
   480	            }
   481	        })
   482	    }
   483	}

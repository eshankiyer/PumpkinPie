   620	    fn mob_interact<'a>(
   621	        &'a self,
   622	        player: &'a Arc<Player>,
   623	        item_stack: &'a mut ItemStack,
   624	    ) -> EntityBaseFuture<'a, bool> {
   625	        Box::pin(async move {
   626	            let entity = &self.mob_entity.living_entity.entity;
   627	
   628	            if !self.is_tame() && self.is_food(item_stack) {
   629	                item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   630	                let world = entity.world.load();
   631	                if rand::random::<u32>().is_multiple_of(3) {
   632	                    self.set_tame(true, Some(player.gameprofile.id));
   633	                    world.send_entity_status(entity, EntityStatus::TamingSucceeded, None);
   634	                } else {
   635	                    world.send_entity_status(entity, EntityStatus::TamingFailed, None);
   636	                }
   637	                world.play_sound(
   638	                    self.get_eat_sound(),
   639	                    SoundCategory::Neutral,
   640	                    &entity.pos.load(),
   641	                );
   642	                return true;
   643	            }
   644	
   645	            if self.is_tame() && !player.get_entity().is_sneaking() {
   646	                if !self.is_saddled.load(Ordering::Relaxed) && item_stack.item == &Item::SADDLE {
   647	                    item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   648	                    self.is_saddled.store(true, Ordering::Relaxed);
   649	                    let world = entity.world.load();
   650	                    // `AbstractNautilus.getEquipSound` (AbstractNautilus.java:475-482): the
   651	                    // saddle sounds are shared with the living nautilus, not zombie-specific.
   652	                    world.play_sound(
   653	                        if self.is_underwater() {
   654	                            Sound::ItemNautilusSaddleUnderwaterEquip
   655	                        } else {
   656	                            Sound::ItemNautilusSaddleEquip
   657	                        },
   658	                        SoundCategory::Neutral,
   659	                        &entity.pos.load(),
   660	                    );
   661	                    return true;
   662	                }
   663	
   664	                if player.get_entity().can_start_riding().await {
   665	                    let world = player.world();
   666	                    if let Some(vehicle) = world.get_entity_by_id(entity.entity_id)
   667	                        && let Some(passenger) = world.get_player_by_id(player.entity_id())
   668	                    {
   669	                        entity
   670	                            .add_passenger(vehicle, passenger as Arc<dyn EntityBase>)
   671	                            .await;
   672	                    }
   673	                }
   674	                return true;
   675	            }
   676	
   677	            self.animal_interact(player, item_stack, self.ambient_sound())
   678	                .await
   679	        })
   680	    }
   681	
   682	    fn is_saddled(&self) -> bool {
   683	        self.is_saddled.load(Ordering::Relaxed)
   684	    }
   685	
   686	    /// `AbstractNautilus.canUseSlot` (AbstractNautilus.java:154-157): the SADDLE and BODY
   687	    /// slots need a live, non-baby, tamed nautilus. The baby term is always false here.
   688	    fn can_be_saddled(&self) -> bool {
   689	        self.mob_entity.living_entity.entity.is_alive() && self.is_tame()
   690	    }
   690	    }
   691	
   692	    fn set_saddled(&self, saddled: bool) {
   693	        self.is_saddled.store(saddled, Ordering::Relaxed);
   694	    }
   695	}

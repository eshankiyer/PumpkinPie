    37	impl ResultValueTaker {
    38	    /// Merges two takers, returning one.
    39	    #[must_use]
    40	    pub fn merge(taker_1: &Self, taker_2: &Self) -> Self {
    41	        let mut takers = Vec::with_capacity(taker_1.0.len() + taker_2.0.len());
    42	        for taker in &taker_1.0 {
    43	            takers.push(taker.clone());
    44	        }
    45	        for taker in &taker_2.0 {
    46	            takers.push(taker.clone());
    47	        }
    48	        Self(takers)
    49	    }

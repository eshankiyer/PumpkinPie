   129	   @Override
   130	   protected void updateTrades(final ServerLevel level) {
   131	      MerchantOffers offers = this.getOffers();
   132	      this.addOffersFromTradeSet(level, offers, TradeSets.WANDERING_TRADER_BUYING);
   133	      this.addOffersFromTradeSet(level, offers, TradeSets.WANDERING_TRADER_UNCOMMON);
   134	      this.addOffersFromTradeSet(level, offers, TradeSets.WANDERING_TRADER_COMMON);
   135	   }

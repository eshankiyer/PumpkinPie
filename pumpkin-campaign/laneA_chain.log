    12	/// `LightBlock.MAX_LEVEL` (`net/minecraft/world/level/block/LightBlock.java:33`).
    13	const MAX_LEVEL: u8 = 15;
    14	
    15	/// `LightBlock` (`net/minecraft/world/level/block/LightBlock.java:31`).
    16	///
    17	/// The only server-side behaviour is the right-click that cycles `LEVEL`
    18	/// (LightBlock.java:53-63). Everything else on the class is client-side or data-driven here:
    19	/// `getShape`/`getRenderShape`/`getShadeBrightness` are rendering, `LIGHT_EMISSION` is the
    20	/// generated per-state luminance, and `propagatesSkylightDown`/`getFluidState` follow from the
    21	/// `WATERLOGGED` property.
    22	#[pumpkin_block("minecraft:light")]
    23	pub struct LightBlock;
    24	
    25	/// `BlockState#cycle(LEVEL)` over `BlockStateProperties.LEVEL` (0..=15): increment, wrapping
    26	/// past the maximum back to the minimum.
    27	const fn cycle_level(level: u8) -> u8 {
    28	    if level >= MAX_LEVEL { 0 } else { level + 1 }
    29	}
    30	
    31	impl BlockBehaviour for LightBlock {
    32	    /// `LightBlock#useWithoutItem` (LightBlock.java:53-63).
    33	    ///
    34	    /// Vanilla gates on `Player#canUseGameMasterBlocks`
    35	    /// (`net/minecraft/world/entity/player/Player.java:1863-1865`), which is creative mode plus
    36	    /// the game-master permission; this codebase spells that as creative plus permission level
    37	    /// two, the same pairing `jigsaw.rs` uses. A player who fails the gate gets `CONSUME`, not
    38	    /// `PASS`, so the click is swallowed rather than falling through to a block placement.
    39	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
    40	        Box::pin(async move {
    41	            // `LightBlock.useWithoutItem` requires `Player.canUseGameMasterBlocks`
    42	            // (`LightBlock.java:53-63`; `Player.java:1863-1865`).
    43	            if !args.player.can_use_game_master_blocks() {
    44	                return BlockActionResult::Consume;
    45	            }
    46	
    47	            let state_id = args.world.get_block_state_id(args.position);
    48	            let mut props = LightLikeProperties::from_state_id(state_id, args.block);
    49	            props.level = cycle_level(props.level);
    50	
    51	            // Vanilla passes flag 2 (`NOTIFY_LISTENERS` only): no neighbour updates.
    52	            args.world
    53	                .set_block_state(
    54	                    args.position,
    55	                    props.to_state_id(args.block),
    56	                    BlockFlags::NOTIFY_LISTENERS,
    57	                )
    58	                .await;
    59	            BlockActionResult::SuccessServer
    60	        })
    61	    }
    62	
    63	    /// `LightBlock.getCloneItemStack`/`setLightOnStack` (LightBlock.java:108-115): creative
    64	    /// pick-block preserves the block's current light level on the returned item.
    65	    fn get_clone_item_stack(&self, args: GetCloneItemStackArgs<'_>) -> Option<ItemStack> {
    66	        let state = args.world.get_block_state(args.position);
    67	        let props = LightLikeProperties::from_state_id(state.id, args.block);
    68	        let mut stack = ItemStack::new(1, Item::from_id(args.block.item_id)?);
    69	        stack.patch.push((
    70	            DataComponent::BlockState,
    71	            Some(Box::new(BlockStateImpl {
    72	                properties: std::borrow::Cow::Owned(vec![(
    73	                    std::borrow::Cow::Borrowed("level"),
    74	                    std::borrow::Cow::Owned(props.level.to_string()),
    75	                )]),
    76	            })),
    77	        ));
    78	        Some(stack)
    79	    }
    80	}

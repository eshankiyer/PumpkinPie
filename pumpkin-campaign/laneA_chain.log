   146	/// (`MacroFunction.java:61-65`).
   147	fn instantiation_failure(fn_id: &str, error: InstantiationError) -> ExecuteFunctionError {
   148	    let reason = match error {
   149	        InstantiationError::MissingArguments => TextComponent::translate_cross(
   150	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENTS,
   151	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENTS,
   152	            [TextComponent::text(fn_id.to_string())],
   153	        ),
   154	        InstantiationError::MissingArgument(parameter) => TextComponent::translate_cross(
   155	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   156	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   157	            [
   158	                TextComponent::text(fn_id.to_string()),
   159	                TextComponent::text(parameter),
   160	            ],
   161	        ),
   162	    };
   163	    ExecuteFunctionError::InstantiationFailure {
   164	        function_id: fn_id.to_string(),
   165	        reason,
   166	    }
   167	}

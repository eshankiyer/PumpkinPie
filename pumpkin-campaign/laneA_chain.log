    29	public class BrushItem extends Item {
    30	   public static final int ANIMATION_DURATION = 10;
    31	   private static final int USE_DURATION = 200;
    32	
    33	   public BrushItem(final Item.Properties properties) {
    34	      super(properties);
    35	   }
    36	
    37	   @Override
    38	   public InteractionResult useOn(final UseOnContext context) {
    39	      Player player = context.getPlayer();
    40	      if (player != null && this.calculateHitResult(player).getType() == HitResult.Type.BLOCK) {
    41	         player.startUsingItem(context.getHand());
    42	      }
    43	
    44	      return InteractionResult.CONSUME;
    45	   }
    46	
    47	   @Override
    48	   public ItemUseAnimation getUseAnimation(final ItemStack itemStack) {
    49	      return ItemUseAnimation.BRUSH;
    50	   }
    51	
    52	   @Override
    53	   public int getUseDuration(final ItemStack itemStack, final LivingEntity user) {
    54	      return 200;
    55	   }
    56	
    57	   @Override
    58	   public void onUseTick(final Level level, final LivingEntity livingEntity, final ItemStack itemStack, final int ticksRemaining) {
    59	      if (ticksRemaining >= 0 && livingEntity instanceof Player player) {
    60	         HitResult hitResult = this.calculateHitResult(player);
    61	         if (hitResult instanceof BlockHitResult blockHitResult && hitResult.getType() == HitResult.Type.BLOCK) {
    62	            int timeElapsed = this.getUseDuration(itemStack, livingEntity) - ticksRemaining + 1;
    63	            boolean isLastTickBeforeBackswing = timeElapsed % 10 == 5;
    64	            if (isLastTickBeforeBackswing) {
    65	               BlockPos pos = blockHitResult.getBlockPos();
    66	               BlockState state = level.getBlockState(pos);
    67	               HumanoidArm brushingArm = livingEntity.getUsedItemHand() == InteractionHand.MAIN_HAND ? player.getMainArm() : player.getMainArm().getOpposite();
    68	               if (state.shouldSpawnTerrainParticles() && state.getRenderShape() != RenderShape.INVISIBLE) {
    69	                  this.spawnDustParticles(level, blockHitResult, state, livingEntity.getViewVector(0.0F), brushingArm);
    70	               }
    71	
    72	               SoundEvent brushSound;
    73	               if (state.getBlock() instanceof BrushableBlock brushableBlock) {
    74	                  brushSound = brushableBlock.getBrushSound();
    75	               } else {
    76	                  brushSound = SoundEvents.BRUSH_GENERIC;
    77	               }
    78	
    79	               level.playSound(player, pos, brushSound, SoundSource.BLOCKS);
    80	               if (level instanceof ServerLevel serverLevel && level.getBlockEntity(pos) instanceof BrushableBlockEntity brushableBlockEntity) {
    81	                  boolean brushingUpdatedState = brushableBlockEntity.brush(level.getGameTime(), serverLevel, player, blockHitResult.getDirection(), itemStack);
    82	                  if (brushingUpdatedState) {
    83	                     EquipmentSlot equippedHand = itemStack.equals(player.getItemBySlot(EquipmentSlot.OFFHAND))
    84	                        ? EquipmentSlot.OFFHAND
    85	                        : EquipmentSlot.MAINHAND;
    86	                     itemStack.hurtAndBreak(1, player, equippedHand);
    87	                  }
    88	               }
    89	            }
    90	         } else {
    91	            livingEntity.releaseUsingItem();
    92	         }
    93	      } else {
    94	         livingEntity.releaseUsingItem();
    95	      }
    96	   }
    97	
    98	   private HitResult calculateHitResult(final Player player) {
    99	      return ProjectileUtil.getHitResultOnViewVector(player, EntitySelector.CAN_BE_PICKED, player.blockInteractionRange());
   100	   }
   101	
   102	   private void spawnDustParticles(
   103	      final Level level, final BlockHitResult hitResult, final BlockState state, final Vec3 viewVector, final HumanoidArm brushingArm
   104	   ) {
   105	      double deltaScale = 3.0;
   106	      int flip = brushingArm == HumanoidArm.RIGHT ? 1 : -1;
   107	      int particles = level.getRandom().nextInt(7, 12);
   108	      BlockParticleOption particle = new BlockParticleOption(ParticleTypes.BLOCK, state);
   109	      Direction hitDirection = hitResult.getDirection();
   110	      BrushItem.DustParticlesDelta dustParticlesDelta = BrushItem.DustParticlesDelta.fromDirection(viewVector, hitDirection);
   111	      Vec3 hitLocation = hitResult.getLocation();
   112	
   113	      for (int i = 0; i < particles; i++) {
   114	         level.addParticle(
   115	            particle,
   116	            hitLocation.x - (hitDirection == Direction.WEST ? 1.0E-6F : 0.0F),
   117	            hitLocation.y,
   118	            hitLocation.z - (hitDirection == Direction.NORTH ? 1.0E-6F : 0.0F),
   119	            dustParticlesDelta.xd() * flip * 3.0 * level.getRandom().nextDouble(),
   120	            0.0,
   121	            dustParticlesDelta.zd() * flip * 3.0 * level.getRandom().nextDouble()
   122	         );
   123	      }
   124	   }
   125	
   126	   private record DustParticlesDelta(double xd, double yd, double zd) {
   127	      private static final double ALONG_SIDE_DELTA = 1.0;
   128	      private static final double OUT_FROM_SIDE_DELTA = 0.1;
   129	
   130	      public static BrushItem.DustParticlesDelta fromDirection(final Vec3 viewVector, final Direction hitDirection) {
   131	         double yd = 0.0;
   132	
   133	         return switch (hitDirection) {
   134	            case DOWN, UP -> new BrushItem.DustParticlesDelta(viewVector.z(), 0.0, -viewVector.x());
   135	            case NORTH -> new BrushItem.DustParticlesDelta(1.0, 0.0, -0.1);
   136	            case SOUTH -> new BrushItem.DustParticlesDelta(-1.0, 0.0, 0.1);
   137	            case WEST -> new BrushItem.DustParticlesDelta(-0.1, 0.0, -1.0);
   138	            case EAST -> new BrushItem.DustParticlesDelta(0.1, 0.0, 1.0);
   139	         };
   140	      }
   141	   }
   142	}

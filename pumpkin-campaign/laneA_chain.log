   141	    fn use_on_entity<'a>(
   142	        &'a self,
   143	        _item: &'a mut ItemStack,
   144	        player: &'a Player,
   145	        entity: Arc<dyn EntityBase>,
   146	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   147	        Box::pin(async move {
   148	            let ent = entity.get_entity();
   149	            if ent.entity_type == &EntityType::ARMADILLO {
   150	                let world = player.world();
   151	                world.play_sound(
   152	                    Sound::EntityArmadilloBrush,
   153	                    SoundCategory::Neutral,
   154	                    &ent.pos.load(),
   155	                );
   156	
   157	                let item_entity = Arc::new(ItemEntity::new(
   158	                    Entity::new(world.clone(), ent.pos.load(), &EntityType::ITEM),
   159	                    ItemStack::new(1, &Item::ARMADILLO_SCUTE),
   160	                ));
   161	                world.spawn_entity(item_entity).await;
   162	
   163	                player.damage_held_item(16).await;
   164	            } else {
   165	                let world = player.world();
   166	                world.play_sound(
   167	                    Sound::ItemBrushBrushingGeneric,
   168	                    SoundCategory::Neutral,
   169	                    &ent.pos.load(),
   170	                );
   171	            }
   172	
   173	            let stack = player.inventory().held_item().await;
   174	            player
   175	                .living_entity
   176	                .set_active_hand(pumpkin_util::Hand::Right, stack, Self::USE_DURATION)
   177	                .await;
   178	        })
   179	    }

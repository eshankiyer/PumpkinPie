  1213	    pub(crate) async fn damage_main_hand_weapon_after_hit(&self) {
  1214	        let living = &self.living_entity;
  1215	        let slot = EquipmentSlot::MAIN_HAND;
  1216	        let mut equipment = living.entity_equipment.lock().await;
  1217	        let Some(stack) = equipment.equipment.get_mut(&slot) else {
  1218	            return;
  1219	        };
  1220	        let broken_item = stack.clone();
  1221	        let cost = mob_weapon_durability_cost(stack);
  1222	        let result = stack.damage_item(cost);
  1223	        if result == DamageResult::Untouched {
  1224	            return;
  1225	        }
  1226	        let updated_stack = stack.clone();
  1227	        drop(equipment);
  1228	
  1229	        if result == DamageResult::Broken {
  1230	            // Vanilla `ItemStack.hurtEnemy` reaches `onEquippedItemBroken` before the broken
  1231	            // weapon is sent to tracking clients (`LivingEntity.java:3845-3848`), which
  1232	            // broadcasts the break status and removes attribute modifiers; the client then plays
  1233	            // `breakItem`'s particles (`LivingEntity.java:1439-1448`) in response.
  1234	            living.on_equipped_item_broken(&broken_item, &slot).await;
  1235	            living.spawn_item_particles(&broken_item, 5);
  1236	        }
  1237	        living.send_equipment_changes(&[(slot, updated_stack)]);
  1238	    }

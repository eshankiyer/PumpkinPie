   114	impl ItemBehaviour for SpawnEggItem {
   115	    /// Vanilla `SpawnEggItem.use` (SpawnEggItem.java:100-131): right-clicking without hitting
   116	    /// a block raycasts with `ClipContext.Fluid.SOURCE_ONLY` and, if the hit block is a
   117	    /// `LiquidBlock`, spawns the mob inside the fluid itself (`tryMoveDown = false`).
   118	    /// Without this, water/lava mob eggs (cod, squid, dolphin, strider, ...) do nothing when
   119	    /// used on the surface of a fluid.
   120	    fn normal_use<'a>(
   121	        &'a self,
   122	        item: &'a Item,
   123	        player: &'a Player,
   124	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   125	        Box::pin(async move {
   126	            let Some(entity_type) = entity_from_egg(item.id) else {
   127	                return;
   128	            };
   129	            let world = player.world();
   130	            let (start_pos, end_pos) = self.get_start_and_end_pos(player);
   131	
   132	            // ClipContext.Fluid.SOURCE_ONLY: stop on any non-air block outline and on
   133	            // full fluid source blocks, but pass through flowing fluid.
   134	            let checker = async |pos: &BlockPos, world_inner: &Arc<World>| {
   135	                let state_id = world_inner.get_block_state_id(pos);
   136	                let block = Block::from_state_id(state_id);
   137	                if state_id == Block::AIR.default_state.id {
   138	                    return false;
   139	                }
   140	                if block.id == Block::WATER.id || block.id == Block::LAVA.id {
   141	                    return state_id == block.default_state.id;
   142	                }
   143	                true
   144	            };
   145	
   146	            let Some((pos, face)) = world.raycast(start_pos, end_pos, checker).await else {
   147	                return;
   148	            };
   149	
   150	            // SpawnEggItem.java:114: only a LiquidBlock is spawned into by `use`; anything
   151	            // else is left to `useOn`.
   152	            let hit_block = world.get_block(&pos);
   153	            if hit_block.id != Block::WATER.id && hit_block.id != Block::LAVA.id {
   154	                return;
   155	            }
   156	
   157	            let inventory = player.inventory();
   158	            let held = inventory.held_item().await;
   159	            let (mut stack, hand) = if !held.is_empty() && held.item.id == item.id {
   160	                (held, Hand::Right)
   161	            } else {
   162	                let off_hand = inventory.off_hand_item().await;
   163	                if !off_hand.is_empty() && off_hand.item.id == item.id {
   164	                    (off_hand, Hand::Left)
   165	                } else {
   166	                    return;
   167	                }
   168	            };
   169	
   170	            // `SpawnEggItem.use` gates liquid spawning with `Player.mayUseItemAt`
   171	            // (`SpawnEggItem.java:112-119`).
   172	            if !player.may_use_item_at(&pos, face, &stack).await {
   173	                return;
   174	            }
   175	
   176	            let spawn_pos = Vector3::new(
   177	                f64::from(pos.0.x) + 0.5,
   178	                f64::from(pos.0.y),
   179	                f64::from(pos.0.z) + 0.5,
   180	            );
   181	            spawn_egg_mob(entity_type, &stack, &world, spawn_pos, player).await;
   182	            // `SpawnEggItem.use` awards ITEM_USED after a successful liquid spawn
   183	            // (`SpawnEggItem.java:118-122`).
   184	            player
   185	                .increment_stat(
   186	                    pumpkin_data::statistic::StatisticCategory::Used,
   187	                    item.id as i32,
   188	                    1,
   189	                )
   190	                .await;
   191	            stack.decrement_unless_creative(player.gamemode.load(), 1);
   192	            inventory.set_stack_in_hand(hand, stack).await;
   193	        })
   194	    }

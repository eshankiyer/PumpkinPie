    95	        let world = player.world();
    96	        let block = world.get_block(&packet.location);
    97	        if block.id == Block::STRUCTURE_BLOCK.id {
    98	            let state_id = world.get_block_state_id(&packet.location);
    99	            let mut properties = StructureBlockLikeProperties::from_state_id(state_id, block);
   100	            properties.r#mode = state_mode;
   101	            let new_state_id = properties.to_state_id(block);
   102	            if new_state_id != state_id {
   103	                world
   104	                    .set_block_state(
   105	                        &packet.location,
   106	                        new_state_id,
   107	                        BlockFlags::SKIP_BLOCK_ADDED_CALLBACK,
   108	                    )
   109	                    .await;
   110	            }
   111	        }
   112	
   113	        if structure_block.has_structure_name().await {
   114	            let structure_name = structure_block.get_structure_name().await;
   115	            match packet.action.0 {
   116	                SSetStructureBlock::ACTION_SAVE_AREA => {
   117	                    structure_block.save_structure(&world, true).await;
   118	                }
   119	                SSetStructureBlock::ACTION_LOAD_AREA => {
   120	                    if structure_block.is_structure_loadable().await {
   121	                        structure_block.place_structure_if_same_size(&world).await;
   122	                    }
   123	                }
   124	                SSetStructureBlock::ACTION_SCAN_AREA => {
   125	                    structure_block.detect_size(&world).await;
   126	                }
   127	                _ => {}
   128	            }
   129	            debug!(
   130	                "Player {} set structure block at {:?}, name: {}, mode: {}",
   131	                player.gameprofile.name, packet.location, structure_name, packet.mode.0
   132	            );
   133	        }
   134	
   135	        // Vanilla marks the block entity dirty and sends its update after all packet fields and
   136	        // the selected action are applied (`ServerGamePacketListenerImpl.java:872-873`).
   137	        player.world().update_block_entity(&block_entity);

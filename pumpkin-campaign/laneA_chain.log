   105	            wander_target: AtomicCell::new(None),
   106	            trading_player: std::sync::Mutex::new(None),
   107	            self_weak: std::sync::Mutex::new(None),
   108	        };
   109	        let mob_arc = Arc::new(trader);
   110	        *mob_arc.self_weak.lock().unwrap() = Some(Arc::downgrade(&mob_arc));
   111	        let mob_weak: Weak<dyn Mob> = {
   112	            let mob_arc: Arc<dyn Mob> = mob_arc.clone();
   113	            Arc::downgrade(&mob_arc)
   114	        };
   115	
   116	        {
   117	            let mut goal_selector = mob_arc
   118	                .mob_entity
   119	                .goals_selector
   120	                .lock()

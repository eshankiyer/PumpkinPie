   164	    fn pick_random_spawn_data(&self) -> Option<(&'static EntityType, NbtCompound)> {
   165	        let total_weight: i32 = self.spawn_potentials.iter().map(|(_, w, _)| *w).sum();
   166	        if total_weight <= 0 {
   167	            return self
   168	                .spawn_potentials
   169	                .first()
   170	                .map(|(entity, _, data)| (*entity, data.clone()));
   171	        }
   172	        let mut roll = rand::random_range(0..total_weight);
   173	        for (entity, weight, data) in &self.spawn_potentials {
   174	            if roll < *weight {
   175	                return Some((*entity, data.clone()));
   176	            }
   177	            roll -= weight;
   178	        }
   179	        None
   180	    }

   230	/// Screen handler for a crafter block (`CrafterMenu.java`).
   231	pub struct CrafterScreenHandler {
   232	    /// The crafter's nine input slots.
   233	    pub inventory: Arc<dyn Inventory>,
   234	    /// One-slot inventory backing the recipe preview (`ResultContainer`,
   235	    /// `CrafterMenu.java:18`).
   236	    pub result_inventory: Arc<dyn Inventory>,
   237	    /// Nine disabled flags plus `powered` (`CrafterMenu.java:26`).
   238	    pub properties: Arc<dyn PropertyDelegate>,
   239	    behaviour: ScreenHandlerBehaviour,
   240	}
   241	
   242	impl CrafterScreenHandler {
   243	    /// Creates a crafter screen handler (`CrafterMenu.java:31-54`).
   244	    ///
   245	    /// Slot order is the vanilla one: nine `CrafterSlot`s, the 36 standard
   246	    /// player slots, then the non-interactive result slot at index 45.
   247	    pub async fn new(
   248	        sync_id: u8,
   249	        player_inventory: &Arc<PlayerInventory>,
   250	        inventory: Arc<dyn Inventory>,
   251	        result_inventory: Arc<dyn Inventory>,
   252	        properties: Arc<dyn PropertyDelegate>,
   253	    ) -> Self {
   254	        let mut handler = Self {
   255	            inventory: inventory.clone(),
   256	            result_inventory: result_inventory.clone(),
   257	            properties: properties.clone(),
   258	            behaviour: ScreenHandlerBehaviour::new(sync_id, Some(WindowType::Crafter3x3)),
   259	        };
   260	
   261	        inventory.on_open().await;
   262	
   263	        for index in 0..CRAFTER_SLOT_COUNT {
   264	            handler.add_slot(Arc::new(CrafterSlot::new(
   265	                inventory.clone(),
   266	                index,
   267	                properties.clone(),
   268	            )));
   269	        }
   270	
   271	        let player_inv: Arc<dyn Inventory> = player_inventory.clone();
   272	        handler.add_player_slots(&player_inv);
   273	
   274	        handler.add_slot(Arc::new(NonInteractiveResultSlot::new(result_inventory, 0)));
   275	
   276	        // `CrafterMenu.java:52`: addDataSlots(this.containerData).
   277	        for index in 0..CRAFTER_PROPERTY_COUNT {
   278	            handler.add_property(ScreenProperty::new(properties.clone(), index as u8));
   279	        }
   280	
   281	        // `CrafterMenu.java:53`: this.refreshRecipeResult().
   282	        handler.refresh_recipe_result().await;
   283	
   284	        handler
   285	    }
   286	
   287	    /// `CrafterMenu.refreshRecipeResult` (`CrafterMenu.java:106-113`), called from
   288	    /// `slotChanged` (`CrafterMenu.java:119-122`) whenever an input slot changes. Populates the
   289	    /// non-interactive recipe-preview slot; it does not affect actual crafting, which
   290	    /// `CrafterBlockEntity`'s redstone-triggered tick already resolves independently via the
   291	    /// same [`match_crafting_recipe`].
   292	    async fn refresh_recipe_result(&self) {
   293	        let input = CrafterRecipeInput(self.inventory.clone());
   294	        let result = match_crafting_recipe(&input, None).await.map_or_else(
   295	            || ItemStack::EMPTY.clone(),
   296	            |matched| matched.to_item_stack(),
   297	        );
   298	        self.result_inventory.set_stack(0, result).await;
   299	    }
   300	
   301	    /// `CrafterMenu.java:62-64`.
   302	    #[must_use]
   303	    pub fn is_slot_disabled(&self, slot_id: i32) -> bool {
   304	        slot_id > -1
   305	            && slot_id < CRAFTER_SLOT_COUNT as i32
   306	            && self.properties.get_property(slot_id) == 1
   307	    }
   308	
   309	    /// `CrafterMenu.java:56-60`. Vanilla stores 0 for enabled and 1 for
   310	    /// disabled, then broadcasts the change.
   311	    pub fn set_slot_state(&self, slot_id: i32, enabled: bool) {
   312	        if slot_id > -1 && slot_id < CRAFTER_SLOT_COUNT as i32 {
   313	            self.properties.set_property(slot_id, i32::from(!enabled));
   314	        }
   315	    }
   316	
   317	    /// `CrafterMenu.java:66-68`.
   318	    #[must_use]
   319	    pub fn is_powered(&self) -> bool {
   320	        self.properties.get_property(POWERED_PROPERTY_INDEX) == 1
   321	    }
   322	}

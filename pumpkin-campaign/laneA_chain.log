    44	            SSetStructureBlock::MODE_SAVE => StructureblockMode::Save,
    45	            SSetStructureBlock::MODE_LOAD => StructureblockMode::Load,
    46	            SSetStructureBlock::MODE_CORNER => StructureblockMode::Corner,
    47	            SSetStructureBlock::MODE_DATA => StructureblockMode::Data,
    48	            _ => return,
    49	        };
    50	        let mirror = match packet.mirror.0 {
    51	            0 => "NONE",
    52	            1 => "LEFT_RIGHT",
    53	            2 => "FRONT_BACK",
    54	            _ => return,
    55	        };
    56	        let rotation = match packet.rotation.0 {
    57	            0 => "NONE",
    58	            1 => "CLOCKWISE_90",
    59	            2 => "CLOCKWISE_180",
    60	            3 => "COUNTERCLOCKWISE_90",
    61	            _ => return,
    62	        };
    63	
    64	        *structure_block.mode.lock().await = mode.to_string();
    65	        structure_block.set_structure_name(packet.name).await;
    66	        structure_block
    67	            .set_structure_pos(BlockPos::new(
    68	                i32::from(packet.offset_x).clamp(-48, 48),
    69	                i32::from(packet.offset_y).clamp(-48, 48),
    70	                i32::from(packet.offset_z).clamp(-48, 48),
    71	            ))
    72	            .await;
    73	        structure_block
    74	            .set_structure_size(Vector3::new(
    75	                i32::from(packet.size_x).min(48),
    76	                i32::from(packet.size_y).min(48),
    77	                i32::from(packet.size_z).min(48),
    78	            ))
    79	            .await;
    80	        *structure_block.mirror.lock().await = mirror.to_string();
    81	        *structure_block.rotation.lock().await = rotation.to_string();

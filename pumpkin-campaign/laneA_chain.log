   122	
   123	            // `WanderingTrader.registerGoals` (`WanderingTrader.java:60-94`).
   124	            goal_selector.add_goal(0, Box::new(SwimGoal::default()));
   125	            goal_selector.add_goal(1, Box::new(TradeWithPlayerGoal::new(0.5)));
   126	            // `WanderingTrader.java:89`: `addGoal(1, new LookAtTradingPlayerGoal(this))`.
   127	            goal_selector.add_goal(

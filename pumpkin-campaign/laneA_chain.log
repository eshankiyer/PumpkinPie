   101	    /// Creates an ingredient matching a specific item ID.
   102	    ///
   103	    /// If no namespace is provided (e.g., `"diamond"`), `"minecraft:"` is prepended.
   104	    #[must_use]
   105	    pub fn item(id: impl AsRef<str>) -> Self {
   106	        let s = id.as_ref();
   107	        let normalized = if s.contains(':') {
   108	            s.to_string()
   109	        } else {
   110	            format!("minecraft:{s}")
   111	        };
   112	        Self::Item(normalized)
   113	    }
   114	
   115	    /// Creates an ingredient matching a tag group of items.

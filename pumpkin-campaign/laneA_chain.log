  3967	    /// `ServerPlayer.onUpdateAbilities` sends the ability packet and refreshes spectator
  3968	    /// invisibility (`Player.java:1646`; `ServerPlayer.java:1740-1745`).
  3969	    pub async fn on_update_abilities(&self) {
  3970	        self.send_abilities_update().await;

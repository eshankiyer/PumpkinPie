   131	                )),
   132	            );
   133	            for (flee_type, flee_distance) in AVOIDED {
   134	                goal_selector.add_goal(
   135	                    1,
   136	                    Box::new(AvoidEntityGoal::new(flee_type, *flee_distance, 0.5, 0.5)),

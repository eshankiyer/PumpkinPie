   153	   private static <T extends ExecutionCommandSource<T>> void queueFunctionsAsReturn(
   154	      final Collection<CommandFunction<T>> functions,
   155	      final @Nullable CompoundTag arguments,
   156	      final T originalSource,
   157	      final T functionSource,
   158	      final ExecutionControl<T> output,
   159	      final FunctionCommand.Callbacks<T> callbacks
   160	   ) throws CommandSyntaxException {
   161	      CommandDispatcher<T> dispatcher = originalSource.dispatcher();
   162	      T noCallbackSource = functionSource.clearCallbacks();
   163	      CommandResultCallback functionCommandOutputCallback = CommandResultCallback.chain(originalSource.callback(), output.currentFrame().returnValueConsumer());
   164	
   165	      for (CommandFunction<T> function : functions) {
   166	         Identifier id = function.id();
   167	         CommandResultCallback functionResultCollector = decorateOutputIfNeeded(originalSource, callbacks, id, functionCommandOutputCallback);
   168	         instantiateAndQueueFunctions(arguments, output, dispatcher, noCallbackSource, function, id, functionResultCollector, true);
   169	      }
   170	
   171	      output.queueNext(FallthroughTask.instance());
   172	   }
   173	
   174	   private static <T extends ExecutionCommandSource<T>> void queueFunctionsNoReturn(
   175	      final Collection<CommandFunction<T>> functions,
   176	      final @Nullable CompoundTag arguments,
   177	      final T originalSource,
   178	      final T functionSource,
   179	      final ExecutionControl<T> output,
   180	      final FunctionCommand.Callbacks<T> callbacks
   181	   ) throws CommandSyntaxException {
   182	      CommandDispatcher<T> dispatcher = originalSource.dispatcher();
   183	      T noCallbackSource = functionSource.clearCallbacks();
   184	      CommandResultCallback originalCallback = originalSource.callback();
   185	      if (!functions.isEmpty()) {
   186	         if (functions.size() == 1) {
   187	            CommandFunction<T> function = functions.iterator().next();
   188	            Identifier id = function.id();
   189	            CommandResultCallback functionResultCollector = decorateOutputIfNeeded(originalSource, callbacks, id, originalCallback);
   190	            instantiateAndQueueFunctions(arguments, output, dispatcher, noCallbackSource, function, id, functionResultCollector, false);
   191	         } else if (originalCallback == CommandResultCallback.EMPTY) {
   192	            for (CommandFunction<T> function : functions) {
   193	               Identifier id = function.id();
   194	               CommandResultCallback functionResultCollector = decorateOutputIfNeeded(originalSource, callbacks, id, originalCallback);
   195	               instantiateAndQueueFunctions(arguments, output, dispatcher, noCallbackSource, function, id, functionResultCollector, false);
   196	            }
   197	         } else {
   198	            class Accumulator {
   199	               private boolean anyResult;
   200	               private int sum;
   201	
   202	               public void add(final int result) {
   203	                  this.anyResult = true;
   204	                  this.sum += result;
   205	               }
   206	            }
   207	
   208	            Accumulator accumulator = new Accumulator();
   209	            CommandResultCallback partialResultCallback = (success, result) -> accumulator.add(result);
   210	
   211	            for (CommandFunction<T> function : functions) {
   212	               Identifier id = function.id();
   213	               CommandResultCallback functionResultCollector = decorateOutputIfNeeded(originalSource, callbacks, id, partialResultCallback);
   214	               instantiateAndQueueFunctions(arguments, output, dispatcher, noCallbackSource, function, id, functionResultCollector, false);
   215	            }
   216	
   217	            output.queueNext((context, frame) -> {
   218	               if (accumulator.anyResult) {
   219	                  originalCallback.onSuccess(accumulator.sum);
   220	               }
   221	            });
   222	         }
   223	      }
   224	   }

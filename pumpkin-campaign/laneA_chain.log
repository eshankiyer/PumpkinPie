    92	    pub(super) fn get_leaf_litter_positions<'a>(
    93	        root_positions: &'a [BlockPos],
    94	        log_positions: &'a [BlockPos],
    95	    ) -> Cow<'a, [BlockPos]> {
    96	        if root_positions.is_empty() {
    97	            return Cow::Borrowed(log_positions);
    98	        }
    99	
   100	        if log_positions
   101	            .first()
   102	            .is_some_and(|log| root_positions[0].0.y == log.0.y)
   103	        {
   104	            let mut list = Vec::with_capacity(root_positions.len() + log_positions.len());
   105	            list.extend_from_slice(log_positions);
   106	            list.extend_from_slice(root_positions);
   107	            return Cow::Owned(list);
   108	        }
   109	
   110	        Cow::Borrowed(root_positions)
   111	    }

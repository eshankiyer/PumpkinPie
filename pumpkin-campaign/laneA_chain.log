   101	    fn instantiate_lines(
   102	        &self,
   103	        fn_id: &str,
   104	        function: &LoadedFunction,
   105	        arguments: Option<&NbtCompound>,
   106	    ) -> Result<Vec<String>, ExecuteFunctionError> {

  4000	    pub async fn increment_stat(
  4001	        &self,
  4002	        category: statistics::StatisticCategory,
  4003	        stat: i32,
  4004	        amount: i32,
  4005	    ) {
  4006	        self.stats.lock().await.increment(category, stat, amount);
  4007	        // Recipe-book unlock triggers. Vanilla drives these from the generated
  4008	        // `recipes/...` advancements, whose criteria are an `inventory_changed`
  4009	        // `has_item` on the recipe's ingredients plus a `recipe_unlocked`, with
  4010	        // `AdvancementRewards.grant` calling `awardRecipesByKey`
  4011	        // (`AdvancementRewards.java:77-79`). Pumpkin has no advancement criteria
  4012	        // engine, so the same two obtain-an-item paths are hooked off the statistic
  4013	        // vanilla increments at that moment.
  4014	        if amount > 0 {
  4015	            match category {
  4016	                statistics::StatisticCategory::PickedUp => {
  4017	                    self.unlock_recipes_using_item(stat).await;
  4018	                }
  4019	                statistics::StatisticCategory::Crafted => {
  4020	                    // `RecipeCraftingHolder.awardUsedRecipes` awards the recipe that
  4021	                    // was just used (`RecipeCraftingHolder.java:17-23`); the crafted
  4022	                    // item is all this hook knows, so every recipe producing it is
  4023	                    // awarded.
  4024	                    self.award_recipes_producing_item(stat).await;
  4025	                    self.unlock_recipes_using_item(stat).await;
  4026	                }
  4027	                _ => {}
  4028	            }
  4029	        }
  4030	    }
  4031	
  4032	    /// `ServerPlayer.awardRecipes` (`ServerPlayer.java:1524-1526`), delegating to
  4033	    /// `ServerRecipeBook.addRecipes` (`ServerRecipeBook.java:61-80`).
  4034	    ///
  4035	    /// Returns the number of recipes newly unlocked.
  4036	    ///
  4037	    /// Vanilla also sends a `ClientboundRecipeBookAddPacket` naming exactly the new
  4038	    /// recipes, with `replace = false` and each entry flagged notification+highlight
  4039	    /// (`ServerRecipeBook.java:70-77`); [`CRecipeBookAddSubset`] carries that.
  4040	    ///

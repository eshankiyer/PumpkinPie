   138	            }
   139	            goal_selector.add_goal(1, EscapeDangerGoal::new(0.5));
   140	            goal_selector.add_goal(2, Box::new(WanderToPositionGoal::new(2.0, 0.35)));
   141	            goal_selector.add_goal(4, MoveTowardsRestrictionGoal::new(0.35));

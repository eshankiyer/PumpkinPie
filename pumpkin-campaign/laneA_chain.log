   180	    /// Vanilla `WanderingTrader::updateTrades` (`WanderingTrader.java:129-135`), via the
   181	    /// shared `AbstractVillager.addOffersFromTradeSet` helper: pulls buying, then uncommon,
   182	    /// then common trade sets, in that fixed order.
   183	    pub async fn update_trades(&self) {
   184	        use pumpkin_data::villager::{
   185	            WANDERING_TRADER_TRADE_SET_BUYING, WANDERING_TRADER_TRADE_SET_COMMON,
   186	            WANDERING_TRADER_TRADE_SET_UNCOMMON,
   187	        };
   188	        use pumpkin_protocol::codec::item_stack_seralizer::ItemStackSerializer;
   189	        use rand::seq::IndexedRandom;
   190	        use std::borrow::Cow;
   191	
   192	        let mut offers = self.offers.lock().await;
   193	        let mut rng = rand::rng();
   194	
   195	        for trade_set in [
   196	            WANDERING_TRADER_TRADE_SET_BUYING,
   197	            WANDERING_TRADER_TRADE_SET_UNCOMMON,
   198	            WANDERING_TRADER_TRADE_SET_COMMON,
   199	        ] {
   200	            let chosen_trades = trade_set.trades.sample(&mut rng, trade_set.amount as usize);
   201	            for trade in chosen_trades {
   202	                offers.push(pumpkin_protocol::java::client::play::MerchantOffer {
   203	                    base_cost_a: ItemStackSerializer(Cow::Owned(
   204	                        pumpkin_data::item_stack::ItemStack::new(
   205	                            trade.wants.count as u8,
   206	                            trade.wants.item,
   207	                        ),
   208	                    )),
   209	                    output: ItemStackSerializer(Cow::Owned(
   210	                        pumpkin_data::item_stack::ItemStack::new(
   211	                            trade.gives.count as u8,
   212	                            trade.gives.item,
   213	                        ),
   214	                    )),
   215	                    cost_b: trade.wants_b.as_ref().map(|b| {
   216	                        ItemStackSerializer(Cow::Owned(pumpkin_data::item_stack::ItemStack::new(
   217	                            b.count as u8,
   218	                            b.item,
   219	                        )))
   220	                    }),
   221	                    reward_exp: true,
   222	                    uses: 0,
   223	                    max_uses: trade.max_uses,
   224	                    xp: trade.xp,
   225	                    special_price: 0,
   226	                    price_multiplier: trade.price_multiplier,
   227	                    demand: 0,
   228	                });
   229	            }
   230	        }
   231	    }

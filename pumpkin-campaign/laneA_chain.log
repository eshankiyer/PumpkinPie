    76	async fn spawn_egg_mob(
    77	    entity_type: &'static EntityType,
    78	    stack: &ItemStack,
    79	    world: &Arc<World>,
    80	    pos: Vector3<f64>,
    81	    player: &Player,
    82	) {
    83	    // Create rotation like Vanilla
    84	    let yaw = wrap_degrees(rand::random::<f32>() * 360.0) % 360.0;
    85	
    86	    let mob = from_type(entity_type, pos, world, Uuid::new_v4());
    87	
    88	    // Set the rotation
    89	    mob.get_entity().set_rotation(yaw, 0.0);
    90	
    91	    apply_entity_variant(stack, mob.as_ref());
    92	
    93	    // `SpawnEggItem.spawn` applies the stack's implicit entity components before adding the
    94	    // offspring (`SpawnEggItem.java:169-171`).
    95	    mob.get_entity()
    96	        .apply_components_from_item_stack(stack)
    97	        .await;
    98	
    99	    // Broadcast the new mob to all players
   100	    world.spawn_entity(mob).await;
   101	
   102	    // `SpawnEggItem.spawn` emits ENTITY_PLACE after a successful spawn (`SpawnEggItem.java:90-93`).
   103	    if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id) {
   104	        emit_game_event(
   105	            world,
   106	            pumpkin_data::game_event::GameEvent::EntityPlace,
   107	            pos,
   108	            GameEventContext::of_entity(player_arc),
   109	        )
   110	        .await;
   111	    }
   112	}

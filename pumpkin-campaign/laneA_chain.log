  3863	    /// Updates the current abilities the player has.
  3864	    pub async fn send_abilities_update(&self) {
  3865	        match self.client.as_ref() {
  3866	            ClientPlatform::Java(java) => {
  3867	                let mut b = 0;
  3868	                let abilities = &self.abilities.lock().await;
  3869	
  3870	                if abilities.invulnerable {
  3871	                    b |= 1;
  3872	                }
  3873	                if abilities.flying {
  3874	                    b |= 2;
  3875	                }
  3876	                if abilities.allow_flying {
  3877	                    b |= 4;
  3878	                }
  3879	                if abilities.creative {
  3880	                    b |= 8;
  3881	                }
  3882	                let packet = CPlayerAbilities::new(b, abilities.fly_speed, abilities.walk_speed);
  3883	                if let Ok(data) = java.serialize_packet(&packet) {
  3884	                    java.enqueue_packet(data).await;
  3885	                }
  3886	            }
  3887	            ClientPlatform::Bedrock(bedrock) => {
  3888	                let abilities = self.abilities.lock().await;
  3889	                let is_op = self.permission_lvl.load() == PermissionLvl::Four;
  3890	                let is_spectator = self.gamemode.load() == GameMode::Spectator;
  3891	
  3892	                // 1. Permission Mapping
  3893	                let player_perm = if is_op { 2 } else { 1 }; // 1: Member, 2: Operator
  3894	                let command_perm = u8::from(is_op); // 0: Normal, 1: Operator
  3895	
  3896	                // 2. Build the Ability Bitmask
  3897	                let mut ability_value: u32 = 0;
  3898	
  3899	                // Helper closure to set bits using your enum
  3900	                let mut set_ability = |ability: Ability, enabled: bool| {
  3901	                    if enabled {
  3902	                        ability_value |= 1 << (ability as u32);
  3903	                    }
  3904	                };
  3905	
  3906	                // Base Permissions
  3907	                set_ability(Ability::MayFly, abilities.allow_flying);
  3908	                set_ability(Ability::Flying, abilities.flying);
  3909	                set_ability(
  3910	                    Ability::Invulnerable,
  3911	                    abilities.invulnerable || abilities.creative,
  3912	                );
  3913	
  3914	                // Operator Specifics
  3915	                set_ability(Ability::OperatorCommands, is_op);
  3916	                set_ability(Ability::Teleport, is_op);
  3917	
  3918	                // Interaction Permissions (Disabled for Spectators)
  3919	                let can_interact = !is_spectator;
  3920	                set_ability(Ability::Build, can_interact);
  3921	                set_ability(Ability::Mine, can_interact);
  3922	                set_ability(Ability::DoorsAndSwitches, can_interact);
  3923	                set_ability(Ability::OpenContainers, can_interact);
  3924	                set_ability(Ability::AttackPlayers, can_interact);
  3925	                set_ability(Ability::AttackMobs, can_interact);
  3926	
  3927	                // Creative/Spectator Extras
  3928	                set_ability(Ability::Instabuild, abilities.creative);
  3929	                set_ability(Ability::NoClip, is_spectator);
  3930	
  3931	                // 3. Construct the Layers
  3932	                let mut layers = vec![AbilityLayer {
  3933	                    serialized_layer: 0, // LAYER_BASE
  3934	                    // 0x3FFFF defines the first 18 bits as "provided" by this packet
  3935	                    abilities_set: (1 << Ability::AbilityCount as u32) - 1,
  3936	                    ability_value,
  3937	                    fly_speed: 0.05,
  3938	                    vertical_fly_speed: 1.0,
  3939	                    walk_speed: 0.1,
  3940	                }];
  3941	
  3942	                if is_spectator {
  3943	                    layers.push(AbilityLayer {
  3944	                        serialized_layer: 1,
  3945	                        abilities_set: 1 << (Ability::Flying as u32),
  3946	                        ability_value: 1 << (Ability::Flying as u32),
  3947	                        fly_speed: 0.05,
  3948	                        vertical_fly_speed: 1.0,
  3949	                        walk_speed: 0.1,
  3950	                    });
  3951	                }
  3952	
  3953	                let packet = CUpdateAbilities {
  3954	                    target_player_raw_id: self.entity_id().into(),
  3955	                    player_permission: player_perm,
  3956	                    command_permission: command_perm,
  3957	                    layers,
  3958	                };
  3959	
  3960	                if let Ok(data) = bedrock.serialize_packet(&packet) {
  3961	                    bedrock.send_game_packet(data).await;
  3962	                }
  3963	            }
  3964	        }
  3965	    }

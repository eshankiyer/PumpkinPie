   246	         return wanderPosition != null && this.isTooFarAway(wanderPosition, this.stopDistance);
   247	      }
   248	
   249	      @Override
   250	      public void tick() {
   251	         BlockPos wanderPosition = this.trader.getWanderTarget();
   252	         if (wanderPosition != null && WanderingTrader.this.navigation.isDone()) {
   253	            if (this.isTooFarAway(wanderPosition, 10.0)) {
   254	               Vec3 dir = new Vec3(
   255	                     wanderPosition.getX() - this.trader.getX(), wanderPosition.getY() - this.trader.getY(), wanderPosition.getZ() - this.trader.getZ()
   256	                  )
   257	                  .normalize();
   258	               Vec3 targetPos = dir.scale(10.0).add(this.trader.getX(), this.trader.getY(), this.trader.getZ());
   259	               WanderingTrader.this.navigation.moveTo(targetPos.x, targetPos.y, targetPos.z, this.speedModifier);
   260	            } else {
   261	               WanderingTrader.this.navigation.moveTo(wanderPosition.getX(), wanderPosition.getY(), wanderPosition.getZ(), this.speedModifier);
   262	            }
   263	         }
   264	      }
   265	
   266	      private boolean isTooFarAway(final BlockPos pos, final double distance) {
   267	         return !pos.closerToCenterThan(this.trader.position(), distance);
   268	      }
   269	   }

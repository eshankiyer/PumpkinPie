   235	      public void runGuarded(
   236	         final CommandSourceStack sender,
   237	         final ContextChain<CommandSourceStack> currentStep,
   238	         final ChainModifiers modifiers,
   239	         final ExecutionControl<CommandSourceStack> output
   240	      ) throws CommandSyntaxException {
   241	         CommandContext<CommandSourceStack> currentContext = currentStep.getTopContext().copyFor(sender);
   242	         Pair<Identifier, Collection<CommandFunction<CommandSourceStack>>> nameAndFunctions = FunctionArgument.getFunctionCollection(currentContext, "name");
   243	         Collection<CommandFunction<CommandSourceStack>> functions = nameAndFunctions.getSecond();
   244	         if (functions.isEmpty()) {
   245	            throw FunctionCommand.ERROR_NO_FUNCTIONS.create(Component.translationArg(nameAndFunctions.getFirst()));
   246	         }
   247	
   248	         CompoundTag arguments = this.arguments(currentContext);
   249	         CommandSourceStack commonFunctionContext = FunctionCommand.modifySenderForExecution(sender);
   250	         if (functions.size() == 1) {
   251	            sender.sendSuccess(
   252	               () -> Component.translatable("commands.function.scheduled.single", Component.translationArg(functions.iterator().next().id())), true
   253	            );
   254	         } else {
   255	            sender.sendSuccess(
   256	               () -> Component.translatable(
   257	                  "commands.function.scheduled.multiple",
   258	                  ComponentUtils.formatList(functions.stream().map(CommandFunction::id).toList(), Component::translationArg)
   259	               ),
   260	               true
   261	            );
   262	         }

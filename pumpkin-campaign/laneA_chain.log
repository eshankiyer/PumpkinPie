    75	async fn spawn_egg_mob(
    76	    entity_type: &'static EntityType,
    77	    stack: &ItemStack,
    78	    world: &Arc<World>,
    79	    pos: Vector3<f64>,
    80	) {
    81	    // Create rotation like Vanilla
    82	    let yaw = wrap_degrees(rand::random::<f32>() * 360.0) % 360.0;
    83	
    84	    let mob = from_type(entity_type, pos, world, Uuid::new_v4());
    85	
    86	    // Set the rotation
    87	    mob.get_entity().set_rotation(yaw, 0.0);
    88	
    89	    apply_entity_variant(stack, mob.as_ref());
    90	
    91	    // `SpawnEggItem.spawn` applies the stack's implicit entity components before adding the
    92	    // offspring (`SpawnEggItem.java:169-171`).
    93	    mob.get_entity()
    94	        .apply_components_from_item_stack(stack)
    95	        .await;
    96	
    97	    // Broadcast the new mob to all players
    98	    world.spawn_entity(mob).await;
    99	}

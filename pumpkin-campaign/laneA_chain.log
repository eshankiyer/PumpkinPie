   110	        write.write_u8(self.size_y)?;
   111	        write.write_u8(self.size_z)?;
   112	        write.write_var_int(&self.mirror)?;
   113	        write.write_var_int(&self.rotation)?;
   114	        write.write_string(self.metadata)?;
   115	        write.write_f32_be(self.integrity)?;
   116	        write.write_var_long(&self.seed)?;
   117	        write.write_u8(self.flags)?;
   118	        Ok(())

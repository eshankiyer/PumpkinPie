   110	   public static <T extends ExecutionCommandSource<T>> void queueFunctions(
   111	      final Collection<CommandFunction<T>> functions,
   112	      final @Nullable CompoundTag arguments,
   113	      final T originalSource,
   114	      final T functionSource,
   115	      final ExecutionControl<T> output,

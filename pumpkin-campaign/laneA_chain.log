    30	impl ItemBehaviour for BrushItem {
    31	    /// `BrushItem.useOn` (`BrushItem.java:37-45`) only starts the use animation; all of
    32	    /// the work happens in `onUseTick`. Vanilla's `Item.use` is not overridden, so
    33	    /// right-clicking air does nothing.
    34	    fn use_on_block<'a>(
    35	        &'a self,
    36	        _item: &'a mut ItemStack,
    37	        player: &'a Player,
    38	        _location: BlockPos,
    39	        _face: BlockDirection,
    40	        _cursor_pos: Vector3<f32>,
    41	        _block: &'a Block,
    42	        _server: &'a Server,
    43	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    44	        Box::pin(async move {
    45	            let stack = player.inventory().held_item().await;
    46	            player
    47	                .living_entity
    48	                .set_active_hand(pumpkin_util::Hand::Right, stack, Self::USE_DURATION)
    49	                .await;
    50	        })
    51	    }
    52	
    53	    /// `BrushItem.onUseTick` (`BrushItem.java:57-96`): one brush stroke lands on every
    54	    /// tick where `elapsed % 10 == 5`, and the brush is damaged only when the stroke
    55	    /// finished the block off (`BrushItem.java:81-87`).
    56	    fn on_use_tick<'a>(
    57	        &'a self,
    58	        _stack: &'a ItemStack,
    59	        player: &'a Player,
    60	        remaining_use_ticks: i32,
    61	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    62	        Box::pin(async move {
    63	            if remaining_use_ticks < 0 {
    64	                player.living_entity.clear_active_hand().await;
    65	                return;
    66	            }
    67	
    68	            let world = player.world();
    69	            let (start, end) = self.get_start_and_end_pos(player);
    70	            let Some((position, face)) = world
    71	                .raycast(start, end, async |pos, w| !w.get_block_state(pos).is_air())
    72	                .await
    73	            else {
    74	                // `BrushItem.java:90-92`: losing the target stops the use.
    75	                player.living_entity.clear_active_hand().await;
    76	                return;
    77	            };
    78	
    79	            let elapsed = Self::USE_DURATION - remaining_use_ticks + 1;
    80	            if elapsed % 10 != 5 {
    81	                return;
    82	            }
    83	
    84	            let block = world.get_block(&position);
    85	            let state = world.get_block_state(&position);
    86	            // `BrushItem.onUseTick` emits dust only when the state allows terrain particles
    87	            // (`BrushItem.java:65-70`); the property comes from `noTerrainParticles`
    88	            // (`BlockBehaviour.java:1265-1267`).
    89	            if state.should_spawn_terrain_particles() {
    90	                let mut particle_data = Vec::new();
    91	                let _ = VarInt(i32::from(pumpkin_data::BlockState::to_be_network_id(
    92	                    state.id,
    93	                )))
    94	                .encode(&mut particle_data);
    95	                let look = player.living_entity.get_looking_vector();
    96	                let dust = match face {
    97	                    BlockDirection::Down | BlockDirection::Up => (look.z, -look.x),
    98	                    BlockDirection::North => (1.0, -0.1),
    99	                    BlockDirection::South => (-1.0, 0.1),
   100	                    BlockDirection::West => (-0.1, -1.0),
   101	                    BlockDirection::East => (0.1, 1.0),
   102	                };
   103	                let mut particle_position = position.to_centered_f64();
   104	                match face {
   105	                    BlockDirection::Down => particle_position.y -= 0.5,
   106	                    BlockDirection::Up => particle_position.y += 0.5,
   107	                    BlockDirection::North => particle_position.z -= 0.5,
   108	                    BlockDirection::South => particle_position.z += 0.5,
   109	                    BlockDirection::West => particle_position.x -= 0.5,
   110	                    BlockDirection::East => particle_position.x += 0.5,
   111	                }
   112	                world.spawn_particle_with_data(
   113	                    particle_position,
   114	                    Vector3::new((dust.0 * 3.0) as f32, 0.0, (dust.1 * 3.0) as f32),
   115	                    0.0,
   116	                    rand::random_range(7..12),
   117	                    pumpkin_data::particle::Particle::BlockCrumble,
   118	                    &particle_data,
   119	                );
   120	            }
   121	            world.play_sound(
   122	                brush_sound(block),
   123	                SoundCategory::Blocks,
   124	                &position.to_f64(),
   125	            );
   126	
   127	            let Some(be) = world.get_block_entity(&position) else {
   128	                return;
   129	            };
   130	            let Some(brush_be) = be.as_any().downcast_ref::<BrushableBlockBlockEntity>() else {
   131	                return;
   132	            };
   133	
   134	            let game_time = world.get_world_age().await;
   135	            if brush_be.brush(&world, game_time, face).await {
   136	                player.damage_held_item(1).await;
   137	            }
   138	        })
   139	    }

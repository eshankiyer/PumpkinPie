   233	    pub async fn open_trading_screen(&self, player: &Arc<Player>) {
   234	        if let Some(sync_id) = player.open_handled_screen(self, None).await {
   235	            let offers = self.offers.lock().await.clone();
   236	            player
   237	                .send_client_packet(&CMerchantOffers::new(
   238	                    VarInt(sync_id as i32),
   239	                    offers,
   240	                    // Vanilla `WanderingTrader.mobInteract` opens `openTradingScreen(player,
   241	                    // displayName, 1)` -- wandering traders have no level progression, so the
   242	                    // level is always fixed at 1.
   243	                    VarInt(1),
   244	                    VarInt(0),
   245	                    false,
   246	                    false,
   247	                ))
   248	                .await;
   249	        }
   250	    }
   251	}

   104	async fn send_success_feedback(context: &CommandContext<'_>, executed_count: usize, name: &str) {
   105	    if name.starts_with('#') {
   106	        context
   107	            .source
   108	            .send_feedback(
   109	                TextComponent::translate_cross(
   110	                    translation::java::COMMANDS_FUNCTION_SUCCESS_MULTIPLE,
   111	                    translation::java::COMMANDS_FUNCTION_SUCCESS_MULTIPLE,
   112	                    [
   113	                        TextComponent::text(executed_count.to_string()),
   114	                        TextComponent::text(name.to_string()),
   115	                    ],
   116	                ),
   117	                true,
   118	            )
   119	            .await;
   120	    } else {
   121	        context
   122	            .source
   123	            .send_feedback(
   124	                TextComponent::translate_cross(
   125	                    translation::java::COMMANDS_FUNCTION_SUCCESS_SINGLE,
   126	                    translation::java::COMMANDS_FUNCTION_SUCCESS_SINGLE,
   127	                    [
   128	                        TextComponent::text(executed_count.to_string()),
   129	                        TextComponent::text(name.to_string()),
   130	                    ],
   131	                ),
   132	                true,
   133	            )
   134	            .await;
   135	    }
   136	}
   137	
   138	/// Maps execution failures to their vanilla counterparts: unknown ids surface
   139	/// as `arguments.function.unknown` and macro instantiation failures as
   140	/// `commands.function.instantiationFailure` (`FunctionCommand.java:49-51`,
   141	/// raised at `:139-141`).
   142	fn map_error(error: ExecuteFunctionError, requested_name: &str) -> CommandSyntaxError {
   143	    match error {
   144	        ExecuteFunctionError::Unknown(_) => ERROR_UNKNOWN_FUNCTION
   145	            .create_without_context(TextComponent::text(requested_name.to_string())),
   146	        ExecuteFunctionError::InstantiationFailure {
   147	            function_id,
   148	            reason,
   149	        } => ERROR_INSTANTIATION_FAILURE
   150	            .create_without_context(TextComponent::text(function_id), reason),
   151	    }
   152	}
   153	
   154	pub fn register(dispatcher: &mut CommandDispatcher, registry: &PermissionRegistry) {
   155	    registry.register_permission_or_panic(Permission::new(
   156	        PERMISSION,
   157	        DESCRIPTION,
   158	        PermissionDefault::Op(PermissionLvl::Two),
   159	    ));
   160	
   161	    dispatcher.register(
   162	        command("function", DESCRIPTION).requires(PERMISSION).then(
   163	            argument("name", StringArgumentType::SingleWord)
   164	                .suggests(FunctionSuggestionProvider)
   165	                .executes(FunctionExecutor)
   166	                // `/function <name> <compound>` — vanilla registers the
   167	                // compound argument under the function-name argument
   168	                // (`FunctionCommand.java:88-92`).
   169	                .then(
   170	                    argument("arguments", NbtCompoundArgumentType)
   171	                        .executes(FunctionWithArgumentsExecutor),
   172	                ),
   173	        ),
   174	    );
   175	}

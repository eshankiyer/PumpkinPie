   240	        || name == "trapped_chest"
   241	        || name == "copper_chest"
   242	        || name.ends_with("_copper_chest")
   243	        || name == "chiseled_bookshelf"
   244	        || name == "command_block"
   245	        || name == "chain_command_block"

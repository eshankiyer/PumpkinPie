   270	/// Matches vanilla `BlockStateBase.isSuffocating` (`BlockBehaviour.java:801-803`) and the
   271	/// block-property overrides registered in `Blocks.java:421-422, 585-586, 637-638, 1299-1300,
   272	/// 2027-2028, 3702-3703, 5116-5117, 5257-5258, 5478-5479, 5699-5708, 5769-5794`.
   273	pub(crate) fn is_suffocating(block: &Block, state: &BlockState, shulker_closed: bool) -> bool {
   274	    match block.name {
   275	        "farmland" | "dirt_path" | "mud" | "soul_sand" | "end_gateway" => true,
   276	        "mangrove_roots" | "glass" | "moving_piston" | "repeater" | "tinted_glass"
   277	        | "firefly_bush" => false,
   278	        name if name.ends_with("_leaves")
   279	            || name.ends_with("_stained_glass")
   280	            || name.ends_with("copper_grate") =>
   281	        {
   282	            false
   283	        }
   284	        name if name == "shulker_box" || name.ends_with("_shulker_box") => shulker_closed,
   285	        "piston" | "sticky_piston" => !block.properties(state.id).is_some_and(|properties| {
   286	            properties
   287	                .to_props()
   288	                .iter()
   289	                .any(|(key, value)| *key == "extended" && *value == "true")
   290	        }),
   291	        _ => blocks_movement(state, block.id) && state.is_full_cube(),
   292	    }
   293	}

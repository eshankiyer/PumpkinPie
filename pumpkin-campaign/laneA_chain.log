    13	
    14	public record ClientboundChunksBiomesPacket(List<ClientboundChunksBiomesPacket.ChunkBiomeData> chunkBiomeData) implements Packet<ClientGamePacketListener> {
    15	   public static final StreamCodec<FriendlyByteBuf, ClientboundChunksBiomesPacket> STREAM_CODEC = Packet.codec(
    16	      ClientboundChunksBiomesPacket::write, ClientboundChunksBiomesPacket::new
    17	   );
    18	   private static final int TWO_MEGABYTES = 2097152;
    19	
    20	   private ClientboundChunksBiomesPacket(final FriendlyByteBuf input) {
    21	      this(input.readList(ClientboundChunksBiomesPacket.ChunkBiomeData::new));
    22	   }
    23	
    24	   public static ClientboundChunksBiomesPacket forChunks(final List<LevelChunk> chunks) {
    25	      return new ClientboundChunksBiomesPacket(chunks.stream().map(ClientboundChunksBiomesPacket.ChunkBiomeData::new).toList());
    26	   }
    27	
    28	   private void write(final FriendlyByteBuf output) {
    29	      output.writeCollection(this.chunkBiomeData, (o, c) -> c.write(o));
    30	   }
    31	
    32	   @Override
    33	   public PacketType<ClientboundChunksBiomesPacket> type() {
    34	      return GamePacketTypes.CLIENTBOUND_CHUNKS_BIOMES;
    35	   }
    36	
    37	   public void handle(final ClientGamePacketListener listener) {
    38	      listener.handleChunksBiomes(this);
    39	   }
    40	
    41	   public record ChunkBiomeData(ChunkPos pos, byte[] buffer) {
    42	      public ChunkBiomeData(final LevelChunk chunk) {
    43	         this(chunk.getPos(), new byte[calculateChunkSize(chunk)]);
    44	         extractChunkData(new FriendlyByteBuf(this.getWriteBuffer()), chunk);
    45	      }
    46	
    47	      public ChunkBiomeData(final FriendlyByteBuf input) {
    48	         this(input.readChunkPos(), input.readByteArray(2097152));
    49	      }
    50	
    51	      private static int calculateChunkSize(final LevelChunk chunk) {
    52	         int total = 0;
    53	
    54	         for (LevelChunkSection section : chunk.getSections()) {
    55	            total += section.getBiomes().getSerializedSize();
    56	         }
    57	
    58	         return total;
    59	      }
    60	
    61	      public FriendlyByteBuf getReadBuffer() {
    62	         return new FriendlyByteBuf(Unpooled.wrappedBuffer(this.buffer));
    63	      }
    64	
    65	      private ByteBuf getWriteBuffer() {
    66	         ByteBuf buffer = Unpooled.wrappedBuffer(this.buffer);
    67	         buffer.writerIndex(0);
    68	         return buffer;
    69	      }
    70	
    71	      public static void extractChunkData(final FriendlyByteBuf buffer, final LevelChunk chunk) {
    72	         for (LevelChunkSection section : chunk.getSections()) {
    73	            section.getBiomes().write(buffer);
    74	         }
    75	
    76	         if (buffer.writerIndex() != buffer.capacity()) {
    77	            throw new IllegalStateException("Didn't fill biome buffer: expected " + buffer.capacity() + " bytes, got " + buffer.writerIndex());
    78	         }
    79	      }
    80	
    81	      public void write(final FriendlyByteBuf output) {
    82	         output.writeChunkPos(this.pos);
    83	         output.writeByteArray(this.buffer);
    84	      }
    85	   }
    86	}

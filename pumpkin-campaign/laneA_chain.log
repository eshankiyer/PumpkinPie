   144	   @Override
   145	   protected void readAdditionalSaveData(final ValueInput input) {
   146	      super.readAdditionalSaveData(input);
   147	      this.despawnDelay = input.getIntOr("DespawnDelay", 0);
   148	      this.wanderTarget = input.read("wander_target", BlockPos.CODEC).orElse(null);
   149	      this.setAge(Math.max(0, this.getAge()));
   150	   }

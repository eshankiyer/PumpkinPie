    36	public class SpawnEggItem extends Item {
    37	   public SpawnEggItem(final Item.Properties properties) {
    38	      super(properties);
    39	   }
    40	
    41	   @Override
    42	   public InteractionResult useOn(final UseOnContext context) {
    43	      Level level = context.getLevel();
    44	      ItemStack itemStack = context.getItemInHand();
    45	      EntityType<?> type = getType(itemStack);
    46	      if (type == null || !type.canSpawn(level)) {
    47	         return InteractionResult.FAIL;
    48	      } else if (!(level instanceof ServerLevel serverLevel)) {
    49	         return InteractionResult.SUCCESS;
    50	      } else {
    51	         BlockPos pos = context.getClickedPos();
    52	         Direction clickedFace = context.getClickedFace();
    53	         BlockState blockState = level.getBlockState(pos);
    54	         if (level.getBlockEntity(pos) instanceof Spawner spawnerHolder) {
    55	            if (!serverLevel.isSpawnerBlockEnabled()) {
    56	               if (context.getPlayer() instanceof ServerPlayer serverPlayer) {
    57	                  serverPlayer.sendSystemMessage(Component.translatable("advMode.notEnabled.spawner"));
    58	               }
    59	
    60	               return InteractionResult.FAIL;
    61	            } else {
    62	               spawnerHolder.setEntityId(type, level.getRandom());
    63	               level.sendBlockUpdated(pos, blockState, blockState, 3);
    64	               level.gameEvent(context.getPlayer(), GameEvent.BLOCK_CHANGE, pos);
    65	               itemStack.shrink(1);
    66	               return InteractionResult.SUCCESS;
    67	            }
    68	         } else {
    69	            BlockPos spawnPos;
    70	            if (blockState.getCollisionShape(level, pos).isEmpty()) {
    71	               spawnPos = pos;
    72	            } else {
    73	               spawnPos = pos.relative(clickedFace);
    74	            }
    75	
    76	            return spawnMob(type, context.getPlayer(), itemStack, serverLevel, spawnPos, true, !Objects.equals(pos, spawnPos) && clickedFace == Direction.UP);
    77	         }
    78	      }
    79	   }
    80	
    81	   private static InteractionResult spawnMob(
    82	      final EntityType<?> type,
    83	      final @Nullable LivingEntity user,
    84	      final ItemStack itemStack,
    85	      final ServerLevel level,
    86	      final BlockPos spawnPos,
    87	      final boolean tryMoveDown,
    88	      final boolean movedUp
    89	   ) {
    90	      if (type.spawn(level, itemStack, user, spawnPos, EntitySpawnReason.SPAWN_ITEM_USE, tryMoveDown, movedUp) != null) {
    91	         itemStack.consume(1, user);
    92	         level.gameEvent(user, GameEvent.ENTITY_PLACE, spawnPos);
    93	         return InteractionResult.SUCCESS;
    94	      } else {
    95	         return InteractionResult.FAIL;
    96	      }
    97	   }
    98	
    99	   @Override
   100	   public InteractionResult use(final Level level, final Player player, final InteractionHand hand) {
   101	      ItemStack itemStack = player.getItemInHand(hand);
   102	      BlockHitResult hitResult = getPlayerPOVHitResult(level, player, ClipContext.Fluid.SOURCE_ONLY);
   103	      if (hitResult.getType() != HitResult.Type.BLOCK) {
   104	         return InteractionResult.PASS;
   105	      }
   106	
   107	      EntityType<?> type = getType(itemStack);
   108	      if (type == null || !type.canSpawn(level)) {
   109	         return InteractionResult.FAIL;
   110	      }
   111	
   112	      if (level instanceof ServerLevel serverLevel) {
   113	         BlockPos pos = hitResult.getBlockPos();
   114	         if (!(level.getBlockState(pos).getBlock() instanceof LiquidBlock)) {
   115	            return InteractionResult.PASS;
   116	         }
   117	
   118	         if (level.mayInteract(player, pos) && player.mayUseItemAt(pos, hitResult.getDirection(), itemStack)) {
   119	            InteractionResult result = spawnMob(type, player, itemStack, serverLevel, pos, false, false);
   120	            if (result == InteractionResult.SUCCESS) {
   121	               player.awardStat(Stats.ITEM_USED.get(this));
   122	            }
   123	
   124	            return result;
   125	         } else {
   126	            return InteractionResult.FAIL;
   127	         }
   128	      } else {
   129	         return InteractionResult.SUCCESS;
   130	      }
   131	   }
   132	
   133	   public static boolean spawnsEntity(final ItemStack itemStack, final EntityType<?> type) {
   134	      return Objects.equals(getType(itemStack), type);
   135	   }
   136	
   137	   public static Optional<Holder<Item>> byId(final EntityType<?> type) {
   138	      return BuiltInRegistries.ITEM.componentLookup().findMatching(DataComponents.ENTITY_DATA, c -> c.type() == type).findAny();
   139	   }
   140	
   141	   public static @Nullable EntityType<?> getType(final ItemStack itemStack) {
   142	      TypedEntityData<EntityType<?>> entityData = itemStack.get(DataComponents.ENTITY_DATA);
   143	      return entityData != null ? entityData.type() : null;
   144	   }
   145	
   146	   public static Optional<Mob> spawnOffspringFromSpawnEgg(
   147	      final Player player, final Mob parent, final EntityType<? extends Mob> type, final ServerLevel level, final Vec3 pos, final ItemStack spawnEggStack
   148	   ) {
   149	      if (!spawnsEntity(spawnEggStack, type)) {
   150	         return Optional.empty();
   151	      }
   152	
   153	      Mob offspring;
   154	      if (parent instanceof AgeableMob ageableMob) {
   155	         offspring = ageableMob.getBreedOffspring(level, ageableMob);
   156	      } else {
   157	         offspring = type.create(level, EntitySpawnReason.SPAWN_ITEM_USE);
   158	      }
   159	
   160	      if (offspring == null) {
   161	         return Optional.empty();
   162	      }
   163	
   164	      offspring.setBaby(true);
   165	      if (!offspring.isBaby()) {
   166	         return Optional.empty();
   167	      }
   168	
   169	      offspring.snapTo(pos.x(), pos.y(), pos.z(), 0.0F, 0.0F);
   170	      offspring.applyComponentsFromItemStack(spawnEggStack);
   171	      level.addFreshEntityWithPassengers(offspring);
   172	      spawnEggStack.consume(1, player);
   173	      return Optional.of(offspring);
   174	   }

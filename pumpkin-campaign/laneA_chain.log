    82	   private void decreaseEggs(final Level level, final BlockPos pos, final BlockState state) {
    83	      level.playSound(null, pos, SoundEvents.TURTLE_EGG_BREAK, SoundSource.BLOCKS, 0.7F, 0.9F + level.getRandom().nextFloat() * 0.2F);
    84	      int numberOfEggs = state.getValue(EGGS);
    85	      if (numberOfEggs <= 1) {
    86	         level.destroyBlock(pos, false);
    87	      } else {
    88	         level.setBlock(pos, state.setValue(EGGS, numberOfEggs - 1), 2);
    89	         level.gameEvent(GameEvent.BLOCK_DESTROY, pos, GameEvent.Context.of(state));
    90	         level.levelEvent(2001, pos, Block.getId(state));
    91	      }
    92	   }

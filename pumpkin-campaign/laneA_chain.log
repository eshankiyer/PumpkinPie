   106	   @Override
   107	   public InteractionResult mobInteract(final Player player, final InteractionHand hand) {
   108	      ItemStack itemStack = player.getItemInHand(hand);
   109	      if (!itemStack.is(Items.VILLAGER_SPAWN_EGG) && this.isAlive() && !this.isTrading() && !this.isBaby()) {
   110	         if (hand == InteractionHand.MAIN_HAND) {
   111	            player.awardStat(Stats.TALKED_TO_VILLAGER);
   112	         }
   113	
   114	         if (!this.level().isClientSide()) {
   115	            if (this.getOffers().isEmpty()) {
   116	               return InteractionResult.CONSUME;
   117	            }
   118	
   119	            this.setTradingPlayer(player);
   120	            this.openTradingScreen(player, this.getDisplayName(), 1);
   121	         }
   122	
   123	         return InteractionResult.SUCCESS;
   124	      } else {
   125	         return super.mobInteract(player, hand);
   126	      }
   127	   }

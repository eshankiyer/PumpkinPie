   182	    // TrialSpawnerConfig.java:47-49 and TrialSpawnerState.java:132-137: select one configured
   183	    // reward table using its weighted-list entry before the ejection cycle begins.
   184	    fn pick_random_loot_table(&self) -> Option<String> {
   185	        let total_weight: i32 = self
   186	            .loot_tables_to_eject
   187	            .iter()
   188	            .map(|(_, weight)| *weight)
   189	            .sum();
   190	        if total_weight <= 0 {
   191	            return self
   192	                .loot_tables_to_eject
   193	                .first()
   194	                .map(|(table, _)| table.clone());
   195	        }
   196	        let mut roll = rand::random_range(0..total_weight);
   197	        for (table, weight) in &self.loot_tables_to_eject {
   198	            if roll < *weight {
   199	                return Some(table.clone());
   200	            }
   201	            roll -= weight;
   202	        }
   203	        None
   204	    }
   205	}

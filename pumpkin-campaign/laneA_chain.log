   195	#[cfg(test)]
   196	mod tests {
   197	    use super::BrushItem;
   198	
   199	    /// `BrushItem.onUseTick` (`BrushItem.java:62-64`): with `getUseDuration` = 200 and a
   200	    /// `remaining_use_ticks` that starts at 200 and decrements by one per tick, a stroke
   201	    /// lands every ten ticks starting on the fifth.
   202	    #[test]
   203	    fn a_stroke_lands_every_ten_ticks_starting_at_five() {
   204	        let strokes: Vec<i32> = (0..40)
   205	            .map(|tick| BrushItem::USE_DURATION - tick)
   206	            .filter(|remaining| (BrushItem::USE_DURATION - remaining + 1) % 10 == 5)
   207	            .map(|remaining| BrushItem::USE_DURATION - remaining)
   208	            .collect();
   209	        assert_eq!(strokes, vec![4, 14, 24, 34]);
   210	    }
   211	}

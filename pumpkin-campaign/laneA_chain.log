    84	/// Represents an ingredient in a recipe.
    85	///
    86	/// Ingredients can be:
    87	/// - A specific item ID (e.g. `"minecraft:diamond"` or `"diamond"`).
    88	/// - A tag representing a group of items (e.g. `"#minecraft:logs"` or `"#logs"`).
    89	/// - One of multiple specific items.
    90	#[derive(Clone, Debug, PartialEq, Eq, Hash)]
    91	pub enum Ingredient {
    92	    /// A specific item by registry key (e.g., `"minecraft:diamond"`).
    93	    Item(String),
    94	    /// A tag representing multiple items (e.g., `"minecraft:logs"`).
    95	    Tag(String),
    96	    /// One of multiple specific items.
    97	    OneOf(Vec<String>),
    98	}

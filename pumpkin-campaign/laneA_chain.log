   117	    /// If no namespace is provided (e.g., `"logs"`), `"minecraft:"` is prepended.
   118	    /// Any leading `#` character is automatically stripped.
   119	    #[must_use]
   120	    pub fn tag(tag: impl AsRef<str>) -> Self {
   121	        let mut s = tag.as_ref();
   122	        if let Some(stripped) = s.strip_prefix('#') {
   123	            s = stripped;
   124	        }
   125	        let normalized = if s.contains(':') {
   126	            s.to_string()
   127	        } else {
   128	            format!("minecraft:{s}")
   129	        };
   130	        Self::Tag(normalized)
   131	    }
   132	
   133	    /// Creates an ingredient matching any of the provided item IDs.

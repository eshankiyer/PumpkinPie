    57	    /// Calls all the contained callbacks of this taker with the returned result.
    58	    #[must_use]
    59	    pub fn call(&self, return_value: ReturnValue) -> Pin<Box<dyn Future<Output = ()> + Send + '_>> {
    60	        Box::pin(async move {
    61	            for callback in &self.0 {
    62	                callback.call(return_value).await;
    63	            }
    64	        })
    65	    }
    66	}

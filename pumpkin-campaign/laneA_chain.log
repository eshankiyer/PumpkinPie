   423	        InstantiationError::MissingArgument(parameter) => TextComponent::translate_cross(
   424	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   425	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   426	            [
   427	                TextComponent::text(fn_id.to_string()),
   428	                TextComponent::text(parameter),
   429	            ],
   430	        ),
   431	    };
   432	    ExecuteFunctionError::InstantiationFailure {
   433	        function_id: fn_id.to_string(),
   434	        reason,
   435	    }
   436	}
   437	
   438	fn read_pack_mcmeta(pack_path: &Path) -> (String, u32) {
   439	    let mcmeta_path = pack_path.join("pack.mcmeta");
   440	    if let Ok(content) = fs::read_to_string(mcmeta_path)
   441	        && let Ok(val) = serde_json::from_str::<serde_json::Value>(&content)
   442	    {
   443	        let pack = val.get("pack");
   444	        let description = pack
   445	            .and_then(|p| p.get("description"))
   446	            .map(|d| {
   447	                d.as_str()
   448	                    .map_or_else(|| d.to_string(), ToString::to_string)
   449	            })
   450	            .unwrap_or_default();
   451	        let pack_format = pack
   452	            .and_then(|p| p.get("pack_format"))
   453	            .and_then(serde_json::Value::as_u64)
   454	            .unwrap_or(61) as u32;
   455	        return (description, pack_format);
   456	    }
   457	    (String::new(), 61)
   458	}
   459	
   460	fn load_recipes_from_dir(
   461	    namespace: &str,
   462	    dir: &Path,
   463	    all_recipes: &mut Vec<DynamicRecipe>,
   464	    count: &mut usize,
   465	) {
   466	    let Ok(entries) = fs::read_dir(dir) else {
   467	        return;
   468	    };
   469	    for entry in entries.flatten() {
   470	        let path = entry.path();
   471	        if path.is_dir() {
   472	            load_recipes_from_dir(namespace, &path, all_recipes, count);
   473	        } else if path
   474	            .extension()
   475	            .is_some_and(|ext| ext.eq_ignore_ascii_case("json"))
   475	            .is_some_and(|ext| ext.eq_ignore_ascii_case("json"))
   476	        {
   477	            let stem = path
   478	                .file_stem()
   479	                .map(|s| s.to_string_lossy().to_string())
   480	                .unwrap_or_default();
   481	            if let Ok(content) = fs::read_to_string(&path)
   482	                && let Some(recipe) = recipe_loader::parse_recipe(namespace, &stem, &content)
   483	            {
   484	                all_recipes.push(recipe);
   485	                *count += 1;
   486	            }
   487	        }
   488	    }
   489	}
   490	
   491	#[cfg(test)]
   492	mod tests {
   493	    use super::{CommandSource, function_source_for_execution};
   494	
   495	    /// `FunctionCommand.modifySenderForExecution` (`FunctionCommand.java:106-108`) suppresses
   496	    /// output on the function execution source while leaving the caller's source unchanged.
   497	    #[test]
   498	    fn function_execution_source_suppresses_output() {
   499	        let source = CommandSource::dummy();
   500	        let function_source = function_source_for_execution(&source);
   501	
   502	        assert!(!source.silent);
   503	        assert!(function_source.silent);
   504	    }
   505	}
diff --git a/crates/pumpkin/src/data/datapack/mod.rs b/crates/pumpkin/src/data/datapack/mod.rs
index 447767b7..e5df03dc 100644
--- a/crates/pumpkin/src/data/datapack/mod.rs
+++ b/crates/pumpkin/src/data/datapack/mod.rs
@@ -243,6 +243,11 @@ impl DatapackManager {
         name: &str,
         arguments: Option<&NbtCompound>,
     ) -> Result<usize, ExecuteFunctionError> {
+        // `FunctionCommand.modifySenderForExecution` suppresses output from commands dispatched
+        // by a function (`FunctionCommand.java:106-108`). Keep the original source for the
+        // caller's result/feedback and use the suppressed copy for every function line.
+        let function_source = function_source_for_execution(source);
+
         // Vanilla clamps the chain limit to at least 1
         // (`Commands.java:400`).
         let fallback_registry = GameRuleRegistry::default();
@@ -259,14 +264,20 @@ impl DatapackManager {
         // ExecutionContext (`Commands.java:412-414`).
         if REMAINING_COMMAND_QUOTA.try_with(Cell::get).is_ok() {
             return self
-                .execute_function_in_context(server, source, name, arguments, limit)
+                .execute_function_in_context(server, &function_source, name, arguments, limit)
                 .await;
         }
 
         REMAINING_COMMAND_QUOTA
             .scope(
                 Cell::new(limit),
-                self.execute_function_in_context(server, source, name, arguments, limit),
+                self.execute_function_in_context(
+                    server,
+                    &function_source,
+                    name,
+                    arguments,
+                    limit,
+                ),
             )
             .await
     }
@@ -390,6 +401,13 @@ impl DatapackManager {
     }
 }
 
+/// Builds the execution source used by `FunctionCommand.runGuarded` after
+/// `modifySenderForExecution` (`FunctionCommand.java:235-264`, with source modification at
+/// `:106-108`).
+fn function_source_for_execution(source: &CommandSource) -> CommandSource {
+    source.clone().with_silent()
+}
+
 /// Translates a macro instantiation failure into the user-facing component
 /// vanilla produces before wrapping it in `ERROR_FUNCTION_INSTANTATION_FAILURE`
 /// (`FunctionCommand.java:139-141`): "missing arguments to function %s"
@@ -469,3 +487,19 @@ fn load_recipes_from_dir(
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::{CommandSource, function_source_for_execution};
+
+    /// `FunctionCommand.modifySenderForExecution` (`FunctionCommand.java:106-108`) suppresses
+    /// output on the function execution source while leaving the caller's source unchanged.
+    #[test]
+    fn function_execution_source_suppresses_output() {
+        let source = CommandSource::dummy();
+        let function_source = function_source_for_execution(&source);
+
+        assert!(!source.silent);
+        assert!(function_source.silent);
+    }
+}


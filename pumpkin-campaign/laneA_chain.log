    59	   @Override
    60	   protected void registerGoals() {
    61	      this.goalSelector.addGoal(0, new FloatGoal(this));
    62	      this.goalSelector
    63	         .addGoal(
    64	            0,
    65	            new UseItemGoal<>(
    66	               this,
    67	               PotionContents.createItemStack(Items.POTION, Potions.INVISIBILITY),
    68	               SoundEvents.WANDERING_TRADER_DISAPPEARED,
    69	               e -> this.level().isDarkOutside() && !e.isInvisible()
    70	            )
    71	         );
    72	      this.goalSelector
    73	         .addGoal(
    74	            0,
    75	            new UseItemGoal<>(
    76	               this, new ItemStack(Items.MILK_BUCKET), SoundEvents.WANDERING_TRADER_REAPPEARED, e -> this.level().isBrightOutside() && e.isInvisible()
    77	            )
    78	         );
    79	      this.goalSelector.addGoal(1, new TradeWithPlayerGoal(this));
    80	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Zombie.class, 8.0F, 0.5, 0.5));
    81	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Evoker.class, 12.0F, 0.5, 0.5));
    82	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Vindicator.class, 8.0F, 0.5, 0.5));
    83	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Vex.class, 8.0F, 0.5, 0.5));
    84	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Pillager.class, 15.0F, 0.5, 0.5));
    85	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Illusioner.class, 12.0F, 0.5, 0.5));
    86	      this.goalSelector.addGoal(1, new AvoidEntityGoal<>(this, Zoglin.class, 10.0F, 0.5, 0.5));
    87	      this.goalSelector.addGoal(1, new PanicGoal(this, 0.5));
    88	      this.goalSelector.addGoal(1, new LookAtTradingPlayerGoal(this));
    89	      this.goalSelector.addGoal(2, new WanderingTrader.WanderToPositionGoal(this, 2.0, 0.35));
    90	      this.goalSelector.addGoal(4, new MoveTowardsRestrictionGoal(this, 0.35));
    91	      this.goalSelector.addGoal(8, new WaterAvoidingRandomStrollGoal(this, 0.35));
    92	      this.goalSelector.addGoal(9, new InteractGoal(this, Player.class, 3.0F, 1.0F));
    93	      this.goalSelector.addGoal(10, new LookAtPlayerGoal(this, Mob.class, 8.0F));
    94	   }

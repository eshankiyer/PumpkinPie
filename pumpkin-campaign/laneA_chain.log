   237	    /// Executes a function or function tag, optionally supplying macro
   238	    /// arguments (vanilla `/function <name> <compound>`).
   239	    pub async fn execute_function(
   240	        &self,
   241	        server: &Arc<Server>,
   242	        source: &CommandSource,
   243	        name: &str,
   244	        arguments: Option<&NbtCompound>,
   245	    ) -> Result<usize, ExecuteFunctionError> {
   246	        // Vanilla clamps the chain limit to at least 1
   247	        // (`Commands.java:400`).
   248	        let fallback_registry = GameRuleRegistry::default();
   249	        let default_limit = fallback_registry.max_command_sequence_length.max(1);
   250	        let limit = source.world.as_ref().map_or(default_limit, |world| {
   251	            match world.get_game_rule(&GameRule::MaxCommandSequenceLength) {
   252	                GameRuleValue::Int(v) => v.max(1),
   253	                GameRuleValue::Bool(_) => default_limit,
   254	            }
   255	        });
   256	
   257	        // A nested call (function invoking `function ...`) joins the ambient
   258	        // chain and shares its quota, like vanilla reuses the ambient
   259	        // ExecutionContext (`Commands.java:412-414`).
   260	        if REMAINING_COMMAND_QUOTA.try_with(Cell::get).is_ok() {
   261	            return self
   262	                .execute_function_in_context(server, source, name, arguments, limit)
   263	                .await;
   264	        }
   265	
   266	        REMAINING_COMMAND_QUOTA
   267	            .scope(
   268	                Cell::new(limit),
   269	                self.execute_function_in_context(server, source, name, arguments, limit),
   270	            )
   271	            .await
   272	    }
   273	
   274	    /// Runs one function or function tag inside the current command chain.
   275	    ///
   276	    /// Port of the per-entry execution of vanilla's command queue
   277	    /// (`ExecutionContext.runCommandQueue`, `ExecutionContext.java:88-105`,
   278	    /// entries dispatched through `CommandQueueEntry.execute`,
   279	    /// `CommandQueueEntry.java:4-6`): every executed line costs one unit of the
   280	    /// chain quota, and an exhausted quota aborts the whole remaining chain with
   281	    /// vanilla's log message. Functions containing `$` macro lines are
   282	    /// instantiated first (`MacroFunction.instantiate`,
   283	    /// `MacroFunction.java:52-82`).
   284	    async fn execute_function_in_context(
   285	        &self,
   286	        server: &Arc<Server>,
   287	        source: &CommandSource,
   288	        name: &str,
   289	        arguments: Option<&NbtCompound>,
   290	        limit: i64,
   291	    ) -> Result<usize, ExecuteFunctionError> {
   292	        let (functions_to_run, is_tag) = if let Some(tag_name) = name.strip_prefix('#') {
   293	            let tags = self.function_tags.read().await;
   294	            let Some(fns) = tags.get(tag_name) else {
   295	                return Err(ExecuteFunctionError::Unknown(format!("#{tag_name}")));
   296	            };
   297	            (fns.clone(), true)
   298	        } else {
   299	            (vec![name.to_string()], false)
   300	        };
   301	
   302	        let all_fns = self.functions.read().await;
   303	        let mut total_executed = 0;
   304	
   305	        for fn_id in functions_to_run {
   306	            let Some(function) = all_fns.get(&fn_id) else {
   307	                if !is_tag {
   308	                    return Err(ExecuteFunctionError::Unknown(fn_id));
   309	                }
   310	                continue;
   311	            };
   312	
   313	            let lines = self.instantiate_lines(&fn_id, function, arguments)?;
   314	            for line in lines {
   315	                // Vanilla checks the quota before polling each queued entry and
   316	                // breaks out of the entire queue once it is spent
   317	                // (`ExecutionContext.java:89-92`).
   318	                let remaining = REMAINING_COMMAND_QUOTA.with(Cell::get);
   319	                if remaining <= 0 {
   320	                    // Vanilla logs the configured limit here
   321	                    // (`ExecutionContext.java:89-91`).
   322	                    info!("Command execution stopped due to limit (executed {limit} commands)");
   323	                    return Ok(total_executed);
   324	                }
   325	                REMAINING_COMMAND_QUOTA.with(|quota| quota.set(remaining - 1));
   326	
   327	                server
   328	                    .command_dispatcher
   329	                    .load()
   330	                    .handle_command(source, &line)

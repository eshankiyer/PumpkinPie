   158	   private void spawnOminousOminousItemSpawner(final ServerLevel level, final BlockPos trialSpawnerPos, final TrialSpawner trialSpawner) {
   159	      TrialSpawnerStateData data = trialSpawner.getStateData();
   160	      TrialSpawnerConfig config = trialSpawner.activeConfig();
   161	      ItemStack itemToDispense = data.getDispensingItems(level, config, trialSpawnerPos).getRandom(level.getRandom()).orElse(ItemStack.EMPTY);
   162	      if (!itemToDispense.isEmpty()) {
   163	         if (this.timeToSpawnItemSpawner(level, data)) {
   164	            calculatePositionToSpawnSpawner(level, trialSpawnerPos, trialSpawner, data).ifPresent(pos -> {
   165	               OminousItemSpawner itemSpawner = OminousItemSpawner.create(level, itemToDispense);
   166	               itemSpawner.snapTo(pos);
   167	               level.addFreshEntity(itemSpawner);
   168	               float pitch = (level.getRandom().nextFloat() - level.getRandom().nextFloat()) * 0.2F + 1.0F;
   169	               level.playSound(null, BlockPos.containing(pos), SoundEvents.TRIAL_SPAWNER_SPAWN_ITEM_BEGIN, SoundSource.BLOCKS, 1.0F, pitch);
   170	               data.cooldownEndsAt = level.getGameTime() + trialSpawner.ominousConfig().ticksBetweenItemSpawners();
   171	            });
   172	         }
   173	      }
   174	   }
   175	
   176	   private static Optional<Vec3> calculatePositionToSpawnSpawner(
   177	      final ServerLevel level, final BlockPos trialSpawnerPos, final TrialSpawner trialSpawner, final TrialSpawnerStateData data
   178	   ) {
   179	      List<Player> nearbyPlayers = data.detectedPlayers
   180	         .stream()
   181	         .map(level::getPlayerByUUID)
   182	         .filter(Objects::nonNull)
   183	         .filter(
   184	            player -> !player.isCreative()
   185	               && !player.isSpectator()
   186	               && player.isAlive()
   187	               && player.distanceToSqr(Vec3.atCenterOf(trialSpawnerPos)) <= Mth.square(trialSpawner.getRequiredPlayerRange())
   188	         )
   189	         .toList();
   190	      if (nearbyPlayers.isEmpty()) {
   191	         return Optional.empty();
   192	      }
   193	
   194	      Entity entity = selectEntityToSpawnItemAbove(nearbyPlayers, data.currentMobs, trialSpawner, trialSpawnerPos, level);
   195	      return entity == null ? Optional.empty() : calculatePositionAbove(entity, level);
   196	   }
   197	
   198	   private static Optional<Vec3> calculatePositionAbove(final Entity entityToSpawnItemAbove, final ServerLevel level) {
   199	      Vec3 entityPos = entityToSpawnItemAbove.position();
   200	      Vec3 trySpawnPos = entityPos.relative(Direction.UP, entityToSpawnItemAbove.getBbHeight() + 2.0F + level.getRandom().nextInt(4));
   201	      BlockHitResult hitResult = level.clip(new ClipContext(entityPos, trySpawnPos, ClipContext.Block.VISUAL, ClipContext.Fluid.NONE, CollisionContext.empty()));
   202	      Vec3 down = Vec3.atCenterOf(hitResult.getBlockPos()).relative(Direction.DOWN, 1.0);
   203	      BlockPos blockPosDown = BlockPos.containing(down);
   204	      return !level.getBlockState(blockPosDown).getCollisionShape(level, blockPosDown).isEmpty() ? Optional.empty() : Optional.of(down);
   205	   }
   206	
   207	   private static @Nullable Entity selectEntityToSpawnItemAbove(
   208	      final List<Player> nearbyPlayers, final Set<UUID> mobIds, final TrialSpawner trialSpawner, final BlockPos spawnerPos, final ServerLevel level
   209	   ) {
   210	      Stream<Entity> nearbyMobs = mobIds.stream()
   211	         .map(level::getEntity)
   212	         .filter(Objects::nonNull)
   213	         .filter(target -> target.isAlive() && target.distanceToSqr(Vec3.atCenterOf(spawnerPos)) <= Mth.square(trialSpawner.getRequiredPlayerRange()));
   214	      RandomSource random = level.getRandom();
   215	      List<? extends Entity> eligibleEntities = random.nextBoolean() ? nearbyMobs.toList() : nearbyPlayers;
   216	      if (eligibleEntities.isEmpty()) {
   217	         return null;
   218	      } else {
   219	         return eligibleEntities.size() == 1 ? eligibleEntities.getFirst() : Util.getRandom(eligibleEntities, random);
   220	      }
   221	   }
   222	
   223	   private boolean timeToSpawnItemSpawner(final ServerLevel serverLevel, final TrialSpawnerStateData data) {
   224	      return serverLevel.getGameTime() >= data.cooldownEndsAt;
   225	   }

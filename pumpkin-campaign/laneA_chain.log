    38	            SSetStructureBlock::MODE_LOAD => "LOAD",
    39	            SSetStructureBlock::MODE_CORNER => "CORNER",
    40	            SSetStructureBlock::MODE_DATA => "DATA",
    41	            _ => return,
    42	        };

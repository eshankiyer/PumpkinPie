     1	use pumpkin_data::translation;
     2	use pumpkin_util::PermissionLvl;
     3	use pumpkin_util::permission::{Permission, PermissionDefault, PermissionRegistry};
     4	use pumpkin_util::text::TextComponent;
     5	
     6	use crate::command::argument_builder::{ArgumentBuilder, argument, command};
     7	use crate::command::argument_types::core::string::StringArgumentType;
     8	use crate::command::argument_types::nbt::NbtCompoundArgumentType;
     9	use crate::command::context::command_context::CommandContext;
    10	use crate::command::errors::command_syntax_error::CommandSyntaxError;
    11	use crate::command::errors::error_types::CommandErrorType;
    12	use crate::command::node::dispatcher::CommandDispatcher;
    13	use crate::command::node::{CommandExecutor, CommandExecutorResult};
    14	use crate::command::suggestion::provider::{SuggestionProvider, SuggestionProviderResult};
    15	use crate::command::suggestion::suggestions::SuggestionsBuilder;
    16	use crate::data::datapack::ExecuteFunctionError;
    17	
    18	const DESCRIPTION: &str = "Runs commands found in the corresponding function files.";
    19	const PERMISSION: &str = "minecraft:command.function";
    20	
    21	static ERROR_UNKNOWN_FUNCTION: CommandErrorType<1> = CommandErrorType::new(
    22	    translation::java::ARGUMENTS_FUNCTION_UNKNOWN,
    23	    translation::java::ARGUMENTS_FUNCTION_UNKNOWN,
    24	);
    25	
    26	/// Port of vanilla's `ERROR_FUNCTION_INSTANTATION_FAILURE`
    27	/// (`FunctionCommand.java:49-51`): wraps a `MacroFunction.instantiate` failure
    28	/// (`MacroFunction.java:52-82`) raised while queueing the function
    29	/// (`FunctionCommand.java:137-141`).
    30	static ERROR_INSTANTIATION_FAILURE: CommandErrorType<2> = CommandErrorType::new(
    31	    translation::java::COMMANDS_FUNCTION_INSTANTIATIONFAILURE,
    32	    translation::java::COMMANDS_FUNCTION_INSTANTIATIONFAILURE,
    33	);
    34	
    35	struct FunctionSuggestionProvider;
    36	
    37	impl SuggestionProvider for FunctionSuggestionProvider {
    38	    fn suggest<'a>(
    39	        &'a self,
    40	        context: &'a CommandContext,
    41	        mut builder: SuggestionsBuilder,
    42	    ) -> SuggestionProviderResult<'a> {
    43	        Box::pin(async move {
    44	            let server = context.server();
    45	            let function_names = server.datapack_manager.get_function_names().await;
    46	            for name in function_names {
    47	                builder = builder.suggest(name);
    48	            }
    49	            builder.build()
    50	        })
    51	    }
    52	}
    53	
    54	/// Runs `/function <name>` without macro arguments (vanilla
    55	/// `FunctionCommand.java:83-88`, where the base executor passes a
    56	/// `null` compound).
    57	struct FunctionExecutor;
    58	
    59	impl CommandExecutor for FunctionExecutor {
    60	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    61	        Box::pin(async move {
    62	            let name_str = StringArgumentType::get(context, "name")?;
    63	            let server = context.server();
    64	
    65	            let executed_count = server
    66	                .datapack_manager
    67	                .execute_function(server, &context.source, name_str, None)
    68	                .await
    69	                .map_err(|error| map_error(error, name_str))?;
    70	
    71	            send_success_feedback(context, executed_count, name_str).await;
    72	
    73	            Ok(executed_count as i32)
    74	        })
    75	    }
    76	}
    77	
    78	/// Runs `/function <name> <compound>` with NBT compound macro arguments
    79	/// (vanilla `CompoundTagArgument.getCompoundTag(context, "arguments")`,
    80	/// `FunctionCommand.java:88-92`; argument type
    81	/// `net.minecraft.commands.arguments.CompoundTagArgument`).
    82	struct FunctionWithArgumentsExecutor;
    83	
    84	impl CommandExecutor for FunctionWithArgumentsExecutor {
    85	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    86	        Box::pin(async move {
    87	            let name_str = StringArgumentType::get(context, "name")?;
    88	            let arguments = NbtCompoundArgumentType::get(context, "arguments")?;
    89	            let server = context.server();
    90	
    91	            let executed_count = server
    92	                .datapack_manager
    93	                .execute_function(server, &context.source, name_str, Some(arguments))
    94	                .await
    95	                .map_err(|error| map_error(error, name_str))?;
    96	
    97	            send_success_feedback(context, executed_count, name_str).await;
    98	
    99	            Ok(executed_count as i32)
   100	        })
   101	    }
   102	}
   103	
   104	async fn send_success_feedback(context: &CommandContext<'_>, executed_count: usize, name: &str) {
   105	    if name.starts_with('#') {
   106	        context
   107	            .source
   108	            .send_feedback(
   109	                TextComponent::translate_cross(
   110	                    translation::java::COMMANDS_FUNCTION_SUCCESS_MULTIPLE,
   111	                    translation::java::COMMANDS_FUNCTION_SUCCESS_MULTIPLE,
   112	                    [
   113	                        TextComponent::text(executed_count.to_string()),
   114	                        TextComponent::text(name.to_string()),
   115	                    ],
   116	                ),
   117	                true,
   118	            )
   119	            .await;
   120	    } else {
   121	        context
   122	            .source
   123	            .send_feedback(
   124	                TextComponent::translate_cross(
   125	                    translation::java::COMMANDS_FUNCTION_SUCCESS_SINGLE,
   126	                    translation::java::COMMANDS_FUNCTION_SUCCESS_SINGLE,
   127	                    [
   128	                        TextComponent::text(executed_count.to_string()),
   129	                        TextComponent::text(name.to_string()),
   130	                    ],
   131	                ),
   132	                true,
   133	            )
   134	            .await;
   135	    }
   136	}
   137	
   138	/// Maps execution failures to their vanilla counterparts: unknown ids surface
   139	/// as `arguments.function.unknown` and macro instantiation failures as
   140	/// `commands.function.instantiationFailure` (`FunctionCommand.java:49-51`,
   141	/// raised at `:139-141`).
   142	fn map_error(error: ExecuteFunctionError, requested_name: &str) -> CommandSyntaxError {
   143	    match error {
   144	        ExecuteFunctionError::Unknown(_) => ERROR_UNKNOWN_FUNCTION
   145	            .create_without_context(TextComponent::text(requested_name.to_string())),
   146	        ExecuteFunctionError::InstantiationFailure {
   147	            function_id,
   148	            reason,
   149	        } => ERROR_INSTANTIATION_FAILURE
   150	            .create_without_context(TextComponent::text(function_id), reason),
   151	    }
   152	}
   153	
   154	pub fn register(dispatcher: &mut CommandDispatcher, registry: &PermissionRegistry) {
   155	    registry.register_permission_or_panic(Permission::new(
   156	        PERMISSION,
   157	        DESCRIPTION,
   158	        PermissionDefault::Op(PermissionLvl::Two),
   159	    ));
   160	
   161	    dispatcher.register(
   162	        command("function", DESCRIPTION).requires(PERMISSION).then(
   163	            argument("name", StringArgumentType::SingleWord)
   164	                .suggests(FunctionSuggestionProvider)
   165	                .executes(FunctionExecutor)
   166	                // `/function <name> <compound>` — vanilla registers the
   167	                // compound argument under the function-name argument
   168	                // (`FunctionCommand.java:88-92`).
   169	                .then(
   170	                    argument("arguments", NbtCompoundArgumentType)
   171	                        .executes(FunctionWithArgumentsExecutor),
   172	                ),
   173	        ),
   174	    );
   175	}

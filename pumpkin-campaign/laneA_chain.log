    54	/// Runs `/function <name>` without macro arguments (vanilla
    55	/// `FunctionCommand.java:83-88`, where the base executor passes a
    56	/// `null` compound).
    57	struct FunctionExecutor;
    58	
    59	impl CommandExecutor for FunctionExecutor {
    60	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    61	        Box::pin(async move {
    62	            let name_str = StringArgumentType::get(context, "name")?;
    63	            let server = context.server();
    64	
    65	            let executed_count = server
    66	                .datapack_manager
    67	                .execute_function(server, &context.source, name_str, None)
    68	                .await
    69	                .map_err(|error| map_error(error, name_str))?;
    70	
    71	            send_success_feedback(context, executed_count, name_str).await;
    72	
    73	            Ok(executed_count as i32)
    74	        })
    75	    }
    76	}

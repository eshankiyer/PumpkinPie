   194	/// Vanilla `decreaseEggs` (TurtleEggBlock.java:82-92): `TURTLE_EGG_BREAK` at volume 0.7 and
   195	/// pitch 0.9-1.1; the last egg pops the block (no drops), otherwise the state keeps the
   196	/// remaining eggs (flag 2 = `NOTIFY_LISTENERS`), firing `BLOCK_DESTROY` plus level event 2001
   197	/// for the break particles. Pumpkin's `GameEventContext` has no block-state variant, so the
   198	/// event carries no source (same documented simplification as `jukebox.rs`).
   199	async fn decrease_eggs(
   200	    world: &std::sync::Arc<crate::world::World>,
   201	    block: &Block,
   202	    position: &BlockPos,
   203	) {
   204	    world.play_sound_raw(
   205	        Sound::EntityTurtleEggBreak as u16,
   206	        SoundCategory::Blocks,
   207	        &position.to_f64(),
   208	        0.7,
   209	        0.9 + rng().random::<f32>() * 0.2,
   210	    );
   211	
   212	    let state_id = world.get_block_state_id(position);
   213	    let mut props = TurtleEggProperties::from_state_id(state_id, block);
   214	    if props.eggs <= 1 {
   215	        world
   216	            .break_block(position, None, BlockFlags::SKIP_DROPS)
   217	            .await;
   218	    } else {
   219	        props.eggs -= 1;
   220	        world
   221	            .set_block_state(
   222	                position,
   223	                props.to_state_id(block),
   224	                BlockFlags::NOTIFY_LISTENERS,
   225	            )
   226	            .await;
   227	
   228	        emit_game_event(
   229	            world,
   230	            GameEvent::BlockDestroy,
   231	            position.to_centered_f64(),
   232	            GameEventContext::none(),
   233	        )
   234	        .await;
   235	        world.sync_world_event(
   236	            WorldEvent::ParticlesDestroyBlock,
   237	            *position,
   238	            i32::from(state_id.as_u16()),
   239	        );
   240	    }
   241	}

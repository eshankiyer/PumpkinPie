   165	async fn destroy_egg(
   166	    world: &std::sync::Arc<crate::world::World>,
   167	    block: &Block,
   168	    position: &BlockPos,
   169	    entity: &dyn EntityBase,
   170	    randomness: i32,
   171	) {
   172	    let entity_ref = entity.get_entity();
   173	    if entity_ref.entity_type.id == EntityType::TURTLE.id
   174	        || entity_ref.entity_type.id == EntityType::BAT.id
   175	    {
   176	        return;
   177	    }
   178	
   179	    if entity.get_living_entity().is_none() {
   180	        return;
   181	    }
   182	
   183	    if entity.get_player().is_none() && !world.level_info.load().game_rules.mob_griefing {
   184	        return;
   185	    }
   186	
   187	    if rng().random_range(0..randomness) != 0 {
   188	        return;
   189	    }

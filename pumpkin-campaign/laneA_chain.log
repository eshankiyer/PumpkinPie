   797	            let behaviour = self.get_behaviour_mut();
   798	            let mut prop_vec = vec![];
   799	            for (idx, prop) in behaviour.properties.iter_mut().enumerate() {
   800	                let value = prop.get();
   801	                if prop.has_changed() {
   802	                    prop_vec.push((idx, value));
   803	                }
   804	            }

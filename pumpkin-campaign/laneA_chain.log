    /// No ingredients provided in a shapeless recipe.
    NoIngredients,
    /// Too many ingredients in a shapeless recipe (maximum 9).
    TooManyIngredients(usize),
    /// No input ingredient provided for cooking recipe.
    MissingCookingInput,
}


    88	            let arguments = NbtCompoundArgumentType::get(context, "arguments")?;
    89	            let server = context.server();
    90	
    91	            let executed_count = server
    92	                .datapack_manager
    93	                .execute_function(server, &context.source, name_str, Some(arguments))
    94	                .await
    95	                .map_err(|error| map_error(error, name_str))?;
    96	
    97	            send_success_feedback(context, executed_count, name_str).await;

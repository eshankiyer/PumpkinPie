    44	/// `HoneyBlock.isSlidingDown` (`HoneyBlock.java:84-101`).
    45	fn is_sliding_down(pos: &pumpkin_util::math::position::BlockPos, entity: &Entity) -> bool {
    46	    if entity.on_ground.load(std::sync::atomic::Ordering::Relaxed) {
    47	        return false;
    48	    }
    49	
    50	    let entity_pos = entity.pos.load();
    51	    if entity_pos.y > f64::from(pos.0.y) + 0.9375 - 1.0e-7 {
    52	        return false;
    53	    }
    54	
    55	    if get_old_delta_y(entity.velocity.load().y) >= -MIN_FALL_SPEED_TO_BE_CONSIDERED_SLIDING {
    56	        return false;
    57	    }
    58	
    59	    let dx = (f64::from(pos.0.x) + 0.5 - entity_pos.x).abs();
    60	    let dz = (f64::from(pos.0.z) + 0.5 - entity_pos.z).abs();
    61	    let overlap_distance = 0.4375 + f64::from(entity.entity_dimension.load().width) / 2.0;
    62	    dx + 1.0e-7 > overlap_distance || dz + 1.0e-7 > overlap_distance
    63	}

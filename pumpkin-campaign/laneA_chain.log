   144	    fn signal_for_count(weight: usize, count: usize) -> u8 {
   145	        let count = count.min(weight);
   146	        if count > 0 {
   147	            let f = count as f32 / weight as f32;
   148	            return (f * 15.0).ceil() as u8;
   149	        }
   150	        0
   151	    }

    38	/// Type alias for async slot operations.
    39	pub type BoxFuture<'a, T> = Pin<Box<dyn Future<Output = T> + Send + 'a>>;
    40	
    41	fn clone_stack_for_creative(stack: &ItemStack) -> ItemStack {
    42	    // `Slot.safeClone` (`Slot.java:125-128`) returns no stack for an empty slot and otherwise
    43	    // copies the item at its own maximum stack size.
    44	    if stack.is_empty() {
    45	        ItemStack::EMPTY.clone()
    46	    } else {
    47	        stack.copy_with_count(stack.get_max_stack_size())
    48	    }
    49	}

   102	    /// Vanilla `SpawnEggItem.use` (SpawnEggItem.java:100-131): right-clicking without hitting
   103	    /// a block raycasts with `ClipContext.Fluid.SOURCE_ONLY` and, if the hit block is a
   104	    /// `LiquidBlock`, spawns the mob inside the fluid itself (`tryMoveDown = false`).
   105	    /// Without this, water/lava mob eggs (cod, squid, dolphin, strider, ...) do nothing when
   106	    /// used on the surface of a fluid.
   107	    fn normal_use<'a>(
   108	        &'a self,
   109	        item: &'a Item,
   110	        player: &'a Player,
   111	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   112	        Box::pin(async move {
   113	            let Some(entity_type) = entity_from_egg(item.id) else {
   114	                return;
   115	            };
   116	            let world = player.world();
   117	            let (start_pos, end_pos) = self.get_start_and_end_pos(player);
   118	
   119	            // ClipContext.Fluid.SOURCE_ONLY: stop on any non-air block outline and on
   120	            // full fluid source blocks, but pass through flowing fluid.
   121	            let checker = async |pos: &BlockPos, world_inner: &Arc<World>| {
   122	                let state_id = world_inner.get_block_state_id(pos);
   123	                let block = Block::from_state_id(state_id);
   124	                if state_id == Block::AIR.default_state.id {
   125	                    return false;
   126	                }
   127	                if block.id == Block::WATER.id || block.id == Block::LAVA.id {
   128	                    return state_id == block.default_state.id;
   129	                }
   130	                true
   131	            };
   132	
   133	            let Some((pos, face)) = world.raycast(start_pos, end_pos, checker).await else {
   134	                return;
   135	            };
   136	
   137	            // SpawnEggItem.java:114: only a LiquidBlock is spawned into by `use`; anything
   138	            // else is left to `useOn`.
   139	            let hit_block = world.get_block(&pos);
   140	            if hit_block.id != Block::WATER.id && hit_block.id != Block::LAVA.id {
   141	                return;
   142	            }
   143	
   144	            let inventory = player.inventory();
   145	            let held = inventory.held_item().await;
   146	            let (mut stack, hand) = if !held.is_empty() && held.item.id == item.id {
   147	                (held, Hand::Right)
   148	            } else {
   149	                let off_hand = inventory.off_hand_item().await;
   150	                if !off_hand.is_empty() && off_hand.item.id == item.id {
   151	                    (off_hand, Hand::Left)
   152	                } else {
   153	                    return;
   154	                }
   155	            };
   156	
   157	            // `SpawnEggItem.use` gates liquid spawning with `Player.mayUseItemAt`
   158	            // (`SpawnEggItem.java:112-119`).
   159	            if !player.may_use_item_at(&pos, face, &stack).await {
   160	                return;
   161	            }
   162	
   163	            let spawn_pos = Vector3::new(
   164	                f64::from(pos.0.x) + 0.5,
   165	                f64::from(pos.0.y),
   166	                f64::from(pos.0.z) + 0.5,
   167	            );
   168	            spawn_egg_mob(entity_type, &stack, &world, spawn_pos).await;
   169	            stack.decrement_unless_creative(player.gamemode.load(), 1);
   170	            inventory.set_stack_in_hand(hand, stack).await;
   171	        })
   172	    }
   173	
   174	    fn use_on_block<'a>(
   175	        &'a self,
   176	        item: &'a mut ItemStack,
   177	        player: &'a Player,
   178	        location: BlockPos,
   179	        face: BlockDirection,
   180	        _cursor_pos: Vector3<f32>,
   181	        _block: &'a Block,
   182	        _server: &'a Server,
   183	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   184	        Box::pin(async move {
   185	            if let Some(entity_type) = entity_from_egg(item.item.id) {
   186	                let world = player.world();
   187	
   188	                if let Some(block_entity) = player.world().get_block_entity(&location)
   189	                    && let Some(spawner) = block_entity
   190	                        .as_any()
   191	                        .downcast_ref::<MobSpawnerBlockEntity>()
   192	                {
   193	                    spawner.set_entity_type(entity_type);
   194	                    world.update_block_entity(&block_entity);
   195	                    item.decrement_unless_creative(player.gamemode.load(), 1);
   196	                    return;
   197	                }
   198	                // Vanilla `SpawnEggItem#useOn` (SpawnEggItem.java:54): the `Spawner`
   199	                // check also matches trial spawner block entities, whose
   200	                // `setEntityId` overrides the entity they spawn.
   201	                if let Some(block_entity) = player.world().get_block_entity(&location)
   202	                    && let Some(trial_spawner) = block_entity
   203	                        .as_any()
   204	                        .downcast_ref::<TrialSpawnerBlockEntity>()
   205	                {
   206	                    trial_spawner.set_entity_id(&world, entity_type).await;
   207	                    world.update_block_entity(&block_entity);
   208	                    item.decrement_unless_creative(player.gamemode.load(), 1);
   209	                    return;
   210	                }
   211	                // Vanilla `SpawnEggItem#useOn`: the mob is placed inside the clicked block when
   212	                // that block has no collision shape (grass, torches, ...), and only otherwise on
   213	                // the block adjacent to the clicked face.
   214	                let pos = if world
   215	                    .get_block_state(&location)
   216	                    .get_block_collision_shapes()
   217	                    .next()
   218	                    .is_none()
   219	                {
   220	                    location
   221	                } else {
   222	                    BlockPos(location.0 + face.to_offset())
   223	                };
   224	                let pos = Vector3::new(
   225	                    f64::from(pos.0.x) + 0.5,
   226	                    f64::from(pos.0.y),
   227	                    f64::from(pos.0.z) + 0.5,
   228	                );
   229	                spawn_egg_mob(entity_type, item, &world, pos).await;
   230	                item.decrement_unless_creative(player.gamemode.load(), 1);
   231	            }
   232	        })
   233	    }

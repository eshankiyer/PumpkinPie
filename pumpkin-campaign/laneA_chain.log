    19	#[pumpkin_block("minecraft:honey_block")]
    20	pub struct HoneyBlock;
    21	
    22	/// `HoneyBlock.getOldDeltaY` (`HoneyBlock.java:76-78`): the stored velocity is already
    23	/// post-gravity/post-drag, so undo both to recover the pre-tick vertical speed.
    24	fn get_old_delta_y(delta_y: f64) -> f64 {
    25	    delta_y / f64::from(0.98f32) + MIN_FALL_SPEED_TO_BE_CONSIDERED_SLIDING
    26	}
    27	
    28	/// `HoneyBlock.getNewDeltaY` (`HoneyBlock.java:80-82`).
    29	fn get_new_delta_y(delta_y: f64) -> f64 {
    30	    (delta_y - MIN_FALL_SPEED_TO_BE_CONSIDERED_SLIDING) * f64::from(0.98f32)
    31	}
    32	
    33	/// `HoneyBlock.doesEntityDoHoneyBlockSlideEffects` (`HoneyBlock.java:42-44`).
    34	fn does_entity_do_slide_effects(entity: &dyn EntityBase) -> bool {
    35	    if entity.get_living_entity().is_some() {
    36	        return true;
    37	    }
    38	    let entity_type = entity.get_entity().entity_type;
    39	    entity_type == &EntityType::TNT
    40	        || entity_type.has_tag(&tag::EntityType::C_MINECARTS)
    41	        || entity_type.has_tag(&tag::EntityType::C_BOATS)
    42	}

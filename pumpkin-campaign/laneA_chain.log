    44	/// `HoneyBlock.isSlidingDown` (`HoneyBlock.java:84-101`).
    45	fn is_sliding_down(pos: &pumpkin_util::math::position::BlockPos, entity: &Entity) -> bool {
    46	    if entity.on_ground.load(std::sync::atomic::Ordering::Relaxed) {
    47	        return false;
    48	    }
    49	
    50	    let entity_pos = entity.pos.load();
    51	    if entity_pos.y > f64::from(pos.0.y) + 0.9375 - 1.0e-7 {
    52	        return false;
    53	    }
    54	
    55	    if get_old_delta_y(entity.velocity.load().y) >= -MIN_FALL_SPEED_TO_BE_CONSIDERED_SLIDING {
    56	        return false;
    57	    }
    58	
    59	    let dx = (f64::from(pos.0.x) + 0.5 - entity_pos.x).abs();
    60	    let dz = (f64::from(pos.0.z) + 0.5 - entity_pos.z).abs();
    61	    let overlap_distance = 0.4375 + f64::from(entity.entity_dimension.load().width) / 2.0;
    62	    dx + 1.0e-7 > overlap_distance || dz + 1.0e-7 > overlap_distance
    63	}
    64	
    65	/// `HoneyBlock.doSlideMovement` (`HoneyBlock.java:109-119`).
    66	fn do_slide_movement(entity: &dyn EntityBase) {
    67	    let base = entity.get_entity();
    68	    let delta = base.velocity.load();
    69	    let old_delta_y = get_old_delta_y(delta.y);
    70	
    71	    let new_velocity = if old_delta_y < -SLIDE_STARTS_WHEN_VERTICAL_SPEED_IS_AT_LEAST {
    72	        let horizontal_reduction_factor = -THROTTLE_SLIDE_SPEED_TO / old_delta_y;
    73	        Vector3::new(
    74	            delta.x * horizontal_reduction_factor,
    75	            get_new_delta_y(-THROTTLE_SLIDE_SPEED_TO),
    76	            delta.z * horizontal_reduction_factor,
    77	        )
    78	    } else {
    79	        Vector3::new(delta.x, get_new_delta_y(-THROTTLE_SLIDE_SPEED_TO), delta.z)
    80	    };
    81	
    82	    base.set_velocity(new_velocity);
    83	
    84	    // `Entity.resetFallDistance`
    85	    if let Some(living) = entity.get_living_entity() {
    86	        living.fall_distance.store(0.0);
    87	    }
    88	}
    89	
    90	impl BlockBehaviour for HoneyBlock {
    91	    /// `HoneyBlock.fallOn` (`HoneyBlock.java:51-61`): the slide sound always plays, and fall
    92	    /// damage is scaled by 0.2 rather than the vanilla default of 1.0.
    93	    fn on_landed_upon<'a>(&'a self, args: OnLandedUponArgs<'a>) -> BlockFuture<'a, ()> {
    94	        Box::pin(async move {
    95	            let entity = args.entity.get_entity();
    96	            entity.play_sound(Sound::BlockHoneyBlockSlide);
    97	            args.world
    98	                .send_entity_status(entity, EntityStatus::HoneyJump, None);
    99	
   100	            if let Some(living) = args.entity.get_living_entity() {
   101	                living
   102	                    .handle_fall_damage(args.entity, args.fall_distance, 0.2)
   103	                    .await;
   104	            }
   105	        })
   106	    }
   107	
   108	    /// `HoneyBlock.entityInside` (`HoneyBlock.java:63-74`).
   109	    fn on_entity_collision<'a>(&'a self, args: OnEntityCollisionArgs<'a>) -> BlockFuture<'a, ()> {
   110	        Box::pin(async move {
   111	            let entity = args.entity.get_entity();
   112	            if !is_sliding_down(args.position, entity) {
   113	                return;
   114	            }
   115	
   116	            // `maybeDoSlideAchievement` (`HoneyBlock.java:103-107`) is an advancement trigger and
   117	            // has no analogue here.
   118	            do_slide_movement(args.entity);
   119	
   120	            // `maybeDoSlideEffects` (`HoneyBlock.java:121-132`).
   121	            if does_entity_do_slide_effects(args.entity) {
   122	                if rng().random_range(0..5) == 0 {
   123	                    entity.play_sound(Sound::BlockHoneyBlockSlide);
   124	                }
   125	                if rng().random_range(0..5) == 0 {
   126	                    args.world
   127	                        .send_entity_status(entity, EntityStatus::HoneySlide, None);
   128	                }
   129	            }
   130	        })
   131	    }
   132	}

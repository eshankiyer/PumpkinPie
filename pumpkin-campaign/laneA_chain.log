    73	   private void destroyEgg(final Level level, final BlockState state, final BlockPos pos, final Entity entity, final int randomness) {
    74	      if (state.is(Blocks.TURTLE_EGG)
    75	         && level instanceof ServerLevel serverLevel
    76	         && this.canDestroyEgg(serverLevel, entity)
    77	         && level.getRandom().nextInt(randomness) == 0) {

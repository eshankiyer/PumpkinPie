   177	   public boolean shouldPrintOpWarning(final ItemStack stack, final @Nullable Player player) {
   178	      if (player != null && player.permissions().hasPermission(Permissions.COMMANDS_GAMEMASTER)) {
   179	         TypedEntityData<EntityType<?>> entityData = stack.get(DataComponents.ENTITY_DATA);
   180	         if (entityData != null) {
   181	            return entityData.type().onlyOpCanSetNbt();
   182	         }
   183	      }
   184	
   185	      return false;
   186	   }

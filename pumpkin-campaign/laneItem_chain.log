    15	#[derive(Default)]
    16	pub struct ItemRegistry {
    17	    items: FxHashMap<u16, Arc<dyn ItemBehaviour>>,
    18	}
    19	
    20	impl ItemRegistry {
    21	    pub fn register<T: ItemBehaviour + ItemMetadata + 'static>(&mut self, item: T) {
    22	        let val = Arc::new(item);
    23	        self.items.reserve(T::ids().len());
    24	        for i in T::ids() {
    25	            self.items.insert(i, val.clone());
    26	        }
    27	    }
    28	
    29	    pub async fn on_use(&self, stack: &ItemStack, player: &Player) {
    30	        let item = stack.item;
    31	        let cooldown = stack.get_use_cooldown();
    32	        let cooldown_group = cooldown
    33	            .and_then(|c| c.cooldown_group.clone())
    34	            .unwrap_or_else(|| item.registry_key.to_string());
    35	
    36	        if player.is_on_cooldown(&cooldown_group).await {
    37	            return;
    38	        }
    39	
    40	        let pumpkin_item = self.get_pumpkin_item(item.id);
    41	        if let Some(pumpkin_item) = pumpkin_item {
    42	            pumpkin_item.normal_use(item, player).await;
    43	        }
    44	
    45	        if let Some(cooldown) = cooldown {
    46	            player
    47	                .start_cooldown(cooldown_group, (cooldown.seconds * 20.0) as i32)
    48	                .await;
    49	        }
    50	    }
    51	
    52	    pub async fn inventory_tick(
    53	        &self,
    54	        stack: &mut ItemStack,
    55	        owner: &dyn EntityBase,
    56	        server: &Server,
    57	    ) {
    58	        if let Some(behaviour) = self.get_pumpkin_item(stack.item.id) {
    59	            behaviour.inventory_tick(stack, owner, server).await;
    60	        }
    61	    }
    62	
    63	    pub async fn on_stopped_using(&self, stack: &ItemStack, player: &Player) {
    64	        if let Some(behaviour) = self.get_pumpkin_item(stack.item.id) {
    65	            behaviour.on_stopped_using(stack, player).await;
    66	        }
    67	    }
    68	
    69	    pub async fn on_use_tick(&self, stack: &ItemStack, player: &Player, remaining_use_ticks: i32) {
    70	        if let Some(behaviour) = self.get_pumpkin_item(stack.item.id) {
    71	            behaviour
    72	                .on_use_tick(stack, player, remaining_use_ticks)
    73	                .await;
    74	        }
    75	    }
    76	
    77	    /// Dispatches `ItemStack.useOnRelease` (`ItemStack.java:756-757`) through the registered item.
    78	    #[must_use]
    79	    pub fn use_on_release(&self, item_id: u16, stack: &ItemStack) -> bool {
    80	        self.get_pumpkin_item(item_id)
    81	            .is_some_and(|behaviour| behaviour.use_on_release(stack))
    82	    }
    83	
    84	    /// Returns the item's use duration in ticks, as defined by its registered behaviour.
    85	    /// Returns `None` if the item has no registered behaviour or its duration is 0.
    86	    #[must_use]
    87	    pub fn get_use_duration(&self, item_id: u16) -> Option<i32> {
    88	        self.get_pumpkin_item(item_id)
    89	            .map(|b| b.get_use_duration())
    90	            .filter(|&d| d > 0)
    91	    }
    92	

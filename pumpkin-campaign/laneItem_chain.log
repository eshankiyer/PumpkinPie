   144	        let pumpkin_item = self.get_pumpkin_item(stack.item.id);
   145	        if let Some(pumpkin_item) = pumpkin_item {
   146	            pumpkin_item.use_on_entity(stack, player, entity).await;
   147	        }
   148	
   149	        if let Some(cooldown) = cooldown {

   299	   public ItemUseAnimation getUseAnimation(final ItemStack itemStack) {
   300	      Consumable consumable = itemStack.get(DataComponents.CONSUMABLE);
   301	      if (consumable != null) {
   302	         return consumable.animation();
   303	      } else if (itemStack.has(DataComponents.BLOCKS_ATTACKS)) {
   304	         return ItemUseAnimation.BLOCK;
   305	      } else {
   306	         return itemStack.has(DataComponents.KINETIC_WEAPON) ? ItemUseAnimation.SPEAR : ItemUseAnimation.NONE;
   307	      }
   308	   }

   896	    /// Determines the mining speed for a block based on tool rules.
   897	    /// Direct matches return immediately, tagged blocks are checked separately.
   898	    /// If no match is found, returns the tool's default mining speed or `1.0`.
   899	    #[must_use]
   900	    pub fn get_speed(&self, block: &'static Block) -> f32 {
   901	        // No tool? Use default speed
   902	        if let Some(tool) = self.get_data_component::<ToolImpl>() {
   903	            for rule in tool.rules.iter() {
   904	                // Skip if speed is not set
   905	                let Some(speed) = rule.speed else {
   906	                    continue;
   907	                };
   908	                match &rule.blocks {
   909	                    IDSet::Tag(tag) => {
   910	                        if block.is_tagged_with(tag).unwrap_or(false) {
   911	                            return speed;
   912	                        }
   913	                    }
   914	                    IDSet::IDs(blocks) => {
   915	                        if blocks.contains(&block) {
   916	                            return speed;
   917	                        }
   918	                    }
   919	                }
   920	            }
   921	            tool.default_mining_speed
   922	        } else {
   923	            1.0
   924	        }
   925	    }

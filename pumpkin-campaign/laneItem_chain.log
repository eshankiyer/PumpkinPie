    #[test]
    fn hash() {
        assert_eq!(get_str_hash("minecraft:sharpness"), 2734053906u32);
        assert_eq!(get_i32_hash(3), 3795317917u32);
        assert_eq!(
            EnchantmentsImpl {
                enchantment: Cow::Borrowed(&[(&crate::Enchantment::SHARPNESS, 2)]),

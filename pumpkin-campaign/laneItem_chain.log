                                }
                                player.inventory.set_held_item(held).await;
                                handled = true;
                            }

                            if !handled {
                                // Check off-hand
                                let mut off_hand = player.inventory.off_hand_item().await;
                                if off_hand.are_items_and_components_equal(item) {

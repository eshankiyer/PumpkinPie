   239	    pub(crate) fn shape_offset_delta(&self, pos: &BlockPos) -> Vector3<f64> {
   240	        let Some(shape_offset) = self.shape_offset() else {
   241	            return Vector3::new(0.0, 0.0, 0.0);
   242	        };
   243	
   244	        let seed = hash_block_pos(pos.0.x, 0, pos.0.z) as u64;
   245	        let max_horizontal = f64::from(shape_offset.max_horizontal);
   246	        let x = (f64::from((seed & 15) as f32 / 15.0) - 0.5) * 0.5;
   247	        let x = x.clamp(-max_horizontal, max_horizontal);
   248	        let z = (f64::from(((seed >> 8) & 15) as f32 / 15.0) - 0.5) * 0.5;
   249	        let z = z.clamp(-max_horizontal, max_horizontal);
   250	        let y = match shape_offset.offset_type {
   251	            ShapeOffsetType::Xz => 0.0,
   252	            ShapeOffsetType::Xyz => {
   253	                (f64::from(((seed >> 4) & 15) as f32 / 15.0) - 1.0)
   254	                    * f64::from(shape_offset.max_vertical)
   255	            }
   256	        };
   257	
   258	        // Extracted shapes are sampled at BlockPos::ZERO, where vanilla uses the
   259	        // negative horizontal limits and, for XYZ offsets, the negative vertical
   260	        // limit. Return only the delta from that sample.
   261	        Vector3::new(
   262	            x + max_horizontal,
   263	            y + shape_offset.offset_type.origin_y(shape_offset.max_vertical),
   264	            z + max_horizontal,
   265	        )
   266	    }

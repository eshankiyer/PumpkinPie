    48	
    49	/// Helper struct to ensure the validity of BlockIds parsed from external sources.
    50	/// Every [`BlockId`] is guaranteed to correspond to a valid [`Block`].
    51	///
    52	/// Also enables [`Block`]-type pattern matching, even in const contexts:
    53	/// ```rs
    54	/// const fn to_waxed(block: &'static Block) -> Option<&'static Block> {
    55	///     match block.id {
    56	///         BlockId::COPPER_BLOCK => Some(Block::WAXED_COPPER_BLOCK),
    57	///         //...
    58	///         _ => None
    59	///     }
    60	/// }
    61	/// ```
    62	#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
    63	#[repr(transparent)]
    64	pub struct BlockId(u16);
    65	
    66	impl PartialEq<BlockId> for Block {
    67	    fn eq(&self, other: &BlockId) -> bool {
    68	        self.id == *other
    69	    }
    70	}
    71	
    72	impl PartialEq<Block> for BlockId {
    73	    fn eq(&self, other: &Block) -> bool {
    74	        *self == other.id
    75	    }
    76	}
    77	
    78	impl PartialEq for Block {
    79	    fn eq(&self, other: &Self) -> bool {
    80	        self.id == other.id
    81	    }
    82	}
    83	
    84	impl Eq for Block {}
    85	
    86	impl Hash for Block {
    87	    fn hash<H: Hasher>(&self, state: &mut H) {
    88	        self.id.hash(state);
    89	    }
    90	}
    91	
    92	impl Taggable for Block {
    93	    #[inline]
    94	    fn tag_key() -> RegistryKey {
    95	        RegistryKey::Block
    96	    }
    97	
    98	    #[inline]
    99	    fn registry_key(&self) -> &str {
   100	        self.name
   101	    }
   102	
   103	    #[inline]
   104	    fn registry_id(&self) -> u16 {
   105	        self.id.as_u16()
   106	    }
   107	}
   108	
   109	impl ToResourceLocation for &'static Block {
   110	    fn to_resource_location(&self) -> ResourceLocation {
   111	        format!("minecraft:{}", self.name)
   112	    }
   113	}
   114	
   115	impl FromResourceLocation for &'static Block {
   116	    fn from_resource_location(resource_location: &ResourceLocation) -> Option<Self> {
   117	        Block::from_registry_key(
   118	            resource_location
   119	                .strip_prefix("minecraft:")
   120	                .unwrap_or(resource_location),
   121	        )
   122	    }
   123	}

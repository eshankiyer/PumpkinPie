   108	            .unwrap_or_else(|| stack.item.registry_key.to_string());
   109	
   110	        if player.is_on_cooldown(&cooldown_group).await {
   111	            return;
   112	        }
   113	
   114	        let pumpkin_item = self.get_pumpkin_item(stack.item.id);
   115	        if let Some(pumpkin_item) = pumpkin_item {
   116	            pumpkin_item
   117	                .use_on_block(stack, player, location, face, cursor_pos, block, server)
   118	                .await;
   119	        }
   120	
   121	        if let Some(cooldown) = cooldown {
   122	            player

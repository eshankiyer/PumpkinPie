diff --git a/crates/pumpkin/src/net/java/play/pick_item.rs b/crates/pumpkin/src/net/java/play/pick_item.rs
index 740835f8a5df1f07e42fb067a943cc8a56e86d8e..7db1ce3f165b62c3c261b21b8309d7d7d846ca02

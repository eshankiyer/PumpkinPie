   583	impl EquippableImpl {
   584	    pub fn read_data(data: &NbtTag) -> Option<Self> {
   585	        let compound = data.extract_compound()?;
   586	        let slot = EquipmentSlot::get_from_name(compound.get_string("slot")?)?;
   587	        let asset_id = compound
   588	            .get_string("asset_id")
   589	            .map(|str| Cow::Owned(str.to_owned()));
   590	        let camera_overlay = compound
   591	            .get_string("camera_overlay")
   592	            .map(|str| Cow::Owned(str.to_owned()));
   593	        let dispensable = compound.get_bool("dispensable").unwrap_or(true);
   594	        let swappable = compound.get_bool("swappable").unwrap_or(true);
   595	        let damage_on_hurt = compound.get_bool("damage_on_hurt").unwrap_or(true);
   596	        let equip_on_interact = compound.get_bool("equip_on_interact").unwrap_or(false);
   597	        let can_be_sheared = compound.get_bool("can_be_sheared").unwrap_or(false);
   598	        let equip_sound = get_idor(compound, "equip_sound", Sound::ItemArmorEquipGeneric);
   599	        let shearing_sound = get_idor(compound, "shearing_sound_sound", Sound::ItemShearsSnip);
   600	        let allowed_entities = if let Some(nbt) = compound.get("allowed_entities") {
   601	            IDSet::<EntityType>::read(nbt)
   602	        } else {
   603	            None
   604	        };
   605	        Some(Self {
   606	            slot,
   607	            equip_sound,
   608	            asset_id,
   609	            camera_overlay,
   610	            allowed_entities,
   611	            dispensable,
   612	            swappable,
   613	            damage_on_hurt,
   614	            equip_on_interact,
   615	            can_be_sheared,
   616	            shearing_sound,
   617	        })
   618	    }
   619	}
   620	impl DataComponentImpl for EquippableImpl {
   621	    fn get_hash(&self) -> i32 {
   622	        let mut digest = Digest::new(Crc32Iscsi);
   623	        digest.update(&[16u8]);
   624	        digest.update(&get_i32_hash(self.slot.get_slot_index()).to_le_bytes());
   625	        digest.update(&get_idor_hash(&self.equip_sound).to_le_bytes());
   626	        if let Some(asset) = &self.asset_id {
   627	            digest.update(&[1u8]);
   628	            digest.update(&get_str_hash(asset).to_le_bytes());
   629	        }
   630	        if let Some(overlay) = &self.camera_overlay {
   631	            digest.update(&[2u8]);
   632	            digest.update(&get_str_hash(overlay).to_le_bytes());
   633	        }
   634	        if let Some(allowed_entities) = &self.allowed_entities {
   635	            digest.update(&[3u8]);
   636	            digest.update(&get_idset_hash(allowed_entities).to_le_bytes());
   637	        }
   638	        digest.update(&[self.dispensable as u8]);
   639	        digest.update(&[self.swappable as u8]);
   640	        digest.update(&[self.damage_on_hurt as u8]);
   641	        digest.update(&[self.equip_on_interact as u8]);
   642	        digest.update(&[self.can_be_sheared as u8]);
   643	        digest.update(&get_idor_hash(&self.shearing_sound).to_le_bytes());
   644	        digest.finalize() as i32
   645	    }
   646	    fn write_data(&self) -> NbtTag {
   647	        let mut compound = NbtCompound::new();
   648	        compound.put_string("slot", self.slot.to_name().to_string());
   649	        put_idor(&mut compound, "equip_sound", &self.equip_sound);
   650	        put_idor(&mut compound, "shearing_sound", &self.shearing_sound);
   651	        if let Some(asset_id) = &self.asset_id {
   652	            compound.put_string("asset_id", asset_id.to_string());
   653	        }
   654	        if let Some(camera_overlay) = &self.camera_overlay {
   655	            compound.put_string("camera_overlay", camera_overlay.to_string());
   656	        }
   657	        if let Some(allowed_entities) = &self.allowed_entities {
   658	            allowed_entities.write(&mut compound, "allowed_entities");
   659	        }
   660	        compound.put_bool("dispensable", self.dispensable);
   661	        compound.put_bool("swappable", self.swappable);
   662	        compound.put_bool("damage_on_hurt", self.damage_on_hurt);
   663	        compound.put_bool("equip_on_interact", self.equip_on_interact);
   664	        compound.put_bool("can_be_sheared", self.can_be_sheared);
   665	        NbtTag::Compound(compound)
   666	    }
   667	    default_impl!(Equippable);
   668	}

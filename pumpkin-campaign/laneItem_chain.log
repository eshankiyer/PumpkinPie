+
+            /// Returns the item registered for a block, defaulting to air when the block has no item form.
+            /// Mirrors `Item.byBlock` (`Item.java:130-133`).
+            #[must_use]
+            pub const fn by_block(block: &Block) -> &'static Self {
+                match Self::from_id(block.item_id) {
+                    Some(item) => item,
+                    None => &Self::AIR,
+                }
+            }

   152	                .await;
   153	        }
   154	    }
   155	
   156	    pub fn can_mine(&self, item: &Item, player: &Player) -> bool {
   157	        let pumpkin_block = self.get_pumpkin_item(item.id);
   158	        if let Some(pumpkin_block) = pumpkin_block {
   159	            return pumpkin_block.can_mine(player);
   160	        }
   161	        true
   162	    }

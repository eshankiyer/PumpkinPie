   258	   public boolean mineBlock(final ItemStack itemStack, final Level level, final BlockState state, final BlockPos pos, final LivingEntity owner) {
   259	      Tool tool = itemStack.get(DataComponents.TOOL);
   260	      if (tool == null) {
   261	         return false;
   262	      }
   263	
   264	      if (!level.isClientSide() && state.getDestroySpeed(level, pos) != 0.0F && tool.damagePerBlock() > 0) {
   265	         itemStack.hurtAndBreak(tool.damagePerBlock(), owner, EquipmentSlot.MAINHAND);
   266	      }
   267	
   268	      return true;
   269	   }

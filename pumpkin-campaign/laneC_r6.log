pub struct ComposterLikeProperties {
    pub r#level: u8,
}
impl BlockProperties for ComposterLikeProperties {
    fn to_index(&self) -> u16 {
        let (index, _) = [(self.r#level as u16, 9u16)]
            .iter()
            .fold((0, 1), |(curr, mul), &(val, count)| {
                (curr + val * mul, mul * count)

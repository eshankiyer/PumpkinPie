+            return false;
+        }
+
+        // Mark chunk as unsaved (dirty)
+        if let Some(Chunk::Level(level_chunk)) = &self.chunk {
+            level_chunk.mark_dirty();
+        }
+
+        let min_light_section = 0; // TODO: get from light engine config
+        let max_light_section = self.changed_blocks_per_section.len().saturating_sub(1) as i32;
+        if chunk_y >= min_light_section && chunk_y <= max_light_section {
+            let index = (chunk_y - min_light_section) as usize;
+            let filter = match layer {
+                LightLayer::Sky => &mut self.sky_changed_light_section_filter,
+                LightLayer::Block => &mut self.block_changed_light_section_filter,
+            };
+            if !filter.contains(&index) {
+                filter.insert(index);
+                return true;
+            }
+        }
+        false
+    }

+    #[test]
+    fn encompassing_creates_union_of_two_boxes() {
+        let a = BlockBox::new(0, 0, 0, 10, 10, 10);
+        let b = BlockBox::new(5, 5, 5, 15, 15, 15);
+        let combined = BlockBox::encompassing(&a, &b);
+        assert_eq!(combined.min, Vector3::new(0, 0, 0));
+        assert_eq!(combined.max, Vector3::new(15, 15, 15));
+    }
+
+    #[test]
+    fn encompassing_positions_creates_box_from_positions() {
+        let positions = [
+            BlockPos(Vector3::new(0, 0, 0)),
+            BlockPos(Vector3::new(10, 5, 3)),
+            BlockPos(Vector3::new(-2, 8, -1)),
+        ];
+        let boxed = BlockBox::encompassing_positions(positions).expect("non-empty");
+        assert_eq!(boxed.min, Vector3::new(-2, 0, -1));
+        assert_eq!(boxed.max, Vector3::new(10, 8, 3));
+    }
+
+    #[test]
+    fn encompassing_positions_empty_returns_none() {
+        let empty: [BlockPos; 0] = [];
+        assert!(BlockBox::encompassing_positions(empty).is_none());
+    }
+
+    #[test]
+    fn from_corners_orders_coordinates_correctly() {
+        let a = BlockPos(Vector3::new(10, 20, 30));
+        let b = BlockPos(Vector3::new(0, 5, 15));
+        let boxed = BlockBox::from_corners(&a, &b);
+        assert_eq!(boxed.min, Vector3::new(0, 5, 15));
+        assert_eq!(boxed.max, Vector3::new(10, 20, 30));
+    }
+
+    #[test]
+    fn infinite_spans_full_range() {
+        let inf = BlockBox::infinite();
+        assert_eq!(inf.min.x, i32::MIN);
+        assert_eq!(inf.min.y, i32::MIN);
+        assert_eq!(inf.min.z, i32::MIN);
+        assert_eq!(inf.max.x, i32::MAX);
+        assert_eq!(inf.max.y, i32::MAX);
+        assert_eq!(inf.max.z, i32::MAX);
+    }
+
+    #[test]
+    fn for_all_corners_visits_eight_corners() {
+        let boxed = BlockBox::new(0, 0, 0, 2, 2, 2);
+        let mut corners = Vec::new();
+        boxed.for_all_corners(|c| corners.push(c));
+        assert_eq!(corners.len(), 8);
+        // Check all 8 combinations of min/max
+        let expected = [
+            Vector3::new(2, 2, 2),
+            Vector3::new(0, 2, 2),
+            Vector3::new(2, 0, 2),
+            Vector3::new(0, 0, 2),
+            Vector3::new(2, 2, 0),
+            Vector3::new(0, 2, 0),
+            Vector3::new(2, 0, 0),
+            Vector3::new(0, 0, 0),
+        ];
+        for e in expected {
+            assert!(corners.iter().any(|c| c.0 == e), "missing corner {e:?}");
+        }
+    }
+

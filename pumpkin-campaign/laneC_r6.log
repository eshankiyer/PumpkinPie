+        assert!(chunks.contains(&Vector2::new(1, 0)));
+
+        // Negative coordinates
+        let boxed = BlockBox::new(-16, 0, -16, -1, 0, -1);
+        let chunks: Vec<_> = boxed.intersecting_chunks().collect();
+        assert_eq!(chunks.len(), 1);
+        assert_eq!(chunks[0], Vector2::new(-1, -1));
+    }

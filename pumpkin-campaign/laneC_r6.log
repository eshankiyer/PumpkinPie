+/// Vanilla `LecternBlockEntity.stillValid` (`LecternBlockEntity.java:95-97` /
+/// `Container.java:94-101`): true if the block entity still exists at its position,
+/// the player is within interaction range (block interaction range + 4.0), and the
+/// lectern has a book.
+pub fn still_valid(&self, player: &crate::entity::player::Player, world: &crate::world::World) -> bool {
+    // Check if block entity still exists at this position
+    if world.get_block_entity(self.position).is_none_or(|be| {
+        be.as_any().downcast_ref::<Self>().is_none_or(|le| std::ptr::eq(le, self) == false)
+    }) {
+        return false;
+    }
+
+    // Check player distance (block interaction range + 4.0)
+    let d = player.block_interaction_range() + 4.0;
+    let box_pos = pumpkin_util::math::boundingbox::BoundingBox::from_block(self.position);
+    let entity_pos = player.living_entity.entity.pos.load();
+    let eye_height = player.living_entity.entity.get_eye_height();
+    box_pos.squared_magnitude(pumpkin_util::math::vector3::Vector3 {
+        x: entity_pos.x,
+        y: entity_pos.y + eye_height,
+        z: entity_pos.z,
+    }) < d * d
+        // Check has book
+        && self.has_book().await
+}

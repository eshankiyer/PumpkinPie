+    /// Marks a block as changed in this chunk.
+    /// `ChunkHolder.blockChanged` (`ChunkHolder.java:123-140`).
+    pub fn block_changed(&mut self, block_pos: &crate::math::position::BlockPos) -> bool {
+        let chunk = self.chunk.as_ref().and_then(|c| match c {
+            Chunk::Level(level_chunk) => Some(level_chunk.as_ref()),
+            Chunk::Proto(_) => None,
+        });
+        if chunk.is_none() {
+            return false;
+        }
+
+        let had_changed_sections = self.has_changed_sections;
+        let section_index = chunk_section_index(block_pos.0.y);
+
+        // Ensure the vector is large enough
+        if section_index >= self.changed_blocks_per_section.len() {
+            self.changed_blocks_per_section.resize(section_index + 1, None);
+        }
+
+        let changed_blocks = self.changed_blocks_per_section[section_index].get_or_insert_with(FxHashSet::default);
+        let packed = pack_local_chunk_section(block_pos);
+        changed_blocks.insert(packed);
+
+        !had_changed_sections
+    }

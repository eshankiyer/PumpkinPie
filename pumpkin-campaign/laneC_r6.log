+    /// Clears or counts items matching a predicate.
+    ///
+    /// Mirrors `ContainerHelper.clearOrCountMatchingItems` usage in
+    /// `Inventory.clearOrCountMatchingItems` (`Inventory.java:180-192`).
+    fn clear_or_count_matching_items<'a>(
+        &'a self,
+        predicate: &'a (dyn Fn(&ItemStack) -> bool + Sync),
+        amount_to_remove: i32,
+        counting_only: bool,
+    ) -> InventoryFuture<'a, i32> {
+        Box::pin(async move {
+            let mut count = 0;
+            for i in 0..self.size() {
+                let stack = self.get_stack(i).await;
+                if stack.is_empty() || !predicate(&stack) {
+                    continue;
+                }
+                if counting_only {
+                    count += stack.item_count as i32;
+                } else {
+                    let remove_count = (stack.item_count as i32).min(amount_to_remove - count);
+                    if remove_count >= stack.item_count as i32 {
+                        self.remove_stack(i).await;
+                    } else {
+                        let mut new_stack = stack.clone();
+                        new_stack.decrement(remove_count as u8);
+                        self.set_stack(i, new_stack).await;
+                    }
+                    count += remove_count;
+                }
+                if count >= amount_to_remove && amount_to_remove > 0 {
+                    break;
+                }
+            }
+            count
+        })
+    }
+
     fn as_any(&self) -> &dyn Any;
 }
 

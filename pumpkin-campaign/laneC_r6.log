+    fn intersecting_chunks_returns_correct_chunks() {
+        // Box from (0,0,0) to (15,0,15) - exactly one chunk
+        let boxed = BlockBox::new(0, 0, 0, 15, 0, 15);
+        let chunks: Vec<_> = boxed.intersecting_chunks().collect();
+        assert_eq!(chunks.len(), 1);
+        assert_eq!(chunks[0], Vector2::new(0, 0));
+
+        // Box spanning two chunks in X
+        let boxed = BlockBox::new(0, 0, 0, 31, 0, 15);

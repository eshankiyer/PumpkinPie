+/// Vanilla `EnderDragon.onSyncedDataUpdated` (`EnderDragon.java:824-831`).
+/// Updates the client-side phase when the phase data watcher changes.
+pub async fn on_synced_data_updated(&self, accessor: &crate::entity::tracked_data::DataAccessor) {
+    // In Pumpkin, the phase is synced via the EntityData system.
+    // When the phase data changes on the client, we update the phase manager.
+    if *accessor == crate::entity::tracked_data::mob::DATA_MOB_FLAGS_ID {
+        // Phase is stored in the entity data; update local phase manager if on client
+        let phase_id = self.mob_entity.living_entity.entity.get_entity_data().get(accessor);
+        if let Some(phase_id) = phase_id.as_i32() {
+            if let Some(phase) = EnderDragonPhase::from_ordinal(phase_id) {
+                *self.phase.lock().await = phase;
+            }
+        }
+    }
+}

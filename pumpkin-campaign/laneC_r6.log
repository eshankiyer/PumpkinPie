+    /// Detects the structure size by finding corner structure blocks.
+    ///
+    /// Mirrors `StructureBlockEntity.detectSize` (`StructureBlockEntity.java:264-289`):
+    /// scans for corner structure blocks with the same name in SAVE mode and calculates
+    /// the enclosing bounding box to determine structure position and size.
+    pub async fn detect_size(&self, world: &Arc<World>) -> bool {
+        let mode = self.mode.lock().await.clone();
+        if mode != "SAVE" {
+            return false;
+        }
+
+        let name = self.name.lock().await.clone();
+        if name.is_empty() {
+            return false;
+        }
+
+        let pos = self.position;
+        let min_y = world.get_min_y();
+        let max_y = world.get_max_y();
+
+        let corner1 = BlockPos::new(pos.0.x - 80, min_y, pos.0.z - 80);
+        let corner2 = BlockPos::new(pos.0.x + 80, max_y, pos.0.z + 80);
+
+        let related_corners = self.get_related_corners(world, corner1, corner2, &name).await;
+        if let Some(bb) = Self::calculate_enclosing_bounding_box(pos, related_corners) {
+            let delta_x = bb.max_x - bb.min_x;
+            let delta_y = bb.max_y - bb.min_y;
+            let delta_z = bb.max_z - bb.min_z;
+
+            if delta_x > 1 && delta_y > 1 && delta_z > 1 {
+                let structure_pos = BlockPos::new(
+                    bb.min_x - pos.0.x + 1,
+                    bb.min_y - pos.0.y + 1,
+                    bb.min_z - pos.0.z + 1,
+                );
+                let structure_size = Vector3::new(delta_x - 1, delta_y - 1, delta_z - 1);
+
+                *self.pos_x.lock().await = structure_pos.0.x;
+                *self.pos_y.lock().await = structure_pos.0.y;
+                *self.pos_z.lock().await = structure_pos.0.z;
+                *self.size_x.lock().await = structure_size.x;
+                *self.size_y.lock().await = structure_size.y;
+                *self.size_z.lock().await = structure_size.z;
+
+                // Mark block entity as changed and send block update
+                self.mark_dirty();
+                if let Some(chunk) = world.get_chunk_at_block_pos(&pos) {
+                    chunk.set_dirty();
+                }
+                world.update_block(pos).await;
+                return true;
+            }
+        }
+        false
+    }
+
+    async fn get_related_corners(
+        &self,
+        world: &Arc<World>,
+        corner1: BlockPos,
+        corner2: BlockPos,
+        name: &str,
+    ) -> Vec<BlockPos> {
+        let mut corners = Vec::new();
+        // Iterate through the region between corner1 and corner2
+        for x in corner1.0.x..=corner2.0.x {
+            for y in corner1.0.y..=corner2.0.y {
+                for z in corner1.0.z..=corner2.0.z {
+                    let pos = BlockPos::new(x, y, z);
+                    if let Some(block_state) = world.get_block_state(&pos).await {
+                        let block = Block::from_state_id(block_state.id);
+                        if block.name == "structure_block" {
+                            if let Some(be) = world.get_block_entity(&pos).await {
+                                if let Some(sb) = be.as_any().downcast_ref::<StructureBlockBlockEntity>() {
+                                    let other_mode = sb.mode.lock().await.clone();
+                                    let other_name = sb.name.lock().await.clone();
+                                    if other_mode == "CORNER" && other_name == name {
+                                        corners.push(pos);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        corners
+    }
+
+    fn calculate_enclosing_bounding_box(
+        pos: BlockPos,
+        corners: Vec<BlockPos>,
+    ) -> Option<BoundingBox> {
+        if corners.is_empty() {
+            return None;
+        }
+        let mut min_x = corners[0].0.x;
+        let mut min_y = corners[0].0.y;
+        let mut min_z = corners[0].0.z;
+        let mut max_x = corners[0].0.x;
+        let mut max_y = corners[0].0.y;
+        let mut max_z = corners[0].0.z;
+
+        for corner in &corners[1..] {
+            min_x = min_x.min(corner.0.x);
+            min_y = min_y.min(corner.0.y);
+            min_z = min_z.min(corner.0.z);
+            max_x = max_x.max(corner.0.x);
+            max_y = max_y.max(corner.0.y);
+            max_z = max_z.max(corner.0.z);
+        }
+
+        // Also encapsulate the structure block position itself if only one corner
+        if corners.len() == 1 {
+            min_x = min_x.min(pos.0.x);
+            min_y = min_y.min(pos.0.y);
+            min_z = min_z.min(pos.0.z);
+            max_x = max_x.max(pos.0.x);
+            max_y = max_y.max(pos.0.y);
+            max_z = max_z.max(pos.0.z);
+        }
+
+        Some(BoundingBox::new(min_x, min_y, min_z, max_x, max_y, max_z))
+    }
+
+    /// Checks if the structure is loadable (exists in the template manager).
+    ///
+    /// Mirrors `StructureBlockEntity.isStructureLoadable` (`StructureBlockEntity.java:440-453`):
+    /// returns true if in LOAD mode, not client-side, has a structure name, and the template
+    /// exists in the structure manager.
+    pub async fn is_structure_loadable(&self, world: &Arc<World>) -> bool {
+        let mode = self.mode.lock().await.clone();
+        if mode != "LOAD" {
+            return false;
+        }
+
+        let name = self.name.lock().await.clone();
+        if name.is_empty() {
+            return false;
+        }
+
+        // Check if template exists in global cache
+        let lookup_name = name.strip_prefix("minecraft:").unwrap_or(&name);
+        global_cache().get(lookup_name).is_some()
+    }
+
+    /// Places the structure if the template size matches the configured size.
+    ///
+    /// Mirrors `StructureBlockEntity.placeStructureIfSameSize` (`StructureBlockEntity.java:369-384`):
+    /// loads the template, compares sizes, and places if they match; otherwise loads
+    /// structure info from the template.
+    pub async fn place_structure_if_same_size(&self, world: &Arc<World>) -> bool {
+        let mode = self.mode.lock().await.clone();
+        if mode != "LOAD" {
+            return false;
+        }
+
+        let name = self.name.lock().await.clone();
+        if name.is_empty() {
+            return false;
+        }
+
+        let lookup_name = name.strip_prefix("minecraft:").unwrap_or(&name);
+        let Some(template) = global_cache().get(lookup_name) else {
+            return false;
+        };
+
+        let size_x = *self.size_x.lock().await;
+        let size_y = *self.size_y.lock().await;
+        let size_z = *self.size_z.lock().await;
+
+        if template.size.x == size_x && template.size.y == size_y && template.size.z == size_z {
+            self.place_structure(world).await;
+            true
+        } else {
+            self.load_structure_info(&template).await;
+            false
+        }
+    }
 }
 

+    /// `BoundingBox.encapsulating` (`levelgen/structure/BoundingBox.java:161-170`): creates a
+    /// box encompassing two boxes.
+    #[must_use]
+    pub const fn encompassing(a: &Self, b: &Self) -> Self {
+        Self {
+            min: Vector3::new(
+                a.min.x.min(b.min.x),
+                a.min.y.min(b.min.y),
+                a.min.z.min(b.min.z),
+            ),
+            max: Vector3::new(
+                a.max.x.max(b.max.x),
+                a.max.y.max(b.max.y),
+                a.max.z.max(b.max.z),
+            ),
+        }
+    }
+
+    /// `BoundingBox.encapsulatingPositions` (`levelgen/structure/BoundingBox.java:127-136`):
+    /// creates a box encompassing all given positions.
+    #[must_use]
+    pub fn encompassing_positions<I>(positions: I) -> Option<Self>
+    where
+        I: IntoIterator<Item = BlockPos>,
+    {
+        let mut iter = positions.into_iter();
+        let first = iter.next()?;
+        let mut result = Self::from_pos(first);
+        for pos in iter {
+            result.encompass(&Self::from_pos(pos));
+        }
+        Some(result)
+    }
+
+    /// `BoundingBox.fromCorners` (`levelgen/structure/BoundingBox.java:66-75`): creates a box
+    /// from two corner positions.
+    #[must_use]
+    pub const fn from_corners(a: &BlockPos, b: &BlockPos) -> Self {
+        Self {
+            min: Vector3::new(
+                a.0.x.min(b.0.x),
+                a.0.y.min(b.0.y),
+                a.0.z.min(b.0.z),
+            ),
+            max: Vector3::new(
+                a.0.x.max(b.0.x),
+                a.0.y.max(b.0.y),
+                a.0.z.max(b.0.z),
+            ),
+        }
+    }
+
+    /// `BoundingBox.infinite` (`levelgen/structure/BoundingBox.java:77-79`): creates an infinite
+    /// box spanning the entire coordinate range.
+    #[must_use]
+    pub const fn infinite() -> Self {
+        Self {
+            min: Vector3::new(i32::MIN, i32::MIN, i32::MIN),
+            max: Vector3::new(i32::MAX, i32::MAX, i32::MAX),
+        }
+    }
+
+    /// `BoundingBox.forAllCorners` (`levelgen/structure/BoundingBox.java:241-251`): calls the
+    /// closure for each of the 8 corners.
+    pub fn for_all_corners<F>(&self, mut f: F)
+    where
+        F: FnMut(BlockPos),
+    {
+        f(BlockPos(Vector3::new(self.max.x, self.max.y, self.max.z)));
+        f(BlockPos(Vector3::new(self.min.x, self.max.y, self.max.z)));
+        f(BlockPos(Vector3::new(self.max.x, self.min.y, self.max.z)));
+        f(BlockPos(Vector3::new(self.min.x, self.min.y, self.max.z)));
+        f(BlockPos(Vector3::new(self.max.x, self.max.y, self.min.z)));
+        f(BlockPos(Vector3::new(self.min.x, self.max.y, self.min.z)));
+        f(BlockPos(Vector3::new(self.max.x, self.min.y, self.min.z)));
+        f(BlockPos(Vector3::new(self.min.x, self.min.y, self.min.z)));
+    }
+
+    /// `BoundingBox.moved` (`levelgen/structure/BoundingBox.java:199-201`): returns a new box

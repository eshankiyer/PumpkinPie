+/// Vanilla `EnderDragon.tickDeath` (`EnderDragon.java:510-558`).
+/// Handles the dragon death animation and XP drops.
+pub async fn tick_death(&self, caller: &Arc<dyn EntityBase>) {
+    let mut death_time = self.dragon_death_time.lock().await;
+    *death_time += 1;
+    let death_time = *death_time;
+
+    let world = self.mob_entity.living_entity.entity.world.load();
+
+    // Particles during death
+    if death_time >= 180 && death_time <= 200 {
+        let xo = (rand::random::<f32>() - 0.5) * 8.0;
+        let yo = (rand::random::<f32>() - 0.5) * 4.0;
+        let zo = (rand::random::<f32>() - 0.5) * 8.0;
+        world.add_particle(
+            pumpkin_data::particle::Particle::ExplosionEmitter,
+            self.mob_entity.living_entity.entity.pos.load().x + xo as f64,
+            self.mob_entity.living_entity.entity.pos.load().y + 2.0 + yo as f64,
+            self.mob_entity.living_entity.entity.pos.load().z + zo as f64,
+            0.0, 0.0, 0.0,
+        ).await;
+    }
+
+    // XP drops
+    let xp_count = if let Some(ref fight_mutex) = world.dragon_fight {
+        let fight = fight_mutex.lock().await;
+        if !fight.has_previously_killed_dragon() {
+            12000
+        } else {
+            500
+        }
+    } else {
+        500
+    };
+
+    if let Some(ref level) = world.as_server_level() {
+        if death_time > 150 && death_time % 5 == 0 && level.game_rules.mob_drops {
+            crate::entity::experience_orb::award(level, self.mob_entity.living_entity.entity.pos.load(), (xp_count as f32 * 0.08) as i32);
+        }
+
+        if death_time == 1 {
+            level.global_level_event(1028, self.mob_entity.living_entity.entity.block_pos.load(), 0);
+        }
+    }
+
+    // Move upward slowly
+    let death_move = Vector3::new(0.0, 0.1, 0.0);
+    self.mob_entity.living_entity.entity.move_entity(death_move).await;
+
+    // Move parts
+    for part in &self.parts {
+        part.entity.set_pos(part.entity.pos.load() + death_move);
+        part.entity.set_old_pos_and_rot();
+    }
+
+    // Final cleanup
+    if death_time >= 200 {
+        if let Some(ref level) = world.as_server_level() {
+            if level.game_rules.mob_drops {
+                crate::entity::experience_orb::award(level, self.mob_entity.living_entity.entity.pos.load(), (xp_count as f32 * 0.2) as i32);
+            }
+
+            if let Some(ref fight_mutex) = world.dragon_fight {
+                let fight = fight_mutex.lock().await;
+                fight.set_dragon_killed(self).await;
+            }
+        }
+
+        self.mob_entity.living_entity.entity.remove().await;
+        // Game event handled by remove
+    }
+}

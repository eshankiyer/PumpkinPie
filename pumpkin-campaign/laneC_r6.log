+        let b = BlockBox::new(1, 2, 3, 4, 5, 6);
+        let c = BlockBox::new(0, 0, 0, 0, 0, 0);
+        assert_eq!(a, b);
+        assert_ne!(a, c);
+
+        use std::collections::HashSet;
+        let mut set = HashSet::new();
+        set.insert(a);
+        set.insert(b); // duplicate
+        set.insert(c);
+        assert_eq!(set.len(), 2);
+    }

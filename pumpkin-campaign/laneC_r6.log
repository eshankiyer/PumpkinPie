+    }
+
+    match &self.cost_b {
+        None => buy_b.is_empty(),
+        Some(cost_b) => cost_b.0.test(buy_b) && buy_b.count() >= cost_b.0.count() as u32,
+    }
+}
+
+/// Vanilla `MerchantOffer::take` (`MerchantOffer.java:221-232`).
+/// Returns true if the trade was successful and shrinks the input stacks.
+pub fn take(&self, buy_a: &mut pumpkin_data::item_stack::ItemStack, buy_b: &mut pumpkin_data::item_stack::ItemStack) -> bool {
+    if !self.satisfied_by(buy_a, buy_b) {
+        return false;
+    }
+
+    let base_count = self.base_cost_a.0.count() as i32;
+    let modified_count = Self::modified_cost_count(
+        base_count,
+        self.demand,
+        self.price_multiplier,
+        self.special_price,
+        self.base_cost_a.0.max_stack_size() as i32,
+    );
+    buy_a.shrink(modified_count as u32);
+
+    if let Some(cost_b) = &self.cost_b {
+        if !cost_b.0.is_empty() {
+            buy_b.shrink(cost_b.0.count() as u32);
+        }
+    }
+
+    true
+}

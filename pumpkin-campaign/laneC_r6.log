+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::entity::Entity;
+    use pumpkin_data::entity::EntityType;
+    use pumpkin_data::{BlockDirection, World};
+    use std::sync::Arc;
+
+    fn make_frame(facing: BlockDirection) -> ItemFrameEntity {
+        let world = Arc::new(World::new_for_testing());
+        let entity = Entity::new(world, Default::default(), &EntityType::ITEM_FRAME);
+        let frame = ItemFrameEntity::new(entity);
+        frame.set_facing(facing);
+        frame
+    }
+
+    #[test]
+    fn visual_rotation_south_zero_rotation() {
+        let frame = make_frame(BlockDirection::South);
+        // 180 + 0*90 + 0*45 + 0 = 180
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 180.0);
+    }
+
+    #[test]
+    fn visual_rotation_south_rotation_1() {
+        let frame = make_frame(BlockDirection::South);
+        frame.rotation.store(1, Ordering::Relaxed);
+        // 180 + 0*90 + 1*45 + 0 = 225
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 225.0);
+    }
+
+    #[test]
+    fn visual_rotation_west_zero_rotation() {
+        let frame = make_frame(BlockDirection::West);
+        // 180 + 1*90 + 0*45 + 0 = 270
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 270.0);
+    }
+
+    #[test]
+    fn visual_rotation_north_zero_rotation() {
+        let frame = make_frame(BlockDirection::North);
+        // 180 + 2*90 + 0*45 + 0 = 360 -> wrap to 0
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 0.0);
+    }
+
+    #[test]
+    fn visual_rotation_east_zero_rotation() {
+        let frame = make_frame(BlockDirection::East);
+        // 180 + 3*90 + 0*45 + 0 = 450 -> wrap to 90
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 90.0);
+    }
+
+    #[test]
+    fn visual_rotation_up_zero_rotation() {
+        let frame = make_frame(BlockDirection::Up);
+        // 180 + 0*90 + 0*45 + 90 = 270
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 270.0);
+    }
+
+    #[test]
+    fn visual_rotation_down_zero_rotation() {
+        let frame = make_frame(BlockDirection::Down);
+        // 180 + 0*90 + 0*45 - 90 = 90
+        assert_eq!(frame.get_visual_rotation_y_in_degrees(), 90.0);
+    }
+}


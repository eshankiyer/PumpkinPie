+/// Vanilla `MerchantOffer::getCostA` (`MerchantOffer.java:119-121`).
+/// Returns the cost A with demand and special price applied.
+#[must_use]
+pub fn cost_a(&self) -> ItemStackSerializer<'static> {
+    let base_count = self.base_cost_a.0.count() as i32;
+    let modified_count = Self::modified_cost_count(
+        base_count,
+        self.demand,
+        self.price_multiplier,
+        self.special_price,
+        self.base_cost_a.0.max_stack_size() as i32,
+    );
+    let mut stack = (*self.base_cost_a.0).clone();
+    stack.set_count(modified_count as u8);
+    ItemStackSerializer(std::borrow::Cow::Owned(stack))
+}

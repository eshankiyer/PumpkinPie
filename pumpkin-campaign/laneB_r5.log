     8	#[test]
     9	fn ensure_dependency_chain_builds_multistage_chain() {
    10	    let mut graph = DAG::default();
    11	    let mut queue = BinaryHeap::new();
    12	    let last_level: ChunkLevel = HashMapType::default();
    13	    let last_high_priority: Vec<ChunkPos> = Vec::new();
    14	
    15	    let chunk_pos = ChunkPos::new(0, 0);
    16	
    17	    // Create a dependency node in the graph which will depend on the chain
    18	    let dependency_task = graph
    19	        .nodes
    20	        .insert(Node::new(ChunkPos::new(10, 10), StagedChunkEnum::Features));
    21	
    22	    let mut holder = ChunkHolder {
    23	        current_stage: StagedChunkEnum::None,
    24	        ..Default::default()
    25	    };
    26	
    27	    // Build a chain up to Surface (Empty -> ... -> Surface)
    28	    GenerationSchedule::ensure_dependency_chain(
    29	        &mut graph,
    30	        &mut queue,
    31	        &last_level,
    32	        &last_high_priority,
    33	        dependency_task,
    34	        chunk_pos,
    35	        &mut holder,
    36	        StagedChunkEnum::Surface,
    37	    );
    38	
    39	    let start = (holder.current_stage as usize + 1).max(StagedChunkEnum::Empty as usize);
    40	    let end = StagedChunkEnum::Surface as u8 as usize;
    41	
    42	    // Ensure tasks were created, present in the DAG, and correctly chained
    43	    for idx in start..=end {
    44	        let key = holder.tasks[idx];
    45	        assert!(!key.is_null(), "task {idx} was not created");
    46	
    47	        let node = graph.nodes.get(key).expect("graph missing node");
    48	
    49	        if idx == start {
    50	            assert_eq!(node.in_degree, 0, "Start task should have 0 in_degree");
    51	        } else {
    52	            assert_eq!(
    53	                node.in_degree, 1,
    54	                "Intermediate task {idx} should have in_degree of 1"
    55	            );
    56	        }
    57	    }
    58	
    59	    // The dependency node should have its in_degree incremented
    60	    let dep_node = graph.nodes.get(dependency_task).unwrap();
    61	    assert_eq!(dep_node.in_degree, 1);
    62	
    63	    // The entry task should have been queued
    64	    let queued = queue.pop().expect("queue should have entry task");
    65	    assert_eq!(queued.node_key(), holder.tasks[start]);
    66	}

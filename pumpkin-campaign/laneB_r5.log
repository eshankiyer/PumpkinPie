   184	    fn apply_lighting_override(&self, chunk: &SyncChunk) {
   185	        match self.lighting_config {
   186	            LightingEngineConfig::Full => {
   187	                let mut engine = chunk
   188	                    .light_engine
   189	                    .lock()
   190	                    .unwrap_or_else(std::sync::PoisonError::into_inner);
   191	                for section in &mut engine.block_light {
   192	                    section.fill(15);
   193	                }
   194	                for section in &mut engine.sky_light {
   195	                    section.fill(15);
   196	                }
   197	                chunk.dirty.store(true, Relaxed);
   198	            }
   199	            LightingEngineConfig::Dark => {
   200	                let mut engine = chunk
   201	                    .light_engine
   202	                    .lock()
   203	                    .unwrap_or_else(std::sync::PoisonError::into_inner);
   204	                for section in &mut engine.block_light {
   205	                    section.fill(0);
   206	                }
   207	                for section in &mut engine.sky_light {
   208	                    section.fill(0);
   209	                }
   210	                chunk.dirty.store(true, Relaxed);
   211	            }
   212	            LightingEngineConfig::Default => {}
   213	        }
   214	    }
   215	
   216	    fn calc_priority(
   217	        last_level: &ChunkLevel,
   218	        last_high_priority: &[ChunkPos],
   219	        pos: ChunkPos,
   220	        stage: StagedChunkEnum,
   221	    ) -> i8 {
   222	        let base_level = *last_level.get(&pos).unwrap_or(&ChunkLoading::MAX_LEVEL);
   223	        if base_level == ChunkLoading::MAX_LEVEL {
   224	            return 127;
   225	        }
   226	        if last_high_priority.is_empty() {
   227	            return base_level + (stage as i8);
   228	        }
   229	        let mut min_dst = i32::MAX;
   230	        for i in last_high_priority {
   231	            let dst = max((i.x - pos.x).abs(), (i.y - pos.y).abs());
   232	            min_dst = min_dst.min(dst);
   233	            if dst <= StagedChunkEnum::FULL_RADIUS
   234	                && stage <= StagedChunkEnum::FULL_DEPENDENCIES[dst as usize]
   235	            {
   236	                return base_level + (stage as i8) - 100 + (dst as i8);
   237	            }
   238	        }
   239	        base_level + (stage as i8) + (min_dst.min(60) as i8)
   240	    }
   241	
   242	    fn sort_queue(&mut self) {
   243	        if self.queue.is_empty() {
   244	            return;
   245	        }
   246	        let mut tasks: Vec<_> = self.queue.drain().collect();
   247	        for i in &mut tasks {
   248	            if let Some(node) = self.graph.nodes.get(i.1) {
   249	                i.0 = Self::calc_priority(
   250	                    &self.last_level,
   251	                    &self.last_high_priority,
   252	                    node.pos,
   253	                    node.stage,
   254	                );
   255	            }
   256	        }
   257	        self.queue = BinaryHeap::from(tasks);
   258	    }

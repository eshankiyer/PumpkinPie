    55	impl DragonRespawnStage {
    56	    /// Advance through the respawn animation.  Returns `true` when the stage
    57	    /// has completed and the caller should advance to the next one.
    58	    #[must_use]
    59	    pub const fn tick(&self, time: i32) -> bool {
    60	        match self {
    61	            Self::Start => time >= 100,
    62	            Self::Preparing => time >= 80,
    63	            Self::End => time >= 20,
    64	        }
    65	    }
    66	}

   313	   private void setupAnimationStates() {
   314	      switch (this.getState()) {
   315	         case IDLE:
   316	            this.interactionGetNoItemAnimationState.stop();
   317	            this.interactionGetItemAnimationState.stop();
   318	            this.interactionDropItemAnimationState.stop();
   319	            this.interactionDropNoItemAnimationState.stop();
   320	            if (this.idleAnimationStartTick == this.tickCount) {
   321	               this.idleAnimationState.start(this.tickCount);
   322	            } else if (this.idleAnimationStartTick == 0) {
   323	               this.idleAnimationStartTick = this.tickCount + this.random.nextInt(200, 240);
   324	            }
   325	
   326	            if (this.tickCount == this.idleAnimationStartTick + 10.0F) {
   327	               this.playHeadSpinSound();
   328	               this.idleAnimationStartTick = 0;
   329	            }
   330	            break;
   331	         case GETTING_ITEM:
   332	            this.idleAnimationState.stop();
   333	            this.idleAnimationStartTick = 0;
   334	            this.interactionGetNoItemAnimationState.stop();
   335	            this.interactionDropItemAnimationState.stop();
   336	            this.interactionDropNoItemAnimationState.stop();
   337	            this.interactionGetItemAnimationState.startIfStopped(this.tickCount);
   338	            break;
   339	         case GETTING_NO_ITEM:
   340	            this.idleAnimationState.stop();
   341	            this.idleAnimationStartTick = 0;
   342	            this.interactionGetItemAnimationState.stop();
   343	            this.interactionDropNoItemAnimationState.stop();
   344	            this.interactionDropItemAnimationState.stop();
   345	            this.interactionGetNoItemAnimationState.startIfStopped(this.tickCount);
   346	            break;
   347	         case DROPPING_ITEM:
   348	            this.idleAnimationState.stop();
   349	            this.idleAnimationStartTick = 0;
   350	            this.interactionGetItemAnimationState.stop();
   351	            this.interactionGetNoItemAnimationState.stop();
   352	            this.interactionDropNoItemAnimationState.stop();
   353	            this.interactionDropItemAnimationState.startIfStopped(this.tickCount);
   354	            break;
   355	         case DROPPING_NO_ITEM:
   356	            this.idleAnimationState.stop();
   357	            this.idleAnimationStartTick = 0;
   358	            this.interactionGetItemAnimationState.stop();
   359	            this.interactionGetNoItemAnimationState.stop();
   360	            this.interactionDropItemAnimationState.stop();
   361	            this.interactionDropNoItemAnimationState.startIfStopped(this.tickCount);
   362	      }
   363	   }

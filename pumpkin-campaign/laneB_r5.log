  2805	    fn push_by_fluid(&self, speed: f64, mut push: Vector3<f64>, n: usize) {
  2806	        if push.length_squared() != 0.0 {
  2807	            if n > 0 {
  2808	                push = push * (1.0 / (n as f64));
  2809	            }
  2810	
  2811	            if self.entity_type != &EntityType::PLAYER {
  2812	                push = push.normalize();
  2813	            }
  2814	
  2815	            push = push * speed;
  2816	
  2817	            let velo = self.velocity.load();
  2818	
  2819	            if velo.x.abs() < 0.003 && velo.z.abs() < 0.003 && velo.length_squared() < 0.000_020_25
  2820	            {
  2821	                push = push.normalize() * 0.0045;
  2822	            }
  2823	
  2824	            self.velocity.store(velo + push);
  2825	        }
  2826	    }

   783	   public Vec3 getHeadLookVector(final float a) {
   784	      DragonPhaseInstance phaseInstance = this.phaseManager.getCurrentPhase();
   785	      EnderDragonPhase<? extends DragonPhaseInstance> phase = phaseInstance.getPhase();
   786	      Vec3 result;
   787	      if (phase == EnderDragonPhase.LANDING || phase == EnderDragonPhase.TAKEOFF) {
   788	         BlockPos egg = this.level().getHeightmapPos(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES, EndPodiumFeature.getLocation(this.fightOrigin));
   789	         float dist = Math.max((float)Math.sqrt(egg.distToCenterSqr(this.position())) / 4.0F, 1.0F);
   790	         float yOffset = 6.0F / dist;
   791	         float xRotOld = this.getXRot();
   792	         float rotScale = 1.5F;
   793	         this.setXRot(-yOffset * 1.5F * 5.0F);
   794	         result = this.getViewVector(a);
   795	         this.setXRot(xRotOld);
   796	      } else if (phaseInstance.isSitting()) {
   797	         float xRotOld = this.getXRot();
   798	         float rotScale = 1.5F;
   799	         this.setXRot(-45.0F);
   800	         result = this.getViewVector(a);
   801	         this.setXRot(xRotOld);
   802	      } else {
   803	         result = this.getViewVector(a);
   804	      }
   805	
   806	      return result;
   807	   }

   294	    pub fn new(entity: Entity) -> Arc<Self> {
   295	        entity.no_clip.store(true, Ordering::Relaxed);
   296	        let base_id = entity.entity_id;
   297	        let dragon_uuid = entity.entity_uuid;
   298	        let world = entity.world.load();
   299	
   300	        let _ = Entity::reserve_ids(8);
   301	
   302	        let mut parts = Vec::new();
   303	        for i in 1..=8 {
   304	            let part_entity = Entity::from_uuid_with_id(
   305	                base_id + i,
   306	                uuid::Uuid::new_v4(),
   307	                world.clone(),
   308	                entity.pos.load(),
   309	                &EntityType::ENDER_DRAGON,
   310	            );
   311	            let part = Arc::new(EnderDragonPart::new(part_entity, dragon_uuid));
   312	            parts.push(part);
   313	        }
   314	
   315	        Arc::new(Self {
   316	            mob_entity: MobEntity::new(entity),
   317	            parts,
   318	            parts_registered: AtomicBool::new(false),
   319	            flight_history: Mutex::new(DragonFlightHistory::default()),
   320	            flap_time: Mutex::new(0.0),
   321	            o_flap_time: Mutex::new(0.0),
   322	            in_wall: Mutex::new(false),
   323	            dragon_death_time: Mutex::new(0),
   324	            sitting_damage_received: Mutex::new(0.0),
   325	            nodes_initialized: Mutex::new(false),
   326	            fight_origin: Mutex::new(BlockPos::new(0, 128, 0)),
   327	            phase_manager: PhaseManager::new(),
   328	            phase: Mutex::new(EnderDragonPhase::Circling),
   329	            growl_time: Mutex::new(GROWL_COOLDOWN_BASE),
   330	            yaw_rot_accel: Mutex::new(0.0),
   331	            holding_pattern_clockwise: Mutex::new(true),
   332	            target_location: Mutex::new(None),
   333	            fireball_charge: Mutex::new(0),
   334	            nodes: Mutex::new([None; NODE_COUNT]),
   335	            path: Mutex::new(Vec::new()),
   336	            target_node: Mutex::new(0),

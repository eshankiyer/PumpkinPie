   247	impl ScreenHandlerFactory for WanderingTraderEntity {
   248	    fn create_screen_handler<'a>(
   249	        &'a self,
   250	        sync_id: u8,
   251	        player_inventory: &'a Arc<pumpkin_inventory::player::player_inventory::PlayerInventory>,
   252	        player: &'a dyn InventoryPlayer,
   253	    ) -> BoxFuture<'a, Option<SharedScreenHandler>> {
   254	        Box::pin(async move {
   255	            let offers = self.offers.lock().await;
   256	            let self_weak = self.self_weak.lock().unwrap().clone().unwrap();
   257	
   258	            let mut handler = MerchantScreenHandler::new(
   259	                sync_id,
   260	                player_inventory,
   261	                self.merchant_inventory.clone(),
   262	                offers.clone(),
   263	            )
   264	            .await;
   265	
   266	            // `AbstractVillager.notifyTradeUpdated` (`AbstractVillager.java:152-157)`)
   267	            // calls the concrete `getTradeUpdatedSound` after the payment slots change,
   268	            // while suppressing repeats during the ambient-sound cooldown window.
   269	            let update_sound_weak = self_weak.clone();
   270	            handler.on_trade_updated = Some(Box::new(move |has_result| {
   271	                if let Some(trader) = update_sound_weak.upgrade() {
   272	                    let interval = trader.get_ambient_sound_interval();
   273	                    let current = trader.mob_entity.ambient_sound_time.load(Ordering::Relaxed);
   274	                    if current > -interval + 20
   275	                        && trader
   276	                            .mob_entity
   277	                            .ambient_sound_time
   278	                            .compare_exchange(
   279	                                current,
   280	                                -interval,
   281	                                Ordering::Relaxed,
   282	                                Ordering::Relaxed,
   283	                            )
   284	                            .is_ok()
   285	                    {
   286	                        trader.get_entity().play_sound(if has_result {
   287	                            Sound::EntityWanderingTraderYes
   288	                        } else {
   289	                            Sound::EntityWanderingTraderNo
   290	                        });
   291	                    }
   292	                }
   293	            }));
   294	
   295	            // `AbstractVillager.startTrading` sets `tradingPlayer`; `stopTrading` clears it.
   296	            // With it set, `isTrading()` suppresses despawn and `TradeWithPlayerGoal` holds
   297	            // the trader still (`WanderingTrader.java:79, 212`).
   298	            if let Some(server_player) = player.as_any().downcast_ref::<Player>() {
   299	                *self
   300	                    .trading_player
   301	                    .lock()
   302	                    .unwrap_or_else(std::sync::PoisonError::into_inner) =
   303	                    Some(server_player.get_entity().entity_uuid);
   304	            }
   305	            let close_weak = self_weak.clone();
   306	            handler.on_close = Some(Box::new(move || {
   307	                let close_weak = close_weak.clone();
   308	                Box::pin(async move {
   309	                    if let Some(trader) = close_weak.upgrade() {
   310	                        *trader
   311	                            .trading_player
   312	                            .lock()
   313	                            .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
   314	                    }
   315	                })
   316	            }));
   317	
   318	            handler.on_trade = Some(Box::new(move |offer_index| {
   319	                let self_weak = self_weak.clone();
   320	                Box::pin(async move {
   321	                    if let Some(trader) = self_weak.upgrade() {
   322	                        let reward_exp = {
   323	                            let mut offers = trader.offers.lock().await;
   324	                            if offer_index >= offers.len() {
   325	                                return;
   326	                            }
   327	                            let offer = &mut offers[offer_index];
   328	                            offer.uses += 1;
   329	                            offer.reward_exp
   330	                        };
   331	
   332	                        // `WanderingTrader::rewardTradeXp` (WanderingTrader.java:158-163): unlike
   333	                        // `Villager`, no persisted XP counter or profession leveling, just a flat
   334	                        // orb, and only when `MerchantOffer::shouldRewardExp`.
   335	                        if reward_exp {
   336	                            let entity = trader.get_entity();
   337	                            crate::entity::experience_orb::ExperienceOrbEntity::spawn(
   338	                                &entity.world.load(),
   339	                                entity.pos.load(),
   340	                                3 + rand::random_range(0..4u32),
   341	                            )
   342	                            .await;
   343	                        }
   344	                    }
   345	                })
   346	            }));
   347	
   348	            let sound_weak = self.self_weak.lock().unwrap().clone().unwrap();
   349	            handler.on_quick_move_trade = Some(Box::new(move || {
   350	                if let Some(trader) = sound_weak.upgrade() {
   351	                    // `MerchantMenu.playTradeSound`/`WanderingTrader.getNotifyTradeSound`
   352	                    // (`MerchantMenu.java:142-147`, `WanderingTrader.java:191-193`).
   353	                    trader
   354	                        .get_entity()
   355	                        .play_sound(pumpkin_data::sound::Sound::EntityWanderingTraderYes);
   356	                }
   357	            }));
   358	
   359	            Some(Arc::new(Mutex::new(handler)) as SharedScreenHandler)
   360	        })

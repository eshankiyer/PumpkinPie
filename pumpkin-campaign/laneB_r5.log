   112	        StructureKeys::OceanRuinCold | StructureKeys::OceanRuinWarm => {
   113	            let generator = OceanRuinGenerator {
   114	                is_warm: structure
   115	                    .biome_temp
   116	                    .map_or(*key == StructureKeys::OceanRuinWarm, |t| t == "warm"),
   117	            };
   118	            generator.get_structure_position(context)
   119	        }
   120	        StructureKeys::EndCity => EndCityGenerator.get_structure_position(context),
   121	        StructureKeys::Mansion => MansionGenerator.get_structure_position(context),
   122	        StructureKeys::Monument => OceanMonumentGenerator.get_structure_position(context),
   123	        StructureKeys::Mineshaft | StructureKeys::MineshaftMesa => {

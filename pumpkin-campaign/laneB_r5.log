   153	    pub async fn try_insert_item(&self, stack: &mut ItemStack, count: u8) -> bool {
   154	        let mut item_guard = self.item.lock().await;
   155	        if let Some(existing) = item_guard.as_mut() {
   156	            if existing.item.id == stack.item.id {
   157	                let add = count.min(64 - existing.item_count);
   158	                if add > 0 {
   159	                    existing.item_count += add;
   160	                    stack.item_count -= add;
   161	                    return true;
   162	                }
   163	            }
   164	            false
   165	        } else {
   166	            let insert_count = count.min(stack.item_count);
   167	            let mut inserted = stack.clone();
   168	            inserted.item_count = insert_count;
   169	            *item_guard = Some(inserted);
   170	            stack.item_count -= insert_count;
   171	            true
   172	        }
   173	    }

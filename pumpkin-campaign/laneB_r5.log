   258	   private void scheduleFullChunkPromotion(
   259	      final ChunkMap scheduler, final CompletableFuture<ChunkResult<LevelChunk>> task, final Executor mainThreadExecutor, final FullChunkStatus status
   260	   ) {
   261	      this.pendingFullStateConfirmation.cancel(false);
   262	      CompletableFuture<Void> confirmation = new CompletableFuture<>();
   263	      confirmation.thenRunAsync(() -> scheduler.onFullChunkStatusChange(this.pos, status), mainThreadExecutor);
   264	      this.pendingFullStateConfirmation = confirmation;
   265	      task.thenAccept(r -> r.ifSuccess(l -> confirmation.complete(null)));
   266	   }
   267	
   268	   private void demoteFullChunk(final ChunkMap scheduler, final FullChunkStatus status) {
   269	      this.pendingFullStateConfirmation.cancel(false);
   270	      scheduler.onFullChunkStatusChange(this.pos, status);
   271	   }
   272	
   273	   protected void updateFutures(final ChunkMap scheduler, final Executor mainThreadExecutor) {
   274	      FullChunkStatus oldFullStatus = ChunkLevel.fullStatus(this.oldTicketLevel);
   275	      FullChunkStatus newFullStatus = ChunkLevel.fullStatus(this.ticketLevel);
   276	      boolean wasAccessible = oldFullStatus.isOrAfter(FullChunkStatus.FULL);
   277	      boolean isAccessible = newFullStatus.isOrAfter(FullChunkStatus.FULL);
   278	      this.wasAccessibleSinceLastSave |= isAccessible;
   279	      if (!wasAccessible && isAccessible) {
   280	         this.fullChunkFuture = scheduler.prepareAccessibleChunk(this);
   281	         this.scheduleFullChunkPromotion(scheduler, this.fullChunkFuture, mainThreadExecutor, FullChunkStatus.FULL);
   282	         this.addSaveDependency(this.fullChunkFuture);
   283	      }
   284	
   285	      if (wasAccessible && !isAccessible) {
   286	         this.fullChunkFuture.complete(UNLOADED_LEVEL_CHUNK);
   287	         this.fullChunkFuture = UNLOADED_LEVEL_CHUNK_FUTURE;
   288	      }
   289	
   290	      boolean wasTicking = oldFullStatus.isOrAfter(FullChunkStatus.BLOCK_TICKING);
   291	      boolean isTicking = newFullStatus.isOrAfter(FullChunkStatus.BLOCK_TICKING);
   292	      if (!wasTicking && isTicking) {
   293	         this.tickingChunkFuture = scheduler.prepareTickingChunk(this);
   294	         this.scheduleFullChunkPromotion(scheduler, this.tickingChunkFuture, mainThreadExecutor, FullChunkStatus.BLOCK_TICKING);
   295	         this.addSaveDependency(this.tickingChunkFuture);
   296	      }
   297	
   298	      if (wasTicking && !isTicking) {
   299	         this.tickingChunkFuture.complete(UNLOADED_LEVEL_CHUNK);
   300	         this.tickingChunkFuture = UNLOADED_LEVEL_CHUNK_FUTURE;
   301	      }
   302	
   303	      boolean wasEntityTicking = oldFullStatus.isOrAfter(FullChunkStatus.ENTITY_TICKING);
   304	      boolean isEntityTicking = newFullStatus.isOrAfter(FullChunkStatus.ENTITY_TICKING);
   305	      if (!wasEntityTicking && isEntityTicking) {
   306	         if (this.entityTickingChunkFuture != UNLOADED_LEVEL_CHUNK_FUTURE) {
   307	            throw (IllegalStateException)Util.pauseInIde(new IllegalStateException());
   308	         }
   309	
   310	         this.entityTickingChunkFuture = scheduler.prepareEntityTickingChunk(this);
   311	         this.scheduleFullChunkPromotion(scheduler, this.entityTickingChunkFuture, mainThreadExecutor, FullChunkStatus.ENTITY_TICKING);
   312	         this.addSaveDependency(this.entityTickingChunkFuture);
   313	      }
   314	
   315	      if (wasEntityTicking && !isEntityTicking) {
   316	         this.entityTickingChunkFuture.complete(UNLOADED_LEVEL_CHUNK);
   317	         this.entityTickingChunkFuture = UNLOADED_LEVEL_CHUNK_FUTURE;
   318	      }
   319	
   320	      if (!newFullStatus.isOrAfter(oldFullStatus)) {
   321	         this.demoteFullChunk(scheduler, newFullStatus);
   322	      }
   323	
   324	      this.onLevelChange.onLevelChange(this.pos, this::getQueueLevel, this.ticketLevel, this::setQueueLevel);
   325	      this.oldTicketLevel = this.ticketLevel;
   326	   }

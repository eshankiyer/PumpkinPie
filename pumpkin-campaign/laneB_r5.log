   405	
   406	   public static BlockState reorient(final BlockGetter level, final BlockPos blockPos, final BlockState blockState) {
   407	      Direction solidNeighbor = null;
   408	
   409	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   410	         BlockPos relativePos = blockPos.relative(direction);
   411	         BlockState state = level.getBlockState(relativePos);
   412	         if (state.is(Blocks.CHEST)) {
   413	            return blockState;
   414	         }
   415	
   416	         if (state.isSolidRender()) {
   417	            if (solidNeighbor != null) {
   418	               solidNeighbor = null;
   419	               break;
   420	            }
   421	
   422	            solidNeighbor = direction;
   423	         }
   424	      }
   425	
   426	      if (solidNeighbor != null) {
   427	         return blockState.setValue(HorizontalDirectionalBlock.FACING, solidNeighbor.getOpposite());
   428	      }
   429	
   430	      Direction lockDir = blockState.getValue(HorizontalDirectionalBlock.FACING);
   431	      BlockPos relativePos = blockPos.relative(lockDir);
   432	      if (level.getBlockState(relativePos).isSolidRender()) {
   433	         lockDir = lockDir.getOpposite();
   434	         relativePos = blockPos.relative(lockDir);
   435	      }
   436	
   437	      if (level.getBlockState(relativePos).isSolidRender()) {
   438	         lockDir = lockDir.getClockWise();
   439	         relativePos = blockPos.relative(lockDir);
   440	      }
   441	
   442	      if (level.getBlockState(relativePos).isSolidRender()) {
   443	         lockDir = lockDir.getOpposite();
   444	         relativePos = blockPos.relative(lockDir);
   445	      }
   446	
   447	      return blockState.setValue(HorizontalDirectionalBlock.FACING, lockDir);
   448	   }

   555	    async fn update_flap_time(&self) {
   556	        let sitting = self.phase.lock().await.is_sitting();
   557	        let in_wall = *self.in_wall.lock().await;
   558	        let mut flap = self.flap_time.lock().await;
   559	        let mut o_flap = self.o_flap_time.lock().await;
   560	
   561	        *o_flap = *flap;
   562	        *flap += if sitting {
   563	            0.1
   564	        } else if in_wall {
   565	            FLAP_SPEED * 0.5
   566	        } else {
   567	            FLAP_SPEED
   568	        };
   569	        if *flap > std::f32::consts::TAU {
   570	            *flap -= std::f32::consts::TAU;
   571	        }
   572	    }
   573	
   574	    /// Vanilla `EnderDragon.isFlapping` (`EnderDragon.java:123-128`): a wing beat is the
   575	    /// `cos(flapTime * 2π)` wave crossing -0.3 upward between the previous and current
   576	    /// sample of the flap phase.
   577	    async fn is_flapping(&self) -> bool {
   578	        let flap = *self.flap_time.lock().await;
   579	        let old_flap = *self.o_flap_time.lock().await;
   580	        (old_flap * std::f32::consts::TAU).cos() <= -0.3
   581	            && (flap * std::f32::consts::TAU).cos() >= -0.3
   582	    }
   583	
   584	    /// Vanilla `EnderDragon.aiStep` calls `processFlappingMovement`
   585	    /// (`EnderDragon.java:148`, `Entity.java:1037-1043`): on a flap crossing, the server
   586	    /// emits `GameEvent.FLAP` (the dragon does not override `getMovementEmission`, whose
   587	    /// default `ALL` emits events - `Entity.java:1533-1535`), which sculk vibration
   588	    /// listeners receive at frequency 1. The client-only local flap sound inside
   589	    /// `onFlap` (`EnderDragon.java:131-138`) has no server counterpart.
   590	    async fn on_flap(&self, caller: &Arc<dyn EntityBase>) {
   591	        let world = self.mob_entity.living_entity.entity.world.load();
   592	        crate::world::game_event::emit_game_event(
   593	            &world,
   594	            pumpkin_data::game_event::GameEvent::Flap,
   595	            self.mob_entity.living_entity.entity.pos.load(),
   596	            crate::world::game_event::GameEventContext::of_entity(caller.clone()),
   597	        )
   598	        .await;
   599	    }

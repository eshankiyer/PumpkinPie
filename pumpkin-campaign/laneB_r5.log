   796	         output.store("text", ComponentSerialization.CODEC, this.getText());
   797	         output.putInt("line_width", this.getLineWidth());
   798	         output.putInt("background", this.getBackgroundColor());
   799	         output.putByte("text_opacity", this.getTextOpacity());
   800	         byte flags = this.getFlags();
   801	         storeFlag(flags, output, "shadow", (byte)1);
   802	         storeFlag(flags, output, "see_through", (byte)2);
   803	         storeFlag(flags, output, "default_background", (byte)4);
   804	         output.store("alignment", Display.TextDisplay.Align.CODEC, getAlign(flags));
   805	      }

   875	    /// Vanilla `EnderDragon.hurt` (EnderDragon.java:446-469). Applies the
   876	    /// DYING-phase immunity, the per-phase `onHurt` hook, the non-head damage
   877	    /// reduction, the 0.01 cutoff, the player/`ALWAYS_HURTS_ENDER_DRAGONS`
   878	    /// gate, and the sitting-damage accumulation that triggers the TAKEOFF
   879	    /// transition at `0.25 * max health`.
   880	    pub async fn hurt_part(
   881	        &self,
   882	        is_head: bool,
   883	        source: &dyn EntityBase,
   884	        damage_type: DamageType,
   885	        mut damage: f32,
   886	    ) -> bool {
   887	        let phase_type = *self.phase.lock().await;
   888	        if phase_type == EnderDragonPhase::Dying {
   889	            return false;
   890	        }
   891	
   892	        // EnderDragon.java:451: the per-phase hook runs before the head/body split.
   893	        damage = self
   894	            .phase_manager
   895	            .get_phase(phase_type)
   896	            .on_hurt(self, source, damage);
   897	
   898	        if !is_head {
   899	            damage = damage / 4.0 + damage.min(1.0);
   900	        }
   901	
   902	        if damage < 0.01 {
   903	            return false;
   904	        }
   905	
   906	        // Vanilla `source.getEntity() instanceof Player` resolves the causing entity, not
   907	        // the direct one - for projectiles that's the shooter, so a projectile source must
   908	        // be followed back to its owner (EnderDragon.java:460, DamageSource.java:63).
   909	        let world = self.mob_entity.living_entity.entity.world.load();
   910	        let caused_by_player = source.get_player().is_some()
   911	            || crate::entity::projectile::projectile_owner_id(source)
   912	                .is_some_and(|id| world.get_player_by_id(id).is_some());
   913	
   914	        if caused_by_player
   915	            || damage_type.has_tag(&tag::DamageType::MINECRAFT_ALWAYS_HURTS_ENDER_DRAGONS)
   916	        {
   917	            let health_before = self.mob_entity.living_entity.health.load();
   918	            self.damage_with_context(self, damage, damage_type, None, Some(source), Some(source))
   919	                .await;
   920	            let health_after = self.mob_entity.living_entity.health.load();
   921	            // Race: a concurrent damage/heal landing between the two loads above can skew
   922	            // this delta (vanilla is single-threaded and has no such window). Clamped at
   923	            // zero rather than restructured, since the two health loads can't be merged
   924	            // into one atomic op and this call already holds no lock across the `.await`.
   925	            let delta = (health_before - health_after).max(0.0);
   926	
   927	            let phase_type: EnderDragonPhase = *self.phase.lock().await;
   928	            if phase_type.is_sitting() {
   929	                let mut received = self.sitting_damage_received.lock().await;
   930	                *received += delta;
   931	                if *received > 0.25 * self.mob_entity.living_entity.get_max_health() {
   932	                    *received = 0.0;
   933	                    drop(received);
   934	                    self.set_phase(EnderDragonPhase::TakingOff).await;
   935	                }
   936	            }
   937	        }
   938	
   939	        true
   940	    }
   941	}

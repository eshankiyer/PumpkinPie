   365	    /// Fills downwards while the column stays structure-replaceable.
   366	    pub fn fill_downwards(
   367	        &self,
   368	        chunk: &mut ProtoChunk,
   369	        state: &BlockState,
   370	        x: i32,
   371	        y: i32,
   372	        z: i32,
   373	        box_limit: &BlockBox,
   374	    ) {
   375	        let world_pos = self.offset_pos(x, y, z);
   376	        if !box_limit.contains_pos(&world_pos) {
   377	            return;
   378	        }
   379	
   380	        let min_fill_y = chunk.bottom_y() as i32 + 1;
   381	        let mut current_y = world_pos.y;
   382	
   383	        while current_y > min_fill_y {
   384	            let block_pos = Vector3::new(world_pos.x, current_y, world_pos.z);
   385	            let current_state = chunk.get_block_state(&block_pos);
   386	            if !Self::is_replaceable_by_structures(
   387	                current_state.to_state(),
   388	                current_state.to_block(),
   389	            ) {
   390	                break;
   391	            }
   392	
   393	            chunk.set_block_state(world_pos.x, current_y, world_pos.z, state);
   394	            current_y -= 1;
   395	        }
   396	    }

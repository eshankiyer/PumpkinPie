   227	    pub async fn open_trading_screen(&self, player: &Arc<Player>) {
   228	        if let Some(sync_id) = player.open_handled_screen(self, None).await {
   229	            let offers = self.offers.lock().await.clone();
   230	            player
   231	                .send_client_packet(&CMerchantOffers::new(
   232	                    VarInt(sync_id as i32),
   233	                    offers,
   234	                    // Vanilla `WanderingTrader.mobInteract` opens `openTradingScreen(player,
   235	                    // displayName, 1)` -- wandering traders have no level progression, so the
   236	                    // level is always fixed at 1.
   237	                    VarInt(1),
   238	                    VarInt(0),
   239	                    false,
   240	                    false,
   241	                ))
   242	                .await;
   243	        }
   244	    }
   245	}

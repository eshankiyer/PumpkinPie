   350	///
   351	/// Implementors must provide:
   352	/// - [`get_behaviour`](ScreenHandler::get_behaviour) and [`get_behaviour_mut`](ScreenHandler::get_behaviour_mut)
   353	/// - [`quick_move`](ScreenHandler::quick_move) for shift-click behavior
   354	/// - [`as_any`](ScreenHandler::as_any) for downcasting
   355	// ScreenHandler.java
   356	// TODO: Fully implement this
   357	pub trait ScreenHandler: Send + Sync {
   358	    // --- Synchronous Methods ---
   359	
   360	    /// Gets the window type for this screen handler.
   361	    fn window_type(&self) -> Option<WindowType> {
   362	        self.get_behaviour().window_type
   363	    }
   364	
   365	    /// Returns this screen handler as an Any reference.
   366	    fn as_any(&self) -> &dyn Any;
   367	
   368	    /// Returns this screen handler as a mutable Any reference.
   369	    fn as_any_mut(&mut self) -> &mut dyn Any;
   370	
   371	    /// Gets the sync ID for this screen handler.
   372	    fn sync_id(&self) -> u8 {
   373	        self.get_behaviour().sync_id
   374	    }
   375	
   376	    /// What must still hold at the position this menu was opened against.
   377	    ///
   378	    /// Vanilla equivalent: the `ContainerLevelAccess`/`Block` pair a menu passes to
   379	    /// `AbstractContainerMenu.stillValid` (`AbstractContainerMenu.java:93-95`), or the
   380	    /// backing container for the `Container.stillValidBlockEntity` family
   381	    /// (`Container.java:94-101`). Defaults to [`ContainerAccess::None`], i.e. a menu
   382	    /// with no backing position.
   383	    fn container_access(&self) -> ContainerAccess {
   384	        ContainerAccess::None
   385	    }
   386	
   387	    /// Checks if the player can still use this container.
   388	    ///
   389	    /// Port of `AbstractContainerMenu.stillValid(Player)`
   390	    /// (`AbstractContainerMenu.java:635`). The default routes
   391	    /// [`ScreenHandler::container_access`] through the player, so a menu stays valid
   392	    /// only while the player is in range of - and the expected block still stands at -
   393	    /// the position the menu was opened against.
   394	    fn can_use(&self, player: &dyn InventoryPlayer) -> bool {
   395	        player.evaluate_container_access(self.container_access())
   396	    }
   397	
   398	    /// Gets a reference to the screen handler behaviour.
   399	    fn get_behaviour(&self) -> &ScreenHandlerBehaviour;
   400	
   401	    /// Gets a mutable reference to the screen handler behaviour.
   402	    fn get_behaviour_mut(&mut self) -> &mut ScreenHandlerBehaviour;
   403	
   404	    /// Adds a slot to this screen handler.
   405	    ///
   406	    /// Assigns an ID and sets up tracking for the slot.
   407	    fn add_slot(&mut self, slot: Arc<dyn Slot>) -> Arc<dyn Slot> {
   408	        let behaviour = self.get_behaviour_mut();
   409	        slot.set_id(behaviour.slots.len());
   410	        behaviour.slots.push(slot.clone());
   411	        behaviour.tracked_stacks.push(ItemStack::EMPTY.clone());
   412	        behaviour.previous_tracked_stacks.push(TrackedStack::EMPTY);
   413	
   414	        slot
   415	    }
   416	
   417	    /// Adds hotbar slots (0-8) from the player inventory.
   418	    fn add_player_hotbar_slots(&mut self, player_inventory: &Arc<dyn Inventory>) {
   419	        for i in 0..9 {
   420	            self.add_slot(Arc::new(NormalSlot::new(player_inventory.clone(), i)));
   421	        }
   422	    }
   423	
   424	    /// Adds main inventory slots (9-35) from the player inventory.
   425	    fn add_player_inventory_slots(&mut self, player_inventory: &Arc<dyn Inventory>) {
   426	        for i in 0..3 {
   427	            for j in 0..9 {
   428	                self.add_slot(Arc::new(NormalSlot::new(
   429	                    player_inventory.clone(),
   430	                    j + (i + 1) * 9,
   431	                )));
   432	            }
   433	        }
   434	    }
   435	
   436	    /// Adds all player inventory slots (main + hotbar).
   437	    fn add_player_slots(&mut self, player_inventory: &Arc<dyn Inventory>) {
   438	        self.add_player_inventory_slots(player_inventory);
   439	        self.add_player_hotbar_slots(player_inventory);
   440	    }
   441	
   442	    /// Records a received hash for a slot (for sync tracking).
   443	    fn set_received_hash(&mut self, slot: usize, hash: OptionalItemStackHash) {
   444	        let behaviour = self.get_behaviour_mut();
   445	        if slot < behaviour.previous_tracked_stacks.len() {
   446	            behaviour.previous_tracked_stacks[slot].set_received_hash(hash);
   447	        } else {
   448	            warn!(
   449	                "Incorrect slot index: {} available slots: {}",
   450	                slot,
   451	                behaviour.previous_tracked_stacks.len()
   452	            );
   453	        }
   454	    }
   455	
   456	    /// Records a received stack for a slot (for sync tracking).
   457	    fn set_received_stack(&mut self, slot: usize, stack: ItemStack) {
   458	        let behaviour = self.get_behaviour_mut();
   459	        behaviour.previous_tracked_stacks[slot].set_received_stack(stack);
   460	    }
   461	
   462	    /// Records a received cursor hash (for sync tracking).
   463	    fn set_received_cursor_hash(&mut self, hash: OptionalItemStackHash) {
   464	        let behaviour = self.get_behaviour_mut();
   465	        behaviour.previous_cursor_stack.set_received_hash(hash);
   466	    }
   467	
   468	    /// Adds a property to track.
   469	    fn add_property(&mut self, property: ScreenProperty) {
   470	        let behaviour = self.get_behaviour_mut();
   471	        behaviour.properties.push(property);
   472	        behaviour.tracked_property_values.push(0);
   473	    }
   474	
   475	    /// Adds multiple properties to track.
   476	    fn add_properties(&mut self, properties: Vec<ScreenProperty>) {
   477	        for property in properties {
   478	            self.add_property(property);
   479	        }
   480	    }
   481	
   482	    // --- Asynchronous Methods ---
   483	
   484	    /// Called when the container is closed by the player.
   485	    ///
   486	    /// Default implementation drops the cursor item.
   487	    fn on_closed<'a>(&'a mut self, player: &'a dyn InventoryPlayer) -> ScreenHandlerFuture<'a, ()> {
   488	        Box::pin(async move {
   489	            self.default_on_closed(player).await;
   490	        })
   491	    }
   492	
   493	    /// Default close behavior - drops the cursor item.
   494	    fn default_on_closed<'a>(
   495	        &'a mut self,
   496	        player: &'a dyn InventoryPlayer,
   497	    ) -> ScreenHandlerFuture<'a, ()> {

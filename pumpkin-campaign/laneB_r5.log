   514	        &'a self,
   515	        player: &'a Arc<Player>,
   516	        item_stack: &'a mut ItemStack,
   517	    ) -> crate::entity::EntityBaseFuture<'a, bool> {
   518	        Box::pin(async move {
   519	            if self.golem_interact(player, item_stack) {
   520	                return true;
   521	            }

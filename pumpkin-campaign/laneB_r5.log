   613	}
   614	
   615	impl StructurePiecesCollector {
   616	    #[must_use]
   617	    pub fn new() -> Self {
   618	        Self {
   619	            pieces: Vec::new(),
   620	            cached_box: None,
   621	        }
   622	    }
   623	
   624	    pub fn add_piece(&mut self, piece: Box<dyn StructurePieceBase>) {
   625	        self.pieces.push(piece);
   626	        self.cached_box = None;
   627	    }
   628	
   629	    #[must_use]
   630	    pub fn get_intersecting(&self, box_to_check: &BlockBox) -> Option<&dyn StructurePieceBase> {
   631	        self.pieces
   632	            .iter()
   633	            .find(|piece| {
   634	                piece
   635	                    .get_structure_piece()
   636	                    .bounding_box
   637	                    .intersects(box_to_check)

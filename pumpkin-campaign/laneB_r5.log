   862	                pos,
   863	                target,
   864	                phase.get_fly_speed(),
   865	                phase.get_turn_speed(),
   866	                0.5,
   867	            )
   868	            .await;
   869	        }
   870	
   871	        self.mob_entity.living_entity.entity.send_pos_rot();

   131	impl StaticIndependentChunkNoiseFunctionComponentImpl for Beardifier {
   132	    fn sample(&self, pos: &Vector3<i32>) -> f64 {
   133	        let Some(affected_box) = self.affected_box else {
   134	            return 0.0;
   135	        };
   136	
   137	        let block_x = pos.x;
   138	        let block_y = pos.y;
   139	        let block_z = pos.z;
   140	
   141	        if !affected_box.contains(block_x, block_y, block_z) {
   142	            return 0.0;
   143	        }
   144	
   145	        let mut weight = 0.0;
   146	
   147	        for structure in &self.structures {
   148	            let box_min_x = structure.bounding_box.min.x;
   149	            let box_min_y = structure.bounding_box.min.y;
   150	            let box_min_z = structure.bounding_box.min.z;
   151	            let box_max_x = structure.bounding_box.max.x;
   152	            let box_max_y = structure.bounding_box.max.y;
   153	            let box_max_z = structure.bounding_box.max.z;
   154	
   155	            let ground_level_delta = structure.ground_level_delta;
   156	
   157	            let dx = 0.max((box_min_x - block_x).max(block_x - box_max_x));
   158	            let dz = 0.max((box_min_z - block_z).max(block_z - box_max_z));
   159	            let ground_y = box_min_y + ground_level_delta;
   160	            let dy_to_ground = block_y - ground_y;
   161	
   162	            let dy = match structure.terrain_adaptation {
   163	                TerrainAdaptation::None => 0,
   164	                TerrainAdaptation::Bury | TerrainAdaptation::BeardThin => dy_to_ground,
   165	                TerrainAdaptation::BeardBox => 0.max((ground_y - block_y).max(block_y - box_max_y)),
   166	                TerrainAdaptation::Encapsulate => {
   167	                    0.max((box_min_y - block_y).max(block_y - box_max_y))
   168	                }
   169	            };
   170	
   171	            let contrib = match structure.terrain_adaptation {
   172	                TerrainAdaptation::None => 0.0,
   173	                TerrainAdaptation::Bury => {
   174	                    get_bury_contribution(dx as f64, dy as f64 / 2.0, dz as f64)
   175	                }
   176	                TerrainAdaptation::BeardThin | TerrainAdaptation::BeardBox => {
   177	                    get_beard_contribution(dx, dy, dz, dy_to_ground) * 0.8
   178	                }
   179	                TerrainAdaptation::Encapsulate => {
   180	                    get_bury_contribution(dx as f64 / 2.0, dy as f64 / 2.0, dz as f64 / 2.0) * 0.8
   181	                }
   182	            };
   183	            weight += contrib;
   184	        }
   185	
   186	        for junction in &self.junctions {
   187	            let j_dx = block_x - junction.x;
   188	            let j_dy = block_y - junction.ground_y;
   189	            let j_dz = block_z - junction.z;
   190	

   420	#[test]
   421	fn cancelled_out_of_range_task_clears_holder_task_slot() {
   422	    let mut graph = DAG::default();
   423	    let mut chunk_map = HashMap::new();
   424	    let pos = ChunkPos::new(0, 0);
   425	
   426	    let stage = StagedChunkEnum::Biomes;
   427	    let node_key = graph.nodes.insert(Node::new(pos, stage));
   428	
   429	    let mut holder = ChunkHolder {
   430	        current_stage: StagedChunkEnum::Empty,
   431	        target_stage: StagedChunkEnum::None, // Chunk was downgraded / moved out of range
   432	        dependency_stage: StagedChunkEnum::None,
   433	        ..Default::default()
   434	    };
   435	    holder.tasks[stage as usize] = node_key;
   436	    chunk_map.insert(pos, holder);
   437	
   438	    // Simulate task processing loop cancellation when node.stage > effective_target
   439	    let node = graph.nodes.get(node_key).unwrap().clone();
   440	    let effective_target = chunk_map.get(&node.pos).map_or(StagedChunkEnum::None, |h| {
   441	        h.target_stage.max(h.dependency_stage)
   442	    });
   443	
   444	    assert!(node.stage > effective_target);
   445	    if let Some(holder) = chunk_map.get_mut(&node.pos) {
   446	        let task_slot = &mut holder.tasks[node.stage as usize];
   447	        if *task_slot == node_key {
   448	            *task_slot = NodeKey::null();
   449	        }
   450	    }
   451	    graph.fast_drop_node(node_key);
   452	
   453	    let holder = chunk_map.get(&pos).unwrap();
   454	    assert!(
   455	        holder.tasks[stage as usize].is_null(),
   456	        "Task slot must be null after cancellation"
   457	    );
   458	    assert!(
   459	        holder.tasks.iter().all(Key::is_null),
   460	        "All task slots must be null when idle"
   461	    );
   462	}


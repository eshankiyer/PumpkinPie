   357	    fn is_replaceable_by_structures(state: &BlockState, block: &Block) -> bool {
   358	        state.is_air()
   359	            || state.is_liquid()
   360	            || block == &Block::GLOW_LICHEN
   361	            || block == &Block::SEAGRASS
   362	            || block == &Block::TALL_SEAGRASS

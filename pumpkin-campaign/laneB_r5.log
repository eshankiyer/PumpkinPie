   292	impl UniformHeightProvider {
   293	    #[must_use]
   294	    pub fn get(&self, random: &mut RandomGenerator, min_y: i8, height: u16) -> i32 {
   295	        let min = self.min_inclusive.get_y(min_y as i16, height);
   296	        let max = self.max_inclusive.get_y(min_y as i16, height);
   297	        if min >= max {
   298	            min
   299	        } else {
   300	            random.next_inbetween_i32(min, max)
   301	        }
   302	    }
   303	}
   304	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
   305	pub struct TrapezoidHeightProvider {
   306	    pub min_inclusive: YOffset,
   307	    pub max_inclusive: YOffset,
   308	    pub plateau: Option<i32>,
   309	}
   310	impl TrapezoidHeightProvider {
   311	    #[must_use]
   312	    pub fn get(&self, random: &mut RandomGenerator, min_y: i8, height: u16) -> i32 {
   313	        let plateau = self.plateau.unwrap_or(0);
   314	        let i = self.min_inclusive.get_y(min_y as i16, height);
   315	        let j = self.max_inclusive.get_y(min_y as i16, height);
   316	        if i >= j {
   317	            return i;
   318	        }
   319	        let k = j - i;
   320	        if plateau >= k {
   321	            return random.next_inbetween_i32(i, j);
   322	        }
   323	        let l = (k - plateau) / 2;
   324	        let m = k - l;
   325	        i + random.next_inbetween_i32(0, m) + random.next_inbetween_i32(0, l)
   326	    }
   327	}

   260	        max_y: i32,
   261	        max_z: i32,
   262	        outline: &BlockState,
   263	        inside: &BlockState,
   264	    ) {
   265	        for y in min_y..=max_y {
   266	            for x in min_x..=max_x {
   267	                for z in min_z..=max_z {
   268	                    if cant_replace_air && self.get_block_at(chunk, x, y, z, box_limit).is_air() {
   269	                        continue;
   270	                    }
   271	                    let is_border = x == min_x
   272	                        || x == max_x
   273	                        || y == min_y
   274	                        || y == max_y
   275	                        || z == min_z
   276	                        || z == max_z;
   277	
   278	                    let block = if is_border { outline } else { inside };
   279	                    self.add_block(chunk, block, x, y, z, box_limit);
   280	                }


   134	#[must_use]
   135	pub fn try_generate_structure(
   136	    key: &StructureKeys,
   137	    structure: &Structure,
   138	    seed: i64,
   139	    chunk: &ProtoChunk,
   140	    sea_level: i32,
   141	    height_sampler: Option<&mut dyn crate::generation::structure::structures::HeightSampler>,
   142	) -> Option<StructurePosition> {
   143	    let random = create_chunk_random(seed, chunk.x, chunk.z);
   144	    let context = StructureGeneratorContext {
   145	        seed,
   146	        chunk_x: chunk.x,
   147	        chunk_z: chunk.z,
   148	        random,
   149	        sea_level,
   150	        min_y: chunk.bottom_y() as i32,
   151	        height_sampler,
   152	        structure_key: Some(*key),
   153	    };
   154	    let structure_pos = generate_structure_position(key, structure, context);
   155	
   156	    if let Some(pos) = structure_pos {
   157	        // Get the biome at the structure's starting position.
   158	        // Clamp biome Y to the chunk's valid range in case a structure's start_pos.y
   159	        // falls outside this chunk's stored biome section range.
   160	        let biome_y = biome_coords::from_block(pos.start_pos.0.y);
   161	        let biome_height = (chunk.height() >> 2) as i32;
   162	        let biome_bottom = biome_coords::from_block(chunk.bottom_y() as i32);
   163	        let clamped_biome_y = biome_y.clamp(biome_bottom, biome_bottom + biome_height - 1);
   164	
   165	        let current_biome = chunk.get_biome_id(
   166	            biome_coords::from_block(pos.start_pos.0.x),
   167	            clamped_biome_y,
   168	            biome_coords::from_block(pos.start_pos.0.z),
   169	        ) as u16;
   170	
   171	        let biomes = get_tag_ids(
   172	            RegistryKey::WorldgenBiome,
   173	            structure
   174	                .biomes
   175	                .strip_prefix('#')
   176	                .unwrap_or(structure.biomes),
   177	        )?;
   178	
   179	        // Check if the biome is allowed for this structure
   180	        if biomes.contains(&current_biome) {
   181	            return Some(pos);
   182	        }
   183	    }
   184	
   185	    None
   186	}
   187	
   188	#[must_use]
   189	pub fn lazily_generate_structure(
   190	    key: &StructureKeys,
   191	    structure: &Structure,
   192	    mut context: StructureGeneratorContext, // Replaces 5 separate arguments!
   193	    biome_supplier: &dyn BiomeSupplier,
   194	    multi_noise_sampler: &mut MultiNoiseSampler,
   195	) -> Option<StructurePosition> {
   196	    if *key == StructureKeys::Monument {
   197	        let center_x = crate::generation::positions::chunk_pos::get_center_x(context.chunk_x);
   198	        let center_z = crate::generation::positions::chunk_pos::get_center_z(context.chunk_z);
   199	        let start_y = context
   200	            .height_sampler
   201	            .as_deref_mut()
   202	            .map_or(context.sea_level, |sampler| {
   203	                sampler.estimate_ocean_floor_height(center_x, center_z)
   204	            });
   205	        if !has_valid_biomes(
   206	            biome_supplier,
   207	            multi_noise_sampler,
   208	            context.chunk_x,
   209	            context.chunk_z,
   210	            context.sea_level,
   211	            start_y,
   212	        ) {
   213	            return None;
   214	        }
   215	    }
   216	
   217	    let structure_pos = generate_structure_position(key, structure, context);
   218	
   219	    if let Some(pos) = structure_pos {
   220	        // Get the biome mathematically, bypassing the chunk boundaries entirely!
   221	        let biome_x = biome_coords::from_block(pos.start_pos.0.x);
   222	        let biome_y = biome_coords::from_block(pos.start_pos.0.y);
   223	        let biome_z = biome_coords::from_block(pos.start_pos.0.z);
   224	
   225	        let biome = biome_supplier.biome(biome_x, biome_y, biome_z, multi_noise_sampler);
   226	
   227	        if let Some(biomes) = get_tag_ids(
   228	            RegistryKey::WorldgenBiome,
   229	            structure
   230	                .biomes
   231	                .strip_prefix('#')
   232	                .unwrap_or(structure.biomes),
   233	        ) && biomes.contains(&(biome.id as u16))
   234	        {
   235	            return Some(pos);
   236	        }
   237	    }
   238	
   239	    None
   240	}

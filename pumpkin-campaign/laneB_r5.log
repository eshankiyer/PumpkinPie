   311	/// Implements helper methods for chest-like block entities.
   312	///
   313	/// Includes the `play_sound` method which handles sound positioning for single and double chests,
   314	/// as well as `new()` and `get_viewer_count()` methods.
   315	#[macro_export]
   316	macro_rules! impl_chest_helper_methods {
   317	    ($struct_name:ty) => {
   318	        impl $struct_name {
   319	            /// Returns the number of players currently viewing this chest
   320	            pub fn get_viewer_count(&self) -> u16 {
   321	                self.viewers.get_viewer_count()
   322	            }
   323	
   324	            #[must_use]
   325	            pub fn new(position: pumpkin_util::math::position::BlockPos) -> Self {
   326	                use std::array::from_fn;
   327	                use std::sync::Mutex as StdMutex;
   328	                use std::sync::atomic::AtomicBool;
   329	
   330	                Self {
   331	                    position,
   332	                    items: tokio::sync::RwLock::new(from_fn(|_| ItemStack::EMPTY.clone())),
   333	                    dirty: AtomicBool::new(false),
   334	                    viewers: $crate::block::viewer::ViewerCountTracker::new(),
   335	                    loot_table: StdMutex::new(None),
   336	                    loot_table_seed: 0,
   337	                }
   338	            }
   339	
   340	            async fn play_sound(
   341	                &self,
   342	                world: &Arc<$crate::world::World>,
   343	                sound: pumpkin_data::sound::Sound,
   344	            ) {
   345	                let mut rng = pumpkin_util::random::xoroshiro128::Xoroshiro::from_seed(
   346	                    pumpkin_util::random::get_seed(),
   347	                );
   348	
   349	                let (block, state) = world.get_block_and_state(&self.position);
   350	                let properties = pumpkin_data::block_properties::ChestLikeProperties::from_state_id(
   351	                    state.id, block,
   352	                );
   353	                let position = match properties.r#type {
   354	                    pumpkin_data::block_properties::ChestType::Left => return,
   355	                    pumpkin_data::block_properties::ChestType::Single => {
   356	                        pumpkin_util::math::vector3::Vector3::new(
   357	                            self.position.0.x as f64 + 0.5,
   358	                            self.position.0.y as f64 + 0.5,
   359	                            self.position.0.z as f64 + 0.5,
   360	                        )
   361	                    }
   362	                    pumpkin_data::block_properties::ChestType::Right => {
   363	                        let direction = pumpkin_data::HorizontalFacingExt::to_block_direction(
   364	                            &properties.facing,
   365	                        )
   366	                        .to_offset();
   367	                        pumpkin_util::math::vector3::Vector3::new(
   368	                            self.position.0.x as f64 + 0.5 + direction.x as f64 * 0.5,
   369	                            self.position.0.y as f64 + 0.5,
   370	                            self.position.0.z as f64 + 0.5 + direction.z as f64 * 0.5,
   371	                        )
   372	                    }
   373	                };
   374	
   375	                world.play_sound_fine(
   376	                    sound,
   377	                    pumpkin_data::sound::SoundCategory::Blocks,
   378	                    &position,
   379	                    0.5,
   380	                    pumpkin_util::random::RandomImpl::next_f32(&mut rng) * 0.1 + 0.9,
   381	                );
   382	                let bedrock_sound = match sound {
   383	                    pumpkin_data::sound::Sound::BlockChestOpen => "chest.open",
   384	                    pumpkin_data::sound::Sound::BlockChestClose => "chest.closed",
   385	                    _ => return,
   386	                };
   387	                world.play_bedrock_level_sound(bedrock_sound, &position, 0);
   388	            }
   389	        }
   390	    };


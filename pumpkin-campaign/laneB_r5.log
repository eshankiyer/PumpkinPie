    89	            if let Some(start_jigsaw_name) = structure.start_jigsaw_name {
    90	                generator = generator.with_start_jigsaw(start_jigsaw_name);
    91	            }
    92	            generator.get_structure_position(context)
    93	        }
    94	        StructureKeys::Shipwreck | StructureKeys::ShipwreckBeached => {
    95	            let generator = ShipwreckGenerator {
    96	                is_beached: structure
    97	                    .is_beached
    98	                    .unwrap_or(*key == StructureKeys::ShipwreckBeached),
    99	            };
   100	            generator.get_structure_position(context)
   101	        }
   102	        StructureKeys::RuinedPortal

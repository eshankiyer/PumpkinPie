  2527	        VillagerProfession::Cartographer => block == &Block::CARTOGRAPHY_TABLE,
  2528	        VillagerProfession::Cleric => block == &Block::BREWING_STAND,
  2529	        VillagerProfession::Fisherman => block == &Block::BARREL,
  2530	        VillagerProfession::Fletcher => block == &Block::FLETCHING_TABLE,

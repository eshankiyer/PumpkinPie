   363	   public float calculateInterpolationProgress(final float partialTickTime) {
   364	      int duration = this.interpolationDuration;
   365	      if (duration <= 0) {
   366	         return 1.0F;
   367	      }
   368	
   369	      float ticksSinceUpdate = (float)(this.tickCount - this.interpolationStartClientTick);
   370	      float partialTicksSinceLastUpdate = ticksSinceUpdate + partialTickTime;
   371	      float result = Mth.clamp(Mth.inverseLerp(partialTicksSinceLastUpdate, 0.0F, duration), 0.0F, 1.0F);
   372	      this.lastProgress = result;
   373	      return result;
   374	   }

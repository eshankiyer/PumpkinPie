   118	
   119	impl StructurePiece {
   120	    #[must_use]
   121	    pub const fn new(
   122	        r#type: StructurePieceType,
   123	        bounding_box: BlockBox,
   124	        chain_length: u32,
   125	    ) -> Self {
   126	        Self {
   127	            r#type,
   128	            bounding_box,
   129	            facing: None,
   130	            mirror: Mirror::None,
   131	            rotation: Rotation::None,
   132	            chain_length,
   133	        }
   134	    }
   135	
   136	    pub const fn set_facing(&mut self, facing: Option<BlockDirection>) {
   137	        self.facing = facing;
   138	        match facing {
   139	            Some(BlockDirection::South) => {
   140	                self.mirror = Mirror::LeftRight;
   141	                self.rotation = Rotation::None;
   142	            }
   143	            Some(BlockDirection::West) => {
   144	                self.mirror = Mirror::LeftRight;
   145	                self.rotation = Rotation::Clockwise90;
   146	            }
   147	            Some(BlockDirection::East) => {
   148	                self.mirror = Mirror::None;
   149	                self.rotation = Rotation::Clockwise90;
   150	            }
   151	            _ => {
   152	                self.mirror = Mirror::None;
   153	                self.rotation = Rotation::None;
   154	            }
   155	        }
   156	    }
   157	
   158	    pub(crate) const fn offset_pos(&self, x: i32, y: i32, z: i32) -> Vector3<i32> {
   159	        Vector3::new(
   160	            self.apply_x_transform(x, z),
   161	            self.apply_y_transform(y),
   162	            self.apply_z_transform(x, z),
   163	        )
   164	    }
   165	
   166	    const fn apply_x_transform(&self, x: i32, z: i32) -> i32 {
   167	        match self.facing {
   168	            Some(BlockDirection::North | BlockDirection::South) => self.bounding_box.min.x + x,
   169	            Some(BlockDirection::West) => self.bounding_box.max.x - z,
   170	            Some(BlockDirection::East) => self.bounding_box.min.x + z,
   171	            _ => x,
   172	        }
   173	    }
   174	
   175	    const fn apply_y_transform(&self, y: i32) -> i32 {
   176	        match self.facing {
   177	            None => y,
   178	            Some(_) => y + self.bounding_box.min.y,
   179	        }
   180	    }
   181	
   182	    const fn apply_z_transform(&self, x: i32, z: i32) -> i32 {
   183	        match self.facing {
   184	            Some(BlockDirection::North) => self.bounding_box.max.z - z,
   185	            Some(BlockDirection::South) => self.bounding_box.min.z + z,
   186	            Some(BlockDirection::West | BlockDirection::East) => self.bounding_box.min.z + x,
   187	            _ => z,
   188	        }
   189	    }
   190	
   191	    #[allow(clippy::too_many_arguments)]
   192	    pub fn place_block(
   193	        &self,
   194	        chunk: &mut ProtoChunk,
   195	        block_registry: &dyn WorldPortalExt,
   196	        mut block_state: &'static BlockState,
   197	        x: i32,
   198	        y: i32,
   199	        z: i32,
   200	        chunk_box: &BlockBox,
   201	    ) {
   202	        let pos = self.offset_pos(x, y, z);
   203	        if chunk_box.contains(pos.x, pos.y, pos.z) {
   204	            let block = Block::from_state_id(block_state.id);
   205	            if self.mirror != Mirror::None {
   206	                block_state = block_registry.mirror(block, block_state.id, self.mirror);
   207	            }
   208	            if self.rotation != Rotation::None {
   209	                block_state = block_registry.rotate(block, block_state.id, self.rotation);
   210	            }
   211	            chunk.set_block_state(pos.x, pos.y, pos.z, block_state);
   212	            schedule_fluid_tick_for_state(chunk, pos.x, pos.y, pos.z, block_state.id);
   213	        }
   214	    }
   215	
   216	    #[expect(clippy::too_many_arguments)]
   217	    pub fn fill_outline_random(
   218	        &self,
   219	        min_x: i32,
   220	        min_y: i32,
   221	        min_z: i32,
   222	        max_x: i32,
   223	        max_y: i32,
   224	        max_z: i32,
   225	        randomizer: &impl BlockRandomizer,
   226	        chunk: &mut ProtoChunk,
   227	        cant_replace_air: bool,
   228	        rng: &mut RandomGenerator,
   229	        box_limit: &BlockBox,
   230	    ) {
   231	        for y in min_y..=max_y {
   232	            for x in min_x..=max_x {
   233	                for z in min_z..=max_z {
   234	                    if cant_replace_air && self.get_block_at(chunk, x, y, z, box_limit).is_air() {
   235	                        continue;
   236	                    }
   237	                    let is_border = x == min_x
   238	                        || x == max_x
   239	                        || y == min_y
   240	                        || y == max_y
   241	                        || z == min_z
   242	                        || z == max_z;
   243	                    let state = randomizer.get_block(rng, is_border);
   244	                    self.add_block(chunk, state, x, y, z, box_limit);
   245	                }
   246	            }
   247	        }
   248	    }

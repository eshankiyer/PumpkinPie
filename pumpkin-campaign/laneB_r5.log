   206	    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   207	        Box::pin(async move {
   208	            if self.cooldown > 0 {
   209	                self.cooldown -= 1;
   210	                return false;
   211	            }
   212	
   213	            let entity = &mob.get_mob_entity().living_entity.entity;
   214	            let world = entity.world.load();
   215	            let origin = Self::block_pos_of(mob);
   216	
   217	            let Some(source) = Self::find_source(&world, origin).await else {
   218	                self.cooldown = mob.get_random().random_range(60..=100);
   219	                return false;
   220	            };
   221	            if Self::find_dest(&world, origin).await.is_none() {
   222	                self.cooldown = mob.get_random().random_range(60..=100);
   223	                return false;
   224	            }
   225	
   226	            self.phase = Phase::ToSource(source);
   227	            true
   228	        })
   229	    }
   230	
   231	    fn should_continue<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   232	        Box::pin(async move { !matches!(self.phase, Phase::Idle) })
   233	    }
   234	
   235	    fn start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   236	        Box::pin(async move {
   237	            if let Phase::ToSource(source) = self.phase {
   238	                Self::walk_to(mob, source, self.speed);
   239	            }
   240	        })
   241	    }
   242	
   243	    fn tick<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   244	        Box::pin(async move {
   245	            if !Self::navigator_idle(mob) {
   246	                return;
   247	            }
   248	
   249	            let entity = &mob.get_mob_entity().living_entity.entity;
   250	            let world = entity.world.load();
   251	
   252	            match self.phase {
   253	                Phase::ToSource(source) => {
   254	                    let origin = Self::block_pos_of(mob);
   255	                    if source.squared_distance(&origin) > 9 {
   256	                        self.phase = Phase::Idle;
   257	                        self.cooldown = mob.get_random().random_range(60..=100);
   258	                        return;
   259	                    }
   260	                    let Some(item) = Self::take_one_item(&world, source).await else {
   261	                        self.phase = Phase::Idle;
   262	                        self.cooldown = mob.get_random().random_range(60..=100);
   263	                        return;
   264	                    };
   265	                    let Some(dest) = Self::find_dest(&world, origin).await else {
   266	                        Self::deposit_item(&world, source, item).await;
   267	                        self.phase = Phase::Idle;
   268	                        return;
   269	                    };
   270	                    self.carried = Some(item);
   271	                    self.phase = Phase::ToDest { source, dest };
   272	                    Self::walk_to(mob, dest, self.speed);
   273	                }
   274	                Phase::ToDest { source, dest } => {
   275	                    if let Some(item) = self.carried.take()
   276	                        && let Some(leftover) = Self::deposit_item(&world, dest, item).await
   277	                    {
   278	                        Self::deposit_item(&world, source, leftover).await;
   279	                    }
   280	                    self.phase = Phase::Idle;
   281	                    self.cooldown = mob.get_random().random_range(60..=100);
   282	                }
   283	                Phase::Idle => {}
   284	            }
   285	        })
   286	    }

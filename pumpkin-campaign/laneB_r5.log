   146	    async fn take_one_item(world: &World, pos: BlockPos) -> Option<ItemStack> {
   147	        let block_entity = world.get_block_entity(&pos)?;
   148	        let inventory = block_entity.get_inventory()?;
   149	        for i in 0..inventory.size() {
   150	            let stack = inventory.get_stack(i).await;
   151	            if !stack.is_empty() {
   152	                return Some(inventory.remove_stack_specific(i, 1).await);
   153	            }
   154	        }
   155	        None
   156	    }
   157	
   158	    async fn deposit_item(world: &World, pos: BlockPos, item: ItemStack) -> Option<ItemStack> {
   159	        let block_entity = world.get_block_entity(&pos)?;
   160	        let inventory = block_entity.get_inventory()?;
   161	        let mut remaining = item;
   162	        for i in 0..inventory.size() {
   163	            let mut stack = inventory.get_stack(i).await;
   164	            if stack.is_empty() {
   165	                inventory.set_stack(i, remaining).await;
   166	                return None;
   167	            }
   168	            if stack.are_items_and_components_equal(&remaining)
   169	                && stack.item_count < stack.get_max_stack_size()
   170	            {
   171	                let space = stack.get_max_stack_size() - stack.item_count;
   172	                let moved = space.min(remaining.item_count);
   173	                stack.item_count += moved;
   174	                inventory.set_stack(i, stack).await;
   175	                remaining.item_count -= moved;
   176	                if remaining.is_empty() {
   177	                    return None;
   178	                }
   179	            }
   180	        }
   181	        Some(remaining)
   182	    }

   750	      private static byte loadFlag(final byte flags, final ValueInput input, final String id, final byte mask) {
   751	         return input.getBooleanOr(id, false) ? (byte)(flags | mask) : flags;
   752	      }
   753	
   754	      @Override
   755	      protected void readAdditionalSaveData(final ValueInput input) {
   756	         super.readAdditionalSaveData(input);
   757	         this.setLineWidth(input.getIntOr("line_width", 200));
   758	         this.setTextOpacity(input.getByteOr("text_opacity", (byte)-1));
   759	         this.setBackgroundColor(input.getIntOr("background", 1073741824));
   760	         byte flags = loadFlag((byte)0, input, "shadow", (byte)1);
   761	         flags = loadFlag(flags, input, "see_through", (byte)2);
   762	         flags = loadFlag(flags, input, "default_background", (byte)4);
   763	         Optional<Display.TextDisplay.Align> alignment = input.read("alignment", Display.TextDisplay.Align.CODEC);
   764	         if (alignment.isPresent()) {
   765	            flags = switch ((Display.TextDisplay.Align)alignment.get()) {
   766	               case CENTER -> flags;
   767	               case LEFT -> (byte)(flags | 8);
   768	               case RIGHT -> (byte)(flags | 16);
   769	            };
   770	         }
   771	
   772	         this.setFlags(flags);
   773	         Optional<Component> text = input.read("text", ComponentSerialization.CODEC);
   774	         if (text.isPresent()) {
   775	            try {
   776	               if (this.level() instanceof ServerLevel serverLevel) {
   777	                  CommandSourceStack context = this.createCommandSourceStackForNameResolution(serverLevel).withPermission(LevelBasedPermissionSet.GAMEMASTER);
   778	                  Component resolvedText = ComponentUtils.resolve(ResolutionContext.create(context), text.get());
   779	                  this.setText(resolvedText);
   780	               } else {
   781	                  this.setText(Component.empty());
   782	               }
   783	            } catch (Exception e) {
   784	               Display.LOGGER.warn("Failed to parse display entity text {}", text, e);
   785	            }
   786	         }
   787	      }
   788	
   789	      private static void storeFlag(final byte flags, final ValueOutput output, final String id, final byte mask) {
   790	         output.putBoolean(id, (flags & mask) != 0);
   791	      }

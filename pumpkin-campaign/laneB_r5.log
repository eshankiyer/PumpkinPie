     3	/// - $`struct_name`: The type of the chest struct (e.g., `ChestBlockEntity`)
     4	/// - $`resource_id`: The resource location string (e.g., "minecraft:chest")
     5	#[macro_export]
     6	macro_rules! impl_block_entity_for_chest {
     7	    ($struct_name:ty) => {
     8	        impl $crate::block::entities::BlockEntity for $struct_name {
     9	            fn resource_location(&self) -> &'static str {
    10	                Self::ID
    11	            }
    12	
    13	            fn get_position(&self) -> BlockPos {
    14	                self.position
    15	            }
    16	
    17	            fn from_nbt(nbt: &pumpkin_nbt::compound::NbtCompound, position: BlockPos) -> Self
    18	            where
    19	                Self: Sized,
    20	            {
    21	                // Read deferred loot-table fields first.
    22	                let loot_table_key = nbt.get_string("LootTable").map(|s| s.to_string());
    23	                let loot_table_seed = nbt.get_long("LootTableSeed").unwrap_or(0);
    24	
    25	                let mut chest = Self {
    26	                    position,
    27	                    items: tokio::sync::RwLock::new(std::array::from_fn(|_| ItemStack::EMPTY.clone())),
    28	                    dirty: std::sync::atomic::AtomicBool::new(false),
    29	                    viewers: $crate::block::viewer::ViewerCountTracker::new(),
    30	                    loot_table: StdMutex::new(loot_table_key),
    31	                    loot_table_seed,
    32	                };
    33	
    34	                // Only read saved items when there is no pending loot table.
    35	                let has_loot_table = chest
    36	                    .loot_table
    37	                    .lock()
    38	                    .unwrap_or_else(std::sync::PoisonError::into_inner)
    39	                    .is_some();
    40	                if !has_loot_table {
    41	                    pumpkin_world::inventory::sync_read_items_from_nbt(nbt, chest.items.get_mut());
    42	                }
    43	
    44	                chest
    45	            }
    46	
    47	            fn write_nbt<'a>(
    48	                &'a self,
    49	                nbt: &'a mut pumpkin_nbt::compound::NbtCompound,
    50	            ) -> std::pin::Pin<Box<dyn std::future::Future<Output = ()> + Send + 'a>> {
    51	                use pumpkin_world::inventory::Inventory;
    52	
    53	                Box::pin(async move {
    54	                    // Clone the loot table key without holding the lock across an await.
    55	                    let loot_table_key = {
    56	                        let guard = self.loot_table.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
    57	                        guard.clone()
    58	                    };
    59	
    60	                    if let Some(key) = loot_table_key {
    61	                        // Persist deferred loot: write the key and seed; skip items.
    62	                        nbt.put_string("LootTable", key);
    63	                        if self.loot_table_seed != 0 {
    64	                            nbt.put_long("LootTableSeed", self.loot_table_seed);
    65	                        }
    66	                    } else {
    67	                        // Loot has already been generated, so persist the actual items.
    68	                        self.write_inventory_nbt(nbt, true).await;
    69	                    }
    70	                })
    71	            }
    72	
    73	            fn tick<'a>(
    74	                &'a self,
    75	                world: &'a Arc<$crate::world::World>,
    76	            ) -> std::pin::Pin<Box<dyn std::future::Future<Output = ()> + Send + 'a>> {
    77	                Box::pin(async move {
    78	                    $crate::block::viewer::ViewerCountTrackerExt::update_viewer_count::<$struct_name>(
    79	                        &self.viewers,
    80	                        self,
    81	                        world,
    82	                        &self.position,
    83	                    )
    84	                    .await;
    85	                })
    86	            }
    87	
    88	            fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn pumpkin_world::inventory::Inventory>> {
    89	                Some(self)
    90	            }
    91	
    92	            fn is_dirty(&self) -> bool {
    93	                self.dirty.load(std::sync::atomic::Ordering::Relaxed)
    94	            }
    95	
    96	            fn clear_dirty(&self) {
    97	                self.dirty
    98	                    .store(false, std::sync::atomic::Ordering::Relaxed);
    99	            }
   100	
   101	            fn chunk_data_nbt(&self) -> Option<pumpkin_nbt::compound::NbtCompound> {
   102	                let mut nbt = pumpkin_nbt::compound::NbtCompound::new();
   103	                let has_loot_table = self.loot_table.lock().unwrap_or_else(std::sync::PoisonError::into_inner).is_some();
   104	                if !has_loot_table {
   105	                    if let Ok(items) = self.items.try_read() {
   106	                        pumpkin_world::inventory::sync_write_items_to_nbt(&*items, &mut nbt);
   107	                    } else {
   108	                        let items = futures::executor::block_on(self.items.read());
   109	                        pumpkin_world::inventory::sync_write_items_to_nbt(&*items, &mut nbt);
   110	                    }
   111	                }
   112	                Some(nbt)
   113	            }
   114	
   115	            fn as_any(&self) -> &dyn std::any::Any {
   116	                self
   117	            }
   118	
   119	            fn take_loot_table(&self) -> Option<(String, i64)> {
   120	                let mut guard = self.loot_table.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
   121	                guard.take().map(|key| (key, self.loot_table_seed))
   122	            }
   123	
   124	            fn has_loot_table(&self) -> bool {
   125	                self.loot_table.lock().unwrap_or_else(std::sync::PoisonError::into_inner).is_some()
   126	            }
   127	        }
   128	    };
   129	}

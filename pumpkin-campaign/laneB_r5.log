   261	   private void updateWeathering(final ServerLevel level, final RandomSource random, final long gameTime) {
   262	      if (this.nextWeatheringTick != -2L) {
   263	         if (this.nextWeatheringTick == -1L) {
   264	            this.nextWeatheringTick = gameTime + random.nextIntBetweenInclusive(504000, 552000);
   265	         } else {
   266	            WeatheringCopper.WeatherState weatherState = this.entityData.get(DATA_WEATHER_STATE);
   267	            boolean isFullyOxidized = weatherState.equals(WeatheringCopper.WeatherState.OXIDIZED);
   268	            if (gameTime >= this.nextWeatheringTick && !isFullyOxidized) {
   269	               WeatheringCopper.WeatherState newState = weatherState.next();
   270	               boolean isNewStateFullyOxidized = newState.equals(WeatheringCopper.WeatherState.OXIDIZED);
   271	               this.setWeatherState(newState);
   272	               this.nextWeatheringTick = isNewStateFullyOxidized ? 0L : this.nextWeatheringTick + random.nextIntBetweenInclusive(504000, 552000);
   273	            }
   274	
   275	            if (isFullyOxidized && this.canTurnToStatue(level)) {
   276	               this.turnToStatue(level);
   277	            }
   278	         }
   279	      }
   280	   }

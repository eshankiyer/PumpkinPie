   286	   private void turnToStatue(final ServerLevel level) {
   287	      BlockPos pos = this.blockPosition();
   288	      level.setBlock(
   289	         pos,
   290	         Blocks.COPPER_GOLEM_STATUE
   291	            .weathering()
   292	            .oxidized()
   293	            .defaultBlockState()
   294	            .setValue(CopperGolemStatueBlock.POSE, CopperGolemStatueBlock.Pose.values()[this.random.nextInt(0, CopperGolemStatueBlock.Pose.values().length)])
   295	            .setValue(CopperGolemStatueBlock.FACING, Direction.fromYRot(this.getYRot())),
   296	         3
   297	      );
   298	      if (level.getBlockEntity(pos) instanceof CopperGolemStatueBlockEntity copperGolemStatueBlockEntity) {
   299	         copperGolemStatueBlockEntity.createStatue(this);
   300	         this.dropPreservedEquipment(level);
   301	         this.discard();
   302	         this.playSound(SoundEvents.COPPER_GOLEM_BECOME_STATUE);
   303	         if (this.isLeashed()) {
   304	            if (level.getGameRules().get(GameRules.ENTITY_DROPS)) {
   305	               this.dropLeash();
   306	            } else {
   307	               this.removeLeash();
   308	            }
   309	         }
   310	      }
   311	   }

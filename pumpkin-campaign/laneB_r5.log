   390	               DamageSource damageSource = this.damageSources().mobAttack(this);
   391	               entity.hurtServer(serverLevel, damageSource, 5.0F);
   392	               EnchantmentHelper.doPostAttackEffects(serverLevel, entity, damageSource);
   393	            }
   394	         }
   395	      }
   396	   }

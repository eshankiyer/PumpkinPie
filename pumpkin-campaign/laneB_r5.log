   204	   @Override
   205	   public InteractionResult mobInteract(final Player player, final InteractionHand hand) {
   206	      ItemStack itemStack = player.getItemInHand(hand);
   207	      if (itemStack.isEmpty()) {
   208	         ItemStack equippedItem = this.getMainHandItem();
   209	         if (!equippedItem.isEmpty()) {
   210	            BehaviorUtils.throwItem(this, equippedItem, player.position());
   211	            this.setItemInHand(InteractionHand.MAIN_HAND, ItemStack.EMPTY);
   212	            return InteractionResult.SUCCESS;
   213	         }
   214	      }
   215	
   216	      Level level = this.level();
   217	      if (itemStack.is(Items.SHEARS) && this.readyForShearing()) {
   218	         if (level instanceof ServerLevel serverLevel) {
   219	            this.shear(serverLevel, SoundSource.PLAYERS, itemStack);
   220	            this.gameEvent(GameEvent.SHEAR, player);
   221	            itemStack.hurtAndBreak(1, player, hand);
   222	         }
   223	
   224	         return InteractionResult.SUCCESS;
   225	      } else {
   226	         if (level.isClientSide()) {
   227	            return InteractionResult.PASS;
   228	         }
   229	
   230	         if (itemStack.is(Items.HONEYCOMB) && this.nextWeatheringTick != -2L) {
   231	            level.levelEvent(this, 3003, this.blockPosition(), 0);
   232	            this.nextWeatheringTick = -2L;
   233	            this.usePlayerItem(player, hand, itemStack);
   234	            return InteractionResult.SUCCESS_SERVER;
   235	         }
   236	
   237	         if (itemStack.is(ItemTags.AXES) && this.nextWeatheringTick == -2L) {
   238	            level.playSound(null, this, SoundEvents.AXE_SCRAPE, this.getSoundSource(), 1.0F, 1.0F);
   239	            level.levelEvent(this, 3004, this.blockPosition(), 0);
   240	            this.nextWeatheringTick = -1L;
   241	            itemStack.hurtAndBreak(1, player, hand.asEquipmentSlot());
   242	            return InteractionResult.SUCCESS_SERVER;
   243	         }
   244	
   245	         if (itemStack.is(ItemTags.AXES)) {
   246	            WeatheringCopper.WeatherState weatherState = this.getWeatherState();
   247	            if (weatherState != WeatheringCopper.WeatherState.UNAFFECTED) {
   248	               level.playSound(null, this, SoundEvents.AXE_SCRAPE, this.getSoundSource(), 1.0F, 1.0F);
   249	               level.levelEvent(this, 3005, this.blockPosition(), 0);
   250	               this.nextWeatheringTick = -1L;
   251	               this.entityData.set(DATA_WEATHER_STATE, weatherState.previous(), true);
   252	               itemStack.hurtAndBreak(1, player, hand.asEquipmentSlot());
   253	               return InteractionResult.SUCCESS_SERVER;
   254	            }
   255	         }
   256	
   257	         return super.mobInteract(player, hand);
   258	      }
   259	   }

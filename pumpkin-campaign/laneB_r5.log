    79	                    break;
    80	                }
    81	                notified.await;
    82	            }
    83	        }
    84	
    85	        let (t_send, mut t_recv) = tokio::sync::mpsc::channel(1000);
    86	
    87	        let batch_len = batch.len();
    88	        let level_clone = level.clone();
    89	
    90	        let fetch_task = tokio::spawn(async move {
    91	            level_clone
    92	                .chunk_saver
    93	                .fetch_chunks(&level_clone.level_folder, &batch, t_send)
    94	                .await;
    95	        });
    96	
    97	        for _ in 0..batch_len {
    98	            let Some(data) = t_recv.recv().await else {
    99	                break;
   100	            };
   101	
   102	            match data {
   103	                Loaded(chunk) => {
   104	                    let pos = ChunkPos::new(chunk.x, chunk.z);
   105	                    if chunk.status == ChunkStatus::Full {
   106	                        // Relighting check
   107	                        let needs_relight = needs_relighting(&chunk, level.lighting_config);
   108	
   109	                        if needs_relight {
   110	                            debug!(
   111	                                "Chunk {pos:?} has uniform lighting, downgrading to Features stage for relighting"
   112	                            );
   113	
   114	                            // Create ProtoChunk using the async method
   115	                            let mut proto =
   116	                                ProtoChunk::from_chunk_data(&chunk, &level.world_gen.load());
   117	
   118	                            // Clear all lighting data
   119	                            let section_count = proto.light.sky_light.len();
   120	                            proto.light.sky_light = (0..section_count)
   121	                                .map(|_| LightContainer::new_empty(15))
   122	                                .collect();
   123	                            proto.light.block_light = (0..section_count)
   124	                                .map(|_| LightContainer::new_empty(0))
   125	                                .collect();
   126	
   127	                            // Set stage to Features
   128	                            proto.stage = StagedChunkEnum::Features;
   129	
   130	                            if send
   131	                                .send((pos, RecvChunk::IO(Chunk::Proto(Box::new(proto)))))
   132	                                .is_err()
   133	                            {
   134	                                break;
   135	                            }
   136	                        } else {
   137	                            // Send fully valid chunk
   138	                            if send
   139	                                .send((pos, RecvChunk::IO(Chunk::Level(chunk))))
   140	                                .is_err()
   141	                            {
   142	                                break;
   143	                            }
   144	                        }
   145	                    } else {
   146	                        // Standard ProtoChunk handling for non-full chunks
   147	                        let val = RecvChunk::IO(Chunk::Proto(Box::new(
   148	                            ProtoChunk::from_chunk_data(&chunk, &level.world_gen.load()),
   149	                        )));
   150	                        if send.send((pos, val)).is_err() {
   151	                            break;
   152	                        }
   153	                    }
   154	                }
   155	                LoadedData::Missing(pos) | LoadedData::Error((pos, _)) => {
   156	                    if send
   157	                        .send((
   158	                            pos,
   159	                            RecvChunk::IO(Chunk::Proto(Box::new(ProtoChunk::new(
   160	                                pos.x,
   161	                                pos.y,
   162	                                &level.world_gen.load(),
   163	                            )))),
   164	                        ))
   165	                        .is_err()
   166	                    {
   167	                        break;
   168	                    }
   169	                }
   170	            }
   171	        }
   172	        let _ = fetch_task.await;
   173	    }
   174	    debug!("io read thread stop");
   175	}

   358	    pub fn golem_interact(&self, player: &Player, item_stack: &mut ItemStack) -> bool {
   359	        if item_stack.item.id == Item::HONEYCOMB.id
   360	            && self.next_weathering_tick.load() != IGNORE_WEATHERING_TICK
   361	        {
   362	            self.next_weathering_tick.store(IGNORE_WEATHERING_TICK);
   363	            item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   364	            self.play_at_self(Sound::ItemHoneycombWaxOn);
   365	            return true;
   366	        }
   367	
   368	        if item_stack.item.has_tag(&tag::Item::MINECRAFT_AXES) {
   369	            if self.next_weathering_tick.load() == IGNORE_WEATHERING_TICK {
   370	                self.next_weathering_tick.store(UNSET_WEATHERING_TICK);
   371	                let _ = item_stack.damage_item(1);
   372	                self.play_at_self(Sound::ItemAxeScrape);
   373	                return true;
   374	            }
   375	
   376	            let state = self.weather_state();
   377	            if state != CopperWeatherState::Unaffected {
   378	                self.next_weathering_tick.store(UNSET_WEATHERING_TICK);
   379	                self.set_weather_state(state.previous());
   380	                let _ = item_stack.damage_item(1);
   381	                self.play_at_self(Sound::ItemAxeScrape);
   382	                return true;
   383	            }
   384	        }
   385	
   386	        false
   387	    }
   388	}

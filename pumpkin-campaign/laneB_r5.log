   862	    fn drop_node(&mut self, node: NodeKey) {
   863	        let Some(old) = self.graph.nodes.remove(node) else {
   864	            return;
   865	        };
   866	        let mut edge = old.edge;
   867	        while !edge.is_null() {
   868	            let cur = self.graph.edges.remove(edge).expect("edge exists");
   869	            if let Some(node) = self.graph.nodes.get_mut(cur.to) {
   870	                debug_assert!(node.in_degree >= 1);
   871	                node.in_degree -= 1;
   872	                if node.in_degree == 0 && !node.in_queue {
   873	                    // Don't queue if parked in waiting_for_chunks — check_waiting_tasks()
   874	                    // will re-queue it once chunk data arrives.
   875	                    if !self.waiting_for_chunks.contains(&cur.to) {
   876	                        self.queue.push(TaskHeapNode(
   877	                            Self::calc_priority(
   878	                                &self.last_level,
   879	                                &self.last_high_priority,
   880	                                node.pos,
   881	                                node.stage,
   882	                            ),
   883	                            cur.to,
   884	                        ));
   885	                        node.in_queue = true;
   886	                    }
   887	                }
   888	            }
   889	            edge = cur.next;
   890	        }
   891	    }
   892	
   893	    fn drop_satisfied_tasks(&mut self, holder: &mut ChunkHolder, stage: StagedChunkEnum) {
   894	        // A neighboring generation cache may already have advanced this holder past the
   895	        // returning task's stage. Drop every scheduled task satisfied by the returned data,
   896	        // including that task's stale in-flight node.
   897	        for task_idx in (StagedChunkEnum::None as usize + 1)..=(stage as usize) {
   898	            if !holder.tasks[task_idx].is_null() {
   899	                self.waiting_for_chunks.remove(&holder.tasks[task_idx]);
   900	                self.drop_node(holder.tasks[task_idx]);
   901	                holder.tasks[task_idx] = NodeKey::null();
   902	            }
   903	        }
   904	    }
   905	
   906	    #[expect(clippy::too_many_lines)]
   907	    /// `dim_sections` is the dimension's full section count (`dimension.height / 16`), which is
   908	    /// what the client reads from the chunk-data packet. Chunks arriving here can be shorter than
   909	    /// that - notably any Nether/End chunk saved while worldgen was sizing sections off the noise
   910	    /// generator's 128-block `shape.height` - and a short chunk serializes short, disconnecting the
   911	    /// client with a protocol error. Pad on the way in so nothing downstream has to care.
   912	    fn receive_chunk(
   913	        &mut self,
   914	        pos: ChunkPos,
   915	        data: RecvChunk,
   916	        dim_sections: usize,
   917	        dim_sky_light: u8,
   918	    ) {
   919	        match data {
   920	            RecvChunk::IO(chunk) => {
   921	                if let Chunk::Level(data) = &chunk {
   922	                    data.pad_sections_to(dim_sections, dim_sky_light);
   923	                }
   924	                let Some(mut holder) = self.chunk_map.remove(&pos) else {
   925	                    warn!("receive_chunk(IO): missing holder for {:?}", pos);
   926	                    return;
   927	                };
   928	                if holder.chunk.is_some() {
   929	                    warn!(
   930	                        "receive_chunk(IO): holder already has chunk at {:?}; replacing",
   931	                        pos
   932	                    );
   933	                }
   934	                debug_assert_eq!(holder.current_stage, StagedChunkEnum::None);
   935	
   936	                let stage = StagedChunkEnum::from(chunk.get_stage_id());
   937	                self.drop_satisfied_tasks(&mut holder, stage);
   938	                holder.current_stage = stage;
   939	                debug_assert!(self.graph.nodes.contains_key(holder.occupied));
   940	                self.drop_node(holder.occupied);

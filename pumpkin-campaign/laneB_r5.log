    68	    fn write_nbt<'a>(
    69	        &'a self,
    70	        nbt: &'a mut NbtCompound,
    71	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    72	        Box::pin(async move {
    73	            if let Some(sh) = self.sherds.lock().await.as_ref() {
    74	                nbt.put_list("sherds", sh.clone());

   131	/// Implements the Inventory trait for chest-like block entities.
   132	#[macro_export]
   133	macro_rules! impl_inventory_for_chest {
   134	    ($struct_name:ty) => {
   135	        impl pumpkin_world::inventory::Inventory for $struct_name {
   136	            fn size(&self) -> usize {
   137	                Self::INVENTORY_SIZE
   138	            }
   139	
   140	            fn is_empty(&self) -> pumpkin_world::inventory::InventoryFuture<'_, bool> {
   141	                Box::pin(async move {
   142	                    let items = self.items.read().await;
   143	                    items.iter().all(|s| s.is_empty())
   144	                })
   145	            }
   146	
   147	            fn get_stack(
   148	                &self,
   149	                slot: usize,
   150	            ) -> pumpkin_world::inventory::InventoryFuture<'_, ItemStack> {
   151	                Box::pin(async move {
   152	                    let items = self.items.read().await;
   153	                    items[slot].clone()
   154	                })
   155	            }
   156	
   157	            fn remove_stack(
   158	                &self,
   159	                slot: usize,
   160	            ) -> pumpkin_world::inventory::InventoryFuture<'_, ItemStack> {
   161	                Box::pin(async move {
   162	                    let mut items = self.items.write().await;
   163	                    let removed = std::mem::replace(&mut items[slot], ItemStack::EMPTY.clone());
   164	                    self.mark_dirty();
   165	                    removed
   166	                })
   167	            }
   168	
   169	            fn remove_stack_specific(
   170	                &self,
   171	                slot: usize,
   172	                amount: u8,
   173	            ) -> pumpkin_world::inventory::InventoryFuture<'_, ItemStack> {
   174	                Box::pin(async move {
   175	                    let mut items = self.items.write().await;
   176	                    let res = if !items[slot].is_empty() && amount > 0 {
   177	                        items[slot].split(amount)
   178	                    } else {
   179	                        ItemStack::EMPTY.clone()
   180	                    };
   300	                        // Also update neighbors of the block below (strongly powered block)
   301	                        // This ensures redstone components adjacent to the block below are notified
   302	                        let below_pos = position.down();
   303	                        world.clone().update_neighbors(&below_pos, None).await;
   304	                    }
   305	                })
   306	            }
   307	        }
   308	    };
   309	}

    16	/// Ports the item-fetching half of vanilla's `TransportItemsBetweenContainers` behavior
    17	/// (`CopperGolemAi.initIdleActivity`): a copper golem walks to a nearby copper chest,
    18	/// takes one item, then walks it to a nearby chest/trapped chest and drops it in.
    19	///
    20	/// Search radii (32 blocks horizontal, 8 vertical) match
    21	/// `CopperGolemAi.TRANSPORT_ITEM_HORIZONTAL_SEARCH_RADIUS` / `_VERTICAL_SEARCH_RADIUS`.
    22	///
    23	/// Deferred vs. vanilla: the real behavior queues on contested containers via
    24	/// `ContainerOpenersCounter`/`shouldQueueForTarget` and plays a five-state open/close
    25	/// animation (`CopperGolemState`) timed to ticks 1/9/60 after arrival. Pumpkin has no
    26	/// `ContainerUser` plumbing for mobs, so this goal performs the pickup/drop instantly on
    27	/// arrival instead of over that animation window.
    28	const HORIZONTAL_RADIUS: i32 = 32;
    29	const VERTICAL_RADIUS: i32 = 8;
    30	const CHUNK_RADIUS: i32 = (HORIZONTAL_RADIUS + 15) / 16;
    31	

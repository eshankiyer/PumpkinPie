    59	pub async fn io_read_work(
    60	    recv: crossfire::compat::MAsyncRx<Vec<ChunkPos>>,
    61	    send: crossfire::compat::MTx<(ChunkPos, RecvChunk)>,
    62	    level: Arc<Level>,
    63	    lock: IOLock,
    64	) {
    65	    debug!("io read thread start");
    66	
    67	    // Cleaner loop and async recv
    68	    while let Ok(batch) = recv.recv().await {
    69	        for pos in &batch {
    70	            // Lock handling
    71	            loop {
    72	                let notified = lock.1.notified();
    73	                if !lock
    74	                    .0
    75	                    .lock()
    76	                    .unwrap_or_else(std::sync::PoisonError::into_inner)
    77	                    .contains_key(pos)

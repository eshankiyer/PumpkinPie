   177	pub async fn io_write_work(recv: AsyncRx<Vec<(ChunkPos, Chunk)>>, level: Arc<Level>, lock: IOLock) {
   178	    loop {
   179	        // Don't check cancel_token here (keep saving chunks)
   180	        let Ok(data) = recv.recv().await else { break };
   181	        // debug!("io write thread receive chunks size {}", data.len());
   182	        let mut vec = Vec::with_capacity(data.len());
   183	        let mut positions = Vec::with_capacity(data.len());
   184	        for (pos, chunk) in data {
   185	            positions.push(pos);
   186	
   187	            match chunk {
   188	                Chunk::Level(chunk) => vec.push((pos, chunk)),
   189	                Chunk::Proto(chunk) => {
   190	                    let mut temp = Chunk::Proto(chunk);
   191	                    temp.upgrade_to_level_chunk(
   192	                        level.world_gen.load().dimension(),
   193	                        &level.lighting_config,
   194	                    );
   195	                    let Chunk::Level(chunk) = temp else { panic!() };
   196	                    vec.push((pos, chunk));
   197	                }
   198	            }
   199	        }
   200	        if let Err(e) = level
   201	            .chunk_saver
   202	            .save_chunks(&level.level_folder, vec)
   203	            .await
   204	        {
   205	            error!("Failed to save chunks: {:?}", e);
   206	        }
   207	
   208	        for i in positions {
   209	            let mut data = lock
   210	                .0
   211	                .lock()
   212	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   213	            match data.entry(i) {
   214	                Entry::Occupied(mut entry) => {
   215	                    let rc = entry.get_mut();
   216	                    if *rc == 1 {
   217	                        entry.remove();
   218	                        drop(data);
   219	                        lock.1.notify_waiters();
   220	                    } else {
   221	                        *rc -= 1;
   222	                    }
   223	                }
   224	                Entry::Vacant(_) => {
   225	                    warn!(
   226	                        "io_write: attempted to release missing lock entry for {:?}",
   227	                        i
   228	                    );
   229	                    // continue without panicking to avoid crashing on shutdown races
   230	                }
   231	            }
   232	        }
   233	    }
   234	}

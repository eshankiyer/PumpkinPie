   354	    pub async fn set_phase(&self, phase_type: EnderDragonPhase) {
   355	        let mut phase_lock = self.phase.lock().await;
   356	        if *phase_lock == phase_type {
   357	            return;
   358	        }
   359	
   360	        let old_phase = self.phase_manager.get_phase(*phase_lock);
   361	        old_phase.end(self).await;
   362	
   363	        *phase_lock = phase_type;
   364	
   365	        let new_phase = self.phase_manager.get_phase(phase_type);
   366	        new_phase.begin(self).await;
   367	    }

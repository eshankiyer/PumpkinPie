   386	   private void updateCulling() {
   387	      float width = this.getWidth();
   388	      float height = this.getHeight();
   389	      this.noCulling = width == 0.0F || height == 0.0F;
   390	      float w = width / 2.0F;
   391	      double x = this.getX();
   392	      double y = this.getY();
   393	      double z = this.getZ();
   394	      this.cullingBoundingBox = new AABB(x - w, y, z - w, x + w, y + height, z + w);
   395	   }

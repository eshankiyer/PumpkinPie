   243	#[test]
   244	fn completed_proto_stage_drops_all_satisfied_tasks() {
   245	    let mut graph = DAG::default();
   246	    let mut holder = ChunkHolder {
   247	        current_stage: StagedChunkEnum::None,
   248	        target_stage: StagedChunkEnum::StructureStart,
   249	        ..Default::default()
   250	    };
   251	
   252	    for stage in StagedChunkEnum::Empty as usize..=StagedChunkEnum::StructureStart as usize {
   253	        holder.tasks[stage] = graph.nodes.insert(Node::new(
   254	            ChunkPos::new(0, 0),
   255	            StagedChunkEnum::from(stage as u8),
   256	        ));
   257	    }
   258	
   259	    for stage in StagedChunkEnum::Empty as usize..StagedChunkEnum::StructureStart as usize {
   260	        graph.add_edge(holder.tasks[stage], holder.tasks[stage + 1]);
   261	    }
   262	
   263	    let returned_stage = StagedChunkEnum::Biomes as usize;
   264	    for task_idx in
   265	        (holder.current_stage as usize + 1)..=(returned_stage).min(holder.tasks.len() - 1)
   266	    {
   267	        if !holder.tasks[task_idx].is_null() {
   268	            if let Some(old) = graph.nodes.remove(holder.tasks[task_idx]) {
   269	                let mut edge = old.edge;
   270	                while !edge.is_null() {
   271	                    let cur = graph.edges.remove(edge).unwrap();
   272	                    if let Some(node) = graph.nodes.get_mut(cur.to) {
   273	                        node.in_degree -= 1;
   274	                    }
   275	                    edge = cur.next;
   276	                }
   277	            }
   278	            holder.tasks[task_idx] = NodeKey::null();
   279	        }
   280	    }
   281	
   282	    assert!(holder.tasks[StagedChunkEnum::Empty as usize].is_null());
   283	    assert!(holder.tasks[StagedChunkEnum::Biomes as usize].is_null());
   284	    assert!(!holder.tasks[StagedChunkEnum::StructureStart as usize].is_null());
   285	    assert!(
   286	        graph
   287	            .nodes
   288	            .get(holder.tasks[StagedChunkEnum::StructureStart as usize])
   289	            .is_some()
   290	    );
   291	}

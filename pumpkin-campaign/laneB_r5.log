   101	    async fn find_nearest<F, C, Fut>(
   102	        world: &World,
   103	        origin: BlockPos,
   104	        block_matches: F,
   105	        candidate_ok: C,
   106	    ) -> Option<BlockPos>
   107	    where
   108	        F: Fn(&World, &BlockPos) -> bool,
   109	        C: Fn(Arc<dyn crate::block::entities::BlockEntity>) -> Fut,
   110	        Fut: Future<Output = bool>,
   111	    {
   112	        let origin_chunk = origin.chunk_position();
   113	        let mut best: Option<(BlockPos, i32)> = None;
   114	
   115	        for dx in -CHUNK_RADIUS..=CHUNK_RADIUS {
   116	            for dz in -CHUNK_RADIUS..=CHUNK_RADIUS {
   117	                let chunk = Vector2::new(origin_chunk.x + dx, origin_chunk.y + dz);
   118	                let Some(entries) = world.block_entities.get(&chunk) else {
   119	                    continue;
   120	                };
   121	                for (pos, block_entity) in entries.iter() {
   122	                    let dist_h = (pos.0.x - origin.0.x)
   123	                        .abs()
   124	                        .max((pos.0.z - origin.0.z).abs());
   125	                    let dist_v = (pos.0.y - origin.0.y).abs();
   126	                    if dist_h > HORIZONTAL_RADIUS || dist_v > VERTICAL_RADIUS {
   127	                        continue;
   128	                    }
   129	                    if !block_matches(world, pos) {
   130	                        continue;
   131	                    }
   132	                    if !candidate_ok(block_entity.clone()).await {
   133	                        continue;
   134	                    }
   135	                    let score = dist_h + dist_v;
   136	                    if best.is_none_or(|(_, best_score)| score < best_score) {
   137	                        best = Some((*pos, score));
   138	                    }
   139	                }
   140	            }
   141	        }
   142	
   143	        best.map(|(pos, _)| pos)
   144	    }

   784	impl From<&RecipeResultStruct> for ItemStack {
   785	    fn from(value: &RecipeResultStruct) -> Self {
   786	        // A recipe result can carry components of its own - a suspicious stew's effect is
   787	        // the only one in 26.2 - and dropping them here is why a crafted stew did nothing.
   788	        Self::new_with_component(
   789	            value.count,
   790	            Item::from_registry_key(value.id.strip_prefix("minecraft:").unwrap_or(value.id))
   791	                .unwrap_or(&Item::AIR),
   792	            value.component_patch(),
   793	        )
   794	    }
   795	}

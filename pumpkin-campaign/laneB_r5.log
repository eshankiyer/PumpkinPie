   347	    /// `CopperGolem.mobInteract`: honeycomb waxes (freezes weathering), axe on a waxed golem
   348	    /// un-waxes it, axe on a weathered-but-unwaxed golem scrapes back one stage.
   349	    ///
   350	    fn play_at_self(&self, sound: Sound) {
   351	        let entity = &self.mob_entity.living_entity.entity;
   352	        entity
   353	            .world
   354	            .load()
   355	            .play_sound(sound, SoundCategory::Blocks, &entity.pos.load());
   356	    }

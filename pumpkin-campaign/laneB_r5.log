    75	        | StructureKeys::VillageTaiga
    76	        | StructureKeys::AncientCity
    77	        | StructureKeys::BastionRemnant
    78	        | StructureKeys::PillagerOutpost
    79	        | StructureKeys::TrailRuins
    80	        | StructureKeys::TrialChambers => {
    81	            let (Some(start_pool), Some(size)) = (structure.start_pool, structure.size) else {
    82	                return None;
    83	            };
    84	            let mut generator =
    85	                JigsawGenerator::new(start_pool, size).with_pool_aliases(structure.pool_aliases);
    86	            if structure.use_expansion_hack.unwrap_or(false) {
    87	                generator = generator.with_expansion_hack(true);

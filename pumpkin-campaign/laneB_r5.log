   613	    fn find_nearest_player(&self) -> Option<Arc<Player>> {
   614	        let world = self.mob_entity.living_entity.entity.world.load();
   615	        let pos = self.mob_entity.living_entity.entity.pos.load();
   616	        world
   617	            .players
   618	            .load()
   619	            .iter()
   620	            .filter(|p| {
   621	                let p_pos = p.living_entity.entity.pos.load();
   622	                p_pos.distance_squared(pos) < ARENA_RADIUS * ARENA_RADIUS
   623	            })
   624	            .min_by(|a, b| {
   625	                let a_pos = a.living_entity.entity.pos.load();
   626	                let b_pos = b.living_entity.entity.pos.load();
   627	                a_pos
   628	                    .distance_squared(pos)
   629	                    .total_cmp(&b_pos.distance_squared(pos))
   630	            })
   631	            .cloned()
   632	    }
   633	
   634	    async fn handle_player_collisions(&self) {
   635	        let world = self.mob_entity.living_entity.entity.world.load();
   636	
   637	        let dragon_bbox = self.mob_entity.living_entity.entity.bounding_box.load();
   638	        let xm = f64::midpoint(dragon_bbox.min.x, dragon_bbox.max.x);
   639	        let zm = f64::midpoint(dragon_bbox.min.z, dragon_bbox.max.z);
   640	
   641	        for player in world.players.load().iter() {
   642	            if player
   643	                .living_entity
   644	                .entity
   645	                .bounding_box
   646	                .load()
   647	                .intersects(&dragon_bbox)
   648	            {
   649	                let player_pos = player.get_entity().pos.load();
   650	                let xd = player_pos.x - xm;
   651	                let zd = player_pos.z - zm;
   652	                let dd = (xd * xd + zd * zd).max(0.1);
   653	
   654	                let resistance = player
   655	                    .living_entity
   656	                    .get_attribute_value(&Attributes::KNOCKBACK_RESISTANCE);
   657	                player.living_entity.entity.apply_knockback(
   658	                    4.0 * (1.0 - resistance).max(0.0),
   659	                    xd / dd,
   660	                    zd / dd,
   661	                );
   662	                player.get_entity().send_velocity();
   663	
   664	                if !self.phase.lock().await.is_sitting() {
   665	                    player.damage(self, 5.0, DamageType::MOB_ATTACK).await;
   666	                }
   667	            }
   668	        }
   669	    }
   670	
   671	    fn tick_crystal_healing(&self) {
   672	        let world = self.mob_entity.living_entity.entity.world.load();
   673	        let pos = self.mob_entity.living_entity.entity.pos.load();
   674	
   675	        let mut nearest_crystal = None;
   676	        let mut min_dist_sq = 1024.0; // 32 blocks
   677	
   678	        for entity in world.entities.load().iter() {
   679	            if entity.get_entity().entity_type == &EntityType::END_CRYSTAL {
   680	                let crystal_pos = entity.get_entity().pos.load();
   681	                let dist_sq = pos.distance_squared(crystal_pos);
   682	                if dist_sq < min_dist_sq {
   683	                    min_dist_sq = dist_sq;
   684	                    nearest_crystal = Some(entity.clone());
   685	                }
   686	            }
   687	        }
   688	
   689	        if let Some(_crystal) = nearest_crystal {
   690	            let living = &self.mob_entity.living_entity;

   391	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   392	        Box::pin(async move {
   393	            self.mob_entity.living_entity.write_nbt(nbt).await;
   394	            nbt.put_long("next_weather_age", self.next_weathering_tick.load());
   395	            nbt.put_string("weather_state", self.weather_state().as_str().to_string());
   396	        })
   397	    }

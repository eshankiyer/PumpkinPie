   260	    /// TODO: will remove at some point
   261	    pub(crate) fn restore_ready_tasks(
   262	        graph: &mut DAG,
   263	        queue: &mut BinaryHeap<TaskHeapNode>,
   264	        chunk_map: &HashMap<ChunkPos, ChunkHolder>,
   265	        last_level: &ChunkLevel,
   266	        last_high_priority: &[ChunkPos],
   267	        waiting_for_chunks: &HashSetType<NodeKey>,
   268	    ) -> usize {
   269	        debug_assert!(queue.is_empty());
   270	
   271	        let mut ready = Vec::new();
   272	        for (key, node) in &mut graph.nodes {
   273	            if node.stage == StagedChunkEnum::None
   274	                || node.in_degree != 0
   275	                || node.in_queue
   276	                || node.in_flight
   277	                || waiting_for_chunks.contains(&key)
   278	            {
   279	                continue;
   280	            }
   281	            let Some(holder) = chunk_map.get(&node.pos) else {
   282	                continue;
   283	            };
   284	            if holder.current_stage >= node.stage || holder.tasks[node.stage as usize] != key {
   285	                continue;
   286	            }
   287	            ready.push((key, node.pos, node.stage));
   288	        }
   289	
   290	        for (key, pos, stage) in &ready {
   291	            let Some(node) = graph.nodes.get_mut(*key) else {
   292	                continue;
   293	            };
   294	            node.in_queue = true;
   295	            queue.push(TaskHeapNode(
   296	                Self::calc_priority(last_level, last_high_priority, *pos, *stage),
   297	                *key,
   298	            ));
   299	        }
   300	
   301	        ready.len()
   302	    }
   303	
   304	    /// Ensure that the dependency chain for `req_stage` exists on `holder` (for chunk at
   305	    /// `chunk_pos`) and wire it to depend on `dependency_task`.
   306	    ///
   307	    /// Bumps `holder.dependency_stage` (NOT `target_stage`) to at least `req_stage` so
   308	    /// that neighbor chunks pulled in as generation dependencies are not discarded before
   309	    /// their dependency is satisfied. `target_stage` is left alone so the level-change
   310	    /// bookkeeping invariant (`old_stage == holder.target_stage`) is never violated.
   311	    #[allow(clippy::too_many_arguments)]
   312	    pub(crate) fn ensure_dependency_chain(
   313	        graph: &mut DAG,
   314	        queue: &mut BinaryHeap<TaskHeapNode>,
   315	        last_level: &ChunkLevel,
   316	        last_high_priority: &[ChunkPos],
   317	        dependency_task: NodeKey,
   318	        chunk_pos: ChunkPos,
   319	        holder: &mut ChunkHolder,
   320	        req_stage: StagedChunkEnum,
   321	    ) {
   322	        // Insert occupied_by edge head
   323	        holder.occupied_by = graph.edges.insert(crate::chunk_system::dag::Edge::new(
   324	            dependency_task,
   325	            holder.occupied_by,
   326	        ));
   327	
   328	        if !holder.occupied.is_null() {
   329	            graph.add_edge(holder.occupied, dependency_task);
   330	        }
   331	
   332	        // Bump dependency_stage so this chunk's IO/generation tasks are scheduled and
   333	        // kept alive even if target_stage is None (outside player view radius).
   334	        // We deliberately do NOT touch target_stage — that field is owned by resort_work
   335	        // and must match the level-change bookkeeping or the debug_assert will fire.
   336	        if holder.dependency_stage < req_stage {
   337	            holder.dependency_stage = req_stage;
   338	        }
   339	
   340	        // Effective target is the max of what the player wants and what dependencies need.
   341	        let effective_target = holder.target_stage.max(holder.dependency_stage);
   342	
   343	        // Create any missing tasks from current_stage+1 up to effective_target.
   344	        // We do this even when current_stage >= req_stage, because dependency_stage may
   345	        // require tasks beyond req_stage that haven't been created yet.
   346	        if holder.current_stage < effective_target {
   347	            let empty = StagedChunkEnum::Empty as usize;
   348	            let start = (holder.current_stage as usize + 1).max(empty);
   349	            let end = effective_target as u8 as usize;
   350	            let mut newly_created = [false; StagedChunkEnum::COUNT];
   351	
   352	            for (i, flag) in newly_created[start..=end].iter_mut().enumerate() {
   353	                let stage_i = start + i;
   354	                if holder.tasks[stage_i].is_null() {
   355	                    let new_node = graph
   356	                        .nodes
   357	                        .insert(Node::new(chunk_pos, StagedChunkEnum::from(stage_i as u8)));
   358	                    holder.tasks[stage_i] = new_node;
   359	                    *flag = true;
   360	                    if !holder.occupied.is_null() {
   361	                        graph.add_edge(holder.occupied, new_node);
   362	                    }
   363	                }
   364	            }
   365	
   366	            for stage_i in start..=end {
   367	                if !newly_created[stage_i] {
   368	                    continue;
   369	                }
   370	                let cur = holder.tasks[stage_i];
   371	
   372	                if stage_i > empty {
   373	                    let prev = holder.tasks[stage_i - 1];
   374	                    if !prev.is_null() {
   375	                        graph.add_edge(prev, cur);
   376	                    }
   377	                }
   378	                if stage_i < end {
   379	                    let next = holder.tasks[stage_i + 1];
   380	                    if !next.is_null() && !newly_created[stage_i + 1] {
   840	
   841	        info!(
   842	            "Saving {} chunks (collected from {} holders)...",
   843	            chunks.len(),
   844	            self.chunk_map.len()
   845	        );
   846	
   847	        let mut data = self
   848	            .io_lock
   849	            .0
   850	            .lock()
   851	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   852	        for (pos, _) in &chunks {
   853	            *data.entry(*pos).or_insert(0) += 1;
   854	        }
   855	        drop(data);
   856	
   857	        if let Err(e) = self.io_write.send(chunks) {
   858	            error!("Failed to send chunks to io write thread: {:?}", e);
   859	        }
   860	    }

   293	impl EnderDragonEntity {
   294	    pub fn new(entity: Entity) -> Arc<Self> {
   295	        entity.no_clip.store(true, Ordering::Relaxed);
   296	        let base_id = entity.entity_id;
   297	        let dragon_uuid = entity.entity_uuid;
   298	        let world = entity.world.load();
   299	
   300	        let _ = Entity::reserve_ids(8);
   301	
   302	        let mut parts = Vec::new();
   303	        for i in 1..=8 {
   304	            let part_entity = Entity::from_uuid_with_id(
   305	                base_id + i,
   306	                uuid::Uuid::new_v4(),
   307	                world.clone(),
   308	                entity.pos.load(),
   309	                &EntityType::ENDER_DRAGON,
   310	            );
   311	            let part = Arc::new(EnderDragonPart::new(part_entity, dragon_uuid));
   312	            parts.push(part);
   313	        }
   314	
   315	        Arc::new(Self {
   316	            mob_entity: MobEntity::new(entity),
   317	            parts,
   318	            parts_registered: AtomicBool::new(false),
   319	            flight_history: Mutex::new(DragonFlightHistory::default()),

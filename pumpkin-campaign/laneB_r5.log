    28	/// Checks if a chunk needs relighting based on the current lighting configuration
    29	/// Returns true if the chunk has uniform lighting (from full/dark mode) but the server
    30	/// is now running in default mode (which needs proper lighting calculation)
    31	fn needs_relighting(chunk: &crate::chunk::ChunkData, config: LightingEngineConfig) -> bool {
    32	    if config != LightingEngineConfig::Default {
    33	        return false;
    34	    }
    35	
    36	    // If the chunk says it's already lit, believe it.
    37	    if chunk.light_populated.load(Relaxed) {
    38	        return false;
    39	    }
    40	
    41	    let engine = chunk
    42	        .light_engine
    43	        .lock()
    44	        .unwrap_or_else(std::sync::PoisonError::into_inner);
    45	
    46	    // Scan for any complex lighting data
    47	    let has_complex_light = engine.sky_light.iter().any(|lc| match lc {
    48	        LightContainer::Full(data) => data.iter().any(|&b| b != 0x00 && b != 0xFF),
    49	        LightContainer::Empty(val) => *val != 0 && *val != 15,
    50	    }) || engine.block_light.iter().any(|lc| match lc {
    51	        LightContainer::Full(data) => data.iter().any(|&b| b != 0x00 && b != 0xFF),
    52	        LightContainer::Empty(val) => *val != 0 && *val != 15,
    53	    });
    54	
    55	    // If it has complex light, we don't need to relight.
    56	    !has_complex_light
    57	}

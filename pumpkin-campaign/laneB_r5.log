   551	    /// Collects the ticks due for active chunks using a snapshot of the world's random-tick rule.
   552	    ///
   553	    /// The caller owns the game-rule snapshot so this crate stays independent from the server's
   554	    /// atomic world-info store. Negative values intentionally produce no samples, as vanilla's
   555	    /// `for (int i = 0; i < tickSpeed; i++)` loop does.
   556	    pub fn get_tick_data(
   557	        &self,
   558	        active_chunks: &FxHashSet<Vector2<i32>>,
   559	        random_tick_speed: i64,
   560	    ) -> TickData {
   561	        let random_tick_samples_per_section = random_tick_samples_per_section(random_tick_speed);
   562	        let mut ticks = TickData {
   563	            block_ticks: Vec::new(),
   564	            fluid_ticks: Vec::new(),
   565	            // This is only a small initial allocation: a sampled block may not actually tick,
   566	            // and an arbitrarily large game-rule value must not cause eager allocation.
   567	            random_ticks: Vec::with_capacity(active_chunks.len() * 3),
   568	        };
   569	
   570	        // 1. Process active chunks (random ticks, block entities)
   571	        for pos in active_chunks {
   572	            if let Some(chunk) = self.loaded_chunks.get(pos) {
   573	                let chunk = chunk.value();
   574	                let chunk_x_base = chunk.x * 16;
   575	                let chunk_z_base = chunk.z * 16;
   576	                let section_count = chunk.section.section_count();
   577	
   578	                // Use the bitmask to skip sections
   579	                let mask = chunk.section.randomly_ticking_mask.load(Ordering::Relaxed);
   580	                if mask != 0 {
   581	                    let sections = chunk
   582	                        .section
   583	                        .block_sections
   584	                        .read()
   585	                        .unwrap_or_else(std::sync::PoisonError::into_inner);
   586	                    let min_y = chunk.section.min_y;
   587	
   588	                    for i in 0..section_count {
   589	                        if (mask & (1 << i)) == 0 {
   590	                            continue;
   591	                        }
   592	                        let y_base = min_y + (i as i32 * 16);
   593	                        for _ in 0..random_tick_samples_per_section {
   594	                            let r = rand::random::<u32>();
   595	                            let x_offset = (r & 0xF) as usize;
   596	                            let z_offset = (r >> 8 & 0xF) as usize;
   597	                            let y_in_section = ((r >> 4) & 0xF) as usize;
   598	
   599	                            let block_state_id = sections[i].get(x_offset, y_in_section, z_offset);
   600	                            let tick_block = has_random_ticks(block_state_id);
   601	                            let tick_fluid = has_random_ticking_fluid(block_state_id);
   602	                            if tick_block || tick_fluid {
   603	                                ticks.random_ticks.push(RandomTickSample {
   604	                                    position: BlockPos::new(
   605	                                        chunk_x_base + x_offset as i32,
   606	                                        y_base + y_in_section as i32,
   607	                                        chunk_z_base + z_offset as i32,
   608	                                    ),
   609	                                    tick_block,
   610	                                    tick_fluid,
   611	                                });
   612	                            }
   613	                        }
   614	                    }
   615	                }
   616	            }
   617	        }
   618	
   619	        // 2. Process chunks with scheduled ticks
   620	        // We collect keys first to avoid holding DashSet shard lock while accessing loaded_chunks (deadlock risk)
   621	        let scheduled_chunk_pos: Vec<_> = self
   622	            .chunks_with_scheduled_ticks
   623	            .iter()
   624	            .map(|p| *p)
   625	            .collect();
   626	        for pos in scheduled_chunk_pos {
   627	            if let Some(chunk) = self.loaded_chunks.get(&pos) {
   628	                let chunk = chunk.value();
   629	                ticks.block_ticks.append(&mut chunk.block_ticks.step_tick());
   630	                ticks.fluid_ticks.append(&mut chunk.fluid_ticks.step_tick());
   631	
   632	                // Remove from set if it no longer has ticks
   633	                if !chunk.block_ticks.has_ticks() && !chunk.fluid_ticks.has_ticks() {
   634	                    self.chunks_with_scheduled_ticks.remove(&pos);
   635	                }
   636	            } else {
   637	                self.chunks_with_scheduled_ticks.remove(&pos); // Chunk unloaded
   638	            }
   639	        }
   640	
   641	        ticks.block_ticks.sort_unstable();
   642	        ticks.fluid_ticks.sort_unstable();
   643	
   644	        ticks
   645	    }

   841	/// `StructurePiece.reorient` (`world/level/levelgen/structure/StructurePiece.java:406-448`).
   842	///
   843	/// Turns a horizontally-facing block (in practice a dungeon chest) so its front points away
   844	/// from the one wall beside it. Vanilla's rules, in order:
   845	///
   846	/// * a chest in any horizontal neighbour leaves the state untouched, so a double chest keeps
   847	///   the facing its first half already chose;
   848	/// * exactly one solid-render neighbour means face the opposite way;
   849	/// * anything else falls back to the state's own facing, flipped away from whichever
   850	///   neighbours are solid (opposite, then clockwise, then opposite again).
   851	///
   852	/// Note this is `isSolidRender`, not "not air": water, torches and cave vines are not walls.
   853	pub fn reorient<T: GenerationCache>(
   854	    cache: &T,
   855	    pos: &Vector3<i32>,
   856	    block: &'static Block,
   857	    state: &'static BlockState,
   858	) -> &'static BlockState {
   859	    let solid_at = |dir: HorizontalFacing| {
   860	        GenerationCache::get_block_state(cache, &pos.add(&dir.to_offset()))
   861	            .to_state()
   862	            .is_solid_render()
   863	    };
   864	
   865	    let mut solid_neighbor = None;
   866	    for dir in pumpkin_data::BlockDirection::horizontal_worldgen() {
   867	        let neighbor = GenerationCache::get_block_state(cache, &pos.add(&dir.to_offset()));
   868	        if neighbor.to_block() == &Block::CHEST {
   869	            return state;
   870	        }
   871	        if neighbor.to_state().is_solid_render() {
   872	            if solid_neighbor.is_some() {
   873	                solid_neighbor = None;
   874	                break;
   875	            }
   876	            solid_neighbor = Some(dir);
   877	        }
   878	    }
   879	
   880	    if let Some(dir) = solid_neighbor {
   881	        return with_facing(block, state, dir.opposite());
   882	    }
   883	
   884	    let Some(mut lock) = facing_of(block, state) else {
   885	        return state;
   886	    };
   887	    if solid_at(lock) {
   888	        lock = lock.opposite();
   889	    }
   890	    if solid_at(lock) {
   891	        lock = horizontal_clockwise(lock);
   892	    }
   893	    if solid_at(lock) {
   894	        lock = lock.opposite();
   895	    }
   896	    with_facing(block, state, lock)
   897	}

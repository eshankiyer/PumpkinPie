   601	    async fn tick_growl(&self) {
   602	        if self.phase.lock().await.is_sitting() {
   603	            return;
   604	        }
   605	        let mut t = self.growl_time.lock().await;
   606	        if *t > 0 {
   607	            *t -= 1;
   608	        } else {
   609	            *t = GROWL_COOLDOWN_BASE + rand::random_range(0..100);
   610	        }
   611	    }

  1151	const fn delta_needs_position_sync(encoded: Vector3<i64>) -> bool {
  1152	    encoded.x < i16::MIN as i64
  1153	        || encoded.x > i16::MAX as i64
  1154	        || encoded.y < i16::MIN as i64
  1155	        || encoded.y > i16::MAX as i64
  1156	        || encoded.z < i16::MIN as i64
  1157	        || encoded.z > i16::MAX as i64
  1158	}

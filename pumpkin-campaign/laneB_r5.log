   412	   private boolean checkWalls(final ServerLevel level, final AABB bb) {
   413	      int x0 = Mth.floor(bb.minX);
   414	      int y0 = Mth.floor(bb.minY);
   415	      int z0 = Mth.floor(bb.minZ);
   416	      int x1 = Mth.floor(bb.maxX);
   417	      int y1 = Mth.floor(bb.maxY);
   418	      int z1 = Mth.floor(bb.maxZ);
   419	      boolean hitWall = false;
   420	      boolean destroyedBlock = false;
   421	
   422	      for (int x = x0; x <= x1; x++) {
   423	         for (int y = y0; y <= y1; y++) {
   424	            for (int z = z0; z <= z1; z++) {
   425	               BlockPos blockPos = new BlockPos(x, y, z);
   426	               BlockState state = level.getBlockState(blockPos);
   427	               if (!state.isAir() && !state.is(BlockTags.DRAGON_TRANSPARENT)) {
   428	                  if (level.getGameRules().get(GameRules.MOB_GRIEFING) && !state.is(BlockTags.DRAGON_IMMUNE)) {
   429	                     destroyedBlock = level.removeBlock(blockPos, false) || destroyedBlock;
   430	                  } else {
   431	                     hitWall = true;
   432	                  }
   433	               }
   434	            }
   435	         }
   436	      }
   437	
   438	      if (destroyedBlock) {
   439	         BlockPos randomPos = new BlockPos(x0 + this.random.nextInt(x1 - x0 + 1), y0 + this.random.nextInt(y1 - y0 + 1), z0 + this.random.nextInt(z1 - z0 + 1));
   440	         level.levelEvent(2008, randomPos, 0);
   441	      }
   442	
   443	      return hitWall;
   444	   }

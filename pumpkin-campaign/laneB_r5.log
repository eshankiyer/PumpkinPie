   446	   public boolean hurt(final ServerLevel level, final EnderDragonPart part, final DamageSource source, float damage) {
   447	      if (this.phaseManager.getCurrentPhase().getPhase() == EnderDragonPhase.DYING) {
   448	         return false;
   449	      }
   450	
   451	      damage = this.phaseManager.getCurrentPhase().onHurt(source, damage);
   452	      if (part != this.head) {
   453	         damage = damage / 4.0F + Math.min(damage, 1.0F);
   454	      }
   455	
   456	      if (damage < 0.01F) {
   457	         return false;
   458	      }
   459	
   460	      if (source.getEntity() instanceof Player || source.is(DamageTypeTags.ALWAYS_HURTS_ENDER_DRAGONS)) {
   461	         float healthBefore = this.getHealth();
   462	         this.reallyHurt(level, source, damage);
   463	         if (this.phaseManager.getCurrentPhase().isSitting()) {
   464	            this.sittingDamageReceived = this.sittingDamageReceived + healthBefore - this.getHealth();
   465	            if (this.sittingDamageReceived > 0.25F * this.getMaxHealth()) {
   466	               this.sittingDamageReceived = 0.0F;
   467	               this.phaseManager.setPhase(EnderDragonPhase.TAKEOFF);
   468	            }
   469	         }
   470	      }
   471	
   472	      return true;
   473	   }

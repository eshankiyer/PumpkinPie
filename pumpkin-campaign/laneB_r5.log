   697	    async fn tick_block_breaking(&self) {
   698	        let phase_type = *self.phase.lock().await;
   699	        if phase_type.is_sitting() || phase_type == EnderDragonPhase::Dying {
   700	            return;
   701	        }
   702	
   703	        let world = self.mob_entity.living_entity.entity.world.load();
   704	        let bbox = self.mob_entity.living_entity.entity.bounding_box.load();
   705	
   706	        let min = bbox.min_block_pos();
   707	        let max = bbox.max_block_pos();
   708	
   709	        for pos in BlockPos::iterate(min, max) {
   710	            let block = world.get_block(&pos);
   720	                    .await;
   721	            }
   722	        }
   723	    }

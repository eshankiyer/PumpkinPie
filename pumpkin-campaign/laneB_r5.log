   293	#[test]
   294	fn cancellation_path_decrements_in_degree() {
   295	    let mut graph = DAG::default();
   296	
   297	    // Create a task that is waiting (in_degree = 1)
   298	    let waiting_task_key = graph
   299	        .nodes
   300	        .insert(Node::new(ChunkPos::new(0, 0), StagedChunkEnum::Surface));
   301	    let waiting_node = graph.nodes.get_mut(waiting_task_key).unwrap();
   302	    waiting_node.in_degree = 1;
   303	
   304	    // Create the occupy node that the task is waiting on
   305	    let occupy_key = graph.nodes.insert(Node::new(
   306	        ChunkPos::new(i32::MAX, i32::MAX),
   307	        StagedChunkEnum::None,
   308	    ));
   309	    graph.add_edge(occupy_key, waiting_task_key);
   310	
   311	    // Set up the chunk map to simulate an in-flight task
   312	    let mut chunk_map = HashMap::new();
   313	    let mut holder = ChunkHolder {
   314	        current_stage: StagedChunkEnum::Empty,
   315	        target_stage: StagedChunkEnum::Surface,
   316	        occupied: occupy_key,
   317	        ..Default::default()
   318	    };
   319	    holder.tasks[StagedChunkEnum::Surface as usize] = waiting_task_key;
   320	    chunk_map.insert(ChunkPos::new(0, 0), holder);
   321	
   322	    // Simulate the cancellation logic from `work()`
   323	    let mut nodes_to_drop = Vec::new();
   324	    for holder in chunk_map.values_mut() {
   325	        for task in &mut holder.tasks {
   326	            if !task.is_null() {
   327	                nodes_to_drop.push(*task);
   328	                *task = NodeKey::null();
   329	            }
   330	        }
   331	        if !holder.occupied.is_null() {
   332	            nodes_to_drop.push(holder.occupied);
   333	            holder.occupied = NodeKey::null();
   334	        }
   335	    }
   336	
   337	    // Drop nodes using the proper graph edge traversal
   338	    for node_key in nodes_to_drop {
   339	        // Simulating the self.drop_node logic inside the test
   340	        if let Some(old) = graph.nodes.remove(node_key) {
   341	            let mut edge = old.edge;
   342	            while !edge.is_null() {
   343	                let cur = graph.edges.remove(edge).unwrap();
   344	                if let Some(node) = graph.nodes.get_mut(cur.to) {
   345	                    node.in_degree -= 1;
   346	                }
   347	                edge = cur.next;
   348	            }
   349	        }
   350	    }
   351	
   352	    // Assert that the waiting task was properly cleaned up
   353	    assert!(
   354	        graph.nodes.get(waiting_task_key).is_none(),
   355	        "The waiting task should have been dropped during cancellation"
   356	    );
   357	}

   288	    fn stop<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   289	        Box::pin(async move {
   290	            self.phase = Phase::Idle;
   291	            self.carried = None;
   292	        })

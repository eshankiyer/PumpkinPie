   171	   public void tryMoveItems(final int newTradeIndex) {
   172	      if (newTradeIndex >= 0 && this.getOffers().size() > newTradeIndex) {
   173	         ItemStack oldCostA = this.tradeContainer.getItem(0);
   174	         if (!oldCostA.isEmpty()) {
   175	            if (!this.moveItemStackTo(oldCostA, 3, 39, true)) {
   176	               return;
   177	            }
   178	
   179	            this.tradeContainer.setItem(0, oldCostA);
   180	         }
   181	
   182	         ItemStack oldCostB = this.tradeContainer.getItem(1);
   183	         if (!oldCostB.isEmpty()) {
   184	            if (!this.moveItemStackTo(oldCostB, 3, 39, true)) {
   185	               return;
   186	            }
   187	
   188	            this.tradeContainer.setItem(1, oldCostB);
   189	         }
   190	
   191	         if (this.tradeContainer.getItem(0).isEmpty() && this.tradeContainer.getItem(1).isEmpty()) {
   192	            MerchantOffer merchantOffer = this.getOffers().get(newTradeIndex);
   193	            this.moveFromInventoryToPaymentSlot(0, merchantOffer.getItemCostA());
   194	            merchantOffer.getItemCostB().ifPresent(costB -> this.moveFromInventoryToPaymentSlot(1, costB));
   195	         }
   196	      }
   197	   }

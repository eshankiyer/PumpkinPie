   123	   public boolean blockChanged(final BlockPos pos) {
   124	      LevelChunk chunk = this.getTickingChunk();
   125	      if (chunk == null) {
   126	         return false;
   127	      }
   128	
   129	      boolean hadChangedSections = this.hasChangedSections;
   130	      int sectionIndex = this.levelHeightAccessor.getSectionIndex(pos.getY());
   131	      ShortSet changedBlocksInSection = this.changedBlocksPerSection[sectionIndex];
   132	      if (changedBlocksInSection == null) {
   133	         this.hasChangedSections = true;
   134	         changedBlocksInSection = new ShortOpenHashSet();
   135	         this.changedBlocksPerSection[sectionIndex] = changedBlocksInSection;
   136	      }
   137	
   138	      changedBlocksInSection.add(SectionPos.sectionRelativePos(pos));
   139	      return !hadChangedSections;
   140	   }
   141	
   142	   public boolean sectionLightChanged(final LightLayer layer, final int chunkY) {
   143	      ChunkAccess chunk = this.getChunkIfPresent(ChunkStatus.INITIALIZE_LIGHT);
   144	      if (chunk == null) {
   145	         return false;
   146	      }
   147	
   148	      chunk.markUnsaved();
   149	      LevelChunk tickingChunk = this.getTickingChunk();
   150	      if (tickingChunk == null) {
   151	         return false;
   152	      }
   153	
   154	      int minLightSection = this.lightEngine.getMinLightSection();
   155	      int maxLightSection = this.lightEngine.getMaxLightSection();
   156	      if (chunkY >= minLightSection && chunkY <= maxLightSection) {
   157	         BitSet filter = layer == LightLayer.SKY ? this.skyChangedLightSectionFilter : this.blockChangedLightSectionFilter;
   158	         int index = chunkY - minLightSection;
   159	         if (!filter.get(index)) {
   160	            filter.set(index);
   161	            return true;
   162	         } else {
   163	            return false;
   164	         }
   165	      } else {
   166	         return false;
   167	      }
   168	   }
   169	
   170	   public boolean hasChangesToBroadcast() {
   171	      return this.hasChangedSections || !this.skyChangedLightSectionFilter.isEmpty() || !this.blockChangedLightSectionFilter.isEmpty();
   172	   }
   173	
   174	   public void broadcastChanges(final LevelChunk chunk) {
   175	      if (this.hasChangesToBroadcast()) {
   176	         Level level = chunk.getLevel();
   177	         if (!this.skyChangedLightSectionFilter.isEmpty() || !this.blockChangedLightSectionFilter.isEmpty()) {
   178	            List<ServerPlayer> borderPlayers = this.playerProvider.getPlayers(this.pos, true);
   179	            if (!borderPlayers.isEmpty()) {
   180	               ClientboundLightUpdatePacket lightPacket = new ClientboundLightUpdatePacket(
   181	                  chunk.getPos(), this.lightEngine, this.skyChangedLightSectionFilter, this.blockChangedLightSectionFilter
   182	               );
   183	               this.broadcast(borderPlayers, lightPacket);
   184	            }
   185	
   186	            this.skyChangedLightSectionFilter.clear();
   187	            this.blockChangedLightSectionFilter.clear();
   188	         }
   189	
   190	         if (this.hasChangedSections) {
   191	            List<ServerPlayer> players = this.playerProvider.getPlayers(this.pos, false);
   192	
   193	            for (int sectionIndex = 0; sectionIndex < this.changedBlocksPerSection.length; sectionIndex++) {
   194	               ShortSet changedBlocks = this.changedBlocksPerSection[sectionIndex];
   195	               if (changedBlocks != null) {
   196	                  this.changedBlocksPerSection[sectionIndex] = null;
   197	                  if (!players.isEmpty()) {
   198	                     int sectionY = this.levelHeightAccessor.getSectionYFromSectionIndex(sectionIndex);
   199	                     SectionPos sectionPos = SectionPos.of(chunk.getPos(), sectionY);
   200	                     if (changedBlocks.size() == 1) {
   201	                        BlockPos pos = sectionPos.relativeToBlockPos(changedBlocks.iterator().nextShort());
   202	                        BlockState state = level.getBlockState(pos);
   203	                        this.broadcast(players, new ClientboundBlockUpdatePacket(pos, state));
   204	                        this.broadcastBlockEntityIfNeeded(players, level, pos, state);
   205	                     } else {
   206	                        LevelChunkSection section = chunk.getSection(sectionIndex);
   207	                        ClientboundSectionBlocksUpdatePacket packet = new ClientboundSectionBlocksUpdatePacket(sectionPos, changedBlocks, section);
   208	                        this.broadcast(players, packet);
   209	                        packet.runUpdates((pos, state) -> this.broadcastBlockEntityIfNeeded(players, level, pos, state));
   210	                     }
   211	                  }
   212	               }
   213	            }
   214	
   215	            this.hasChangedSections = false;
   216	         }
   217	      }
   218	   }

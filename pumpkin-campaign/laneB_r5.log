   382	#[test]
   383	fn dag_prune_edge_chain_removes_dead_target_edges() {
   384	    let mut graph = DAG::default();
   385	    let node_alive = graph
   386	        .nodes
   387	        .insert(Node::new(ChunkPos::new(0, 0), StagedChunkEnum::Empty));
   388	    let node_dead = graph
   389	        .nodes
   390	        .insert(Node::new(ChunkPos::new(1, 0), StagedChunkEnum::Empty));
   391	
   392	    let edge_alive = graph.edges.insert(crate::chunk_system::dag::Edge::new(
   393	        node_alive,
   394	        crate::chunk_system::dag::EdgeKey::null(),
   395	    ));
   396	    let edge_dead = graph
   397	        .edges
   398	        .insert(crate::chunk_system::dag::Edge::new(node_dead, edge_alive));
   399	
   400	    // Remove node_dead from graph.nodes to simulate completed/dropped task
   401	    graph.nodes.remove(node_dead);
   402	
   403	    let mut head = edge_dead;
   404	    let has_valid_task = graph.prune_edge_chain(&mut head);
   405	
   406	    assert!(has_valid_task);
   407	    assert_eq!(head, edge_alive);
   408	    assert_eq!(graph.edges.len(), 1);
   409	    assert!(graph.edges.contains_key(edge_alive));
   410	    assert!(!graph.edges.contains_key(edge_dead));
   411	
   412	    // Now remove node_alive as well
   413	    graph.nodes.remove(node_alive);
   414	    let has_valid_task = graph.prune_edge_chain(&mut head);
   415	    assert!(!has_valid_task);
   416	    assert!(head.is_null());
   417	    assert_eq!(graph.edges.len(), 0);
   418	}

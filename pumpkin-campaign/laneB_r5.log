   318	        }
   319	        let k = j - i;
   320	        if plateau >= k {
   321	            return random.next_inbetween_i32(i, j);
   322	        }
   323	        let l = (k - plateau) / 2;
   324	        let m = k - l;
   325	        i + random.next_inbetween_i32(0, m) + random.next_inbetween_i32(0, l)
   326	    }

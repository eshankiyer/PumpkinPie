   307	    fn can_turn_to_statue(world: &World, pos: &BlockPos) -> bool {
   308	        let state_id = world.get_block_state_id(pos);
   309	        pumpkin_data::block_properties::is_air(state_id)
   310	            && rand::rng().random::<f32>() <= TURN_TO_STATUE_CHANCE
   311	    }
   312	
   313	    /// `CopperGolem.turnToStatue`: replaces the golem with an oxidized copper golem statue
   314	    /// block, always at the fully-oxidized stage (only reachable once the golem itself is
   315	    /// fully oxidized).
   316	    async fn turn_to_statue(&self, world: &Arc<World>) {
   317	        let pos = self.position();
   318	        let entity = &self.mob_entity.living_entity.entity;
   319	        let facing = entity.get_horizontal_facing();
   320	
   321	        let mut props =
   322	            CopperGolemStatueLikeProperties::default(&Block::OXIDIZED_COPPER_GOLEM_STATUE);
   323	        props.r#copper_golem_pose = match rand::rng().random_range(0..4) {
   324	            0 => CopperGolemPose::Standing,
   325	            1 => CopperGolemPose::Sitting,
   326	            2 => CopperGolemPose::Running,
   327	            _ => CopperGolemPose::Star,
   328	        };
   329	        props.r#facing = facing;
   330	        let state_id = props.to_state_id(&Block::OXIDIZED_COPPER_GOLEM_STATUE);
   331	
   332	        world
   333	            .set_block_state(&pos, state_id, BlockFlags::NOTIFY_ALL)
   334	            .await;
   335	
   336	        if let Some(block_entity) = world.get_block_entity(&pos)
   337	            && let Some(statue) = block_entity
   338	                .as_any()
   339	                .downcast_ref::<CopperGolemStatueBlockEntity>()
   340	        {
   341	            statue.create_statue();
   342	        }
   343	
   344	        entity.remove().await;
   345	    }

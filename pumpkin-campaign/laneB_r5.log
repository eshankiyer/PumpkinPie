   199	   private void moveFromInventoryToPaymentSlot(final int paymentSlot, final ItemCost cost) {
   200	      for (int i = 3; i < 39; i++) {
   201	         ItemStack inventoryItem = this.slots.get(i).getItem();
   202	         if (!inventoryItem.isEmpty() && cost.test(inventoryItem)) {
   203	            ItemStack currentPaymentItem = this.tradeContainer.getItem(paymentSlot);
   204	            if (currentPaymentItem.isEmpty() || ItemStack.isSameItemSameComponents(inventoryItem, currentPaymentItem)) {
   205	               int maxStackSize = inventoryItem.getMaxStackSize();
   206	               int moveCount = Math.min(maxStackSize - currentPaymentItem.getCount(), inventoryItem.getCount());
   207	               ItemStack newPaymentItem = inventoryItem.copyWithCount(currentPaymentItem.getCount() + moveCount);
   208	               inventoryItem.shrink(moveCount);
   209	               this.tradeContainer.setItem(paymentSlot, newPaymentItem);
   210	               if (newPaymentItem.getCount() >= maxStackSize) {
   211	                  break;
   212	               }
   213	            }
   214	         }
   215	      }
   216	   }

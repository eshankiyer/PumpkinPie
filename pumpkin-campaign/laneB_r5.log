   431	
   432	    /// `CopperGolem.thunderHit`: a lightning strike scrubs the golem back to unaffected.
   433	    fn mob_on_lightning_strike<'a>(
   434	        &'a self,
   435	        caller: &'a dyn EntityBase,
   436	        lightning: &'a crate::entity::lightning::LightningBoltEntity,
   437	    ) -> EntityBaseFuture<'a, ()> {
   438	        Box::pin(async move {
   439	            self.mob_entity
   440	                .living_entity
   441	                .on_lightning_strike(caller, lightning)
   442	                .await;
   443	
   444	            // `CopperGolem.thunderHit` ignores repeated callbacks for the same bolt and
   445	            // advances one oxidation stage toward unaffected, rather than clearing all stages.
   446	            // The compare-exchange keeps that read/modify/write atomic if lightning dispatch
   447	            // ever reaches this entity concurrently.
   448	            let lightning_uuid = lightning.get_entity().entity_uuid;
   449	            loop {
   450	                let previous = self.last_lightning_bolt_uuid.load();
   451	                if previous == Some(lightning_uuid) {
   452	                    return;
   453	                }
   454	                if self
   455	                    .last_lightning_bolt_uuid
   456	                    .compare_exchange(previous, Some(lightning_uuid))
   457	                    .is_ok()
   458	                {
   459	                    break;
   460	                }
   461	            }
   462	
   463	            let state = self.weather_state();
   464	            if state != CopperWeatherState::Unaffected {
   465	                self.next_weathering_tick.store(UNSET_WEATHERING_TICK);
   466	                self.set_weather_state(state.previous());
   467	            }
   468	        })
   469	    }
   470	
   471	    fn mob_init_data_tracker(&self) -> EntityBaseFuture<'_, ()> {
   472	        Box::pin(async move {
   473	            self.mob_entity.living_entity.entity.send_meta_data(
   474	                &[

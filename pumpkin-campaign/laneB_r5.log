   106	impl DragonFight {
   107	    #[must_use]
   108	    pub fn new() -> Self {
   109	        // Build the gateway queue: indices 0-19 in a fixed (non-shuffled for
   110	        // now) order.  Vanilla shuffles by world seed — shuffle here if your
   111	        // server exposes a seed.
   112	        let pending_gateways: Vec<usize> = (0..GATEWAY_COUNT).collect();
   113	
   114	        Self {
   115	            dragon_killed: false,
   116	            previously_killed: false,
   117	            needs_state_scanning: true,
   118	            dragon_uuid: None,
   119	            portal_location: None,
   120	            crystals_alive: 0,
   121	            pending_gateways,
   122	            respawn_stage: None,
   123	            respawn_time: 0,
   124	            respawn_crystal_uuids: Vec::new(),
   125	            ticks_since_dragon_seen: 0,
   126	            ticks_since_crystals_scanned: 0,
   127	            // Start above the threshold so the first tick with players triggers a scan.
   128	            ticks_since_last_player_scan: PLAYER_SCAN_INTERVAL + 1,
   129	            bossbar_uuid: Uuid::new_v4(),
   130	            bossbar_players: Vec::new(),
   131	        }
   132	    }
   133	
   134	    // ── Main tick ─────────────────────────────────────────────────────────────
   135	
   136	    pub async fn tick(fight_mutex: &Mutex<Self>, world: &Arc<World>) {
   137	        let (
   138	            ticks_since_last_player_scan,
   139	            needs_state_scanning,
   140	            respawn_stage,
   141	            dragon_killed,
   142	            dragon_uuid,
   143	        ) = {
   144	            let mut fight = fight_mutex.lock().await;
   145	            fight.ticks_since_last_player_scan += 1;
   146	            (
   147	                fight.ticks_since_last_player_scan,
   148	                fight.needs_state_scanning,
   149	                fight.respawn_stage,
   150	                fight.dragon_killed,
   151	                fight.dragon_uuid,
   152	            )
   153	        };
   154	
   155	        // 1. Update boss-bar recipients every 20 ticks.
   156	        if ticks_since_last_player_scan >= PLAYER_SCAN_INTERVAL {
   157	            let mut fight = fight_mutex.lock().await;
   158	            fight.update_players(world).await;
   159	            fight.ticks_since_last_player_scan = 0;
   160	        }
   161	
   162	        let is_empty = { fight_mutex.lock().await.bossbar_players.is_empty() };
   163	        // Nothing to do without nearby players.
   164	        if is_empty {
   165	            return;
   166	        }
   167	
   168	        // 2. One-time state scan on the first populated tick.
   169	        if needs_state_scanning {
   170	            let mut fight = fight_mutex.lock().await;
   171	            fight.scan_state(world).await;
   172	            fight.needs_state_scanning = false;
   173	        }
   174	
   175	        // 3. Respawn sequence (takes priority over normal dragon-missing logic).
   176	        if respawn_stage.is_some() {
   177	            let mut fight = fight_mutex.lock().await;
   178	            fight.tick_respawn(world).await;
   179	            return;
   180	        }
   181	
   182	        // 4. Normal fight ticking.
   183	        if !dragon_killed {
   184	            let mut fight = fight_mutex.lock().await;
   185	            fight.ticks_since_dragon_seen += 1;
   186	            if dragon_uuid.is_none()
   187	                || fight.ticks_since_dragon_seen >= MAX_TICKS_BEFORE_DRAGON_RESPAWN
   188	            {
   189	                fight.find_or_create_dragon(world).await;
   190	                fight.ticks_since_dragon_seen = 0;
   191	            }
   192	
   193	            fight.ticks_since_crystals_scanned += 1;
   194	            if fight.ticks_since_crystals_scanned >= CRYSTAL_SCAN_INTERVAL {
   195	                fight.update_crystal_count(world);
   196	                fight.ticks_since_crystals_scanned = 0;
   197	            }
   198	        }
   199	    }
   200	
   201	    // ── State scanning ────────────────────────────────────────────────────────
   202	
   203	    /// Runs once on the first tick with nearby players.  Determines whether
   204	    /// this is a fresh fight or a resumed one and reconciles the entity list.
   205	    async fn scan_state(&mut self, world: &Arc<World>) {
   206	        info!("Scanning End fight state...");
   207	
   208	        let has_active_portal = Self::has_active_exit_portal(world);
   209	
   210	        if has_active_portal {
   211	            info!("Exit portal found – dragon has been killed previously.");
   212	            self.previously_killed = true;
   213	        } else {
   214	            info!("No exit portal – fight is fresh or in progress.");
   215	            self.previously_killed = false;
   216	            if self.portal_location.is_none() {
   217	                self.spawn_exit_portal(world, false).await;
   218	            }
   219	            self.spawn_crystals(world).await;
   220	        }
   221	
   222	        // Reconcile any live dragon entity.
   223	        let existing = {
   224	            let entities = world.entities.load();
   225	            entities
   226	                .iter()
   227	                .find(|e| e.get_entity().entity_type == &EntityType::ENDER_DRAGON)
   228	                .map(|e| e.get_entity().entity_uuid)
   229	        };
   230	
   231	        match existing {
   232	            Some(uuid) if has_active_portal => {
   233	                // Stale dragon after a completed fight — remove it.
   234	                if let Some(e) = world
   235	                    .entities
   236	                    .load()
   237	                    .iter()
   238	                    .find(|e| e.get_entity().entity_uuid == uuid)
   239	                {
   240	                    e.get_entity().remove().await;
   241	                }
   242	                self.dragon_uuid = None;
   243	                self.dragon_killed = true;
   244	            }
   245	            Some(uuid) => {
   246	                info!("Found existing dragon entity {:?}.", uuid);
   247	                self.dragon_uuid = Some(uuid);
   248	                self.dragon_killed = false;
   249	            }
   250	            None => {
   251	                self.dragon_killed = true;
   252	            }
   253	        }
   254	
   255	        // Fresh world where the dragon appears dead → force a spawn next tick.
   256	        if !self.previously_killed && self.dragon_killed {
   257	            self.dragon_killed = false;
   258	        }
   259	    }
   260	
   261	    /// Checks whether a `END_PORTAL` block exists within an 8-chunk radius
   262	    /// of the origin, matching vanilla's `hasActiveExitPortal`.
   263	    fn has_active_exit_portal(world: &Arc<World>) -> bool {
   264	        for cx in -8i32..=8 {
   265	            for cz in -8i32..=8 {
   266	                let bx = cx * 16;
   267	                let bz = cz * 16;
   268	                for y in 30i32..=80 {
   269	                    if world.get_block(&BlockPos::new(bx, y, bz)) == &Block::END_PORTAL {
   270	                        return true;
   271	                    }
   272	                }
   273	            }
   274	        }
   275	        false
   276	    }

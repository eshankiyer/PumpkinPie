    10	#[derive(Clone)]
    11	pub struct MerchantOffer {
    12	    pub base_cost_a: ItemStackSerializer<'static>,
    13	    pub output: ItemStackSerializer<'static>,
    14	    pub cost_b: Option<ItemStackSerializer<'static>>,
    15	    pub reward_exp: bool,
    16	    pub uses: i32,
    17	    pub max_uses: i32,
    18	    pub xp: i32,
    19	    pub special_price: i32,
    20	    pub price_multiplier: f32,
    21	    pub demand: i32,
    22	}
    23	
    24	impl MerchantOffer {
    25	    /// Vanilla `MerchantOffer::getModifiedCostCount` (`MerchantOffer.java:123-127`): the
    26	    /// actual price charged/displayed, layering demand-driven inflation and the
    27	    /// reputation/hero-of-the-village `special_price` discount on top of the trade
    28	    /// definition's base count. Demand only ever raises the price (`max(0, ...)`);
    29	    /// `special_price` can be negative.
    30	    #[must_use]
    31	    pub fn modified_cost_count(
    32	        base_count: i32,
    33	        demand: i32,
    34	        price_multiplier: f32,
    35	        special_price: i32,
    36	        max_stack_size: i32,
    37	    ) -> i32 {
    38	        #[allow(clippy::cast_possible_truncation)]
    39	        let demand_diff = ((base_count as f32) * (demand as f32) * price_multiplier)
    40	            .floor()
    41	            .max(0.0) as i32;
    42	        (base_count + demand_diff + special_price).clamp(1, max_stack_size.max(1))
    43	    }
    44	
    45	    #[must_use]
    46	    pub const fn is_out_of_stock(&self) -> bool {
    47	        self.uses >= self.max_uses
    48	    }
    49	
    50	    #[must_use]
    51	    pub const fn needs_restock(&self) -> bool {
    52	        self.uses > 0
    53	    }
    54	
    55	    pub const fn update_demand(&mut self) {
    56	        self.demand += self.uses - (self.max_uses - self.uses);
    57	    }
    58	
    59	    pub const fn reset_uses(&mut self) {
    60	        self.uses = 0;
    61	    }
    62	
    63	    /// Vanilla `MerchantOffer::setToOutOfStock` (`MerchantOffer.java:201-203`).
    64	    pub const fn set_to_out_of_stock(&mut self) {
    65	        self.uses = self.max_uses;
    66	    }
    67	
    68	    pub fn write(
    69	        &self,
    70	        mut write: impl std::io::Write,
    71	        version: &JavaMinecraftVersion,
    72	    ) -> Result<(), crate::ser::WritingError> {
    73	        if *version >= JavaMinecraftVersion::V_1_20_5 {
    74	            self.base_cost_a
    75	                .write_item_cost_with_version(&mut write, version)?;
    76	            self.output.write_with_version(&mut write, version)?;
    77	            write.write_option(&self.cost_b, |w, cost_b| {
    78	                cost_b.write_item_cost_with_version(w, version)
    79	            })?;
    80	        } else {
    81	            self.base_cost_a.write_with_version(&mut write, version)?;
    82	            self.output.write_with_version(&mut write, version)?;
    83	            if let Some(cost_b) = &self.cost_b {
    84	                cost_b.write_with_version(&mut write, version)?;
    85	            } else {
    86	                write.write_bool(false)?;
    87	            }
    88	        }
    89	        // Vanilla `MerchantOffer::writeToStream` (`MerchantOffer.java:238-249`) sends the
    90	        // out-of-stock flag here, not `rewardExp`; clients use it to grey out exhausted
    91	        // trades.
    92	        write.write_bool(if *version >= JavaMinecraftVersion::V_1_20_5 {
    93	            self.is_out_of_stock()
    94	        } else {
    95	            self.reward_exp
    96	        })?;
    97	        write.write_i32_be(self.uses)?;
    98	        write.write_i32_be(self.max_uses)?;
    99	        write.write_i32_be(self.xp)?;
   100	        write.write_i32_be(self.special_price)?;
   101	        write.write_f32_be(self.price_multiplier)?;
   102	        write.write_i32_be(self.demand)?;
   103	        Ok(())
   104	    }
   105	}

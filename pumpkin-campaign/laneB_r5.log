   454	      final BlockPos pos,
   455	      final ResourceKey<LootTable> lootTable,
   456	      @Nullable BlockState blockState
   457	   ) {
   458	      if (chunkBB.isInside(pos) && !level.getBlockState(pos).is(Blocks.CHEST)) {
   459	         if (blockState == null) {
   460	            blockState = reorient(level, pos, Blocks.CHEST.defaultBlockState());
   461	         }
   462	
   463	         level.setBlock(pos, blockState, 2);
   464	         if (level.getBlockEntity(pos) instanceof ChestBlockEntity chestBlockEntity) {
   465	            chestBlockEntity.setLootTable(lootTable, random.nextLong());
   466	         }
   467	
   468	         return true;
   469	      } else {
   470	         return false;
   471	      }
   472	   }

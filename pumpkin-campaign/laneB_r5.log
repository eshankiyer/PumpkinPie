   109	    async fn prepare_hand_item_for_use(
   110	        &self,
   111	        player: &Arc<Player>,
   112	        hand: Hand,
   113	        held: &mut ItemStack,
   114	    ) {
   115	        let inventory = player.inventory();
   116	
   117	        if held.get_data_component::<ConsumableImpl>().is_some()
   118	            || held.get_data_component::<BlocksAttacksImpl>().is_some()
   119	        {
   120	            // If its food we want to make sure we can actually consume it
   121	            if let Some(food) = held.get_data_component::<FoodImpl>() {
   122	                if player.abilities.lock().await.invulnerable
   123	                    || food.can_always_eat
   124	                    || player.hunger_manager.level.load() < 20
   125	                {
   126	                    player
   127	                        .living_entity
   128	                        .set_active_hand(hand, held.clone(), held.get_max_use_time())
   129	                        .await;
   130	                }
   131	            } else {
   132	                player
   133	                    .living_entity
   134	                    .set_active_hand(hand, held.clone(), held.get_max_use_time())
   135	                    .await;
   136	            }
   137	        }
   138	        let equipment_slot = held
   139	            .get_data_component::<EquippableImpl>()
   140	            .map(|equippable| equippable.slot.clone());
   141	        if let Some(slot) = equipment_slot {
   142	            // The equipment lock has to be released before touching the hand again:
   143	            // the off hand lives in the same map, so holding it here would deadlock.
   144	            let current_equipped = inventory.entity_equipment.lock().await.get(&slot);
   145	            if current_equipped.are_items_and_components_equal(held) {
   146	                return;
   147	            }
   148	
   149	            player.enqueue_equipment_change(&slot, held).await;
   150	
   151	            let equipped = if current_equipped.is_empty() {
   152	                let equipped = held.clone();
   153	                held.decrement_unless_creative(player.gamemode.load(), 1);
   154	                equipped
   155	            } else {
   156	                std::mem::replace(held, current_equipped)
   157	            };
   158	            inventory.entity_equipment.lock().await.put(&slot, equipped);
   159	            inventory.set_stack_in_hand(hand, held.clone()).await;
   160	        }
   161	    }

    27	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    28	        Box::pin(async move {
    29	            let mut props =
    30	                DecoratedPotLikeProperties::from_state_id(args.block.default_state.id, args.block);
    31	            props.facing = args
    32	                .player
    33	                .living_entity
    34	                .entity
    35	                .get_horizontal_facing()
    36	                .opposite();
    37	            props.waterlogged = args.replacing.water_source();
    38	            props.to_state_id(args.block)
    39	        })
    40	    }
    41	
    42	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    43	        Box::pin(async move {
    44	            let entity = DecoratedPotBlockEntity::new(*args.position);
    45	            args.world.add_block_entity(Arc::new(entity));
    46	        })
    47	    }
    48	
    49	    fn use_with_item<'a>(
    50	        &'a self,
    51	        args: UseWithItemArgs<'a>,
    52	    ) -> BlockFuture<'a, BlockActionResult> {
    53	        Box::pin(async move {
    54	            if args.item_stack.item_count == 0 {
    55	                return self
    56	                    .normal_use(NormalUseArgs {
    57	                        server: args.server,
    58	                        world: args.world,
    59	                        block: args.block,
    60	                        position: args.position,
    61	                        player: args.player,
    62	                        hit: args.hit,
    63	                    })
    64	                    .await;
    65	            }
    66	
    67	            if let Some(block_entity) = args.world.get_block_entity(args.position)
    68	                && let Some(pot_entity) = block_entity
    69	                    .as_any()
    70	                    .downcast_ref::<DecoratedPotBlockEntity>()
    71	            {
    72	                if pot_entity.try_insert_item(args.item_stack, 1).await {
    73	                    // `DecoratedPotBlock.useItemOn` wobbles positively on a successful
    74	                    // insert (`DecoratedPotBlock.java:104`).
    75	                    pot_entity.wobble(args.world, WobbleStyle::Positive).await;
    76	                    args.world.play_sound(
    77	                        Sound::BlockDecoratedPotInsert,
    78	                        SoundCategory::Blocks,
    79	                        &args.position.to_f64(),

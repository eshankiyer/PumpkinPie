   146	/// The six `data/minecraft/loot_table/archaeology/*.json` tables, transcribed from
   147	/// `assets/datapacks/26_2`. They are absent from the generated chest-loot registry,
   148	/// which only carries `chests/*`.
   149	///
   150	/// Every one of them is a single pool with `rolls: 1`, no count functions and default
   151	/// weights, so the chest-loot roller reproduces them exactly.
   152	#[must_use]
   153	pub fn archaeology_loot_table(key: &str) -> Option<ChestLootTable> {
   154	    let key = key.strip_prefix("minecraft:").unwrap_or(key);
   155	    let pools = match key {
   156	        "archaeology/desert_pyramid" => DESERT_PYRAMID_POOLS,
   157	        "archaeology/desert_well" => DESERT_WELL_POOLS,
   158	        "archaeology/ocean_ruin_cold" => OCEAN_RUIN_COLD_POOLS,
   159	        "archaeology/ocean_ruin_warm" => OCEAN_RUIN_WARM_POOLS,
   160	        "archaeology/trail_ruins_common" => TRAIL_RUINS_COMMON_POOLS,
   161	        "archaeology/trail_ruins_rare" => TRAIL_RUINS_RARE_POOLS,
   162	        _ => return None,
   163	    };
   164	    Some(ChestLootTable { pools })
   165	}
   166	
   167	/// `BrushableBlockEntity.getCompletionState` (`BrushableBlockEntity.java:230-238`).
   168	#[must_use]
   169	pub const fn completion_state(brush_count: i32) -> u8 {
   170	    if brush_count == 0 {
   171	        0
   172	    } else if brush_count < 3 {
   173	        1
   174	    } else if brush_count < 6 {
   175	        2
   176	    } else {
   177	        3
   178	    }
   179	}
   180	
   181	/// `BrushableBlock`'s `turns_into` codec field, as bound by the two vanilla instances
   182	/// registered for suspicious sand and gravel.
   183	#[must_use]
   184	pub fn turns_into(block: &Block) -> &'static Block {
   185	    if block.id == BlockId::SUSPICIOUS_GRAVEL {
   186	        &Block::GRAVEL
   187	    } else {
   188	        &Block::SAND
   189	    }
   190	}


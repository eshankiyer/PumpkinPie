   278	    // ── Dragon lifecycle ──────────────────────────────────────────────────────
   279	
   280	    async fn find_or_create_dragon(&mut self, world: &Arc<World>) {
   281	        let uuid = {
   282	            let entities = world.entities.load();
   283	            entities
   284	                .iter()
   285	                .find(|e| e.get_entity().entity_type == &EntityType::ENDER_DRAGON)
   286	                .map(|e| e.get_entity().entity_uuid)
   287	        };
   288	
   289	        if let Some(u) = uuid {
   290	            debug!("Re-acquired existing dragon {:?}.", u);
   291	            self.dragon_uuid = Some(u);
   292	            self.ticks_since_dragon_seen = 0;
   293	        } else {
   294	            debug!("No dragon found – spawning one.");
   295	            self.create_new_dragon(world).await;
   296	        }
   297	    }
   298	
   299	    async fn create_new_dragon(&mut self, world: &Arc<World>) {
   300	        let uuid = Uuid::new_v4();
   301	        let position = Vector3::new(0.5, DRAGON_SPAWN_Y, 0.5);
   302	        let dragon =
   303	            crate::entity::r#type::from_type(&EntityType::ENDER_DRAGON, position, world, uuid);
   304	
   305	        world.spawn_entity(dragon).await;
   306	        self.dragon_uuid = Some(uuid);
   307	        info!("Spawned ender dragon {:?}.", uuid);
   308	    }
   309	
   310	    /// Called every tick while the dragon is alive.  Updates the boss-bar
   311	    /// health fraction, matching vanilla `EnderDragonFight.updateDragon`.
   312	    pub async fn update_dragon(&mut self, world: &Arc<World>, health: f32, max_health: f32) {
   313	        self.ticks_since_dragon_seen = 0;
   314	        let fraction = if max_health > 0.0 {
   315	            (health / max_health).clamp(0.0, 1.0)
   316	        } else {
   317	            0.0
   318	        };
   319	        self.update_bossbar_health(world, fraction).await;
   320	
   321	        // Sync fight origin to the dragon so its pathfinding nodes are correctly placed.
   322	        if let Some(loc) = self.portal_location
   323	            && let Some(dragon_uuid) = self.dragon_uuid
   324	            && let Some(e) = world
   325	                .entities
   326	                .load()
   327	                .iter()
   328	                .find(|e| e.get_entity().entity_uuid == dragon_uuid)
   329	            && let Some(dragon) = e
   330	                .cast_any()
   331	                .downcast_ref::<crate::entity::boss::ender_dragon::EnderDragonEntity>()
   332	        {
   333	            dragon.set_fight_origin(loc).await;
   334	        }
   335	    }
   336	
   337	    /// Called by the dragon entity when it dies.  Activates the portal, places
   338	    /// the egg on a first kill, spawns a gateway, and hides the boss bar.
   339	    /// Matches vanilla `EnderDragonFight.setDragonKilled`.
   340	    pub async fn set_dragon_killed(&mut self, world: &Arc<World>, killed_uuid: Uuid) {
   341	        if Some(killed_uuid) != self.dragon_uuid {
   342	            return;
   343	        }
   344	
   345	        self.update_bossbar_health(world, 0.0).await;
   346	        self.remove_all_bossbar(world).await;
   347	
   348	        // Activate the exit portal.
   349	        self.spawn_exit_portal(world, true).await;
   350	
   351	        // Place the dragon egg on the first kill.
   352	        if !self.previously_killed
   353	            && let Some(loc) = self.portal_location
   354	        {
   355	            let egg_pos = BlockPos::new(loc.0.x, loc.0.y + 4, loc.0.z);
   356	            world
   357	                .set_block_state(
   358	                    &egg_pos,
   359	                    Block::DRAGON_EGG.default_state.id,
   360	                    BlockFlags::NOTIFY_ALL,
   361	                )
   362	                .await;
   363	        }
   364	
   365	        // Spawn a new end gateway.
   366	        self.spawn_new_gateway(world);
   367	
   368	        self.previously_killed = true;
   369	        self.dragon_killed = true;
   370	        self.dragon_uuid = None;
   371	    }
   372	
   373	    fn update_crystal_count(&mut self, world: &Arc<World>) {
   374	        let spikes = Spike::for_level_seed(world.level.seed.0);
   375	        self.crystals_alive = world
   376	            .entities
   377	            .load()
   378	            .iter()
   379	            .filter(|e| {
   380	                e.get_entity().entity_type == &EntityType::END_CRYSTAL
   381	                    && spikes.iter().any(|spike| {
   382	                        spike
   383	                            .top_bounding_box()
   384	                            .intersects(&e.get_entity().bounding_box.load())
   385	                    })
   386	            })
   387	            .count() as u32;
   388	        debug!("Found {} end crystals still alive.", self.crystals_alive);
   389	    }

   123	    let id = source.get_entity().entity_type.id;
   124	    let is_arrow_or_wind_charge = id == EntityType::ARROW.id
   125	        || id == EntityType::SPECTRAL_ARROW.id
   126	        || id == EntityType::TRIDENT.id
   127	        || id == EntityType::WIND_CHARGE.id;

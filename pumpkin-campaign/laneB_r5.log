   564	/// Mirrors `StructurePiece.placeBlock`'s fluid-tick scheduling: a source block placed by a
   565	/// structure needs a scheduled tick to start flowing/settling like naturally-placed fluid.
   566	fn schedule_fluid_tick_for_state(
   567	    chunk: &mut ProtoChunk,
   568	    x: i32,
   569	    y: i32,
   570	    z: i32,
   571	    state_id: BlockStateId,
   572	) {
   573	    if state_id == Block::WATER.default_state.id {
   574	        chunk.schedule_fluid_tick(x, y, z, &Fluid::WATER);
   575	    } else if state_id == Block::LAVA.default_state.id {
   576	        chunk.schedule_fluid_tick(x, y, z, &Fluid::LAVA);
   577	    }
   578	}

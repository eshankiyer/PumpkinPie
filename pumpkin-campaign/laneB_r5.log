   725	    async fn tick_parts(&self) {
   726	        let history: tokio::sync::MutexGuard<'_, DragonFlightHistory> =
   727	            self.flight_history.lock().await;
   728	        let p5 = history.get(5);
   729	        let p10 = history.get(10);
   730	        let p0 = history.get(0);
   731	
   732	        let tilt = (p5.y - p10.y) as f32 * 10.0 * (std::f32::consts::PI / 180.0);
   733	        let cc_tilt = tilt.cos() as f64;
   734	        let ss_tilt = tilt.sin() as f64;
   735	
   736	        let yaw = self.mob_entity.living_entity.entity.yaw.load();
   737	        let rot1 = yaw * (std::f32::consts::PI / 180.0);
   738	        let ss1 = rot1.sin() as f64;
   739	        let cc1 = rot1.cos() as f64;
   740	
   741	        let pos = self.mob_entity.living_entity.entity.pos.load();
   742	
   743	        // Body
   744	        self.parts[2]
   745	            .entity
   746	            .set_pos(Vector3::new(pos.x + ss1 * 0.5, pos.y, pos.z - cc1 * 0.5));
   747	
   748	        // Wings
   749	        self.parts[6].entity.set_pos(Vector3::new(
   750	            pos.x + cc1 * 4.5,
   751	            pos.y + 2.0,
   752	            pos.z + ss1 * 4.5,
   753	        ));
   754	        self.parts[7].entity.set_pos(Vector3::new(
   755	            pos.x - cc1 * 4.5,
   756	            pos.y + 2.0,
   757	            pos.z - ss1 * 4.5,
   758	        ));
   759	
   760	        let head_y_offset = if self.phase.lock().await.is_sitting() {
   761	            -1.0
   762	        } else {
   763	            (p5.y - p0.y) as f64
   764	        };
   765	
   766	        let yaw_accel = *self.yaw_rot_accel.lock().await;
   767	        let rot2 = (yaw - yaw_accel * 0.01) * (std::f32::consts::PI / 180.0);
   768	        let ss2 = rot2.sin() as f64;
   769	        let cc2 = rot2.cos() as f64;
   770	
   771	        // Head & Neck
   772	        self.parts[0].entity.set_pos(Vector3::new(
   773	            pos.x + ss2 * 6.5 * cc_tilt,
   774	            pos.y + head_y_offset + ss_tilt * 6.5,
   775	            pos.z - cc2 * 6.5 * cc_tilt,
   776	        ));
   777	        self.parts[1].entity.set_pos(Vector3::new(
   778	            pos.x + ss2 * 5.5 * cc_tilt,
   779	            pos.y + head_y_offset + ss_tilt * 5.5,
   780	            pos.z - cc2 * 5.5 * cc_tilt,
   781	        ));
   782	
   783	        // Tails
   784	        for i in 0..3 {
   785	            let pi = history.get(12 + i * 2);
   786	            let rot = yaw * (std::f32::consts::PI / 180.0)
   787	                + (pi.y_rot - p5.y_rot).rem_euclid(360.0).to_radians();
   788	            let ss = rot.sin() as f64;
   789	            let cc = rot.cos() as f64;
   790	            let dd = (i + 1) as f64 * 2.0;
   791	
   792	            self.parts[3 + i as usize].entity.set_pos(Vector3::new(
   793	                pos.x - (ss1 * 1.5 + ss * dd) * cc_tilt,
   794	                pos.y + (pi.y - p5.y) - (dd + 1.5) * ss_tilt + 1.5,
   795	                pos.z + (cc1 * 1.5 + cc * dd) * cc_tilt,
   796	            ));
   797	        }
   798	
   799	        for part in &self.parts {
   800	            part.entity.send_pos_rot();
   801	        }
   802	    }

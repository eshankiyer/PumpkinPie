   329	pub struct BiasedToBottomHeightProvider {
   330	    pub min_inclusive: YOffset,
   331	    pub max_inclusive: YOffset,
   332	    pub inner: Option<std::num::NonZero<u32>>,
   333	}
   334	impl BiasedToBottomHeightProvider {
   335	    /// Samples the lower-biased vertical range from vanilla `sample`.
   336	    ///
   337	    /// Source: `net/minecraft/world/level/levelgen/heightproviders/BiasedToBottomHeight.java:37-46`.
   338	    #[must_use]
   339	    pub fn get(&self, random: &mut RandomGenerator, min_y: i8, height: u16) -> i32 {
   340	        let min = self.min_inclusive.get_y(min_y as i16, height);
   341	        let max = self.max_inclusive.get_y(min_y as i16, height);
   342	        let inner = self.inner.map_or(1, std::num::NonZero::get) as i32;
   343	        if max - min - inner < 0 {
   344	            return min;
   345	        }
   346	        let limit = random.next_bounded_i32(max - min - inner + 1);
   347	        random.next_bounded_i32(limit + inner) + min
   348	    }
   349	}
   350	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
   351	pub struct VeryBiasedToBottomHeightProvider {
   352	    pub min_inclusive: YOffset,
   353	    pub max_inclusive: YOffset,
   354	    pub inner: Option<std::num::NonZero<u32>>,
   355	}
   356	impl VeryBiasedToBottomHeightProvider {
   357	    #[must_use]
   358	    pub fn get(&self, random: &mut RandomGenerator, min_y: i8, height: u16) -> i32 {
   359	        let min = self.min_inclusive.get_y(min_y as i16, height);
   360	        let max = self.max_inclusive.get_y(min_y as i16, height);
   361	        let inner = self.inner.map_or(1, std::num::NonZero::get) as i32;
   362	        if min >= max {
   363	            return min;
   364	        }
   365	        let min_rnd = random.next_inbetween_i32(min + inner, max);
   366	        let max_rnd = random.next_inbetween_i32(min, min_rnd - 1);
   367	        random.next_inbetween_i32(min, max_rnd - 1 + inner)
   368	    }
   369	}

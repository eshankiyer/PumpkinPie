   159	    let chunk_pos = ChunkPos::new(0, 0);
   160	    let dependency_task = graph
   161	        .nodes
   162	        .insert(Node::new(ChunkPos::new(10, 10), StagedChunkEnum::Features));
   163	
   164	    // Create an "occupy" node to simulate another thread/process currently working on this chunk
   165	    let occupy_node = graph.nodes.insert(Node::new(
   166	        ChunkPos::new(i32::MAX, i32::MAX),
   167	        StagedChunkEnum::None,
   168	    ));
   169	
   170	    let mut holder = ChunkHolder {
   171	        current_stage: StagedChunkEnum::None,
   172	        occupied: occupy_node,
   173	        ..Default::default()
   174	    };
   175	
   176	    GenerationSchedule::ensure_dependency_chain(
   177	        &mut graph,
   178	        &mut queue,
   179	        &last_level,
   180	        &last_high_priority,
   181	        dependency_task,
   182	        chunk_pos,
   183	        &mut holder,
   184	        StagedChunkEnum::Surface,
   185	    );
   186	
   187	    let start = StagedChunkEnum::Empty as usize;
   188	    let entry_task = holder.tasks[start];

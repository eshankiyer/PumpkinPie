   119	/// `DragonSittingAttackingPhase` and `DragonSittingFlamingPhase`.
   120	pub(super) fn sitting_on_hurt(source: &dyn EntityBase, damage: f32) -> f32 {
   121	    use pumpkin_data::entity::EntityType;

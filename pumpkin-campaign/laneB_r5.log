   796	#[must_use]
   797	pub fn create_chunk_random(seed: i64, chunk_x: i32, chunk_z: i32) -> RandomGenerator {
   798	    let mut seeder = LegacyRand::from_seed(seed as u64);
   799	    let x_multiplier = seeder.next_i64();
   800	    let z_multiplier = seeder.next_i64();
   800	    let z_multiplier = seeder.next_i64();
   801	    let structure_seed = (i64::from(chunk_x).wrapping_mul(x_multiplier))
   802	        ^ (i64::from(chunk_z).wrapping_mul(z_multiplier))
   803	        ^ seed;
   804	    RandomGenerator::Legacy(LegacyRand::from_seed(structure_seed as u64))
   805	}

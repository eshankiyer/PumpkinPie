   310	    /// returns `Math.abs(this.from - this.to) / (this.lerpEnd - this.lerpBegin)`.
   311	    /// When not lerping, the speed is 0.
   312	    #[must_use]
   313	    pub const fn lerp_speed(&self) -> f64 {
   314	        if self.lerp_ticks_total > 0 {
   315	            (self.old_diameter - self.new_diameter).abs() / self.lerp_ticks_total as f64
   316	        } else {
   317	            0.0
   318	        }
   319	    }

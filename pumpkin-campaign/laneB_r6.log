+    pub fn is_brain_dead(&self) -> bool {
+        let memory_empty = self.memory.lock().unwrap().is_empty();
+        let runtime = self.runtime.lock().unwrap();
+        memory_empty && runtime.sensors.is_empty() && runtime.behaviors_by_priority.is_empty()
+    }

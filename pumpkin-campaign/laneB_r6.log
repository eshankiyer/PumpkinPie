   418	    /// `Brain.setActiveActivityToFirstValid` (`Brain.java:337-344`). This is what
   419	    /// `AllayAi.updateActivity` calls; no schedule subsystem is involved.
   420	    pub fn set_active_activity_to_first_valid(&self, activities: &[Activity]) {
   421	        for activity in activities {
   422	            if self.activity_requirements_are_met(*activity) {
   423	                self.set_active_activity(*activity);
   424	                break;
   425	            }
   426	        }

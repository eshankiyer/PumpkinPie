   338	    fn parse_options(&mut self) -> Result<(), CommandSyntaxError> {
   339	        self.suggestions = EntitySelectorParserSuggestions::OptionsKey;
   340	        self.reader.skip_whitespace();
   341	        while self.reader.can_read_char() && self.reader.peek() != Some(']') {
   342	            self.reader.skip_whitespace();
   343	            let i = self.reader.cursor();
   344	            let string = self.reader.read_string()?;
   345	            // Try to get the option.
   346	            let option = string.parse::<EntitySelectorOption>();
   347	            if let Ok(option) = option {
   348	                if !option.can_use(self) {
   349	                    return Err(INAPPLICABLE_OPTION_ERROR_TYPE
   350	                        .create(self.reader, TextComponent::text(string)));
   351	                }
   352	                // Now, we start parsing the option.
   353	                self.reader.skip_whitespace();
   354	                if self.reader.peek() != Some('=') {
   355	                    self.reader.set_cursor(i);
   356	                    return Err(EXPECTED_OPTION_VALUE_ERROR_TYPE
   357	                        .create(self.reader, TextComponent::text(string)));
   358	                }
   359	                self.reader.skip();
   360	                self.reader.skip_whitespace();
   361	                self.suggestions = EntitySelectorParserSuggestions::Nothing;
   362	                option.modify_parser(self)?;
   363	                self.reader.skip_whitespace();
   364	                self.suggestions = EntitySelectorParserSuggestions::OptionsNextOrClose;

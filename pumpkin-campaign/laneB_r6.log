   186	   private Predicate<Entity> createRotationPredicate(final MinMaxBounds.FloatDegrees range, final ToFloatFunction<Entity> function) {
   187	      float min = Mth.wrapDegrees(range.min().orElse(0.0F));
   188	      float max = Mth.wrapDegrees(range.max().orElse(359.0F));
   189	      return e -> {
   190	         float rotation = Mth.wrapDegrees(function.applyAsFloat(e));
   191	         return min > max ? rotation >= min || rotation <= max : rotation >= min && rotation <= max;
   192	      };
   193	   }

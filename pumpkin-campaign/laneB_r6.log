   424	impl BrainRuntime {
   425	    /// `Brain.startEachNonRunningBehavior` (`Brain.java:409-424`).
   426	    ///
   427	    /// Every stopped behavior in every active activity gets a `try_start`, in ascending
   428	    /// priority order. There is no early exit and no per-control exclusion: two behaviors can
   429	    /// both start in the same tick.
   430	    fn start_each_non_running_behavior(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   431	        for behaviors in self.behaviors_by_priority.values_mut() {
   432	            for (activity, behavior) in behaviors.iter_mut() {
   433	                if !self.active_activities.contains(activity) {
   434	                    continue;
   435	                }
   436	                if behavior.status() == BehaviorStatus::Stopped {
   437	                    behavior.try_start(mob, brain, game_time);
   438	                }
   439	            }
   440	        }
   441	    }
   442	
   443	    /// `Brain.tickEachRunningBehavior` (`Brain.java:426-432`).
   444	    fn tick_each_running_behavior(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   445	        for behaviors in self.behaviors_by_priority.values_mut() {
   446	            for (_, behavior) in behaviors.iter_mut() {
   447	                if behavior.status() == BehaviorStatus::Running {
   448	                    behavior.tick_or_stop(mob, brain, game_time);

   200	                    .await;
   201	                world.update_neighbors(pos, None).await;
   202	                world.schedule_block_tick(block, *pos, 30, TickPriority::Normal);
   203	                if let Some(block_entity) = world.get_block_entity(pos)
   204	                    && let Some(sculk_sensor) = block_entity
   205	                        .as_any()
   206	                        .downcast_ref::<crate::block::entities::sculk_sensor::SculkSensorBlockEntity>()
   207	                {
   208	                    sculk_sensor.set_last_vibration_frequency(frequency).await;
   209	                }
   210	                Self::try_resonate_vibration(world, pos, frequency).await;
   211	            }
   212	        } else if block.id == BlockId::CALIBRATED_SCULK_SENSOR {
   213	            let state = world.get_block_state(pos);
   214	            let mut props = CalibratedSculkSensorLikeProperties::from_state_id(state.id, block);
   215	            if props.sculk_sensor_phase == SculkSensorPhase::Inactive {
   216	                let back_dir = horizontal_facing_to_dir(props.facing).opposite();
   217	                let back_pos = pos.offset(back_dir.to_offset());
   218	                let back_state = world.get_block_state(&back_pos);
   219	                let back_block = Block::from_state_id(back_state.id);
   220	
   221	                let calibrated_freq = world
   222	                    .block_registry
   223	                    .get_weak_redstone_power(back_block, world, &back_pos, back_state, back_dir)
   224	                    .await;
   225	
   226	                // Vanilla `CalibratedSculkSensorBlockEntity.VibrationUser.canReceiveVibration`
   227	                // (`CalibratedSculkSensorBlockEntity.java:35-40`) compares the back signal to
   228	                // the event frequency, not to the distance-derived redstone power.
   229	                if calibrated_freq > 0 && i32::from(calibrated_freq) != frequency {
   230	                    return;
   231	                }
   232	
   233	                if let Some(be) = world.get_block_entity(pos)
   234	                    && let Some(cal_be) = be
   235	                        .as_any()
   236	                        .downcast_ref::<CalibratedSculkSensorBlockEntity>()
   237	                {
   238	                    *cal_be.last_vibration_frequency.lock().await = frequency;
   239	                }
   240	
   241	                props.sculk_sensor_phase = SculkSensorPhase::Active;
   242	                props.power = power;
   243	                world
   244	                    .set_block_state(pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
   245	                    .await;
   246	                world.update_neighbors(pos, None).await;
   247	                // CalibratedSculkSensorBlock overrides getActiveTicks() to 10.
   248	                world.schedule_block_tick(block, *pos, 10, TickPriority::Normal);
   249	                if let Some(block_entity) = world.get_block_entity(pos)
   250	                    && let Some(calibrated) = block_entity
   251	                        .as_any()
   252	                        .downcast_ref::<crate::block::entities::calibrated_sculk_sensor::CalibratedSculkSensorBlockEntity>()
   253	                {
   254	                    calibrated.set_last_vibration_frequency(frequency).await;
   255	                }
   256	                // The calibrated sensor extends `SculkSensorBlock` in vanilla and inherits
   257	                // `activate`, so it resonates adjacent amethyst the same way.
   258	                Self::try_resonate_vibration(world, pos, frequency).await;
   259	            }
   260	        }
   261	    }
   262	}

+impl TestInstanceData {
+    /// TestInstanceBlockEntity.java:437-463 (`withSize`/`withStatus`/`withError`): these record
+    /// updates preserve the other test-instance fields while changing one result field.
+    #[must_use]
+    pub fn with_size(mut self, size: Vector3<i32>) -> Self {
+        self.size = size;
+        self
+    }
+
+    #[must_use]
+    pub fn with_status(mut self, status: TestInstanceStatus) -> Self {
+        self.status = status;
+        self.error_message = None;
+        self
+    }
+
+    #[must_use]
+    pub fn with_error(mut self, error_message: String) -> Self {
+        self.status = TestInstanceStatus::Finished;
+        self.error_message = Some(error_message);
+        self
+    }
+}
 
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ErrorMarker {
+    pub position: BlockPos,
+    pub text: String,
+}
+

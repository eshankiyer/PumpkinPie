   517	    fn mob_interact<'a>(
   518	        &'a self,
   519	        player: &'a Arc<Player>,
   520	        item_stack: &'a mut ItemStack,
   521	    ) -> EntityBaseFuture<'a, bool> {
   522	        Box::pin(async move {
   523	            // HappyGhast.java:281-283: babies never equip/ride, only eat to grow up.
   524	            if self.is_baby() {
   525	                use crate::entity::passive::animal::Animal as _;
   526	                return self
   527	                    .animal_interact(player, item_stack, Sound::EntityGhastlingAmbient)
   528	                    .await;
   529	            }
   530	
   531	            if !item_stack.is_empty() && self.try_equip_harness(player, item_stack).await {
   532	                return true;
   533	            }
   534	
   535	            if self.try_mount(player).await {
   536	                return true;
   537	            }
   538	
   539	            self.mob_entity
   540	                .mob_interact(player, item_stack, self.can_be_leashed())
   541	                .await
   542	        })
   543	    }
   544	
   545	    fn mob_tick<'a>(&'a self, _caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   546	        Box::pin(async move {
   547	            if !self.mob_entity.living_entity.entity.is_alive() {
   548	                return;
   549	            }
   550	
   551	            self.ageable_ai_step();
   552	
   553	            if self.is_baby() {
   554	                if !self.baby_setup.swap(true, Relaxed) {
   555	                    self.setup_baby().await;
   556	                }
   557	            } else if self.baby_setup.swap(false, Relaxed) {
   558	                self.setup_adult().await;
   559	            }
   560	
   561	            let leash_time = self.leash_holder_time.load(Relaxed);
   562	            if leash_time > 0 {
   563	                self.leash_holder_time.fetch_sub(1, Relaxed);
   564	            }
   565	            self.set_leash_holder(leash_time > 0);
   566	
   567	            if self.server_still_timeout.load(Relaxed) > 0 {
   568	                if self.get_entity().age.load(Relaxed) > 60 {
   569	                    self.server_still_timeout.fetch_sub(1, Relaxed);
   570	                }
   571	                self.sync_stay_still_flag();
   572	            }
   573	
   574	            self.continuous_heal();
   575	
   576	            let is_vehicle = !self
   577	                .mob_entity
   578	                .living_entity
   579	                .entity
   580	                .passengers
   581	                .lock()
   582	                .await
   583	                .is_empty();
   584	            if !is_vehicle {
   585	                self.check_restriction().await;
   586	            }
   587	        })
   588	    }
   589	}

   193	         Style style = message.getStyle();
   194	         ClickEvent event = style.getClickEvent();
   195	         switch (event) {
   196	            case ClickEvent.RunCommand command:
   197	               level.getServer().getCommands().performPrefixedCommand(createCommandSourceStack(player, level, pos), command.command());
   198	               hasAnyClickCommand = true;
   199	               break;
   200	            case ClickEvent.ShowDialog dialog:
   201	               player.openDialog(dialog.dialog());
   202	               hasAnyClickCommand = true;
   203	               break;
   204	            case ClickEvent.Custom custom:
   205	               level.getServer().handleCustomClickAction(custom.id(), custom.payload());
   206	               hasAnyClickCommand = true;
   207	               break;
   208	            case null:
   209	            default:
   210	         }
   211	      }
   212	
   213	      return hasAnyClickCommand;
   214	   }

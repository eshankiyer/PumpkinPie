   299	    pub fn clamp_block(&self, x: i32, z: i32) -> (i32, i32) {
   300	        let (min_x, max_x, min_z, max_z) = self.bounds();
   301	        (
   302	            clamp(f64::from(x), min_x, max_x - 1.0e-5).floor() as i32,
   303	            clamp(f64::from(z), min_z, max_z - 1.0e-5).floor() as i32,
   304	        )
   305	    }

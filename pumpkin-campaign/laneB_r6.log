   722	    fn push<'a>(&'a self, entity: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   723	        Box::pin(async move {
   724	            let self_entity = self.get_entity();
   725	            let other_entity = entity.get_entity();
   726	
   727	            // Vanilla `IronGolem.doPush` (`IronGolem.java:103-110`) gives the golem a
   728	            // target with a 1/20 roll when it physically collides with an Enemy other
   729	            // than a creeper. `push_entities` reaches this shared collision method for
   730	            // every overlapping mob, so keep the species hook here rather than adding a
   731	            // second collision loop to IronGolemEntity.
   732	            if self_entity.entity_type == &EntityType::IRON_GOLEM
   733	                && other_entity.entity_type.category == &pumpkin_data::entity::MobCategory::MONSTER
   734	                && other_entity.entity_type != &EntityType::CREEPER
   735	                && rand::random_range(0..20) == 0
   736	                && let Some(iron_golem) =
   737	                    self.cast_any()
   738	                        .downcast_ref::<crate::entity::passive::iron_golem::IronGolemEntity>()
   739	            {
   740	                iron_golem.mob_entity.set_target(Some(entity.clone())).await;
   741	            }
   742	
   743	            if self_entity.no_clip.load(Ordering::Relaxed)
   744	                || other_entity.no_clip.load(Ordering::Relaxed)
   745	            {
   746	                return;
   747	            }
   748	
   749	            {
   750	                let passengers = self_entity.passengers.lock().await;
   751	                if passengers
   752	                    .iter()
   753	                    .any(|p| p.get_entity().entity_id == other_entity.entity_id)
   754	                {
   755	                    return;
   756	                }
   757	            }
   758	            {
   759	                let passengers = other_entity.passengers.lock().await;
   760	                if passengers
   761	                    .iter()
   762	                    .any(|p| p.get_entity().entity_id == self_entity.entity_id)
   763	                {
   764	                    return;
   765	                }
   766	            }
   767	
   768	            let mut dx = other_entity.pos.load().x - self_entity.pos.load().x;
   769	            let mut dz = other_entity.pos.load().z - self_entity.pos.load().z;
   770	            let mut d = dx.abs().max(dz.abs());
   771	            if d >= 0.01 {
   772	                d = d.sqrt();
   773	                dx /= d;
   774	                dz /= d;
   775	                let mut d2 = 1.0 / d;
   776	                if d2 > 1.0 {
   777	                    d2 = 1.0;
   778	                }
   779	                dx *= d2;
   780	                dz *= d2;
   781	                dx *= 0.05;
   782	                dz *= 0.05;
   783	
   784	                if !self_entity.has_passengers().await && self.is_pushable() {
   785	                    let mut vel = self_entity.velocity.load();
   786	                    vel.x -= dx;
   787	                    vel.z -= dz;
   788	                    self_entity.velocity.store(vel);
   789	                    self_entity.send_velocity();
   790	                }
   791	
   792	                if !other_entity.has_passengers().await && entity.is_pushable() {
   793	                    let mut vel = other_entity.velocity.load();
   794	                    vel.x += dx;
   795	                    vel.z += dz;
   796	                    other_entity.velocity.store(vel);
   797	                    other_entity.send_velocity();
   798	                }
   799	            }
   800	        })
   801	    }

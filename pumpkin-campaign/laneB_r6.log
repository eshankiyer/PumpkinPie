   352	                );
   353	                Ok(())
   354	            }
   355	            Self::Tag => {
   356	                let invert = parser.consume_inverted_start();
   357	                let string = parser.reader.read_unquoted_string();
   358	                parser.add_predicate(EntitySelectorPredicate::Tag(string, invert));
   359	                Ok(())
   360	            }
   361	            Self::Team => {
   362	                let start = parser.reader.cursor();
   363	                let invert = parser.consume_inverted_start();
   364	                if parser.has_flag(if invert {
   365	                    Flags::TEAM_NOT_EQUALS_SET
   366	                } else {
   367	                    Flags::TEAM_EQUALS_SET
   368	                }) {
   369	                    parser.reader.set_cursor(start);
   370	                    return Err(self.inapplicable_error(parser.reader));
   371	                }
   372	                let string = parser.reader.read_unquoted_string();
   373	                parser.add_predicate(EntitySelectorPredicate::Team(string, invert));
   374	                parser.set_flag(
   375	                    if invert {
   376	                        Flags::TEAM_NOT_EQUALS_SET
   377	                    } else {
   378	                        Flags::TEAM_EQUALS_SET
   379	                    },
   380	                    true,
   381	                );
   382	                Ok(())
   383	            }
   384	            Self::Scores => {
   385	                parser.reader.expect('{')?;
   386	                parser.reader.skip_whitespace();
   387	                let mut scores = std::collections::HashMap::new();
   388	                while parser.reader.can_read_char() && parser.reader.peek() != Some('}') {
   389	                    parser.reader.skip_whitespace();
   390	                    let objective = parser.reader.read_unquoted_string();
   391	                    parser.reader.skip_whitespace();
   392	                    parser.reader.expect('=')?;
   393	                    parser.reader.skip_whitespace();
   394	                    let bounds = IntBounds::from_reader(parser.reader)?;
   395	                    scores.insert(objective, bounds);
   396	                    parser.reader.skip_whitespace();
   397	                    if parser.reader.can_read_char() && parser.reader.peek() == Some(',') {
   398	                        parser.reader.skip(); // Consume ','
   399	                    }
   400	                }
   401	                parser.reader.expect('}')?;
   402	                parser.add_predicate(EntitySelectorPredicate::Scores(scores));
   403	                parser.set_flag(Flags::SCORES_SET, true);
   404	                Ok(())
   405	            }
   406	            Self::Advancements => {
   407	                parser.reader.expect('{')?;
   408	                parser.reader.skip_whitespace();
   409	                let mut advancements = std::collections::HashMap::new();
   410	                while parser.reader.can_read_char() && parser.reader.peek() != Some('}') {
   411	                    parser.reader.skip_whitespace();
   412	                    let advancement_id = parser.reader.read_unquoted_string();
   413	                    parser.reader.skip_whitespace();
   414	                    parser.reader.expect('=')?;
   415	                    parser.reader.skip_whitespace();
   416	                    let val = parser.reader.read_bool()?;
   417	                    advancements.insert(advancement_id, val);
   418	                    parser.reader.skip_whitespace();
   419	                    if parser.reader.can_read_char() && parser.reader.peek() == Some(',') {
   420	                        parser.reader.skip(); // Consume ','
   421	                    }
   422	                }
   423	                parser.reader.expect('}')?;
   424	                parser.add_predicate(EntitySelectorPredicate::Advancements(advancements));
   425	                parser.set_flag(Flags::ADVANCEMENTS_SET, true);
   426	                Ok(())
   427	            }
   428	            Self::Nbt => {
   429	                let start = parser.reader.cursor();
   430	                let invert = parser.consume_inverted_start();
   431	                let tag = crate::command::snbt::SnbtParser::parse_for_commands(parser.reader)?;
   432	                if let pumpkin_nbt::tag::NbtTag::Compound(compound) = tag {
   433	                    parser.add_predicate(EntitySelectorPredicate::Nbt(compound, invert));
   434	                    Ok(())
   435	                } else {
   436	                    parser.reader.set_cursor(start);
   437	                    Err(
   438	                        crate::command::errors::error_types::DISPATCHER_UNKNOWN_ARGUMENT
   439	                            .create(parser.reader),
   440	                    )
   441	                }
   442	            }
   443	            Self::Predicate => {
   444	                let invert = parser.consume_inverted_start();
   445	                let string = parser.reader.read_unquoted_string();
   446	                parser.add_predicate(EntitySelectorPredicate::Predicate(string, invert));
   447	                Ok(())
   448	            }
   449	        }
   450	    }

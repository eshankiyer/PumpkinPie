   547	   private boolean scanPlayerAboveGhast() {
   548	      AABB happyGhastBb = this.getBoundingBox();
   549	      AABB ghastDetectionBox = new AABB(
   550	         happyGhastBb.minX - 1.0,
   551	         happyGhastBb.maxY - 1.0E-5F,
   552	         happyGhastBb.minZ - 1.0,
   553	         happyGhastBb.maxX + 1.0,
   554	         happyGhastBb.maxY + happyGhastBb.getYsize() / 2.0,
   555	         happyGhastBb.maxZ + 1.0
   556	      );
   557	
   558	      for (Player player : this.level().players()) {
   559	         if (!player.isSpectator()) {
   560	            Entity rootVehicle = player.getRootVehicle();
   561	            if (!(rootVehicle instanceof HappyGhast) && ghastDetectionBox.contains(rootVehicle.position())) {
   562	               return true;
   563	            }
   564	         }
   565	      }
   566	
   567	      return false;
   568	   }

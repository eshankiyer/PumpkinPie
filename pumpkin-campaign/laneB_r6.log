   330	    /// `Brain.getActiveActivities` (`Brain.java:259-263`), copied because the Rust runtime keeps
   331	    /// the active set behind its mutex.
   332	    #[must_use]
   333	    pub fn get_active_activities(&self) -> Vec<Activity> {
   334	        self.runtime.lock().unwrap().active_activities.clone()
   335	    }
   336	
   337	    /// `Brain.getRunningBehaviors` (`Brain.java:265-280`). Debug names are the stable Rust
   338	    /// representation because behavior objects remain owned by the brain runtime.
   339	    #[must_use]
   340	    pub fn get_running_behaviors(&self) -> Vec<&'static str> {
   341	        let runtime = self.runtime.lock().unwrap();
   342	        runtime
   343	            .behaviors_by_priority
   344	            .values()
   345	            .flat_map(|behaviors| behaviors.iter())
   346	            .filter(|(_, behavior)| behavior.status() == BehaviorStatus::Running)
   347	            .map(|(_, behavior)| behavior.debug_name())
   348	            .collect()
   349	    }

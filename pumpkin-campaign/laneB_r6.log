      SulfurCube sulfurCube = EntityTypes.SULFUR_CUBE.create(level, EntitySpawnReason.BREEDING);
      if (sulfurCube != null) {
         sulfurCube.setSize(1, true);
      }

      return sulfurCube;
   }


   173	/// Resolves the pusher's own collision rule/team name once per `push_entities` call, and whether
   174	/// any teams exist at all (so the common no-teams case can skip per-candidate locking entirely).
   175	async fn pusher_team_state(
   176	    world: &World,
   177	    pusher: &dyn EntityBase,
   178	) -> (
   179	    crate::world::scoreboard::CollisionRule,
   180	    Option<String>,
   181	    bool,
   182	) {
   183	    use crate::world::scoreboard::{CollisionRule, entity_scoreboard_name};
   184	
   185	    let scoreboard = world.scoreboard.lock().await;
   186	    if scoreboard.get_teams().is_empty() {
   187	        return (CollisionRule::Always, None, false);
   188	    }
   189	    let pusher_name = entity_scoreboard_name(pusher);
   190	    let team = scoreboard.get_team_for_scoreboard_name(&pusher_name);
   191	    (
   192	        team.map_or(CollisionRule::Always, |t| t.collision_rule),
   193	        team.map(|t| t.name.clone()),
   194	        true,
   195	    )
   196	}

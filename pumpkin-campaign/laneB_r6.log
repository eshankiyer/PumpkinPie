   284	    /// `ServerRecipeBook.loadUntrusted` (`ServerRecipeBook.java:139-143`) plus the
   285	    /// `loadRecipes` validator (`ServerRecipeBook.java:100-110`): ids the registry
   286	    /// does not recognise are dropped rather than kept.
   287	    pub fn read_nbt(&mut self, nbt: &NbtCompound) {
   288	        let Some(book) = nbt.get_compound(RECIPE_BOOK_TAG) else {
   289	            return;
   290	        };
   291	        self.settings = RecipeBookSettings::read_nbt(book);
   292	        self.known = read_id_list(book, KNOWN_TAG);
   293	        self.highlight = read_id_list(book, HIGHLIGHT_TAG);
   294	        // A highlighted recipe that is not known is meaningless.
   295	        self.highlight.retain(|id| self.known.contains(id));
   296	    }
   297	}

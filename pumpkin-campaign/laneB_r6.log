   417	   private static BoundingBox getWritableArea(final ChunkAccess chunk) {
   418	      ChunkPos chunkPos = chunk.getPos();
   419	      int targetBlockX = chunkPos.getMinBlockX();
   420	      int targetBlockZ = chunkPos.getMinBlockZ();
   421	      LevelHeightAccessor heightAccessor = chunk.getHeightAccessorForGeneration();
   422	      int minY = heightAccessor.getMinY() + 1;
   423	      int maxY = heightAccessor.getMaxY();
   424	      return new BoundingBox(targetBlockX, minY, targetBlockZ, targetBlockX + 15, maxY, targetBlockZ + 15);
   425	   }

   166	// VibrationSystem.getRedstoneStrengthForDistance
   167	#[must_use]
   168	pub fn redstone_strength_for_distance(distance: f32, listener_radius: i32) -> u8 {
   169	    let power_scale = 15.0 / f64::from(listener_radius);
   170	    let strength = 15 - (power_scale * f64::from(distance)).floor() as i32;
   171	    strength.max(1) as u8
   172	}
   173	
   174	// VibrationSystem.Listener.isOccluded, approximated: samples block centers along the
   175	// straight line from `from` to `to` (exclusive of the endpoints) instead of vanilla's
   176	// 6-direction nudged ClipBlockStateContext raycast.
   177	fn is_occluded(world: &World, from: Vector3<f64>, to: Vector3<f64>) -> bool {
   178	    let delta = to - from;
   179	    let distance = delta.length();
   180	    if distance < 1.0e-6 {
   181	        return false;
   182	    }
   183	    let steps = distance.ceil() as i32;
   184	    for i in 1..steps {
   185	        let t = f64::from(i) / f64::from(steps);
   186	        let sample = Vector3::new(
   187	            from.x + delta.x * t,
   188	            from.y + delta.y * t,
   189	            from.z + delta.z * t,
   190	        );
   191	        let pos = BlockPos::new(
   192	            sample.x.floor() as i32,
   193	            sample.y.floor() as i32,
   194	            sample.z.floor() as i32,
   195	        );
   196	        if world
   197	            .get_block(&pos)
   198	            .has_tag(&tag::Block::MINECRAFT_OCCLUDES_VIBRATION_SIGNALS)
   199	        {
   200	            return true;
   201	        }
   202	    }
   203	    false
   204	}
   205	
   206	// GameEventDispatcher.post: notifies every registered listener within the event's
   207	// notification radius, closest-first (GameEvent.ListenerInfo::compareTo), gated by the
   208	// occlusion check above. Vanilla's chunk-section iteration is replaced by scanning the
   209	// flat registry (see module doc comment).
   210	pub async fn emit_game_event(
   211	    world: &Arc<World>,
   212	    event: GameEvent,
   213	    position: Vector3<f64>,
   214	    context: GameEventContext,
   215	) {
   216	    // `VibrationSystem.Listener.isValidVibration` rejects a source entity that
   217	    // dampens vibrations (ItemEntity.java:85-87 and VibrationSystem.java:424-426).
   218	    // Keep this source-side gate here so every listener observes the same rule.
   219	    if let Some(source) = context.source_entity.clone()
   220	        && let Some(item) = source.get_item_entity()
   221	        && item.dampens_vibrations().await
   222	    {
   223	        return;
   224	    }
   225	
   226	    let radius = f64::from(notification_radius(&event));
   227	    let radius_sq = radius * radius;
   228	
   229	    let listeners = world.game_event_listeners.lock().await.clone();
   230	    let mut in_range: Vec<(f64, Arc<dyn GameEventListener>, Vector3<f64>)> = listeners
   231	        .into_iter()
   232	        .filter_map(|listener| {
   233	            let listener_pos = listener.listener_source().get_position(world)?;
   234	            let dist_sq = (listener_pos - position).length_squared();
   235	            let listener_radius = f64::from(listener.listener_radius());
   236	            (dist_sq <= radius_sq.min(listener_radius * listener_radius)).then_some((
   237	                dist_sq,
   238	                listener,
   239	                listener_pos,
   240	            ))
   241	        })
   242	        .collect();
   243	
   244	    in_range.sort_by(|a, b| a.0.total_cmp(&b.0));
   245	
   246	    for (_, listener, listener_pos) in in_range {
   247	        if is_occluded(world, position, listener_pos) {
   248	            continue;
   249	        }
   250	        listener
   251	            .handle_game_event(world, &event, &context, position)
   252	            .await;
   253	    }
   254	}


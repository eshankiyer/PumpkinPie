    30	/// Represents a structure that can target entities.
    31	///
    32	/// Not all selectors represented by this object start with `@`; this is also used for
    33	/// selectors like *plain player names* and *bare UUIDs*.
    34	pub struct EntitySelector {
    35	    /// The maximum number of possible entities that can be selected.
    36	    pub max_selected: i32,
    37	    /// Whether this selector includes all entities rather than just players.
    38	    pub includes_entities: bool,
    39	    /// A list of predicates that must be satisfied by an entity to be part
    40	    /// of this selector. Used for things like checking a game mode.
    41	    pub predicates: Vec<EntitySelectorPredicate>,
    42	    /// The distance range that this selector allows.
    43	    pub distance: Option<DoubleBounds>,
    44	    /// A function corresponding to how positions are provided for this selector, provided
    45	    /// an initial [`Vector3<f64>`].
    46	    pub position_function: PositionFunction,
    47	    /// The limiting bounding box for this selector.
    48	    pub bounding_box: Option<BoundingBox>,
    49	    /// The sorting order of this selector.
    50	    pub order: Order,
    51	    /// Whether the selector represents the currently executing entity. Only true if `@s` is used.
    52	    pub is_current_entity: bool,
    53	    /// The limiting player name of this selector.
    54	    pub player_name: Option<String>,
    55	    /// The limiting UUID of this selector.
    56	    pub entity_uuid: Option<Uuid>,
    57	    /// The limiting entity type or tag for this selector.
    58	    pub entity_type: Option<&'static EntityType>,
    59	    /// Whether this selector uses a selector variable (like `@p`).
    60	    pub uses_selector_variable: bool,
    61	    /// Whether this selector limits entities to a certain world.
    62	    pub is_world_limited: bool,
    63	}
    64	
    65	impl EntitySelector {
    66	    /// Returns an [`Err`] if a [`CommandSource`] does not have permission to use
    67	    /// this entity selector.
    68	    pub async fn check_permissions(
    69	        &self,
    70	        source: &CommandSource,
    71	    ) -> Result<(), CommandSyntaxError> {
    72	        if self.uses_selector_variable && !source.has_permission(ENTITY_SELECTOR_PERMISSION).await {
    73	            Err(SELECTORS_NOT_ALLOWED_ERROR_TYPE.create_without_context())
    74	        } else {
    75	            Ok(())
    76	        }
    77	    }
    78	
    79	    const fn result_limit(&self) -> usize {
    80	        if matches!(self.order, Order::Arbitrary) {
    81	            self.max_selected as usize
    82	        } else {
    83	            usize::MAX
    84	        }
    85	    }
    86	
    87	    /// Tries to find a single entity represented by this selector.
    88	    pub async fn find_single_entity(
    89	        &self,
    90	        source: &CommandSource,
    91	    ) -> Result<Arc<dyn EntityBase>, CommandSyntaxError> {
    92	        let list = self.find_entities(source).await?;
    93	        match list.as_slice() {
    94	            [] => Err(entity::NO_ENTITIES_ERROR_TYPE.create_without_context()),
    95	            [entity] => Ok(entity.clone()),
    96	            _ => Err(entity::NOT_SINGLE_ENTITY_ERROR_TYPE.create_without_context()),
    97	        }
    98	    }
    99	
   100	    /// Tries to find any entities represented by this selector. If none are found, an empty `Vec` will still be returned.
   101	    pub async fn find_entities(
   102	        &self,
   103	        source: &CommandSource,
   104	    ) -> Result<Vec<Arc<dyn EntityBase>>, CommandSyntaxError> {
   105	        self.check_permissions(source).await?;
   106	        if !self.includes_entities {
   107	            self.find_players(source)
   108	                .await
   109	                .map(|v| v.into_iter().map(|p| p as Arc<dyn EntityBase>).collect())
   110	        } else if let Some(name) = self.player_name.as_ref() {
   111	            // Try to get the player by name.
   112	            let player = source
   113	                .server
   114	                .as_ref()
   115	                .and_then(|s| s.get_player_by_name(name));
   116	            Ok(player.map_or_else(Vec::new, |p| vec![p as Arc<dyn EntityBase>]))
   117	        } else if let Some(uuid) = self.entity_uuid.as_ref() {
   118	            // Try to get an entity by UUID.
   119	            for world in source.server().worlds.load().iter() {
   120	                if let Some(entity) = world.get_entity_by_uuid(*uuid) {
   121	                    return Ok(vec![entity]);
   122	                }
   123	            }
   124	            Ok(Vec::new())
   125	        } else {
   126	            let origin = self.position_function.apply(source.position);
   127	            let bounding_box = self.absolute_bounding_box(origin);
   128	            let predicate = self.predicate(origin, bounding_box);
   129	            if self.is_current_entity {
   130	                Ok(source
   131	                    .entity
   132	                    .as_ref()
   133	                    .filter(|p| predicate.test(p.as_ref()))
   134	                    .map_or_else(Vec::new, |p| vec![p.clone()]))
   135	            } else {
   136	                let mut list = Vec::new();
   137	                if self.is_world_limited {
   138	                    self.add_entities(&mut list, source.world().as_ref(), bounding_box, &predicate);
   139	                } else {
   140	                    for world in source.server().worlds.load().iter() {
   141	                        self.add_entities(&mut list, world, bounding_box, &predicate);
   142	                    }
   143	                }
   144	
   145	                Ok(self.sort_and_limit(origin, list))
   146	            }
   147	        }
   148	    }
   149	
   150	    fn add_entities(
   151	        &self,
   152	        list: &mut Vec<Arc<dyn EntityBase>>,
   153	        world: &World,
   154	        bounding_box: Option<BoundingBox>,
   155	        predicate: &EntitySelectorPredicate,
   156	    ) {
   157	        let limit = self.result_limit();
   158	        if let Some(b) = bounding_box {
   159	            world.extend_entities_in_box_where(list, limit, b, |e| predicate.test(e));
   160	        } else {
   161	            world.extend_entities_where(list, limit, |e| predicate.test(e));
   162	        }
   163	    }

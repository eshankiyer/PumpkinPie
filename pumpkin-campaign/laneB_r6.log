   126	impl ZombieEntityBase {
   127	    /// Builds a base from an already-configured `MobEntity` (used by variants that register
   128	    /// their own goal set instead of the shared zombie one).
   129	    pub const fn from_mob_entity(mob_entity: MobEntity) -> Self {
   130	        Self {
   131	            mob_entity,
   132	            restored_from_nbt: AtomicBool::new(false),
   133	            is_leader: AtomicBool::new(false),
   134	        }
   135	    }
   136	
   137	    /// Marks this zombie as restored from disk, suppressing the fresh-spawn attribute roll.
   138	    pub fn mark_restored_from_nbt(&self) {
   139	        self.restored_from_nbt.store(true, Ordering::Relaxed);
   140	    }
   141	
   142	    /// Runs `Zombie::handleAttributes` (`Zombie.java:531-558`) once, and only for a genuine
   143	    /// fresh spawn, recording the leader outcome in `is_leader`.
   144	    pub async fn roll_spawn_attributes(&self) {
   145	        if self.restored_from_nbt.load(Ordering::Relaxed) {
   146	            return;
   147	        }
   148	        let entity = &self.mob_entity.living_entity.entity;
   149	        let world = entity.world.load_full();
   150	        let difficulty = RegionalDifficulty::at(&world, entity.pos.load());
   151	        let is_leader = handle_attributes(
   152	            &self.mob_entity.living_entity,
   153	            difficulty.special_multiplier,
   154	        )
   155	        .await;
   156	        self.is_leader.store(is_leader, Ordering::Relaxed);
   157	    }
   158	}

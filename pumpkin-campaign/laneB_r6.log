    33	/// Vanilla `BlockPos.findClosestMatch(center, 5, 1, water)` using the same Manhattan traversal
    34	/// order as `BlockPos.withinManhattan`. The search is only used when the mob is on fire and its
    35	/// current block has no collision shape (`AnimalPanic.java:89-98`).
    36	fn nearest_water(world: &World, origin: BlockPos) -> Option<BlockPos> {
    37	    if !world.get_block_state(&origin).collision_shapes.is_empty() {
    38	        return None;
    39	    }
    40	
    41	    for depth in 0i32..=11 {
    42	        let max_x: i32 = 5.min(depth);
    43	        for x in -max_x..=max_x {
    44	            let max_y: i32 = 1.min(depth - x.abs());
    45	            for y in -max_y..=max_y {
    46	                let z = depth - x.abs() - y.abs();
    47	                if z > 5 {
    48	                    continue;
    49	                }
    50	
    51	                let candidate = BlockPos::new(origin.0.x + x, origin.0.y + y, origin.0.z + z);
    52	                let (fluid, _) = world.get_fluid_and_fluid_state(&candidate);
    53	                if fluid.has_tag(&tag::Fluid::MINECRAFT_WATER) {
    54	                    return Some(candidate);
    55	                }
    56	                if z != 0 {
    57	                    let candidate = BlockPos::new(origin.0.x + x, origin.0.y + y, origin.0.z - z);
    58	                    let (fluid, _) = world.get_fluid_and_fluid_state(&candidate);
    59	                    if fluid.has_tag(&tag::Fluid::MINECRAFT_WATER) {
    60	                        return Some(candidate);
    61	                    }
    62	                }
    63	            }
    64	        }
    65	    }
    66	    None
    67	}

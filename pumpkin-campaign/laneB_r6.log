   130	impl Sensor for NearestLivingEntitySensor {
   131	    /// `requires()` (`NearestLivingEntitySensor.java:28-30`).
   132	    fn requires(&self) -> &[MemoryKeyId] {
   133	        &REQUIRES
   134	    }
   135	
   136	    fn ticks_until_scan(&mut self) -> &mut i64 {
   137	        &mut self.ticks_until_scan
   138	    }
   139	
   140	    /// `doTick` (`NearestLivingEntitySensor.java:17-25`): collect every other living entity
   141	    /// in a FOLLOW_RANGE-inflated bounding box, sort nearest-first, write the list into
   142	    /// `NEAREST_LIVING_ENTITIES` and its per-entity visibility snapshot into
   143	    /// `NEAREST_VISIBLE_LIVING_ENTITIES`.
   144	    fn do_tick<'a>(&'a mut self, mob: &'a dyn Mob, brain: &'a Brain) -> SensorFuture<'a> {
   145	        Box::pin(async move {
   146	            let mob_entity = mob.get_mob_entity();
   147	            let living_entity = &mob_entity.living_entity;
   148	            let entity = &living_entity.entity;
   149	            let mob_pos = entity.pos.load();
   150	            let world = entity.world.load();
   151	            let observer_type = entity.entity_type;
   152	
   153	            let follow_range = living_entity.get_attribute_value(&Attributes::FOLLOW_RANGE);
   154	            let search_box =
   155	                entity
   156	                    .bounding_box
   157	                    .load()
   158	                    .expand(follow_range, follow_range, follow_range);
   159	
   160	            // `level.getEntitiesOfClass(LivingEntity.class, boundingBox, mob -> mob != body &&
   161	            // mob.isAlive())` (`NearestLivingEntitySensor.java:20`).
   162	            let mut candidates: Vec<(f64, Arc<dyn EntityBase>)> = world
   163	                .get_entities_at_box(&search_box)
   164	                .into_iter()
   165	                .filter_map(|candidate| {
   166	                    if candidate.get_entity().entity_id == entity.entity_id
   167	                        || candidate.get_living_entity().is_none()
   168	                        || !candidate.get_entity().is_alive()
   169	                    {
   170	                        return None;
   171	                    }
   172	                    let distance = candidate
   173	                        .get_entity()
   174	                        .pos
   175	                        .load()
   176	                        .squared_distance_to_vec(&mob_pos);
   177	                    Some((distance, candidate))
   178	                })
   179	                .collect();
   180	
   181	            // `livingEntities.sort(Comparator.comparingDouble(body::distanceToSqr))`
   182	            // (`NearestLivingEntitySensor.java:21`). This order is preserved into both
   183	            // memories, which is what makes findClosest "nearest".
   184	            candidates.sort_by(|a, b| a.0.total_cmp(&b.0));
   185	
   186	            let mut nearby: Vec<Weak<dyn EntityBase>> = Vec::with_capacity(candidates.len());
   187	            let mut visible: Vec<(Weak<dyn EntityBase>, bool)> =
   188	                Vec::with_capacity(candidates.len());
   189	            for (distance_sq, candidate) in candidates {
   190	                nearby.push(Arc::downgrade(&candidate));
   191	                let targetable = Self::is_targetable(
   192	                    mob_entity,
   193	                    observer_type,
   194	                    follow_range,
   195	                    distance_sq,
   196	                    &candidate,
   197	                )
   198	                .await;
   199	                visible.push((Arc::downgrade(&candidate), targetable));
   200	            }
   201	
   202	            brain.set::<NearestLivingEntitiesMemory>(nearby);
   203	            brain.set::<NearestVisibleLivingEntitiesMemory>(NearestVisibleLivingEntities::new(
   204	                visible,
   205	            ));
   206	        })
   207	    }
   208	}

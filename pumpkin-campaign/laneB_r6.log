   248	    fn parse_selector(&mut self) -> Result<(), CommandSyntaxError> {
   249	        self.uses_selector_variable = true;
   250	        self.suggestions = EntitySelectorParserSuggestions::Selector;
   251	        let i = self.reader.cursor();
   252	        let Some(char) = self.reader.read() else {
   253	            return Err(MISSING_SELECTOR_TYPE_ERROR_TYPE.create(self.reader));
   254	        };
   255	        let mut add_alive_predicate = false;
   256	        match char {
   257	            'a' => {
   258	                self.max_selected = i32::MAX;
   259	                self.includes_entities = false;
   260	                self.order = Order::Arbitrary;
   261	                self.limit_to_players();
   262	            }
   263	            'e' => {
   264	                self.max_selected = i32::MAX;
   265	                self.includes_entities = true;
   266	                self.order = Order::Arbitrary;
   267	                add_alive_predicate = true;
   268	            }
   269	            'n' => {
   270	                self.max_selected = 1;
   271	                self.includes_entities = true;
   272	                self.order = Order::Nearest;
   273	                add_alive_predicate = true;
   274	            }
   275	            'p' => {
   276	                self.max_selected = 1;
   277	                self.includes_entities = false;
   278	                self.order = Order::Nearest;
   279	                self.limit_to_players();
   280	            }
   281	            'r' => {
   282	                self.max_selected = 1;
   283	                self.includes_entities = false;
   284	                self.order = Order::Random;
   285	                self.limit_to_players();
   286	            }
   287	            's' => {
   288	                self.max_selected = 1;
   289	                self.includes_entities = true;
   290	                self.is_current_entity = true;
   291	            }
   292	            _ => {
   293	                self.reader.set_cursor(i);
   294	                let mut selector = "@".to_string();

   276	    async fn move_from_inventory_to_payment_slot(&self, payment_slot: usize, cost: &ItemStack) {
   277	        let mut payment = self.inventory.get_stack(payment_slot).await;
   278	
   279	        for slot in &self.get_behaviour().slots[3..] {
   280	            let mut source = slot.get_stack().await;
   281	            if source.is_empty()
   282	                || source.item.id != cost.item.id
   283	                || !cost.are_items_and_components_equal(&source)
   284	                || (!payment.is_empty()
   285	                    && (!source.are_items_and_components_equal(&payment)
   286	                        || !payment.are_items_and_components_equal(&source)))
   287	            {
   288	                continue;
   289	            }
   290	
   291	            if payment.is_empty() {
   292	                payment = source.copy_with_count(0);
   293	            }
   294	            let moved = source
   295	                .item_count
   296	                .min(source.get_max_stack_size() - payment.item_count);
   297	            payment.increment(moved);
   298	            source.decrement(moved);
   299	            if source.is_empty() {
   300	                source = ItemStack::EMPTY.clone();
   301	            }
   302	            slot.set_stack(source).await;
   303	            if payment.item_count == payment.get_max_stack_size() {
   304	                break;
   305	            }
   306	        }
   307	        self.inventory.set_stack(payment_slot, payment).await;
   308	    }

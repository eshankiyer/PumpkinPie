   441	   public WeightedList<MobSpawnSettings.SpawnerData> getMobsAt(
   442	      final Holder<Biome> biome, final StructureManager structureManager, final MobCategory mobCategory, final BlockPos pos
   443	   ) {
   444	      Map<Structure, LongSet> structures = structureManager.getAllStructuresAt(pos);
   445	
   446	      for (Entry<Structure, LongSet> entry : structures.entrySet()) {
   447	         Structure structure = entry.getKey();
   448	         StructureSpawnOverride override = structure.spawnOverrides().get(mobCategory);
   449	         if (override != null) {
   450	            MutableBoolean inOverrideBox = new MutableBoolean(false);
   451	            Predicate<StructureStart> check = override.boundingBox() == StructureSpawnOverride.BoundingBoxType.PIECE
   452	               ? start -> structureManager.structureHasPieceAt(pos, start)
   453	               : start -> start.getBoundingBox().isInside(pos);
   454	            structureManager.fillStartsForStructure(structure, entry.getValue(), start -> {
   455	               if (inOverrideBox.isFalse() && check.test(start)) {
   456	                  inOverrideBox.setTrue();
   457	               }
   458	            });
   459	            if (inOverrideBox.isTrue()) {
   460	               return override.spawns();
   461	            }
   462	         }
   463	      }
   464	
   465	      return biome.value().getMobSettings().getMobs(mobCategory);
   466	   }

   614	    pub fn list_suggestions<'a>(
   615	        context: &'a CommandContext<'_>,
   616	        suggestions_builder: SuggestionsBuilder,
   617	    ) -> Pin<Box<dyn Future<Output = Suggestions> + Send + 'a>> {
   618	        Box::pin(async move {
   619	            let mut reader = StringReader::new(suggestions_builder.input.clone());
   620	            reader.set_cursor(suggestions_builder.start);
   621	            let mut parser = EntitySelectorParser::new(
   622	                &mut reader,
   623	                context
   624	                    .source
   625	                    .has_permission(ENTITY_SELECTOR_PERMISSION)
   626	                    .await,
   627	            );
   628	
   629	            let _ = parser.parse();
   630	
   631	            parser.fill_suggestions(&suggestions_builder, |mut suggestions| {
   632	                for player in context.server().get_all_players() {
   633	                    suggestions =
   634	                        suggestions.filter_and_suggest_one(player.gameprofile.name.clone());
   635	                }
   636	                // ONLY FOR EntityArgumentType: This is server-side, so no other entity will show up.
   637	                suggestions
   638	            })
   639	        })
   640	    }
   641	}

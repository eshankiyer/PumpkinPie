   362	            if !self.converting.load(Ordering::Relaxed)
   363	                || self
   364	                    .get_mob_entity()
   365	                    .living_entity
   366	                    .dead
   367	                    .load(Ordering::Relaxed)
   368	            {
   369	                return;
   370	            }
   371	
   372	            let amount = self.conversion_progress();
   373	            let remaining = self.conversion_time.fetch_sub(amount, Ordering::Relaxed) - amount;
   374	            if remaining <= 0 {
   375	                self.finish_conversion().await;
   376	            }
   377	        })
   378	    }
   379	
   380	    /// ZombieVillager.java:163-180 (`mobInteract`): a golden apple only does something
   381	    /// while the zombie villager has Weakness; otherwise the click is swallowed
   382	    /// (`InteractionResult.CONSUME`) without eating the apple.
   383	    fn mob_interact<'a>(
   384	        &'a self,
   385	        player: &'a Arc<Player>,
   386	        item_stack: &'a mut ItemStack,
   387	    ) -> EntityBaseFuture<'a, bool> {
   388	        Box::pin(async move {
   389	            if item_stack.item.id != Item::GOLDEN_APPLE.id {
   390	                return self
   391	                    .get_mob_entity()
   392	                    .mob_interact(player, item_stack, self.can_be_leashed())
   393	                    .await;
   394	            }
   395	
   396	            if !self
   397	                .get_mob_entity()
   398	                .living_entity
   399	                .has_effect(&StatusEffect::WEAKNESS)
   400	                .await
   401	            {
   402	                return true;
   403	            }
   404	
   405	            item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   406	            let ticks = rand::random_range(3600..=6000); // ZombieVillager.java:170
   407	            self.start_converting(Some(player.get_entity().entity_uuid), ticks)
   408	                .await;
   409	            true
   410	        })
   411	    }
   412	}

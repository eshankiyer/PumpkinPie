    38	pub struct ZombieEntityBase {
    39	    pub mob_entity: MobEntity,
    40	    /// Set by every `read_nbt_non_mut` on the zombie family. Vanilla's `finalizeSpawn` -- and
    41	    /// so `Zombie::handleAttributes` (`Zombie.java:505`) -- never runs for an entity restored
    42	    /// from disk, but Pumpkin calls `init_data_tracker` on both fresh spawns and chunk loads.
    43	    /// NBT is read first in both paths, so this flag distinguishes the two and keeps a chunk
    44	    /// reload from re-rolling leader status.
    45	    restored_from_nbt: AtomicBool,
    46	    /// Whether the last `Zombie::handleAttributes` roll made this a leader zombie
    47	    /// (`Zombie.java:543`). Read by `ZombieEntity` to force door breaking
    48	    /// (`Zombie.java:556`).
    49	    pub is_leader: AtomicBool,
    50	}
    51	
    52	impl ZombieEntityBase {
    53	    pub fn new(entity: Entity) -> Arc<Self> {
    54	        let mob_entity = MobEntity::new(entity);
    55	        let zombie = Self {
    56	            mob_entity,
    57	            restored_from_nbt: AtomicBool::new(false),
    58	            is_leader: AtomicBool::new(false),
    59	        };
    60	        let mob_arc = Arc::new(zombie);
    61	        let mob_weak: Weak<dyn Mob> = {
    62	            let mob_arc: Arc<dyn Mob> = mob_arc.clone();
    63	            Arc::downgrade(&mob_arc)
    64	        };
    65	
    66	        {
    67	            let mut goal_selector = mob_arc
    68	                .mob_entity
    69	                .goals_selector
    70	                .lock()
    71	                .unwrap_or_else(std::sync::PoisonError::into_inner);
    72	            let mut target_selector = mob_arc
    73	                .mob_entity
    74	                .target_selector
    75	                .lock()
    76	                .unwrap_or_else(std::sync::PoisonError::into_inner);
    77	
    78	            goal_selector.add_goal(0, Box::new(SwimGoal::default()));
    79	            goal_selector.add_goal(2, SpearUseGoal::new(1.0, 1.0, 10.0, 2.0));
    80	            goal_selector.add_goal(3, ZombieAttackGoal::new(1.0, false));
    81	            goal_selector.add_goal(4, DestroyEggGoal::new(1.0, 3));
    82	            goal_selector.add_goal(7, Box::new(WanderAroundGoal::new_water_avoiding(1.0)));
    83	            goal_selector.add_goal(
    84	                8,
    85	                LookAtEntityGoal::with_default(mob_weak, &EntityType::PLAYER, 8.0),
    86	            );
    87	            goal_selector.add_goal(8, Box::new(RandomLookAroundGoal::default()));
    88	
    89	            target_selector.add_goal(1, Box::new(RevengeGoal::new(true)));
    90	            target_selector.add_goal(
    91	                2,
    92	                ActiveTargetGoal::with_default(&mob_arc.mob_entity, &EntityType::PLAYER, true),
    93	            );
    94	            target_selector.add_goal(
    95	                3,
    96	                // `Zombie#addBehaviourGoals` targets `AbstractVillager` with visibility
    97	                // disabled. The concrete implementations in this version are villagers and
    98	                // wandering traders.
    99	                ActiveTargetGoal::with_default_types(
   100	                    &mob_arc.mob_entity,
   101	                    &[&EntityType::VILLAGER, &EntityType::WANDERING_TRADER],
   102	                    false,
   103	                ),
   104	            );
   105	            target_selector.add_goal(
   106	                3,
   107	                ActiveTargetGoal::with_default(&mob_arc.mob_entity, &EntityType::IRON_GOLEM, true),
   108	            );
   109	            target_selector.add_goal(
   110	                5,
   111	                Box::new(ActiveTargetGoal::new(
   112	                    &mob_arc.mob_entity,
   113	                    &EntityType::TURTLE,
   114	                    10,
   115	                    true,
   116	                    false,
   117	                    Some(baby_turtle_on_land),
   118	                )),
   119	            );
   120	        };
   121	
   122	        mob_arc
   123	    }
   124	}

   144	/// vanilla `EntitySelector.pushableBy`.
   145	///
   146	/// Whether scoreboard team collision rules allow an entity with the resolved `pusher_rule`/
   147	/// `pusher_team_name` (see [`pusher_team_state`]) to push `other`. Entities with no team resolve
   148	/// to `CollisionRule::Always`, so untagged entities always push normally.
   149	/// (net.minecraft.world.entity.EntitySelector, decompiled 26.2, lines 29-56)
   150	async fn team_allows_push(
   151	    world: &World,
   152	    pusher_rule: crate::world::scoreboard::CollisionRule,
   153	    pusher_team_name: Option<&str>,
   154	    other: &dyn EntityBase,
   155	) -> bool {
   156	    use crate::world::scoreboard::{
   157	        CollisionRule, collision_rule_permits_push, entity_scoreboard_name,
   158	    };
   159	
   160	    if matches!(pusher_rule, CollisionRule::Never) {
   161	        return false;
   162	    }
   163	
   164	    let other_name = entity_scoreboard_name(other);
   165	    let scoreboard = world.scoreboard.lock().await;
   166	    let other_team = scoreboard.get_team_for_scoreboard_name(&other_name);
   167	    let other_rule = other_team.map_or(CollisionRule::Always, |t| t.collision_rule);
   168	    let same_team = pusher_team_name.is_some_and(|name| other_team.is_some_and(|t| t.name == name));
   169	
   170	    collision_rule_permits_push(pusher_rule, other_rule, same_team)
   171	}

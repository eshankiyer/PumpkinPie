   165	    /// Tries to find a single player represented by this selector.
   166	    pub async fn find_single_player(
   167	        &self,
   168	        source: &CommandSource,
   169	    ) -> Result<Arc<Player>, CommandSyntaxError> {
   170	        let mut list = self.find_players(source).await?;
   171	        if list.len() == 1 {
   172	            list.pop()
   173	                .ok_or_else(|| entity::NO_PLAYERS_ERROR_TYPE.create_without_context())
   174	        } else {
   175	            Err(entity::NO_PLAYERS_ERROR_TYPE.create_without_context())
   176	        }
   177	    }
   178	
   179	    /// Tries to find any players represented by this selector.
   180	    pub async fn find_players(
   181	        &self,
   182	        source: &CommandSource,
   183	    ) -> Result<Vec<Arc<Player>>, CommandSyntaxError> {
   184	        self.check_permissions(source).await?;
   185	        if let Some(name) = self.player_name.as_ref() {
   186	            // Try to get the player by name.
   187	            let player = source
   188	                .server
   189	                .as_ref()
   190	                .and_then(|s| s.get_player_by_name(name));
   191	            Ok(player.map_or_else(Vec::new, |p| vec![p]))
   192	        } else if let Some(uuid) = self.entity_uuid.as_ref() {
   193	            // Try to get an entity by UUID.
   194	            for world in source.server().worlds.load().iter() {
   195	                if let Some(player) = world.get_player_by_uuid(*uuid) {
   196	                    return Ok(vec![player]);
   197	                }
   198	            }
   199	            Ok(Vec::new())
   200	        } else {
   201	            let origin = self.position_function.apply(source.position);
   202	            let bounding_box = self.absolute_bounding_box(origin);
   203	            let predicate = self.predicate(origin, bounding_box);
   204	            if self.is_current_entity {
   205	                Ok(source
   206	                    .entity
   207	                    .as_ref()
   208	                    .and_then(|e| {
   209	                        source
   210	                            .server()
   211	                            .get_player_by_uuid(e.get_entity().entity_uuid)
   212	                    })
   213	                    .filter(|p| predicate.test(p.as_ref()))
   214	                    .map_or_else(Vec::new, |p| vec![p]))
   215	            } else {
   216	                let limit = self.result_limit();
   217	                let mut list = Vec::new();
   218	                if limit > 0 {
   219	                    if self.is_world_limited {
   220	                        Self::add_players_from_world(source.world(), &mut list, &predicate, limit);
   221	                    } else {
   222	                        for world in source.server().worlds.load().iter() {
   223	                            Self::add_players_from_world(
   224	                                world.as_ref(),
   225	                                &mut list,
   226	                                &predicate,
   227	                                limit,
   228	                            );
   229	                        }
   230	                    }
   231	                }
   232	
   233	                Ok(self.sort_and_limit(origin, list))
   234	            }
   235	        }
   236	    }
   237	
   238	    fn add_players_from_world(
   239	        world: &World,
   240	        list: &mut Vec<Arc<Player>>,
   241	        predicate: &EntitySelectorPredicate,
   242	        limit: usize,
   243	    ) {
   244	        for player in world.players.load().iter() {
   245	            if predicate.test(player.as_ref()) {
   246	                list.push(player.clone());
   247	                if list.len() >= limit {
   248	                    return;
   249	                }
   250	            }
   251	        }
   252	    }

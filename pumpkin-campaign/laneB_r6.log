   310	    pub async fn update_result_slot(&mut self) {
   311	        let input_a = self.inventory.get_stack(0).await;
   312	        let input_b = self.inventory.get_stack(1).await;
   313	        self.active_offer = self.find_active_offer(&input_a, &input_b);
   314	
   315	        if let Some(index) = self.active_offer {
   316	            self.inventory
   317	                .set_stack(2, (*self.offers[index].output.0).clone())
   318	                .await;
   319	        } else {
   320	            self.inventory.set_stack(2, ItemStack::EMPTY.clone()).await;
   321	        }
   322	    }
   323	
   324	    async fn notify_trade_updated(&self) {
   325	        if self.inventory.get_stack(0).await.is_empty()
   326	            && self.inventory.get_stack(1).await.is_empty()
   327	        {
   328	            return;
   329	        }
   330	        if let Some(on_trade_updated) = &self.on_trade_updated {
   331	            on_trade_updated(self.active_offer.is_some());
   332	        }
   333	    }
   334	}

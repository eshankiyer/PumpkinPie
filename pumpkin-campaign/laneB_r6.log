   297	            // the trader still (`WanderingTrader.java:79, 212`).
   298	            if let Some(server_player) = player.as_any().downcast_ref::<Player>() {
   299	                *self
   300	                    .trading_player
   301	                    .lock()
   302	                    .unwrap_or_else(std::sync::PoisonError::into_inner) =
   303	                    Some(server_player.get_entity().entity_uuid);
   304	            }
   305	            let close_weak = self_weak.clone();
   306	            handler.on_close = Some(Box::new(move || {
   307	                let close_weak = close_weak.clone();

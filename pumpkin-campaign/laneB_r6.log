   117	/// `Brain<E>` (`Brain.java:40-49`), split per the module comment.
   118	pub struct Brain {
   119	    /// Always live. Short-held lock only; never `mem::take`n.
   120	    pub memory: Mutex<MemoryStore>,
   121	    /// Taken out for the duration of the tick.
   122	    runtime: Mutex<BrainRuntime>,
   123	    /// Immutable after construction, so activity switching never has to nest the two locks.
   124	    core_activities: Vec<Activity>,
   125	    activity_requirements: Vec<(Activity, Vec<(MemoryKeyId, MemoryStatus)>)>,
   126	    activity_memories_to_erase: Vec<(Activity, Vec<MemoryKeyId>)>,
   127	    default_activity: Activity,
   128	}

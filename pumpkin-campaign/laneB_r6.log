    29	/// `AnimalPanic.PANIC_DISTANCE_HORIZONTAL` / `PANIC_DISTANCE_VERTICAL` (`:29-30`).
    30	const PANIC_DISTANCE_HORIZONTAL: f64 = 5.0;

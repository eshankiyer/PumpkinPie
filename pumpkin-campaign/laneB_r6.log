diff --git a/crates/pumpkin/src/entity/living.rs b/crates/pumpkin/src/entity/living.rs
index 036fdb7915c359b6b0dbfe2811c6c65711d218ef..58fbbd081a9efe87ef1440d51df5703aefeb6d0d
--- a/crates/pumpkin/src/entity/living.rs
+++ b/crates/pumpkin/src/entity/living.rs
@@ -5323,7 +5323,19 @@
                     .get_mob()
                     .and_then(Mob::get_hurt_sound)
                     .unwrap_or_else(|| self.hurt_sound());
-                world.play_sound(hurt_sound, SoundCategory::Players, &self.entity.pos.load());
+                let pitch = caller
+                    .get_mob()
+                    .map(Mob::get_sound_pitch)
+                    .unwrap_or(1.0);
+                // `LivingEntity.makeSound` passes `getVoicePitch` to the sound packet
+                // (`LivingEntity.java:1427-1434`).
+                world.play_sound_fine(
+                    hurt_sound,
+                    SoundCategory::Players,
+                    &self.entity.pos.load(),
+                    1.0,
+                    pitch,
+                );
 
                 // `LivingEntity.hurtServer` gates the default 0.4 knockback on the

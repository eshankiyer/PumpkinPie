   784	#[allow(clippy::too_many_lines)]
   785	pub fn spawn_category_for_position(
   786	    category: &'static MobCategory,
   787	    world: &Arc<World>,
   788	    pos: BlockPos,
   789	    chunk_pos: &Vector2<i32>,
   790	    spawn_state: &SpawnState,
   791	    is_thundering: bool,
   792	) -> Vec<Arc<dyn EntityBase>> {
   793	    if world.get_block_state(&pos).is_solid_block() {
   794	        return Vec::new();
   795	    }
   796	
   797	    let mut batch_buffer = vec![];
   798	    let mut spawn_cluster_size = 0;
   799	    let player_positions: Vec<_> = world
   800	        .players
   801	        .load()
   802	        .iter()
   803	        .filter(|player| counts_for_natural_spawning(player.gamemode.load()))
   804	        .map(|p| p.position())
   805	        .collect();
   806	    // Vanilla's getNearestPlayer(..., false) returns null when only spectators are
   807	    // online, and NaturalSpawner skips the attempt in that case. Do not let the
   808	    // f64::MAX sentinel in get_nearest_player turn that into an eligible spawn.
   809	    if player_positions.is_empty() {
   810	        return batch_buffer;

+        assert_eq!(zombie_villager_voice_pitch(true, 1.0, 0.0), 2.2);
+        assert!((0.8..=1.2).contains(&zombie_villager_voice_pitch(false, 0.0, 1.0)));
+        assert!((1.8..=2.2).contains(&zombie_villager_voice_pitch(true, 0.0, 1.0)));
+    }

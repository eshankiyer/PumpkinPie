    52	
    53	    fn handle_game_event<'a>(
    54	        &'a self,
    55	        world: &'a Arc<World>,
    56	        event: &'a GameEvent,
    57	        context: &'a GameEventContext,
    58	        source_position: Vector3<f64>,
    59	    ) -> GameEventFuture<'a> {
    60	        Box::pin(async move {
    61	            let (block, _) = world.get_block_and_state(&self.pos);
    62	            if block.id != BlockId::SCULK_SENSOR && block.id != BlockId::CALIBRATED_SCULK_SENSOR {
    63	                return false;
    64	            }
    65	
    66	            // SculkSensorBlockEntity.VibrationUser.canReceiveVibration: a block_destroy
    67	            // or block_place at the sensor's own position is ignored (the sensor's own
    68	            // placement/removal must not self-trigger it).
    69	            let event_pos = BlockPos::new(
    70	                source_position.x.floor() as i32,
    71	                source_position.y.floor() as i32,
    72	                source_position.z.floor() as i32,
    73	            );
    74	            if event_pos == self.pos
    75	                && matches!(event, GameEvent::BlockDestroy | GameEvent::BlockPlace)
    76	            {
    77	                return false;
    78	            }
    79	
    80	            let listener_pos = PositionSource::Block(self.pos)
    81	                .get_position(world)
    82	                .expect("block position source always resolves");
    83	            let distance = (listener_pos - source_position).length() as f32;
    84	            let power = redstone_strength_for_distance(distance, self.radius);
    85	            let frequency = crate::world::game_event::vibration_frequency(event);
    86	            // Vanilla `SculkSensorBlockEntity.VibrationUser.canReceiveVibration`
    87	            // (`SculkSensorBlockEntity.java:102-107`) rejects events with no vibration
    88	            // frequency before delegating to the sensor activation check.
    89	            if frequency == 0 {
    90	                return false;
    91	            }
    92	
    93	            let _ = context;
    94	            SculkSensorBlock::trigger(world, &self.pos, block, power, frequency).await;
    95	            true
    96	        })
    97	    }
    98	}

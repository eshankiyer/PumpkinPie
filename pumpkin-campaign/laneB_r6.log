   307	
   308	    fn activity_requirements_are_met(&self, activity: Activity) -> bool {
   309	        // Brain.activityRequirementsAreMet (Brain.java:434+): an activity with no registered
   310	        // requirement entry at all returns false.
   311	        let Some((_, conditions)) = self
   312	            .activity_requirements
   313	            .iter()
   314	            .find(|(candidate, _)| *candidate == activity)
   315	        else {
   316	            return false;
   317	        };
   318	        self.check_memories(conditions)
   319	    }

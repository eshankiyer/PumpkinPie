   229	    // --- memory accessors -------------------------------------------------------------
   230	    //
   231	    // Each of these takes the memory lock for the duration of exactly one field access. This
   232	    // is the only sanctioned way for behaviors and external (non-AI-tick) code to touch
   233	    // memory; it makes "never hold the memory lock across an await, never hold it while
   234	    // taking a controller lock" structurally hard to get wrong.
   235	
   236	    pub fn register<K: MemoryKey>(&self) {
   237	        self.memory.lock().unwrap().register(K::ID);
   238	    }
   239	
   240	    /// Cloning read. Vanilla returns the live object; every memory value in this stage is
   241	    /// cheap to clone (`WalkTarget`, `PositionTracker`, `Weak`, primitives).
   242	    #[must_use]
   243	    pub fn get<K: MemoryKey>(&self) -> Option<K::Value>
   244	    where
   245	        K::Value: Clone,
   246	    {
   247	        self.memory.lock().unwrap().get::<K>().cloned()
   248	    }
   249	
   250	    pub fn set<K: MemoryKey>(&self, value: K::Value) {
   251	        self.memory.lock().unwrap().set::<K>(value);
   252	    }
   253	
   254	    pub fn set_with_expiry<K: MemoryKey>(&self, value: K::Value, time_to_live: i64) {
   255	        self.memory
   256	            .lock()
   257	            .unwrap()
   258	            .set_with_expiry::<K>(value, time_to_live);
   259	    }
   260	
   261	    pub fn erase<K: MemoryKey>(&self) {
   262	        self.memory.lock().unwrap().erase::<K>();
   263	    }
   264	
   265	    /// `Brain.clearMemories` (`Brain.java:154-156`).
   266	    pub fn clear_memories(&self) {
   267	        self.memory.lock().unwrap().clear();
   268	    }
   269	
   270	    #[must_use]
   271	    pub fn has_value<K: MemoryKey>(&self) -> bool {
   272	        self.memory.lock().unwrap().has_value::<K>()
   273	    }
   274	
   275	    /// `Brain.isMemoryValue` (`Brain.java:237-240`).
   276	    #[must_use]
   277	    pub fn is_memory_value<K: MemoryKey>(&self, value: &K::Value) -> bool
   278	    where
   279	        K::Value: PartialEq,
   280	    {
   281	        self.memory.lock().unwrap().get::<K>() == Some(value)
   282	    }
   283	
   284	    /// `Brain.getTimeUntilExpiry` (`Brain.java:225-227`).
   285	    #[must_use]
   286	    pub fn time_until_expiry<K: MemoryKey>(&self) -> i64 {
   287	        self.memory.lock().unwrap().time_until_expiry::<K>()
   288	    }
   289	
   290	    /// `Behavior.hasRequiredMemories` (`behavior/Behavior.java:97-107`): every entry condition
   291	    /// must hold. Checked under a single lock acquisition.
   292	    #[must_use]
   293	    pub fn check_memories(&self, conditions: &[(MemoryKeyId, MemoryStatus)]) -> bool {
   294	        let store = self.memory.lock().unwrap();
   295	        conditions
   296	            .iter()
   297	            .all(|(id, status)| store.check(*id, *status))
   298	    }
   299	
   300	    /// `Brain.checkMemory` (`Brain.java:242-249`).
   301	    #[must_use]
   302	    pub fn check_memory(&self, id: MemoryKeyId, status: MemoryStatus) -> bool {
   303	        self.memory.lock().unwrap().check(id, status)
   304	    }

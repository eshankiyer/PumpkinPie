   225	    /// Tries to parse the selector from the provided [`StringReader`].
   226	    pub fn parse(&mut self) -> Result<(), CommandSyntaxError> {
   227	        self.start_position = self.reader.cursor();
   228	        self.suggestions = EntitySelectorParserSuggestions::NameOrSelector;
   229	        if self.reader.peek() == Some('@') {
   230	            if !self.allows_selector_variable {
   231	                return Err(SELECTORS_NOT_ALLOWED_ERROR_TYPE.create(self.reader));
   232	            }
   233	            self.reader.skip();
   234	            self.parse_selector()?;
   235	        } else {
   236	            self.parse_name_or_uuid()?;
   237	        }
   238	        Ok(())
   239	    }
   240	
   241	    /// Tries to parse the selector from the provided [`StringReader`], and consumes
   242	    /// itself in the process.
   243	    pub fn parse_and_consume(mut self) -> Result<EntitySelector, CommandSyntaxError> {
   244	        self.parse()?;
   245	        Ok(self.selector())
   246	    }

   138	///
   139	/// `NoteBlock.getPitchFromNote(toneMap[frequency])`, where
   140	/// `getPitchFromNote(note) = 2^((note - 12) / 12)` (`NoteBlock.java:143-145`).
   141	#[must_use]
   142	pub fn resonance_pitch_bend(frequency: i32) -> f32 {
   143	    const TONE_MAP: [i32; 16] = [0, 0, 2, 4, 6, 7, 9, 10, 12, 14, 15, 18, 19, 21, 22, 24];
   144	    let index = frequency.clamp(0, 15) as usize;
   145	    f32::powf(2.0, (TONE_MAP[index] - 12) as f32 / 12.0)
   146	}

+            min: Vector3::new(pos.0.x as f64, pos.0.y as f64, pos.0.z as f64),
+            max: Vector3::new(
+                max.0.x as f64 + 1.0,
+                max.0.y as f64 + 1.0,
+                max.0.z as f64 + 1.0,

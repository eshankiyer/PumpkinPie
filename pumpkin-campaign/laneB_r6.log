   187	    async fn consume_payment(&self, slot: usize, count: u8) {
   188	        let mut stack = self.inventory.get_stack(slot).await;
   189	        stack.decrement(count);
   190	        if stack.is_empty() {
   191	            stack = ItemStack::EMPTY.clone();
   192	        }
   193	        self.inventory.set_stack(slot, stack).await;
   194	        self.get_behaviour().slots[slot].mark_dirty().await;
   195	    }

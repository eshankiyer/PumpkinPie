  2071	        let horizontal_speed = velocity.x.hypot(velocity.z);
  2072	        let look = caller.get_looking_vector();
  2073	        let pitch = f64::from(self.entity.pitch.load()).to_radians();
  2074	        let gravity = self.get_effective_gravity(caller).await;

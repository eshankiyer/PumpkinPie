  2368	            self.entity.entity_type,
  2369	            self.entity.horizontal_collision.load(SeqCst),
  2370	        ) {
  2371	            let was_climbing = self.climbing.swap(climbing, Relaxed);
  2372	
  2373	            if climbing != was_climbing {
  2374	                self.entity.send_meta_data(
  2375	                    &[Metadata::new(
  2376	                        tracked_data::spider::DATA_FLAGS_ID,

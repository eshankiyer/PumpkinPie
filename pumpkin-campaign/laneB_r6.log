   962	    /// Internal slot click handling implementation.
   963	    ///
   964	    /// Handles all click types: pickup, quick move, swap, throw, drag, clone.
   965	    #[expect(clippy::too_many_lines)]
   966	    fn internal_on_slot_click<'a>(
   967	        &'a mut self,
   968	        slot_index: i32,
   969	        button: i32,
   970	        action_type: SlotActionType,
   971	        player: &'a dyn InventoryPlayer,
   972	    ) -> ScreenHandlerFuture<'a, ()> {
   973	        Box::pin(async move {
   974	            if action_type == SlotActionType::PickupAll && button == 0 {
   975	                let behavior = self.get_behaviour_mut();
   976	                let mut cursor_stack = behavior.cursor_stack.lock().await;
   977	                let mut to_pick_up = cursor_stack.get_max_stack_size() - cursor_stack.item_count;
   978	
   979	                for slot in &behavior.slots {
   980	                    if to_pick_up == 0 {
   981	                        break;
   982	                    }
   983	
   984	                    let item_stack = slot.get_cloned_stack().await;
   985	                    if !item_stack.are_items_and_components_equal(&cursor_stack) {
   986	                        continue;
   987	                    }
   988	
   989	                    if !slot.allow_modification(player).await {
   990	                        continue;
   991	                    }
   992	
   993	                    let taken_stack = slot
   994	                        .safe_take(
   995	                            item_stack.item_count.min(to_pick_up),
   996	                            cursor_stack.get_max_stack_size() - cursor_stack.item_count,
   997	                            player,
   998	                        )
   999	                        .await;
  1000	                    to_pick_up -= taken_stack.item_count;
  1001	                    cursor_stack.increment(taken_stack.item_count);
  1002	                }
  1003	            } else if action_type == SlotActionType::QuickCraft {
  1004	                let drag_type = button & 3;
  1005	                let drag_button = (button >> 2) & 3;
  1006	                let behaviour = self.get_behaviour_mut();
  1007	                if drag_type == 0 {
  1008	                    behaviour.drag_slots.clear();
  1009	                } else if drag_type == 1 {
  1010	                    if slot_index < 0 {
  1011	                        warn!("Invalid slot index for drag action: {slot_index}. Must be >= 0");
  1012	                        return;
  1013	                    }
  1014	                    let cursor_stack = behaviour.cursor_stack.lock().await;
  1015	
  1016	                    let slot = &behaviour.slots[slot_index as usize];
  1017	                    let stack = slot.get_stack().await;
  1018	                    if !cursor_stack.is_empty()
  1019	                        && slot.can_insert(&cursor_stack).await
  1020	                        && (stack.are_items_and_components_equal(&cursor_stack) || stack.is_empty())
  1021	                        && slot.get_max_item_count_for_stack(&stack).await > stack.item_count
  1022	                    {
  1023	                        behaviour.drag_slots.push(slot_index as u32);
  1024	                    }
  1025	                } else if drag_type == 2 && !behaviour.drag_slots.is_empty() {
  1026	                    // process drag end
  1027	                    if behaviour.drag_slots.len() == 1 {
  1028	                        let slot = behaviour.drag_slots[0] as i32;
  1029	                        behaviour.drag_slots.clear();
  1030	                        let _ = behaviour;
  1031	                        self.internal_on_slot_click(
  1032	                            slot,
  1033	                            drag_button,
  1034	                            SlotActionType::Pickup,
  1035	                            player,
  1036	                        )
  1037	                        .await;
  1038	
  1039	                        return;
  1040	                    }
  1041	                    if drag_button == 2 && !player.has_infinite_materials() {
  1042	                        return; // Only creative
  1043	                    }
  1044	
  1045	                    let mut cursor_stack = behaviour.cursor_stack.lock().await;
  1046	                    let initial_count = cursor_stack.item_count;
  1047	                    let slots_count = behaviour.drag_slots.len();
  1048	                    for slot_index in &behaviour.drag_slots {
  1049	                        let Some(slot) = behaviour.slots.get(*slot_index as usize).cloned() else {
  1050	                            continue;
  1051	                        };
  1052	                        let stack = slot.get_stack().await;
  1053	
  1054	                        if (stack.are_items_and_components_equal(&cursor_stack) || stack.is_empty())
  1055	                            && slot.can_insert(&cursor_stack).await
  1056	                        {
  1057	                            let mut inserting_count = match drag_button {
  1058	                                0 => (initial_count as usize)
  1059	                                    .checked_div(slots_count)
  1060	                                    .map_or(0, |c| c as u8),
  1061	                                1 => 1,
  1062	                                2 => {
  1063	                                    cursor_stack.item_count = cursor_stack.get_max_stack_size();
  1064	                                    cursor_stack.item_count
  1065	                                }
  1066	                                _ => 0,
  1067	                            };
  1068	                            // `AbstractContainerMenu.java:384-386` caps against
  1069	                            // `min(source.getMaxStackSize(), slot.getMaxStackSize(source))`,
  1070	                            // i.e. the CARRIED stack's limit, and does the headroom
  1071	                            // subtraction on a signed int. Using the slot's own (possibly
  1072	                            // empty) stack and a `u8` subtraction both diverge: the latter
  1073	                            // underflows whenever the slot already holds more than the
  1074	                            // carried stack's max size permits.
  1075	                            let headroom = slot
  1076	                                .get_max_item_count_for_stack(&cursor_stack)
  1077	                                .await
  1078	                                .saturating_sub(stack.item_count);
  1079	                            inserting_count =
  1080	                                inserting_count.min(headroom).min(cursor_stack.item_count);
  1081	                            if inserting_count > 0 {
  1082	                                let mut new_stack = stack.clone();
  1083	                                if new_stack.is_empty() {
  1084	                                    new_stack = cursor_stack.copy_with_count(0);
  1085	                                }
  1086	                                new_stack.increment(inserting_count);
  1087	                                slot.set_stack(new_stack).await;
  1088	                                if drag_button != 2 {
  1089	                                    cursor_stack.decrement(inserting_count);
  1090	                                }
  1091	                                if cursor_stack.is_empty() {
  1092	                                    *cursor_stack = ItemStack::EMPTY.clone();
  1093	                                    break;
  1094	                                }
  1095	                            }
  1096	                        }
  1097	                    }
  1098	
  1099	                    if drag_button == 2 {
  1100	                        *cursor_stack = ItemStack::EMPTY.clone();
  1101	                    }
  1102	                    behaviour.drag_slots.clear();
  1103	                }
  1104	            } else if action_type == SlotActionType::Throw {
  1105	                if slot_index >= 0 && self.get_behaviour().cursor_stack.lock().await.is_empty() {
  1106	                    let slot = self.get_behaviour().slots[slot_index as usize].clone();
  1107	                    let prev_stack = slot.get_cloned_stack().await;
  1108	                    if !prev_stack.is_empty() {
  1109	                        if button == 1 {
  1110	                            // Throw all
  1111	                            while slot
  1112	                                .get_cloned_stack()
  1113	                                .await
  1114	                                .are_items_and_components_equal(&prev_stack)
  1115	                            {
  1116	                                let drop_stack =
  1117	                                    slot.safe_take(prev_stack.item_count, u8::MAX, player).await;
  1118	                                player.drop_item(drop_stack, true).await;
  1119	                                // player.handleCreativeModeItemDrop(itemStack);
  1120	                            }
  1121	                        } else {
  1122	                            let drop_stack = slot.safe_take(1, u8::MAX, player).await;
  1123	                            if !drop_stack.is_empty() {
  1124	                                slot.on_take_item(player, &drop_stack).await;
  1125	                                player.drop_item(drop_stack, true).await;
   240	                    false,
   241	                ))
   242	                .await;
   243	        }
   244	    }

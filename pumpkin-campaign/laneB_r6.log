    58	/// Waxes the block at `location` if it has a waxed equivalent, emitting the wax
    59	/// particles and sound on success.
    60	pub(crate) async fn try_wax_block(world: &Arc<World>, location: BlockPos, block: &Block) -> bool {
    61	    let Some(replacement) = get_waxed_equivalent(block.id) else {
    62	        return false;
    63	    };
    64	    let new_block = replacement.to_block();
    65	
    66	    let new_state_id = if block.has_tag(&tag::Block::MINECRAFT_DOORS) {
    67	        // Carry the door state over to the waxed door.
    68	        let door_information = world.get_block_state_id(&location);
    69	        let door_props = OakDoorLikeProperties::from_state_id(door_information, block);
    70	        let mut new_door_properties = OakDoorLikeProperties::default(new_block);
    71	        new_door_properties.facing = door_props.facing;
    72	        new_door_properties.open = door_props.open;
    73	        new_door_properties.half = door_props.half;
    74	        new_door_properties.hinge = door_props.hinge;
    75	        new_door_properties.powered = door_props.powered;
    76	        new_door_properties.to_state_id(new_block)
    77	    } else if block.has_tag(&tag::Block::MINECRAFT_TRAPDOORS) {
    78	        // Carry the trapdoor state over to the waxed trapdoor.
    79	        let trapdoor_information = world.get_block_state_id(&location);
    80	        wax_trapdoor_state(trapdoor_information, block, new_block)
    81	    } else {
    82	        let old_state_id = world.get_block_state_id(&location);
    83	        crate::item::items::state_with_properties_of(block, old_state_id, new_block)
    84	    };
    85	
    86	    world
    87	        .set_block_state(&location, new_state_id, BlockFlags::NOTIFY_ALL)
    88	        .await;
    89	    world.sync_world_event(WorldEvent::ParticlesAndSoundWaxOn, location, 0);
    90	    true
    91	}

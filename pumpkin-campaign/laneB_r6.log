  2646	    /// Vanilla `LivingEntity.calculateFallDamage` (`LivingEntity.java:1845-1852`), including the
  2647	    /// `FALL_DAMAGE_MULTIPLIER` attribute that horses, camels and llamas set to 0.5.
  2648	    ///
  2649	    /// Split out so a subclass override (`Goat.calculateFallDamage`,
  2650	    /// `Frog.calculateFallDamage`) can reach the `LivingEntity`-level result without recursing
  2651	    /// back into itself.
  2652	    pub fn default_calculate_fall_damage(&self, fall_distance: f64, damage_modifier: f32) -> i32 {
  2653	        if self.is_immune_to_fall_damage() {
  2654	            return 0;
  2655	        }
  2656	        let fall_power =
  2657	            fall_distance + 1.0E-6 - self.get_attribute_value(&Attributes::SAFE_FALL_DISTANCE);
  2658	        let damage = fall_power
  2659	            * f64::from(damage_modifier)
  2660	            * self.get_attribute_value(&Attributes::FALL_DAMAGE_MULTIPLIER);
  2661	        #[allow(clippy::cast_possible_truncation)]
  2662	        {
  2663	            damage.floor() as i32
  2664	        }
  2665	    }

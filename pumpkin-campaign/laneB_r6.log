   359	    fn on_closed<'a>(&'a mut self, player: &'a dyn InventoryPlayer) -> ScreenHandlerFuture<'a, ()> {
   360	        Box::pin(async move {
   361	            if let Some(on_close) = &self.on_close {
   362	                on_close().await;
   363	            }
   364	            self.default_on_closed(player).await;
   365	            self.inventory.on_close().await;
   366	            // Vanilla drops items from merchant container on close
   367	            for i in 0..2 {
   368	                // Drop inputs only, output is virtual/ghost in some sense or just cleared
   369	                let stack = self.inventory.remove_stack(i).await;
   370	                if !stack.is_empty() {
   371	                    offer_or_drop_stack(player, stack).await;
   372	                }
   373	            }
   374	            // Clear output slot
   375	            self.inventory.set_stack(2, ItemStack::EMPTY.clone()).await;
   376	        })
   377	    }

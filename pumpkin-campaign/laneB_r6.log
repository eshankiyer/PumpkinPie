   178	    /// Determines the appropriate facing direction for a wall-hanging sign.
   179	    fn calculate_wall_hanging_facing(wall_dir: BlockDirection, player_yaw: f32) -> &'static str {
   180	        match wall_dir {
   450	        match clicked_face {
   451	            BlockDirection::Up => {
   452	                !is_hanging && (state.is_center_solid(BlockDirection::Up) || is_permissive)
   453	            }
   454	            BlockDirection::Down => {
   455	                is_hanging && (state.is_side_solid(BlockDirection::Down) || is_permissive)
   456	            }
   457	            _ => state.is_side_solid(clicked_face.opposite()) || is_permissive,
   458	        }
   459	    }

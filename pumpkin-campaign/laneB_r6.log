   309	                    if let Some(trader) = close_weak.upgrade() {
   310	                        *trader
   311	                            .trading_player
   312	                            .lock()
   313	                            .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
   314	                    }
   315	                })
   316	            }));
   317	
   318	            handler.on_trade = Some(Box::new(move |offer_index| {
   319	                let self_weak = self_weak.clone();
   320	                Box::pin(async move {
   321	                    if let Some(trader) = self_weak.upgrade() {
   322	                        let reward_exp = {
   323	                            let mut offers = trader.offers.lock().await;
   324	                            if offer_index >= offers.len() {
   325	                                return;
   326	                            }
   327	                            let offer = &mut offers[offer_index];

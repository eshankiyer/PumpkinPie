   392	                        feature.placeWithBiomeCheck(level, this, random, origin);
   393	                     } catch (Exception e) {
   394	                        CrashReport report = CrashReport.forThrowable(e, "Feature placement");
   395	                        report.addCategory("Feature").setDetail("Description", currentlyGenerating::get);
   396	                        throw new ReportedException(report);
   397	                     }
   398	                  }
   399	               }
   400	            }
   401	
   402	            level.setCurrentlyGenerating(null);
   403	            if (SharedConstants.DEBUG_FEATURE_COUNT) {
   404	               FeatureCountTracker.chunkDecorated(level.getLevel());
   405	            }
   406	         } catch (Exception e) {
   407	            CrashReport report = CrashReport.forThrowable(e, "Biome decoration");
   408	            report.addCategory("Generation")
   409	               .setDetail("CenterX", centerPos.x())
   410	               .setDetail("CenterZ", centerPos.z())
   411	               .setDetail("Decoration Seed", decorationSeed);
   412	            throw new ReportedException(report);
   413	         }
   414	      }
   415	   }

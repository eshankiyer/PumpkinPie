+
+        brain.clear_memories();
+        assert!(!brain.has_value::<LikedPlayerMemory>());
+        assert!(!brain.check_memory(
+            MemoryKeyId::LikedPlayer,
+            super::memory::MemoryStatus::ValuePresent
+        ));
+    }

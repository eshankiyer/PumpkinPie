  3846	            smoker_filtering: wire[7],
  3847	        })
  3848	        .await;
  3849	
  3850	        let registry = crate::data::recipe_book::registry();
  3851	        let entries: Vec<RecipeBookEntry> = {
  3852	            let book = self.recipe_book.lock().await;
  3853	            let mut entries: Vec<RecipeBookEntry> = book
  3854	                .known()
  3855	                .iter()
  3856	                .filter_map(|id| {
  3857	                    registry.by_id(id).map(|entry| {

   159	   private AABB createAabb(final double x, final double y, final double z) {
   160	      boolean xNeg = x < 0.0;
   161	      boolean yNeg = y < 0.0;
   162	      boolean zNeg = z < 0.0;
   163	      double xMin = xNeg ? x : 0.0;
   164	      double yMin = yNeg ? y : 0.0;
   165	      double zMin = zNeg ? z : 0.0;
   166	      double xMax = (xNeg ? 0.0 : x) + 1.0;
   167	      double yMax = (yNeg ? 0.0 : y) + 1.0;
   168	      double zMax = (zNeg ? 0.0 : z) + 1.0;
   169	      return new AABB(xMin, yMin, zMin, xMax, yMax, zMax);
   170	   }

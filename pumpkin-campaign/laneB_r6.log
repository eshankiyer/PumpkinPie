   351	    /// `Brain.getActiveNonCoreActivity` (`Brain.java:287-296`): the one non-core activity
   352	    /// alongside the always-active core set, if any is currently active.
   353	    #[must_use]
   354	    pub fn get_active_non_core_activity(&self) -> Option<Activity> {
   355	        self.runtime
   356	            .lock()
   357	            .unwrap()
   358	            .active_activities
   359	            .iter()
   360	            .find(|activity| !self.core_activities.contains(activity))
   361	            .copied()
   362	    }
   363	
   364	    /// `Brain.setActiveActivity` (`Brain.java:305-312`) plus
   365	    /// `eraseMemoriesForOtherActivitesThan` (`:314-325`). CORE stays active alongside exactly
   366	    /// one non-core activity.
   367	    ///
   368	    /// The two locks are taken in sequence, never nested: the runtime lock is released before
   369	    /// the memory erasures run.
   370	    fn set_active_activity(&self, activity: Activity) {
   371	        let to_erase: Vec<MemoryKeyId> = {
   372	            let mut runtime = self.runtime.lock().unwrap();
   373	            if runtime.active_activities.contains(&activity) {
   374	                return;
   375	            }
   376	            let to_erase = runtime
   377	                .active_activities
   378	                .iter()
   379	                .filter(|old| **old != activity)
   380	                .filter_map(|old| {
   381	                    self.activity_memories_to_erase
   382	                        .iter()
   383	                        .find(|(candidate, _)| candidate == old)
   384	                })
   385	                .flat_map(|(_, ids)| ids.iter().copied())
   386	                .collect();
   387	
   388	            runtime.active_activities.clear();
   389	            runtime
   390	                .active_activities
   391	                .extend_from_slice(&self.core_activities);
   392	            runtime.active_activities.push(activity);
   393	            to_erase
   394	        };
   395	
   396	        if !to_erase.is_empty() {
   397	            let mut store = self.memory.lock().unwrap();
   398	            for id in to_erase {
   399	                store.erase_by_id(id);
   400	            }
   401	        }
   402	    }

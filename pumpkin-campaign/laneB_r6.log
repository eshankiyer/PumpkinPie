    97	/// `Warden.applyDarknessAround` (Warden.java:407-410).
    98	///
    99	/// Also carries the parts of `MobEffectUtil.addEffectToPlayersAround`
   100	/// (MobEffectUtil.java:51-72) that are expressible here: survival/adventure players only,
   101	/// inside `darkness_radius`, and skipped for a player who already holds Darkness with more
   102	/// than `displayEffectLimit - 1` = 199 ticks left. The `isAlliedTo(source)` test is dropped -
   103	/// the only caller is the sculk shrieker, which passes a null source. Vanilla's
   104	/// amplifier comparison is a no-op here because the applied amplifier is 0 and Pumpkin's
   105	/// amplifier field is unsigned.
   106	///
   107	/// Note `new MobEffectInstance(DARKNESS, 260, 0, false, false)` sets `visible` AND `showIcon`
   108	/// to false (the 5-argument constructor forwards `visible` as `showIcon`,
   109	/// MobEffectInstance.java:60-62).
   110	pub async fn apply_darkness_around(
   111	    world: &Arc<World>,
   112	    position: pumpkin_util::math::vector3::Vector3<f64>,
   113	    darkness_radius: f64,
   114	) {
   115	    const DARKNESS_DURATION: i32 = 260;
   116	    const DISPLAY_EFFECT_LIMIT: i32 = 200;
   117	
   118	    for player in world.get_nearby_players(position, darkness_radius) {
   119	        if !matches!(
   120	            player.gamemode.load(),
   121	            GameMode::Survival | GameMode::Adventure
   122	        ) {
   123	            continue;
   124	        }
   125	        if let Some(current) = player
   126	            .living_entity
   127	            .get_effect(&pumpkin_data::effect::StatusEffect::DARKNESS)
   128	            .await
   129	            && current.duration > DISPLAY_EFFECT_LIMIT - 1
   130	        {
   131	            continue;
   132	        }
   133	
   134	        let darkness = pumpkin_data::potion::Effect {
   135	            effect_type: &pumpkin_data::effect::StatusEffect::DARKNESS,
   136	            duration: DARKNESS_DURATION,
   137	            amplifier: 0,
   138	            ambient: false,
   139	            show_particles: false,
   140	            show_icon: false,
   141	            blend: true,
   142	        };
   143	        player.send_effect(darkness.clone()).await;
   144	        player.living_entity.add_effect(darkness).await;
   145	    }
   146	}

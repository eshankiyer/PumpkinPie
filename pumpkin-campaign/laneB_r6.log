   745	pub trait HeightSampler {
   746	    fn estimate_height(&mut self, block_x: i32, block_z: i32) -> i32;
   747	
   748	    fn estimate_ocean_floor_height(&mut self, block_x: i32, block_z: i32) -> i32 {

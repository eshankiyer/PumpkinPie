  1139	        can_be_leashed: bool,
  1140	    ) -> bool {
  1141	        let entity = &self.living_entity.entity;
  1142	
  1143	        // If already leashed to player, right-clicking unleashes the mob
  1144	        let currently_leashed = {
  1145	            let guard = entity.leashed_to.lock().await;
  1146	            guard.is_some()
  1147	        };
  1148	
  1149	        if currently_leashed {
  1150	            entity.unleash().await;
  1151	            let lead_item =
  1152	                pumpkin_data::item_stack::ItemStack::new(1, &pumpkin_data::item::Item::LEAD);
  1153	            entity
  1154	                .world
  1155	                .load()
  1156	                .drop_stack(&entity.block_pos.load(), lead_item)
  1157	                .await;
  1158	            return true;
  1159	        }
  1160	
  1161	        // If holding a lead, leash the mob to the player
  1162	        if can_be_leashed
  1163	            && (item_stack.item.registry_key == "lead"
  1164	                || item_stack.item.registry_key == "minecraft:lead")
  1165	        {
  1166	            let diff = entity.pos.load() - player.get_entity().pos.load();
  1167	            let dist_sq = diff.length_squared();
  1168	            let leash_snap_distance = entity.leash_snap_distance();
  1169	            if dist_sq <= leash_snap_distance * leash_snap_distance {
  1170	                entity.leash_to(player.clone() as Arc<dyn EntityBase>).await;
  1171	                if player.gamemode.load() != pumpkin_util::GameMode::Creative {
  1172	                    item_stack.decrement(1);
  1173	                }
  1174	                return true;
  1175	            }
  1176	        }
  1177	
  1178	        false
  1179	    }

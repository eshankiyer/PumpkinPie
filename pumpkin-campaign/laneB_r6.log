   235	    /// Completes a trade selected through Bedrock's item-stack request protocol.
   236	    ///
   237	    /// Bedrock moves the result directly between named containers instead of
   238	    /// sending Java's slot-click action, so the caller has already validated
   239	    /// that the result can be inserted into its destination.
   240	    pub async fn complete_bedrock_trade(&mut self, player: &dyn InventoryPlayer) -> bool {
   241	        if !self.complete_trade(player).await {
   242	            return false;
   243	        }
   244	        self.update_result_slot().await;
   245	        self.notify_trade_updated().await;
   246	        self.send_content_updates().await;
   247	        true
   248	    }
   249	
   250	    async fn can_fully_insert(&self, stack: &ItemStack, start: usize, end: usize) -> bool {
   251	        let mut remaining = stack.item_count;
   252	        for slot in &self.get_behaviour().slots[start..end] {
   253	            if !slot.can_insert(stack).await {
   254	                continue;
   255	            }
   256	            let existing = slot.get_cloned_stack().await;
   257	            let capacity = if existing.is_empty() {
   258	                slot.get_max_item_count_for_stack(stack).await
   259	            } else if existing.are_items_and_components_equal(stack)
   260	                && stack.are_items_and_components_equal(&existing)
   261	            {
   262	                slot.get_max_item_count_for_stack(&existing)
   263	                    .await
   264	                    .saturating_sub(existing.item_count)
   265	            } else {
   266	                0
   267	            };
   268	            remaining = remaining.saturating_sub(capacity);
   269	            if remaining == 0 {
   270	                return true;
   271	            }
   272	        }
   273	        false
   274	    }

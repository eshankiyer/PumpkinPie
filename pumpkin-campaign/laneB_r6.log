-                    radius: if args.block.id == BlockId::CALIBRATED_SCULK_SENSOR {
-                        CalibratedSculkSensorBlockEntity::LISTENER_RADIUS
-                    } else {
-                        LISTENER_RANGE
-                    },
-                }))
-                .await;
+            ensure_listener_registered(args.world, args.position).await;
         })
     }
 

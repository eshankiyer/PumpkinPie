   191	    /// Modifies the provided [`EntitySelectorParser`].
   192	    ///
   193	    /// Any required fields will be parsed by this method using [`StringReader`]
   194	    /// methods, and any required predicates will be added.
   195	    /// Any found errors will be returned.
   196	    #[allow(clippy::too_many_lines)]
   197	    pub fn modify_parser(
   198	        self,
   199	        parser: &mut EntitySelectorParser,
   200	    ) -> Result<(), CommandSyntaxError> {
   201	        let i = parser.reader.cursor();
   202	        match self {
   203	            Self::Distance => {
   204	                let bounds = DoubleBounds::from_reader(parser.reader)?;
   205	                if bounds.min().is_none_or(|n| n < 0.0) && bounds.max().is_none_or(|n| n < 0.0) {
   206	                    parser.reader.set_cursor(i);
   207	                    Err(DISTANCE_NEGATIVE_ERROR_TYPE.create(parser.reader))
   208	                } else {
   209	                    parser.distance = Some(bounds);
   210	                    parser.set_flag(Flags::WORLD_LIMITED, true);
   211	                    Ok(())
   212	                }
   213	            }
   214	            Self::Level => {
   215	                let bounds = IntBounds::from_reader(parser.reader)?;
   216	                if bounds.min().is_none_or(|n| n < 0) && bounds.max().is_none_or(|n| n < 0) {
   217	                    parser.reader.set_cursor(i);
   218	                    Err(LEVEL_NEGATIVE_ERROR_TYPE.create(parser.reader))
   219	                } else {
   220	                    parser.experience_level = Some(bounds);
   221	                    parser.set_includes_entities(false);
   222	                    Ok(())
   223	                }
   224	            }
   225	            Self::X => coordinate_option_impl!(parser, pos, x),
   226	            Self::Y => coordinate_option_impl!(parser, pos, y),
   227	            Self::Z => coordinate_option_impl!(parser, pos, z),
   228	            Self::Dx => coordinate_option_impl!(parser, delta, x),
   229	            Self::Dy => coordinate_option_impl!(parser, delta, y),
   230	            Self::Dz => coordinate_option_impl!(parser, delta, z),
   231	            Self::XRotation => rotation_option_impl!(parser, x),
   232	            Self::YRotation => rotation_option_impl!(parser, y),
   233	            Self::Limit => {
   234	                let limit = parser.reader.read_int()?;
   235	                if limit < 1 {
   236	                    parser.reader.set_cursor(i);
   237	                    Err(LIMIT_TOO_SMALL_ERROR_TYPE.create(parser.reader))
   238	                } else {
   239	                    parser.max_selected = limit;
   240	                    parser.set_flag(Flags::LIMIT_SET, true);
   241	                    Ok(())
   242	                }
   243	            }
   244	            Self::Sort => {
   245	                let string = parser.reader.read_unquoted_string();
   246	                parser.suggestions = EntitySelectorParserSuggestions::Sort;
   247	                parser.order = match string.as_str() {
   248	                    "nearest" => Ok(Order::Nearest),
   249	                    "furthest" => Ok(Order::Furthest),
   250	                    "random" => Ok(Order::Random),
   251	                    "arbitrary" => Ok(Order::Arbitrary),
   252	                    _ => {
   253	                        parser.reader.set_cursor(i);
   254	                        Err(SORT_UNKNOWN_ERROR_TYPE
   255	                            .create(parser.reader, TextComponent::text(string)))
   256	                    }
   257	                }?;
   258	                parser.set_flag(Flags::SORT_SET, true);
   259	                Ok(())
   260	            }
   261	            Self::Gamemode => {
   262	                parser.suggestions = EntitySelectorParserSuggestions::Gamemode;
   263	                let start = parser.reader.cursor();
   264	                let invert = parser.consume_inverted_start();
   265	                if parser.has_flag(Flags::GAMEMODE_NOT_EQUALS_SET) && !invert {
   266	                    parser.reader.set_cursor(start);
   267	                    return Err(self.inapplicable_error(parser.reader));
   268	                }
   269	                let string = parser.reader.read_unquoted_string();
   270	                if let Ok(gamemode) = GameMode::from_str(&string) {
   271	                    parser.set_includes_entities(false);
   272	                    parser.add_predicate(EntitySelectorPredicate::GameMode(gamemode, invert));
   273	                    parser.set_flag(
   274	                        if invert {
   275	                            Flags::GAMEMODE_NOT_EQUALS_SET
   276	                        } else {
   277	                            Flags::GAMEMODE_EQUALS_SET
   278	                        },
   279	                        true,
   280	                    );
   281	                    Ok(())
   282	                } else {
   283	                    parser.reader.set_cursor(start);
   284	                    Err(GAMEMODE_INVALID_ERROR_TYPE
   285	                        .create(parser.reader, TextComponent::text(string)))
   286	                }
   287	            }
   288	            Self::Type => {
   289	                let start = parser.reader.cursor();
   290	                let invert = parser.consume_inverted_start();
   291	                let is_tag = parser.consume_tag_start();
   292	                if is_tag {
   293	                    if parser.entity_type.is_some() || parser.has_flag(Flags::ENTITY_TYPE_INVERTED)
   294	                    {
   295	                        parser.reader.set_cursor(start);
   296	                        return Err(self.inapplicable_error(parser.reader));
   297	                    }
   298	                } else if parser.entity_type.is_some()
   299	                    || parser.has_flag(Flags::ENTITY_TYPE_TAG_SET)
   300	                    || parser.has_flag(Flags::ENTITY_TYPE_INVERTED)
   301	                {
   302	                    parser.reader.set_cursor(start);
   303	                    return Err(self.inapplicable_error(parser.reader));
   304	                }
   305	                let identifier = Identifier::from_reader(parser.reader)?;
   306	                if is_tag {
   307	                    parser.add_predicate(EntitySelectorPredicate::EntityTypeTag(
   308	                        identifier.to_string(),
   309	                        invert,
   310	                    ));
   311	                    parser.set_flag(Flags::ENTITY_TYPE_TAG_SET, true);
   312	                    Ok(())
   313	                } else if let Some(entity_type) =
   314	                    identifier.is_vanilla_then().and_then(EntityType::from_name)
   315	                {
   316	                    if entity_type.id == EntityType::PLAYER.id && !invert {
   317	                        parser.limit_to_players();
   318	                    }
   319	                    parser.add_predicate(EntitySelectorPredicate::EntityType(entity_type, invert));
   320	                    if invert {
   321	                        parser.set_flag(Flags::ENTITY_TYPE_INVERTED, true);
   322	                    } else {
   323	                        parser.entity_type = Some(entity_type);
   324	                    }
   325	                    Ok(())
   326	                } else {
   327	                    parser.reader.set_cursor(start);
   328	                    Err(TYPE_INVALID_ERROR_TYPE
   329	                        .create(parser.reader, TextComponent::text(identifier.to_string())))
   330	                }
   331	            }
   332	            Self::Name => {
   333	                let start = parser.reader.cursor();

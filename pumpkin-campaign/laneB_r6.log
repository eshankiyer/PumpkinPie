    89	    fn reached_target(mob: &dyn Mob, walk_target: &WalkTarget) -> bool {
    90	        let Some(target) = walk_target.target.current_block_position() else {
    91	            return false;
    92	        };
    93	        let mob_pos = mob.get_mob_entity().living_entity.entity.block_pos.load();
    94	        let distance = (target.0.x - mob_pos.0.x).abs()
    95	            + (target.0.y - mob_pos.0.y).abs()

    91	    async fn try_move_items(&mut self, index: usize) {
    92	        let Some(offer) = self.offers.get(index) else {
    93	            return;
    94	        };
    95	        let cost_a = offer.base_cost_a.0.as_ref().clone();
    96	        let cost_b = offer.cost_b.as_ref().map(|cost| cost.0.as_ref().clone());
    97	        let player_slots_end = self.get_behaviour().slots.len() as i32;
    98	
    99	        for index in 0..2 {
   100	            let mut stack = self.inventory.get_stack(index).await;
   101	            if !stack.is_empty()
   102	                && !self
   103	                    .insert_item(&mut stack, 3, player_slots_end, true)
   104	                    .await
   105	            {
   106	                return;
   107	            }
   108	            self.inventory.set_stack(index, stack).await;
   109	        }
   110	
   111	        if !self.inventory.get_stack(0).await.is_empty()
   112	            || !self.inventory.get_stack(1).await.is_empty()
   113	        {
   114	            return;
   115	        }
   116	
   117	        self.move_from_inventory_to_payment_slot(0, &cost_a).await;
   118	        if let Some(cost_b) = cost_b {
   119	            self.move_from_inventory_to_payment_slot(1, &cost_b).await;
   120	        }
   121	    }

   753	/// Port of `Structure.getLowestY(GenerationContext, int sizeX, int sizeZ)` and its
   754	/// four-argument overload
   755	/// (`net/minecraft/world/level/levelgen/structure/Structure.java:171-182`).
   756	///
   757	/// Returns the minimum of the `WORLD_SURFACE_WG` first-occupied heights sampled by
   758	/// `Structure.getCornerHeights`
   759	/// (`net/minecraft/world/level/levelgen/structure/Structure.java:154-167`) at the four corners
   760	/// `(minX, minZ)`, `(minX, minZ + sizeZ)`, `(minX + sizeX, minZ)` and
   761	/// `(minX + sizeX, minZ + sizeZ)` of a `size_x` × `size_z` box.
   762	#[must_use]
   763	pub fn get_lowest_y(
   764	    sampler: &mut dyn HeightSampler,
   765	    min_x: i32,
   766	    min_z: i32,
   767	    size_x: i32,
   768	    size_z: i32,
   769	) -> i32 {
   770	    let corner_a = sampler.estimate_height(min_x, min_z);
   771	    let corner_b = sampler.estimate_height(min_x, min_z + size_z);
   772	    let corner_c = sampler.estimate_height(min_x + size_x, min_z);
   773	    let corner_d = sampler.estimate_height(min_x + size_x, min_z + size_z);
   774	    corner_a.min(corner_b).min(corner_c).min(corner_d)
   775	}

   480	    /// `Brain.isBrainDead` (`Brain.java:454-455`).
   481	    #[must_use]
   482	    pub fn is_brain_dead(&self) -> bool {
   483	        let memory_empty = self.memory.lock().unwrap().is_empty();
   484	        let runtime = self.runtime.lock().unwrap();
   485	        memory_empty && runtime.sensors.is_empty() && runtime.behaviors_by_priority.is_empty()
   486	    }

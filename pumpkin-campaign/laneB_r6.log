    30	    fn can_mine(&self, player: &Player) -> bool {
    31	        player.gamemode.load() != GameMode::Creative
    32	    }
    33	
    34	    // Vanilla DyeItem.java#interactLivingEntity: only sheep, only alive, only unsheared,
    35	    // no-op (no consume) if already the target color.
    36	    fn use_on_entity<'a>(
    37	        &'a self,
    38	        item: &'a mut ItemStack,
    39	        player: &'a Player,
    40	        entity: Arc<dyn EntityBase>,
    41	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    42	        Box::pin(async move {
    43	            let Some(sheep) = entity.cast_any().downcast_ref::<SheepEntity>() else {
    44	                return;
    45	            };
    46	            // DyeItem.java:21 requires `sheep.isAlive()`, which is LivingEntity.isAlive:
    47	            // not removed AND health above zero. A dying sheep is not dyeable.
    48	            if entity.get_entity().is_removed()
    49	                || sheep.mob_entity.living_entity.health.load() <= 0.0
    50	                || sheep.is_sheared()
    51	            {
    52	                return;
    53	            }
    54	            let Some(color_name) = item.item.registry_key.strip_suffix("_dye") else {
    55	                return;
    56	            };
    57	            let new_color = DyeColor::from(color_name) as u8;
    58	            if new_color == sheep.get_color() {
    59	                return;
    60	            }
    61	
    62	            let world = entity.get_entity().world.load();
    63	            world.play_sound(
    64	                Sound::ItemDyeUse,
    65	                SoundCategory::Players,
    66	                &entity.get_entity().pos.load(),
    67	            );
    68	            sheep.set_color(new_color);
    69	            item.decrement_unless_creative(player.gamemode.load(), 1);
    70	        })
    71	    }

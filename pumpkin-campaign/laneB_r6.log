    93	impl HoneyCombItem {
    94	    pub(crate) fn apply_to_sign(
    95	        args: &UseWithItemArgs<'_>,
    96	        block_entity: &Arc<dyn BlockEntity>,
    97	        sign_entity: &dyn SignTextAccess,
    98	    ) -> BlockActionResult {
    99	        // Vanilla `HoneycombItem#tryApplyToSign` returns the result of `SignBlockEntity#setWaxed`,
   100	        // which is false when the sign is already waxed, so the honeycomb is not consumed.
   101	        if !sign_entity.set_waxed() {
   102	            return BlockActionResult::PassToDefaultBlockAction;

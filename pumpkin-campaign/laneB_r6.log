   440	    /// `Brain.addActivity` (`Brain.java:350-373`). This supports construction-time extension of
   441	    /// the existing priority/activity tables without introducing another behavior subsystem.
   442	    pub fn add_activity(
   443	        &mut self,
   444	        activity: Activity,
   445	        behavior_priority_pairs: Vec<(u32, Box<dyn Behavior>)>,
   446	        conditions: Vec<(MemoryKeyId, MemoryStatus)>,
   447	        memories_to_erase_when_stopped: Vec<MemoryKeyId>,
   448	    ) {
   449	        {
   450	            let mut memory = self.memory.lock().unwrap();
   451	            for (id, _) in &conditions {
   452	                memory.register(*id);
   453	            }
   454	            for (_, behavior) in &behavior_priority_pairs {
   455	                for (id, _) in behavior.required_memories() {
   456	                    memory.register(*id);
   457	                }
   458	            }
   459	        }
   460	        self.activity_requirements.push((activity, conditions));
   461	        if !memories_to_erase_when_stopped.is_empty() {
   462	            self.activity_memories_to_erase
   463	                .push((activity, memories_to_erase_when_stopped));
   464	        }
   465	        let mut runtime = self.runtime.lock().unwrap();
   466	        for (priority, behavior) in behavior_priority_pairs {
   467	            runtime
   468	                .behaviors_by_priority
   469	                .entry(priority)
   470	                .or_default()
   471	                .push((activity, behavior));
   472	        }
   473	    }

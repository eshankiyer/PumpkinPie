   122	   public EntitySelector getSelector() {
   123	      AABB aabb;
   124	      if (this.deltaX == null && this.deltaY == null && this.deltaZ == null) {
   125	         if (this.distance != null && this.distance.max().isPresent()) {
   126	            double maxRange = (Double)this.distance.max().get();
   127	            aabb = new AABB(-maxRange, -maxRange, -maxRange, maxRange + 1.0, maxRange + 1.0, maxRange + 1.0);
   128	         } else {
   129	            aabb = null;
   130	         }
   131	      } else {
   132	         aabb = this.createAabb(this.deltaX == null ? 0.0 : this.deltaX, this.deltaY == null ? 0.0 : this.deltaY, this.deltaZ == null ? 0.0 : this.deltaZ);
   133	      }
   134	
   135	      Function<Vec3, Vec3> position;
   136	      if (this.x == null && this.y == null && this.z == null) {
   137	         position = o -> o;
   138	      } else {
   139	         position = o -> new Vec3(this.x == null ? o.x : this.x, this.y == null ? o.y : this.y, this.z == null ? o.z : this.z);
   140	      }
   141	
   142	      return new EntitySelector(
   143	         this.maxResults,
   144	         this.includesEntities,
   145	         this.worldLimited,
   146	         List.copyOf(this.predicates),
   147	         this.distance,
   148	         position,
   149	         aabb,
   150	         this.order,
   151	         this.currentEntity,
   152	         this.playerName,
   153	         this.entityUUID,
   154	         this.type,
   155	         this.usesSelectors

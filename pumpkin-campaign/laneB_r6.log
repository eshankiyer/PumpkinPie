+    /// TestInstanceBlockEntity.java:107-127 (`test`, `getTestName`, `ignoreEntities`, `getSize`,
+    /// `getRotation`): expose the server-side test configuration held by this block entity.
+    pub async fn test(&self) -> Option<String> {

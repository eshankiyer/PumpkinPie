   260	      float priceMultiplier = input.readFloat();
   261	      int demand = input.readInt();
   262	      MerchantOffer offer = new MerchantOffer(buy, buyB, sell, uses, maxUses, xp, priceMultiplier, demand);
   263	      if (isExhausted) {
   264	         offer.setToOutOfStock();
   265	      }
   266	
   267	      offer.setSpecialPriceDiff(specialPriceDiff);
   268	      return offer;
   269	   }

   467	    fn get_state_for_neighbor_update<'a>(
   468	        &'a self,
   469	        args: GetStateForNeighborUpdateArgs<'a>,
   470	    ) -> BlockFuture<'a, BlockStateId> {
   471	        let is_hanging = args.block.name.contains("hanging");
   472	        let is_wall_sign = args.block.name.contains("wall");
   473	
   474	        // Determine the expected support direction

   153	impl DerefMut for RuntimeTakeGuard<'_> {
   154	    fn deref_mut(&mut self) -> &mut Self::Target {
   155	        self.runtime.as_mut().unwrap()
   156	    }
   157	}
   158	
   159	impl Drop for RuntimeTakeGuard<'_> {
   160	    fn drop(&mut self) {
   161	        if let Some(runtime) = self.runtime.take() {
   162	            *self.mutex.lock().unwrap() = runtime;
   163	        }
   164	    }
   165	}

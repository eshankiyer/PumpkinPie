   352	                    // (`MerchantMenu.java:142-147`, `WanderingTrader.java:191-193`).
   353	                    trader
   354	                        .get_entity()
   355	                        .play_sound(pumpkin_data::sound::Sound::EntityWanderingTraderYes);
   356	                }
   357	            }));
   358	
   359	            Some(Arc::new(Mutex::new(handler)) as SharedScreenHandler)
   360	        })

   283	    /// Signed distance from `(x, z)` to the nearest border edge; negative when outside.
   284	    #[must_use]
   285	    pub fn distance_to_border(&self, x: f64, z: f64) -> f64 {
   286	        let (min_x, max_x, min_z, max_z) = self.bounds();
   287	
   288	        let from_west = x - min_x;
   289	        let from_east = max_x - x;
   290	        let from_north = z - min_z;
   291	        let from_south = max_z - z;
   292	
   293	        from_west.min(from_east).min(from_north).min(from_south)
   294	    }

  3748	    /// `ServerPlayer.resetRecipes` (`ServerPlayer.java:1541-1544`), delegating to
  3749	    /// `ServerRecipeBook.removeRecipes` (`ServerRecipeBook.java:82-97`), which sends
  3750	    /// a `ClientboundRecipeBookRemovePacket` naming the display ids it dropped.
  3751	    ///
  3752	    /// This is what backs `/recipe take`, which calls straight into it.
  3753	    pub async fn reset_recipes<'a>(&self, ids: impl IntoIterator<Item = &'a str>) -> usize {
  3754	        let removed = self.recipe_book.lock().await.remove_recipes(ids);
  3755	        if removed.is_empty() {
  3756	            return 0;
  3757	        }
  3758	        let registry = crate::data::recipe_book::registry();
  3759	        let display_ids: Vec<i32> = removed
  3760	            .iter()
  3761	            .filter_map(|id| registry.by_id(id))
  3762	            .map(|entry| entry.display_id)
  3763	            .collect();
  3764	        if !display_ids.is_empty() {
  3765	            self.send_client_packet(&CRecipeBookRemove::new(&display_ids))
  3766	                .await;
  3767	        }
  3768	        removed.len()
  3769	    }

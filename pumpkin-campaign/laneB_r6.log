   146	    pub fn set_diameter(&mut self, world: &World, diameter: f64, speed: Option<i64>) {
   147	        // Vanilla `WorldBorderCommand.setSize` lerps from `border.getSize()`, the
   148	        // current interpolated size, not from the previous lerp target.
   149	        self.old_diameter = self.current_diameter;
   150	        self.new_diameter = diameter;
   151	
   152	        // A zero (or negative) tick duration has nothing to interpolate over --
   153	        // vanilla's own `calculateSize` degenerates to `to` immediately in that case
   154	        // (`(duration - progress) / duration` is NaN, which fails the `< 1.0` check).
   155	        if let Some(ticks) = speed.filter(|ticks| *ticks > 0) {
   156	            self.lerp_ticks_total = ticks;
   157	            self.lerp_ticks_remaining = ticks;
   158	            self.current_diameter = self.old_diameter;
   159	            world.broadcast_packet_all(&CSetBorderLerpSize::new(
   160	                self.old_diameter,
   161	                self.new_diameter,
   162	                ticks.into(),
   163	            ));
   164	        } else {
   165	            self.lerp_ticks_total = 0;
   166	            self.lerp_ticks_remaining = 0;
   167	            self.current_diameter = self.new_diameter;
   168	            if speed.is_some() {
   169	                world.broadcast_packet_all(&CSetBorderLerpSize::new(
   170	                    self.old_diameter,
   171	                    self.new_diameter,
   172	                    0i64.into(),
   173	                ));
   174	            } else {
   175	                world.broadcast_packet_all(&CSetBorderSize::new(self.new_diameter));
   176	            }
   177	        }
   178	    }

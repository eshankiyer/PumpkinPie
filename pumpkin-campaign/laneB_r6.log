   130	struct RuntimeTakeGuard<'a> {
   131	    mutex: &'a Mutex<BrainRuntime>,
   132	    runtime: Option<BrainRuntime>,
   133	}
   134	
   135	impl RuntimeTakeGuard<'_> {
   136	    fn new(mutex: &Mutex<BrainRuntime>) -> RuntimeTakeGuard<'_> {
   137	        let runtime = std::mem::take(&mut *mutex.lock().unwrap());
   138	        RuntimeTakeGuard {
   139	            mutex,
   140	            runtime: Some(runtime),
   141	        }
   142	    }
   143	}
   144	
   145	impl Deref for RuntimeTakeGuard<'_> {
   146	    type Target = BrainRuntime;
   147	
   148	    fn deref(&self) -> &Self::Target {
   149	        self.runtime.as_ref().unwrap()
   150	    }
   151	}

   332	                        // `WanderingTrader::rewardTradeXp` (WanderingTrader.java:158-163): unlike
   333	                        // `Villager`, no persisted XP counter or profession leveling, just a flat
   334	                        // orb, and only when `MerchantOffer::shouldRewardExp`.
   335	                        if reward_exp {
   336	                            let entity = trader.get_entity();
   337	                            crate::entity::experience_orb::ExperienceOrbEntity::spawn(
   338	                                &entity.world.load(),
   339	                                entity.pos.load(),
   340	                                3 + rand::random_range(0..4u32),
   341	                            )
   342	                            .await;
   343	                        }
   344	                    }
   345	                })
   346	            }));
   347	
   348	            let sound_weak = self.self_weak.lock().unwrap().clone().unwrap();
   349	            handler.on_quick_move_trade = Some(Box::new(move || {
   350	                if let Some(trader) = sound_weak.upgrade() {

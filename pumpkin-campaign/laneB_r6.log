   394	/// `Mth.clamp`: the lower bound wins when the range is inverted, unlike
   395	/// `f64::clamp`, which panics.
   396	fn clamp(value: f64, min: f64, max: f64) -> f64 {
   397	    if value < min {
   398	        min
   399	    } else if value > max {
   400	        max
   401	    } else {
   402	        value
   403	    }
   404	}

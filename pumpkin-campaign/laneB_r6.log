+    /// derive the structure box from the transformed size; test padding is unavailable without
+    /// the game-test registry, so the server-side box is the structure box.
+    pub async fn get_structure_pos(&self) -> BlockPos {
+        self.position.offset(Vector3::new(0, 1, 1))
+    }
+
+    pub async fn get_start_corner(&self) -> BlockPos {
+        let size = self.get_size().await;
+        let rotation = self.get_rotation().await;
+        let structure_pos = self.get_structure_pos().await;
+        match rotation {
+            Rotation::None => structure_pos,
+            Rotation::Clockwise90 => structure_pos.offset(Vector3::new(size.z - 1, 0, 0)),
+            Rotation::Rotate180 => {
+                structure_pos.offset(Vector3::new(size.x - 1, 0, size.z - 1))
+            }
+            Rotation::CounterClockwise90 => {
+                structure_pos.offset(Vector3::new(0, 0, size.x - 1))
+            }
+        }
+    }
+
+    pub async fn get_structure_bounding_box(&self) -> BoundingBox {
+        let pos = self.get_structure_pos().await;
+        let size = self.get_transformed_size().await;
+        let max = pos.offset(Vector3::new(size.x - 1, size.y - 1, size.z - 1));
+        BoundingBox {
+            min: Vector3::new(pos.0.x as f64, pos.0.y as f64, pos.0.z as f64),
+            max: Vector3::new(
+                max.0.x as f64 + 1.0,
+                max.0.y as f64 + 1.0,
+                max.0.z as f64 + 1.0,
+            ),
+        }
+    }
+
+    pub async fn get_test_bounding_box(&self) -> BoundingBox {
+        self.get_structure_bounding_box().await
+    }
+
+    pub async fn get_structure_bounds(&self) -> BoundingBox {
+        self.get_structure_bounding_box().await
+    }
+
+    pub async fn get_test_bounds(&self) -> BoundingBox {
+        self.get_test_bounding_box().await
+    }
+
+    async fn get_transformed_size(&self) -> Vector3<i32> {
+        let size = self.get_size().await;
+        match self.get_rotation().await {
+            Rotation::Clockwise90 | Rotation::CounterClockwise90 => {
+                Vector3::new(size.z, size.y, size.x)
+            }
+            Rotation::None | Rotation::Rotate180 => size,
+        }
+    }
+
+    /// TestInstanceBlockEntity.java:127-140 and 399-412 (`errorMessage`, status setters,
+    /// `markError`, `clearErrorMarkers`): preserve test status and error markers locally.
+    pub async fn error_message(&self) -> Option<String> {
+        self.data.lock().await.error_message.clone()
+    }
+
+    pub async fn set_error_message(&self, error_message: String) {
+        let mut data = self.data.lock().await;
+        data.error_message = Some(error_message);
+        data.status = TestInstanceStatus::Finished;
+    }
+
+    pub async fn set_success(&self) {
+        let mut data = self.data.lock().await;
+        data.status = TestInstanceStatus::Finished;
+        data.error_message = None;
+    }
+
+    pub async fn set_running(&self) {
+        let mut data = self.data.lock().await;
+        data.status = TestInstanceStatus::Running;
+        data.error_message = None;
+    }
+
+    pub async fn mark_error(&self, position: BlockPos, text: String) {
+        self.error_markers
+            .lock()
+            .await
+            .push(ErrorMarker { position, text });
+    }
+
+    pub async fn clear_error_markers(&self) {
+        self.error_markers.lock().await.clear();
+    }
+
+    pub async fn get_error_markers(&self) -> Vec<ErrorMarker> {
+        self.error_markers.lock().await.clone()
+    }
+}
+
+const fn rotation_name(rotation: Rotation) -> &'static str {
+    match rotation {
+        Rotation::None => "NONE",
+        Rotation::Clockwise90 => "CLOCKWISE_90",
+        Rotation::Rotate180 => "CLOCKWISE_180",
+        Rotation::CounterClockwise90 => "COUNTERCLOCKWISE_90",
+    }
+}
+
+const fn rotation_from_name(name: &str) -> Rotation {
+    match name {
+        "CLOCKWISE_90" => Rotation::Clockwise90,
+        "CLOCKWISE_180" => Rotation::Rotate180,
+        "COUNTERCLOCKWISE_90" => Rotation::CounterClockwise90,
+        _ => Rotation::None,
+    }
+}
+
+const fn status_name(status: TestInstanceStatus) -> &'static str {
+    match status {
+        TestInstanceStatus::Cleared => "cleared",
+        TestInstanceStatus::Running => "running",
+        TestInstanceStatus::Finished => "finished",
+    }
+}
+
+const fn status_from_name(name: &str) -> TestInstanceStatus {
+    match name {
+        "running" => TestInstanceStatus::Running,
+        "finished" => TestInstanceStatus::Finished,
+        _ => TestInstanceStatus::Cleared,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rotation_names_round_trip() {
+        for rotation in Rotation::values() {
+            assert_eq!(rotation_from_name(rotation_name(rotation)), rotation);
+        }
+    }
+
+    #[test]
+    fn status_names_match_vanilla_status_ids() {
+        assert_eq!(status_from_name("cleared"), TestInstanceStatus::Cleared);
+        assert_eq!(status_from_name("running"), TestInstanceStatus::Running);
+        assert_eq!(status_from_name("finished"), TestInstanceStatus::Finished);
     }
 }

  1425	                Operation::AddValue => ModifierOperation::Add,
  1426	                Operation::AddMultipliedBase => ModifierOperation::MultiplyBase,
  1427	                Operation::AddMultipliedTotal => ModifierOperation::MultiplyTotal,
  1428	            };

   321	    /// Vanilla `WorldBorder.isInsideCloseToBorder` (`WorldBorder.java:114-117`).
   322	    ///
   323	    /// Checks if an entity's bounding box is close enough to the border to take damage.
   324	    /// The threshold is `max(|boundingBox.xSize|, |boundingBox.zSize|, 1.0) * 2.0`.
   325	    #[must_use]
   326	    pub fn is_inside_close_to_border(
   327	        &self,
   328	        x: f64,
   329	        z: f64,
   330	        bbox_xsize: f64,
   331	        bbox_zsize: f64,
   332	    ) -> bool {
   333	        let distance = self.distance_to_border(x, z);
   334	        let bb_max = bbox_xsize.abs().max(bbox_zsize.abs()).max(1.0);
   335	        distance < bb_max * 2.0 && self.contains_with_margin(x, z, bb_max)
   336	    }
   337	
   338	    /// Returns finite bounding-box pieces for the outside-of-border collision shape.
   339	    ///
   340	    /// Vanilla `WorldBorder.getCollisionShape` (`WorldBorder.java:100-101`) delegates
   341	    /// to the extent's shape. Both extents construct it as `INFINITY` minus the box
   342	    /// from `floor(min)` to `ceil(max)` (`WorldBorder.java:440-452` and
   343	    /// `WorldBorder.java:553-564`), which is the four outside walls returned here.
   344	    /// The query bounds keep those infinite walls finite for Pumpkin's AABB
   345	    /// collision solver without changing their relevant collision planes.
   346	    #[must_use]
   347	    pub fn collision_boxes(&self, query: BoundingBox) -> Vec<BoundingBox> {
   348	        let (min_x, max_x, min_z, max_z) = self.bounds();
   349	        let min_x = min_x.floor();
   350	        let max_x = max_x.ceil();
   351	        let min_z = min_z.floor();
   352	        let max_z = max_z.ceil();
   353	
   354	        [
   355	            BoundingBox::new(
   356	                Vector3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
   357	                Vector3::new(min_x, f64::INFINITY, f64::INFINITY),
   358	            ),
   359	            BoundingBox::new(
   360	                Vector3::new(max_x, f64::NEG_INFINITY, f64::NEG_INFINITY),
   361	                Vector3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
   362	            ),
   363	            BoundingBox::new(
   364	                Vector3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
   365	                Vector3::new(f64::INFINITY, f64::INFINITY, min_z),
   366	            ),
   367	            BoundingBox::new(
   368	                Vector3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, max_z),
   369	                Vector3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
   370	            ),
   371	        ]
   372	        .into_iter()
   373	        .filter(|wall| wall.intersects(&query))
   374	        .collect()
   375	    }

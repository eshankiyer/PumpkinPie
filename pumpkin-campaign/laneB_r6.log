  2081	            let new_horizontal_speed = self
  2082	                .entity
  2083	                .velocity
  2084	                .load()
  2085	                .x
  2086	                .hypot(self.entity.velocity.load().z);
  2087	            if let Some(damage) =
  2088	                fall_flying_collision_damage(horizontal_speed, new_horizontal_speed)
  2089	            {

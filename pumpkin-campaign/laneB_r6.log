   148	impl SculkSensorBlock {
   149	    /// Vanilla `SculkSensorBlock.tryResonateVibration` (`SculkSensorBlock.java:233-243`):
   150	    /// every adjacent `minecraft:vibration_resonators` block (amethyst) re-emits the
   151	    /// `RESONATE_<frequency>` game event and plays the resonating sound at the frequency's
   152	    /// pitch bend (`RESONANCE_PITCH_BEND`, `SculkSensorBlock.java:53-59`, pitch via
   153	    /// `NoteBlock.getPitchFromNote`, `NoteBlock.java:143-145`).
   154	    pub async fn try_resonate_vibration(world: &Arc<World>, pos: &BlockPos, frequency: i32) {
   155	        for direction in BlockDirection::all() {
   156	            let relative_pos = pos.offset(direction.to_offset());
   157	            let neighbor_state = world.get_block_state(&relative_pos);
   158	            let neighbor_block = Block::from_state_id(neighbor_state.id);
   159	            if !neighbor_block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_VIBRATION_RESONATORS) {
   160	                continue;
   161	            }
   162	            crate::world::game_event::emit_game_event(
   163	                world,
   164	                resonance_event_by_frequency(frequency),
   165	                relative_pos.to_centered_f64(),
   166	                GameEventContext::none(),
   167	            )
   168	            .await;
   169	            world.play_sound_fine(
   170	                Sound::BlockAmethystBlockResonate,
   171	                SoundCategory::Blocks,
   172	                &relative_pos.to_centered_f64(),
   173	                1.0,
   174	                resonance_pitch_bend(frequency),
   175	            );
   176	        }
   177	    }

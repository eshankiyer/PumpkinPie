  2060	    /// Vanilla `LivingEntity.travelFallFlying`: update velocity from the look vector before
  2061	    /// moving through the normal collision solver.
  2062	    async fn travel_fall_flying<'a>(&'a self, caller: &'a Arc<dyn EntityBase>) {

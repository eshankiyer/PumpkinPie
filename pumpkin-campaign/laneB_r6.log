  3708	    /// `ServerPlayer.awardRecipes` (`ServerPlayer.java:1524-1526`), delegating to
  3709	    /// `ServerRecipeBook.addRecipes` (`ServerRecipeBook.java:61-80`).
  3710	    ///
  3711	    /// Returns the number of recipes newly unlocked.
  3712	    ///
  3713	    /// Vanilla also sends a `ClientboundRecipeBookAddPacket` naming exactly the new
  3714	    /// recipes, with `replace = false` and each entry flagged notification+highlight
  3715	    /// (`ServerRecipeBook.java:70-77`); [`CRecipeBookAddSubset`] carries that.
  3716	    ///
  3717	    /// Ids the static recipe registry does not know - a datapack recipe, say - are
  3718	    /// still unlocked server-side, they just have no display id to name on the wire.
  3719	    pub async fn award_recipes<'a>(&self, ids: impl IntoIterator<Item = &'a str>) -> usize {
  3720	        let added = self.recipe_book.lock().await.add_recipes(ids);
  3721	        if added.is_empty() {
  3722	            return 0;
  3723	        }
  3724	        let registry = crate::data::recipe_book::registry();
  3725	        let entries: Vec<RecipeBookEntry> = added
  3726	            .iter()
  3727	            .filter_map(|id| registry.by_id(id))
  3728	            .map(|entry| RecipeBookEntry::unlocked(entry.display_id))
  3729	            .collect();
  3730	        if !entries.is_empty() {
  3731	            self.send_client_packet(&CRecipeBookAddSubset::new(false, &entries))
  3732	                .await;
  3733	        }
  3734	        added.len()

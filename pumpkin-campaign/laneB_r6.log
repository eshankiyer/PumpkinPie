   116	impl GeneratorManager {
   117	    /// Registers a custom chunk generator and returns its unique generator ID.
   118	    ///
   119	    /// You can then set this generator on a world using `world.set_chunk_generator(id)`.
   120	    pub fn register<G: ChunkGenerator>(generator: G) -> u32 {
   121	        let mut id_lock = NEXT_GENERATOR_ID.lock().unwrap_or_else(|e| e.into_inner());
   122	        let id = *id_lock;
   123	        *id_lock += 1;
   124	
   125	        let mut handlers = GENERATOR_HANDLERS.lock().unwrap_or_else(|e| e.into_inner());
   126	        handlers.insert(id, Box::new(generator));
   127	        id
   128	    }

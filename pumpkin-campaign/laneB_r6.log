   326	    ///
   327	    /// The two locks are taken in sequence, never nested: the runtime lock is released before
   328	    /// the memory erasures run.
   329	    fn set_active_activity(&self, activity: Activity) {
   330	        let to_erase: Vec<MemoryKeyId> = {
   331	            let mut runtime = self.runtime.lock().unwrap();
   332	            if runtime.active_activities.contains(&activity) {
   333	                return;
   334	            }
   335	            let to_erase = runtime
   336	                .active_activities
   337	                .iter()
   338	                .filter(|old| **old != activity)
   339	                .filter_map(|old| {
   340	                    self.activity_memories_to_erase
   341	                        .iter()
   342	                        .find(|(candidate, _)| candidate == old)
   343	                })
   344	                .flat_map(|(_, ids)| ids.iter().copied())
   345	                .collect();

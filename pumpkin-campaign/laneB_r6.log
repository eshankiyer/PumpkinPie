   163	    }
   164	
   165	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   166	        self.mark_restored_from_nbt();
   167	        self.mob_entity.living_entity.read_nbt_non_mut(nbt)
   168	    }

  4112	    /// `Entity.dropAllLeashConnections` (`Entity.java:2343-2361`): break every leash
  4113	    /// held by this entity in the vanilla 32-block search volume and drop one lead per
  4114	    /// released target. The firework launch path is the current server caller.
  4115	    ///
  4116	    /// Vanilla's `Leashable.leashableInArea` (`Leashable.java:356-358`) centers a 32x32x32
  4117	    /// cube on the entity's bounding-box center, i.e. +-16 on every axis; `pos` here is the
  4118	    /// entity's base position rather than its box center, so this is off by roughly half the
  4119	    /// entity's height on the vertical axis -- a documented, narrow simplification, still far
  4120	    /// closer to vanilla than an asymmetric box that only searches upward.
  4121	    pub async fn drop_all_leash_connections(&self) -> bool {
  4122	        let world = self.world.load();
  4123	        let pos = self.pos.load();
  4124	        let search_box = BoundingBox {
  4125	            min: Vector3::new(pos.x - 16.0, pos.y - 16.0, pos.z - 16.0),
  4126	            max: Vector3::new(pos.x + 16.0, pos.y + 16.0, pos.z + 16.0),
  4127	        };
  4128	        let mut attached = Vec::new();
  4129	
  4130	        for entity_base in world.get_entities_at_box(&search_box) {
  4131	            let entity = entity_base.get_entity();
  4132	            let is_attached = entity
  4133	                .leashed_to
  4134	                .lock()
  4135	                .await
  4136	                .as_ref()
  4137	                .is_some_and(|holder| holder.get_entity().entity_id == self.entity_id);
  4138	            if is_attached {
  4139	                attached.push(entity_base);
  4140	            }
  4141	        }
  4142	
  4143	        if attached.is_empty() {
  4144	            return false;
  4145	        }
  4146	
  4147	        for entity_base in attached {
  4148	            let entity = entity_base.get_entity();
  4149	            entity.unleash().await;
  4150	            let lead_item = ItemStack::new(1, &pumpkin_data::item::Item::LEAD);
  4151	            world.drop_stack(&entity.block_pos.load(), lead_item).await;
  4152	        }
  4153	
  4154	        crate::world::game_event::emit_game_event(
  4155	            &world,
  4156	            pumpkin_data::game_event::GameEvent::Shear,
  4157	            pos,
  4158	            crate::world::game_event::GameEventContext::none(),
  4159	        )
  4160	        .await;
  4161	
  4162	        true
  4163	    }

   369	                        }
   370	                        break;
   371	                    }
   372	                    self.reader.skip();
   373	                    self.suggestions = EntitySelectorParserSuggestions::OptionsKey;
   374	                }
   375	            } else {
   376	                self.reader.set_cursor(i);
   377	                return Err(
   378	                    UNKNOWN_OPTION_ERROR_TYPE.create(self.reader, TextComponent::text(string))
   379	                );
   380	            }
   381	        }
   382	        if self.reader.can_read_char() {
   383	            self.reader.skip();
   384	            self.suggestions = EntitySelectorParserSuggestions::Nothing;
   385	            Ok(())
   386	        } else {

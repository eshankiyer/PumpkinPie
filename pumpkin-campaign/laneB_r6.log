+        sign.update_text(true, [
+            "front 1".into(),
+            "front 2".into(),
+            "front 3".into(),
+            "front 4".into(),
+        ]);
+
+        let front = sign
+            .front_text
+            .messages
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        assert_eq!(&*front[0], "front 1");
+        drop(front);
+        let back = sign
+            .back_text
+            .messages
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        assert!(back.iter().all(|line| line.is_empty()));
+    }

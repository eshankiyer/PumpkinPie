   104	    /// this takes the navigator lock. Never invert that order.
   105	    fn push_to_navigator(&self, mob: &dyn Mob) {
   106	        let Some(destination) = self.last_target_position else {
   107	            return;
   108	        };
   109	        let mob_entity = mob.get_mob_entity();
   110	        let current = mob_entity.living_entity.entity.pos.load();
   111	        let mut navigator = mob_entity.navigator.lock().unwrap();
   112	        navigator.set_progress(NavigatorGoal::new(
   113	            current,
   114	            destination,
   115	            f64::from(self.speed_modifier),
   116	        ));
   117	    }
   118	}

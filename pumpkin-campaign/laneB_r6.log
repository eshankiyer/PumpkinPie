+                .push((activity, memories_to_erase_when_stopped));
+        }
+        let mut runtime = self.runtime.lock().unwrap();
+        for (priority, behavior) in behavior_priority_pairs {
+            runtime
+                .behaviors_by_priority
+                .entry(priority)
+                .or_default()
+                .push((activity, behavior));
+        }
+    }

   184	    /// Per-tick lerp update, mirroring vanilla `WorldBorder.MovingBorderExtent::update`.
   185	    /// A no-op once the lerp has completed (`lerp_ticks_remaining == 0`).
   186	    pub fn tick(&mut self, _world: &World) {
   187	        if self.lerp_ticks_remaining > 0 {
   188	            self.lerp_ticks_remaining -= 1;
   189	            self.current_diameter = if self.lerp_ticks_remaining > 0 {
   190	                let progress = (self.lerp_ticks_total - self.lerp_ticks_remaining) as f64
   191	                    / self.lerp_ticks_total as f64;
   192	                self.old_diameter + (self.new_diameter - self.old_diameter) * progress
   193	            } else {
   194	                self.new_diameter
   195	            };
   196	        }
   197	    }

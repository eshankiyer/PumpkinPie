   142	impl SignBlock {
   143	    /// Checks if a block can provide support for a sign.
   144	    fn is_valid_support(world: &World, pos: &BlockPos, direction: BlockDirection) -> bool {
   145	        let (block, state) = world.get_block_and_state(pos);
   146	        let is_permissive = block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_LEAVES)
   147	            || block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_SIGNS);
   148	
   149	        match direction {
   150	            BlockDirection::Up => state.is_side_solid(BlockDirection::Down) || is_permissive,
   151	            BlockDirection::Down => state.is_center_solid(BlockDirection::Up) || is_permissive,
   152	            _ => state.is_side_solid(direction.opposite()) || is_permissive,
   153	        }
   154	    }
   155	
   156	    /// Detects available support points around a position.
   157	    fn detect_support(world: &World, position: &BlockPos) -> SupportInfo {
   158	        let (block_above, state_above) = world.get_block_and_state(&position.up());
   159	        let above_is_valid = state_above.is_side_solid(BlockDirection::Down)
   160	            || block_above.has_tag(&pumpkin_data::tag::Block::MINECRAFT_SIGNS)
   161	            || block_above.has_tag(&pumpkin_data::tag::Block::MINECRAFT_LEAVES);
   162	
   163	        let mut side_direction = None;
   164	        for direction in BlockDirection::horizontal() {
   165	            let pos = position.offset(direction.to_offset());
   166	            if Self::is_valid_support(world, &pos, direction.opposite().to_block_direction()) {
   167	                side_direction = Some(direction);
   168	                break;
   169	            }
   170	        }
   171	
   172	        SupportInfo {
   173	            above_is_valid,
   174	            side_direction: side_direction.map(|d| d.to_block_direction()),
   175	        }
   176	    }

   468	   public void createStructures(
   469	      final RegistryAccess registryAccess,
   470	      final ChunkGeneratorStructureState state,
   471	      final StructureManager structureManager,
   472	      final ChunkAccess centerChunk,
   473	      final StructureTemplateManager structureTemplateManager,
   474	      final ResourceKey<Level> level
   475	   ) {
   476	      if (!SharedConstants.DEBUG_DISABLE_STRUCTURES) {
   477	         ChunkPos sourceChunkPos = centerChunk.getPos();
   478	         SectionPos sectionPos = SectionPos.bottomOf(centerChunk);
   479	         RandomState randomState = state.randomState();
   480	         state.possibleStructureSets()
   481	            .forEach(
   482	               set -> {
   483	                  StructurePlacement featurePlacement = set.value().placement();
   484	                  List<StructureSet.StructureSelectionEntry> structures = set.value().structures();
   485	
   486	                  for (StructureSet.StructureSelectionEntry structure : structures) {
   487	                     StructureStart existingStart = structureManager.getStartForStructure(sectionPos, structure.structure().value(), centerChunk);
   488	                     if (existingStart != null && existingStart.isValid()) {
   489	                        return;
   490	                     }
   590	      } else {
   591	         return false;
   592	      }
   593	   }

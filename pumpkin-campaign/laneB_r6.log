   475	   private static void fillSelectorSuggestions(final SuggestionsBuilder builder) {
   476	      builder.suggest("@p", Component.translatable("argument.entity.selector.nearestPlayer"));
   477	      builder.suggest("@a", Component.translatable("argument.entity.selector.allPlayers"));
   478	      builder.suggest("@r", Component.translatable("argument.entity.selector.randomPlayer"));
   479	      builder.suggest("@s", Component.translatable("argument.entity.selector.self"));
   480	      builder.suggest("@e", Component.translatable("argument.entity.selector.allEntities"));
   481	      builder.suggest("@n", Component.translatable("argument.entity.selector.nearestEntity"));
   482	   }

   605	    }
   606	}
   607	
   608	/// Holds all the pieces that make up a generated structure instance.
   609	#[derive(Default)]
   610	pub struct StructurePiecesCollector {
   611	    pub pieces: Vec<Box<dyn StructurePieceBase>>,
   612	    cached_box: Option<BlockBox>,
   613	}
   614	
   615	impl StructurePiecesCollector {
   616	    #[must_use]
   617	    pub fn new() -> Self {
   618	        Self {
   619	            pieces: Vec::new(),
   620	            cached_box: None,
   621	        }
   622	    }
   623	
   624	    pub fn add_piece(&mut self, piece: Box<dyn StructurePieceBase>) {
   625	        self.pieces.push(piece);
   626	        self.cached_box = None;
   627	    }
   628	
   629	    #[must_use]
   630	    pub fn get_intersecting(&self, box_to_check: &BlockBox) -> Option<&dyn StructurePieceBase> {
   631	        self.pieces
   632	            .iter()
   633	            .find(|piece| {
   634	                piece
   635	                    .get_structure_piece()
   636	                    .bounding_box
   637	                    .intersects(box_to_check)
   638	            })
   639	            .map(|v| v.as_ref() as &dyn StructurePieceBase)
   640	    }
   641	
   642	    /// Iterates over all pieces and generates them if they intersect the current chunk.
   643	    pub fn generate_in_chunk(
   644	        &mut self,
   645	        chunk: &mut ProtoChunk,
   646	        block_registry: &dyn WorldPortalExt,
   647	        random: &mut RandomGenerator,
   648	        seed: i64,
   649	    ) {
   650	        let chunk_x = start_block_x(chunk.x);
   651	        let chunk_z = start_block_z(chunk.z);
   652	        let chunk_box = BlockBox::new(
   653	            chunk_x,
   654	            chunk.bottom_y() as i32,
   655	            chunk_z,
   656	            chunk_x + 15,
   657	            i32::MAX,
   658	            chunk_z + 15,
   659	        );
   660	
   661	        for piece in &mut self.pieces {
   662	            if piece.bounding_box().intersects(&chunk_box) {
   663	                piece.place(chunk, block_registry, random, seed, &chunk_box);
   664	            }
   665	        }
   666	    }
   667	
   668	    pub fn shift(&mut self, y_offset: i32) {
   669	        for piece in &mut self.pieces {
   670	            piece.translate(0, y_offset, 0);
   671	        }
   672	        self.cached_box = None;
   673	    }
   674	
   675	    /// Calculates a random vertical position and shifts the structure to fit.
   676	    /// Matches 'shiftInto(int topY, int bottomY, Random random, int topPenalty)'
   677	    pub fn shift_into(
   678	        &mut self,
   679	        top_y: i32,
   680	        bottom_y: i32,
   681	        random: &mut RandomGenerator,
   682	        top_penalty: i32,
   683	    ) -> i32 {
   684	        let i = top_y - top_penalty;
   685	        let bounding_box = self.get_bounding_box();
   686	
   687	        let mut j = bounding_box.get_block_count_y() + bottom_y + 1;
   688	
   689	        if j < i {
   690	            j += random.next_bounded_i32(i - j);
   691	        }
   692	
   693	        let k = j - bounding_box.max.y;
   694	
   695	        self.shift(k);
   696	
   697	        k
   698	    }
   699	
   700	    pub fn get_bounding_box(&mut self) -> BlockBox {
   701	        if let Some(bbox) = self.cached_box {
   702	            return bbox;
   703	        }
   704	
   705	        let bbox = BlockBox::encompass_all(self.pieces.iter().map(|p| p.bounding_box()))
   706	            .unwrap_or_else(|| BlockBox::new(0, 0, 0, 0, 0, 0));
   707	
   708	        self.cached_box = Some(bbox);
   709	        bbox
   710	    }
   711	
   712	    #[must_use]
   713	    pub fn is_empty(&self) -> bool {
   714	        self.pieces.is_empty()
   715	    }
   716	
   717	    pub fn clear(&mut self) {
   718	        self.pieces.clear();
   719	    }
   720	}

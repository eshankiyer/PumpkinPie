   369	                let stack = self.inventory.remove_stack(i).await;
   370	                if !stack.is_empty() {
   371	                    offer_or_drop_stack(player, stack).await;
   372	                }
   373	            }
   374	            // Clear output slot
   375	            self.inventory.set_stack(2, ItemStack::EMPTY.clone()).await;
   376	        })
   377	    }
   378	
   379	    fn quick_move<'a>(
   380	        &'a mut self,
   381	        player: &'a dyn InventoryPlayer,
   382	        slot_index: i32,
   383	    ) -> ItemStackFuture<'a> {
   384	        Box::pin(async move {
   385	            const PLAYER_INVENTORY_START: i32 = 3;
   386	            const PLAYER_HOTBAR_START: i32 = 30;
   387	
   388	            let slot = self.get_behaviour().slots[slot_index as usize].clone();
   389	            let mut stack = slot.get_cloned_stack().await;
   390	            if stack.is_empty() {
   391	                return ItemStack::EMPTY.clone();
   392	            }
   393	            let original = stack.clone();
   394	            let player_slots_end = self.get_behaviour().slots.len() as i32;
   395	
   396	            if slot_index == 2 {
   397	                if !self
   398	                    .can_fully_insert(
   399	                        &stack,
   400	                        PLAYER_INVENTORY_START as usize,
   401	                        player_slots_end as usize,
   402	                    )
   403	                    .await
   404	                    || !self
   405	                        .insert_item(&mut stack, PLAYER_INVENTORY_START, player_slots_end, true)
   406	                        .await
   407	                {
   408	                    return ItemStack::EMPTY.clone();
   409	                }
   410	            } else if slot_index < PLAYER_INVENTORY_START {
   411	                if !self
   412	                    .insert_item(&mut stack, PLAYER_INVENTORY_START, player_slots_end, false)
   413	                    .await
   414	                {
   415	                    return ItemStack::EMPTY.clone();
   416	                }
   417	            } else if slot_index < PLAYER_HOTBAR_START {
   418	                if !self
   419	                    .insert_item(&mut stack, PLAYER_HOTBAR_START, player_slots_end, false)
   420	                    .await
   421	                {
   422	                    return ItemStack::EMPTY.clone();
   423	                }
   424	            } else if !self
   425	                .insert_item(
   426	                    &mut stack,
   427	                    PLAYER_INVENTORY_START,
   428	                    PLAYER_HOTBAR_START,
   429	                    false,
   430	                )
   431	                .await
   432	            {
   433	                return ItemStack::EMPTY.clone();
   434	            }
   435	
   436	            if stack.item_count == original.item_count {
   437	                return ItemStack::EMPTY.clone();
   438	            }
   439	            if stack.is_empty() {
   440	                slot.set_stack(ItemStack::EMPTY.clone()).await;
   441	            } else {
   442	                slot.set_stack(stack.clone()).await;
   443	            }
   444	
   445	            let mut taken = original.clone();
   446	            taken.set_count(original.item_count - stack.item_count);
   447	            slot.on_take_item(player, &taken).await;
   448	            if slot_index == 2 {
   449	                slot.on_quick_move_crafted(stack, original.clone()).await;
   450	                self.result_taken.store(false, Ordering::Relaxed);
   451	                if !self.complete_trade(player).await {
   452	                    return ItemStack::EMPTY.clone();
   453	                }
   454	                if let Some(on_quick_move_trade) = &self.on_quick_move_trade {
   455	                    on_quick_move_trade();
   456	                }
   457	                self.update_result_slot().await;
   458	            }
   459	
   460	            original
   461	        })
   462	    }
   463	
   464	    fn on_slot_click<'a>(
   465	        &'a mut self,
   466	        slot_index: i32,
   467	        button: i32,
   468	        action_type: pumpkin_protocol::java::server::play::SlotActionType,
   469	        player: &'a dyn InventoryPlayer,
   470	    ) -> ScreenHandlerFuture<'a, ()> {
   471	        Box::pin(async move {
   472	            if slot_index == 2 {
   473	                self.update_result_slot().await;
   474	            }
   475	            self.result_taken.store(false, Ordering::Relaxed);
   476	            self.internal_on_slot_click(slot_index, button, action_type, player)
   477	                .await;
   478	            if self.result_taken.swap(false, Ordering::Relaxed) {
   479	                self.complete_trade(player).await;
   480	            }
   481	            self.update_result_slot().await;
   482	            self.notify_trade_updated().await;
   483	            self.send_content_updates().await;
   484	        })
   485	    }
   486	}

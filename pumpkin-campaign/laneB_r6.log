   115	/// Vanilla `VibrationSystem.getResonanceEventByFrequency`: frequency N maps to
   116	/// `RESONATE_N` (1-15).
   117	const fn resonance_event_by_frequency(frequency: i32) -> GameEvent {
   118	    match frequency {
   119	        1 => GameEvent::Resonate1,
   120	        2 => GameEvent::Resonate2,
   121	        3 => GameEvent::Resonate3,
   122	        4 => GameEvent::Resonate4,
   123	        5 => GameEvent::Resonate5,
   124	        6 => GameEvent::Resonate6,
   125	        7 => GameEvent::Resonate7,
   126	        8 => GameEvent::Resonate8,
   127	        9 => GameEvent::Resonate9,
   128	        10 => GameEvent::Resonate10,
   129	        11 => GameEvent::Resonate11,
   130	        12 => GameEvent::Resonate12,
   131	        13 => GameEvent::Resonate13,
   132	        14 => GameEvent::Resonate14,
   133	        _ => GameEvent::Resonate15,

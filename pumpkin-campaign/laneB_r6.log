   259	    /// `ServerPlayer.java:421` storing `ServerRecipeBook.Packed.CODEC`.
   260	    pub fn write_nbt(&self, nbt: &mut NbtCompound) {
   261	        let mut book = NbtCompound::new();
   262	        self.settings.write_nbt(&mut book);
   263	        let mut known: Vec<&str> = self.known.iter().map(String::as_str).collect();
   264	        known.sort_unstable();
   265	        let mut highlight: Vec<&str> = self.highlight.iter().map(String::as_str).collect();
   266	        highlight.sort_unstable();
   267	        book.put_list(
   268	            KNOWN_TAG,
   269	            known
   270	                .into_iter()
   271	                .map(|id| NbtTag::String(id.into()))
   272	                .collect(),
   273	        );
   274	        book.put_list(
   275	            HIGHLIGHT_TAG,
   276	            highlight
   277	                .into_iter()
   278	                .map(|id| NbtTag::String(id.into()))
   279	                .collect(),
   280	        );
   281	        nbt.put_compound(RECIPE_BOOK_TAG, book);
   282	    }

  1299	                    let input_slot = NormalSlot::new(crafing_inventory.clone(), j + i * width);
  1300	                    self.add_slot(Arc::new(input_slot));
  1301	                }
  1302	            }
  1303	            self.add_listener(result_slot).await;
  1304	        })
  1305	    }
  1306	}

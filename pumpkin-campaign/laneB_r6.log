   172	   private void finalizePredicates() {
   173	      if (this.rotX != null) {
   174	         this.predicates.add(this.createRotationPredicate(this.rotX, Entity::getXRot));
   175	      }
   176	
   177	      if (this.rotY != null) {
   178	         this.predicates.add(this.createRotationPredicate(this.rotY, Entity::getYRot));
   179	      }
   180	
   181	      if (this.level != null) {
   182	         this.predicates.add(e -> e instanceof ServerPlayer serverPlayer && this.level.matches(serverPlayer.experienceLevel));
   183	      }
   184	   }

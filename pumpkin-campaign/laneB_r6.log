  1430	                id: effect_modifier.id.to_string(),
  1431	                amount: effect_modifier.base_value * (f64::from(effect.amplifier) + 1.0),
  1432	                operation,
  1433	            };
  1434	            self.update_attribute(attribute, |instance| {
  1435	                instance.add_or_replace_modifier(modifier.clone());

    27	pub fn find_closest_biome_3d(
    28	    world_gen: &WorldGenerator,
    29	    origin: BlockPos,
    30	    targets: &FxHashSet<u8>,
    31	    horizontal_radius: i32,
    32	    horizontal_step: i32,
    33	    vertical_step: i32,

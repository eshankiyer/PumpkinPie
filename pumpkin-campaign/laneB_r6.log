   106	// GameEvent.java bootstrap: DEFAULT_NOTIFICATION_RADIUS = 16; jukebox_play and
   107	// jukebox_stop_play register at 10; shriek registers at 32. All others use the default.
   108	#[must_use]
   109	pub const fn notification_radius(event: &GameEvent) -> i32 {
   110	    match event {
   111	        GameEvent::JukeboxPlay | GameEvent::JukeboxStopPlay => 10,
   112	        GameEvent::Shriek => 32,
   113	        _ => 16,

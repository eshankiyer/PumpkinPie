   446	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
   447	        Box::pin(async move {
   448	            let state = args.world.get_block_state(args.position);
   449	            if args.block.id == BlockId::SCULK_SENSOR {
   450	                let mut props = SculkSensorLikeProperties::from_state_id(state.id, args.block);
   451	                match props.sculk_sensor_phase {
   452	                    SculkSensorPhase::Active => {
   453	                        props.sculk_sensor_phase = SculkSensorPhase::Cooldown;
   454	                        props.power = 0;
   455	                        args.world
   456	                            .set_block_state(
   457	                                args.position,
   458	                                props.to_state_id(args.block),
   459	                                BlockFlags::NOTIFY_ALL,
   460	                            )
   461	                            .await;
   462	                        args.world.schedule_block_tick(
   463	                            args.block,
   464	                            *args.position,
   465	                            10,
   466	                            TickPriority::Normal,
   467	                        );
   468	                        args.world.update_neighbors(args.position, None).await;
   469	                    }
   470	                    SculkSensorPhase::Cooldown => {
   471	                        props.sculk_sensor_phase = SculkSensorPhase::Inactive;
   472	                        props.power = 0;
   473	                        args.world
   474	                            .set_block_state(
   475	                                args.position,
   476	                                props.to_state_id(args.block),
   477	                                BlockFlags::NOTIFY_ALL,
   478	                            )
   479	                            .await;
   480	                        args.world.update_neighbors(args.position, None).await;
   481	                    }
   482	                    SculkSensorPhase::Inactive => {}
   483	                }
   484	            } else if args.block.id == BlockId::CALIBRATED_SCULK_SENSOR {
   485	                let mut props =
   486	                    CalibratedSculkSensorLikeProperties::from_state_id(state.id, args.block);
   487	                match props.sculk_sensor_phase {
   488	                    SculkSensorPhase::Active => {
   489	                        props.sculk_sensor_phase = SculkSensorPhase::Cooldown;
   490	                        props.power = 0;
   491	                        args.world
   492	                            .set_block_state(
   493	                                args.position,
   494	                                props.to_state_id(args.block),
   495	                                BlockFlags::NOTIFY_ALL,
   496	                            )
   497	                            .await;
   498	                        args.world.schedule_block_tick(
   499	                            args.block,
   500	                            *args.position,
   501	                            10,
   502	                            TickPriority::Normal,
   503	                        );
   504	                        args.world.update_neighbors(args.position, None).await;
   505	                    }
   506	                    SculkSensorPhase::Cooldown => {
   507	                        props.sculk_sensor_phase = SculkSensorPhase::Inactive;
   508	                        props.power = 0;
   509	                        args.world
   510	                            .set_block_state(
   511	                                args.position,
   512	                                props.to_state_id(args.block),
   513	                                BlockFlags::NOTIFY_ALL,
   514	                            )
   515	                            .await;
   516	                        args.world.update_neighbors(args.position, None).await;
   517	                    }
   518	                    SculkSensorPhase::Inactive => {}
   519	                }
   520	            }
   521	        })
   522	    }

   644	    fn set_on_fire_for_ticks(&self, ticks: u32) {
   645	        let entity = self.get_entity();
   646	        let mut event = crate::plugin::api::events::entity::entity_combust::EntityCombustEvent::new(
   647	            entity.entity_id,
   648	            ticks as f32 / 20.0,
   649	        );
   650	        if let Some(server) = entity.world.load().server.upgrade() {
   651	            tokio::task::block_in_place(|| {
   652	                tokio::runtime::Handle::current().block_on(async {
   653	                    server.plugin_manager.fire(&server, &mut event).await;
   654	                });
   655	            });
   656	            if event.cancelled {
   657	                return;
   658	            }

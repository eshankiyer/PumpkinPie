   179	/// Syncs the tracked-data `POSE` without going through `Entity::set_pose`, for the same reason
   180	/// `frog_tongue_attack.rs::sync_tongue_pose` does: `set_pose` gates on `is_space_empty`, so it
   181	/// would silently no-op in a tight spot, and vanilla's `refreshDimensions` has no such gate.
   182	///
   183	/// The resize vanilla does perform is done here instead. `Warden.getDefaultDimensions`
   184	/// (Warden.java:516-521) overrides dimensions for `DIGGING`/`EMERGING` only, not `ROARING`, so
   185	/// a roaring warden keeps its normal box while an emerging one shrinks to 1.0 blocks tall.
   186	fn sync_warden_pose(entity: &Entity, pose: EntityPose) {
   187	    entity.pose.store(pose);
   188	
   189	    // `Entity.refreshDimensions` (`Entity.java:660-676`), the half that matters here: apply
   190	    // whatever `getDefaultDimensions` returns for the new pose and rebuild the bounding box
   191	    // around the current position. `Warden.getDefaultDimensions` (`Warden.java:516-521`)
   192	    // squashes a digging or emerging warden to a 1.0-block-tall box; every other pose gets the
   193	    // type's own size back. Vanilla's `refreshDimensions` performs no space check, so neither
   194	    // does this -- the `is_space_empty` gate that `set_pose` applies is what this function
   195	    // exists to bypass.
   196	    let dimension = entity.get_dimensions(pose);
   197	    let position = entity.pos.load();
   198	    entity.bounding_box.store(BoundingBox::new_from_pos(
   199	        position.x, position.y, position.z, &dimension,
   200	    ));
   201	    entity.entity_dimension.store(dimension);
   202	
   203	    entity.send_meta_data(
   204	        &[Metadata::new(
   205	            tracked_data::warden::POSE,
   206	            VarInt(pose as i32),
   207	        )],
   208	        None,
   209	    );
   210	}

   197	    async fn complete_trade(&mut self, player: &dyn InventoryPlayer) -> bool {
   198	        let Some(offer_index) = self.active_offer else {
   199	            return false;
   200	        };
   201	        let Some(offer) = self.offers.get(offer_index) else {
   202	            return false;
   203	        };
   204	        if offer.is_out_of_stock() {
   205	            return false;
   206	        }
   207	
   208	        let input_a = self.inventory.get_stack(0).await;
   209	        let input_b = self.inventory.get_stack(1).await;
   210	        let Some(swapped) = Self::input_order(offer, &input_a, &input_b) else {
   211	            return false;
   212	        };
   213	        let cost_a = Self::adjusted_cost_a(offer).item_count;
   214	        let cost_b = offer.cost_b.as_ref().map(|cost| cost.0.item_count);
   215	
   216	        self.consume_payment(usize::from(swapped), cost_a).await;
   217	        if let Some(cost_b) = cost_b {
   218	            self.consume_payment(usize::from(!swapped), cost_b).await;
   219	        }
   220	        self.offers[offer_index].uses += 1;
   221	
   222	        if let Some(on_trade) = &self.on_trade {
   223	            on_trade(offer_index).await;
   224	        }
   225	        player
   226	            .increment_stat(
   227	                StatisticCategory::Custom,
   228	                CustomStatistic::TradedWithVillager as i32,
   229	                1,
   230	            )
   231	            .await;
   232	        true
   233	    }

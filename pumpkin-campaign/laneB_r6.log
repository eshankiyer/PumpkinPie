   193	        let dx = f64::from(current_block.0.x - last.0.x);
   194	        let dy = f64::from(current_block.0.y - last.0.y);
   195	        let dz = f64::from(current_block.0.z - last.0.z);
   196	        if dx * dx + dy * dy + dz * dz <= 4.0 {
   197	            return;
   198	        }

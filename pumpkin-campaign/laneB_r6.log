   595	   private static int fetchReferences(
   596	      final StructureManager structureManager, final ChunkAccess centerChunk, final SectionPos sectionPos, final Structure structure
   597	   ) {
   598	      StructureStart prevEntry = structureManager.getStartForStructure(sectionPos, structure, centerChunk);
   599	      return prevEntry != null ? prevEntry.getReferences() : 0;
   600	   }
   601	
   602	   public void createReferences(final WorldGenLevel level, final StructureManager structureManager, final ChunkAccess centerChunk) {
   603	      int range = 8;
   604	      ChunkPos chunkPos = centerChunk.getPos();
   605	      int targetX = chunkPos.x();
   606	      int targetZ = chunkPos.z();
   607	      int targetBlockX = chunkPos.getMinBlockX();
   608	      int targetBlockZ = chunkPos.getMinBlockZ();
   609	      SectionPos pos = SectionPos.bottomOf(centerChunk);
   610	
   611	      for (int sourceX = targetX - 8; sourceX <= targetX + 8; sourceX++) {
   612	         for (int sourceZ = targetZ - 8; sourceZ <= targetZ + 8; sourceZ++) {
   613	            long sourceChunkKey = ChunkPos.pack(sourceX, sourceZ);
   614	
   615	            for (StructureStart start : level.getChunk(sourceX, sourceZ).getAllStarts().values()) {
   616	               try {
   617	                  if (start.isValid() && start.getBoundingBox().intersects(targetBlockX, targetBlockZ, targetBlockX + 15, targetBlockZ + 15)) {
   618	                     structureManager.addReferenceForStructure(pos, start.getStructure(), sourceChunkKey, centerChunk);
   619	                  }
   620	               } catch (Exception e) {
   621	                  CrashReport report = CrashReport.forThrowable(e, "Generating structure reference");
   622	                  CrashReportCategory structure = report.addCategory("Structure");
   623	                  Optional<? extends Registry<Structure>> configuredStructuresRegistry = level.registryAccess().lookup(Registries.STRUCTURE);
   624	                  structure.setDetail("Id", () -> configuredStructuresRegistry.<String>map(r -> r.getKey(start.getStructure()).toString()).orElse("UNKNOWN"));
   625	                  structure.setDetail("Name", () -> BuiltInRegistries.STRUCTURE_TYPE.getKey(start.getStructure().type()).toString());
   626	                  structure.setDetail("Class", () -> start.getStructure().getClass().getCanonicalName());
   627	                  throw new ReportedException(report);
   628	               }
   629	            }
   630	         }
   631	      }
   632	   }

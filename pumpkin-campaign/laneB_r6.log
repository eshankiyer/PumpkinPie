    20	/// their item stacks in Pumpkin goes through `tokio::sync::Mutex`. Implementations MUST copy
    21	/// what they need out of the world first and only then take the brain's memory lock: the
    22	/// memory guard is a `std::sync::Mutex` guard and must never be held across an `.await`.
    23	pub trait Sensor: Send {

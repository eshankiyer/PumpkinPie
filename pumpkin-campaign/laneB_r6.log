    35	use crate::entity::ai::brain::Brain;
    36	use crate::entity::ai::brain::memory::{MemoryKeyId, MemoryStatus};
    37	use crate::entity::mob::Mob;
    38	
    39	/// `Behavior.Status` (`behavior/Behavior.java:109-112`).
    40	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    41	pub enum BehaviorStatus {
    42	    Stopped,
    43	    Running,
    44	}
    45	
    46	/// `BehaviorControl<E>` (`behavior/BehaviorControl.java:8-20`).
    47	///
    48	/// No `Controls`-style exclusivity field, on purpose. See `super`'s module comment.
    49	pub trait Behavior: Send {
    50	    /// `getRequiredMemories()`. Used both as the entry gate and, at brain construction, as the
    51	    /// list of memories to register (`Brain.java:363-366`).
    52	    fn required_memories(&self) -> &[(MemoryKeyId, MemoryStatus)];
    53	    fn status(&self) -> BehaviorStatus;
    54	    fn try_start(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool;
    55	    fn tick_or_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64);
    56	    fn do_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64);
    57	    fn debug_name(&self) -> &'static str;
    58	}
    59	
    60	/// The overridable half of vanilla's `Behavior<E>`: the `protected` hooks a subclass fills in.
    61	pub trait TimedBehavior: Send {
    62	    fn debug_name(&self) -> &'static str;
    63	
    64	    /// `checkExtraStartConditions` (`behavior/Behavior.java:88-90`).
    65	    fn check_extra_start_conditions(&mut self, _mob: &dyn Mob, _brain: &Brain) -> bool {
    66	        true
    67	    }
    68	
    69	    /// `start` (`behavior/Behavior.java:56-57`).
    70	    fn start(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {}
    71	
    72	    /// `tick` (`behavior/Behavior.java:68-69`).
    73	    fn tick(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {}
    74	
    75	    /// `stop` (`behavior/Behavior.java:77-78`).
    76	    fn stop(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {}
    77	
    78	    /// `canStillUse` (`behavior/Behavior.java:80-82`), which defaults to `false` -- a behavior
    79	    /// that does not override it runs for exactly one tick.
    80	    fn can_still_use(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) -> bool {
    81	        false
    82	    }
    83	
    84	    /// `timedOut` (`behavior/Behavior.java:84-86`). `CountDownCooldownTicks` overrides it to
    85	    /// `false` (`behavior/CountDownCooldownTicks.java:22-25`), so it never expires on duration.
    86	    fn can_time_out(&self) -> bool {
    87	        true
    88	    }
    89	}
    90	
    91	/// The `final` half of vanilla's `Behavior<E>`: entry-condition check, randomized duration,
    92	/// and the `tryStart` / `tickOrStop` / `doStop` state machine (`behavior/Behavior.java:44-75`).
    93	pub struct TimedBehaviorControl<T: TimedBehavior> {
    94	    inner: T,
    95	    entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
    96	    status: BehaviorStatus,
    97	    end_timestamp: i64,
    98	    min_duration: i32,
    99	    max_duration: i32,
   100	}
   101	
   102	impl<T: TimedBehavior> TimedBehaviorControl<T> {
   103	    /// `Behavior(entryCondition)` -- `DEFAULT_DURATION = 60` (`behavior/Behavior.java:12,19-21`).
   104	    pub const fn new(inner: T, entry_condition: Vec<(MemoryKeyId, MemoryStatus)>) -> Self {
   105	        Self::with_duration(inner, entry_condition, 60, 60)
   106	    }
   107	
   108	    /// `Behavior(entryCondition, minDuration, maxDuration)` (`behavior/Behavior.java:27-31`).
   109	    pub const fn with_duration(
   110	        inner: T,
   111	        entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
   112	        min_duration: i32,
   113	        max_duration: i32,
   114	    ) -> Self {
   115	        Self {
   116	            inner,
   117	            entry_condition,
   118	            status: BehaviorStatus::Stopped,
   119	            end_timestamp: 0,
   120	            min_duration,
   121	            max_duration,
   122	        }
   123	    }
   124	
   125	    /// `timedOut(timestamp)` (`behavior/Behavior.java:84-86`).
   126	    fn timed_out(&self, game_time: i64) -> bool {
   127	        self.inner.can_time_out() && game_time > self.end_timestamp
   128	    }
   129	}
   130	
   131	impl<T: TimedBehavior + 'static> Behavior for TimedBehaviorControl<T> {
   132	    fn required_memories(&self) -> &[(MemoryKeyId, MemoryStatus)] {
   133	        &self.entry_condition
   134	    }
   135	
   136	    fn status(&self) -> BehaviorStatus {
   137	        self.status
   138	    }
   139	
   140	    /// `tryStart` (`behavior/Behavior.java:43-54`). The randomized duration is rolled once, at
   141	    /// start: `minDuration + random.nextInt(maxDuration + 1 - minDuration)`.
   142	    fn try_start(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool {
   143	        if !brain.check_memories(&self.entry_condition) {
   144	            return false;
   145	        }
   146	        if !self.inner.check_extra_start_conditions(mob, brain) {
   147	            return false;
   148	        }
   149	        self.status = BehaviorStatus::Running;
   150	        let span = self.max_duration + 1 - self.min_duration;
   151	        let duration = if span > 1 {
   152	            self.min_duration + mob.get_random().random_range(0..span)
   153	        } else {
   154	            self.min_duration
   155	        };
   156	        self.end_timestamp = game_time + i64::from(duration);
   157	        self.inner.start(mob, brain, game_time);
   158	        true
   159	    }
   160	
   161	    /// `tickOrStop` (`behavior/Behavior.java:59-66`).
   162	    fn tick_or_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   163	        if !self.timed_out(game_time) && self.inner.can_still_use(mob, brain, game_time) {
   164	            self.inner.tick(mob, brain, game_time);
   165	        } else {
   166	            self.do_stop(mob, brain, game_time);
   167	        }
   168	    }
   169	
   170	    /// `doStop` (`behavior/Behavior.java:71-75`).
   171	    fn do_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   172	        self.status = BehaviorStatus::Stopped;
   173	        self.inner.stop(mob, brain, game_time);
   174	    }
   175	
   176	    fn debug_name(&self) -> &'static str {
   177	        self.inner.debug_name()
   178	    }
   179	}
   180	
   181	/// `OneShot<E>` (`behavior/OneShot.java:7-38`), the base of every `BehaviorBuilder.create`
   182	/// declarative behavior.
   183	///
   184	/// `tryStart` runs a trigger and, if it fires, marks the behavior running
   185	/// for a single tick; `tickOrStop` unconditionally stops it.
   186	pub trait OneShotTrigger: Send {
   187	    fn debug_name(&self) -> &'static str;
   188	    fn trigger(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool;
   189	}
   190	
   191	pub struct OneShot<T: OneShotTrigger> {
   192	    inner: T,
   193	    entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
   194	    status: BehaviorStatus,
   195	}
   196	
   197	impl<T: OneShotTrigger> OneShot<T> {
   198	    pub const fn new(inner: T, entry_condition: Vec<(MemoryKeyId, MemoryStatus)>) -> Self {
   199	        Self {
   200	            inner,
   201	            entry_condition,
   202	            status: BehaviorStatus::Stopped,
   203	        }
   204	    }
   205	}
   206	
   207	impl<T: OneShotTrigger + 'static> Behavior for OneShot<T> {
   208	    fn required_memories(&self) -> &[(MemoryKeyId, MemoryStatus)] {
   209	        &self.entry_condition
   210	    }
   211	
   212	    fn status(&self) -> BehaviorStatus {
   213	        self.status
   214	    }
   215	
   216	    fn try_start(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool {
   217	        // The declarative builders fold the memory-status group into the trigger; here the
   218	        // group is the entry condition and is checked first, matching
   219	        // `BehaviorBuilder`'s generated `hasRequiredMemories` gate.
   220	        if !brain.check_memories(&self.entry_condition) {
   221	            return false;
   222	        }
   223	        if self.inner.trigger(mob, brain, game_time) {
   224	            self.status = BehaviorStatus::Running;
   225	            true
   226	        } else {
   227	            false
   228	        }
   229	    }
   230	
   231	    fn tick_or_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   232	        self.do_stop(mob, brain, game_time);
   233	    }
   234	
   235	    fn do_stop(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {
   236	        self.status = BehaviorStatus::Stopped;
   237	    }
   238	
   239	    fn debug_name(&self) -> &'static str {
   240	        self.inner.debug_name()
   241	    }
   242	}


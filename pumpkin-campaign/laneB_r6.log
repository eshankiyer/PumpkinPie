   349	   @Override
   350	   protected Vec3 getRiddenInput(final Player controller, final Vec3 selfInput) {
   351	      float strafe = controller.xxa;
   352	      float forward = 0.0F;
   353	      float up = 0.0F;
   354	      if (controller.zza != 0.0F) {
   355	         float forwardLook = Mth.cos(controller.getXRot() * (float) (Math.PI / 180.0));
   356	         float upLook = -Mth.sin(controller.getXRot() * (float) (Math.PI / 180.0));
   357	         if (controller.zza < 0.0F) {
   358	            forwardLook *= -0.5F;
   359	            upLook *= -0.5F;
   360	         }
   361	
   362	         up = upLook;
   363	         forward = forwardLook;
   364	      }
   365	
   366	      if (controller.isJumping()) {
   367	         up += 0.5F;
   368	      }
   369	
   370	      return new Vec3(strafe, up, forward).scale(3.9F * this.getAttributeValue(Attributes.FLYING_SPEED));
   371	   }

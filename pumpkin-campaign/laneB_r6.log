   106	            let position = self.get_position();
   107	            nbt.put_int("x", position.0.x);
   108	            nbt.put_int("y", position.0.y);
   109	            nbt.put_int("z", position.0.z);
   110	            self.write_nbt(nbt).await;
   111	        })
   112	    }

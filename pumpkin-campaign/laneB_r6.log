+        memories_to_erase_when_stopped: Vec<MemoryKeyId>,
+    ) {
+        {
+            let mut memory = self.memory.lock().unwrap();
+            for (id, _) in &conditions {
+                memory.register(*id);
+            }
+            for (_, behavior) in &behavior_priority_pairs {
+                for (id, _) in behavior.required_memories() {
+                    memory.register(*id);
+                }
+            }
+        }

   125	    /// `checkExtraStartConditions` (`MoveToTargetSink.java:45-65`).
   126	    fn check_extra_start_conditions(&mut self, mob: &dyn Mob, brain: &Brain) -> bool {
   127	        if self.remaining_cooldown > 0 {
   128	            self.remaining_cooldown -= 1;
   129	            return false;
   130	        }
   131	
   132	        let Some(walk_target) = brain.get::<WalkTargetMemory>() else {
   133	            return false;
   134	        };

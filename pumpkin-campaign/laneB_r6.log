  1991	                // TODO: If the passenger is a player, ogs = movement_speed * 0.1
  1992	
  1993	                0.02
  1994	            };
  1995	
  1996	            (speed, air_drag)
  1997	        };
  1998	
  1999	        self.entity
  2000	            .update_velocity_from_input(self.movement_input.load(), speed);
  2001	
  2002	        self.apply_climbing_speed();
  2003	
  2004	        self.make_move(caller).await;
  2005	
  2006	        let mut velo = self.entity.velocity.load();

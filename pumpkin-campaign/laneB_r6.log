   409	   private void startEachNonRunningBehavior(final ServerLevel level, final E body) {
   410	      long time = level.getGameTime();
   411	
   412	      for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
   413	         for (Entry<Activity, Set<BehaviorControl<? super E>>> behavioursForActivity : behavioursByActivities.entrySet()) {
   414	            Activity activity = behavioursForActivity.getKey();
   415	            if (this.activeActivities.contains(activity)) {
   416	               for (BehaviorControl<? super E> behavior : behavioursForActivity.getValue()) {
   417	                  if (behavior.getStatus() == Behavior.Status.STOPPED) {
   418	                     behavior.tryStart(level, body, time);
   419	                  }
   420	               }
   421	            }
   422	         }
   423	      }
   424	   }

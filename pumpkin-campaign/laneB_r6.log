   123	    fn adjusted_cost_a(offer: &pumpkin_protocol::java::client::play::MerchantOffer) -> ItemStack {
   124	        let mut cost = offer.base_cost_a.0.as_ref().clone();
   125	        let demand = i32::from(cost.item_count).saturating_mul(offer.demand) as f32;
   126	        let demand_bonus = (demand * offer.price_multiplier).floor().max(0.0) as i32;
   127	        let count = i32::from(cost.item_count)
   128	            .saturating_add(demand_bonus)
   129	            .saturating_add(offer.special_price)
   130	            .clamp(1, i32::from(cost.get_max_stack_size()));
   131	        cost.set_count(count as u8);
   132	        cost
   133	    }
   134	
   135	    fn matches_cost(cost: &ItemStack, input: &ItemStack) -> bool {
   136	        !input.is_empty()
   137	            && cost.are_items_and_components_equal(input)
   138	            && input.item_count >= cost.item_count
   139	    }
   140	
   141	    fn satisfies(
   142	        offer: &pumpkin_protocol::java::client::play::MerchantOffer,
   143	        input_a: &ItemStack,
   144	        input_b: &ItemStack,
   145	    ) -> bool {
   146	        Self::matches_cost(&Self::adjusted_cost_a(offer), input_a)
   147	            && offer.cost_b.as_ref().map_or_else(
   148	                || input_b.is_empty(),
   149	                |cost_b| Self::matches_cost(&cost_b.0, input_b),
   150	            )
   151	    }
   152	
   153	    fn input_order(
   154	        offer: &pumpkin_protocol::java::client::play::MerchantOffer,
   155	        input_a: &ItemStack,
   156	        input_b: &ItemStack,
   157	    ) -> Option<bool> {
   158	        if Self::satisfies(offer, input_a, input_b) {
   159	            Some(false)
   160	        } else if Self::satisfies(offer, input_b, input_a) {
   161	            Some(true)
   162	        } else {
   163	            None
   164	        }
   165	    }
   166	
   167	    fn matching_offer(&self, input_a: &ItemStack, input_b: &ItemStack) -> Option<usize> {
   168	        if self.selected_offer > 0 && self.selected_offer < self.offers.len() {
   169	            return Self::satisfies(&self.offers[self.selected_offer], input_a, input_b)
   170	                .then_some(self.selected_offer);
   171	        }
   172	
   173	        self.offers
   174	            .iter()
   175	            .position(|offer| Self::satisfies(offer, input_a, input_b))
   176	    }
   177	
   178	    fn find_active_offer(&self, input_a: &ItemStack, input_b: &ItemStack) -> Option<usize> {
   179	        self.matching_offer(input_a, input_b)
   180	            .filter(|&index| !self.offers[index].is_out_of_stock())
   181	            .or_else(|| {
   182	                self.matching_offer(input_b, input_a)
   183	                    .filter(|&index| !self.offers[index].is_out_of_stock())
   184	            })
   185	    }

   389	    fn custom_travel<'a>(&'a self, caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, bool> {
   390	        Box::pin(async move {
   391	            let living = &self.mob_entity.living_entity;
   392	            let entity = &living.entity;
   393	            let flying_speed = living.get_attribute_value(&Attributes::FLYING_SPEED);
   394	
   395	            // HappyGhast.getRiddenInput/getRiddenRotation/tickRidden
   396	            // (`HappyGhast.java:350-387`) are folded into this reachable travel hook. The
   397	            // packet's input flags are the server representation of the rider's xxa/zza/jumping.
   398	            let rider_input = {
   399	                let passengers = entity.passengers.lock().await;
   400	                passengers.first().and_then(|passenger| {
   401	                    passenger.get_player().map(|rider| {
   402	                        (
   403	                            rider.last_input.load(Relaxed),
   404	                            rider.get_entity().pitch.load(),
   405	                            rider.get_entity().yaw.load(),
   406	                        )
   407	                    })
   408	                })
   409	            };
   410	            let movement_input = if !self.is_on_still_timeout()
   411	                && self.is_wearing_body_armor().await
   412	                && let Some((input, pitch, yaw)) = rider_input
   413	            {
   414	                // `ServerPlayer.getLastClientMoveIntent` (`ServerPlayer.java:2231`): left is
   415	                // positive strafe, right is negative.
   416	                let mut strafe = 0.0;
   417	                if input & SPlayerInput::LEFT != 0 {
   418	                    strafe += 1.0;
   419	                }
   420	                if input & SPlayerInput::RIGHT != 0 {
   421	                    strafe -= 1.0;
   422	                }
   423	
   424	                let mut up = 0.0;
   425	                let mut forward = 0.0;
   426	                if input & (SPlayerInput::FORWARD | SPlayerInput::BACKWARD) != 0 {
   427	                    let pitch_radians = f64::from(pitch).to_radians();
   428	                    forward = pitch_radians.cos();
   429	                    up = -pitch_radians.sin();
   430	                    if input & SPlayerInput::BACKWARD != 0 {
   431	                        forward *= -0.5;
   432	                        up *= -0.5;
   433	                    }
   434	                }
   435	                if input & SPlayerInput::JUMP != 0 {
   436	                    up += 0.5;
   437	                }
   438	
   439	                let diff = pumpkin_util::math::wrap_degrees(yaw - entity.yaw.load());
   440	                let new_yaw = entity.yaw.load() + diff * 0.08;
   441	                entity.yaw.store(new_yaw);
   442	                entity.pitch.store(pitch * 0.5);
   443	                entity.head_yaw.store(new_yaw);
   444	                entity.body_yaw.store(new_yaw);
   445	
   446	                Vector3::new(strafe, up, forward) * (3.9 * flying_speed)
   447	            } else {
   448	                living.movement_input.load()
   449	            };
   450	
   451	            // `HappyGhast.travel` (`HappyGhast.java:176-179`) always uses travelFlying with
   452	            // FLYING_SPEED * 5/3, including in water and lava. `travelFlying` applies the
   453	            // corresponding 0.8/0.5/0.91 velocity drag (`LivingEntity.java:2439-2457`).
   454	            living
   455	                .entity
   456	                .update_velocity_from_input(movement_input, flying_speed * (5.0 / 3.0));
   457	            let velocity = entity.velocity.load();
   458	            entity.move_entity(caller, velocity).await;
   459	
   460	            let drag = if entity.touching_water.load(Relaxed) {
   461	                0.8
   462	            } else if entity.touching_lava.load(Relaxed) {
   463	                0.5
   464	            } else {
   465	                0.91
   466	            };
   467	            entity.velocity.store(entity.velocity.load() * drag);
   468	            true
   469	        })
   470	    }

    30	// Port of VibrationSelector.java (66 lines). Picks, per game tick, the single
    31	// candidate vibration a listener will actually act on: closer distance wins, and on
    32	// a distance tie the higher-frequency event wins (VibrationSelector.shouldReplaceVibration).
    33	//
    34	// Not yet wired into the live emission path: vanilla resolves the chosen candidate on
    35	// a later tick via VibrationSystem.Ticker (travel-time simulation), which this Phase 1
    36	// does not implement (see mod.rs doc comment). This type is provided, tested, standalone,
    37	// for a future phase's tick-based listener to use.
    38	#[derive(Default)]
    39	pub struct VibrationSelector {
    40	    current: Option<(VibrationInfo, u64)>,
    41	}
    42	
    43	impl VibrationSelector {
    44	    #[must_use]
    45	    pub const fn new() -> Self {
    46	        Self { current: None }
    47	    }
    48	
    49	    pub fn add_candidate(&mut self, candidate: VibrationInfo, tick_time: u64) {
    50	        if self.should_replace_vibration(&candidate, tick_time) {
    51	            self.current = Some((candidate, tick_time));
    52	        }
    53	    }
    54	
    55	    fn should_replace_vibration(&self, candidate: &VibrationInfo, tick_time: u64) -> bool {
    56	        let Some((previous, previous_tick)) = &self.current else {
    57	            return true;
    58	        };
    59	        if tick_time != *previous_tick {
    60	            return false;
    61	        }
    62	        if candidate.distance < previous.distance {
    63	            return true;
    64	        }
    65	        if candidate.distance > previous.distance {
    66	            return false;
    67	        }
    68	        candidate.frequency > previous.frequency
    69	    }
    70	
    71	    #[must_use]
    72	    pub fn chosen_candidate(&self, time: u64) -> Option<VibrationInfo> {
    73	        let (info, tick) = self.current.as_ref()?;
    74	        (*tick < time).then_some(*info)
    75	    }
    76	
    77	    pub const fn start_over(&mut self) {
    78	        self.current = None;
    79	    }
    80	}

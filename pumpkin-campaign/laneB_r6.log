   807	pub enum StructureInstance {
   808	    /// This chunk is the "owner" of the structure.
   809	    Start(StructurePosition),
   810	    /// This chunk just contains a piece of a structure starting elsewhere.
   811	    /// Stores the `BlockPos` of the 'Start' so you can look it up.
   812	    Reference(Arc<Mutex<StructurePiecesCollector>>),
   813	}

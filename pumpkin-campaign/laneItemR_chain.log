    23	/// `ServerGamePacketListenerImpl.handleUseItemOn`'s hit-location guard
    24	/// (ServerGamePacketListenerImpl.java:1346-1348): the packet carries the hit point relative to
    25	/// the block, so vanilla accepts only points within 1.0000001 of the block centre on every axis.
    26	fn valid_block_hit_cursor(cursor_pos: &Vector3<f32>) -> bool {
    27	    const LIMIT: f64 = 1.0000001;
    28	
    29	    (f64::from(cursor_pos.x) - 0.5).abs() < LIMIT
    30	        && (f64::from(cursor_pos.y) - 0.5).abs() < LIMIT
    31	        && (f64::from(cursor_pos.z) - 0.5).abs() < LIMIT
    32	}

   502	    const fn from_effect(effect: &Effect) -> Self {
   503	        Self {
   504	            particle_id: VarInt(Particle::EntityEffect as i32),
   505	            color: (((if effect.ambient { 38 } else { 255 }) as u32) << 24
   506	                | effect.effect_type.color as u32) as i32,
   507	        }
   508	    }
   509	}

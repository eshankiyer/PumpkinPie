    77	
    78	    pub fn next_id(&self) -> NonZero<i32> {
    79	        // Wraps on overflow, which is what we want.
    80	        let value = self.counter.fetch_add(1, Ordering::Relaxed);
    81	
    82	        // Negative values are invalid; cycle through the positives
    83	        let masked = value & 0x7FFFFFFF;
    84	
    85	        if let Some(id) = NonZero::new(masked as i32) {
    86	            id
    87	        } else {
    88	            // If we fetched 0 or 0x80000000, that's masked out as 0
    89	            // Zero is invalid, so we just ask for the next ID to keep things simple/correct.
    90	            self.next_id()
    91	        }
    92	    }
    93	}

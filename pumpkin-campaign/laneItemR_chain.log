   125	            if let Some(food) = held.get_data_component::<FoodImpl>() {
   126	                if player.abilities.lock().await.invulnerable
   127	                    || food.can_always_eat
   128	                    || player.hunger_manager.level.load() < 20
   129	                {
   130	                    player
   131	                        .living_entity
   132	                        .set_active_hand(hand, held.clone(), held.get_max_use_time())
   133	                        .await;
   134	                }
   135	            } else {
   136	                player
   137	                    .living_entity
   138	                    .set_active_hand(hand, held.clone(), held.get_max_use_time())
   139	                    .await;
   140	            }
   141	        }
   142	        let equipment_slot = held
   143	            .get_data_component::<EquippableImpl>()
   144	            .map(|equippable| equippable.slot.clone());
   145	        if let Some(slot) = equipment_slot {
   146	            // The equipment lock has to be released before touching the hand again:
   147	            // the off hand lives in the same map, so holding it here would deadlock.
   148	            let current_equipped = inventory.entity_equipment.lock().await.get(&slot);
   149	            if current_equipped.are_items_and_components_equal(held) {
   150	                return;
   151	            }
   152	
   153	            player.enqueue_equipment_change(&slot, held).await;
   154	
   155	            let equipped = if current_equipped.is_empty() {
   156	                let equipped = held.clone();
   157	                held.decrement_unless_creative(player.gamemode.load(), 1);
   158	                equipped
   159	            } else {
   160	                std::mem::replace(held, current_equipped)
   161	            };
   162	            inventory.entity_equipment.lock().await.put(&slot, equipped);
   163	            inventory.set_stack_in_hand(hand, held.clone()).await;
   164	        }
   165	    }

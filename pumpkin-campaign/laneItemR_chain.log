   475	
   476	/// Vanilla updates the ambient flag from every active visible effect, including an empty
   477	/// collection (`LivingEntity.java:909-910, 960-967`).
   478	fn all_effects_ambient<'a>(effects: impl Iterator<Item = &'a Effect>) -> bool {
   479	    effects
   480	        .filter(|effect| effect.show_particles)
   481	        .all(|effect| effect.ambient)
   482	}
   483	
   484	impl MetadataSerializer for EffectParticles {
   485	    fn write_metadata(
   486	        &self,
   487	        writer: &mut impl std::io::Write,
   488	        _version: &pumpkin_util::version::JavaMinecraftVersion,
   489	    ) -> Result<(), WritingError> {
   490	        let count = i32::try_from(self.0.len())
   491	            .map_err(|_| WritingError::Message("Too many effect particles".into()))?;
   492	        writer.write_var_int(&VarInt(count))?;
   493	        for particle in &self.0 {
   494	            writer.write_var_int(&particle.particle_id)?;
   495	            writer.write_i32(particle.color)?;
   496	        }
   497	        Ok(())
   498	    }
   499	}

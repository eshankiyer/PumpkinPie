+            || id == Item::MUSHROOM_STEW.id
+            || id == Item::RABBIT_STEW.id
+            || id == Item::SUSPICIOUS_STEW.id => Some(&Item::BOWL),
+        id if id == Item::HONEY_BOTTLE.id || id == Item::POTION.id => {
+            Some(&Item::GLASS_BOTTLE)
+        }
         id if id == Item::MILK_BUCKET.id => Some(&Item::BUCKET),

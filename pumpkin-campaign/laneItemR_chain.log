   298	#[derive(Clone, Debug, PartialEq)]
   299	pub struct ConsumableImpl {
   300	    pub consume_seconds: f32,
   301	    pub animation: ConsumeAnimation,
   302	    pub sound_event: IdOr<SoundEvent>,
   303	    pub consume_particles: bool,
   304	    pub effects: Cow<'static, [ConsumeEffect]>,
   305	}
   306	impl ConsumableImpl {
   307	    pub const fn new(
   308	        consume_seconds: f32,
   309	        animation: ConsumeAnimation,
   310	        sound_event: IdOr<SoundEvent>,
   311	        consume_particles: bool,
   312	        effects: Cow<'static, [ConsumeEffect]>,
   313	    ) -> Self {
   314	        Self {
   315	            consume_seconds,
   316	            animation,
   317	            sound_event,
   318	            consume_particles,
   319	            effects,
   320	        }
   321	    }
   322	    #[must_use]
   323	    pub fn consume_ticks(&self) -> i32 {
   324	        (self.consume_seconds * 20.0) as i32
   325	    }
   326	    pub fn read_data(data: &NbtTag) -> Option<Self> {
   327	        let compound = data.extract_compound()?;
   328	        let consume_seconds = compound.get_float("consume_seconds")?;
   329	        let animation = compound
   330	            .get_string("animation")?
   331	            .parse::<ConsumeAnimation>()
   332	            .ok()?;
   333	        let sound_event = get_idor(compound, "sound", Sound::EntityGenericEat);
   334	        let consume_particles = compound.get_bool("has_consume_particles").unwrap_or(false);
   335	        let opt_list = compound.get_list("on_consume_effects");
   336	        let effects: Cow<'static, [ConsumeEffect]> = if let Some(effect_list) = opt_list {
   337	            effect_list
   338	                .iter()
   339	                .filter_map(ConsumeEffect::read_data)
   340	                .collect()
   341	        } else {
   342	            Cow::Borrowed(&[])
   343	        };
   344	        Some(Self {
   345	            consume_seconds,
   346	            animation,
   347	            sound_event,
   348	            consume_particles,
   349	            effects,
   350	        })
   351	    }
   352	}
   353	impl DataComponentImpl for ConsumableImpl {
   354	    fn write_data(&self) -> NbtTag {
   355	        let mut compound = NbtCompound::new();
   356	        compound.put_float("consume_seconds", self.consume_seconds);
   357	        compound.put_string("animation", self.animation.to_str().to_string());
   358	        put_idor(&mut compound, "sound", &self.sound_event);
   359	        compound.put_bool("has_consume_particles", self.consume_particles);
   360	        let nbt_vec = self.effects.iter().map(|x| x.as_nbt()).collect();
   361	        compound.put_list("on_consume_effects", nbt_vec);
   362	        NbtTag::Compound(compound)
   363	    }
   364	    fn get_hash(&self) -> i32 {
   365	        let mut digest = Digest::new(Crc32Iscsi);
   366	        digest.update(&[2u8]);
   367	        digest.update(&get_f32_hash(self.consume_seconds).to_le_bytes());
   368	        digest.update(&get_i32_hash(self.animation as i32).to_le_bytes());
   369	        digest.update(&get_idor_hash(&self.sound_event).to_be_bytes());
   370	        digest.update(&[self.consume_particles as u8]);
   371	        for effect in self.effects.iter() {
   372	            digest.update(&effect.get_hash().to_le_bytes());
   373	        }
   374	        digest.update(&[3u8]);
   375	        digest.finalize() as i32
   376	    }
   377	    default_impl!(Consumable);
   378	}
   379	impl Hash for ConsumableImpl {
   380	    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
   381	        unsafe { (*(&raw const self.consume_seconds).cast::<u32>()).hash(state) };
   382	    }
   383	}

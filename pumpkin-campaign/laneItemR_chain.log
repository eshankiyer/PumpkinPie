   212	            for (int row = 0; row < 128; row++) {
   213	               for (int column = 0; column < 128; column++) {
   214	                  Holder<Biome> biome = level.getBiome(pos.set((unscaledStartX + column) * scale, 0, (unscaledStartZ + row) * scale));
   215	                  isBiomeWatery[row * 128 + column] = biome.is(BiomeTags.WATER_ON_MAP_OUTLINES);
   216	               }
   217	            }
   218	
   219	            for (int mx = 1; mx < 127; mx++) {
   220	               for (int mz = 1; mz < 127; mz++) {
   221	                  int waterCount = 0;
   222	
   223	                  for (int dx = -1; dx < 2; dx++) {

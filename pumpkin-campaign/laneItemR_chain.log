   259	/// Vanilla `CrossbowItem#getShotPitch` / `#getRandomShotPitch`: the first shot is always 1.0,
   260	/// later shots alternate between a high (0.63) and a low (0.43) offset.
   261	fn crossbow_shot_pitch(index: u32, random_value: f32) -> f32 {
   262	    if index == 0 {
   263	        return 1.0;
   264	    }
   265	    let range_decider = if index & 1 == 1 { 0.63 } else { 0.43 };
   266	    1.0 / random_value.mul_add(0.5, 1.8) + range_decider
   267	}

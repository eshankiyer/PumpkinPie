   349	                *component = Some(DamageImpl { damage }.to_dyn());
   350	                return;
   351	            }
   352	        }
   353	
   354	        self.patch
   355	            .push((DataComponent::Damage, Some(DamageImpl { damage }.to_dyn())));
   356	    }

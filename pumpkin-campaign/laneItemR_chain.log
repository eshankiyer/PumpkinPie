   168	/// vanilla `MaceItem.getAttackDamageBonus`: a tiered formula, not a flat multiplier.
   169	/// 4 per block up to 3 blocks, 2 per block from 3 to 8, then 1 per block beyond that.
   170	pub fn mace_smash_damage_bonus(fall_distance: f64) -> f64 {
   171	    if fall_distance <= 3.0 {
   172	        4.0 * fall_distance
   173	    } else if fall_distance <= 8.0 {
   174	        12.0 + 2.0 * (fall_distance - 3.0)
   175	    } else {
   176	        22.0 + fall_distance - 8.0
   177	    }
   178	}

    98	        // (`Player.java:2023-2026`; `LivingEntity.java:1721-1737`).
    99	        let climbing = player.on_climbable().await;
   100	        let mounted = entity.has_vehicle().await;
   101	        let target_is_living = target.get_living_entity().is_some();
   102	        let movement = entity.velocity.load();
   103	        let movement_speed = player
   104	            .living_entity
   105	            .get_attribute_value(&Attributes::MOVEMENT_SPEED);
   106	
   107	        let is_strong = attack_cooldown_progress > 0.9;
   108	        if sprinting && is_strong {
   109	            return Self::Knockback;
   110	        }
   111	
   112	        if is_strong
   113	            && can_critical_attack(
   114	                on_ground,
   115	                fall_distance,
   116	                climbing,
   117	                in_water,
   118	                mobility_restricted,
   119	                mounted,
   120	                target_is_living,
   121	                sprinting,
   122	            )
   123	        {
   124	            return Self::Critical;
   125	        }
   126	
   127	        if can_sweep_attack(
   128	            sword,
   129	            is_strong,
   130	            on_ground,
   131	            movement.horizontal_length_squared(),
   132	            movement_speed,
   133	        ) && !is_bedrock
   134	        {
   135	            return Self::Sweeping;
   136	        }
   137	
   138	        if is_strong { Self::Strong } else { Self::Weak }
   139	    }
   140	}

   142	/// Scales a knockback `strength` by a living entity's knockback resistance,
   143	/// mirroring vanilla `LivingEntity.knockback`: `strength *= 1.0 - resistance`.
   144	/// A resistance of 1.0 (iron golem, warden, ...) cancels the knockback entirely.
   145	pub fn knockback_after_resistance(strength: f64, resistance: f64) -> f64 {
   146	    strength * (1.0 - resistance)
   147	}
   148	
   149	pub fn handle_knockback(attacker: &Entity, victim: &dyn EntityBase, strength: f64) {
   150	    let resistance = victim.get_living_entity().map_or(0.0, |living| {
   151	        living.get_attribute_value(&Attributes::KNOCKBACK_RESISTANCE)
   152	    });
   153	    let strength = knockback_after_resistance(strength * 0.5, resistance);
   154	
   155	    if strength > 0.0 {
   156	        let yaw = attacker.yaw.load();
   157	        victim.get_entity().knockback(
   158	            strength,
   159	            f64::from((yaw.to_radians()).sin()),
   160	            f64::from(-(yaw.to_radians()).cos()),
   161	        );
   162	    }
   163	
   164	    let velocity = attacker.velocity.load();
   165	    attacker.velocity.store(velocity.multiply(0.6, 1.0, 0.6));
   166	}

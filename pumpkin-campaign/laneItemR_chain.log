   178	        // TODO: Apply fishing rod durability on retrieval based on catch type.
   179	        let mut fish_event = PlayerFishEvent::new(
   180	            player.clone(),
   181	            None,
   182	            uuid::Uuid::nil(),
   183	            String::new(),
   184	            PlayerFishState::Fishing,
   185	            hand,
   186	            0,
   187	        );
   188	        server.plugin_manager.fire(server, &mut fish_event).await;
   189	        !fish_event.cancelled
   190	    }
   191	}

   182	        let to_get_id = T::get_enum();
   183	        if let Some(index) = self.patch.iter().position(|(id, _)| *id == to_get_id) {
   184	            return self.patch[index]
   185	                .1
   186	                .as_mut()
   187	                .map(|component| get_mut::<T>(component.as_mut()));
   188	        }

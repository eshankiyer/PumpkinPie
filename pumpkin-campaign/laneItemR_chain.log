   179	    fn on_use_tick<'a>(
   180	        &'a self,
   181	        _stack: &'a ItemStack,
   182	        player: &'a Player,
   183	        remaining_use_ticks: i32,
   184	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   185	        Box::pin(async move {
   186	            let stack = player.inventory().held_item().await;
   187	
   188	            // Already loaded: vanilla's `isCharged` check (CrossbowItem.java:222) stops the
   189	            // loading branch, and the start/mid sounds only fire once per use anyway.
   190	            if stack
   191	                .get_data_component::<ChargedProjectilesImpl>()
   192	                .is_some_and(|charged| !charged.projectiles.is_empty())
   193	            {
   194	                return;
   195	            }
   196	
   197	            let charge_duration = charge_duration_ticks(&stack);
   198	            if charge_duration == 0 {
   199	                return;
   200	            }
   201	
   202	            let held_ticks = 72000 - remaining_use_ticks;
   203	            let (start_sound, mid_sound, end_sound) = charging_sounds(&stack);
   204	
   205	            // Vanilla `CrossbowItem#onUseTick` (CrossbowItem.java:202-238): the charging
   206	            // progress is `(useDuration - ticksRemaining) / chargeDuration`, with sounds at
   207	            // START_SOUND_PERCENT 0.2 and MID_SOUND_PERCENT 0.5 played exactly once per use.
   208	            // Held ticks increase by one each tick, so "first tick at or past a threshold"
   209	            // equals the smallest tick count reaching it: ceil(threshold * duration).
   210	            let start_at = (0.2 * charge_duration as f32).ceil() as i32;
   211	            let mid_at = (0.5 * charge_duration as f32).ceil() as i32;
   212	
   213	            if held_ticks == start_at
   214	                && let Some(sound) = start_sound
   215	            {
   216	                player.world().play_sound_fine(
   217	                    sound,
   218	                    SoundCategory::Players,
   219	                    &player.position(),
   220	                    0.5,
   221	                    1.0,
   222	                );
   223	            }
   224	            if held_ticks == mid_at
   225	                && let Some(sound) = mid_sound
   226	            {
   227	                player.world().play_sound_fine(
   228	                    sound,
   229	                    SoundCategory::Players,
   230	                    &player.position(),
   231	                    0.5,
   232	                    1.0,
   233	                );
   234	            }
   235	
   236	            if held_ticks >= charge_duration {
   237	                // Vanilla CrossbowItem.java:222-236: loading at full charge; the
   238	                // loading-end sound inside is gated on the load succeeding.
   239	                Self::try_load_projectiles(player, end_sound).await;
   240	            }
   241	        })
   242	    }

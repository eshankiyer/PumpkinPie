    71	    pub async fn new(
    72	        player: &Player,
    73	        target: &dyn EntityBase,
    74	        attack_cooldown_progress: f32,
    75	    ) -> Self {
    76	        let entity = &player.get_entity();
    77	
    78	        let sprinting = entity.is_sprinting();
    79	        let on_ground = entity.on_ground.load(Ordering::Relaxed);
    80	        let fall_distance = player.living_entity.fall_distance.load();
    81	        let held_item = player.inventory().held_item().await;
    82	        let is_mace = held_item.item.id == pumpkin_data::item::Item::MACE.id;
    83	
    84	        if is_mace && !on_ground && fall_distance > 1.5 && !entity.is_fall_flying() {
    85	            return Self::MaceSmash;
    86	        }
    87	
    88	        let sword = held_item.is_sword();
    89	        let is_bedrock = matches!(player.client.as_ref(), ClientPlatform::Bedrock(_));
    90	
    91	        let in_water = player.living_entity.is_in_water();
    92	        let mobility_restricted = player
    93	            .living_entity
    94	            .get_effect(&pumpkin_data::effect::StatusEffect::BLINDNESS)
    95	            .await
    96	            .is_some();

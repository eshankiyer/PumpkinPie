   189	   public InteractionResult use(final Level level, final Player player, final InteractionHand hand) {
   190	      ItemStack stack = player.getItemInHand(hand);
   191	      Consumable consumable = stack.get(DataComponents.CONSUMABLE);
   192	      if (consumable != null) {
   193	         return consumable.startConsuming(player, stack, hand);
   194	      } else {
   195	         Equippable equippable = stack.get(DataComponents.EQUIPPABLE);
   196	         if (equippable != null && equippable.swappable()) {
   197	            return equippable.swapWithEquipmentSlot(stack, player);
   198	         } else if (stack.has(DataComponents.BLOCKS_ATTACKS)) {
   199	            player.startUsingItem(hand);
   200	            return InteractionResult.CONSUME;
   201	         } else {
   202	            KineticWeapon kineticWeapon = stack.get(DataComponents.KINETIC_WEAPON);
   203	            if (kineticWeapon != null) {
   204	               player.startUsingItem(hand);
   205	               kineticWeapon.makeSound(player);
   206	               return InteractionResult.CONSUME;
   207	            } else {
   208	               return InteractionResult.PASS;
   209	            }
   210	         }
   211	      }
   212	   }

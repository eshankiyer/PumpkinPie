   162	                .is_some_and(|charged| !charged.projectiles.is_empty())
   163	            {
   164	                player.living_entity.clear_active_hand().await;
   165	                return;
   166	            }
   167	
   168	            let use_ticks = player.living_entity.item_use_time.load(Ordering::Relaxed);
   169	            let use_ticks = 72000 - use_ticks;
   170	
   171	            if use_ticks >= charge_duration_ticks(&stack) {

   200	   public static void renderBiomePreviewMap(final ServerLevel level, final ItemStack mapItemStack) {
   201	      MapItemSavedData data = getSavedData(mapItemStack, level);
   202	      if (data != null) {
   203	         if (level.dimension() == data.dimension) {
   204	            int scale = 1 << data.scale;
   205	            int centerX = data.centerX;
   206	            int centerZ = data.centerZ;
   207	            boolean[] isBiomeWatery = new boolean[16384];
   208	            int unscaledStartX = centerX / scale - 64;
   209	            int unscaledStartZ = centerZ / scale - 64;

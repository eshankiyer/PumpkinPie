   109	    async fn prepare_hand_item_for_use(
   110	        &self,
   111	        player: &Arc<Player>,
   112	        hand: Hand,
   113	        held: &mut ItemStack,
   114	    ) {
   115	        let inventory = player.inventory();
   116	
   117	        if held.get_data_component::<ConsumableImpl>().is_some()
   118	            || held.get_data_component::<BlocksAttacksImpl>().is_some()
   119	        {
   120	            // If its food we want to make sure we can actually consume it
   121	            if let Some(food) = held.get_data_component::<FoodImpl>() {
   122	                if player.abilities.lock().await.invulnerable
   123	                    || food.can_always_eat
   124	                    || player.hunger_manager.level.load() < 20
   125	                {
   126	                    player
   127	                        .living_entity
   128	                        .set_active_hand(hand, held.clone(), held.get_max_use_time())
   129	                        .await;
   130	                }
   131	            } else {
   132	                player
   133	                    .living_entity
   134	                    .set_active_hand(hand, held.clone(), held.get_max_use_time())
   135	                    .await;
   136	            }
   137	        }
   138	        let equipment_slot = held
   139	            .get_data_component::<EquippableImpl>()
   140	            .map(|equippable| equippable.slot.clone());
   141	        if let Some(slot) = equipment_slot {
   142	            // The equipment lock has to be released before touching the hand again:
   143	            // the off hand lives in the same map, so holding it here would deadlock.
   144	            let current_equipped = inventory.entity_equipment.lock().await.get(&slot);
   145	            if current_equipped.are_items_and_components_equal(held) {
   205	            inventory.get_selected_slot() as usize
   206	        } else {
   207	            PlayerInventory::OFF_HAND_SLOT
   208	        };
   209	
   210	        if item.is_empty() {
   211	            // TODO item cool down
   212	            // If the hand is empty we stop here
   213	            return Ok(());
   214	        }
   215	
   216	        let before = item.clone();
   217	
   218	        // Vanilla `ItemStack.useOn` checks `canPlaceOnBlockInAdventureMode` before dispatching
   219	        // to the item (`ItemStack.java:357-365`); `ServerPlayerGameMode.useItemOn` reaches this
   220	        // fallback after block interaction (`ServerPlayerGameMode.java:386-395`).
   221	        if player.gamemode.load() == GameMode::Adventure
   222	            && !player.abilities.lock().await.allow_modify_world
   223	            && !item.can_place_on_block_in_adventure_mode(block, world.get_block_state(&position))
   224	        {
   225	            return Ok(());
   226	        }
   227	
   228	        // `AxeItem.useOn` (`AxeItem.java:64-66`) passes when the main-hand axe is
   229	        // blocked by an off-hand item with `BLOCKS_ATTACKS`, unless secondary use is active.
   230	        if axe_use_blocked_by_offhand(hand, &item, &off_hand_item, sneaking) {
   231	            return Ok(());
   232	        }
   233	
   234	        server
   235	            .item_registry
   236	            .use_on_block(&mut item, player, position, face, cursor_pos, block, server)
   237	            .await;
   238	
   239	        // Check if the item is a block, because not every item can be placed :D
   240	        let item_id = item.item.id;
   241	        if let Some(block) = Block::from_item_id(item_id) {
   242	            should_try_decrement = self
   243	                .run_is_block_place(player, block, server, use_item_on, position, face)
   244	                .await?;
   245	        }
   246	
   247	        if should_try_decrement {
   248	            // TODO: Config
   249	            // Decrease block count
   250	            if player.gamemode.load() != GameMode::Creative {
   251	                item.decrement(1);
   252	            }
   253	        }
   254	
   255	        let after = item.clone();
   256	
   257	        // NOTE: the equipment-break entity status (item_break sound/particles) is NOT
   258	        // broadcast here. A stack reaching zero via placement/consumption (spawn eggs,
   259	        // the last block in a stack, ...) is not the same event as a damageable item's
   260	        // durability reaching zero -- vanilla only plays the break effect for the latter.
   261	        // Actual tool-durability breakage already broadcasts this status correctly,
   262	        // gated on `DamageResult::Broken`, in `Player::damage_item_in_slot`.
   263	
   264	        if !after.are_equal(&before) {
   265	            player.sync_hand_slot(slot_index, after.clone()).await;
   266	            inventory.set_stack_in_hand(hand, after).await;
   267	        }
   268	
   269	        Ok(())
   270	    }

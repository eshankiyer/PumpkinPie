   502	            .component(
   503	               DataComponents.KINETIC_WEAPON,
   504	               new KineticWeapon(
   505	                  10,
   506	                  (int)(delay * 20.0F),
   507	                  KineticWeapon.Condition.ofAttackerSpeed((int)(dismountTime * 20.0F), dismountThreshold),
   508	                  KineticWeapon.Condition.ofAttackerSpeed((int)(knockbackTime * 20.0F), knockbackThreshold),
   509	                  KineticWeapon.Condition.ofRelativeSpeed((int)(damageTime * 20.0F), damageThreshold),
   510	                  0.38F,
   511	                  damageMultiplier,
   512	                  Optional.of(material == ToolMaterial.WOOD ? SoundEvents.SPEAR_WOOD_USE : SoundEvents.SPEAR_USE),
   513	                  Optional.of(material == ToolMaterial.WOOD ? SoundEvents.SPEAR_WOOD_HIT : SoundEvents.SPEAR_HIT)
   514	               )
   515	            )
   516	            .component(
   517	               DataComponents.PIERCING_WEAPON,
   518	               new PiercingWeapon(
   519	                  true,
   520	                  false,
   521	                  Optional.of(material == ToolMaterial.WOOD ? SoundEvents.SPEAR_WOOD_ATTACK : SoundEvents.SPEAR_ATTACK),
   522	                  Optional.of(material == ToolMaterial.WOOD ? SoundEvents.SPEAR_WOOD_HIT : SoundEvents.SPEAR_HIT)
   523	               )
   524	            )
   525	            .component(DataComponents.ATTACK_RANGE, new AttackRange(2.0F, 4.5F, 2.0F, 6.5F, 0.125F, 0.5F))
   526	            .component(DataComponents.MINIMUM_ATTACK_CHARGE, 1.0F)
   527	            .component(DataComponents.SWING_ANIMATION, new SwingAnimation(SwingAnimationType.STAB, (int)(attackDuration * 20.0F)))
   528	            .attributes(
   529	               ItemAttributeModifiers.builder()
   530	                  .add(
   531	                     Attributes.ATTACK_DAMAGE,
   532	                     new AttributeModifier(Item.BASE_ATTACK_DAMAGE_ID, 0.0F + material.attackDamageBonus(), AttributeModifier.Operation.ADD_VALUE),
   533	                     EquipmentSlotGroup.MAINHAND
   534	                  )
   535	                  .add(
   536	                     Attributes.ATTACK_SPEED,
   537	                     new AttributeModifier(Item.BASE_ATTACK_SPEED_ID, 1.0F / attackDuration - 4.0, AttributeModifier.Operation.ADD_VALUE),
   538	                     EquipmentSlotGroup.MAINHAND
   539	                  )
   540	                  .build()
   541	            )
   542	            .component(DataComponents.USE_EFFECTS, new UseEffects(true, false, 1.0F))
   543	            .component(DataComponents.WEAPON, new Weapon(1));
   544	      }

   903	    #[must_use]
   904	    pub fn get_speed(&self, block: &'static Block) -> f32 {
   905	        // No tool? Use default speed
   906	        if let Some(tool) = self.get_data_component::<ToolImpl>() {
   907	            for rule in tool.rules.iter() {
   908	                // Skip if speed is not set
   909	                let Some(speed) = rule.speed else {
   910	                    continue;
   911	                };
   912	                match &rule.blocks {
   913	                    IDSet::Tag(tag) => {
   914	                        if block.is_tagged_with(tag).unwrap_or(false) {
   915	                            return speed;
   916	                        }

   680	      private DataComponentInitializers.Initializer<Item> finalizeInitializer(final Component name, final Identifier model) {
   681	         return this.componentInitializer
   682	            .andThen((components, context, key) -> components.set(DataComponents.ITEM_NAME, name).set(DataComponents.ITEM_MODEL, model).addValidator(c -> {
   683	               if (c.has(DataComponents.DAMAGE) && c.getOrDefault(DataComponents.MAX_STACK_SIZE, 1) > 1) {
   684	                  throw new IllegalStateException("Item cannot have both durability and be stackable");
   685	               }
   686	            }));
   687	      }

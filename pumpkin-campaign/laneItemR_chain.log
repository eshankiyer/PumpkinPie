   100	
   101	static ITEM_STACK_ID_GEN: ItemStackIdGenerator = ItemStackIdGenerator::new();
   102	
   103	impl ItemStack {
   104	    #[must_use]
   105	    pub fn new(item_count: u8, item: &'static Item) -> Self {
   106	        let patch = if item.id == Item::POTION.id {
   107	            // `PotionItem.getDefaultInstance` installs `PotionContents(Potions.WATER)`
   108	            // (`PotionItem.java:28-32`). The generated item table carries the empty
   109	            // component shape, so new stacks need this item-specific default overlay.
   110	            vec![(
   111	                DataComponent::PotionContents,
   112	                Some(Box::new(PotionContentsImpl {
   113	                    potion_id: Some(crate::potion::Potion::WATER.id as i32),
   114	                    custom_color: None,
   115	                    custom_effects: Vec::new(),
   116	                    custom_name: None,
   117	                }) as Box<dyn DataComponentImpl>),
   118	            )]
   119	        } else {
   120	            Vec::new()
   121	        };
   122	        Self {
   123	            item_count,
   124	            item,
   125	            patch,
   126	
   127	            uid: ITEM_STACK_ID_GEN.next_id(),
   128	        }
   129	    }
   130	
   131	    #[must_use]
   132	    pub fn new_with_component(
   133	        item_count: u8,
   134	        item: &'static Item,
   135	        component: Vec<(DataComponent, Option<Box<dyn DataComponentImpl>>)>,
   136	    ) -> Self {
   137	        Self {
   138	            item_count,
   139	            item,
   140	            patch: component,
   141	
   142	            uid: ITEM_STACK_ID_GEN.next_id(),
   143	        }
   144	    }
   145	
   146	    /// Ignore the Bedrock UID for this `ItemStack`.
   147	    /// This constructor is intended for Java-only item stacks, where the network UID
   148	    /// is not required.
   149	    #[must_use]
   150	    pub const fn static_new_java(item_count: u8, item: &'static Item) -> Self {
   151	        Self {
   152	            item_count,
   153	            item,
   154	            patch: Vec::new(),
   155	
   156	            uid: match NonZero::new(1) {
   157	                Some(v) => v,
   158	                None => panic!("1 is non-zero"),
   159	            },
   160	        }
   161	    }
   162	
   163	    #[must_use]
   164	    pub fn get_data_component<T: DataComponentImpl + 'static>(&self) -> Option<&T> {
   165	        let to_get_id = &T::get_enum();
   166	        for (id, component) in &self.patch {
   167	            if id == to_get_id {
   168	                return component
   169	                    .as_ref()

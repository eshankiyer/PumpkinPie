   167	    async fn should_continue_use_after_fish_event(
   168	        &self,
   169	        server: &Arc<Server>,
   170	        player: &Arc<Player>,
   171	        hand: Hand,
   172	        item_for_use: &Item,
   173	    ) -> bool {

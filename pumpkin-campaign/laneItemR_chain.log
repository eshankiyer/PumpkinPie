   228	                     }
   229	                  }
   230	
   231	                  MapColor.Brightness brightness = MapColor.Brightness.LOWEST;
   232	                  MapColor newColor = MapColor.NONE;
   233	                  if (isBiomeWatery(isBiomeWatery, mx, mz)) {
   234	                     newColor = MapColor.COLOR_ORANGE;
   235	                     if (waterCount > 7 && mz % 2 == 0) {
   236	                        switch ((mx + (int)(Mth.sin(mz + 0.0F) * 7.0F)) / 8 % 5) {
   237	                           case 0:
   238	                           case 4:
   239	                              brightness = MapColor.Brightness.LOW;
   240	                              break;
   241	                           case 1:
   242	                           case 3:
   243	                              brightness = MapColor.Brightness.NORMAL;
   244	                              break;

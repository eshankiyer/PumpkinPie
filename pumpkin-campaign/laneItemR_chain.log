   387	#[derive(Clone, PartialEq)]
   388	pub struct ToolImpl {
   389	    pub rules: Cow<'static, [ToolRule]>,
   390	    pub default_mining_speed: f32,
   391	    pub damage_per_block: u32,
   392	    pub can_destroy_blocks_in_creative: bool,
   393	}
   394	impl ToolImpl {
   395	    pub fn read_data(data: &NbtTag) -> Option<Self> {
   396	        let compound = data.extract_compound()?;
   397	        let mut rules = Vec::new();
   398	        if let Some(list) = compound.get_list("rules") {
   399	            for rule_tag in list {
   400	                if let Some(rule_compound) = rule_tag.extract_compound()
   401	                    && let Some(blocks_tag) = rule_compound.get("blocks")
   402	                    && let Some(blocks) = IDSet::<Block>::read(blocks_tag)
   403	                {
   404	                    rules.push(ToolRule {
   405	                        blocks,
   406	                        speed: rule_compound.get_float("speed"),
   407	                        correct_for_drops: rule_compound.get_bool("correct_for_drops"),
   408	                    });
   409	                }
   410	            }
   411	        }
   412	        let default_mining_speed = compound.get_float("default_mining_speed").unwrap_or(1.0);
   413	        let damage_per_block = compound.get_int("damage_per_block").unwrap_or(1).max(0) as u32;
   414	        let can_destroy_blocks_in_creative = compound
   415	            .get_bool("can_destroy_blocks_in_creative")
   416	            .unwrap_or(true);
   417	        Some(Self {
   418	            rules: Cow::Owned(rules),
   419	            default_mining_speed,
   420	            damage_per_block,
   421	            can_destroy_blocks_in_creative,
   422	        })
   423	    }
   424	}
   425	impl DataComponentImpl for ToolImpl {
   426	    fn write_data(&self) -> NbtTag {
   427	        let mut compound = NbtCompound::new();
   428	        let mut rules_list = Vec::new();
   429	        for rule in self.rules.iter() {
   430	            let mut rule_compound = NbtCompound::new();
   431	            rule.blocks.write(&mut rule_compound, "blocks");
   432	            if let Some(speed) = rule.speed {
   433	                rule_compound.put_float("speed", speed);
   434	            }
   435	            if let Some(correct_for_drops) = rule.correct_for_drops {
   436	                rule_compound.put_bool("correct_for_drops", correct_for_drops);
   437	            }
   438	            rules_list.push(NbtTag::Compound(rule_compound));
   439	        }
   440	        compound.put_list("rules", rules_list);
   441	        compound.put_float("default_mining_speed", self.default_mining_speed);
   442	        compound.put_int("damage_per_block", self.damage_per_block as i32);
   443	        compound.put_bool(
   444	            "can_destroy_blocks_in_creative",
   445	            self.can_destroy_blocks_in_creative,
   446	        );
   447	        NbtTag::Compound(compound)
   448	    }
   449	    default_impl!(Tool);
   450	}

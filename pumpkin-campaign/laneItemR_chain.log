use crate::entity::player::Player;
use crate::world::World;
use dashmap::DashMap;
use pumpkin_data::data_component::DataComponent;
use pumpkin_data::data_component_impl::{
    DataComponentImpl, MapIdImpl, MapPostProcessing, MapPostProcessingImpl,
};

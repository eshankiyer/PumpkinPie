   106	            -yaw_rad.sin() * pitch_rad.cos() * block_interaction_range,
   107	            -pitch_rad.sin() * block_interaction_range,
   108	            pitch_rad.cos() * yaw_rad.cos() * block_interaction_range,
   109	        );

    59	    }
    60	
    61	    /// `CopperGolemStatueBlockEntity.createStatue`: vanilla additionally persists the
    62	    /// golem's custom name into the block entity's `CUSTOM_NAME` component. Deferred here --
    63	    /// `CopperGolemEntity` has no custom-name field wired up yet, so there is nothing to
    64	    /// carry over. Kept as a named call site so that wiring shows up as a one-line change.
    65	    pub const fn create_statue(&self) {}
    66	
    67	    /// `CopperGolemStatueBlockEntity.removeStatue` + `initCopperGolem`: spawns a fresh
    68	    /// (`UNAFFECTED`) copper golem at this position, facing the direction the statue block
    69	    /// was facing, and removes the statue block.
    70	    ///
    71	    /// Callers must first check `WeatheringCopperGolemStatueBlock.useItemOn`'s condition
    72	    /// (an axe used on a statue whose weathering stage is `UNAFFECTED`, i.e. the unwaxed
    73	    /// `minecraft:copper_golem_statue` alone) -- this method performs the conversion
    74	    /// unconditionally once called. `CopperGolemStatueBlock::use_with_item` is that caller.
    75	    ///
    76	    /// `waterlogged` mirrors `Level.removeBlock(pos, false)`, which replaces the block with
    77	    /// `getFluidState(pos).createLegacyBlock()`: a waterlogged statue leaves a water source
    78	    /// behind, not air.
    79	    pub async fn remove_statue(
    80	        &self,
    81	        world: &Arc<World>,
    82	        facing: HorizontalFacing,
    83	        waterlogged: bool,
    84	    ) {
    85	        let pos = self.position;
    86	        let center = Vector3::new(
    87	            f64::from(pos.0.x) + 0.5,
    88	            f64::from(pos.0.y),
    89	            f64::from(pos.0.z) + 0.5,
    90	        );
    91	
    92	        let entity = Entity::new(world.clone(), center, &EntityType::COPPER_GOLEM);
    93	        let yaw = horizontal_facing_to_yaw(facing);
    94	        entity.yaw.store(yaw);
    95	        entity.head_yaw.store(yaw);
    96	
    97	        let golem = CopperGolemEntity::new(entity);
    98	        world.spawn_entity(golem).await;
    99	
   100	        let remaining = if waterlogged {
   101	            Block::WATER.default_state.id
   102	        } else {
   103	            Block::AIR.default_state.id
   104	        };
   105	        world
   106	            .set_block_state(&pos, remaining, BlockFlags::NOTIFY_ALL)
   107	            .await;
   108	    }
   109	}
   110	
   111	/// Inverse of `Entity::get_horizontal_facing`'s `floor(yaw / 90 + 0.5) & 3` mapping.
   112	const fn horizontal_facing_to_yaw(facing: HorizontalFacing) -> f32 {
   113	    match facing {
   114	        HorizontalFacing::South => 0.0,
   115	        HorizontalFacing::West => 90.0,
   116	        HorizontalFacing::North => 180.0,
   117	        HorizontalFacing::East => 270.0,
   118	    }
   119	}

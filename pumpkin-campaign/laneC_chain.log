   841	   private static boolean checkScore(final CommandContext<CommandSourceStack> context, final MinMaxBounds.Ints range) throws CommandSyntaxException {
   842	      ScoreHolder target = ScoreHolderArgument.getName(context, "target");
   843	      Objective targetObjective = ObjectiveArgument.getObjective(context, "targetObjective");
   844	      Scoreboard scoreboard = context.getSource().getServer().getScoreboard();
   845	      ReadOnlyScoreInfo scoreInfo = scoreboard.getPlayerScoreInfo(target, targetObjective);
   846	      return scoreInfo == null ? false : range.matches(scoreInfo.value());
   847	   }

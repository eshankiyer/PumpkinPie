    38	fn execute_as_modifier<'a>(
    39	    context: &'a CommandContext,
    40	) -> crate::command::node::RedirectModifierResult<'a> {
    41	    Box::pin(async move {
    42	        let targets = EntityArgumentType::get_optional_entities(context, "targets").await?;
    43	        let mut sources = Vec::new();
    44	        for target in targets {
    45	            let mut source = context.source.as_ref().clone();
    46	            let display_name = target.get_display_name().await;
    47	            let name = target.get_name().get_text();
    48	            source.entity = Some(target.clone());
    49	            source.name = name;
    50	            source.display_name = display_name;
    51	            sources.push(Arc::new(source));
    52	        }
    53	        Ok(sources)
    54	    })
    55	}

     7	// getWalkTargetValue implementation. Keep that calculation local until the
     8	// generic PathfinderMob value is ported for every mob type.
     9	
    10	use std::sync::atomic::Ordering::Relaxed;
    11	
    12	use super::{Controls, Goal, GoalFuture};
    13	use crate::entity::ai::pathfinder::NavigatorGoal;
    14	use crate::entity::mob::Mob;
    15	use pumpkin_util::math::vector3::Vector3;
    16	use rand::RngExt;
    17	
    18	const SEARCH_RANGE: i32 = 10;
    19	const SEARCH_HEIGHT: i32 = 3;
    20	const SEARCH_ATTEMPTS: usize = 10;
    21	const BRIGHT_OUTSIDE_THRESHOLD: u8 = 4;
    22	
    23	/// Vanilla `Monster#getWalkTargetValue` delegates to
    24	/// `LevelReader#getPathfindingCostFromLightLevels` and negates the result.
    25	fn monster_walk_target_value(
    26	    world: &crate::world::World,
    27	    pos: &pumpkin_util::math::position::BlockPos,
    28	) -> f32 {
    29	    let brightness = f32::from(world.get_max_local_raw_brightness(pos)) / 15.0;
    30	    let curved_brightness = brightness / (4.0 - 3.0 * brightness);
    31	    let light_value = curved_brightness + world.dimension.ambient_light * (1.0 - curved_brightness);
    32	    -(light_value - 0.5)
    33	}

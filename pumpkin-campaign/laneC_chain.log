     1	use crate::{generation::proto_chunk::GenerationCache, world::WorldPortalExt};
     2	use pumpkin_data::{BlockDirection, tag};
     3	use pumpkin_util::{
     4	    math::position::BlockPos,
     5	    random::{RandomGenerator, RandomImpl},
     6	};
     7	
     8	use super::{CoralFeature, shuffle};
     9	
    10	pub struct CoralTreeFeature;
    11	
    12	impl CoralTreeFeature {
    13	    #[allow(clippy::too_many_arguments)]
    14	    pub fn generate<T: GenerationCache>(
    15	        chunk: &mut T,
    16	        block_registry: &dyn WorldPortalExt,
    17	        _min_y: i8,
    18	        _height: u16,
    19	        _feature: pumpkin_data::placed_feature::PlacedFeature, // This placed feature
    20	        random: &mut RandomGenerator,
    21	        pos: BlockPos,
    22	    ) -> bool {
    23	        // First lets get a random coral
    24	        let block = CoralFeature::get_random_tag_entry(tag::Block::MINECRAFT_CORAL_BLOCKS, random);
    25	        let mut pos = pos;
    26	        let trunk_height = random.next_bounded_i32(3) + 1;
    27	        for _ in 0..trunk_height {
    28	            if !CoralFeature::generate_coral_piece(chunk, block_registry, random, block, pos) {
    29	                return true;
    30	            }
    31	            pos = pos.up();
    32	        }
    33	        // CoralTreeFeature.placeFeature: every branch starts over from the top of the trunk --
    34	        // branches radiate from one shared point, they don't chain off each other.
    35	        let trunk_top_pos = pos;
    36	        let branch_count = random.next_bounded_i32(3) + 2;
    37	
    38	        // vanilla takes the first `branch_count` of Plane.HORIZONTAL.shuffledCopy(random):
    39	        // a Fisher-Yates over the horizontal_worldgen() [N, E, S, W] base order that
    40	        // consumes RNG draws.
    41	        let mut directions = BlockDirection::horizontal_worldgen();
    42	        shuffle(&mut directions, random);
    43	        for dir in &directions[..branch_count as usize] {
    44	            pos = trunk_top_pos;
    45	            pos = pos.offset(dir.to_offset());
    46	            let times = random.next_bounded_i32(5) + 2;
    47	            let mut m = 0;
    48	            for n in 0..times {
    49	                if !CoralFeature::generate_coral_piece(chunk, block_registry, random, block, pos) {
    50	                    break;
    51	                }
    52	                pos = pos.up();
    53	                m += 1;
    54	                if n != 0 && (m < 2 || random.next_f32() >= 0.25) {
    55	                    continue;
    56	                }
    57	                pos = pos.offset(dir.to_offset());
    58	                m = 0;
    59	            }
    60	        }
    61	        true
    62	    }
    63	}

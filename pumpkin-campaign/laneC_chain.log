     5	/// Represents an axis-aligned bounding box in 3D space.
     6	#[derive(Clone, Copy, Debug)]
     7	pub struct BoundingBox {
     8	    /// The minimum corner of the box.
     9	    pub min: Vector3<f64>,
    10	    /// The maximum corner of the box.
    11	    pub max: Vector3<f64>,
    12	}
    13	
    14	/// Represents a 2D bounding plane used for collision checks.
    15	#[derive(Clone, Copy, Debug)]
    16	struct BoundingPlane {
    17	    /// The minimum corner of the plane.
    18	    pub min: Vector2<f64>,
    19	    /// The maximum corner of the plane.
    20	    pub max: Vector2<f64>,
    21	}
    22	
    23	impl BoundingPlane {
    24	    /// Checks whether this plane intersects another plane.
    25	    ///
    26	    /// # Arguments
    27	    /// * `other` – The other bounding plane to check against.
    28	    pub fn intersects(&self, other: &Self) -> bool {
    29	        self.min.x < other.max.x
    30	            && self.max.x > other.min.x
    31	            && self.min.y < other.max.y
    32	            && self.max.y > other.min.y
    33	    }
    34	
    35	    /// Projects a 3D bounding box onto a 2D plane by excluding one axis.
    36	    ///
    37	    /// # Arguments
    38	    /// * `bounding_box` – The 3D bounding box to project.
    39	    /// * `excluded` – The axis to exclude from the projection.
    40	    pub const fn from_box(bounding_box: &BoundingBox, excluded: Axis) -> Self {
    41	        let [axis1, axis2] = Axis::excluding(excluded);
    42	
    43	        Self {
    44	            min: Vector2::new(
    45	                bounding_box.get_side(false).get_axis(axis1),
    46	                bounding_box.get_side(false).get_axis(axis2),
    47	            ),
    48	
    49	            max: Vector2::new(
    50	                bounding_box.get_side(true).get_axis(axis1),
    51	                bounding_box.get_side(true).get_axis(axis2),
    52	            ),
    53	        }
    54	    }
    55	}
    56	
    57	impl BoundingBox {
    58	    /// Creates a default bounding box at the origin using entity dimensions.
    59	    ///
    60	    /// # Arguments
    61	    /// * `size` – Dimensions of the entity.
    62	    #[must_use]
    63	    pub fn new_default(size: &EntityDimensions) -> Self {
    64	        Self::new_from_pos(0., 0., 0., size)
    65	    }
    66	
    67	    /// Creates a bounding box from a position and entity dimension.
    68	    ///
    69	    /// # Arguments
    70	    /// * `x` – X coordinate of the position.
    71	    /// * `y` – Y coordinate of the position.
    72	    /// * `z` – Z coordinate of the position.
    73	    /// * `size` – Dimensions of the entity.
    74	    #[must_use]
    75	    pub fn new_from_pos(x: f64, y: f64, z: f64, size: &EntityDimensions) -> Self {
    76	        let f = f64::from(size.width) / 2.;
    77	        Self {
    78	            min: Vector3::new(x - f, y, z - f),
    79	            max: Vector3::new(x + f, y + f64::from(size.height), z + f),
    80	        }
    81	    }
    82	
    83	    /// Expands this box by given amounts along each axis.
    84	    ///
    85	    /// # Arguments
    86	    /// * `x` – Amount to expand along the X axis.
    87	    /// * `y` – Amount to expand along the Y axis.
    88	    /// * `z` – Amount to expand along the Z axis.
    89	    #[must_use]
    90	    pub fn expand(&self, x: f64, y: f64, z: f64) -> Self {
    91	        Self {
    92	            min: Vector3::new(self.min.x - x, self.min.y - y, self.min.z - z),
    93	            max: Vector3::new(self.max.x + x, self.max.y + y, self.max.z + z),
    94	        }
    95	    }
    96	
    97	    /// Expands this bounding box towards a specific direction.
    98	    ///
    99	    /// If a provided value is negative, it extends the minimum boundary along that axis.
   100	    /// If a provided value is positive, it extends the maximum boundary along that axis.
   101	    ///
   102	    /// # Arguments
   103	    /// * `x` – Amount to expand towards on the X axis.
   104	    /// * `y` – Amount to expand towards on the Y axis.
   105	    /// * `z` – Amount to expand towards on the Z axis.
   106	    #[must_use]
   107	    pub fn expand_towards(&self, x: f64, y: f64, z: f64) -> Self {
   108	        let mut min_x = self.min.x;
   109	        let mut min_y = self.min.y;
   110	        let mut min_z = self.min.z;
   111	
   112	        let mut max_x = self.max.x;
   113	        let mut max_y = self.max.y;
   114	        let mut max_z = self.max.z;
   115	
   116	        if x < 0.0 {
   117	            min_x += x;
   118	        } else if x > 0.0 {
   119	            max_x += x;
   120	        }
   121	
   122	        if y < 0.0 {
   123	            min_y += y;
   124	        } else if y > 0.0 {
   125	            max_y += y;
   126	        }
   127	
   128	        if z < 0.0 {
   129	            min_z += z;
   130	        } else if z > 0.0 {
   131	            max_z += z;
   132	        }
   133	
   134	        Self {
   135	            min: Vector3::new(min_x, min_y, min_z),
   136	            max: Vector3::new(max_x, max_y, max_z),
   137	        }
   138	    }
   139	
   140	    /// Expands this box uniformly along all axes.
   141	    ///
   142	    /// # Arguments
   143	    /// * `value` – Amount to expand along all axes.
   144	    #[must_use]
   145	    pub fn expand_all(&self, value: f64) -> Self {
   146	        self.expand(value, value, value)
   147	    }

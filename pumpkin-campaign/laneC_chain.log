   203	    #[must_use]
   204	    pub fn can_fit(&self, candidate: &BlockBox) -> bool {
   205	        is_box_inside(&self.bounds, candidate)
   206	            && !self.occupied.iter().any(|b| boxes_intersect(b, candidate))
   207	    }

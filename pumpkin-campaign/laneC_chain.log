    28	      this.vehicle = input.readVarInt();
    29	      this.passengers = input.readVarIntArray();
    30	   }
    31	
    32	   private void write(final FriendlyByteBuf output) {
    33	      output.writeVarInt(this.vehicle);
    34	      output.writeVarIntArray(this.passengers);
    35	   }
    36	
    37	   @Override
    38	   public PacketType<ClientboundSetPassengersPacket> type() {
    39	      return GamePacketTypes.CLIENTBOUND_SET_PASSENGERS;
    40	   }
    41	
    42	   public void handle(final ClientGamePacketListener listener) {
    43	      listener.handleSetEntityPassengersPacket(this);
    44	   }

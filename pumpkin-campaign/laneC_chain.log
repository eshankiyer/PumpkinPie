   877	   private static ArgumentBuilder<CommandSourceStack, ?> addConditional(
   878	      final CommandNode<CommandSourceStack> root,
   879	      final ArgumentBuilder<CommandSourceStack, ?> argument,
   880	      final boolean expected,
   881	      final ExecuteCommand.CommandPredicate predicate
   882	   ) {
   883	      return argument.fork(root, c -> expect(c, expected, predicate.test(c))).executes(c -> {
   884	         if (expected == predicate.test(c)) {
   885	            c.getSource().sendSuccess(() -> Component.translatable("commands.execute.conditional.pass"), false);
   886	            return 1;
   887	         } else {
   888	            throw ERROR_CONDITIONAL_FAILED.create();
   889	         }
   890	      });
   891	   }

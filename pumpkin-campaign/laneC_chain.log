    72	fn format_clickable_list(items: Vec<TextComponent>) -> TextComponent {
    73	    let mut root = TextComponent::empty();
    74	    for (i, item) in items.into_iter().enumerate() {
    75	        if i > 0 {
    76	            root = root.add_child(TextComponent::text(" "));
    77	        }
    78	        let styled = item.color_named(NamedColor::Green);
    79	        let wrapped = styled.wrap_in_square_brackets();
    80	        root = root.add_child(wrapped);
    81	    }
    82	    root
    83	}

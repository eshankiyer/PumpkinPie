    35	pub struct FleeSunGoal {
    36	    speed: f64,
    37	    goal_control: Controls,
    38	    target: Option<Vector3<f64>>,
    39	}
    40	
    41	impl FleeSunGoal {
    42	    #[must_use]
    43	    pub fn new(speed: f64) -> Box<Self> {
    44	        Box::new(Self {
    45	            speed,
    46	            goal_control: Controls::MOVE,
    47	            target: None,
    48	        })
    49	    }
    50	
    51	    fn find_shelter(mob: &dyn Mob) -> Option<Vector3<f64>> {
    52	        let mob_entity = mob.get_mob_entity();
    53	        let entity = &mob_entity.living_entity.entity;
    54	        let world = entity.world.load();
    55	        let current_pos = entity.block_pos.load();
    56	        let mut rng = mob.get_random();
    57	
    58	        for _ in 0..SEARCH_ATTEMPTS {
    59	            // Vanilla: random.nextInt(20) - 10 → range [-10, 9], random.nextInt(6) - 3 → range [-3, 2]
    60	            // Rust half-open ranges: -10..10 and -3..3
    61	            let dx = rng.random_range(-SEARCH_RANGE..SEARCH_RANGE);
    62	            let dy = rng.random_range(-SEARCH_HEIGHT..SEARCH_HEIGHT);
    63	            let dz = rng.random_range(-SEARCH_RANGE..SEARCH_RANGE);
    64	
    65	            let candidate_pos = current_pos.add(dx, dy, dz);
    66	
    67	            // Position must not see the sky (sheltered from sun)
    68	            if world.can_see_sky(&candidate_pos) {
    69	                continue;
    70	            }
    71	
    72	            // Vanilla's skeleton is a Monster, whose getWalkTargetValue is
    73	            // negative when the pathfinding light cost is positive.
    74	            if monster_walk_target_value(&world, &candidate_pos) >= 0.0 {
    75	                continue;
    76	            }
    77	
    78	            return Some(Vector3::new(
    79	                f64::from(candidate_pos.0.x) + 0.5,
    80	                f64::from(candidate_pos.0.y),
    81	                f64::from(candidate_pos.0.z) + 0.5,
    82	            ));
    83	        }
    84	
    85	        None
    86	    }
    87	}

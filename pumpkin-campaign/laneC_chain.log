    34	            level.playSound(player, relativePos, SoundEvents.FLINTANDSTEEL_USE, SoundSource.BLOCKS, 1.0F, level.getRandom().nextFloat() * 0.4F + 0.8F);
    35	            BlockState fireState = BaseFireBlock.getState(level, relativePos);
    36	            level.setBlock(relativePos, fireState, 11);
    37	            level.gameEvent(player, GameEvent.BLOCK_PLACE, pos);
    38	            ItemStack itemStack = context.getItemInHand();
    39	            if (player instanceof ServerPlayer serverPlayer) {
    40	               CriteriaTriggers.PLACED_BLOCK.trigger(serverPlayer, relativePos, itemStack);
    41	               itemStack.hurtAndBreak(1, player, context.getHand().asEquipmentSlot());
    42	            }
    43	
    44	            return InteractionResult.SUCCESS;
    45	         } else {
    46	            return InteractionResult.FAIL;
    47	         }
    48	      } else {
    49	         level.playSound(player, pos, SoundEvents.FLINTANDSTEEL_USE, SoundSource.BLOCKS, 1.0F, level.getRandom().nextFloat() * 0.4F + 0.8F);
    50	         level.setBlock(pos, state.setValue(BlockStateProperties.LIT, true), 11);
    51	         level.gameEvent(player, GameEvent.BLOCK_CHANGE, pos);
    52	         if (player != null) {
    53	            context.getItemInHand().hurtAndBreak(1, player, context.getHand().asEquipmentSlot());
    54	         }

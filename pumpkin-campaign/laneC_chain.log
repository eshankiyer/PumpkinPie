  1019	    /// is not sitting, a killing blow never kills - vanilla resets health to 1 and hands the
  1020	    /// sequence to the DYING phase. Clamping here (rather than letting health go to/below zero
  1021	    /// and reacting afterward, as vanilla's separate `die()` step does) keeps Pumpkin's generic
  1022	    /// death pipeline - which removes a health<=0 entity immediately inside
  1023	    /// `LivingEntity::damage_with_context` rather than after a `death_time` delay like vanilla -
  1024	    /// from deleting the dragon mid-animation, so the dying phase's XP shower and
  1025	    /// `setDragonKilled` still run.
  1026	    fn mob_pre_apply_damage(&self, health: f32, amount: f32) -> EntityBaseFuture<'_, (f32, bool)> {
  1027	        Box::pin(async move {
  1028	            let phase_type = *self.phase.lock().await;
  1029	            if phase_type != EnderDragonPhase::Dying
  1030	                && !phase_type.is_sitting()
  1031	                && amount.is_finite()
  1032	                && health > 0.0
  1033	                && health - amount <= 0.0
  1034	            {

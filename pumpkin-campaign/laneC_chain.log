   920	   private static OptionalInt checkRegions(final CommandContext<CommandSourceStack> context, final boolean skipAir) throws CommandSyntaxException {
   921	      return checkRegions(
   922	         context.getSource().getLevel(),
   923	         BlockPosArgument.getLoadedBlockPos(context, "start"),
   924	         BlockPosArgument.getLoadedBlockPos(context, "end"),
   925	         BlockPosArgument.getLoadedBlockPos(context, "destination"),
   926	         skipAir
   927	      );
   928	   }
   929	
   930	   private static OptionalInt checkRegions(
   931	      final ServerLevel level, final BlockPos startPos, final BlockPos endPos, final BlockPos destPos, final boolean skipAir
   932	   ) throws CommandSyntaxException {
   933	      BoundingBox from = BoundingBox.fromCorners(startPos, endPos);
   934	      BoundingBox destination = BoundingBox.fromCorners(destPos, destPos.offset(from.getLength()));
   935	      BlockPos offset = new BlockPos(destination.minX() - from.minX(), destination.minY() - from.minY(), destination.minZ() - from.minZ());
   936	      long area = (long)from.getXSpan() * from.getYSpan() * from.getZSpan();
   937	      if (area > 32768L) {
   938	         throw ERROR_AREA_TOO_LARGE.create(32768, area);
   939	      }
   940	
   941	      int count = 0;
   942	      RegistryAccess registryAccess = level.registryAccess();
   943	
   944	      try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(LOGGER)) {
   945	         for (int z = from.minZ(); z <= from.maxZ(); z++) {
   946	            for (int y = from.minY(); y <= from.maxY(); y++) {
   947	               for (int x = from.minX(); x <= from.maxX(); x++) {
   948	                  BlockPos sourcePos = new BlockPos(x, y, z);
   949	                  BlockPos destinationPos = sourcePos.offset(offset);
   950	                  BlockState sourceBlock = level.getBlockState(sourcePos);
   951	                  if (!skipAir || !sourceBlock.is(Blocks.AIR)) {
   952	                     if (sourceBlock != level.getBlockState(destinationPos)) {
   953	                        return OptionalInt.empty();
   954	                     }
   955	
   956	                     BlockEntity sourceBlockEntity = level.getBlockEntity(sourcePos);
   957	                     BlockEntity destinationBlockEntity = level.getBlockEntity(destinationPos);
   958	                     if (sourceBlockEntity != null) {
   959	                        if (destinationBlockEntity == null) {
   960	                           return OptionalInt.empty();
   961	                        }
   962	
   963	                        if (destinationBlockEntity.getType() != sourceBlockEntity.getType()) {
   964	                           return OptionalInt.empty();
   965	                        }
   966	
   967	                        if (!sourceBlockEntity.components().equals(destinationBlockEntity.components())) {
   968	                           return OptionalInt.empty();
   969	                        }
   970	
   971	                        TagValueOutput sourceOutput = TagValueOutput.createWithContext(reporter.forChild(sourceBlockEntity.problemPath()), registryAccess);
   972	                        sourceBlockEntity.saveCustomOnly(sourceOutput);
   973	                        CompoundTag sourceTag = sourceOutput.buildResult();
   974	                        TagValueOutput destinationOutput = TagValueOutput.createWithContext(
   975	                           reporter.forChild(destinationBlockEntity.problemPath()), registryAccess
   976	                        );
   977	                        destinationBlockEntity.saveCustomOnly(destinationOutput);
   978	                        CompoundTag destinationTag = destinationOutput.buildResult();
   979	                        if (!sourceTag.equals(destinationTag)) {
   980	                           return OptionalInt.empty();
   981	                        }
   982	                     }
   983	
   984	                     count++;
   985	                  }
   986	               }
   987	            }
   988	         }
   989	      }
   990	
   991	      return OptionalInt.of(count);
   992	   }

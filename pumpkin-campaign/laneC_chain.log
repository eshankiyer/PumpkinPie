   369	    #[must_use]
   370	    pub fn from_block_raw(position: &BlockPos) -> Self {
   371	        let position = position.0;
   372	        Self {
   373	            min: Vector3::new(
   374	                f64::from(position.x),
   375	                f64::from(position.y),
   376	                f64::from(position.z),
   377	            ),
   378	            max: Vector3::new(
   379	                f64::from(position.x),
   380	                f64::from(position.y),
   381	                f64::from(position.z),
   382	            ),
   383	        }
   384	    }

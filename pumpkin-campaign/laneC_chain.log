   386	    /// Checks if this bounding box intersects another bounding box.
   387	    ///
   388	    /// # Arguments
   389	    /// * `other` – The other bounding box to check against.
   390	    #[must_use]
   391	    pub fn intersects(&self, other: &Self) -> bool {
   392	        self.min.x < other.max.x
   393	            && self.max.x > other.min.x
   394	            && self.min.y < other.max.y
   395	            && self.max.y > other.min.y
   396	            && self.min.z < other.max.z
   397	            && self.max.z > other.min.z
   398	    }

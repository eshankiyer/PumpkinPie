   849	   private static boolean checkStopwatch(final CommandContext<CommandSourceStack> context, final MinMaxBounds.Doubles range) throws CommandSyntaxException {
   850	      Identifier id = IdentifierArgument.getId(context, "id");
   851	      Stopwatches stopwatches = context.getSource().getServer().getStopwatches();
   852	      Stopwatch stopwatch = stopwatches.get(id);
   853	      if (stopwatch == null) {
   854	         throw StopwatchCommand.ERROR_DOES_NOT_EXIST.create(id);
   855	      }
   856	
   857	      long currentTime = Stopwatches.currentTime();
   858	      double elapsedSeconds = stopwatch.elapsedSeconds(currentTime);
   859	      return range.matches(elapsedSeconds);
   860	   }

   766	   private static int countItems(final Iterable<? extends SlotProvider> sources, final SlotRange slotRange, final Predicate<ItemStack> predicate) {
   767	      int count = 0;
   768	
   769	      for (SlotProvider slotProvider : sources) {
   770	         IntList slots = slotRange.slots();
   771	
   772	         for (int i = 0; i < slots.size(); i++) {
   773	            int slotId = slots.getInt(i);
   774	            SlotAccess slot = slotProvider.getSlot(slotId);
   775	            if (slot != null) {
   776	               ItemStack contents = slot.get();
   777	               if (predicate.test(contents)) {
   778	                  count += contents.getCount();
   779	               }
   780	            }
   781	         }
   782	      }
   783	
   784	      return count;
   785	   }
   786	
   787	   private static int countItems(final CommandSourceStack source, final BlockPos pos, final SlotRange slotRange, final Predicate<ItemStack> predicate) throws CommandSyntaxException {
   788	      int count = 0;
   789	      Container container = ItemCommands.getContainer(source, pos, ItemCommands.ERROR_SOURCE_NOT_A_CONTAINER);
   790	      int containerSize = container.getContainerSize();
   791	      IntList slots = slotRange.slots();
   792	
   793	      for (int i = 0; i < slots.size(); i++) {
   794	         int slotId = slots.getInt(i);
   795	         if (slotId >= 0 && slotId < containerSize) {
   796	            ItemStack contents = container.getItem(slotId);
   797	            if (predicate.test(contents)) {
   798	               count += contents.getCount();
   799	            }
   800	         }
   801	      }
   802	
   803	      return count;
   804	   }

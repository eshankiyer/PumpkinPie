   400	    /// Computes the squared magnitude from a point to the nearest point on this bounding box.
   401	    ///
   402	    /// # Arguments
   403	    /// * `pos` – The point to measure from.
   404	    #[must_use]
   405	    pub fn squared_magnitude(&self, pos: Vector3<f64>) -> f64 {
   406	        let d = f64::max(f64::max(self.min.x - pos.x, pos.x - self.max.x), 0.0);
   407	        let e = f64::max(f64::max(self.min.y - pos.y, pos.y - self.max.y), 0.0);
   408	        let f = f64::max(f64::max(self.min.z - pos.z, pos.z - self.max.z), 0.0);
   409	
   410	        super::squared_magnitude(d, e, f)
   411	    }
   412	
   413	    /// Computes the squared distance between this bounding box and another bounding box.
   414	    ///
   415	    /// # Arguments
   416	    /// * `other` – The other bounding box to measure the distance to.
   417	    #[must_use]
   418	    pub fn squared_distance_to_box(&self, other: &Self) -> f64 {
   419	        let d = f64::max(
   420	            f64::max(self.min.x - other.max.x, other.min.x - self.max.x),
   421	            0.0,
   422	        );
   423	        let e = f64::max(
   424	            f64::max(self.min.y - other.max.y, other.min.y - self.max.y),
   425	            0.0,
   426	        );
   427	        let f = f64::max(
   428	            f64::max(self.min.z - other.max.z, other.min.z - self.max.z),
   429	            0.0,
   430	        );
   431	
   432	        super::squared_magnitude(d, e, f)
   433	    }
   434	}

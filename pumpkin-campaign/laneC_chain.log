  1126	   private static class ExecuteIfFunctionCustomModifier implements CustomModifierExecutor.ModifierAdapter<CommandSourceStack> {
  1127	      private final IntPredicate check;
  1128	
  1129	      private ExecuteIfFunctionCustomModifier(final boolean check) {
  1130	         this.check = check ? value -> value != 0 : value -> value == 0;
  1131	      }
  1132	
  1133	      public void apply(
  1134	         final CommandSourceStack originalSource,
  1135	         final List<CommandSourceStack> currentSources,
  1136	         final ContextChain<CommandSourceStack> currentStep,
  1137	         final ChainModifiers modifiers,
  1138	         final ExecutionControl<CommandSourceStack> output
  1139	      ) {
  1140	         ExecuteCommand.scheduleFunctionConditionsAndTest(
  1141	            originalSource,
  1142	            currentSources,
  1143	            FunctionCommand::modifySenderForExecution,
  1144	            this.check,
  1145	            currentStep,
  1146	            null,
  1147	            output,
  1148	            c -> FunctionArgument.getFunctions(c, "name"),
  1149	            modifiers
  1150	         );
  1151	      }
  1152	   }

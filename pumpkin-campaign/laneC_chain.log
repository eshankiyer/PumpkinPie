   264	   private static String validatedSubstring(final String input, final int start, final int end) throws CommandSyntaxException {
   265	      if (start >= 0 && end <= input.length() && start <= end) {
   266	         return input.substring(start, end);
   267	      } else {
   268	         throw ERROR_INVALID_SUBSTRING.create(start, end);
   269	      }
   270	   }

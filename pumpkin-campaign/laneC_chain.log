    32	   public void tick(final ServerPlayer player) {
    33	      ServerLevel level = player.level();
    34	      Difficulty difficulty = level.getDifficulty();
    35	      if (this.exhaustionLevel > 4.0F) {
    36	         this.exhaustionLevel -= 4.0F;
    37	         if (this.saturationLevel > 0.0F) {
    38	            this.saturationLevel = Math.max(this.saturationLevel - 1.0F, 0.0F);
    39	         } else if (difficulty != Difficulty.PEACEFUL) {
    40	            this.foodLevel = Math.max(this.foodLevel - 1, 0);
    41	         }
    42	      }
    43	
    44	      boolean naturalRegen = level.getGameRules().get(GameRules.NATURAL_HEALTH_REGENERATION);
    45	      if (naturalRegen && this.saturationLevel > 0.0F && player.isHurt() && this.foodLevel >= 20) {
    46	         this.tickTimer++;
    47	         if (this.tickTimer >= 10) {
    48	            float saturationSpent = Math.min(this.saturationLevel, 6.0F);
    49	            player.heal(saturationSpent / 6.0F);
    50	            this.addExhaustion(saturationSpent);

    28	public class CocoaBlock extends HorizontalDirectionalBlock implements BonemealableBlock {
    29	   public static final MapCodec<CocoaBlock> CODEC = simpleCodec(CocoaBlock::new);
    30	   public static final int MAX_AGE = 2;
    31	   public static final IntegerProperty AGE = BlockStateProperties.AGE_2;
    32	   private static final List<Map<Direction, VoxelShape>> SHAPES = IntStream.rangeClosed(0, 2)
    33	      .mapToObj(i -> Shapes.rotateHorizontal(Block.column(4 + i * 2, 7 - i * 2, 12.0).move(0.0, 0.0, (i - 5) / 16.0).optimize()))
    34	      .toList();
    35	
    36	   @Override
    37	   public MapCodec<CocoaBlock> codec() {
    38	      return CODEC;
    39	   }
    40	
    41	   public CocoaBlock(final BlockBehaviour.Properties properties) {
    42	      super(properties);
    43	      this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH).setValue(AGE, 0));
    44	   }
    45	
    46	   @Override
    47	   protected boolean isRandomlyTicking(final BlockState state) {
    48	      return state.getValue(AGE) < 2;
    49	   }
    50	
    51	   @Override
    52	   protected void randomTick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
    53	      if (level.getRandom().nextInt(5) == 0) {
    54	         int age = state.getValue(AGE);
    55	         if (age < 2) {
    56	            level.setBlock(pos, state.setValue(AGE, age + 1), 2);
    57	         }
    58	      }
    59	   }
    60	
    61	   @Override
    62	   protected boolean canSurvive(final BlockState state, final LevelReader level, final BlockPos pos) {
    63	      BlockState relativeState = level.getBlockState(pos.relative(state.getValue(FACING)));
    64	      return relativeState.is(BlockTags.SUPPORTS_COCOA);
    65	   }
    66	
    67	   @Override
    68	   protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
    69	      return SHAPES.get(state.getValue(AGE)).get(state.getValue(FACING));
    70	   }
    71	
    72	   @Override
    73	   public @Nullable BlockState getStateForPlacement(final BlockPlaceContext context) {
    74	      BlockState state = this.defaultBlockState();
    75	      LevelReader level = context.getLevel();
    76	      BlockPos pos = context.getClickedPos();
    77	
    78	      for (Direction direction : context.getNearestLookingDirections()) {
    79	         if (direction.getAxis().isHorizontal()) {
    80	            state = state.setValue(FACING, direction);
    81	            if (state.canSurvive(level, pos)) {
    82	               return state;
    83	            }
    84	         }
    85	      }
    86	
    87	      return null;
    88	   }
    89	
    90	   @Override
    91	   protected BlockState updateShape(
    92	      final BlockState state,
    93	      final LevelReader level,
    94	      final ScheduledTickAccess ticks,
    95	      final BlockPos pos,
    96	      final Direction directionToNeighbour,
    97	      final BlockPos neighbourPos,
    98	      final BlockState neighbourState,
    99	      final RandomSource random
   100	   ) {
   101	      return directionToNeighbour == state.getValue(FACING) && !state.canSurvive(level, pos)
   102	         ? Blocks.AIR.defaultBlockState()
   103	         : super.updateShape(state, level, ticks, pos, directionToNeighbour, neighbourPos, neighbourState, random);
   104	   }
   105	
   106	   @Override
   107	   public boolean isValidBonemealTarget(final LevelReader level, final BlockPos pos, final BlockState state) {
   108	      return state.getValue(AGE) < 2;
   109	   }
   110	
   111	   @Override
   112	   public boolean isBonemealSuccess(final Level level, final RandomSource random, final BlockPos pos, final BlockState state) {
   113	      return true;
   114	   }
   115	
   116	   @Override
   117	   public void performBonemeal(final ServerLevel level, final RandomSource random, final BlockPos pos, final BlockState state) {
   118	      level.setBlock(pos, state.setValue(AGE, state.getValue(AGE) + 1), 2);
   119	   }
   120	
   121	   @Override
   122	   protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
   123	      builder.add(FACING, AGE);
   124	   }
   125	
   126	   @Override
   127	   protected boolean isPathfindable(final BlockState state, final PathComputationType type) {
   128	      return false;
   129	   }
   130	}


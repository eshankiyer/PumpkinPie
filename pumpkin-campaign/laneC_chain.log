  1057	   public static <T extends ExecutionCommandSource<T>> void scheduleFunctionConditionsAndTest(
  1058	      final T originalSource,
  1059	      final List<T> currentSources,
  1060	      final Function<T, T> functionContextModifier,
  1061	      final IntPredicate check,
  1062	      final ContextChain<T> currentStep,
  1063	      final @Nullable CompoundTag parameters,
  1064	      final ExecutionControl<T> output,
  1065	      final InCommandFunction<CommandContext<T>, Collection<CommandFunction<T>>> functionGetter,
  1066	      final ChainModifiers modifiers
  1067	   ) {
  1068	      List<T> filteredSources = new ArrayList<>(currentSources.size());
  1069	
  1070	      Collection<CommandFunction<T>> functionsToRun;
  1071	      try {
  1072	         functionsToRun = functionGetter.apply(currentStep.getTopContext().copyFor(originalSource));
  1073	      } catch (CommandSyntaxException e) {
  1074	         originalSource.handleError(e, modifiers.isForked(), output.tracer());
  1075	         return;
  1076	      }
  1077	
  1078	      int functionCount = functionsToRun.size();
  1079	      if (functionCount != 0) {
  1080	         List<InstantiatedFunction<T>> instantiatedFunctions = new ArrayList<>(functionCount);
  1081	
  1082	         try {
  1083	            for (CommandFunction<T> function : functionsToRun) {
  1084	               try {
  1085	                  instantiatedFunctions.add(function.instantiate(parameters, originalSource.dispatcher()));
  1086	               } catch (FunctionInstantiationException e) {
  1087	                  throw ERROR_FUNCTION_CONDITION_INSTANTATION_FAILURE.create(function.id(), e.messageComponent());
  1088	               }
  1089	            }
  1090	         } catch (CommandSyntaxException e) {
  1091	            originalSource.handleError(e, modifiers.isForked(), output.tracer());
  1092	         }
  1093	
  1094	         for (T source : currentSources) {
  1095	            T newFunctionContext = (T)functionContextModifier.apply(source.clearCallbacks());
  1096	            CommandResultCallback functionCallback = (success, result) -> {
  1097	               if (check.test(result)) {
  1098	                  filteredSources.add(source);
  1099	               }
  1100	            };
  1101	            output.queueNext(new IsolatedCall<>(o -> {
  1102	               for (InstantiatedFunction<T> function : instantiatedFunctions) {
  1103	                  o.queueNext(new CallFunction<>(function, o.currentFrame().returnValueConsumer(), true).bind(newFunctionContext));
  1104	               }
  1105	
  1106	               o.queueNext(FallthroughTask.instance());
  1107	            }, functionCallback));
  1108	         }
  1109	
  1110	         ContextChain<T> nextStage = currentStep.nextStage();
  1111	         String input = currentStep.getTopContext().getInput();
  1112	         output.queueNext(new BuildContexts.Continuation<>(input, nextStage, modifiers, originalSource, filteredSources));
  1113	      }
  1114	   }

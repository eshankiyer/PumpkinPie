    40	#[expect(clippy::too_many_lines)]
    41	pub fn snbt_colorful_display(tag: &NbtTag, depth: usize) -> Result<TextComponent, String> {
    42	    let folded = TextComponent::text("<...>").color_named(NamedColor::Gray);
    43	    match tag {
    44	        NbtTag::End => Err("Unexpected end tag".into()),
    45	        NbtTag::Byte(value) => {
    46	            let byte_format = TextComponent::text("b").color_named(NamedColor::Red);
    47	            Ok(TextComponent::text(format!("{value}"))
    48	                .color_named(NamedColor::Gold)
    49	                .add_child(byte_format))
    50	        }
    51	        NbtTag::Short(value) => {
    52	            let short_format = TextComponent::text("s").color_named(NamedColor::Red);
    53	            Ok(TextComponent::text(format!("{value}"))
    54	                .color_named(NamedColor::Gold)
    55	                .add_child(short_format))
    56	        }
    57	        NbtTag::Int(value) => {
    58	            Ok(TextComponent::text(format!("{value}")).color_named(NamedColor::Gold))
    59	        }
    60	        NbtTag::Long(value) => {
    61	            let long_format = TextComponent::text("L").color_named(NamedColor::Red);
    62	            Ok(TextComponent::text(format!("{value}"))
    63	                .color_named(NamedColor::Gold)
    64	                .add_child(long_format))
    65	        }
    66	        NbtTag::Float(value) => {
    67	            let float_format = TextComponent::text("f").color_named(NamedColor::Red);
    68	            Ok(TextComponent::text(format!("{value}"))
    69	                .color_named(NamedColor::Gold)
    70	                .add_child(float_format))
    71	        }
    72	        NbtTag::Double(value) => {
    73	            let double_format = TextComponent::text("d").color_named(NamedColor::Red);
    74	            Ok(TextComponent::text(format!("{value}"))
    75	                .color_named(NamedColor::Gold)
    76	                .add_child(double_format))
    77	        }
    78	        NbtTag::ByteArray(value) => {
    79	            let byte_array_format = TextComponent::text("B").color_named(NamedColor::Red);
    80	            let mut content = TextComponent::text("[")
    81	                .add_child(byte_array_format.clone())
    82	                .add_child(TextComponent::text("; "));
    83	
    84	            for (index, byte) in value.iter().take(128).enumerate() {
    85	                content = content
    86	                    .add_child(TextComponent::text(format!("{byte}")))
    87	                    .add_child(byte_array_format.clone());
    88	                if index < value.len() - 1 {
    89	                    content = content.add_child(TextComponent::text(", "));
    90	                }
    91	            }
    92	
    93	            if value.len() > 128 {
    94	                content = content.add_child(folded);
    95	            }
    96	
    97	            content = content.add_child(TextComponent::text("]"));
    98	            Ok(content)
    99	        }
   100	        NbtTag::String(value) => {
   101	            let escaped_value = value
   102	                .replace('"', "\\\"")
   103	                .replace('\\', "\\\\")
   104	                .replace('\n', "\\n")
   105	                .replace('\t', "\\t")
   106	                .replace('\r', "\\r")
   107	                .replace('\x0c', "\\f")
   108	                .replace('\x08', "\\b");
   109	
   110	            Ok(TextComponent::text(format!("\"{escaped_value}\"")).color_named(NamedColor::Green))
   111	        }
   112	        NbtTag::List(value) => {
   113	            if value.is_empty() {
   114	                Ok(TextComponent::text("[]"))
   115	            } else if depth >= 64 {
   116	                Ok(TextComponent::text("[")
   117	                    .add_child(folded)
   118	                    .add_child(TextComponent::text("]")))
   119	            } else {
   120	                let mut content = TextComponent::text("[");
   121	
   122	                for (index, item) in value.iter().take(128).enumerate() {
   123	                    let item_display = snbt_colorful_display(item, depth + 1)
   124	                        .map_err(|string| format!("Error displaying item.[{index}]: {string}"))?;
   125	                    content = content.add_child(item_display);
   126	
   127	                    if index < value.len() - 1 {
   128	                        content = content.add_child(TextComponent::text(", "));
   129	                    }
   130	                }
   131	
   132	                if value.len() > 128 {
   133	                    content = content.add_child(folded);
   134	                }
   135	
   136	                content = content.add_child(TextComponent::text("]"));
   137	                Ok(content)
   138	            }
   139	        }
   140	        NbtTag::Compound(value) => {
   141	            if value.is_empty() {
   142	                Ok(TextComponent::text("{}"))
   143	            } else if depth >= 64 {
   144	                Ok(TextComponent::text("{")
   145	                    .add_child(folded)
   146	                    .add_child(TextComponent::text("}")))
   147	            } else {
   148	                let mut content = TextComponent::text("{");
   149	
   150	                for (index, (key, item)) in value.child_tags.iter().take(128).enumerate() {
   151	                    let item_display = snbt_colorful_display(item, depth + 1)
   152	                        .map_err(|string| format!("Error displaying item.{key}: {string}"))?;
   153	                    content = content
   154	                        .add_child(
   155	                            TextComponent::text(key.to_string()).color_named(NamedColor::Aqua),
   156	                        )
   157	                        .add_child(TextComponent::text(": "))
   158	                        .add_child(item_display);
   159	
   160	                    if index < value.child_tags.len() - 1 {
   161	                        content = content.add_child(TextComponent::text(", "));
   162	                    }
   163	                }
   164	
   165	                if value.child_tags.len() > 128 {
   166	                    content = content.add_child(folded);
   167	                }
   168	
   169	                content = content.add_child(TextComponent::text("}"));
   170	                Ok(content)
   171	            }
   172	        }
   173	        NbtTag::IntArray(value) => {
   174	            let int_array_format = TextComponent::text("I").color_named(NamedColor::Red);
   175	            let mut content = TextComponent::text("[")
   176	                .add_child(int_array_format)
   177	                .add_child(TextComponent::text("; "));
   178	
   179	            for (index, int) in value.iter().take(128).enumerate() {
   180	                content = content
   181	                    .add_child(TextComponent::text(format!("{int}")).color_named(NamedColor::Gold));
   182	                if index < value.len() - 1 {
   183	                    content = content.add_child(TextComponent::text(", "));
   184	                }
   185	            }
   186	
   187	            if value.len() > 128 {
   188	                content = content.add_child(folded);
   189	            }
   190	
   191	            content = content.add_child(TextComponent::text("]"));
   192	            Ok(content)
   193	        }
   194	        NbtTag::LongArray(value) => {
   195	            let long_array_format = TextComponent::text("L").color_named(NamedColor::Red);
   196	            let mut content = TextComponent::text("[")
   197	                .add_child(long_array_format.clone())
   198	                .add_child(TextComponent::text("; "));
   199	
   200	            for (index, long) in value.iter().take(128).enumerate() {
   201	                content = content
   202	                    .add_child(TextComponent::text(format!("{long}")))
   203	                    .add_child(long_array_format.clone());
   204	                if index < value.len() - 1 {
   205	                    content = content.add_child(TextComponent::text(", "));
   206	                }
   207	            }
   208	
   209	            if value.len() > 128 {
   210	                content = content.add_child(folded);
   211	            }
   212	
   213	            content = content.add_child(TextComponent::text("]"));
   214	            Ok(content)
   215	        }
   216	    }
   217	}
   218	
   219	async fn display_data(
   220	    entity: &dyn EntityBase,
   221	    target_name: TextComponent,
   222	    sender: &CommandSender,
   223	) -> Result<i32, CommandError> {
   224	    let mut nbt = NbtCompound::new();
   225	    entity.write_nbt(&mut nbt).await;
   226	    let tag = NbtTag::Compound(nbt);
   227	
   228	    let result = get_i32_result(&tag)?;
   229	    let display = snbt_colorful_display(&tag, 0)
   230	        .map_err(|string| CommandError::CommandFailed(TextComponent::text(string)))?;
   231	    sender
   232	        .send_message(TextComponent::translate_cross(
   233	            translation::java::COMMANDS_DATA_ENTITY_QUERY,
   234	            translation::java::COMMANDS_DATA_ENTITY_QUERY,
   235	            [target_name, display],
   236	        ))
   237	        .await;
   238	
   239	    Ok(result)
   240	}
   241	
   242	fn get_i32_result(tag: &NbtTag) -> Result<i32, CommandError> {
   243	    match tag {
   244	        NbtTag::End => Err(CommandError::CommandFailed(TextComponent::translate_cross(
   245	            translation::java::COMMANDS_DATA_GET_UNKNOWN,
   246	            translation::java::COMMANDS_DATA_GET_UNKNOWN,
   247	            [],
   248	        ))),
   249	
   250	        NbtTag::Byte(b) => Ok(*b as i32),
   251	        NbtTag::Short(s) => Ok(*s as i32),
   252	        NbtTag::Int(i) => Ok(*i),
   253	        NbtTag::Long(l) => Ok((*l).clamp(i32::MIN as i64, i32::MAX as i64) as i32),
   254	        NbtTag::Float(f) => Ok({
   255	            let i = *f as i32;
   256	            if *f < i as f32 { i - 1 } else { i }
   257	        }),
   258	        NbtTag::Double(d) => Ok({
   259	            let i = *d as i32;
   260	            if *d < i as f64 { i - 1 } else { i }
   261	        }),
   262	
   263	        NbtTag::ByteArray(items) => Ok(items.len() as i32),
   264	        NbtTag::IntArray(items) => Ok(items.len() as i32),
   265	        NbtTag::LongArray(items) => Ok(items.len() as i32),
   266	
   267	        NbtTag::String(string) => Ok(string.len() as i32),
   268	        NbtTag::List(nbt_tags) => Ok(nbt_tags.len() as i32),
   269	        NbtTag::Compound(nbt_compound) => Ok(nbt_compound.child_tags.len() as i32),
   270	    }
   271	}
   272	
   273	pub fn init_command_tree() -> CommandTree {
   274	    CommandTree::new(NAMES, DESCRIPTION).then(
   275	        literal("get").then(
   276	            literal("entity")
   277	                .then(argument(ARG_ENTITY, EntityArgumentConsumer).execute(GetEntityDataExecutor)),
   278	        ),
   279	    )
   280	}

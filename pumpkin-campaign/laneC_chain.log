   324	    /// Returns a new bounding box shifted by a delta vector.
   325	    ///
   326	    /// # Arguments
   327	    /// * `delta` – Vector to shift the bounding box by.
   328	    #[must_use]
   329	    pub fn shift(&self, delta: Vector3<f64>) -> Self {
   330	        Self {
   331	            min: self.min + delta,
   332	            max: self.max + delta,

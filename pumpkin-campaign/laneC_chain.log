    16	   @Override
    17	   protected boolean placeFeature(final LevelAccessor level, final RandomSource random, final BlockPos origin, final BlockState state) {
    18	      int height = random.nextInt(3) + 3;
    19	      int width = random.nextInt(3) + 3;
    20	      int length = random.nextInt(3) + 3;
    21	      int sinkValue = random.nextInt(3) + 1;
    22	      BlockPos.MutableBlockPos mutPos = origin.mutable();
    23	
    24	      for (int x = 0; x <= width; x++) {
    25	         for (int y = 0; y <= height; y++) {
    26	            for (int z = 0; z <= length; z++) {
    27	               mutPos.set(x + origin.getX(), y + origin.getY(), z + origin.getZ());
    28	               mutPos.move(Direction.DOWN, sinkValue);
    29	               if ((x != 0 && x != width || y != 0 && y != height)
    30	                  && (z != 0 && z != length || y != 0 && y != height)
    31	                  && (x != 0 && x != width || z != 0 && z != length)
    32	                  && (x == 0 || x == width || y == 0 || y == height || z == 0 || z == length)
    33	                  && !(random.nextFloat() < 0.1F)
    34	                  && !this.placeCoralBlock(level, random, mutPos, state)) {
    35	               }
    36	            }
    37	         }
    38	      }
    39	
    40	      return true;
    41	   }

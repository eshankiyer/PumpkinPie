   309	    /// Returns the maximum block position covered by this bounding box.
   310	    #[must_use]
   311	    pub const fn max_block_pos(&self) -> BlockPos {
   312	        // Use a tiny epsilon and floor the max coordinates so that a box whose
   313	        // max is exactly on a block boundary does not include the adjacent
   314	        // block. This mirrors vanilla behaviour where max block is inclusive

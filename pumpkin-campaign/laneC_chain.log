     1	package net.minecraft.world.level.levelgen.feature;
     2	
     3	import com.mojang.serialization.Codec;
     4	import java.util.List;
     5	import java.util.stream.Stream;
     6	import net.minecraft.core.BlockPos;
     7	import net.minecraft.core.Direction;
     8	import net.minecraft.util.RandomSource;
     9	import net.minecraft.util.Util;
    10	import net.minecraft.world.level.LevelAccessor;
    11	import net.minecraft.world.level.block.state.BlockState;
    12	import net.minecraft.world.level.levelgen.feature.configurations.NoneFeatureConfiguration;
    13	
    14	public class CoralClawFeature extends CoralFeature {
    15	   public CoralClawFeature(final Codec<NoneFeatureConfiguration> codec) {
    16	      super(codec);
    17	   }
    18	
    19	   @Override
    20	   protected boolean placeFeature(final LevelAccessor level, final RandomSource random, final BlockPos origin, final BlockState state) {
    21	      if (!this.placeCoralBlock(level, random, origin, state)) {
    22	         return false;
    23	      }
    24	
    25	      Direction clawDirection = Direction.Plane.HORIZONTAL.getRandomDirection(random);
    26	      int nBranches = random.nextInt(2) + 2;
    27	      List<Direction> possibleDirections = Util.toShuffledList(
    28	         Stream.of(clawDirection, clawDirection.getClockWise(), clawDirection.getCounterClockWise()), random
    29	      );
    30	
    31	      for (Direction branchDirection : possibleDirections.subList(0, nBranches)) {
    32	         BlockPos.MutableBlockPos mutPos = origin.mutable();
    33	         int sidewayLength = random.nextInt(2) + 1;
    34	         mutPos.move(branchDirection);
    35	         int inwayLenth;
    36	         Direction segmentDirection;
    37	         if (branchDirection == clawDirection) {
    38	            segmentDirection = clawDirection;
    39	            inwayLenth = random.nextInt(3) + 2;
    40	         } else {
    41	            mutPos.move(Direction.UP);
    42	            Direction[] segmentPossibleDirections = new Direction[]{branchDirection, Direction.UP};
    43	            segmentDirection = Util.getRandom(segmentPossibleDirections, random);
    44	            inwayLenth = random.nextInt(3) + 3;
    45	         }
    46	
    47	         for (int i = 0; i < sidewayLength && this.placeCoralBlock(level, random, mutPos, state); i++) {
    48	            mutPos.move(segmentDirection);
    49	         }
    50	
    51	         mutPos.move(segmentDirection.getOpposite());
    52	         mutPos.move(Direction.UP);
    53	
    54	         for (int i = 0; i < inwayLenth; i++) {
    55	            mutPos.move(clawDirection);
    56	            if (!this.placeCoralBlock(level, random, mutPos, state)) {
    57	               break;
    58	            }
    59	
    60	            if (random.nextFloat() < 0.25F) {
    61	               mutPos.move(Direction.UP);
    62	            }
    63	         }
    64	      }
    65	
    66	      return true;
    67	   }
    68	}

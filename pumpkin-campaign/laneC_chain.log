   830	   private static boolean checkScore(final CommandContext<CommandSourceStack> context, final ExecuteCommand.IntBiPredicate operation) throws CommandSyntaxException {
   831	      ScoreHolder target = ScoreHolderArgument.getName(context, "target");
   832	      Objective targetObjective = ObjectiveArgument.getObjective(context, "targetObjective");
   833	      ScoreHolder source = ScoreHolderArgument.getName(context, "source");
   834	      Objective sourceObjective = ObjectiveArgument.getObjective(context, "sourceObjective");
   835	      Scoreboard scoreboard = context.getSource().getServer().getScoreboard();
   836	      ReadOnlyScoreInfo a = scoreboard.getPlayerScoreInfo(target, targetObjective);
   837	      ReadOnlyScoreInfo b = scoreboard.getPlayerScoreInfo(source, sourceObjective);
   838	      return a != null && b != null ? operation.test(a.value(), b.value()) : false;
   839	   }

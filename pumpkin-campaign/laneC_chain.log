    48	fn game_profile_to_nbt(profile: &GameProfile) -> NbtCompound {
    49	    let mut compound = NbtCompound::new();
    50	    let int_array = uuid_to_int_array(&profile.id);
    51	    compound.put("id", NbtTag::IntArray(int_array.to_vec()));
    52	    if !profile.name.is_empty() {
    53	        compound.put_string("name", profile.name.clone());
    54	    }
    55	    let properties = profile.properties.load();
    56	    if !properties.is_empty() {
    57	        let mut prop_list = Vec::new();
    58	        for prop in properties.iter() {
    59	            let mut prop_compound = NbtCompound::new();
    60	            prop_compound.put_string("name", prop.name.to_string());
    61	            prop_compound.put_string("value", prop.value.to_string());
    62	            if let Some(ref sig) = prop.signature {

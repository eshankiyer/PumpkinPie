     1	use std::sync::Arc;
     2	
     3	use super::{NBTStorage, NBTStorageInit, player::Player};
     4	use crate::entity::NbtFuture;
     5	use crossbeam::atomic::AtomicCell;
     6	use pumpkin_data::damage::DamageType;
     7	use pumpkin_nbt::compound::NbtCompound;
     8	use pumpkin_util::Difficulty;
     9	
    10	const MAX_FOOD: u8 = 20;
    11	const EXHAUSTION_COST: f32 = 4.0;
    12	const MAX_EXHAUSTION: f32 = 40.0;
    13	
    14	pub struct HungerManager {
    15	    pub level: AtomicCell<u8>,
    16	    pub saturation: AtomicCell<f32>,
    17	    pub exhaustion: AtomicCell<f32>,
    18	    pub tick_timer: AtomicCell<u32>,
    19	}
    20	
    21	impl Default for HungerManager {
    22	    fn default() -> Self {
    23	        Self {
    24	            level: AtomicCell::new(MAX_FOOD),
    25	            saturation: AtomicCell::new(5.0),
    26	            exhaustion: AtomicCell::new(0.0),
    27	            tick_timer: AtomicCell::new(0),
    28	        }
    29	    }
    30	}
    31	
    32	impl HungerManager {
    33	    pub async fn tick(&self, player: &Arc<Player>) {
    34	        let mut level = self.level.load();
    35	        let mut saturation = self.saturation.load();
    36	        let mut exhaustion = self.exhaustion.load();
    37	        let mut timer = self.tick_timer.load();
    38	
    39	        let level_info = player.world().level_info.load();
    40	        let difficulty = level_info.difficulty;
    41	        let natural_regen = level_info.game_rules.natural_health_regeneration;
    42	        let health = player.living_entity.health.load();
    43	        let can_heal = player.can_food_heal();
    44	
    45	        let mut needs_sync = false;
    46	        let mut heal_amount = 0.0;
    47	        let mut damage_amount = 0.0;
    48	
    49	        if exhaustion > EXHAUSTION_COST {
    50	            exhaustion -= EXHAUSTION_COST;
    51	            if saturation > 0.0 {
    52	                saturation = (saturation - 1.0).max(0.0);
    53	            } else if difficulty != Difficulty::Peaceful {
    54	                level = level.saturating_sub(1);
    55	            }
    56	            needs_sync = true;
    57	        }
    58	
    59	        if natural_regen && saturation > 0.0 && can_heal && level >= 20 {
    60	            timer += 1;
    61	            if timer >= 10 {
    62	                // `FoodData.tick`: the saturation spent is charged as exhaustion, which the
    63	                // branch above turns into saturation loss at four exhaustion per point.
    64	                // Subtracting it here as well spent it about five times too fast.
    65	                let cost = saturation.min(6.0);
    66	                exhaustion += cost;
    67	                heal_amount = cost / 6.0;
    68	                timer = 0;
    69	                needs_sync = true;
    70	            }
    71	        } else if natural_regen && level >= 18 && can_heal {
    72	            timer += 1;
    73	            if timer >= 80 {
    74	                heal_amount = 1.0;
    75	                exhaustion += 6.0;
    76	                timer = 0;
    77	                needs_sync = true;
    78	            }
    79	        } else if level == 0 {
    80	            timer += 1;
    81	            if timer >= 80 {
    82	                timer = 0;
    83	                let should_starve = match difficulty {
    84	                    Difficulty::Peaceful | Difficulty::Easy => health > 10.0,
    85	                    Difficulty::Normal => health > 1.0,
    86	                    Difficulty::Hard => true,
    87	                };
    88	
    89	                if should_starve {
    90	                    damage_amount = 1.0;
    91	                }
    92	                self.tick_timer.store(0);
    93	            }
    94	        } else {
    95	            timer = 0;
    96	        }
    97	
    98	        if needs_sync || timer != self.tick_timer.load() {
    99	            self.level.store(level);
   100	            self.saturation.store(saturation);
   101	            self.exhaustion.store(exhaustion);
   102	            self.tick_timer.store(timer);
   103	        }
   104	
   105	        if needs_sync {
   106	            player.send_health().await;
   107	        }
   108	        if heal_amount > 0.0 {
   109	            player.heal(heal_amount).await;
   110	        }
   111	        if damage_amount > 0.0 {
   112	            player
   113	                .damage(&**player, damage_amount, DamageType::STARVE)
   114	                .await;
   115	        }
   116	    }
   117	
   118	    /// Vanilla `FoodData.eat(FoodProperties)`, which forwards the component's
   119	    /// `saturation()` straight to `FoodData.add` -- the value is already absolute,
   120	    /// not a modifier, so no `FoodConstants.saturationByModifier` scaling applies.
   121	    pub async fn eat(&self, player: &Player, food: u8, saturation: f32) {
   122	        let new_level = self.level.load().saturating_add(food).min(MAX_FOOD);
   123	        let new_sat = (self.saturation.load() + saturation).clamp(0.0, f32::from(new_level));
   124	
   125	        self.level.store(new_level);
   126	        self.saturation.store(new_sat);
   127	
   128	        player.send_health().await;
   129	    }
   130	
   131	    /// Add exhaustion to trigger hunger decrease
   132	    pub fn add_exhaustion(&self, exhaustion: f32) {
   133	        let current = self.exhaustion.load();
   134	        self.exhaustion
   135	            .store((current + exhaustion).min(MAX_EXHAUSTION));
   136	    }
   137	
   138	    /// Add hunger manually
   139	    pub fn add_hunger(&self, hunger: u8) {
   140	        let current = self.level.load();
   141	        self.level.store((current + hunger).min(MAX_FOOD));
   142	    }
   143	
   144	    /// Add saturation manually
   145	    pub fn add_saturation(&self, saturation: f32) {
   146	        let current = self.saturation.load();
   147	        self.saturation
   148	            .store((current + saturation).min(f32::from(self.level.load())));
   149	    }
   150	
   151	    pub fn set_level(&self, level: u8) {
   152	        self.level.store(level.min(MAX_FOOD));
   153	    }
   154	
   155	    pub fn set_saturation(&self, saturation: f32) {
   156	        self.saturation
   157	            .store(saturation.min(f32::from(self.level.load())));
   158	    }
   159	
   160	    pub fn get_exhaustion(&self) -> f32 {
   161	        self.exhaustion.load()
   162	    }
   163	
   164	    pub fn set_exhaustion(&self, exhaustion: f32) {
   165	        self.exhaustion.store(exhaustion.min(MAX_EXHAUSTION));
   166	    }
   167	
   168	    pub fn restart(&self) {
   169	        self.level.store(MAX_FOOD);
   170	        self.saturation.store(5.0);
   171	        self.exhaustion.store(0.0);
   172	        self.tick_timer.store(0);
   173	    }
   174	
   175	    /// Vanilla `FoodData.hasEnoughFood()` (`FoodData.java:92-94`).
   176	    ///
   177	    /// Returns true if the food level is above 6 (enough to sprint).
   178	    #[must_use]
   179	    pub fn has_enough_food(&self) -> bool {
   180	        self.level.load() > 6
   181	    }
   182	
   183	    /// Vanilla `FoodData.needsFood()` (`FoodData.java:96-98`).
   184	    ///
   185	    /// Returns true if the food level is below maximum (20).
   186	    #[must_use]
   187	    pub fn needs_food(&self) -> bool {
   188	        self.level.load() < MAX_FOOD
   189	    }
   190	}
   191	
   192	impl NBTStorage for HungerManager {
   193	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   194	        Box::pin(async {
   195	            nbt.put_int("foodLevel", self.level.load().into());
   196	            nbt.put_float("foodSaturationLevel", self.saturation.load());
   197	            nbt.put_float("foodExhaustionLevel", self.exhaustion.load());
   198	            nbt.put_int("foodTickTimer", self.tick_timer.load() as i32);
   199	        })
   200	    }
   201	
   202	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   203	        Box::pin(async move {
   204	            self.level
   205	                .store(nbt.get_int("foodLevel").unwrap_or(20) as u8);
   206	            self.saturation
   207	                .store(nbt.get_float("foodSaturationLevel").unwrap_or(5.0));
   208	            self.exhaustion
   209	                .store(nbt.get_float("foodExhaustionLevel").unwrap_or(0.0));
   210	            self.tick_timer
   211	                .store(nbt.get_int("foodTickTimer").unwrap_or(0) as u32);
   212	        })
   213	    }
   214	}

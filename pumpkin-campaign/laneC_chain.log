     7	
     8	public record ClientboundRespawnPacket(CommonPlayerSpawnInfo commonPlayerSpawnInfo, byte dataToKeep) implements Packet<ClientGamePacketListener> {
     9	   public static final StreamCodec<RegistryFriendlyByteBuf, ClientboundRespawnPacket> STREAM_CODEC = Packet.codec(
    10	      ClientboundRespawnPacket::write, ClientboundRespawnPacket::new
    11	   );
    12	   public static final byte KEEP_ATTRIBUTE_MODIFIERS = 1;
    13	   public static final byte KEEP_ENTITY_DATA = 2;
    14	   public static final byte KEEP_ALL_DATA = 3;
    15	
    16	   private ClientboundRespawnPacket(final RegistryFriendlyByteBuf input) {
    17	      this(new CommonPlayerSpawnInfo(input), input.readByte());
    18	   }
    19	
    20	   private void write(final RegistryFriendlyByteBuf output) {
    21	      this.commonPlayerSpawnInfo.write(output);
    22	      output.writeByte(this.dataToKeep);
    23	   }
    24	
    25	   @Override
    26	   public PacketType<ClientboundRespawnPacket> type() {
    27	      return GamePacketTypes.CLIENTBOUND_RESPAWN;
    28	   }
    29	
    30	   public void handle(final ClientGamePacketListener listener) {
    31	      listener.handleRespawn(this);
    32	   }
    33	
    34	   public boolean shouldKeep(final byte mask) {
    35	      return (this.dataToKeep & mask) != 0;
    36	   }
    37	}


    18	import net.minecraft.network.chat.CommonComponents;
    19	import net.minecraft.network.chat.Component;
    20	import net.minecraft.network.chat.ComponentSerialization;
    21	import net.minecraft.network.chat.ComponentUtils;
    22	import net.minecraft.network.chat.MutableComponent;
    23	import net.minecraft.network.chat.contents.objects.PlayerSprite;
    24	import net.minecraft.server.MinecraftServer;
    25	import net.minecraft.server.players.ProfileResolver;
    26	import net.minecraft.util.Util;
    27	import net.minecraft.world.entity.Avatar;
    28	import net.minecraft.world.entity.Entity;
    29	import net.minecraft.world.item.component.ResolvableProfile;
    30	
    31	public class FetchProfileCommand {
    32	   private static final DynamicCommandExceptionType NO_PROFILE = new DynamicCommandExceptionType(
    33	      id -> Component.translatableEscape("commands.fetchprofile.no_profile", id)
    34	   );
    35	
    36	   public static void register(final CommandDispatcher<CommandSourceStack> dispatcher) {
    37	      dispatcher.register(
    38	         Commands.literal("fetchprofile")
    39	            .requires(Commands.hasPermission(Commands.LEVEL_GAMEMASTERS))
    40	            .then(
    41	               Commands.literal("name")
    42	                  .then(
    43	                     Commands.argument("name", StringArgumentType.greedyString())
    44	                        .executes(c -> resolveName(c.getSource(), StringArgumentType.getString(c, "name")))
    45	                  )
    46	            )
    47	            .then(
    48	               Commands.literal("id").then(Commands.argument("id", UuidArgument.uuid()).executes(c -> resolveId(c.getSource(), UuidArgument.getUuid(c, "id"))))
    49	            )
    50	            .then(
    51	               Commands.literal("entity")
    52	                  .then(
    53	                     Commands.argument("entity", EntityArgument.entity()).executes(c -> printForEntity(c.getSource(), EntityArgument.getEntity(c, "entity")))
    54	                  )
    55	            )
    56	      );
    57	   }
    58	
    59	   private static void reportResolvedProfile(final CommandSourceStack sender, final GameProfile gameProfile, final String messageId, final Component argument) {
    60	      reportResolvedProfile(sender, messageId, argument, ResolvableProfile.createResolved(gameProfile));
    61	   }
    62	
    63	   private static void reportResolvedProfile(final CommandSourceStack sender, final String messageId, final Component argument, final ResolvableProfile profile) {
    64	      ResolvableProfile.CODEC
    65	         .encodeStart(NbtOps.INSTANCE, profile)
    66	         .ifSuccess(
    67	            encodedProfile -> {
    68	               String encodedProfileAsString = encodedProfile.toString();
    69	               MutableComponent headComponent = Component.object(new PlayerSprite(profile, true));
    70	               ComponentSerialization.CODEC
    71	                  .encodeStart(NbtOps.INSTANCE, headComponent)
    72	                  .ifSuccess(
    73	                     encodedComponent -> {
    74	                        String encodedComponentAsString = encodedComponent.toString();
    75	                        sender.sendSuccess(
    76	                           () -> {
    77	                              Component clickable = ComponentUtils.formatList(
    78	                                 List.of(
    79	                                    Component.translatable("commands.fetchprofile.copy_component")
    80	                                       .withStyle(s -> s.withClickEvent(new ClickEvent.CopyToClipboard(encodedProfileAsString))),
    81	                                    Component.translatable("commands.fetchprofile.give_item")
    82	                                       .withStyle(
    83	                                          s -> s.withClickEvent(
    84	                                             new ClickEvent.RunCommand("give @s minecraft:player_head[profile=" + encodedProfileAsString + "]")
    85	                                          )
    86	                                       ),
    87	                                    Component.translatable("commands.fetchprofile.summon_mannequin")
    88	                                       .withStyle(
    89	                                          s -> s.withClickEvent(
    90	                                             new ClickEvent.RunCommand("summon minecraft:mannequin ~ ~ ~ {profile:" + encodedProfileAsString + "}")
    91	                                          )
    92	                                       ),
    93	                                    Component.translatable("commands.fetchprofile.copy_text", headComponent.withStyle(ChatFormatting.WHITE))
    94	                                       .withStyle(s -> s.withClickEvent(new ClickEvent.CopyToClipboard(encodedComponentAsString)))
    95	                                 ),
    96	                                 CommonComponents.SPACE,
    97	                                 c -> ComponentUtils.wrapInSquareBrackets(c.withStyle(ChatFormatting.GREEN))
    98	                              );
    99	                              return Component.translatable(messageId, argument, clickable);
   100	                           },
   101	                           false
   102	                        );
   103	                     }
   104	                  )
   105	                  .ifError(
   106	                     componentEncodingError -> sender.sendFailure(
   107	                        Component.translatable("commands.fetchprofile.failed_to_serialize", componentEncodingError.message())
   108	                     )
   109	                  );
   110	            }
   111	         )
   112	         .ifError(error -> sender.sendFailure(Component.translatable("commands.fetchprofile.failed_to_serialize", error.message())));
   113	   }
   114	
   115	   private static int resolveName(final CommandSourceStack source, final String name) {
   116	      MinecraftServer server = source.getServer();
   117	      ProfileResolver resolver = server.services().profileResolver();
   118	      Util.nonCriticalIoPool()
   119	         .execute(
   120	            () -> {
   121	               Component nameComponent = Component.literal(name);
   122	               Optional<GameProfile> result = resolver.fetchByName(name);
   123	               server.execute(
   124	                  () -> result.ifPresentOrElse(
   125	                     profile -> reportResolvedProfile(source, profile, "commands.fetchprofile.name.success", nameComponent),
   126	                     () -> source.sendFailure(Component.translatable("commands.fetchprofile.name.failure", nameComponent))
   127	                  )
   128	               );
   129	            }
   130	         );
   131	      return 1;
   132	   }
   133	
   134	   private static int resolveId(final CommandSourceStack source, final UUID id) {
   135	      MinecraftServer server = source.getServer();
   136	      ProfileResolver resolver = server.services().profileResolver();
   137	      Util.nonCriticalIoPool()
   138	         .execute(
   139	            () -> {
   140	               Component idComponent = Component.translationArg(id);
   141	               Optional<GameProfile> result = resolver.fetchById(id);
   142	               server.execute(
   143	                  () -> result.ifPresentOrElse(
   144	                     profile -> reportResolvedProfile(source, profile, "commands.fetchprofile.id.success", idComponent),
   145	                     () -> source.sendFailure(Component.translatable("commands.fetchprofile.id.failure", idComponent))
   146	                  )
   147	               );
   148	            }
   149	         );
   150	      return 1;
   151	   }
   152	
   153	   private static int printForEntity(final CommandSourceStack source, final Entity entity) throws CommandSyntaxException {
   154	      if (entity instanceof Avatar avatar) {
   155	         printForAvatar(source, avatar);
   156	         return 1;
   157	      } else {
   158	         throw NO_PROFILE.create(entity.getDisplayName());
   159	      }
   160	   }
   161	
   162	   public static void printForAvatar(final CommandSourceStack source, final Avatar avatar) {
   163	      reportResolvedProfile(source, "commands.fetchprofile.entity.success", avatar.getDisplayName(), avatar.getProfile());
   164	   }
   165	}


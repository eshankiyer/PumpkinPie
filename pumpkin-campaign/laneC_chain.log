   276	impl CommandExecutor for ResolveNameExecutor {
   277	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   278	        Box::pin(async move {
   279	            let name = StringArgumentType::get(context, ARG_NAME)?;
   280	            let server = context.server().clone();
   281	            let source = context.source.clone();
   282	            let name_owned = name.to_string();

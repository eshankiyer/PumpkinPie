     1	package net.minecraft.world.entity.animal.frog;
     2	
     3	import com.mojang.serialization.Codec;
     4	import com.mojang.serialization.codecs.RecordCodecBuilder;
     5	import java.util.List;
     6	import net.minecraft.core.ClientAsset;
     7	import net.minecraft.core.Holder;
     8	import net.minecraft.core.registries.Registries;
     9	import net.minecraft.network.RegistryFriendlyByteBuf;
    10	import net.minecraft.network.codec.ByteBufCodecs;
    11	import net.minecraft.network.codec.StreamCodec;
    12	import net.minecraft.resources.RegistryFixedCodec;
    13	import net.minecraft.world.entity.variant.PriorityProvider;
    14	import net.minecraft.world.entity.variant.SpawnCondition;
    15	import net.minecraft.world.entity.variant.SpawnContext;
    16	import net.minecraft.world.entity.variant.SpawnPrioritySelectors;
    17	
    18	public record FrogVariant(ClientAsset.ResourceTexture assetInfo, SpawnPrioritySelectors spawnConditions)
    19	   implements PriorityProvider<SpawnContext, SpawnCondition> {
    20	   public static final Codec<FrogVariant> DIRECT_CODEC = RecordCodecBuilder.create(
    21	      i -> i.group(
    22	            ClientAsset.ResourceTexture.DEFAULT_FIELD_CODEC.forGetter(FrogVariant::assetInfo),
    23	            SpawnPrioritySelectors.CODEC.fieldOf("spawn_conditions").forGetter(FrogVariant::spawnConditions)
    24	         )
    25	         .apply(i, FrogVariant::new)
    26	   );
    27	   public static final Codec<FrogVariant> NETWORK_CODEC = RecordCodecBuilder.create(
    28	      i -> i.group(ClientAsset.ResourceTexture.DEFAULT_FIELD_CODEC.forGetter(FrogVariant::assetInfo)).apply(i, FrogVariant::new)
    29	   );
    30	   public static final Codec<Holder<FrogVariant>> CODEC = RegistryFixedCodec.create(Registries.FROG_VARIANT);
    31	   public static final StreamCodec<RegistryFriendlyByteBuf, Holder<FrogVariant>> STREAM_CODEC = ByteBufCodecs.holderRegistry(Registries.FROG_VARIANT);
    32	
    33	   private FrogVariant(final ClientAsset.ResourceTexture assetInfo) {
    34	      this(assetInfo, SpawnPrioritySelectors.EMPTY);
    35	   }
    36	
    37	   @Override
    38	   public List<PriorityProvider.Selector<SpawnContext, SpawnCondition>> selectors() {
    39	      return this.spawnConditions.selectors();
    40	   }
    41	}


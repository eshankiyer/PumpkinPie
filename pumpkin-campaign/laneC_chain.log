    95	        Some((leader, candidates))
    96	    }
    97	}
    98	
    99	impl Default for FollowFlockLeaderGoal {
   100	    fn default() -> Self {
   101	        *Self::new()
   102	    }
   103	}
   104	
   105	impl Goal for FollowFlockLeaderGoal {
   106	    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   107	        Box::pin(async move {
   108	            if mob.get_mob_entity().has_schooling_followers() {
   109	                return false;
   110	            }
   111	            if mob.get_mob_entity().is_schooling_follower() {
   112	                return true;
   113	            }
   114	
   115	            let remaining = self.next_start_tick.load(Ordering::Relaxed);
   116	            if remaining < 0 {
   117	                self.next_start_tick
   118	                    .store(Self::roll_next_start_tick(mob) - 1, Ordering::Relaxed);
   119	                return false;
   120	            }
   121	            if remaining > 0 {
   122	                self.next_start_tick.fetch_sub(1, Ordering::Relaxed);
   123	                return false;
   124	            }
   125	            self.next_start_tick
   126	                .store(Self::roll_next_start_tick(mob), Ordering::Relaxed);
   127	
   128	            let Some((leader, candidates)) = Self::find_school(mob) else {
   129	                return false;
   130	            };
   131	
   132	            let Some(leader_mob) = leader.get_mob() else {
   133	                return false;
   134	            };
   135	            let remaining = leader_mob.get_mob_entity().schooling_followers_remaining();
   136	
   137	            // Vanilla applies the capacity limit before filtering out the leader itself. Keep
   138	            // that order, and preserve the query order instead of imposing an entity-id sort.
   139	            for candidate in candidates.into_iter().take(remaining) {
   140	                if candidate.get_entity().entity_id == leader.get_entity().entity_id {
   141	                    continue;
   142	                }
   143	                let Some(candidate_mob) = candidate.get_mob() else {
   144	                    continue;
   145	                };
   146	                if candidate_mob.get_mob_entity().is_schooling_follower() {
   147	                    continue;
   148	                }
   149	                let _ = candidate_mob
   150	                    .get_mob_entity()
   151	                    .start_schooling_following(&leader);
   152	            }
   153	
   154	            mob.get_mob_entity().is_schooling_follower()
   155	        })
   156	    }
   157	
   158	    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   159	        Box::pin(async move {
   160	            if !mob.get_mob_entity().is_schooling_follower() {
   161	                return false;
   162	            }
   163	            let Some(leader) = mob.get_mob_entity().schooling_leader() else {
   164	                return false;
   165	            };
   166	
   167	            let dist_sq = mob
   168	                .get_entity()
   169	                .pos
   170	                .load()
   171	                .squared_distance_to_vec(&leader.get_entity().pos.load());
   172	            dist_sq <= IN_RANGE_OF_LEADER_SQ
   173	        })
   174	    }
   175	
   176	    fn start<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   177	        Box::pin(async move {
   178	            self.time_to_recalc_path.store(0, Ordering::Relaxed);
   179	        })
   180	    }
   181	
   182	    fn stop<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   183	        Box::pin(async move {
   184	            let Some(leader) = mob.get_mob_entity().schooling_leader() else {
   185	                return;
   186	            };
   187	            mob.get_mob_entity().stop_schooling_following_if(&leader);
   188	        })
   189	    }
   190	
   191	    fn tick<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   192	        Box::pin(async move {
   193	            let remaining = self.time_to_recalc_path.fetch_sub(1, Ordering::Relaxed) - 1;
   194	            if remaining > 0 {
   195	                return;
   196	            }
   197	            self.time_to_recalc_path
   198	                .store(to_goal_ticks(10), Ordering::Relaxed);
   199	
   200	            let Some(leader) = mob.get_mob_entity().schooling_leader() else {
   201	                return;
   202	            };
   203	
   204	            let pos = mob.get_entity().pos.load();
   205	            let target: Vector3<f64> = leader.get_entity().pos.load();
   206	            mob.get_mob_entity()
   207	                .navigator
   208	                .lock()
   209	                .unwrap()
   210	                .set_progress(NavigatorGoal::new(pos, target, 1.0));
   211	        })
   212	    }
   213	
   214	    fn controls(&self) -> Controls {
   215	        self.goal_control
   216	    }
   217	}

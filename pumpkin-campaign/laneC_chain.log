     8	use super::{CoralFeature, shuffle};
     9	
    10	pub struct CoralClawFeature;
    11	
    12	impl CoralClawFeature {
    13	    #[allow(clippy::too_many_arguments)]
    14	    pub fn generate<T: GenerationCache>(
    15	        chunk: &mut T,
    16	        block_registry: &dyn WorldPortalExt,
    17	        _min_y: i8,
    18	        _height: u16,
    19	        _feature: pumpkin_data::placed_feature::PlacedFeature, // This placed feature
    20	        random: &mut RandomGenerator,
    21	        pos: BlockPos,
    22	    ) -> bool {
    23	        // First lets get a random coral
    24	        let block = CoralFeature::get_random_tag_entry(tag::Block::MINECRAFT_CORAL_BLOCKS, random);
    25	        if !CoralFeature::generate_coral_piece(chunk, block_registry, random, block, pos) {
    26	            return false;
    27	        }
    28	        // CoralClawFeature.placeFeature: claw_direction = Direction.Plane.HORIZONTAL
    29	        // .getRandomDirection(random) -- a uniform pick over all 4 horizontal directions.
    30	        let claw_direction = BlockDirection::random_horizontal(random).to_block_direction();
    31	        let branch_count = random.next_bounded_i32(2) + 2;
    32	
    33	        // Util.toShuffledList(Stream.of(clawDirection, clockWise, counterClockWise), random),
    34	        // then take the first `branch_count` entries -- NOT an arbitrary subset of all 4
    35	        // horizontal directions in enum order.
    36	        let mut possible_directions = [
    37	            claw_direction,
    38	            claw_direction.rotate_clockwise(),
    39	            claw_direction.rotate_counter_clockwise(),
    40	        ];
    41	        shuffle(&mut possible_directions, random);
    42	
    43	        for &branch_direction in &possible_directions[..branch_count as usize] {
    44	            let mut pos = pos;
    45	            let sideway_length = random.next_bounded_i32(2) + 1;
    46	            pos = pos.offset(branch_direction.to_offset());
    47	
    48	            let segment_direction;
    49	            let inway_length = if branch_direction == claw_direction {
    50	                segment_direction = claw_direction;
    51	                random.next_bounded_i32(3) + 2
    52	            } else {
    53	                pos = pos.up();
    54	                // Util.getRandom([branchDirection, Direction.UP], random): a uniform pick
    55	                // between continuing sideways or heading straight up.
    56	                segment_direction = if random.next_bounded_i32(2) == 0 {
    57	                    branch_direction
    58	                } else {
    59	                    BlockDirection::Up
    60	                };
    61	                random.next_bounded_i32(3) + 3
    62	            };
    63	
    64	            for _ in 0..sideway_length {
    65	                if !CoralFeature::generate_coral_piece(chunk, block_registry, random, block, pos) {
    66	                    break;
    67	                }
    68	                pos = pos.offset(segment_direction.to_offset());
    69	            }
    70	
    71	            pos = pos.offset(segment_direction.opposite().to_offset());
    72	            pos = pos.up();
    73	
    74	            for _ in 0..inway_length {
    75	                pos = pos.offset(claw_direction.to_offset());
    76	                if !CoralFeature::generate_coral_piece(chunk, block_registry, random, block, pos) {
    77	                    // Mirrors `CoralClawFeature.placeFeature` (`CoralClawFeature.java:54-58`):
    78	                    // a failed inway placement ends this branch, then the next shuffled branch
    79	                    // is attempted.
    80	                    break;
    81	                }
    82	                if random.next_f32() < 0.25 {
    83	                    pos = pos.up();
    84	                }
    85	            }
    86	        }
    87	        true
    88	    }
    89	}

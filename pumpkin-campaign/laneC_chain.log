   862	   private static boolean checkCustomPredicate(final CommandSourceStack source, final Holder<LootItemCondition> predicate) {
   863	      ServerLevel level = source.getLevel();
   864	      LootParams lootParams = new LootParams.Builder(level)
   865	         .withParameter(LootContextParams.ORIGIN, source.getPosition())
   866	         .withOptionalParameter(LootContextParams.THIS_ENTITY, source.getEntity())
   867	         .create(LootContextParamSets.COMMAND);
   868	      LootContext context = new LootContext.Builder(lootParams).create(Optional.empty());
   869	      context.pushVisitedElement(LootContext.createVisitedEntry(predicate.value()));
   870	      return predicate.value().test(context);
   871	   }

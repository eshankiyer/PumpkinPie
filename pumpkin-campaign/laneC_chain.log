   132	/// Ported from vanilla `ExecuteCommand.executeOver`
   133	/// (`net/minecraft/server/commands/ExecuteCommand.java:192-203`): moves the source
   134	/// to the Y of the given heightmap type at the source's current X/Z, erroring when
   135	/// the containing chunk is not loaded.
   136	fn execute_over_modifier<'a>(
   137	    context: &'a CommandContext,
   138	) -> crate::command::node::RedirectModifierResult<'a> {
   139	    Box::pin(async move {
   140	        let heightmap_type = HeightmapTypeArgumentType::get(context, "heightmap")?;
   141	        let world = context.source.world();
   142	        let x = context.source.position.x.floor() as i32;
   143	        let z = context.source.position.z.floor() as i32;
   144	        // Vanilla throws `BlockPosArgument.ERROR_NOT_LOADED` from `level.hasChunk`
   145	        // (`net/minecraft/server/commands/ExecuteCommand.java:197-199`).
   146	        if !world.is_loaded(&BlockPos::new(x, world.min_y, z)) {
   147	            return Err(NOT_LOADED_ERROR_TYPE.create_without_context());
   148	        }
   149	        let height = world.get_heightmap_height(heightmap_type, x, z);
   150	        let mut source = context.source.as_ref().clone();
   151	        source.position.y = f64::from(height);
   152	        Ok(vec![Arc::new(source)])
   153	    })
   154	}

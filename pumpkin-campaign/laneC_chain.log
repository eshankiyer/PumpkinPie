   806	   private static Command<CommandSourceStack> createNumericConditionalHandler(final boolean expected, final ExecuteCommand.CommandNumericPredicate condition) {
   807	      return expected ? c -> {
   808	         int count = condition.test(c);
   809	         if (count > 0) {
   810	            c.getSource().sendSuccess(() -> Component.translatable("commands.execute.conditional.pass_count", count), false);
   811	            return count;
   812	         } else {
   813	            throw ERROR_CONDITIONAL_FAILED.create();
   814	         }
   815	      } : c -> {
   816	         int count = condition.test(c);
   817	         if (count == 0) {
   818	            c.getSource().sendSuccess(() -> Component.translatable("commands.execute.conditional.pass"), false);
   819	            return 1;
   820	         } else {
   821	            throw ERROR_CONDITIONAL_FAILED_COUNT.create(count);
   822	         }
   823	      };
   824	   }

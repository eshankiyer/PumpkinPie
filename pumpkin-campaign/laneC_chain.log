   149	    /// Contracts this box uniformly along all axes.
   150	    ///
   151	    /// # Arguments
   152	    /// * `value` – Amount to contract along all axes.
   153	    #[must_use]
   154	    pub fn contract_all(&self, value: f64) -> Self {

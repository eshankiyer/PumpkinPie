     9	#[java_packet(SET_EXPERIENCE)]
    10	pub struct CSetExperience {
    11	    pub progress: f32,
    12	    pub level: VarInt,
    13	    pub total_experience: VarInt,
    14	}
    15	
    16	impl CSetExperience {
    17	    #[must_use]
    18	    pub const fn new(progress: f32, level: VarInt, total_experience: VarInt) -> Self {
    19	        Self {
    20	            progress,
    21	            level,
    22	            total_experience,
    23	        }
    24	    }
    25	}
    26	
    27	impl ClientPacket for CSetExperience {
    28	    fn write_packet_data(
    29	        &self,
    30	        mut write: impl std::io::Write,
    31	        version: &JavaMinecraftVersion,
    32	    ) -> Result<(), crate::ser::WritingError> {
    33	        write.write_f32_be(self.progress)?;
    34	        if *version <= JavaMinecraftVersion::V_1_7_6 {
    35	            write.write_i16_be(self.level.0 as i16)?;
    36	            write.write_i16_be(self.total_experience.0 as i16)?;
    37	        } else {
    38	            write.write_var_int(&self.level)?;
    39	            write.write_var_int(&self.total_experience)?;
    40	        }
    41	        Ok(())
    42	    }
    43	}
    44	
    45	impl<'a> crate::ServerPacket<'a> for CSetExperience {
    46	    fn read(
    47	        bytebuf: &mut &'a [u8],
    48	        version: &JavaMinecraftVersion,
    49	    ) -> Result<Self, crate::ser::ReadingError> {
    50	        use crate::ser::NetworkReadExt;
    51	        let progress = bytebuf.get_f32_be()?;
    52	        let (level, total_experience) = if *version <= JavaMinecraftVersion::V_1_7_6 {
    53	            (
    54	                VarInt(i32::from(bytebuf.get_i16_be()?)),
    55	                VarInt(i32::from(bytebuf.get_i16_be()?)),
    56	            )
    57	        } else {
    58	            (bytebuf.get_var_int()?, bytebuf.get_var_int()?)
    59	        };
    60	
    61	        Ok(Self {
    62	            progress,
    63	            level,
    64	            total_experience,
    65	        })
    66	    }
    67	}

    38	const fn uuid_to_int_array(uuid: &Uuid) -> [i32; 4] {
    39	    let (most, least) = uuid.as_u64_pair();
    40	    [
    41	        (most >> 32) as i32,
    42	        most as i32,
    43	        (least >> 32) as i32,
    44	        least as i32,
    45	    ]
    46	}

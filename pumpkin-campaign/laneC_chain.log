   219	async fn display_data(
   220	    entity: &dyn EntityBase,
   221	    target_name: TextComponent,
   222	    sender: &CommandSender,
   223	) -> Result<i32, CommandError> {
   224	    let mut nbt = NbtCompound::new();
   225	    entity.write_nbt(&mut nbt).await;
   226	    let tag = NbtTag::Compound(nbt);
   227	
   228	    let result = get_i32_result(&tag)?;
   229	    let display = snbt_colorful_display(&tag, 0)
   230	        .map_err(|string| CommandError::CommandFailed(TextComponent::text(string)))?;
   231	    sender
   232	        .send_message(TextComponent::translate_cross(
   233	            translation::java::COMMANDS_DATA_ENTITY_QUERY,
   234	            translation::java::COMMANDS_DATA_ENTITY_QUERY,
   235	            [target_name, display],
   236	        ))
   237	        .await;
   238	
   239	    Ok(result)
   240	}
   241	
   242	fn get_i32_result(tag: &NbtTag) -> Result<i32, CommandError> {
   243	    match tag {
   244	        NbtTag::End => Err(CommandError::CommandFailed(TextComponent::translate_cross(
   245	            translation::java::COMMANDS_DATA_GET_UNKNOWN,
   246	            translation::java::COMMANDS_DATA_GET_UNKNOWN,
   247	            [],
   248	        ))),
   249	
   250	        NbtTag::Byte(b) => Ok(*b as i32),
   251	        NbtTag::Short(s) => Ok(*s as i32),
   252	        NbtTag::Int(i) => Ok(*i),
   253	        NbtTag::Long(l) => Ok((*l).clamp(i32::MIN as i64, i32::MAX as i64) as i32),
   254	        NbtTag::Float(f) => Ok({
   255	            let i = *f as i32;
   256	            if *f < i as f32 { i - 1 } else { i }
   257	        }),
   258	        NbtTag::Double(d) => Ok({
   259	            let i = *d as i32;
   260	            if *d < i as f64 { i - 1 } else { i }
   261	        }),
   262	
   263	        NbtTag::ByteArray(items) => Ok(items.len() as i32),
   264	        NbtTag::IntArray(items) => Ok(items.len() as i32),
   265	        NbtTag::LongArray(items) => Ok(items.len() as i32),
   266	
   267	        NbtTag::String(string) => Ok(string.len() as i32),
   268	        NbtTag::List(nbt_tags) => Ok(nbt_tags.len() as i32),
   269	        NbtTag::Compound(nbt_compound) => Ok(nbt_compound.child_tags.len() as i32),
   270	    }
   271	}

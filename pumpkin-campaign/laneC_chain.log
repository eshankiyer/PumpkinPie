   111	/// Inverse of `Entity::get_horizontal_facing`'s `floor(yaw / 90 + 0.5) & 3` mapping.
   112	const fn horizontal_facing_to_yaw(facing: HorizontalFacing) -> f32 {
   113	    match facing {
   114	        HorizontalFacing::South => 0.0,
   115	        HorizontalFacing::West => 90.0,
   116	        HorizontalFacing::North => 180.0,
   117	        HorizontalFacing::East => 270.0,
   118	    }

     9	/// Updates the exact position, rotation, and velocity of an entity.
    10	///
    11	/// This packet is used for server-side authority over entity movement.
    12	/// In the latest protocol versions, this replaces several older "Relative Move"
    13	/// packets to provide more precise synchronization and reduce "rubber-banding."
    14	///
    15	/// Note: This packet must NOT be used for the player receiving the packet or
    16	/// any entity the player is currently riding.
    17	pub struct CEntityPositionSync {
    18	    /// The Entity ID of the entity being moved.
    19	    pub entity_id: VarInt,
    20	    /// The absolute position of the entity in the world.
    21	    pub position: Vector3<f64>,
    22	    /// The current velocity (delta) of the entity, used by the client
    23	    /// for smooth interpolation.
    24	    pub delta: Vector3<f64>,
    25	    /// The absolute yaw (horizontal rotation) in degrees.
    26	    pub yaw: f32,
    27	    /// The absolute pitch (vertical rotation) in degrees.
    28	    pub pitch: f32,
    29	    /// Whether the entity is currently touching the ground.
    30	    pub on_ground: bool,
    31	}
    32	
    33	impl CEntityPositionSync {
    34	    #[must_use]
    35	    pub const fn new(
    36	        entity_id: VarInt,
    37	        position: Vector3<f64>,
    38	        delta: Vector3<f64>,
    39	        yaw: f32,
    40	        pitch: f32,
    41	        on_ground: bool,
    42	    ) -> Self {
    43	        Self {
    44	            entity_id,
    45	            position,
    46	            delta,
    47	            yaw,
    48	            pitch,
    49	            on_ground,
    50	        }
    51	    }
    52	}
    53	
    54	impl MultiVersionJavaPacket for CEntityPositionSync {
    55	    fn to_id(version: JavaMinecraftVersion) -> i32 {
    56	        if version >= JavaMinecraftVersion::V_1_21_2 {
    57	            ENTITY_POSITION_SYNC.to_id(version)
    58	        } else {
    59	            TELEPORT_ENTITY.to_id(version)
    60	        }
    61	    }
    62	}
    63	
    64	impl ClientPacket for CEntityPositionSync {
    65	    fn write_packet_data(
    66	        &self,
    67	        mut write: impl std::io::Write,
    68	        version: &JavaMinecraftVersion,
    69	    ) -> Result<(), crate::ser::WritingError> {
    70	        write.write_var_int(&self.entity_id)?;
    71	        write.write_f64_be(self.position.x)?;
    72	        write.write_f64_be(self.position.y)?;
    73	        write.write_f64_be(self.position.z)?;
    74	        if version >= &JavaMinecraftVersion::V_1_21_2 {
    75	            write.write_f64_be(self.delta.x)?;
    76	            write.write_f64_be(self.delta.y)?;
    77	            write.write_f64_be(self.delta.z)?;
    78	            write.write_f32_be(self.yaw)?;
    79	            write.write_f32_be(self.pitch)?;
    80	        } else {
    81	            write.write_u8((self.yaw.rem_euclid(360.0) * 256.0 / 360.0).floor() as u8)?;
    82	            write.write_u8((self.pitch.rem_euclid(360.0) * 256.0 / 360.0).floor() as u8)?;
    83	        }
    84	        write.write_bool(self.on_ground)?;
    85	        Ok(())
    86	    }
    87	}

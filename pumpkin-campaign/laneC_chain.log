     7	import net.minecraft.core.Holder;
     8	import net.minecraft.core.registries.BuiltInRegistries;
     9	import net.minecraft.tags.BlockTags;
    10	import net.minecraft.util.RandomSource;
    11	import net.minecraft.world.level.LevelAccessor;
    12	import net.minecraft.world.level.WorldGenLevel;
    13	import net.minecraft.world.level.block.BaseCoralWallFanBlock;
    14	import net.minecraft.world.level.block.Block;
    15	import net.minecraft.world.level.block.Blocks;
    16	import net.minecraft.world.level.block.SeaPickleBlock;
    17	import net.minecraft.world.level.block.state.BlockState;
    18	import net.minecraft.world.level.levelgen.feature.configurations.NoneFeatureConfiguration;
    19	
    20	public abstract class CoralFeature extends Feature<NoneFeatureConfiguration> {
    21	   public CoralFeature(final Codec<NoneFeatureConfiguration> codec) {
    22	      super(codec);
    23	   }
    24	
    25	   @Override
    26	   public boolean place(final FeaturePlaceContext<NoneFeatureConfiguration> context) {
    27	      RandomSource random = context.random();
    28	      WorldGenLevel level = context.level();
    29	      BlockPos origin = context.origin();
    30	      Optional<Block> coral = BuiltInRegistries.BLOCK.getRandomElementOf(BlockTags.CORAL_BLOCKS, random).map(Holder::value);
    31	      return coral.isEmpty() ? false : this.placeFeature(level, random, origin, coral.get().defaultBlockState());
    32	   }
    33	
    34	   protected abstract boolean placeFeature(final LevelAccessor level, final RandomSource random, final BlockPos origin, final BlockState state);
    35	
    36	   protected boolean placeCoralBlock(final LevelAccessor level, final RandomSource random, final BlockPos pos, final BlockState state) {
    37	      BlockPos above = pos.above();
    38	      BlockState targetBlockState = level.getBlockState(pos);
    39	      if ((targetBlockState.is(Blocks.WATER) || targetBlockState.is(BlockTags.CORALS)) && level.getBlockState(above).is(Blocks.WATER)) {
    40	         level.setBlock(pos, state, 3);
    41	         if (random.nextFloat() < 0.25F) {
    42	            BuiltInRegistries.BLOCK
    43	               .getRandomElementOf(BlockTags.CORALS, random)
    44	               .map(Holder::value)
    45	               .ifPresent(block -> level.setBlock(above, block.defaultBlockState(), 2));
    46	         } else if (random.nextFloat() < 0.05F) {
    47	            level.setBlock(above, Blocks.SEA_PICKLE.defaultBlockState().setValue(SeaPickleBlock.PICKLES, random.nextInt(4) + 1), 2);
    48	         }
    49	
    50	         for (Direction direction : Direction.Plane.HORIZONTAL) {
    51	            if (random.nextFloat() < 0.2F) {
    52	               BlockPos relativePos = pos.relative(direction);
    53	               if (level.getBlockState(relativePos).is(Blocks.WATER)) {
    54	                  BuiltInRegistries.BLOCK.getRandomElementOf(BlockTags.WALL_CORALS, random).map(Holder::value).ifPresent(coral -> {
    55	                     BlockState coralFanState = coral.defaultBlockState();
    56	                     if (coralFanState.hasProperty(BaseCoralWallFanBlock.FACING)) {
    57	                        coralFanState = coralFanState.setValue(BaseCoralWallFanBlock.FACING, direction);
    58	                     }
    59	
    60	                     level.setBlock(relativePos, coralFanState, 2);
    61	                  });
    62	               }
    63	            }
    64	         }
    65	
    66	         return true;
    67	      } else {
    68	         return false;
    69	      }
    70	   }
    71	}

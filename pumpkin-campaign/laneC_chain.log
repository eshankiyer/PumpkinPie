    pub async fn set_dragon_killed(&mut self, world: &Arc<World>, killed_uuid: Uuid) {
        if Some(killed_uuid) != self.dragon_uuid {
            return;
        }

        self.update_bossbar_health(world, 0.0).await;
        self.remove_all_bossbar(world).await;


    45	impl ClientPacket for CUpdateTime {
    46	    fn write_packet_data(
    47	        &self,
    48	        mut write: impl std::io::Write,
    49	        version: &JavaMinecraftVersion,
    50	    ) -> Result<(), WritingError> {
    51	        write.write_i64_be(self.game_time)?;
    52	
    53	        if version >= &JavaMinecraftVersion::V_26_1 {
    54	            write.write_var_int(&VarInt(self.clock_updates.len() as i32))?;
    55	            for &(clock_id, total_ticks, partial_tick, rate) in &self.clock_updates {
    56	                write.write_var_int(&VarInt(clock_id))?;
    57	                write.write_var_long(&VarLong(total_ticks))?;
    58	                write.write_f32_be(partial_tick)?;
    59	                write.write_f32_be(rate)?;
    60	            }
    61	        } else {
    62	            let (day_time, rate) = self
    63	                .clock_updates
    64	                .first()
    65	                .map_or((0, 1.0), |&(_, total_ticks, _, rate)| (total_ticks, rate));
    66	
    67	            let is_paused = rate == 0.0;
    68	            let day_time = if version < &JavaMinecraftVersion::V_1_21_2 {
    69	                if is_paused {
    70	                    match day_time.cmp(&0) {
    71	                        std::cmp::Ordering::Greater => -day_time,
    72	                        std::cmp::Ordering::Equal => -1,
    73	                        std::cmp::Ordering::Less => day_time,
    74	                    }
    75	                } else {
    76	                    day_time.abs()
    77	                }
    78	            } else {
    79	                day_time
    80	            };
    81	
    82	            write.write_i64_be(day_time)?;
    83	
    84	            if version >= &JavaMinecraftVersion::V_1_21_2 {
    85	                let is_increasing = rate > 0.0;
    86	                write.write_bool(is_increasing)?;
    87	            }
    88	        }
    89	        Ok(())
    90	    }
    91	}

    44	#[derive(Clone, Copy, Default, Debug)]
    45	pub struct DragonNode {
    46	    pub x: f64,
    47	    pub y: f64,
    48	    pub z: f64,
    49	}
    50	
    51	impl DragonNode {
    52	    #[must_use]
    53	    pub const fn new(x: f64, y: f64, z: f64) -> Self {
    54	        Self { x, y, z }
    55	    }
    56	
    57	    #[inline]
    58	    #[must_use]
    59	    pub fn dist_sq(&self, other: &Self) -> f64 {
    60	        let (dx, dy, dz) = (self.x - other.x, self.y - other.y, self.z - other.z);
    61	        dx * dx + dy * dy + dz * dz
    62	    }
    63	
    64	    #[inline]
    65	    #[must_use]
    66	    pub fn dist_sq_vec(&self, v: Vector3<f64>) -> f64 {
    67	        let (dx, dy, dz) = (self.x - v.x, self.y - v.y, self.z - v.z);
    68	        dx * dx + dy * dy + dz * dz
    69	    }
    70	
    71	    #[inline]
    72	    #[must_use]
    73	    pub const fn as_vec3(&self) -> Vector3<f64> {
    74	        Vector3::new(self.x, self.y, self.z)
    75	    }
    76	}
    77	
    78	#[must_use]
    79	pub fn find_path(
    80	    nodes: &[Option<DragonNode>; NODE_COUNT],
    81	    from: usize,
    82	    to: usize,
    83	    final_node: Option<DragonNode>,
    84	) -> Vec<usize> {
    85	    if from == to && final_node.is_none() {
    86	        return vec![];
    87	    }
    88	
    89	    let mut g = [f64::MAX; NODE_COUNT];
    90	    let mut came_from = [NODE_COUNT; NODE_COUNT];
    91	    let mut closed = [false; NODE_COUNT];
    92	    let mut open: std::collections::BinaryHeap<(ordered_float::OrderedFloat<f64>, usize)> =
    93	        std::collections::BinaryHeap::new();
    94	
    95	    let h = |n: usize| -> f64 {
    96	        if let Some(target) = final_node
    97	            && let Some(node) = nodes[n]
    98	        {
    99	            return node.dist_sq(&target).sqrt();
   100	        }
   101	        match (nodes[n], nodes[to]) {
   102	            (Some(a), Some(b)) => a.dist_sq(&b).sqrt(),
   103	            _ => 0.0,
   104	        }
   105	    };
   106	
   107	    g[from] = 0.0;
   108	    open.push((ordered_float::OrderedFloat(-h(from)), from));
   109	
   110	    'outer: while let Some((_, cur)) = open.pop() {
   111	        if closed[cur] {
   112	            continue;
   113	        }
   114	        if cur == to {
   115	            break 'outer;
   116	        }
   117	        closed[cur] = true;
   118	
   119	        let adj = NODE_ADJACENCY[cur];
   120	        for nbr in 0..NODE_COUNT {
   121	            if (adj >> nbr) & 1 == 0 || closed[nbr] {
   122	                continue;
   123	            }
   124	            let (Some(cn), Some(nn)) = (nodes[cur], nodes[nbr]) else {
   125	                continue;
   126	            };
   127	            let ng = g[cur] + cn.dist_sq(&nn).sqrt();
   128	            if ng < g[nbr] {
   129	                g[nbr] = ng;
   130	                came_from[nbr] = cur;
   131	                open.push((ordered_float::OrderedFloat(-(ng + h(nbr))), nbr));
   132	            }
   133	        }
   134	    }
   135	
   136	    let mut path = Vec::new();
   137	    let mut cur = to;
   138	    while cur != NODE_COUNT {
   139	        path.push(cur);
   140	        cur = came_from[cur];
   141	    }
   142	    path.reverse();
   143	    if path.first() == Some(&from) {
   144	        path.remove(0);
   145	    }
   146	    path
   147	}

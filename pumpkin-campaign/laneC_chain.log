     9	import net.minecraft.world.level.block.state.BlockState;
    10	import net.minecraft.world.level.levelgen.feature.configurations.NoneFeatureConfiguration;
    11	
    12	public class CoralTreeFeature extends CoralFeature {
    13	   public CoralTreeFeature(final Codec<NoneFeatureConfiguration> codec) {
    14	      super(codec);
    15	   }
    16	
    17	   @Override
    18	   protected boolean placeFeature(final LevelAccessor level, final RandomSource random, final BlockPos origin, final BlockState state) {
    19	      BlockPos.MutableBlockPos mutPos = origin.mutable();
    20	      int trunckHeight = random.nextInt(3) + 1;
    21	
    22	      for (int i = 0; i < trunckHeight; i++) {
    23	         if (!this.placeCoralBlock(level, random, mutPos, state)) {
    24	            return true;
    25	         }
    26	
    27	         mutPos.move(Direction.UP);
    28	      }
    29	
    30	      BlockPos trunckTopPos = mutPos.immutable();
    31	      int nBranches = random.nextInt(3) + 2;
    32	      List<Direction> directions = Direction.Plane.HORIZONTAL.shuffledCopy(random);
    33	
    34	      for (Direction branchDirection : directions.subList(0, nBranches)) {
    35	         mutPos.set(trunckTopPos);
    36	         mutPos.move(branchDirection);
    37	         int branchHeight = random.nextInt(5) + 2;
    38	         int segmentLength = 0;
    39	
    40	         for (int j = 0; j < branchHeight && this.placeCoralBlock(level, random, mutPos, state); j++) {
    41	            segmentLength++;
    42	            mutPos.move(Direction.UP);
    43	            if (j == 0 || segmentLength >= 2 && random.nextFloat() < 0.25F) {
    44	               mutPos.move(branchDirection);
    45	               segmentLength = 0;
    46	            }
    47	         }
    48	      }
    49	
    50	      return true;
    51	   }
    52	}

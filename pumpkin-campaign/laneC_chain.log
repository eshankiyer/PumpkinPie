   149	pub struct EnderDragonPart {
   150	    pub entity: Entity,
   151	    pub dragon_uuid: uuid::Uuid,
   152	}
   153	
   154	impl EnderDragonPart {
   155	    pub const fn new(entity: Entity, dragon_uuid: uuid::Uuid) -> Self {
   156	        Self {
   157	            entity,
   158	            dragon_uuid,
   159	        }
   160	    }
   161	
   162	    /// Checks the part's own invulnerability, resolves this part's owning dragon and
   163	    /// whether this part is the head (vanilla `EnderDragon.head`, EnderDragon.java:93,101 -
   164	    /// the first entry of `subEntities`), then routes into `EnderDragonEntity::hurt_part`
   165	    /// (vanilla `EnderDragon.hurt`, EnderDragon.java:446-469).
   166	    async fn hurt_dragon(
   167	        &self,
   168	        source: &dyn EntityBase,
   169	        amount: f32,
   170	        damage_type: DamageType,
   171	    ) -> bool {
   172	        // Vanilla `EnderDragonPart.hurtServer` (EnderDragonPart.java:52-54) checks the part's
   173	        // own `isInvulnerableToBase(source)` before routing into `EnderDragon.hurt`.
   174	        if self.entity.is_invulnerable_to(&damage_type).await {
   175	            return false;
   176	        }
   177	
   178	        let world = self.entity.world.load();
   179	        let Some(dragon_base) = world
   180	            .entities
   181	            .load()
   182	            .iter()
   183	            .find(|e| e.get_entity().entity_uuid == self.dragon_uuid)
   184	            .cloned()
   185	        else {
   186	            return false;
   187	        };
   188	        let Some(dragon) = dragon_base.cast_any().downcast_ref::<EnderDragonEntity>() else {
   189	            return false;
   190	        };
   191	        let is_head = dragon
   192	            .parts
   193	            .first()
   194	            .is_some_and(|head| head.entity.entity_uuid == self.entity.entity_uuid);
   195	        dragon.hurt_part(is_head, source, damage_type, amount).await
   196	    }
   197	}

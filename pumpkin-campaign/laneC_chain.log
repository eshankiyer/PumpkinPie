   345	    pub async fn set_fight_origin(&self, pos: BlockPos) {
   346	        let mut initialized = self.nodes_initialized.lock().await;
   347	        let mut origin = self.fight_origin.lock().await;
   348	        if *origin != pos {
   349	            *origin = pos;
   350	            *initialized = false;
   351	        }
   352	    }
   353	
   354	    pub async fn set_phase(&self, phase_type: EnderDragonPhase) {
   355	        let mut phase_lock = self.phase.lock().await;
   356	        if *phase_lock == phase_type {
   357	            return;
   358	        }
   359	
   360	        let old_phase = self.phase_manager.get_phase(*phase_lock);
   361	        old_phase.end(self).await;
   362	
   363	        *phase_lock = phase_type;
   364	
   365	        let new_phase = self.phase_manager.get_phase(phase_type);
   366	        new_phase.begin(self).await;
   367	    }
   368	
   369	    async fn ensure_nodes_initialized(&self) {
   370	        let mut initialized = self.nodes_initialized.lock().await;
   371	        if *initialized {
   372	            return;
   373	        }
   374	
   375	        let world = self.mob_entity.living_entity.entity.world.load();
   376	        let fight_origin = self.fight_origin.lock().await;
   377	
   378	        let mut nodes = self.nodes.lock().await;
   379	        for i in 0..NODE_COUNT {
   380	            let mut y_adjustment = 5;
   381	            let node_x;
   382	            let node_z;
   383	
   384	            if i < 12 {
   385	                node_x = fight_origin.0.x
   386	                    + (60.0 * ((i as f32) * std::f32::consts::TAU / 12.0).cos()) as i32;
   387	                node_z = fight_origin.0.z
   388	                    + (60.0 * ((i as f32) * std::f32::consts::TAU / 12.0).sin()) as i32;
   389	            } else if i < 20 {
   390	                let multiplier = i - 12;
   391	                node_x = fight_origin.0.x
   392	                    + (40.0 * ((multiplier as f32) * std::f32::consts::TAU / 8.0).cos()) as i32;
   393	                node_z = fight_origin.0.z
   394	                    + (40.0 * ((multiplier as f32) * std::f32::consts::TAU / 8.0).sin()) as i32;
   395	                y_adjustment += 10;
   396	            } else {
   397	                let multiplier = i - 20;
   398	                node_x = fight_origin.0.x
   399	                    + (20.0 * ((multiplier as f32) * std::f32::consts::TAU / 4.0).cos()) as i32;
   400	                node_z = fight_origin.0.z
   401	                    + (20.0 * ((multiplier as f32) * std::f32::consts::TAU / 4.0).sin()) as i32;
   402	            }
   403	
   404	            let height =
   405	                world.get_heightmap_height(ChunkHeightmapType::MotionBlocking, node_x, node_z);
   406	            let node_y = 73.max(height + y_adjustment);
   407	            nodes[i] = Some(DragonNode::new(node_x as f64, node_y as f64, node_z as f64));
   408	        }
   409	
   410	        let pos = self.mob_entity.living_entity.entity.pos.load();
   411	        let nearest = Self::nearest_node_in(&nodes, pos);
   412	        let dest = Self::random_node_idx();
   413	        let new_path = find_path(&nodes, nearest, dest, None);
   414	        drop(nodes);
   415	
   416	        *self.target_node.lock().await = dest;
   417	        *self.path.lock().await = new_path;
   418	        *initialized = true;
   419	    }
   420	
   421	    pub async fn find_closest_node(&self) -> usize {
   422	        let pos = self.mob_entity.living_entity.entity.pos.load();
   423	        self.find_closest_node_to(pos).await
   424	    }
   425	
   426	    pub async fn find_closest_node_to(&self, pos: Vector3<f64>) -> usize {
   427	        self.ensure_nodes_initialized().await;
   428	        let nodes = self.nodes.lock().await;
   429	        Self::nearest_node_in(&nodes, pos)
   430	    }
   431	
   432	    fn nearest_node_in(nodes: &[Option<DragonNode>; NODE_COUNT], pos: Vector3<f64>) -> usize {
   433	        nodes
   434	            .iter()
   435	            .enumerate()
   436	            .filter_map(|(i, n)| n.map(|n| (i, n.dist_sq_vec(pos))))
   437	            .min_by(|a, b| a.1.total_cmp(&b.1))
   438	            .map_or(0, |(i, _)| i)
   439	    }
   440	
   441	    fn random_node_idx() -> usize {
   442	        rand::random_range(0..NODE_COUNT)
   443	    }
   444	
   445	    #[inline]
   446	    #[must_use]
   447	    pub fn yaw_toward(from: Vector3<f64>, to: Vector3<f64>) -> f32 {
   448	        (-(to.z - from.z)).atan2(to.x - from.x).to_degrees() as f32 - 90.0
   449	    }
   450	
   451	    pub fn move_relative(&self, speed: f32, relative_movement: Vector3<f64>) {
   452	        let yaw = self.mob_entity.living_entity.entity.yaw.load();
   453	        let movement = Self::get_relative_movement(relative_movement, speed, yaw);
   454	        let entity = &self.mob_entity.living_entity.entity;
   455	        let vel = entity.velocity.load();
   456	        entity.velocity.store(vel + movement);
   457	    }
   458	
   459	    fn get_relative_movement(
   460	        relative_movement: Vector3<f64>,
   461	        speed: f32,
   462	        yaw: f32,
   463	    ) -> Vector3<f64> {
   464	        let dist = relative_movement.length_squared();
   465	        if dist < 1.0E-7 {
   466	            return Vector3::new(0.0, 0.0, 0.0);
   467	        }
   468	        let vec = if dist > 1.0 {
   469	            relative_movement.normalize()
   470	        } else {
   471	            relative_movement
   472	        } * (speed as f64);
   473	        let sin = (yaw * (std::f32::consts::PI / 180.0)).sin() as f64;
   474	        let cos = (yaw * (std::f32::consts::PI / 180.0)).cos() as f64;
   475	        Vector3::new(vec.x * cos - vec.z * sin, vec.y, vec.z * cos + vec.x * sin)
   476	    }
   477	
   478	    pub async fn steer_toward(
   479	        &self,
   480	        pos: Vector3<f64>,
   481	        target: Vector3<f64>,
   482	        fly_speed: f32,
   483	        turn_speed: f32,
   484	        _y_scale: f64,
   485	    ) {
   486	        let xdd = target.x - pos.x;
   487	        let mut ydd = target.y - pos.y;
   488	        let zdd = target.z - pos.z;
   489	        let dist_sq = xdd * xdd + ydd * ydd + zdd * zdd;
   490	
   491	        let horizontal_dist = xdd.hypot(zdd);
   492	        if horizontal_dist > 0.0 {
   493	            ydd = (ydd / horizontal_dist).clamp(-(fly_speed as f64), fly_speed as f64);
   494	        }
   495	
   496	        let entity = &self.mob_entity.living_entity.entity;
   497	        let mut vel = entity.velocity.load();
   498	        vel.y += ydd * 0.01;
   499	        entity.velocity.store(vel);
   500	
   501	        let yaw = entity.yaw.load();
   502	        let aim_diff = target - pos;
   503	        let aim = if aim_diff.length_squared() > 1e-6 {
   504	            aim_diff.normalize()
   505	        } else {
   506	            Vector3::new(0.0, 0.0, 0.0)
   507	        };
   508	
   509	        let dir_vec = Vector3::new(
   510	            (yaw * (std::f32::consts::PI / 180.0)).sin() as f64,
   511	            vel.y,
   512	            -(yaw * (std::f32::consts::PI / 180.0)).cos() as f64,
   513	        );
   514	        let dir = if dir_vec.length_squared() > 1e-6 {
   515	            dir_vec.normalize()
   516	        } else {
   517	            Vector3::new(0.0, 0.0, 0.0)
   518	        };
   519	
   520	        let dot = (dir.dot(&aim) as f32 + 0.5).max(0.0) / 1.5;
   521	        if xdd.abs() > 1.0E-5 || zdd.abs() > 1.0E-5 {
   522	            let mut y_rot_d =
   523	                (180.0 - (xdd.atan2(zdd).to_degrees() as f32) - yaw).rem_euclid(360.0);
   524	            if y_rot_d > 180.0 {
   525	                y_rot_d -= 360.0;
   526	            }
   527	            y_rot_d = y_rot_d.clamp(-50.0, 50.0);
   528	
   529	            let mut y_rot_a = self.yaw_rot_accel.lock().await;
   530	            *y_rot_a *= 0.8;
   531	            *y_rot_a += y_rot_d * turn_speed;
   532	            entity.yaw.store(yaw + *y_rot_a * 0.1);
   533	        }
   534	
   535	        let span = (2.0 / (dist_sq + 1.0)) as f32;
   536	        self.move_relative(
   537	            0.06 * (dot * span + (1.0 - span)),
   538	            Vector3::new(0.0, 0.0, -1.0),
   539	        );
   540	
   541	        let actual_vel = entity.velocity.load();
   542	        let actual_dir = if actual_vel.length_squared() > 1e-6 {
   543	            actual_vel.normalize()
   544	        } else {
   545	            Vector3::new(0.0, 0.0, 0.0)
   546	        };
   547	        let slide = 0.8 + 0.15 * (actual_dir.dot(&dir) + 1.0) / 2.0;
   548	        entity.velocity.store(Vector3::new(
   549	            actual_vel.x * slide,
   550	            actual_vel.y * 0.91,
   551	            actual_vel.z * slide,
   552	        ));
   553	    }
   554	
   555	    async fn update_flap_time(&self) {
   556	        let sitting = self.phase.lock().await.is_sitting();
   557	        let in_wall = *self.in_wall.lock().await;
   558	        let mut flap = self.flap_time.lock().await;
   559	        let mut o_flap = self.o_flap_time.lock().await;
   560	
   561	        *o_flap = *flap;
   562	        *flap += if sitting {
   563	            0.1
   564	        } else if in_wall {
   565	            FLAP_SPEED * 0.5
   566	        } else {
   567	            FLAP_SPEED
   568	        };
   569	        if *flap > std::f32::consts::TAU {
   570	            *flap -= std::f32::consts::TAU;
   571	        }
   572	    }
   573	
   574	    /// Vanilla `EnderDragon.isFlapping` (`EnderDragon.java:123-128`): a wing beat is the
   575	    /// `cos(flapTime * 2π)` wave crossing -0.3 upward between the previous and current
   576	    /// sample of the flap phase.
   577	    async fn is_flapping(&self) -> bool {
   578	        let flap = *self.flap_time.lock().await;
   579	        let old_flap = *self.o_flap_time.lock().await;
   580	        (old_flap * std::f32::consts::TAU).cos() <= -0.3
   581	            && (flap * std::f32::consts::TAU).cos() >= -0.3
   582	    }
   583	
   584	    /// Vanilla `EnderDragon.aiStep` calls `processFlappingMovement`
   585	    /// (`EnderDragon.java:148`, `Entity.java:1037-1043`): on a flap crossing, the server
   586	    /// emits `GameEvent.FLAP` (the dragon does not override `getMovementEmission`, whose
   587	    /// default `ALL` emits events - `Entity.java:1533-1535`), which sculk vibration
   588	    /// listeners receive at frequency 1. The client-only local flap sound inside
   589	    /// `onFlap` (`EnderDragon.java:131-138`) has no server counterpart.
   590	    async fn on_flap(&self, caller: &Arc<dyn EntityBase>) {
   591	        let world = self.mob_entity.living_entity.entity.world.load();
   592	        crate::world::game_event::emit_game_event(
   593	            &world,
   594	            pumpkin_data::game_event::GameEvent::Flap,
   595	            self.mob_entity.living_entity.entity.pos.load(),
   596	            crate::world::game_event::GameEventContext::of_entity(caller.clone()),
   597	        )
   598	        .await;
   599	    }
   600	
   601	    async fn tick_growl(&self) {
   602	        if self.phase.lock().await.is_sitting() {
   603	            return;
   604	        }
   605	        let mut t = self.growl_time.lock().await;
   606	        if *t > 0 {
   607	            *t -= 1;
   608	        } else {
   609	            *t = GROWL_COOLDOWN_BASE + rand::random_range(0..100);
   610	        }
   611	    }
   612	
   613	    fn find_nearest_player(&self) -> Option<Arc<Player>> {
   614	        let world = self.mob_entity.living_entity.entity.world.load();
   615	        let pos = self.mob_entity.living_entity.entity.pos.load();
   616	        world
   617	            .players
   618	            .load()
   619	            .iter()
   620	            .filter(|p| {
   621	                let p_pos = p.living_entity.entity.pos.load();
   622	                p_pos.distance_squared(pos) < ARENA_RADIUS * ARENA_RADIUS
   623	            })
   624	            .min_by(|a, b| {
   625	                let a_pos = a.living_entity.entity.pos.load();
   626	                let b_pos = b.living_entity.entity.pos.load();
   627	                a_pos
   628	                    .distance_squared(pos)
   629	                    .total_cmp(&b_pos.distance_squared(pos))
   630	            })
   631	            .cloned()
   632	    }
   633	
   634	    async fn handle_player_collisions(&self) {
   635	        let world = self.mob_entity.living_entity.entity.world.load();
   636	
   637	        let dragon_bbox = self.mob_entity.living_entity.entity.bounding_box.load();
   638	        let xm = f64::midpoint(dragon_bbox.min.x, dragon_bbox.max.x);
   639	        let zm = f64::midpoint(dragon_bbox.min.z, dragon_bbox.max.z);
   640	
   641	        for player in world.players.load().iter() {
   642	            if player
   643	                .living_entity
   644	                .entity
   645	                .bounding_box
   646	                .load()
   647	                .intersects(&dragon_bbox)
   648	            {
   649	                let player_pos = player.get_entity().pos.load();
   650	                let xd = player_pos.x - xm;
   651	                let zd = player_pos.z - zm;
   652	                let dd = (xd * xd + zd * zd).max(0.1);
   653	
   654	                let resistance = player
   655	                    .living_entity
   656	                    .get_attribute_value(&Attributes::KNOCKBACK_RESISTANCE);
   657	                player.living_entity.entity.apply_knockback(
   658	                    4.0 * (1.0 - resistance).max(0.0),
   659	                    xd / dd,
   660	                    zd / dd,
   661	                );
   662	                player.get_entity().send_velocity();
   663	
   664	                if !self.phase.lock().await.is_sitting() {
   665	                    player.damage(self, 5.0, DamageType::MOB_ATTACK).await;
   666	                }
   667	            }
   668	        }
   669	    }
   670	
   671	    fn tick_crystal_healing(&self) {
   672	        let world = self.mob_entity.living_entity.entity.world.load();
   673	        let pos = self.mob_entity.living_entity.entity.pos.load();
   674	
   675	        let mut nearest_crystal = None;
   676	        let mut min_dist_sq = 1024.0; // 32 blocks
   677	
   678	        for entity in world.entities.load().iter() {
   679	            if entity.get_entity().entity_type == &EntityType::END_CRYSTAL {
   680	                let crystal_pos = entity.get_entity().pos.load();
   681	                let dist_sq = pos.distance_squared(crystal_pos);
   682	                if dist_sq < min_dist_sq {
   683	                    min_dist_sq = dist_sq;
   684	                    nearest_crystal = Some(entity.clone());
   685	                }
   686	            }
   687	        }
   688	
   689	        if let Some(_crystal) = nearest_crystal {
   690	            let living = &self.mob_entity.living_entity;
   691	            if living.health.load() < living.get_max_health() {
   692	                living.heal(1.0);
   693	            }
   694	        }
   695	    }
   696	
   697	    async fn tick_block_breaking(&self) {
   698	        let phase_type = *self.phase.lock().await;
   699	        if phase_type.is_sitting() || phase_type == EnderDragonPhase::Dying {
   700	            return;
   701	        }
   702	
   703	        let world = self.mob_entity.living_entity.entity.world.load();
   704	        let bbox = self.mob_entity.living_entity.entity.bounding_box.load();
   705	
   706	        let min = bbox.min_block_pos();
   707	        let max = bbox.max_block_pos();
   708	
   709	        for pos in BlockPos::iterate(min, max) {
   710	            let block = world.get_block(&pos);
   711	            if block != &Block::BEDROCK
   712	                && block != &Block::END_STONE
   713	                && block != &Block::OBSIDIAN
   714	                && block != &Block::IRON_BARS
   715	                && block != &Block::END_PORTAL
   716	                && block != &Block::END_PORTAL_FRAME
   717	            {
   718	                world
   719	                    .set_block_state(&pos, BlockStateId::AIR, BlockFlags::NOTIFY_ALL)
   720	                    .await;
   721	            }
   722	        }
   723	    }
   724	
   725	    async fn tick_parts(&self) {
   726	        let history: tokio::sync::MutexGuard<'_, DragonFlightHistory> =
   727	            self.flight_history.lock().await;
   728	        let p5 = history.get(5);
   729	        let p10 = history.get(10);
   730	        let p0 = history.get(0);
   731	
   732	        let tilt = (p5.y - p10.y) as f32 * 10.0 * (std::f32::consts::PI / 180.0);
   733	        let cc_tilt = tilt.cos() as f64;
   734	        let ss_tilt = tilt.sin() as f64;
   735	
   736	        let yaw = self.mob_entity.living_entity.entity.yaw.load();
   737	        let rot1 = yaw * (std::f32::consts::PI / 180.0);
   738	        let ss1 = rot1.sin() as f64;
   739	        let cc1 = rot1.cos() as f64;
   740	
   741	        let pos = self.mob_entity.living_entity.entity.pos.load();
   742	
   743	        // Body
   744	        self.parts[2]
   745	            .entity
   746	            .set_pos(Vector3::new(pos.x + ss1 * 0.5, pos.y, pos.z - cc1 * 0.5));
   747	
   748	        // Wings
   749	        self.parts[6].entity.set_pos(Vector3::new(
   750	            pos.x + cc1 * 4.5,
   751	            pos.y + 2.0,
   752	            pos.z + ss1 * 4.5,
   753	        ));
   754	        self.parts[7].entity.set_pos(Vector3::new(
   755	            pos.x - cc1 * 4.5,
   756	            pos.y + 2.0,
   757	            pos.z - ss1 * 4.5,
   758	        ));
   759	
   760	        let head_y_offset = if self.phase.lock().await.is_sitting() {
   761	            -1.0
   762	        } else {
   763	            (p5.y - p0.y) as f64
   764	        };
   765	
   766	        let yaw_accel = *self.yaw_rot_accel.lock().await;
   767	        let rot2 = (yaw - yaw_accel * 0.01) * (std::f32::consts::PI / 180.0);
   768	        let ss2 = rot2.sin() as f64;
   769	        let cc2 = rot2.cos() as f64;
   770	
   771	        // Head & Neck
   772	        self.parts[0].entity.set_pos(Vector3::new(
   773	            pos.x + ss2 * 6.5 * cc_tilt,
   774	            pos.y + head_y_offset + ss_tilt * 6.5,
   775	            pos.z - cc2 * 6.5 * cc_tilt,
   776	        ));
   777	        self.parts[1].entity.set_pos(Vector3::new(
   778	            pos.x + ss2 * 5.5 * cc_tilt,
   779	            pos.y + head_y_offset + ss_tilt * 5.5,
   780	            pos.z - cc2 * 5.5 * cc_tilt,
   781	        ));
   782	
   783	        // Tails
   784	        for i in 0..3 {
   785	            let pi = history.get(12 + i * 2);
   786	            let rot = yaw * (std::f32::consts::PI / 180.0)
   787	                + (pi.y_rot - p5.y_rot).rem_euclid(360.0).to_radians();
   788	            let ss = rot.sin() as f64;
   789	            let cc = rot.cos() as f64;
   790	            let dd = (i + 1) as f64 * 2.0;
   791	
   792	            self.parts[3 + i as usize].entity.set_pos(Vector3::new(
   793	                pos.x - (ss1 * 1.5 + ss * dd) * cc_tilt,
   794	                pos.y + (pi.y - p5.y) - (dd + 1.5) * ss_tilt + 1.5,
   795	                pos.z + (cc1 * 1.5 + cc * dd) * cc_tilt,
   796	            ));
   797	        }
   798	
   799	        for part in &self.parts {
   800	            part.entity.send_pos_rot();
   801	        }
   802	    }
   803	
   804	    pub async fn ai_step(&self, caller: &Arc<dyn EntityBase>) {
   805	        if !self.parts_registered.swap(true, Ordering::AcqRel) {
   806	            let world = self.mob_entity.living_entity.entity.world.load();
   807	            for part in &self.parts {
   808	                world
   809	                    .add_entity_silent(part.clone() as Arc<dyn EntityBase>)
   810	                    .await;
   811	            }
   812	        }
   813	
   814	        self.mob_entity.living_entity.entity.update_last_pos();
   815	        self.ensure_nodes_initialized().await;
   816	        self.update_flap_time().await;
   817	        if self.is_flapping().await {
   818	            self.on_flap(caller).await;
   819	        }
   820	
   821	        {
   822	            let y = self.mob_entity.living_entity.entity.pos.load().y;
   823	            let yaw = self.mob_entity.living_entity.entity.yaw.load();
   824	            self.flight_history.lock().await.record(y, yaw);
   825	        };
   826	
   827	        self.tick_growl().await;
   828	        self.tick_crystal_healing();
   829	
   830	        {
   831	            let world = self.mob_entity.living_entity.entity.world.load();
   832	            if let Some(ref fight_mutex) = world.dragon_fight {
   833	                let living = &self.mob_entity.living_entity;
   834	                fight_mutex
   835	                    .lock()
   836	                    .await
   837	                    .update_dragon(&world, living.health.load(), living.get_max_health())
   838	                    .await;
   839	            }
   840	        }
   841	
   842	        let phase_type: EnderDragonPhase = *self.phase.lock().await;
   843	        let phase = self.phase_manager.get_phase(phase_type);
   844	
   845	        if phase_type.is_sitting() {
   846	            *self.ticks_sitting.lock().await += 1;
   847	        } else {
   848	            self.handle_player_collisions().await;
   849	            self.tick_block_breaking().await;
   850	        }
   851	
   852	        phase.tick(self).await;
   853	
   854	        if phase_type == EnderDragonPhase::Dying {
   855	            return;
   856	        }
   857	
   858	        let target_location = *self.target_location.lock().await;
   859	        if let Some(target) = target_location {
   860	            let pos = self.mob_entity.living_entity.entity.pos.load();
   861	            self.steer_toward(
   862	                pos,
   863	                target,
   864	                phase.get_fly_speed(),
   865	                phase.get_turn_speed(),
   866	                0.5,
   867	            )
   868	            .await;
   869	        }
   870	
   871	        self.mob_entity.living_entity.entity.send_pos_rot();
   872	        self.tick_parts().await;
   873	    }
   874	
   875	    /// Vanilla `EnderDragon.hurt` (EnderDragon.java:446-469). Applies the
   876	    /// DYING-phase immunity, the per-phase `onHurt` hook, the non-head damage
   877	    /// reduction, the 0.01 cutoff, the player/`ALWAYS_HURTS_ENDER_DRAGONS`
   878	    /// gate, and the sitting-damage accumulation that triggers the TAKEOFF
   879	    /// transition at `0.25 * max health`.
   880	    pub async fn hurt_part(
   881	        &self,
   882	        is_head: bool,
   883	        source: &dyn EntityBase,
   884	        damage_type: DamageType,
   885	        mut damage: f32,
   886	    ) -> bool {
   887	        let phase_type = *self.phase.lock().await;
   888	        if phase_type == EnderDragonPhase::Dying {
   889	            return false;
   890	        }
   891	
   892	        // EnderDragon.java:451: the per-phase hook runs before the head/body split.
   893	        damage = self
   894	            .phase_manager
   895	            .get_phase(phase_type)
   896	            .on_hurt(self, source, damage);
   897	
   898	        if !is_head {
   899	            damage = damage / 4.0 + damage.min(1.0);
   900	        }
   901	
   902	        if damage < 0.01 {
   903	            return false;
   904	        }
   905	
   906	        // Vanilla `source.getEntity() instanceof Player` resolves the causing entity, not
   907	        // the direct one - for projectiles that's the shooter, so a projectile source must
   908	        // be followed back to its owner (EnderDragon.java:460, DamageSource.java:63).
   909	        let world = self.mob_entity.living_entity.entity.world.load();
   910	        let caused_by_player = source.get_player().is_some()
   911	            || crate::entity::projectile::projectile_owner_id(source)
   912	                .is_some_and(|id| world.get_player_by_id(id).is_some());
   913	
   914	        if caused_by_player
   915	            || damage_type.has_tag(&tag::DamageType::MINECRAFT_ALWAYS_HURTS_ENDER_DRAGONS)
   916	        {
   917	            let health_before = self.mob_entity.living_entity.health.load();
   918	            self.damage_with_context(self, damage, damage_type, None, Some(source), Some(source))
   919	                .await;

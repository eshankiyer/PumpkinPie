    84	/// Represents a Frog, an amphibious mob that can eat small slimes and magma cubes.
    85	///
    86	/// Wiki: <https://minecraft.wiki/w/Frog>
    87	pub struct FrogEntity {
    88	    pub mob_entity: MobEntity,
    89	    pub ageable_data: AgeableData,
    90	    pub variant: AtomicI32,
    91	    pub tongue_target_id: AtomicI32,
    92	    /// `MemoryModuleType.IS_PREGNANT` (`Frog.spawnChildFromBreeding`, `Frog.java:256-259`).
    93	    /// A breeding frog produces no baby: it becomes pregnant and later lays frogspawn, which is
    94	    /// what hatches into tadpoles. Pumpkin has no memory system, so the memory is a plain flag,
    95	    /// the same shape `warden.rs` uses for the warden's activity state.
    96	    is_pregnant: AtomicBool,
    97	}
    98	
    99	impl FrogEntity {
   100	    pub fn new(entity: Entity) -> Arc<Self> {
   101	        let mob_entity = MobEntity::new(entity);
   102	        let frog = Self {
   103	            mob_entity,
   104	            ageable_data: AgeableData::default(),
   105	            variant: AtomicI32::new(FROG_VARIANT_UNSET),
   106	            tongue_target_id: AtomicI32::new(-1),
   107	            is_pregnant: AtomicBool::new(false),
   108	        };
   109	        let mob_arc = Arc::new(frog);
   110	        // `Frog.<init>` (`Frog.java:92`): `SmoothSwimmingMoveControl<>(this, 85, 10, 0.02F, 0.1F, true)`.
   111	        *mob_arc
   112	            .mob_entity
   113	            .move_control
   114	            .lock()
   115	            .unwrap_or_else(std::sync::PoisonError::into_inner) =
   116	            Box::new(crate::entity::ai::control::smooth_swimming_move_control::SmoothSwimmingMoveControl::new(
   117	                85, 10, 0.02, 0.1, true,
   118	            ));
   119	        let frog_weak = Arc::downgrade(&mob_arc);
   120	        let mob_weak: Weak<dyn Mob> = {
   121	            let mob_arc: Arc<dyn Mob> = mob_arc.clone();
   122	            Arc::downgrade(&mob_arc)
   123	        };
   124	
   125	        {
   126	            let mut goal_selector = mob_arc
   127	                .mob_entity
   128	                .goals_selector
   129	                .lock()
   130	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   131	            let mut target_selector = mob_arc
   132	                .mob_entity
   133	                .target_selector
   134	                .lock()
   135	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   136	
   137	            goal_selector.add_goal(0, Box::new(SwimGoal::default()));
   138	            goal_selector.add_goal(1, Box::new(FrogTongueAttackGoal::new()));
   139	            goal_selector.add_goal(1, Box::new(TemptGoal::new(1.0, FROG_FOOD, false)));
   140	            // `FrogAi.initLaySpawnActivity` (`FrogAi.java:143-168`) outranks the idle bundle,
   141	            // and `AnimalMakeLove(FROG)` (`FrogAi.java:90`) is what `BreedGoal` stands in for.
   142	            goal_selector.add_goal(1, FrogLaySpawnGoal::new(frog_weak, 1.0));
   143	            // `FrogAi.initIdleActivity` / `initSwimActivity` register two separate instances,
   144	            // `TryFindLand.create(6, 1.0F)` and `TryFindLand.create(8, 1.5F)`
   145	            // (`FrogAi.java:93,120`), picked by which Brain activity is active. Pumpkin has no
   146	            // per-activity dispatch for the frog, so this wires only the swim variant's wider
   147	            // range/speed; a frog in the idle activity searches slightly farther and faster
   148	            // than vanilla until activity-aware dispatch exists.
   149	            goal_selector.add_goal(2, Box::new(TryFindLandGoal::new(8, 1.5)));
   150	            goal_selector.add_goal(2, BreedGoal::new(1.0));
   151	            goal_selector.add_goal(2, Box::new(WanderAroundGoal::new(1.0)));
   152	            goal_selector.add_goal(
   153	                3,
   154	                LookAtEntityGoal::with_default(mob_weak, &EntityType::PLAYER, 6.0),
   155	            );
   156	            goal_selector.add_goal(4, Box::new(RandomLookAroundGoal::default()));
   157	
   158	            target_selector.add_goal(1, Box::new(FrogFindFoodGoal::default()));
   159	        };
   160	
   161	        mob_arc
   162	    }

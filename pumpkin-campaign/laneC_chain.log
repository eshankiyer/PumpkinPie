   414	   private static CommandSourceStack storeValue(
   415	      final CommandSourceStack source, final Collection<ScoreHolder> names, final Objective objective, final boolean storeResult
   416	   ) {
   417	      Scoreboard scoreboard = source.getServer().getScoreboard();
   418	      return source.withCallback((success, result) -> {
   419	         for (ScoreHolder name : names) {
   420	            ScoreAccess score = scoreboard.getOrCreatePlayerScore(name, objective);
   421	            int value = storeResult ? result : (success ? 1 : 0);
   422	            score.set(value);
   423	         }
   424	      }, CommandResultCallback::chain);
   425	   }
   426	
   427	   private static CommandSourceStack storeValue(
   428	      final CommandSourceStack source, final CustomBossEvent event, final boolean storeIntoValue, final boolean storeResult
   429	   ) {
   430	      return source.withCallback((success, result) -> {
   431	         int value = storeResult ? result : (success ? 1 : 0);
   432	         if (storeIntoValue) {
   433	            event.setValue(value);
   434	         } else {
   435	            event.setMax(value);
   436	         }
   437	      }, CommandResultCallback::chain);
   438	   }
   439	
   440	   private static CommandSourceStack storeData(
   441	      final CommandSourceStack source,
   442	      final DataAccessor accessor,
   443	      final NbtPathArgument.NbtPath path,
   444	      final IntFunction<Tag> constructor,
   445	      final boolean storeResult
   446	   ) {
   447	      return source.withCallback((success, result) -> {
   448	         try {
   449	            CompoundTag data = accessor.getData();
   450	            int value = storeResult ? result : (success ? 1 : 0);
   451	            path.set(data, constructor.apply(value));
   452	            accessor.setData(data);
   453	         } catch (CommandSyntaxException var8) {
   454	         }
   455	      }, CommandResultCallback::chain);
   456	   }

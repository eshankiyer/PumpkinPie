  1002	   private static RedirectModifier<CommandSourceStack> expandOneToManyEntityRelation(final Function<Entity, Stream<Entity>> unpacker) {
  1003	      return context -> {
  1004	         CommandSourceStack source = context.getSource();
  1005	         Entity entity = source.getEntity();
  1006	         return entity == null ? List.of() : unpacker.apply(entity).filter(e -> !e.isRemoved()).map(source::withEntity).toList();
  1007	      };
  1008	   }

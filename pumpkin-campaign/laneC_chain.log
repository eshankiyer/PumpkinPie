    17	const SCHOOL_RANGE: f64 = 8.0;
    18	const IN_RANGE_OF_LEADER_SQ: f64 = 121.0;
    19	
    20	/// Makes schooling fish (cod, salmon, tropical fish) cluster with, and follow, one leader fish of
    21	/// the same species picked from nearby individuals.
    22	///
    23	/// Vanilla source: `net/minecraft/world/entity/ai/goal/FollowFlockLeaderGoal.java`, backed by
    24	/// per-fish state in `net/minecraft/world/entity/animal/fish/AbstractSchoolingFish.java`
    25	/// (`leader`/`schoolSize`/`isFollower`/`canBeFollowed`).
    26	pub struct FollowFlockLeaderGoal {
    27	    goal_control: Controls,
    28	    next_start_tick: AtomicI32,
    29	    time_to_recalc_path: AtomicI32,
    30	}
    31	
    32	/// A leader and the fish that would join it, as `AbstractSchoolingFish` pairs them.
    33	type School = (Arc<dyn EntityBase>, Vec<Arc<dyn EntityBase>>);
    34	
    35	impl FollowFlockLeaderGoal {
    36	    #[must_use]
    37	    pub fn new() -> Box<Self> {
    38	        Box::new(Self {
    39	            goal_control: Controls::MOVE,
    40	            // `new()` is kept for existing registrations. The first can_start call seeds the
    41	            // same randomized delay that vanilla creates in the goal constructor.
    42	            next_start_tick: AtomicI32::new(-1),
    43	            time_to_recalc_path: AtomicI32::new(0),
    44	        })
    45	    }
    46	
    47	    fn roll_next_start_tick(mob: &dyn Mob) -> i32 {
    48	        to_goal_ticks(INTERVAL_TICKS + mob.get_random().random_range(0..200) % 20)
    49	    }
    50	
    51	    fn find_school(mob: &dyn Mob) -> Option<School> {
    52	        let self_entity = mob.get_entity();
    53	        let self_uuid = self_entity.entity_uuid;
    54	        let self_type = self_entity.entity_type;
    55	        let world = self_entity.world.load();
    56	        let search_box =
    57	            self_entity
    58	                .bounding_box
    59	                .load()
    60	                .expand(SCHOOL_RANGE, SCHOOL_RANGE, SCHOOL_RANGE);
    61	
    62	        // `get_entities_at_box` preserves the world's entity-list order, matching the order
    63	        // consumed by vanilla's `getEntitiesOfClass` stream. The existing sphere/HashMap helper
    64	        // would both select the wrong shape and lose that ordering.
    65	        let mut candidates = Vec::new();
    66	        for candidate in world.get_entities_at_box(&search_box) {
    67	            let candidate_entity = candidate.get_entity();
    68	            if candidate_entity.entity_type != self_type || !candidate_entity.is_alive() {
    69	                continue;
    70	            }
    71	            let Some(candidate_mob) = candidate.get_mob() else {
    72	                continue;
    73	            };
    74	            if candidate_mob
    75	                .get_mob_entity()
    76	                .can_be_followed_by_schooling_fish()
    77	                || !candidate_mob.get_mob_entity().is_schooling_follower()
    78	            {
    79	                candidates.push(candidate);
    80	            }
    81	        }
    82	
    83	        let leader = candidates
    84	            .iter()
    85	            .find(|candidate| {
    86	                candidate.get_mob().is_some_and(|candidate_mob| {
    87	                    candidate_mob
    88	                        .get_mob_entity()
    89	                        .can_be_followed_by_schooling_fish()
    90	                })
    91	            })
    92	            .cloned()
    93	            .or_else(|| world.get_entity_by_uuid(self_uuid))?;
    94	
    95	        Some((leader, candidates))
    96	    }
    97	}

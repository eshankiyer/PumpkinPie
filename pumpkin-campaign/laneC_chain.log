    89	impl Goal for FleeSunGoal {
    90	    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
    91	        Box::pin(async move {
    92	            let mob_entity = mob.get_mob_entity();
    93	            let living = &mob_entity.living_entity;
    94	            let entity = &living.entity;
    95	
    96	            // Must have no target to avoid sun-burning while fighting
    97	            let target_lock = mob_entity.target.lock().await;
    98	            if target_lock.is_some() {
    99	                return false;
   100	            }
   101	            drop(target_lock);
   102	
   103	            // Vanilla Entity.isOnFire() uses remaining fire ticks on the
   104	            // server; the shared visual-fire flag is only a client-side aid.
   105	            if entity.entity_type.fire_immune
   106	                || entity.fire_immune.load(Relaxed)
   107	                || entity.fire_ticks.load(Relaxed) <= 0
   108	            {
   109	                return false;
   110	            }
   111	
   112	            let world = entity.world.load();
   113	
   114	            // Must be bright outside (daylight)
   115	            let is_fixed_time = world.dimension.fixed_time.is_some();
   116	            let sky_darken = world.sky_darken.load(Relaxed);
   117	            if is_fixed_time || sky_darken >= BRIGHT_OUTSIDE_THRESHOLD {
   118	                return false;
   119	            }
   120	
   121	            // Must be able to see the sky from current position (exposed to sun)
   122	            let current_pos = entity.block_pos.load();
   123	            if !world.can_see_sky(&current_pos) {
   124	                return false;
   125	            }
   126	
   127	            // Cannot have head armor (which protects from sun)
   128	            if let Ok(eq) = living.entity_equipment.try_lock() {
   129	                use pumpkin_data::data_component_impl::EquipmentSlot;
   130	                let head_item = eq.get(&EquipmentSlot::HEAD);
   131	                if !head_item.is_empty() {
   132	                    return false;
   133	                }
   134	            }
   135	
   136	            // Try to find a shelter to flee to
   137	            self.target = Self::find_shelter(mob);
   138	            self.target.is_some()
   139	        })
   140	    }
   141	
   142	    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   143	        Box::pin(async move {
   144	            let navigator = mob.get_mob_entity().navigator.lock().unwrap();
   145	            !navigator.is_idle()
   146	        })
   147	    }
   148	
   149	    fn start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   150	        Box::pin(async move {
   151	            if let Some(target) = self.target {
   152	                let entity = &mob.get_mob_entity().living_entity.entity;
   153	                let pos = entity.pos.load();
   154	                let mut navigator = mob.get_mob_entity().navigator.lock().unwrap();
   155	                navigator.set_progress(NavigatorGoal::new(pos, target, self.speed));
   156	            }
   157	        })
   158	    }
   159	
   160	    fn stop<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   161	        Box::pin(async move {
   162	            self.target = None;
   163	        })
   164	    }
   165	
   166	    fn controls(&self) -> Controls {
   167	        self.goal_control
   168	    }
   169	}

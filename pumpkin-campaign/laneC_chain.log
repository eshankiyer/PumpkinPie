   154	async fn fetch_profile_by_name_helper(server: &Server, name: &str) -> Option<GameProfile> {
   155	    if let Some(player) = server.get_player_by_name(name) {
   156	        return Some(player.gameprofile.clone());
   157	    }
   158	
   159	    let cached_entry = server.data.user_cache.write().await.get_by_name(name);
   160	
   161	    let auth_config = server
   162	        .advanced_config
   163	        .networking
   164	        .java
   165	        .authentication
   166	        .clone();
   167	    let name_string = name.to_string();
   168	
   169	    let mojang_res =
   170	        tokio::task::spawn_blocking(move || lookup_profile_by_name(&name_string, &auth_config))
   171	            .await
   172	            .ok()
   173	            .and_then(Result::ok)
   174	            .flatten();
   175	
   176	    if let Some((uuid, resolved_name)) = mojang_res {
   177	        server
   178	            .data
   179	            .user_cache
   180	            .write()
   181	            .await
   182	            .upsert(uuid, resolved_name.clone());
   183	        let auth_config_clone = server
   184	            .advanced_config
   185	            .networking
   186	            .java
   187	            .authentication
   188	            .clone();
   189	        let full_profile =
   190	            tokio::task::spawn_blocking(move || fetch_profile_by_uuid(uuid, &auth_config_clone))
   191	                .await
   192	                .ok()
   193	                .and_then(Result::ok)
   194	                .flatten();
   195	
   196	        return Some(full_profile.unwrap_or_else(|| GameProfile {
   197	            id: uuid,
   198	            name: resolved_name,
   199	            properties: arc_swap::ArcSwap::new(Arc::new(vec![])),
   200	            profile_actions: None,
   201	        }));
   202	    }
   203	
   204	    if let Some(entry) = cached_entry {
   205	        return Some(GameProfile {
   206	            id: entry.uuid,
   207	            name: entry.name,
   208	            properties: arc_swap::ArcSwap::new(Arc::new(vec![])),
   209	            profile_actions: None,
   210	        });
   211	    }
   212	
   213	    if !server.advanced_config.networking.java.online_mode
   214	        && let Ok(uuid) = offline_uuid(name)
   215	    {
   216	        let profile = GameProfile {
   217	            id: uuid,
   218	            name: name.to_string(),
   219	            properties: arc_swap::ArcSwap::new(Arc::new(vec![])),
   220	            profile_actions: None,
   221	        };
   222	        server
   223	            .data
   224	            .user_cache
   225	            .write()
   226	            .await
   227	            .upsert(uuid, name.to_string());
   228	        return Some(profile);
   229	    }
   230	
   231	    None
   232	}

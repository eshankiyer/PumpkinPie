    38	
    39	        let level_info = player.world().level_info.load();
    40	        let difficulty = level_info.difficulty;
    41	        let natural_regen = level_info.game_rules.natural_health_regeneration;
    42	        let health = player.living_entity.health.load();
    43	        let can_heal = player.can_food_heal();
    44	
    45	        let mut needs_sync = false;
    46	        let mut heal_amount = 0.0;
    47	        let mut damage_amount = 0.0;
    48	
    49	        if exhaustion > EXHAUSTION_COST {
    50	            exhaustion -= EXHAUSTION_COST;
    51	            if saturation > 0.0 {
    52	                saturation = (saturation - 1.0).max(0.0);
    53	            } else if difficulty != Difficulty::Peaceful {
    54	                level = level.saturating_sub(1);
    55	            }
    56	            needs_sync = true;
    57	        }
    58	
    59	        if natural_regen && saturation > 0.0 && can_heal && level >= 20 {
    60	            timer += 1;
    61	            if timer >= 10 {
    62	                // `FoodData.tick`: the saturation spent is charged as exhaustion, which the
    63	                // branch above turns into saturation loss at four exhaustion per point.
    64	                // Subtracting it here as well spent it about five times too fast.
    65	                let cost = saturation.min(6.0);
    66	                exhaustion += cost;
    67	                heal_amount = cost / 6.0;
    68	                timer = 0;
    69	                needs_sync = true;
    70	            }
    71	        } else if natural_regen && level >= 18 && can_heal {
    72	            timer += 1;
    73	            if timer >= 80 {
    74	                heal_amount = 1.0;
    75	                exhaustion += 6.0;
    76	                timer = 0;
    77	                needs_sync = true;
    78	            }
    79	        } else if level == 0 {
    80	            timer += 1;
    81	            if timer >= 80 {
    82	                timer = 0;
    83	                let should_starve = match difficulty {
    84	                    Difficulty::Peaceful | Difficulty::Easy => health > 10.0,
    85	                    Difficulty::Normal => health > 1.0,
    86	                    Difficulty::Hard => true,
    87	                };
    88	
    89	                if should_starve {
    90	                    damage_amount = 1.0;
    91	                }
    92	                self.tick_timer.store(0);
    93	            }
    94	        } else {
    95	            timer = 0;
    96	        }
    97	
    98	        if needs_sync || timer != self.tick_timer.load() {
    99	            self.level.store(level);
   100	            self.saturation.store(saturation);
   101	            self.exhaustion.store(exhaustion);
   102	            self.tick_timer.store(timer);
   103	        }
   104	
   105	        if needs_sync {
   106	            player.send_health().await;
   107	        }
   108	        if heal_amount > 0.0 {
   109	            player.heal(heal_amount).await;
   110	        }
   111	        if damage_amount > 0.0 {
   112	            player
   113	                .damage(&**player, damage_amount, DamageType::STARVE)
   114	                .await;
   115	        }
   116	    }

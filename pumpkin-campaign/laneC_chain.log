   249	    /// Calculates the collision time with another bounding box along a movement vector.
   250	    ///
   251	    /// # Arguments
   252	    /// * `other` – The bounding box to test collision against.
   253	    /// * `movement` – Movement vector of this box.
   254	    /// * `axis` – Axis along which to calculate collision.
   255	    /// * `max_time` – Maximum allowed collision time.
   256	    ///
   257	    /// # Returns
   258	    /// Some(f64) if a collision occurs within `max_time`, None otherwise.
   259	    #[must_use]
   260	    pub fn calculate_collision_time(
   261	        &self,
   262	        other: &Self,
   263	        movement: Vector3<f64>,
   264	        axis: Axis,
   265	        max_time: f64, // NOTE: Start with 1.0
   266	    ) -> Option<f64> {
   267	        let movement_on_axis = movement.get_axis(axis);
   268	
   269	        if movement_on_axis == 0.0 {
   270	            return None;
   271	        }
   272	
   273	        let move_positive = movement_on_axis.is_sign_positive();
   274	        let self_plane_const = self.get_side(move_positive).get_axis(axis);
   275	        let other_plane_const = other.get_side(!move_positive).get_axis(axis);
   276	        let collision_time = (other_plane_const - self_plane_const) / movement_on_axis;
   277	
   278	        if collision_time < 0.0 || collision_time >= max_time {
   279	            return None;
   280	        }
   281	
   282	        let self_moved = self.shift(movement * collision_time);
   283	        let self_plane_moved = BoundingPlane::from_box(&self_moved, axis);
   284	        let other_plane = BoundingPlane::from_box(other, axis);
   285	
   286	        if !self_plane_moved.intersects(&other_plane) {
   287	            return None;
   288	        }
   289	
   290	        Some(collision_time)
   291	    }
   292	
   293	    /// Returns the average side length of the bounding box.
   294	    #[must_use]
   295	    pub fn get_average_side_length(&self) -> f64 {
   296	        let width = self.max.x - self.min.x;
   297	        let height = self.max.y - self.min.y;
   298	        let depth = self.max.z - self.min.z;
   299	
   300	        (width + height + depth) / 3.0
   301	    }

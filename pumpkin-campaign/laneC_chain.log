     1	package net.minecraft.world.level.levelgen.structure.pools;
     2	
     3	import com.mojang.datafixers.util.Either;
     4	import com.mojang.serialization.Codec;
     5	import com.mojang.serialization.codecs.RecordCodecBuilder;
     6	import java.util.function.Function;
     7	import net.minecraft.util.ExtraCodecs;
     8	
     9	public record DimensionPadding(int bottom, int top) {
    10	   private static final Codec<DimensionPadding> RECORD_CODEC = RecordCodecBuilder.create(
    11	      i -> i.group(
    12	            ExtraCodecs.NON_NEGATIVE_INT.lenientOptionalFieldOf("bottom", 0).forGetter(r -> r.bottom),
    13	            ExtraCodecs.NON_NEGATIVE_INT.lenientOptionalFieldOf("top", 0).forGetter(r -> r.top)
    14	         )
    15	         .apply(i, DimensionPadding::new)
    16	   );
    17	   public static final Codec<DimensionPadding> CODEC = Codec.either(ExtraCodecs.NON_NEGATIVE_INT, RECORD_CODEC)
    18	      .xmap(
    19	         e -> e.map(DimensionPadding::new, Function.identity()),
    20	         padding -> padding.hasEqualTopAndBottom() ? Either.left(padding.bottom) : Either.right(padding)
    21	      );
    22	   public static final DimensionPadding ZERO = new DimensionPadding(0);
    23	
    24	   public DimensionPadding(final int value) {
    25	      this(value, value);
    26	   }
    27	
    28	   public boolean hasEqualTopAndBottom() {
    29	      return this.top == this.bottom;
    30	   }
    31	}

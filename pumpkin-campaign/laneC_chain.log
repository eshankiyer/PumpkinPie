   994	   private static RedirectModifier<CommandSourceStack> expandOneToOneEntityRelation(final Function<Entity, Optional<Entity>> unpacker) {
   995	      return context -> {
   996	         CommandSourceStack source = context.getSource();
   997	         Entity entity = source.getEntity();
   998	         return entity == null ? List.of() : unpacker.apply(entity).filter(e -> !e.isRemoved()).map(e -> List.of(source.withEntity(e))).orElse(List.of());
   999	      };
  1000	   }

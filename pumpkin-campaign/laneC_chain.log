   118	    /// Vanilla `FoodData.eat(FoodProperties)`, which forwards the component's
   119	    /// `saturation()` straight to `FoodData.add` -- the value is already absolute,
   120	    /// not a modifier, so no `FoodConstants.saturationByModifier` scaling applies.
   121	    pub async fn eat(&self, player: &Player, food: u8, saturation: f32) {
   122	        let new_level = self.level.load().saturating_add(food).min(MAX_FOOD);
   123	        let new_sat = (self.saturation.load() + saturation).clamp(0.0, f32::from(new_level));
   124	
   125	        self.level.store(new_level);
   126	        self.saturation.store(new_sat);
   127	
   128	        player.send_health().await;
   129	    }

   385	pub fn register(dispatcher: &mut CommandDispatcher, registry: &PermissionRegistry) {
   386	    registry.register_permission_or_panic(Permission::new(
   387	        PERMISSION,
   388	        DESCRIPTION,
   389	        PermissionDefault::Op(PermissionLvl::Two),
   390	    ));
   391	
   392	    dispatcher.register(
   393	        command("fetchprofile", DESCRIPTION)
   394	            .requires(PERMISSION)
   395	            .then(literal("name").then(
   396	                argument(ARG_NAME, StringArgumentType::GreedyPhrase).executes(ResolveNameExecutor),
   397	            ))
   398	            .then(
   399	                literal("id").then(argument(ARG_ID, UuidArgumentType).executes(ResolveIdExecutor)),
   400	            )
   401	            .then(literal("entity").then(
   402	                argument(ARG_ENTITY, EntityArgumentType::Entity).executes(PrintForEntityExecutor),
   403	            )),
   404	    );
   405	}

     1	use std::io::{Error, Write};
     2	
     3	use crate::{
     4	    codec::{var_int::VarInt, var_long::VarLong, var_uint::VarUInt},
     5	    serial::PacketWrite,
     6	};
     7	use pumpkin_macros::packet;
     8	
     9	#[derive(PacketWrite)]
    10	#[packet(107)]
    11	pub struct CSetDisplayObjective {
    12	    pub display_slot: String,
    13	    pub objective_name: String,
    14	    pub display_name: String,
    15	    pub criteria_name: String,
    16	    pub sort_order: VarInt,
    17	}
    18	
    19	#[packet(108)]
    20	pub struct CSetScore {
    21	    pub action: VarInt, // 0 = change, 1 = remove
    22	    pub entries: Vec<ScoreEntry>,
    23	}
    24	
    25	impl PacketWrite for CSetScore {
    26	    fn write<W: Write>(&self, writer: &mut W) -> Result<(), Error> {
    27	        VarUInt(self.entries.len() as u32).write(writer)?;
    28	        for entry in &self.entries {
    29	            let entry_type = if self.action.0 == 1 {
    30	                0
    31	            } else {
    32	                entry.entry_type.0
    33	            };
    34	            VarUInt(entry_type as u32).write(writer)?;
    35	            match entry_type {
    36	                0 => "remove".write(writer)?,
    37	                1 => "changeplayer".write(writer)?,
    38	                2 => "changeentity".write(writer)?,
    39	                3 => "changefakeplayer".write(writer)?,
    40	                _ => return Err(Error::other("Invalid scoreboard entry type")),
    41	            }
    42	            entry.write_for_type(writer, entry_type)?;
    43	        }
    44	        Ok(())
    45	    }
    46	}
    47	
    48	pub struct ScoreEntry {
    49	    pub scoreboard_id: i64,
    50	    pub objective_name: String,
    51	    pub score: VarInt,
    52	    pub entry_type: VarInt, // 1 = player, 2 = entity, 3 = fake player
    53	    pub entity_unique_id: i64,
    54	    pub custom_name: String,
    55	}
    56	
    57	impl PacketWrite for ScoreEntry {
    58	    fn write<W: Write>(&self, writer: &mut W) -> Result<(), Error> {
    59	        self.write_for_type(writer, self.entry_type.0)
    60	    }
    61	}
    62	
    63	impl ScoreEntry {
    64	    fn write_for_type<W: Write>(&self, writer: &mut W, entry_type: i32) -> Result<(), Error> {
    65	        VarLong(self.scoreboard_id).write(writer)?;
    66	        if entry_type == 0 {
    67	            (!self.objective_name.is_empty()).write(writer)?;
    68	            if !self.objective_name.is_empty() {
    69	                self.objective_name.write(writer)?;
    70	            }
    71	            return Ok(());
    72	        }
    73	        if self.objective_name.is_empty() {
    74	            " ".write(writer)?;
    75	        } else {
    76	            self.objective_name.write(writer)?;
    77	        }
    78	        self.score.0.write(writer)?;
    79	        match entry_type {
    80	            1 | 2 => {
    81	                VarLong(self.entity_unique_id).write(writer)?;
    82	            }
    83	            3 => {
    84	                if self.custom_name.is_empty() {
    85	                    " ".write(writer)?;
    86	                } else {
    87	                    self.custom_name.write(writer)?;
    88	                }
    89	            }
    90	            _ => {}
    91	        }
    92	        Ok(())
    93	    }
    94	}
    95	

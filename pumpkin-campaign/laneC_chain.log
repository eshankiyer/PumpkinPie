--- crates/pumpkin-protocol/src/java/client/play/set_equipment.rs ---
     1	use std::io::Write;
     2	
     3	use crate::{
     4	    ClientPacket, ServerPacket, VarInt,
     5	    codec::item_stack_seralizer::ItemStackSerializer,
     6	    ser::{NetworkReadExt, NetworkWriteExt, ReadingError, WritingError},
     7	};
     8	use pumpkin_data::packet::clientbound::play::SET_EQUIPMENT;
     9	use pumpkin_macros::java_packet;
    10	use pumpkin_util::version::JavaMinecraftVersion;
    11	
    12	#[must_use]
    13	pub fn slot_to_version(slot: i8, version: &JavaMinecraftVersion) -> i8 {
    14	    if *version <= JavaMinecraftVersion::V_1_8 {
    15	        match slot {
    16	            0 => 0, // MainHand -> Held
    17	            2 => 1, // Feet -> Boots
    18	            3 => 2, // Legs -> Leggings
    19	            4 => 3, // Chest -> Chestplate
    20	            5 => 4, // Head -> Helmet
    21	            _ => slot,
    22	        }
    23	    } else {
    24	        slot
    25	    }
    26	}
    27	
    28	#[must_use]
    29	pub fn slot_from_version(slot: i8, version: &JavaMinecraftVersion) -> i8 {
    30	    if *version <= JavaMinecraftVersion::V_1_8 {
    31	        match slot {
    32	            0 => 0, // Held -> MainHand
    33	            1 => 2, // Boots -> Feet
    34	            2 => 3, // Leggings -> Legs
    35	            3 => 4, // Chestplate -> Chest
    36	            4 => 5, // Helmet -> Head
    37	            _ => slot,
    38	        }
    39	    } else {
    40	        slot
    41	    }
    42	}
    43	
    44	#[java_packet(SET_EQUIPMENT)]
    45	#[derive(Clone)]
    46	pub struct CSetEquipment {
    47	    pub entity_id: VarInt,
    48	    pub equipment: Vec<(i8, ItemStackSerializer<'static>)>,
    49	}
    50	
    51	impl CSetEquipment {
    52	    #[must_use]
    53	    pub const fn new(
    54	        entity_id: VarInt,
    55	        equipment: Vec<(i8, ItemStackSerializer<'static>)>,
    56	    ) -> Self {
    57	        Self {
    58	            entity_id,
    59	            equipment,
    60	        }
    61	    }
    62	}
    63	
    64	impl ClientPacket for CSetEquipment {
    65	    fn write_packet_data(
    66	        &self,
    67	        mut write: impl Write,
    68	        version: &JavaMinecraftVersion,
    69	    ) -> Result<(), WritingError> {
    70	        if *version <= JavaMinecraftVersion::V_1_7_6 {
    71	            write.write_i32_be(self.entity_id.0)?;
    72	        } else {
    73	            write.write_var_int(&self.entity_id)?;
    74	        }
    75	
    76	        if *version >= JavaMinecraftVersion::V_1_16 {
    77	            let size = self.equipment.len();
    78	            for (i, equipment) in self.equipment.iter().enumerate() {
    79	                let slot = equipment.0;
    80	                let last = i == size - 1;
    81	                let slot_byte = if last { slot } else { slot | -128 };
    82	                write.write_i8(slot_byte)?;
    83	                equipment.1.write_with_version(&mut write, version)?;
    84	            }
    85	        } else if let Some(equipment) = self.equipment.first() {
    86	            let slot = slot_to_version(equipment.0, version);
    87	            if *version >= JavaMinecraftVersion::V_1_9 {
    88	                write.write_var_int(&VarInt(i32::from(slot)))?;
    89	            } else {
    90	                write.write_i16_be(i16::from(slot))?;
    91	            }
    92	            equipment.1.write_with_version(&mut write, version)?;
    93	        }
    94	
    95	        Ok(())
    96	    }
    97	}
    98	
    99	impl<'a> ServerPacket<'a> for CSetEquipment {
   100	    fn read(bytebuf: &mut &'a [u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
   101	        let entity_id = if *version <= JavaMinecraftVersion::V_1_7_6 {
   102	            VarInt(bytebuf.get_i32_be()?)
   103	        } else {
   104	            bytebuf.get_var_int()?
   105	        };
   106	
   107	        let equipment = if *version >= JavaMinecraftVersion::V_1_16 {
   108	            let mut equipment = Vec::new();
   109	            loop {
   110	                let value = bytebuf.get_u8()?;
   111	                let slot = (value & 0x7F) as i8;
   112	                let item = ItemStackSerializer::read_with_version(bytebuf, version)?;
   113	                equipment.push((slot, item));
   114	                if (value & 0x80) == 0 {
   115	                    break;
   116	                }
   117	            }
   118	            equipment
   119	        } else if *version >= JavaMinecraftVersion::V_1_9 {
   120	            let slot = bytebuf.get_var_int()?.0 as i8;
   121	            let item = ItemStackSerializer::read_with_version(bytebuf, version)?;
   122	            vec![(slot, item)]
   123	        } else {
   124	            let raw_slot = bytebuf.get_i16_be()? as i8;
   125	            let slot = slot_from_version(raw_slot, version);
   126	            let item = ItemStackSerializer::read_with_version(bytebuf, version)?;
   127	            vec![(slot, item)]
   128	        };
   129	
   130	        Ok(Self {
   131	            entity_id,
   132	            equipment,
   133	        })
   134	    }
   135	}

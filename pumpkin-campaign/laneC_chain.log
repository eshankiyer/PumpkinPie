   336	    /// Stretches this bounding box along each axis by a given vector.
   337	    ///
   338	    /// # Arguments
   339	    /// * `other` – Vector specifying how much to stretch along each axis.
   340	    #[must_use]
   341	    pub const fn stretch(&self, other: Vector3<f64>) -> Self {
   342	        let mut new = *self;
   343	
   344	        if other.x < 0.0 {
   345	            new.min.x += other.x;
   346	        } else if other.x > 0.0 {
   347	            new.max.x += other.x;
   348	        }
   349	
   350	        if other.y < 0.0 {
   351	            new.min.y += other.y;
   352	        } else if other.y > 0.0 {
   353	            new.max.y += other.y;
   354	        }
   355	
   356	        if other.z < 0.0 {
   357	            new.min.z += other.z;
   358	        } else if other.z > 0.0 {
   359	            new.max.z += other.z;
   360	        }

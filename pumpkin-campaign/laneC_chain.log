/// ([`FunctionLine::Macro`], vanilla `MacroEntry`,
/// `MacroFunction.java:119-147`).
#[derive(Clone, Debug)]
pub enum FunctionLine {
    Plain(String),
    Macro(MacroTemplate),
}


   284	            tokio::spawn(async move {
   285	                let name_component = TextComponent::text(name_owned.clone());
   286	                let result = fetch_profile_by_name_helper(&server, &name_owned).await;
   287	                match result {
   288	                    Some(profile) => {
   289	                        report_resolved_profile(
   290	                            &source,
   291	                            &profile,
   292	                            translation::java::COMMANDS_FETCHPROFILE_NAME_SUCCESS,
   293	                            name_component,
   294	                        )
   295	                        .await;
   296	                    }
   297	                    None => {
   298	                        source
   299	                            .send_error(TextComponent::translate_cross(
   300	                                translation::java::COMMANDS_FETCHPROFILE_NAME_FAILURE,
   301	                                translation::java::COMMANDS_FETCHPROFILE_NAME_FAILURE,
   302	                                [name_component],
   303	                            ))
   304	                            .await;
   305	                    }
   306	                }
   307	            });
   308	
   309	            Ok(1)
   310	        })
   311	    }
   312	}

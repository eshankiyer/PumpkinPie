    17	
    18	impl CUpdateTime {
    19	    #[must_use]
    20	    pub fn new(game_time: i64, day_time: i64, increasing: bool) -> Self {
    21	        let overworld_id = 0;
    22	        let partial_tick = 0.0f32;
    23	        let rate = if increasing { 1.0f32 } else { 0.0f32 }; // Normal speed
    24	        Self {

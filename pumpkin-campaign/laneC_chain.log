    33	        clock_id: i32,
    34	        total_ticks: i64,
    35	        partial_tick: f32,
    36	        rate: f32,
    37	    ) -> Self {
    38	        Self {
    39	            game_time,
    40	            clock_updates: vec![(clock_id, total_ticks, partial_tick, rate)],
    41	        }
    42	    }

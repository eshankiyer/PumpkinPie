   595	fn set_redirects_to_execute(tree: &mut Tree, parent: NodeId, execute_id: CommandNodeId) {
   596	    for child_id in tree.get_children(parent) {
   597	        if let Some(redirect) = tree[child_id].redirect()
   598	            && matches!(redirect, Redirection::Root)
   599	            && tree[child_id].name() != "run"
   600	        {
   601	            tree[child_id].set_redirect(Some(Redirection::Local(NodeId::from(execute_id))));
   602	        }
   603	        set_redirects_to_execute(tree, child_id, execute_id);
   604	    }
   605	}

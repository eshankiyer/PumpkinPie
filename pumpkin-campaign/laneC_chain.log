    25	impl ItemBehaviour for EndCrystalItem {
    26	    fn use_on_block<'a>(
    27	        &'a self,
    28	        item: &'a mut ItemStack,
    29	        player: &'a Player,
    30	        location: BlockPos,
    31	        _face: BlockDirection,
    32	        _cursor_pos: Vector3<f32>,
    33	        _block: &'a Block,
    34	        _server: &'a Server,
    35	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    36	        Box::pin(async move {
    37	            let world = player.world();
    38	            let block = world.get_block(&location);
    39	            if block != &Block::OBSIDIAN && block != &Block::BEDROCK {
    40	                return;
    41	            }
    42	
    43	            let location = location.up();
    44	            let location_vec = location.0.to_f64();
    45	
    46	            if !world.get_block_state(&location).is_air()
    47	                || !world
    48	                    .get_entities_at_box(&BoundingBox::new(
    49	                        Vector3::new(location_vec.x, location_vec.y, location_vec.z),
    50	                        Vector3::new(
    51	                            location_vec.x + 1.0,
    52	                            location_vec.y + 2.0,
    53	                            location_vec.z + 1.0,
    54	                        ),
    55	                    ))
    56	                    .is_empty()
    57	            {
    58	                return;
    59	            }
    60	
    61	            let entity = Entity::new(world.clone(), location.to_f64(), &EntityType::END_CRYSTAL);
    62	            let end_crystal = Arc::new(EndCrystalEntity::new(entity));
    63	            world.spawn_entity(end_crystal.clone()).await;
    64	            end_crystal.set_show_bottom(false);
    65	
    66	            // `EndCrystalItem.useOn` (`EndCrystalItem.java:57`): placing a crystal emits
    67	            // ENTITY_PLACE at the position above the clicked block.
    68	            if let Some(player_arc) = world.get_player_by_id(player.living_entity.entity.entity_id)
    69	            {
    70	                crate::world::game_event::emit_game_event(
    71	                    &world,
    72	                    pumpkin_data::game_event::GameEvent::EntityPlace,
    73	                    location.to_f64(),
    74	                    crate::world::game_event::GameEventContext::of_entity(player_arc),
    75	                )
    76	                .await;
    77	            }
    78	
    79	            // `EndCrystalItem.useOn` (`EndCrystalItem.java:58-61`): every placed crystal
    80	            // retries the dragon respawn ritual, which only fires once the four cardinal
    81	            // crystals are in place (`EnderDragonFight.tryRespawn`).
    82	            if let Some(ref fight_mutex) = world.dragon_fight {
    83	                fight_mutex.lock().await.try_respawn(&world).await;
    84	            }
    85	
    86	            item.decrement_unless_creative(player.gamemode.load(), 1);
    87	        })
    88	    }

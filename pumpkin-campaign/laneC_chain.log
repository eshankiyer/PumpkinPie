    10	public class ClientboundSetPassengersPacket implements Packet<ClientGamePacketListener> {
    11	   public static final StreamCodec<FriendlyByteBuf, ClientboundSetPassengersPacket> STREAM_CODEC = Packet.codec(
    12	      ClientboundSetPassengersPacket::write, ClientboundSetPassengersPacket::new
    13	   );
    14	   private final int vehicle;
    15	   private final int[] passengers;
    16	
    17	   public ClientboundSetPassengersPacket(final Entity vehicle) {
    18	      this.vehicle = vehicle.getId();
    19	      List<Entity> entities = vehicle.getPassengers();
    20	      this.passengers = new int[entities.size()];
    21	
    22	      for (int i = 0; i < entities.size(); i++) {
    23	         this.passengers[i] = entities.get(i).getId();
    24	      }
    25	   }
    26	

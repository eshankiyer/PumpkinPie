    16	/// `Util.shuffle`: Fisher-Yates from the end, `random.nextInt(i)` per swap. Must match this
    17	/// exact call order (not e.g. shuffling from the front) to stay seed-reproducible with vanilla.
    18	pub fn shuffle<T>(slice: &mut [T], random: &mut RandomGenerator) {
    19	    let mut i = slice.len();
    20	    while i > 1 {
    21	        let swap_to = random.next_bounded_i32(i as i32) as usize;
    22	        slice.swap(i - 1, swap_to);
    23	        i -= 1;
    24	    }
    25	}
    26	
    27	pub struct CoralFeature;
    28	
    29	impl CoralFeature {
    30	    pub fn generate_coral_piece<T: GenerationCache>(
    31	        chunk: &mut T,
    32	        _block_registry: &dyn WorldPortalExt,
    33	        random: &mut RandomGenerator,
    34	        state: &BlockState,
    35	        pos: BlockPos,
    36	    ) -> bool {
    37	        let block = GenerationCache::get_block_state(chunk, &pos.0).to_block_id();
    38	        let above_block = GenerationCache::get_block_state(chunk, &pos.up().0).to_block_id();
    39	
    40	        if block != BlockId::WATER && !block.has_tag(tag::Block::MINECRAFT_CORALS)
    41	            || above_block != BlockId::WATER
    42	        {
    43	            return false;
    44	        }
    45	        // Mirrors `CoralFeature.placeCoralBlock` (`CoralFeature.java:36-47`): once the
    46	        // water/coral and water-above predicates pass, the feature writes the coral at `pos`
    47	        // and places optional growth at `pos.above()`.
    48	        chunk.set_block_state(&pos.0, state);
    49	        if random.next_f32() < 0.25 {
    50	            let block_to_place_state =
    51	                Self::get_random_tag_entry(tag::Block::MINECRAFT_CORALS, random);
    52	            chunk.set_block_state(&pos.up().0, block_to_place_state);
    53	        } else if random.next_f32() < 0.05 {
    54	            let mut props = SeaPickleLikeProperties::default(&Block::SEA_PICKLE);
    55	            props.pickles = (random.next_bounded_i32(4) as u8) + 1;
    56	            let state_id = props.to_state_id(&Block::SEA_PICKLE);
    57	            let block_state = BlockState::from_id(state_id);
    58	            chunk.set_block_state(&pos.up().0, block_state);
    59	        }
    60	        for dir in BlockDirection::horizontal_worldgen() {
    61	            let dir_pos = pos.offset(dir.to_offset());
    62	            if random.next_f32() >= 0.2
    63	                || GenerationCache::get_block_state(chunk, &dir_pos.0).to_block_id() != Block::WATER
    64	            {
    65	                continue;
    66	            }
    67	            let wall_coral =
    68	                Self::get_random_tag_entry_block(tag::Block::MINECRAFT_WALL_CORALS, random);
    69	            let Some(properties) = wall_coral.properties(wall_coral.default_state.id) else {
    70	                continue;
    71	            };
    72	            let original_props = &properties.to_props();
    73	            // Set the right Axis
    74	            let props: Vec<(&str, &str)> = original_props
    75	                .iter()
    76	                .map(|(key, value)| {
    77	                    if *key == "facing" {
    78	                        (*key, dir.to_value())
    79	                    } else {
    80	                        (*key, *value)
    81	                    }
    82	                })
    83	                .collect();
    84	            let block_state_id = wall_coral.from_properties(&props).to_state_id(wall_coral);
    85	            chunk.set_block_state(&dir_pos.0, BlockState::from_id(block_state_id));
    86	        }
    87	
    88	        true
    89	    }
    90	
    91	    pub fn get_random_tag_entry(
    92	        tag: tag::Tag,
    93	        random: &mut RandomGenerator,
    94	    ) -> &'static BlockState {
    95	        let block = Self::get_random_tag_entry_block(tag, random);
    96	        block.default_state
    97	    }
    98	
    99	    pub fn get_random_tag_entry_block(
   100	        tag: tag::Tag,
   101	        random: &mut RandomGenerator,
   102	    ) -> &'static Block {
   103	        let values = tag.1;
   104	        let value = values[random.next_bounded_i32(values.len() as i32) as usize];
   105	        let id = BlockId::new(value).unwrap_or(BlockId::AIR);
   106	        id.to_block()
   107	    }
   108	}

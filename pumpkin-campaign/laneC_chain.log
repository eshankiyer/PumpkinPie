    20	      this.foodLevel = Mth.clamp(food + this.foodLevel, 0, 20);
    21	      this.saturationLevel = Mth.clamp(saturation + this.saturationLevel, 0.0F, this.foodLevel);
    22	   }
    23	
    24	   public void eat(final int food, final float saturationModifier) {
    25	      this.add(food, FoodConstants.saturationByModifier(food, saturationModifier));
    26	   }

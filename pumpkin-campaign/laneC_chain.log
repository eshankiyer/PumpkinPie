  1055	impl Vector3Ext for Vector3<f64> {
  1056	    fn distance_squared(self, other: Self) -> f64 {
  1057	        let (dx, dy, dz) = (self.x - other.x, self.y - other.y, self.z - other.z);
  1058	        dx * dx + dy * dy + dz * dz
  1059	    }

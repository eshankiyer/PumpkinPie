    31	        Box::pin(async move {
    32	            let Some(Arg::Entity(entity)) = args.get(&ARG_ENTITY) else {
    33	                return Err(InvalidConsumption(Some(ARG_ENTITY.into())));
    34	            };
    35	            display_data(entity.as_ref(), entity.get_display_name().await, sender).await
    36	        })
    37	    }
    38	}

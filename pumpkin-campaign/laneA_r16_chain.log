   564	                        .then(argument(ARG_PATH, crate::command::argument_types::nbt_path::NbtPathArgumentType)
   565	                            .executes(GetExecutor { target_kind: TargetKind::Block, has_path: true, has_scale: false })
   566	                            .then(argument(ARG_SCALE, DoubleArgumentType::any())
   567	                                .executes(GetExecutor { target_kind: TargetKind::Block, has_path: true, has_scale: true }))),
   568	                )),
   569	            ))
   570	            .then(literal("merge").then(
   571	                literal("entity").then(argument(ARG_ENTITY, EntityArgumentType::Entity).then(
   572	                    argument(ARG_NBT, NbtCompoundArgumentType).executes(MergeExecutor { target_kind: TargetKind::Entity }),
   573	                ))
   574	                .then(literal("block").then(argument(ARG_POS, BlockPosArgumentType).then(

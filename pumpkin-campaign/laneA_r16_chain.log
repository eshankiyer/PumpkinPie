   392	impl CommandExecutor for GetExecutor {
   393	    // Vanilla DataCommands.java:330-369 defines whole-tag, path, and scaled numeric get results.
   394	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   395	        Box::pin(async move {
   396	            let target = resolve_target(context, self.target_kind).await?;
   397	            let data = target.get_data().await;
   398	            if !self.has_path {
   399	                let root = NbtTag::Compound(data);
   400	                context
   401	                    .source
   402	                    .send_feedback(target.query_message(&root).await?, false)
   403	                    .await;
   404	                return Ok(1);
   405	            }
   406	
   407	            let path = context.get_argument::<NbtPath>(ARG_PATH)?;
   408	            let root = NbtTag::Compound(data);
   409	            let tag = get_single_tag(path, &root)?;
   410	            let value = if self.has_scale {
   411	                let scale = DoubleArgumentType::get(context, ARG_SCALE)?;
   412	                let NbtTag::Byte(_) | NbtTag::Short(_) | NbtTag::Int(_) | NbtTag::Long(_)
   413	                | NbtTag::Float(_) | NbtTag::Double(_) = tag
   414	                else {
   415	                    return Err(GET_NOT_NUMBER_ERROR.create_without_context(TextComponent::text(
   416	                        path.as_string(),
   417	                    )));
   418	                };
   419	                let numeric = match tag {
   420	                    NbtTag::Byte(value) => f64::from(*value),
   421	                    NbtTag::Short(value) => f64::from(*value),
   422	                    NbtTag::Int(value) => f64::from(*value),
   423	                    NbtTag::Long(value) => *value as f64,
   424	                    NbtTag::Float(value) => f64::from(*value),
   425	                    NbtTag::Double(value) => *value,
   426	                    _ => unreachable!(),
   427	                };
   428	                let value = (numeric * scale).floor() as i32;
   429	                context
   430	                    .source
   431	                    .send_feedback(target.get_message(path, scale, value).await, false)
   432	                    .await;
   433	                return Ok(value);
   434	            } else {
   435	                tag_result(tag, path)?
   436	            };
   437	            context
   438	                .source
   439	                .send_feedback(target.query_message(value).await?, false)
   440	                .await;
   441	            Ok(value_result(value))
   442	        })
   443	    }
   444	}

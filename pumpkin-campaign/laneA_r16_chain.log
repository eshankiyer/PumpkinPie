+#[derive(Clone, Debug, PartialEq)]
+pub enum PathNode {
+    CompoundChild(String),
+    MatchObject(String, NbtCompound),
+    MatchRootObject(NbtCompound),
+    IndexedElement(i32),
+    MatchElement(NbtCompound),
+    AllElements,

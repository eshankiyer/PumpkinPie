+            if !first_node {
+                return Err(INVALID_NODE_ERROR.create(reader));
+            }
+            Ok(PathNode::MatchRootObject(parse_compound(reader)?))
+        }
+        Some(_) => Ok(read_object_node(reader, read_unquoted_name(reader)?)?),
+        None => Err(INVALID_NODE_ERROR.create(reader)),
+    }

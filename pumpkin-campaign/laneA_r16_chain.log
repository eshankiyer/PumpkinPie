+    fn set_tag(&self, parent: &mut NbtTag, new_tag: &mut dyn FnMut() -> NbtTag) -> i32 {
+        match self {
+            Self::AllElements => {
+                let NbtTag::List(list) = parent else { return 0 };
+                let size = list.len();
+                if size == 0 {
+                    list.push(new_tag());
+                    return 1;
+                }
+                let first = new_tag();
+                let changed = size - list.iter().filter(|tag| **tag == first).count();
+                if changed == 0 {

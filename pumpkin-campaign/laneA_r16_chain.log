   449	
   450	impl CommandExecutor for MergeExecutor {
   451	    // Vanilla DataCommands.java:374-386 copies, merges, depth-checks, and rejects unchanged data.
   452	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   453	        Box::pin(async move {
   454	            let target = resolve_target(context, self.target_kind).await?;
   455	            let nbt = context.get_argument::<NbtCompound>(ARG_NBT)?.clone();
   456	            if NbtPath::is_too_deep(&NbtTag::Compound(nbt.clone()), 0) {
   457	                return Err(crate::command::argument_types::nbt_path::DATA_TOO_DEEP_ERROR.create_without_context());
   458	            }
   459	            let old = target.get_data().await;
   460	            let mut merged = old.clone();
   461	            merged.merge(&nbt);
   462	            if old == merged {
   463	                return Err(MERGE_UNCHANGED_ERROR.create_without_context());
   464	            }
   465	            target.set_data(context, merged).await?;
   466	            context
   467	                .source
   468	                .send_feedback(target.modified_message().await, true)
   469	                .await;
   470	            Ok(1)
   471	        })
   472	    }
   473	}

+fn tag_result<'a>(tag: &'a NbtTag, path: &NbtPath) -> Result<&'a NbtTag, CommandSyntaxError> {
+    if matches!(tag, NbtTag::End) {
+        Err(GET_NON_EXISTENT_ERROR.create_without_context(TextComponent::text(path.as_string())))
+    } else {
+        Ok(tag)
+    }
+}

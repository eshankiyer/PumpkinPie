   475	struct RemoveExecutor {
   476	    target_kind: TargetKind,
   477	}
   478	
   479	impl CommandExecutor for RemoveExecutor {
   480	    // Vanilla DataCommands.java:318-328 removes matching path nodes and rejects a zero count.
   481	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   482	        Box::pin(async move {
   483	            let target = resolve_target(context, self.target_kind).await?;
   484	            let path = context.get_argument::<NbtPath>(ARG_PATH)?;
   485	            let data = target.get_data().await;
   486	            let mut root = NbtTag::Compound(data);
   487	            let count = path.remove(&mut root);
   488	            if count == 0 {
   489	                return Err(MERGE_UNCHANGED_ERROR.create_without_context());
   490	            }
   491	            let NbtTag::Compound(data) = root else { unreachable!() };
   492	            target.set_data(context, data).await?;
   493	            context
   494	                .source
   495	                .send_feedback(target.modified_message().await, true)
   496	                .await;
   497	            Ok(count)
   498	        })
   499	    }
   500	}
   501	
   502	fn get_single_tag<'a>(path: &NbtPath, root: &'a NbtTag) -> Result<&'a NbtTag, CommandSyntaxError> {
   503	    let tags = path.get(root)?;
   504	    let Some(tag) = tags.first() else {
   505	        return Err(GET_NON_EXISTENT_ERROR.create_without_context(TextComponent::text(
   506	            path.as_string(),
   507	        )));
   508	    };
   509	    if tags.len() > 1 {
   510	        return Err(MULTIPLE_TAGS_ERROR.create_without_context());
   511	    }
   512	    Ok(tag)
   513	}
   514	
   515	fn tag_result<'a>(tag: &'a NbtTag, path: &NbtPath) -> Result<&'a NbtTag, CommandSyntaxError> {
   516	    if matches!(tag, NbtTag::End) {
   517	        Err(GET_NON_EXISTENT_ERROR.create_without_context(TextComponent::text(
   518	            path.as_string(),
   519	        )))
   520	    } else {
   521	        Ok(tag)
   522	    }
   523	}
   524	
   525	fn value_result(tag: &NbtTag) -> i32 {
   526	    match tag {
   527	        NbtTag::Byte(value) => i32::from(*value),
   528	        NbtTag::Short(value) => i32::from(*value),
   529	        NbtTag::Int(value) => *value,
   530	        NbtTag::Long(value) => (*value).clamp(i32::MIN as i64, i32::MAX as i64) as i32,
   531	        NbtTag::Float(value) => value.floor() as i32,
   532	        NbtTag::Double(value) => value.floor() as i32,
   533	        NbtTag::ByteArray(value) => value.len() as i32,
   534	        NbtTag::IntArray(value) => value.len() as i32,
   535	        NbtTag::LongArray(value) => value.len() as i32,
   536	        NbtTag::String(value) => value.len() as i32,
   537	        NbtTag::List(value) => value.len() as i32,
   538	        NbtTag::Compound(value) => value.child_tags.len() as i32,
   539	        NbtTag::End => 0,
   540	    }
   541	}

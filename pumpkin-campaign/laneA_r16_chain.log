+        Ok(Self {
+            original: reader.string()[start..reader.cursor()].to_owned(),
+            nodes,
+            node_positions,
+        })
+    }
+
+    fn collect<'a>(&self, tag: &'a NbtTag) -> Vec<&'a NbtTag> {
+        let mut current = vec![tag];
+        for node in &self.nodes {
+            let mut next = Vec::new();
+            for parent in current {

+    ) {
+        match self {
+            Self::AllElements => {
+                if let NbtTag::List(list) = parent {
+                    if list.is_empty() {
+                        list.push(preferred_parent.map_or_else(new_tag, PathNode::preferred_parent));
+                    }
+                    output.extend(list.iter_mut());
+                }
+            }
+            Self::CompoundChild(name) => {
+                if let NbtTag::Compound(compound) = parent {
+                    if !compound.has(name) {
+                        compound.put(name, preferred_parent.map_or_else(new_tag, PathNode::preferred_parent));
+                    }
+                    if let Some(tag) = compound.get_mut(name) {
+                        output.push(tag);
+                    }
+                }
+            }
+            Self::IndexedElement(index) => {

+pub const DATA_TOO_DEEP_ERROR: CommandErrorType<0> = CommandErrorType::new(
+    translation::java::ARGUMENTS_NBTPATH_TOO_DEEP,
+    translation::java::ARGUMENTS_NBTPATH_TOO_DEEP,
+);

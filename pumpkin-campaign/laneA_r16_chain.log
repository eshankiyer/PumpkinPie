impl CommandExecutor for BaseResetExecutor {
    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
        Box::pin(async move {
            let target = EntityArgumentType::get_entity(context, ARG_TARGET).await?;

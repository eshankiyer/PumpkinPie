   556	                        .then(argument(ARG_PATH, crate::command::argument_types::nbt_path::NbtPathArgumentType)
   557	                            .executes(GetExecutor { target_kind: TargetKind::Entity, has_path: true, has_scale: false })
   558	                            .then(argument(ARG_SCALE, DoubleArgumentType::any())
   559	                                .executes(GetExecutor { target_kind: TargetKind::Entity, has_path: true, has_scale: true }))),

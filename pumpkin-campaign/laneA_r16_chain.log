+impl NbtPath {
+    pub fn parse(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
+        let start = reader.cursor();
+        let mut nodes = Vec::new();
+        let mut node_positions = Vec::new();
+        let mut first_node = true;

+
+fn read_object_node(reader: &mut StringReader, name: String) -> Result<PathNode, CommandSyntaxError> {
+    if name.is_empty() {
+        return Err(INVALID_NODE_ERROR.create(reader));
+    }
+    if reader.peek() == Some('{') {
+        Ok(PathNode::MatchObject(name, parse_compound(reader)?))
+    } else {
+        Ok(PathNode::CompoundChild(name))
+    }

   197	                        self.queue.push_back(PropagationEntry { pos: neighbor_pos });
   198	                        self.visited.insert(neighbor_pos);
   199	                    }
   200	                }
   201	            }
   202	        }
   203	
   204	        self.propagate(cache); // Re-propagate from survivors
   205	    }

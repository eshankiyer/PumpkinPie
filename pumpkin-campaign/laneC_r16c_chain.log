   362	    /// Replays changes whose propagation reached an unloaded neighboring
   363	    /// chunk. This is the runtime equivalent of vanilla's light storage
   364	    /// retaining section work until `LevelLightEngine` can see the chunk.
   365	    #[expect(clippy::too_many_lines)]
   366	    pub fn on_chunk_loaded(&self, level: &Arc<Level>, chunk_pos: Vector2<i32>) {
   367	        let _processing = self
   368	            .processing
   369	            .lock()
   370	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   371	        let pending = {
   372	            let mut pending = self
   373	                .pending_border_updates
   374	                .lock()
   375	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   376	            std::mem::take(&mut *pending)
   377	        };
   378	
   379	        let mut retry = Vec::new();
   380	        let mut deferred = Vec::new();
   381	        for update in pending {
   382	            let source_loaded = level.is_chunk_loaded(&update.source_pos.chunk_position());
   383	            let target_loaded = level.is_chunk_loaded(&update.target_pos.chunk_position());
   384	            if (update.source_pos.chunk_position() == chunk_pos
   385	                || update.target_pos.chunk_position() == chunk_pos)
   386	                && source_loaded
   387	                && target_loaded
   388	            {
   389	                retry.push(update);
   390	            } else {
   391	                deferred.push(update);
   392	            }
   393	        }
   394	
   395	        if !deferred.is_empty() {
   396	            self.pending_border_updates
   397	                .lock()
   398	                .unwrap_or_else(std::sync::PoisonError::into_inner)
   399	                .extend(deferred);
   400	        }
   401	
   402	        let had_retry = !retry.is_empty();
   403	        // Vanilla drains decreases before increases. Keep the same phase order
   404	        // when a border becomes available so a stale increase cannot overwrite
   405	        // a removal merely because a set happened to iterate in another order.
   406	        // Keep replay deterministic even when several changes hit the same edge
   407	        // before the target chunk loads. Decreases always precede increases, and
   408	        // equal-phase entries have a stable position/direction/level order.
   409	        retry.sort_by_key(|update| {
   410	            let (kind, level, mode) = match update.update {
   411	                PendingBorderLightUpdate::BlockDecrease(level)
   412	                | PendingBorderLightUpdate::SkyDecrease(level) => (0u8, level, (0, 0)),
   413	                PendingBorderLightUpdate::BlockIncrease(level, mode)
   414	                | PendingBorderLightUpdate::SkyIncrease(level, mode) => {
   415	                    (1u8, level, mode.sort_key())
   416	                }
   417	            };
   418	            (
   419	                update.update.phase(),
   420	                kind,
   421	                update.source_pos.0.x,
   422	                update.source_pos.0.y,
   423	                update.source_pos.0.z,
   424	                update.target_pos.0.x,
   425	                update.target_pos.0.y,
   426	                update.target_pos.0.z,
   427	                update.direction.to_index(),
   428	                level,
   429	                mode.0,
   430	                mode.1,


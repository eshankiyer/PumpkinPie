   215	    fn mark_chunk_dirty(&self, level: &Level, pos: &BlockPos) {
   216	        let (chunk, _) = pos.chunk_and_chunk_relative_position();
   217	        self.dirty_chunks.push(chunk);
   218	
   219	        let min_y = level.world_gen.load().dimension().min_y;
   220	        let section_count = level.world_gen.load().dimension().height as usize / BlockPalette::SIZE;
   221	        if pos.0.y >= min_y {
   222	            let section = ((pos.0.y - min_y) as usize) / BlockPalette::SIZE;
   223	            if section < section_count {
   224	                self.dirty_sections
   225	                    .lock()
   226	                    .unwrap_or_else(std::sync::PoisonError::into_inner)
   227	                    .entry(chunk)
   228	                    .or_default()
   229	                    .insert(section);
   230	            }
   231	        }
   232	    }
   233	
   234	    /// Returns and clears the changed physical light sections per chunk.
   235	    pub fn take_dirty_sections(&self) -> Vec<(Vector2<i32>, Vec<usize>)> {
   236	        while self.dirty_chunks.pop().is_some() {}
   237	        let dirty = {
   238	            let mut dirty = self
   239	                .dirty_sections
   240	                .lock()
   241	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   242	            std::mem::take(&mut *dirty)
   243	        };
   244	        dirty
   245	            .into_iter()
   246	            .map(|(chunk, sections)| {
   247	                let mut sections: Vec<_> = sections.into_iter().collect();
   248	                sections.sort_unstable();
   249	                (chunk, sections)
   250	            })
   251	            .collect()
   252	    }
   253	
   254	    /// Returns and clears the chunks whose light arrays changed since the last call.
   255	    pub fn take_dirty_chunks(&self) -> Vec<Vector2<i32>> {
   256	        let mut chunks = HashSet::new();
   257	        while let Some(chunk) = self.dirty_chunks.pop() {
   258	            chunks.insert(chunk);
   259	        }
   260	        chunks.into_iter().collect()
   261	    }

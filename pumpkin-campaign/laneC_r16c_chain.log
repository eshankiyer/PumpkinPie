    70	/// Turns the unsupported stalactite starting at `position` into falling block entities.
    71	///
    72	/// minecraft.wiki, "Pointed Dripstone": "If the block supporting a stalactite or any block of
    73	/// the stalactite is broken, all of the unsupported pointed dripstone below the broken block
    74	/// drops, causing damage to any player and mobs standing beneath it, similar to a falling
    75	/// anvil." Only the tip segment hurts entities; the damage scales with the number of blocks
    76	/// in the falling stalactite (see [`stalactite_damage_per_distance`]).
    77	async fn spawn_falling_stalactite(world: &Arc<World>, position: &BlockPos) {
    78	    let mut segments = Vec::new();
    79	    let mut current = *position;
    80	    let mut has_tip = false;
    81	    loop {
    82	        let (block, state) = world.get_block_and_state(&current);
    83	        if !is_stalactite(block, state.id) {
    84	            break;
    85	        }
    86	        segments.push((current, state.id));
    87	        let props = PointedDripstoneLikeProperties::from_state_id(state.id, block);
    88	        if is_tip_thickness(props.thickness) {
    89	            has_tip = true;
    90	            break;
    91	        }
    92	        current = current.down();
    93	    }
    94	
    95	    let last_index = segments.len().saturating_sub(1);
    96	    let damage_per_distance = stalactite_damage_per_distance(segments.len());
    97	    for (index, (pos, state_id)) in segments.into_iter().enumerate() {
    98	        let hurts = (has_tip && index == last_index)
    99	            .then_some((damage_per_distance, STALACTITE_MAX_DAMAGE));
   100	        FallingEntity::replace_spawn_hurting(world, pos, state_id, hurts).await;
   101	    }
   102	}

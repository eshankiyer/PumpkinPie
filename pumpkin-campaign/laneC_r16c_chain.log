   108	/// Matches `LightEngine.hasDifferentLightProperties` (`LightEngine.java:41-48`)
   109	/// for the state pair supplied by a live block replacement.
   110	fn has_different_light_properties(
   111	    old_state: &'static pumpkin_data::BlockState,
   112	    new_state: &'static pumpkin_data::BlockState,
   113	) -> bool {
   114	    old_state != new_state
   115	        && (old_state.opacity != new_state.opacity
   116	            || old_state.luminance != new_state.luminance
   117	            || old_state.use_shape_for_light_occlusion
   118	            || new_state.use_shape_for_light_occlusion)
   119	}

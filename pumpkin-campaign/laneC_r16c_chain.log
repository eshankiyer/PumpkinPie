   217	impl BlockLightPropagator {
   218	    pub fn propagate_light(&mut self, cache: &mut Cache) {
   219	        self.clear();
   220	
   221	        //let scan_start = Instant::now();
   222	
   223	        let min_y = cache.bottom_y() as i32;
   224	        let max_y = min_y + cache.height() as i32;
   225	        let center_x = cache.x + (cache.size / 2);
   226	        let center_z = cache.z + (cache.size / 2);
   227	
   228	        let start_x = center_x * 16 - 1;
   229	        let start_z = center_z * 16 - 1;
   230	        let end_x = start_x + 18;
   231	        let end_z = start_z + 18;
   232	
   233	        for y in min_y..max_y {
   234	            for z in start_z..end_z {
   235	                for x in start_x..end_x {
   236	                    let pos_vec = Vector3::new(x, y, z);
   237	                    let state = cache.get_block_state(&pos_vec);
   238	                    let emission = state.to_state().luminance;
   239	                    if emission > 0 {
   240	                        let pos = BlockPos(pos_vec);
   241	                        set_block_light(cache, pos, emission);
   242	                        if self.visited.insert(pos) {
   243	                            // Block light propagates in all directions
   244	                            self.queue.push_back(PropagationEntry { pos });
   245	                        }
   246	                    }
   247	                }
   248	            }
   249	        }
   250	        //let scan_elapsed = scan_start.elapsed();
   251	        //let propagate_start = Instant::now();
   252	
   253	        self.propagate(cache);
   254	
   255	        //let propagate_elapsed = propagate_start.elapsed();
   256	        //log::info!("Block light timing - Scan: {:?}, Propagate: {:?}", scan_elapsed, propagate_elapsed);
   257	    }
   258	}

   189	        &self,
   190	        chunk: &mut T,
   191	        random: &mut RandomGenerator,
   192	        wind: &WindOffsetter,
   193	    ) {
   194	        for dx in -self.radius..=self.radius {
   195	            for dz in -self.radius..=self.radius {
   196	                let current_radius = ((dx * dx + dz * dz) as f32).sqrt();
   197	                if current_radius <= self.radius as f32 {
   198	                    let mut height = self.get_height_at_radius(current_radius);
   199	                    if height > 0 {
   200	                        if random.next_f32() < 0.2 {
   201	                            height = (height as f32 * random.next_inbetween_f32(0.8, 1.0)) as i32;
   202	                        }
   203	
   204	                        let mut pos = self.root.offset(Vector3::new(dx, 0, dz));
   205	                        let mut has_been_out_of_stone = false;
   206	                        // Only upward-growing columns stop at the world surface
   207	                        // (`LargeDripstoneFeature.java:175`).
   208	                        let max_y = if self.pointing_up {
   209	                            chunk.get_top_y(&HeightMap::WorldSurfaceWg, pos.0.x, pos.0.z)
   210	                        } else {
   211	                            i32::MAX
   212	                        };

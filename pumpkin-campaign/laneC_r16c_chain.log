   public void readBiomes(final FriendlyByteBuf buffer) {
      PalettedContainer<Holder<Biome>> biomes = this.biomes.recreate();
      biomes.read(buffer);
      this.biomes = biomes;
   }

   public void write(final FriendlyByteBuf buffer) {

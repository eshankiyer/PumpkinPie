   161	
   162	    fn update_sky_sources_for_change(
   163	        &self,
   164	        level: &Arc<Level>,
   165	        pos: BlockPos,
   166	        old_state: &'static pumpkin_data::BlockState,
   167	        new_state: &'static pumpkin_data::BlockState,
   168	    ) {
   169	        if old_state == new_state || !Self::has_skylight(level) {
   170	            return;
   171	        }
   172	
   173	        let old_source_y = Self::lowest_sky_source_y(level, &pos, Some((&pos, old_state)));
   174	        let new_source_y = Self::lowest_sky_source_y(level, &pos, Some((&pos, new_state)));
   175	        let min_y = level.world_gen.load().dimension().min_y;
   176	        let max_y = min_y + level.world_gen.load().dimension().height;
   177	        let old_start = old_source_y.clamp(min_y, max_y);
   178	        let new_start = new_source_y.clamp(min_y, max_y);
   179	
   180	        if old_start < new_start {
   181	            // The direct-sky column moved upward. Remove the old level-15
   182	            // source nodes before the normal decrease pass runs.
   183	            for y in old_start..new_start {
   184	                let source_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   185	                if self.get_sky_light_level(level, &source_pos) == 15 {
   186	                    self.set_sky_light_level(level, &source_pos, 0).ok();
   187	                    self.queue_sky_light_decrease(source_pos, 15);
   188	                }
   189	            }
   190	        } else if new_start < old_start {
   191	            // The column opened downward. Add the newly exposed source nodes.
   192	            for y in new_start..old_start {
   193	                let source_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   194	                self.set_sky_light_level(level, &source_pos, 15).ok();
   195	                self.queue_sky_light_increase(source_pos, 15);
   196	            }
   197	        }
   198	    }

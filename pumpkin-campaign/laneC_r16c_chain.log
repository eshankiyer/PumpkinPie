   350	
   351	      for (int i = 1; i < maxSteps; i++) {
   352	         mutablePos.move(direction);
   353	         BlockState state = level.getBlockState(mutablePos);
   354	         if (targetPredicate.test(state)) {
   355	            return Optional.of(mutablePos.immutable());

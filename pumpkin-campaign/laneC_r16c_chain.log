   204	    /// Vanilla's `LightEngine.getState` uses bedrock when the lighting source
   205	    /// cannot provide a loaded chunk. Treating an unloaded neighbor as air
   206	    /// would allow light to cross a chunk boundary that vanilla blocks.
   207	    fn state_for_lighting(level: &Level, pos: &BlockPos) -> &'static pumpkin_data::BlockState {
   208	        if level.is_chunk_loaded(&pos.chunk_position()) {
   209	            level.get_block_state(pos).to_state()
   210	        } else {
   211	            Block::BEDROCK.default_state
   212	        }
   213	    }

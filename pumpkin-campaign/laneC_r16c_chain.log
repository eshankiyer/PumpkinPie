   456	fn can_place_at_pos(
   457	    block_accessor: &dyn BlockAccessor,
   458	    speleothem: &Block,
   459	    position: &BlockPos,
   460	    placing_direction: Option<BlockDirection>,
   461	    player_option: Option<&Player>,
   462	) -> bool {
   463	    // Determine support block
   464	    let Some(support_block_vertical_direction) = get_support_block_vertical_direction(
   465	        block_accessor,
   466	        speleothem,
   467	        position,
   468	        placing_direction,
   469	        player_option,
   470	    ) else {
   471	        return false;
   472	    };
   473	    let support_pos = match support_block_vertical_direction {
   474	        VerticalDirection::Up => position.up(),
   475	        VerticalDirection::Down => position.down(),
   476	    };
   477	    let support_block = block_accessor.get_block(&support_pos);
   478	    if can_support_dripstone(support_block, speleothem) {
   479	        return true;
   480	    }
   481	    false
   482	}
   483	
   484	fn get_support_block_vertical_direction(
   485	    block_accessor: &dyn BlockAccessor,
   486	    speleothem: &Block,
   487	    position: &BlockPos,
   488	    placing_direction_wrapper: Option<BlockDirection>,
   489	    player_option: Option<&Player>,
   490	) -> Option<VerticalDirection> {
   491	    let Some(placing_direction) = placing_direction_wrapper else {
   492	        //then this is basically called by a neighbor update check
   493	        let (block, state) = block_accessor.get_block_and_state(position);
   494	        if block != speleothem {
   495	            return None;
   496	        }
   497	        let props = PointedDripstoneLikeProperties::from_state_id(state.id, block);
   498	        return Some(flip_dir(props.vertical_direction));
   499	    };
   500	    match block_direction_to_vertical_direction(placing_direction) {
   501	        Some(ver_dir) => match ver_dir {
   502	            VerticalDirection::Up => {
   503	                let block_above = block_accessor.get_block(&position.up());
   504	                let block_below = block_accessor.get_block(&position.down());
   505	                if can_support_dripstone(block_above, speleothem) {
   506	                    return Some(VerticalDirection::Up);
   507	                } else if can_support_dripstone(block_below, speleothem) {
   508	                    return Some(VerticalDirection::Down);
   509	                }
   510	                None
   511	            }
   512	            VerticalDirection::Down => {
   513	                let block_above = block_accessor.get_block(&position.up());
   514	                let block_below = block_accessor.get_block(&position.down());
   515	                if can_support_dripstone(block_below, speleothem) {
   516	                    return Some(VerticalDirection::Down);
   517	                } else if can_support_dripstone(block_above, speleothem) {
   518	                    return Some(VerticalDirection::Up);
   519	                }
   520	                None
   521	            }
   522	        },
   523	        None => player_option.map_or(Some(VerticalDirection::Up), |player| {
   524	            let (_, pitch) = player.rotation();
   525	            let (can_place_above, can_place_below) = {
   526	                let block_above = block_accessor.get_block(&position.up());
   527	                let block_below = block_accessor.get_block(&position.down());
   528	                (
   529	                    can_support_dripstone(block_above, speleothem),
   530	                    can_support_dripstone(block_below, speleothem),
   531	                )
   532	            };
   533	            match (can_place_above, can_place_below) {
   534	                (true, true) => {
   535	                    if pitch > 0.0 {
   536	                        Some(VerticalDirection::Down)
   537	                    } else {
   538	                        Some(VerticalDirection::Up)
   539	                    }
   540	                }
   541	                (false, false) => None,
   542	                (true, false) => Some(VerticalDirection::Up),
   543	                (false, true) => Some(VerticalDirection::Down),
   544	            }
   545	        }),
   546	    }
   547	}
   548	/// `SpeleothemBlock.isValidSpeleothemPlacement` (SpeleothemBlock.java:174-180): a sturdy face
   549	/// behind, or another speleothem of the *same* block (`behindState.is(this)`), so a sulfur
   550	/// spike never hangs off a pointed dripstone.
   551	fn can_support_dripstone(support_block: &Block, speleothem: &Block) -> bool {
   552	    if support_block == speleothem {
   553	        return true;
   554	    }
   555	    if support_block.default_state.is_full_cube() && support_block.default_state.is_solid_block() {
   556	        return true;
   557	    }
   558	    false
   559	}
   560	async fn modify_dripstone_thickness_to(
   561	    world: &Arc<World>,
   562	    speleothem: &Block,
   563	    pos: &BlockPos,
   564	    new_thickness: SpeleothemThickness,
   565	) {
   566	    let (block, support_block_state_id) = world.get_block_and_state_id(pos);
   567	
   568	    if block != speleothem {
   569	        //this shouldn't happen
   570	        return;
   571	    }
   572	    let mut support_props =
   573	        PointedDripstoneLikeProperties::from_state_id(support_block_state_id, block);
   574	    if support_props.thickness == new_thickness {
   575	        return;
   576	    }
   577	    support_props.thickness = new_thickness;
   578	    world
   579	        .set_block_state(
   580	            pos,
   581	            support_props.to_state_id(speleothem),
   582	            BlockFlags::empty(),
   583	        )
   584	        .await;
   585	}
   586	fn offset_pos_by_vertical_dir(pos: &BlockPos, ver_dir: VerticalDirection) -> BlockPos {
   587	    match ver_dir {
   588	        VerticalDirection::Up => pos.down(),
   589	        VerticalDirection::Down => pos.up(),
   590	    }
   591	}
   592	const fn block_direction_to_vertical_direction(dir: BlockDirection) -> Option<VerticalDirection> {
   593	    match dir {
   594	        BlockDirection::Up => Some(VerticalDirection::Up),
   595	        BlockDirection::Down => Some(VerticalDirection::Down),
   596	        _ => None,
   597	    }
   598	}
   599	fn flip_dir(dir: VerticalDirection) -> VerticalDirection {
   600	    if dir == VerticalDirection::Up {
   601	        return VerticalDirection::Down;
   602	    }
   603	    VerticalDirection::Up
   604	}

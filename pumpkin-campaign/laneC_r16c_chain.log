#[inline]
#[must_use]
pub fn has_random_ticking_fluid(id: BlockStateId) -> bool {
    Fluid::from_state_id(id).is_some_and(|fluid| Fluid::same_fluid_type(fluid.id, Fluid::LAVA.id))

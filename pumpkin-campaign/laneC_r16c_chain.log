   151	    #[must_use]
   152	    pub fn unique_biomes(&self) -> Vec<u8> {
   153	        let mut biomes = Vec::new();
   154	        // Vanilla `ChunkAccess.collectBiomesInPalette` visits each section's palette
   155	        // (`ChunkAccess.java:350-353`), rather than scanning all section positions.
   156	        self.biome_sections
   157	            .read()
   158	            .unwrap_or_else(std::sync::PoisonError::into_inner)
   159	            .iter()
   160	            .for_each(|section| {
   161	                section.for_each_in_palette(|biome| {
   162	                    if !biomes.contains(&biome) {
   163	                        biomes.push(biome);
   164	                    }
   165	                });
   166	            });
   167	        biomes
   168	    }

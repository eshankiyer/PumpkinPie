   288	            return pos;
   289	        };
   290	
   291	        let dy = self.origin_y - pos.0.y;
   292	        let total_wind_adjust =
   293	            Vector3::new(wind_speed.x * dy as f64, 0.0, wind_speed.z * dy as f64);
   294	        let dx = (total_wind_adjust.x.floor() as i32).clamp(-self.max_offset, self.max_offset);
   295	        let dz = (total_wind_adjust.z.floor() as i32).clamp(-self.max_offset, self.max_offset);

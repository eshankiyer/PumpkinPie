    52	        let target_id = GenerationCache::get_block_state(chunk, &target.0).to_block_id();
    53	        if target_id == Block::WATER || target_id == Block::AIR {
    54	            return false;
    55	        }
    56	
    57	        // Below must be solid
    58	        let below = target.offset(BlockDirection::Down.to_offset());
    59	        let below_id = GenerationCache::get_block_state(chunk, &below.0).to_block_id();
    60	        if below_id == Block::WATER || below_id == Block::AIR {
    61	            return false;
    62	        }
    63	
    64	        // No open horizontal faces
    65	        for dir in &BlockDirection::horizontal() {
    66	            let neighbour = target.offset(dir.to_offset());
    67	            let n_id = GenerationCache::get_block_state(chunk, &neighbour.0).to_block_id();

   260	impl SkyLightPropagator {
   261	    fn lowest_source_y(cache: &Cache, x: i32, z: i32, bottom_y: i32, max_y: i32) -> i32 {
   262	        let mut top_state = Block::AIR.default_state;
   263	        let mut top_y = max_y;
   264	
   265	        for y in (bottom_y..max_y).rev() {
   266	            let state = cache.get_block_state(&Vector3::new(x, y, z)).to_state();
   267	            if state.opacity != 0
   268	                || pumpkin_data::light_shape_occludes(top_state, state, BlockDirection::Down)
   269	            {
   270	                return top_y;
   271	            }
   272	            top_state = state;
   273	            top_y = y;
   274	        }
   275	
   276	        bottom_y - 1
   277	    }

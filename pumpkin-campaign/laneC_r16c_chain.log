   532	
   533	    /// Sets the given block in the chunk, returning the old block
   534	    /// Contrary to `set_block` this does not update the heightmap.
   535	    ///
   536	    /// Only use this if you know you don't need to update the heightmap
   537	    /// or if you manually set the heightmap in `empty_with_heightmap`
   538	    pub fn set_block_no_heightmap_update(
   539	        &self,
   540	        relative_x: usize,
   541	        relative_y: usize,
   542	        relative_z: usize,
   543	        block_state_id: BlockStateId,
   544	    ) -> BlockStateId {
   545	        self.set_block_no_heightmap_update_if(
   546	            relative_x,
   547	            relative_y,
   548	            relative_z,
   549	            None,
   550	            block_state_id,
   551	        )
   552	        .unwrap_or(BlockStateId::AIR)
   553	    }
   554	
   555	    /// Sets a block only when its current state matches `expected_block_state_id`.
   556	    ///
   557	    /// The check and write share the same section write lock. This is used by
   558	    /// asynchronous entity goals that must not remove a block another task has
   559	    /// replaced since the goal observed it.
   560	    pub fn set_block_no_heightmap_update_if(
   561	        &self,
   562	        relative_x: usize,
   563	        relative_y: usize,
   564	        relative_z: usize,
   565	        expected_block_state_id: Option<BlockStateId>,
   566	        block_state_id: BlockStateId,
   567	    ) -> Option<BlockStateId> {
   568	        debug_assert!(relative_x < BlockPalette::SIZE);
   569	        debug_assert!(relative_z < BlockPalette::SIZE);
   570	
   571	        let section_index = relative_y / BlockPalette::SIZE;
   572	        let relative_y = relative_y % BlockPalette::SIZE;
   573	
   574	        // Keep lock order consistent to avoid deadlocks: block sections first, then random-tick cache.
   575	        let mut sections = self
   576	            .block_sections
   577	            .write()
   578	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   579	        let mut random_tick_sections_guard = self
   580	            .random_tick_sections
   581	            .write()
   582	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   583	
   584	        if let Some(section) = sections.get_mut(section_index) {
   585	            if let Some(expected_block_state_id) = expected_block_state_id
   586	                && section.get(relative_x, relative_y, relative_z) != expected_block_state_id
   587	            {
   588	                return None;
   589	            }
   590	
   591	            let replaced_block_state_id =
   592	                section.set(relative_x, relative_y, relative_z, block_state_id);
   593	            if replaced_block_state_id == block_state_id {
   594	                return Some(replaced_block_state_id);
   595	            }
   596	
   597	            if (has_random_ticks(block_state_id) || has_random_ticking_fluid(block_state_id))
   598	                && random_tick_sections_guard.is_none()
   599	            {
   600	                // `sections` is already held here; use its length rather than
   601	                // `section_count()`, which would re-lock the same RwLock and deadlock.
   602	                let new_cache =
   603	                    vec![RandomTickSectionCache::default(); sections.len()].into_boxed_slice();
   604	                *random_tick_sections_guard = Some(new_cache);
   605	            }
   606	
   607	            if let Some(random_tick_sections) = random_tick_sections_guard.as_mut() {
   608	                let random_tick_cache = &mut random_tick_sections[section_index];
   609	                if has_random_ticks(replaced_block_state_id) {
   610	                    random_tick_cache.random_ticking_block_count = random_tick_cache
   611	                        .random_ticking_block_count
   612	                        .saturating_sub(1);
   613	                }
   614	                if has_random_ticking_fluid(replaced_block_state_id) {
   615	                    random_tick_cache.random_ticking_fluid_count = random_tick_cache
   616	                        .random_ticking_fluid_count
   617	                        .saturating_sub(1);
   618	                }
   619	
   620	                if has_random_ticks(block_state_id) {
   621	                    random_tick_cache.random_ticking_block_count = random_tick_cache
   622	                        .random_ticking_block_count
   623	                        .saturating_add(1);
   624	                }
   625	                if has_random_ticking_fluid(block_state_id) {
   626	                    random_tick_cache.random_ticking_fluid_count = random_tick_cache
   627	                        .random_ticking_fluid_count
   628	                        .saturating_add(1);
   629	                }
   630	
   631	                // Update the bitmask
   632	                let mut mask = self
   633	                    .randomly_ticking_mask
   634	                    .load(std::sync::atomic::Ordering::Relaxed);
   635	                if random_tick_cache.is_randomly_ticking() {
   636	                    mask |= 1 << section_index;
   637	                } else {
   638	                    mask &= !(1 << section_index);
   639	                }
   640	                self.randomly_ticking_mask
   641	                    .store(mask, std::sync::atomic::Ordering::Relaxed);
   642	            }
   643	
   644	            return Some(replaced_block_state_id);
   645	        }
   646	        (expected_block_state_id.is_none()).then_some(BlockStateId::AIR)
   647	    }

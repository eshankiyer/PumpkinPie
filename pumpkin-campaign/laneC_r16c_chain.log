    17	impl UnderwaterMagmaFeature {
    18	    /// Find the Y coordinate of a solid floor beneath a water column at the origin's XZ.
    19	    fn get_floor_y<T: GenerationCache>(&self, chunk: &T, origin: BlockPos) -> Option<i32> {
    20	        let x = origin.0.x;
    21	        let z = origin.0.z;
    22	
    23	        // Drop down until water found
    24	        for dy in 0..=self.floor_search_range {
    25	            let check_y = origin.0.y - dy;
    26	            let pos = BlockPos::new(x, check_y, z);
    27	            let state_id = GenerationCache::get_block_state(chunk, &pos.0).to_block_id();
    28	
    29	            if state_id == Block::WATER {
    30	                // Sink to first non-water block below the column
    31	                let mut floor_y = check_y - 1;
    32	                loop {
    33	                    let floor_pos = BlockPos::new(x, floor_y, z);
    34	                    let floor_id =
    35	                        GenerationCache::get_block_state(chunk, &floor_pos.0).to_block_id();
    36	                    if floor_id != Block::WATER {
    37	                        return Some(floor_y);
    38	                    }
    39	                    if (check_y - floor_y) > self.floor_search_range {
    40	                        break;
    41	                    }
    42	                    floor_y -= 1;
    43	                }
    44	            }
    45	        }
    46	        None
    47	    }

   340	    fn defer_border_update(
   341	        &self,
   342	        source_pos: BlockPos,
   343	        target_pos: BlockPos,
   344	        direction: BlockDirection,
   345	        update: PendingBorderLightUpdate,
   346	    ) {
   347	        let update = PendingBorderUpdate {
   348	            source_pos,
   349	            target_pos,
   350	            direction,
   351	            update,
   352	        };

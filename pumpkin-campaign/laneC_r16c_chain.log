    45	pub struct HeterogeneousPaletteData<V: Hash + Eq + Copy, const DIM: usize> {
    46	    storage: PaletteStorage<V, DIM>,
    47	    palette: Vec<V>,
    48	    counts: Vec<u16>,
    49	}
    50	
    51	#[derive(Clone)]
    52	enum PaletteStorage<V, const DIM: usize> {
    53	    Dense(Box<AbstractCube<V, DIM>>),
    54	    Indexed(Box<AbstractCube<u8, DIM>>),
    55	}
    56	
    57	impl<V: Hash + Eq + Copy + Default, const DIM: usize> HeterogeneousPaletteData<V, DIM> {
    58	    fn get(&self, x: usize, y: usize, z: usize) -> V {
    59	        debug_assert!(x < DIM);
    60	        debug_assert!(y < DIM);
    61	        debug_assert!(z < DIM);
    62	
    63	        match &self.storage {
    64	            PaletteStorage::Dense(cube) => cube[y][z][x],
    65	            PaletteStorage::Indexed(indices) => self.palette[indices[y][z][x] as usize],
    66	        }
    67	    }
    68	
    69	    /// Returns the Original
    70	    fn set(&mut self, x: usize, y: usize, z: usize, value: V) -> V {
    71	        debug_assert!(x < DIM);
    72	        debug_assert!(y < DIM);
    73	        debug_assert!(z < DIM);
    74	
    75	        let original = self.get(x, y, z);
    76	        if original == value {
    77	            return original;
    78	        }
    79	
    80	        let original_index = self
    81	            .palette
    82	            .iter()
    83	            .position(|v| v == &original)
    84	            .unwrap_or(0);
    85	
    86	        // Find or add the new value to the palette.
    87	        let new_index = if let Some(new_index) = self.palette.iter().position(|v| v == &value) {
    88	            self.counts[new_index] += 1;
    89	            new_index
    90	        } else {
    91	            self.palette.push(value);
    92	            self.counts.push(1);
    93	            self.palette.len() - 1
    94	        };
    95	
    96	        // Handle storage upgrades or updates
    97	        let mut upgraded = false;
    98	        match &mut self.storage {
    99	            PaletteStorage::Dense(cube) => {
   100	                cube[y][z][x] = value;
   101	            }
   102	            PaletteStorage::Indexed(indices) => {
   103	                if new_index <= 255 {
   104	                    indices[y][z][x] = new_index as u8;
   105	                } else {
   106	                    // Upgrade to Dense
   107	                    let mut cube = Box::new([[[V::default(); DIM]; DIM]; DIM]);
   108	                    for (i, v) in cube
   109	                        .as_flattened_mut()
   110	                        .as_flattened_mut()
   111	                        .iter_mut()
   112	                        .enumerate()
   113	                    {
   114	                        let y = i / (DIM * DIM);
   115	                        let z = (i / DIM) % DIM;
   116	                        let x = i % DIM;
   117	                        *v = self.palette[indices[y][z][x] as usize];
   118	                    }
   119	                    cube[y][z][x] = value;
   120	                    self.storage = PaletteStorage::Dense(cube);
   121	                    upgraded = true;
   122	                }
   123	            }
   124	        }
   125	
   126	        self.counts[original_index] -= 1;
   127	
   128	        if self.counts[original_index] == 0 {
   129	            let last_index = self.palette.len() - 1;
   130	            // Remove from palette and counts Vecs if the count hits zero.
   131	            self.palette.swap_remove(original_index);
   132	            self.counts.swap_remove(original_index);
   133	
   134	            if self.palette.capacity() > 16 && self.palette.len() < self.palette.capacity() / 2 {
   135	                self.palette.shrink_to_fit();
   136	                self.counts.shrink_to_fit();
   137	            }
   138	
   139	            // If we are indexed, we need to update all indices because swap_remove changed indices
   140	            if !upgraded && let PaletteStorage::Indexed(indices) = &mut self.storage {
   141	                for row in indices.iter_mut() {
   142	                    for col in row.iter_mut() {
   143	                        for idx in col.iter_mut() {
   144	                            if *idx as usize == last_index {
   145	                                *idx = original_index as u8;
   146	                            }
   147	                        }
   148	                    }
   149	                }
   150	            }
   151	        }
   152	
   153	        original
   154	    }
   155	}

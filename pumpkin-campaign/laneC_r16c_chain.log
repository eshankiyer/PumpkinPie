   121	impl DynamicLightEngine {
   122	    /// Finds the lowest direct-sky source in a column, matching
   123	    /// `ChunkSkyLightSources.findLowestSourceY`. A source begins immediately
   124	    /// above the first opaque or shape-occluded vertical edge.
   125	    fn lowest_sky_source_y(
   126	        level: &Arc<Level>,
   127	        pos: &BlockPos,
   128	        replacement: Option<(&BlockPos, &'static pumpkin_data::BlockState)>,
   129	    ) -> i32 {
   130	        let world_gen = level.world_gen.load();
   131	        let dimension = world_gen.dimension();
   132	        let min_y = dimension.min_y;
   133	        let max_y = min_y + dimension.height;
   134	        let mut top_state = Block::AIR.default_state;
   135	        let mut top_y = max_y;
   136	
   137	        for y in (min_y..max_y).rev() {
   138	            let current_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   139	            let state = replacement
   140	                .filter(|(replacement_pos, _)| **replacement_pos == current_pos)
   141	                .map_or_else(
   142	                    || Self::state_for_lighting(level, &current_pos),
   143	                    |(_, replacement_state)| replacement_state,
   144	                );
   145	
   146	            if state.opacity != 0
   147	                || pumpkin_data::light_shape_occludes(top_state, state, BlockDirection::Down)
   148	            {
   149	                return top_y;
   150	            }
   151	
   152	            top_state = state;
   153	            top_y = y;
   154	        }
   155	
   156	        // No edge was occluded: every block in the world is a direct-sky
   157	        // source, just as ChunkSkyLightSources represents this below-world
   158	        // sentinel.
   159	        min_y - 1
   160	    }
   161	
   162	    fn update_sky_sources_for_change(
   163	        &self,
   164	        level: &Arc<Level>,
   165	        pos: BlockPos,
   166	        old_state: &'static pumpkin_data::BlockState,
   167	        new_state: &'static pumpkin_data::BlockState,
   168	    ) {
   169	        if old_state == new_state || !Self::has_skylight(level) {
   170	            return;
   171	        }
   172	
   173	        let old_source_y = Self::lowest_sky_source_y(level, &pos, Some((&pos, old_state)));
   174	        let new_source_y = Self::lowest_sky_source_y(level, &pos, Some((&pos, new_state)));
   175	        let min_y = level.world_gen.load().dimension().min_y;
   176	        let max_y = min_y + level.world_gen.load().dimension().height;
   177	        let old_start = old_source_y.clamp(min_y, max_y);
   178	        let new_start = new_source_y.clamp(min_y, max_y);
   179	
   180	        if old_start < new_start {
   181	            // The direct-sky column moved upward. Remove the old level-15
   182	            // source nodes before the normal decrease pass runs.
   183	            for y in old_start..new_start {
   184	                let source_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   185	                if self.get_sky_light_level(level, &source_pos) == 15 {
   186	                    self.set_sky_light_level(level, &source_pos, 0).ok();
   187	                    self.queue_sky_light_decrease(source_pos, 15);
   188	                }
   189	            }
   190	        } else if new_start < old_start {
   191	            // The column opened downward. Add the newly exposed source nodes.
   192	            for y in new_start..old_start {
   193	                let source_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   194	                self.set_sky_light_level(level, &source_pos, 15).ok();
   195	                self.queue_sky_light_increase(source_pos, 15);
   196	            }
   197	        }
   198	    }

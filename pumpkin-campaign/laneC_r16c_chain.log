   300	/// Port of `Column.scan` restricted to the `Column.Range` outcome needed here
   301	/// (`Column.java:64-98`): scans up/down while blocks stay empty-or-water, and both scans
   302	/// must end on a valid edge (dripstone base / replaceable / lava). Returns
   303	/// `(floor, ceiling)`; `None` covers the `Line`/`Ray` outcomes and the non-positive
   304	/// height that vanilla rejects in the `Range` constructor (`Column.java:134-136`).
   305	fn scan_column_range<T: GenerationCache>(
   306	    chunk: &T,
   307	    origin: &BlockPos,
   308	    search_range: i32,
   309	) -> Option<(i32, i32)> {
   310	    let inside_column = |pos: &BlockPos| -> bool { is_empty_or_water(chunk, pos) };
   311	    let valid_edge = |pos: &BlockPos| -> bool {
   312	        let id = GenerationCache::get_block_state(chunk, &pos.0).to_block_id();
   313	        can_replace(id) || id == Block::LAVA.id
   314	    };
   315	
   316	    if !inside_column(origin) {
   317	        return None;
   318	    }
   319	
   320	    let scan_direction = |start_y: i32, up: bool| -> Option<i32> {
   321	        // `Column.scanDirection` (`Column.java:82-98`): advance while inside the column
   322	        // and under the search budget, then require a valid edge at the stop position.
   323	        let step = if up { 1 } else { -1 };
   324	        let mut y = start_y;
   325	        let mut i = 1;
   326	        while i < search_range && inside_column(&BlockPos::new(origin.0.x, y, origin.0.z)) {
   327	            y += step;
   328	            i += 1;
   329	        }
   330	        valid_edge(&BlockPos::new(origin.0.x, y, origin.0.z)).then_some(y)
   331	    };
   332	
   333	    let ceiling = scan_direction(origin.0.y, true)?;
   334	    let floor = scan_direction(origin.0.y, false)?;
   335	
   336	    (ceiling > floor).then_some((floor, ceiling))
   337	}

   157	/// A paletted container is a cube of registry ids. It uses a custom compression scheme based on how
   158	/// may distinct registry ids are in the cube.
   159	#[derive(Clone)]
   160	pub enum PalettedContainer<V: Hash + Eq + Copy + Default, const DIM: usize> {
   161	    Homogeneous(V),
   162	    Heterogeneous(Box<HeterogeneousPaletteData<V, DIM>>),
   163	}
   164	
   165	impl<V: Hash + Eq + Copy + Default, const DIM: usize> PalettedContainer<V, DIM> {
   166	    pub const SIZE: usize = DIM;
   167	    pub const VOLUME: usize = DIM * DIM * DIM;

    94	/// Sky light attenuation for one BFS step, matching vanilla
    95	/// `SkyLightEngine`/`LightEngine.getOpacity` (`fromLevel - max(1, dampening)`,
    96	/// LightEngine.java:77-79, used at SkyLightEngine.java:152/188). The direct-sun
    97	/// column (15 propagating straight down through a non-occluding block) is a
    98	/// separate vanilla mechanic (`ChunkSkyLightSources`/`isSource`) that does not
    99	/// decay at all, kept here as the `down` special case.
   100	fn sky_attenuation(from_level: u8, opacity: u8, down: bool) -> u8 {
   101	    if from_level == 15 && down && opacity == 0 {
   102	        15
   103	    } else {
   104	        from_level.saturating_sub(opacity.max(1))
   105	    }
   106	}

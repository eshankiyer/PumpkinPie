    87	impl<P: LightProvider> LightPropagator<P> {
    88	    #[must_use]
    89	    pub fn new() -> Self {
    90	        Self {
    91	            queue: VecDeque::with_capacity(4096),
    92	            visited: FastHashSet::default(),
    93	            decrease_queue: VecDeque::new(),
    94	            _marker: std::marker::PhantomData,
    95	        }
    96	    }
    97	
    98	    pub fn clear(&mut self) {
    99	        self.queue.clear();
   100	        self.visited.clear();
   101	        self.decrease_queue.clear();
   102	    }
   103	
   104	    /// Core Propagation Logic (BFS).
   105	    ///
   106	    /// Reads and writes light directly through the light storage (a fast array
   107	    /// lookup) instead of maintaining a separate hashed shadow cache and batched
   108	    /// write buffer; the storage is the single source of truth.
   109	    pub fn propagate(&mut self, cache: &mut Cache) {
   110	        // Cache metadata for bounds checking
   111	        let cache_x = cache.x;
   112	        let cache_z = cache.z;
   113	        let cache_size = cache.size;
   114	        let min_y = cache.bottom_y() as i32;
   115	        let max_y = min_y + cache.height() as i32;
   116	
   117	        while let Some(entry) = self.queue.pop_front() {
   118	            let pos = entry.pos;
   119	            self.visited.remove(&pos);
   120	
   121	            let current_light = P::get_light(cache, pos);
   122	            if current_light <= 1 {
   123	                continue;
   124	            }
   125	
   126	            for dir in BlockDirection::all() {
   127	                let neighbor_pos = pos.offset(dir.to_offset());
   128	
   129	                // Skip neighbor if it's outside world bounds
   130	                if neighbor_pos.0.y < min_y || neighbor_pos.0.y >= max_y {
   131	                    continue;
   132	                }
   133	
   134	                let (cx, _rel) = neighbor_pos.chunk_and_chunk_relative_position();
   135	                let rel_x = cx.x - cache_x;
   136	                let rel_z = cx.y - cache_z;
   137	                if rel_x < 0 || rel_x >= cache_size || rel_z < 0 || rel_z >= cache_size {
   138	                    continue;
   139	                }
   140	
   141	                // Get block opacity
   142	                let state = cache.get_block_state(&neighbor_pos.0);
   143	                let opacity = state.to_state().opacity;
   144	
   145	                let new_level = P::propagate_level(current_light, opacity, dir);
   146	                let neighbor_light = P::get_light(cache, neighbor_pos);
   147	
   148	                let from_state = cache.get_block_state(&pos.0).to_state();
   149	                let to_state = state.to_state();
   150	                if new_level > neighbor_light
   151	                    && !pumpkin_data::light_shape_occludes(from_state, to_state, dir)
   152	                {
   153	                    P::set_light(cache, neighbor_pos, new_level);
   154	
   155	                    // Add to propagation queue if bright enough
   156	                    if new_level > 1 && self.visited.insert(neighbor_pos) {
   157	                        self.queue.push_back(PropagationEntry { pos: neighbor_pos });
   158	                    }
   159	                }
   160	            }
   161	        }
   162	    }
   163	
   164	    /// Handle light removal
   165	    pub fn process_decrease_queue(&mut self, cache: &mut Cache) {
   166	        {
   167	            // Cache metadata for bounds checking
   168	            let cache_x = cache.x;
   169	            let cache_z = cache.z;
   170	            let cache_size = cache.size;
   171	
   172	            while let Some((pos, old_val)) = self.decrease_queue.pop_front() {
   173	                for dir in BlockDirection::all() {
   174	                    let neighbor_pos = pos.offset(dir.to_offset());
   175	
   176	                    // Bounds check
   177	                    let (cx, _rel) = neighbor_pos.chunk_and_chunk_relative_position();
   178	                    let rel_x = cx.x - cache_x;
   179	                    let rel_z = cx.y - cache_z;
   180	
   181	                    if rel_x < 0 || rel_x >= cache_size || rel_z < 0 || rel_z >= cache_size {
   182	                        continue;
   183	                    }
   184	
   185	                    let neighbor_light = P::get_light(cache, neighbor_pos);
   186	                    if neighbor_light == 0 {
   187	                        continue;
   188	                    }
   189	
   190	                    if neighbor_light <= old_val.saturating_sub(1) {
   191	                        // Darken
   192	                        P::set_light(cache, neighbor_pos, 0);
   193	                        self.decrease_queue
   194	                            .push_back((neighbor_pos, neighbor_light));

   214	                        let mut i = 0;
   215	                        while i < height && pos.0.y < max_y {
   216	                            let wind_adjusted_pos = wind.offset(pos);
   217	                            let wind_block_id =
   218	                                GenerationCache::get_block_state(chunk, &wind_adjusted_pos.0)
   219	                                    .to_block_id();

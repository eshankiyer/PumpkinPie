   706	impl ChunkData {
   706	impl ChunkData {
   707	    /// Grow this chunk to `total_sections` 16-block sections, padding with air / empty light.
   707	    /// Grow this chunk to `total_sections` 16-block sections, padding with air / empty light.
   708	    ///
   708	    ///
   709	    /// The chunk-data packet carries no explicit section count: the client reads exactly
   709	    /// The chunk-data packet carries no explicit section count: the client reads exactly
   710	    /// `dimension.height / 16` sections, taken from the dimension registry it received at
   710	    /// `dimension.height / 16` sections, taken from the dimension registry it received at
   711	    /// login. A chunk holding fewer sections than that serializes short, so the client runs
   712	    /// past the end of the buffer and drops the connection with a protocol error.
   713	    ///
   714	    /// Chunks can end up short from two directions: worldgen sizing sections off the noise
   715	    /// generator's `shape.height` (128 for Nether/End) instead of the dimension height (256),
   716	    /// and loading a saved chunk whose file simply does not contain the upper sections - the
   717	    /// on-disk reader derives its section count from the highest `Y` tag present, so any file
   718	    /// written while the first bug was live reloads just as short as it was saved. Padding
   719	    /// here fixes both, and is a no-op when the chunk is already the right size.
   720	    ///
   721	    /// Padding sections are air. Their sky light is `sky_light` - which must be 15 in a
   722	    /// dimension that has sky light, and 0 in one that does not.
   723	    ///
   724	    /// Getting that wrong is not cosmetic. Padded sections sit above every section the chunk
   725	    /// actually stored, and the on-disk reader documents the same invariant: sections above
   726	    /// the highest one carrying a `SkyLight` tag see open sky and are 15. Padding them at 0
   727	    /// instead caps the column with a lid of artificial darkness, and sky light stops
   728	    /// propagating down - which shows up as black caves that snap to full brightness the
   729	    /// moment a block update forces a relight.
   730	    pub fn pad_sections_to(&self, total_sections: usize, sky_light: u8) {
   731	        let mut block_sections = self
   732	            .section
   733	            .block_sections
   734	            .write()
   735	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   736	        if block_sections.len() >= total_sections {
   737	            return;
   738	        }
   739	
   740	        let mut biome_sections = self
   741	            .section
   742	            .biome_sections
   743	            .write()

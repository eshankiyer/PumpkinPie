) {
    crate::world::game_event::emit_game_event(
        world,
        pumpkin_data::game_event::GameEvent::ProjectileLand,
        land_pos,
        crate::world::game_event::GameEventContext::of_entity(caller.clone()),
    )
    .await;
}


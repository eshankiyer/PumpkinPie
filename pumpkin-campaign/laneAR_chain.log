   113	                    &args.position.to_f64(),
   114	                );
   115	                props.hydration += 1;
   116	                args.world
   117	                    .set_block_state(
   118	                        args.position,
   119	                        props.to_state_id(args.block),
   120	                        BlockFlags::NOTIFY_LISTENERS,
   121	                    )
   122	                    .await;
   123	                return;
   124	            }
   125	
   126	            // `spawnGhastling` (`DriedGhastBlock.java:115-127`).
   127	            args.world
   128	                .set_block_state(
   129	                    args.position,
   130	                    pumpkin_data::Block::AIR.default_state.id,
   131	                    BlockFlags::NOTIFY_ALL,
   132	                )
   133	                .await;
   134	
   135	            let yaw = direction_yaw(props.facing);
   136	            let spawn_at = Vector3::new(
   137	                f64::from(args.position.0.x) + 0.5,
   138	                f64::from(args.position.0.y),
   139	                f64::from(args.position.0.z) + 0.5,
   140	            );
   141	            let ghastling = crate::entity::r#type::from_type(
   142	                &EntityType::HAPPY_GHAST,
   143	                spawn_at,
   144	                args.world,
   145	                Uuid::new_v4(),
   146	            );
   147	            ghastling.get_entity().set_age(-24000);
   148	            ghastling.get_entity().set_rotation(yaw, 0.0);
   149	            args.world.spawn_entity(ghastling).await;
   150	            args.world.play_sound(
   151	                Sound::EntityGhastlingSpawn,
   152	                SoundCategory::Blocks,
   153	                &spawn_at,
   154	            );
   155	        })
   156	    }
   157	
   158	    /// `DriedGhastBlock.setPlacedBy` (`DriedGhastBlock.java:195-201`).
   159	    fn player_placed<'a>(&'a self, args: PlayerPlacedArgs<'a>) -> BlockFuture<'a, ()> {
   160	        Box::pin(async move {
   161	            let props = DriedGhastLikeProperties::from_state_id(args.state_id, args.block);
   162	            let sound = if props.waterlogged {
   163	                Sound::BlockDriedGhastPlaceInWater
   164	            } else {
   165	                Sound::BlockDriedGhastPlace
   166	            };
   167	            args.world
   168	                .play_sound(sound, SoundCategory::Blocks, &args.position.to_f64());
   169	        })
   170	    }
   171	}

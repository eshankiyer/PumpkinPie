   206	            .setValue(EAST, state.getValue(WEST))
   207	            .setValue(SOUTH, state.getValue(NORTH))
   208	            .setValue(WEST, state.getValue(EAST));
   209	         case COUNTERCLOCKWISE_90 -> (BlockState)state.setValue(NORTH, state.getValue(EAST))
   210	            .setValue(EAST, state.getValue(SOUTH))
   211	            .setValue(SOUTH, state.getValue(WEST))
   212	            .setValue(WEST, state.getValue(NORTH));
   213	         case CLOCKWISE_90 -> (BlockState)state.setValue(NORTH, state.getValue(WEST))
   214	            .setValue(EAST, state.getValue(NORTH))
   215	            .setValue(SOUTH, state.getValue(EAST))
   216	            .setValue(WEST, state.getValue(SOUTH));
   217	         default -> state;
   218	      };
   219	   }

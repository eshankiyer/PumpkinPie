   405	/// Translates a macro instantiation failure into the user-facing component
   406	/// vanilla produces before wrapping it in `ERROR_FUNCTION_INSTANTATION_FAILURE`
   407	/// (`FunctionCommand.java:139-141`): "missing arguments to function %s"
   408	/// (`MacroFunction.java:53-55`) or "missing argument for function %s, %s"
   409	/// (`MacroFunction.java:61-65`).
   410	fn instantiation_failure(fn_id: &str, error: InstantiationError) -> ExecuteFunctionError {
   411	    let reason = match error {
   412	        InstantiationError::MissingArguments => TextComponent::translate_cross(
   413	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENTS,
   414	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENTS,
   415	            [TextComponent::text(fn_id.to_string())],
   416	        ),
   417	        InstantiationError::MissingArgument(parameter) => TextComponent::translate_cross(
   418	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   419	            translation::java::COMMANDS_FUNCTION_ERROR_MISSING_ARGUMENT,
   420	            [
   421	                TextComponent::text(fn_id.to_string()),
   422	                TextComponent::text(parameter),
   423	            ],
   424	        ),
   425	    };
   426	    ExecuteFunctionError::InstantiationFailure {
   427	        function_id: fn_id.to_string(),
   428	        reason,
   429	    }
   430	}

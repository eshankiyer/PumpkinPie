   344	    /// Instantiates a function into the concrete command lines to dispatch.
   345	    ///
   346	    /// Plain functions pass their lines through unchanged (vanilla
   347	    /// `PlainTextFunction.instantiate`). Macro functions require an argument
   348	    /// compound and run through the LRU cache exactly like vanilla's
   349	    /// `MacroFunction.instantiate` (`MacroFunction.java:52-82`): missing
   350	    /// arguments raise an instantiation error which the caller surfaces as
   351	    /// `commands.function.instantiationFailure`
   352	    /// (`FunctionCommand.java:49-51`, `:139-141`), parameter values are pulled
   353	    /// and stringified in parameter order (`:57-68`, stringify at `:84-94`),
   354	    /// cached hits skip re-substitution (`:70-73`) and misses substitute all
   355	    /// entries before being inserted, evicting the least-recently-used entry
   356	    /// once 8 slots are occupied (`:75-81`).
   357	    fn instantiate_lines(
   358	        &self,
   359	        fn_id: &str,
   360	        function: &LoadedFunction,
   361	        arguments: Option<&NbtCompound>,
   362	    ) -> Result<Vec<String>, ExecuteFunctionError> {
   363	        if !function.is_macro() {
   364	            return Ok(function
   365	                .lines
   366	                .iter()
   367	                .filter_map(|line| match line {
   368	                    macro_function::FunctionLine::Plain(command) => Some(command.clone()),
   369	                    // A function without parameters cannot contain macro lines;
   370	                    // guaranteed by `LoadedFunction::from_lines`.
   371	                    macro_function::FunctionLine::Macro(_) => None,
   372	                })
   373	                .collect());
   374	        }
   375	
   376	        let instantiation_error = |error| instantiation_failure(fn_id, error);
   377	
   378	        let arguments =
   379	            arguments.ok_or_else(|| instantiation_error(InstantiationError::MissingArguments))?;
   380	        let values = function
   381	            .extract_parameter_values(arguments)
   382	            .map_err(instantiation_error)?;
   383	
   384	        let mut caches = self
   385	            .instantiation_caches
   386	            .lock()
   387	            .unwrap_or_else(std::sync::PoisonError::into_inner);
   388	        let cache = caches.entry(fn_id.to_string()).or_default();
   389	        cache
   390	            .get_or_insert_with(&values, || function.substitute_all(&values))
   391	            .map_err(|e| ExecuteFunctionError::InstantiationFailure {
   392	                function_id: fn_id.to_string(),
   393	                reason: TextComponent::text(e),
   394	            })
   395	    }
   396	}

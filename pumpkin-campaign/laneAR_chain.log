    97	    /// Vanilla `CrafterBlockEntity.serverTick` (`CrafterBlockEntity.java:236-245`):
    98	    /// counts the crafting animation down and clears `CRAFTING` when it reaches zero.
    99	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   100	        Box::pin(async move {
   101	            let remaining = self.crafting_ticks_remaining.load(Ordering::Relaxed) - 1;
   102	            if remaining < 0 {
   103	                return;
   104	            }
   105	            self.crafting_ticks_remaining
   106	                .store(remaining, Ordering::Relaxed);
   107	            if remaining != 0 {
   108	                return;
   109	            }
   110	            let block = world.get_block(&self.position);
   111	            let state = world.get_block_state(&self.position);
   112	            let mut props = CrafterLikeProperties::from_state_id(state.id, block);
   113	            if !props.crafting {
   114	                return;
   115	            }
   116	            props.crafting = false;
   117	            world
   118	                .set_block_state(
   119	                    &self.position,
   120	                    props.to_state_id(block),
   121	                    BlockFlags::NOTIFY_ALL,
   122	                )
   123	                .await;
   124	        })
   125	    }

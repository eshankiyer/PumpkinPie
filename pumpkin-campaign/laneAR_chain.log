    23	public class StructureBlock extends BaseEntityBlock implements GameMasterBlock {
    24	   public static final MapCodec<StructureBlock> CODEC = simpleCodec(StructureBlock::new);
    25	   public static final EnumProperty<StructureMode> MODE = BlockStateProperties.STRUCTUREBLOCK_MODE;
    26	
    27	   @Override

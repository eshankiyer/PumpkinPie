   477	    /// # Panics
   478	    ///
   479	    /// Panics if this source does not have a reference to the
   480	    /// server (i.e. this is a dummy [`CommandSource`].)
   481	    #[must_use]
   482	    pub async fn has_permission(&self, permission: &str) -> bool {
   483	        self.output.has_permission(self.server(), permission).await
   484	    }
   485	
   486	    /// Returns whether this source has the permission provided.
   487	    ///
   488	    /// # Panics
   489	    ///
   490	    /// Panics **if, and only if** both the following conditions are met:
   491	    ///
   492	    /// - permission is not [`None`].
   493	    /// - this source does not have a reference to the server (i.e. this is a dummy [`CommandSource`].)
   494	    #[must_use]
   495	    pub async fn has_permission_from_option(&self, permission: Option<&str>) -> bool {
   496	        match permission {
   497	            None => true,
   498	            Some(permission) => self.has_permission(permission).await,
   499	        }
   500	    }
   501	}

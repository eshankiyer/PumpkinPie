   865	    /// Inserts an item into a range of slots.
   866	    ///
   867	    /// First tries to stack with existing items, then fills empty slots.
   868	    fn insert_item<'a>(
   869	        &'a mut self,
   870	        stack: &'a mut ItemStack,
   871	        start_index: i32,
   872	        end_index: i32,
   873	        from_last: bool,
   874	    ) -> ScreenHandlerFuture<'a, bool> {
   875	        Box::pin(async move {
   876	            let mut success = false;
   877	            let mut current_index = if from_last {
   878	                end_index - 1
   879	            } else {
   880	                start_index
   881	            };
   882	
   883	            if stack.is_stackable() {
   884	                while !stack.is_empty()
   885	                    && (if from_last {
   886	                        current_index >= start_index
   887	                    } else {
   888	                        current_index < end_index
   889	                    })
   890	                {
   891	                    let slot = self.get_behaviour().slots[current_index as usize].clone();
   892	                    let mut slot_stack = slot.get_stack().await;
   893	
   894	                    if !slot_stack.is_empty() && slot_stack.are_items_and_components_equal(stack) {
   895	                        let combined_count = slot_stack.item_count + stack.item_count;
   896	                        let max_slot_count = slot.get_max_item_count_for_stack(&slot_stack).await;
   897	                        if combined_count <= max_slot_count {
   898	                            stack.set_count(0);
   899	                            slot_stack.set_count(combined_count);
   900	                            slot.set_stack(slot_stack).await;
   901	                            success = true;
   902	                        } else if slot_stack.item_count < max_slot_count {
   903	                            stack.decrement(max_slot_count - slot_stack.item_count);
   904	                            slot_stack.set_count(max_slot_count);
   905	                            slot.set_stack(slot_stack).await;
   906	                            success = true;
   907	                        }
   908	                    }
   909	
   910	                    if from_last {
   911	                        current_index -= 1;
   912	                    } else {
   913	                        current_index += 1;
   914	                    }
   915	                }
   916	            }
   917	
   918	            if !stack.is_empty() {
   919	                if from_last {
   920	                    current_index = end_index - 1;
   921	                } else {
   922	                    current_index = start_index;
   923	                }
   924	
   925	                while if from_last {
   926	                    current_index >= start_index
   927	                } else {
   928	                    current_index < end_index
   929	                } {
   930	                    let slot = self.get_behaviour().slots[current_index as usize].clone();
   931	                    let slot_stack = slot.get_stack().await;
   932	
   933	                    if slot_stack.is_empty() && slot.can_insert(stack).await {
   934	                        let max_count = slot.get_max_item_count_for_stack(stack).await;
   935	                        slot.set_stack(stack.split(max_count.min(stack.item_count)))
   936	                            .await;
   937	                        slot.mark_dirty().await;
   938	                        success = true;
   939	                        break;
   940	                    }
   941	
   942	                    if from_last {
   943	                        current_index -= 1;
   944	                    } else {
   945	                        current_index += 1;
   946	                    }
   947	                }
   948	            }
   949	
   950	            success
   951	        })
   952	    }

   111	
   112	/// Returns the state of `new_block` that carries over every property it shares
   113	/// with `old_block` in `old_state_id`.
   114	///
   115	/// Equivalent to vanilla's `Block#withPropertiesOf`, used by stripping, waxing,
   116	/// scraping and de-oxidizing to keep facing, waterlogging, slab type, and so on.
   117	/// Falls back to the default state when either block carries no properties.
   118	#[must_use]
   119	pub fn state_with_properties_of(
   120	    old_block: &Block,
   121	    old_state_id: BlockStateId,
   122	    new_block: &Block,
   123	) -> BlockStateId {
   124	    let default_state_id = new_block.default_state.id;
   125	    if new_block.properties(default_state_id).is_none() {
   126	        return default_state_id;
   127	    }
   128	    old_block
   129	        .properties(old_state_id)
   130	        .map_or(default_state_id, |properties| {
   131	            new_block
   132	                .from_properties(&properties.to_props())
   133	                .to_state_id(new_block)
   134	        })
   135	}

    65	/// `HoneyBlock.doSlideMovement` (`HoneyBlock.java:109-119`).
    66	fn do_slide_movement(entity: &dyn EntityBase) {
    67	    let base = entity.get_entity();
    68	    let delta = base.velocity.load();
    69	    let old_delta_y = get_old_delta_y(delta.y);
    70	
    71	    let new_velocity = if old_delta_y < -SLIDE_STARTS_WHEN_VERTICAL_SPEED_IS_AT_LEAST {
    72	        let horizontal_reduction_factor = -THROTTLE_SLIDE_SPEED_TO / old_delta_y;
    73	        Vector3::new(
    74	            delta.x * horizontal_reduction_factor,
    75	            get_new_delta_y(-THROTTLE_SLIDE_SPEED_TO),
    76	            delta.z * horizontal_reduction_factor,
    77	        )
    78	    } else {
    79	        Vector3::new(delta.x, get_new_delta_y(-THROTTLE_SLIDE_SPEED_TO), delta.z)
    80	    };
    81	
    82	    base.set_velocity(new_velocity);
    83	
    84	    // `Entity.resetFallDistance`
    85	    if let Some(living) = entity.get_living_entity() {
    86	        living.fall_distance.store(0.0);
    87	    }
    88	}

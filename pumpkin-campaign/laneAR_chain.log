   310	    /// disabled, then broadcasts the change.
   311	    pub fn set_slot_state(&self, slot_id: i32, enabled: bool) {
   312	        if slot_id > -1 && slot_id < CRAFTER_SLOT_COUNT as i32 {
   313	            self.properties.set_property(slot_id, i32::from(!enabled));
   314	        }
   315	    }

   242	impl CrafterScreenHandler {
   243	    /// Creates a crafter screen handler (`CrafterMenu.java:31-54`).
   244	    ///
   245	    /// Slot order is the vanilla one: nine `CrafterSlot`s, the 36 standard
   246	    /// player slots, then the non-interactive result slot at index 45.
   247	    pub async fn new(
   248	        sync_id: u8,
   249	        player_inventory: &Arc<PlayerInventory>,
   250	        inventory: Arc<dyn Inventory>,
   251	        result_inventory: Arc<dyn Inventory>,
   252	        properties: Arc<dyn PropertyDelegate>,
   253	    ) -> Self {
   254	        let mut handler = Self {
   255	            inventory: inventory.clone(),
   256	            result_inventory: result_inventory.clone(),
   257	            properties: properties.clone(),
   258	            behaviour: ScreenHandlerBehaviour::new(sync_id, Some(WindowType::Crafter3x3)),
   259	        };
   260	
   261	        inventory.on_open().await;
   262	
   263	        for index in 0..CRAFTER_SLOT_COUNT {
   264	            handler.add_slot(Arc::new(CrafterSlot::new(
   265	                inventory.clone(),
   266	                index,
   267	                properties.clone(),
   268	            )));
   269	        }
   270	
   271	        let player_inv: Arc<dyn Inventory> = player_inventory.clone();
   272	        handler.add_player_slots(&player_inv);
   273	
   274	        handler.add_slot(Arc::new(NonInteractiveResultSlot::new(result_inventory, 0)));
   275	
   276	        // `CrafterMenu.java:52`: addDataSlots(this.containerData).
   277	        for index in 0..CRAFTER_PROPERTY_COUNT {
   278	            handler.add_property(ScreenProperty::new(properties.clone(), index as u8));
   279	        }
   280	
   281	        // `CrafterMenu.java:53`: this.refreshRecipeResult().
   282	        handler.refresh_recipe_result().await;
   283	
   284	        handler
   285	    }

   226	    async fn update(world: &Arc<World>, pos: &BlockPos, state_id: BlockStateId) {
   227	        for dir in [BlockDirection::South, BlockDirection::West] {
   228	            for i in 1..42 {
   229	                let current_pos = pos.offset_dir(dir.to_offset(), i);
   230	                let (current_block, current_state) = world.get_block_and_state_id(&current_pos);
   231	                if current_block == &Block::TRIPWIRE_HOOK {
   232	                    let current_props =
   233	                        TripwireHookProperties::from_state_id(current_state, &Block::TRIPWIRE_HOOK);
   234	                    if dir
   235	                        .opposite()
   236	                        .to_horizontal_facing()
   237	                        .is_some_and(|f| current_props.facing == f)
   238	                    {
   239	                        TripwireHookBlock::update(
   240	                            world,
   241	                            current_pos,
   242	                            current_state,
   243	                            false,
   244	                            true,
   245	                            i,
   246	                            Some(state_id),
   247	                        )
   248	                        .await;
   249	                    }
   250	                    break;
   251	                }
   252	                if current_block != &Block::TRIPWIRE {
   253	                    break;
   254	                }
   255	            }
   256	        }
   257	    }

   390	    pub async fn parse(
   391	        &self,
   392	        reader: &mut StringReader<'_>,
   393	        source: &CommandSource,
   394	    ) -> ParsingResult<'_> {
   395	        let context = CommandContextBuilder::new(
   396	            self,
   397	            Arc::new(source.clone()),
   398	            ROOT_NODE_ID,
   399	            reader.cursor(),
   400	        );
   401	        self.parse_nodes(ROOT_NODE_ID, reader, &context).await
   402	    }
   403	
   404	    async fn parse_nodes<'a>(
   405	        &'a self,
   406	        node: NodeId,
   407	        original_reader: &mut StringReader<'_>,
   408	        context_so_far: &CommandContextBuilder<'a>,
   409	    ) -> ParsingResult<'a> {
   410	        let source = context_so_far.source.clone();
   411	        let mut errors: FxHashMap<NodeId, CommandSyntaxError> = FxHashMap::default();
   412	        let mut potentials: Vec<ParsingResult> = Vec::new();
   413	        let cursor = original_reader.cursor();
   414	
   415	        for child in self.tree.get_relevant_nodes(original_reader, node) {
   416	            if !self.tree.can_use(child, &source).await {
   417	                continue;
   418	            }
   419	            let mut context = context_so_far.clone();
   420	            let mut reader = original_reader.clone();
   421	            let parse_result = {
   422	                if let Err(error) = self.tree.parse(child, &mut reader, &mut context).await {
   423	                    Err(error)
   424	                } else {
   425	                    let peek = reader.peek();
   426	                    if peek.is_some() && peek != Some(ARG_SEPARATOR_CHAR) {
   427	                        Err(DISPATCHER_EXPECTED_ARGUMENT_SEPARATOR.create(&reader))
   428	                    } else {
   429	                        Ok(())
   430	                    }
   431	                }
   432	            };
   433	            if let Err(parse_error) = parse_result {
   434	                errors.insert(child, parse_error);
   435	                reader.set_cursor(cursor);
   436	                continue;
   437	            }
   438	
   439	            let child_node = &self.tree[child];
   440	            context.with_command(child_node.command().clone());
   441	            let redirect = self.tree[child].redirect();
   442	            if reader.can_read_chars(if redirect.is_some() { 2 } else { 1 }) {
   443	                reader.skip();
   444	                if let Some(redirect) = redirect {
   445	                    let Some(redirect) = self.tree.resolve(redirect) else {
   446	                        errors.insert(child, UNRESOLVED_REDIRECT.create(&reader));
   447	                        reader.set_cursor(cursor);
   448	                        continue;
   449	                    };
   450	                    let child_context =
   451	                        CommandContextBuilder::new(self, source, redirect, reader.cursor());
   452	                    let parsed =
   453	                        Box::pin(self.parse_nodes(redirect, &mut reader, &child_context)).await;
   454	                    context.with_child(parsed.context);
   455	                    return ParsingResult {
   456	                        context,
   457	                        errors: parsed.errors,
   458	                        reader: parsed.reader,
   459	                    };
   460	                }
   461	                let parsed = Box::pin(self.parse_nodes(child, &mut reader, &context)).await;
   462	                potentials.push(parsed);
   463	            } else {
   464	                potentials.push(ParsingResult {
   465	                    context,
   466	                    errors: FxHashMap::default(),
   467	                    reader: reader.clone_into_owned(),
   468	                });
   469	            }
   470	        }
   390	    /// Gets the player as a result:
   391	    ///
   392	    /// - If this source actually contains a player, it returns that wrapped in an [`Ok`].
   393	    /// - If it doesn't, a command error is provided instead, wrapped in an [`Err`].
   394	    pub fn player_or_err(&self) -> Result<&Player, CommandSyntaxError> {
   395	        self.player_or_none()
   396	            .ok_or(REQUIRES_PLAYER.create_without_context())
   397	    }
   398	
   399	    /// Returns if the command was executed by a player.
   400	    #[must_use]

   239	            if (this.level().loadedAndEntityCanStandOn(current.relative(this.currentMoveDirection), this)) {
   240	               this.selectNextMoveDirection(axis, finalTarget);
   241	            } else {
   242	               BlockPos targetPos = finalTarget.blockPosition();
   243	               if (axis == Direction.Axis.X && current.getX() == targetPos.getX()
   244	                  || axis == Direction.Axis.Z && current.getZ() == targetPos.getZ()
   245	                  || axis == Direction.Axis.Y && current.getY() == targetPos.getY()) {
   246	                  this.selectNextMoveDirection(axis, finalTarget);
   247	               }
   248	            }
   249	         }
   250	      }
   251	   }

    19	   public ServerboundPlayerActionPacket(final ServerboundPlayerActionPacket.Action action, final BlockPos pos, final Direction direction, final int sequence) {
    20	      this.action = action;
    21	      this.pos = pos.immutable();
    22	      this.direction = direction;
    23	      this.sequence = sequence;
    24	   }
    25	

   307	fn write_root_vehicle(nbt: &mut NbtCompound, uuid: Uuid) {
   308	    let value = uuid.as_u128();
   309	    let mut root_vehicle = NbtCompound::new();
   310	    root_vehicle.put(
   311	        "Attach",
   312	        NbtTag::IntArray(vec![
   313	            (value >> 96) as i32,
   314	            (value >> 64) as i32,
   315	            (value >> 32) as i32,
   316	            value as i32,
   317	        ]),
   318	    );
   319	    nbt.put("RootVehicle", NbtTag::Compound(root_vehicle));
   320	}

   221	/// A single entry in the template's block palette.
   222	#[derive(Debug, Clone, PartialEq, Eq, Hash)]
   223	pub struct PaletteEntry {
   224	    /// The block name (e.g., "`minecraft:stone_bricks`").
   225	    pub name: String,
   226	
   227	    /// Block state properties (e.g., [("facing", "north"), ("lit", "false")]).
   228	    pub properties: Vec<(String, String)>,
   229	}
   230	
   231	impl PaletteEntry {
   232	    /// Creates a new palette entry with no properties.
   233	    #[must_use]
   234	    pub const fn new(name: String) -> Self {
   235	        Self {
   236	            name,
   237	            properties: Vec::new(),
   238	        }
   239	    }
   240	
   241	    /// Creates a new palette entry with the given properties.
   242	    #[must_use]
   243	    pub const fn with_properties(name: String, properties: Vec<(String, String)>) -> Self {
   244	        Self { name, properties }
   245	    }
   246	
   247	    /// Parses a block state string (e.g. "`minecraft:oak_log`[axis=x]") into a palette entry.
   248	    #[must_use]
   249	    pub fn from_string(s: &str) -> Self {
   250	        s.find('[').map_or_else(
   251	            || Self::new(s.to_string()),
   252	            |bracket_pos| {
   253	                let name = s[..bracket_pos].to_string();
   254	                let end_bracket = s.rfind(']').unwrap_or(s.len());
   255	                let props_str = &s[bracket_pos + 1..end_bracket];
   256	                let properties = props_str
   257	                    .split(',')
   258	                    .filter_map(|p| {
   259	                        // Preserve final-state properties consumed by the placement transform (StructureTemplate.java:283-287).
   260	                        let (key, value) = p.split_once('=')?;
   261	                        let key = key.trim().to_string();
   262	                        let value = value.trim().to_string();
   263	                        Some((key, value))
   264	                    })
   265	                    .collect();
   266	                Self { name, properties }
   267	            },
   268	        )
   269	    }
   270	
   271	    /// Rotates this block state by the given rotation.
   272	    #[must_use]
   273	    pub fn rotate(&self, rotation: Rotation) -> Self {
   274	        self.transform(rotation, Mirror::None)
   275	    }
   276	
   277	    /// Mirrors this block state by the given mirror.
   278	    #[must_use]
   279	    pub fn mirror(&self, mirror: Mirror) -> Self {
   280	        self.transform(Rotation::None, mirror)
   281	    }
   282	
   283	    /// Rotates and mirrors this block state.
   284	    #[must_use]
   285	    pub fn transform(&self, rotation: Rotation, mirror: Mirror) -> Self {
   286	        if rotation == Rotation::None && mirror == Mirror::None {
   287	            return self.clone();
   288	        }
   289	
   290	        let properties: Vec<(String, String)> = self
   291	            .properties
   292	            .iter()
   293	            .map(|(key, value)| {
   294	                let transformed_key = match key.as_str() {
   295	                    "north" | "south" | "east" | "west" => rotation
   296	                        .rotate_facing(mirror.mirror_facing(key))
   297	                        .to_string(),
   298	                    _ => key.clone(),
   299	                };
   300	
   301	                let transformed_value = match key.as_str() {
   302	                    "facing" => {
   303	                        let mirrored = mirror.mirror_facing(value);
   304	                        rotation.rotate_facing(mirrored).to_string()
   305	                    }
   306	                    "orientation" => {
   307	                        let mut parts = value.split('_');
   308	                        if let (Some(front), Some(top)) = (parts.next(), parts.next()) {
   309	                            let mirrored_front = mirror.mirror_facing(front);
   310	                            let rotated_front = rotation.rotate_facing(mirrored_front);
   311	                            let mirrored_top = mirror.mirror_facing(top);
   312	                            let rotated_top = rotation.rotate_facing(mirrored_top);
   313	                            format!("{rotated_front}_{rotated_top}")
   314	                        } else {
   315	                            value.clone()
   316	                        }
   317	                    }
   318	                    "axis" => rotation.rotate_axis(value).to_string(),
   319	                    "rotation" => value.parse::<i32>().map_or_else(
   320	                        |_| value.clone(),
   321	                        |rot_value| {
   322	                            let mirrored = mirror.mirror_block_rotation(rot_value);
   323	                            let rotated = rotation.rotate_block_rotation(mirrored);
   324	                            rotated.to_string()
   325	                        },
   326	                    ),
   327	                    _ => value.clone(),
   328	                };
   329	
   330	                (transformed_key, transformed_value)
   331	            })
   332	            .collect();
   333	
   334	        Self {
   335	            name: self.name.clone(),
   336	            properties,
   337	        }
   338	    }
   339	
   340	    /// Converts this palette entry to an NBT compound tag.
   341	    #[must_use]
   342	    pub fn to_nbt_compound(&self) -> NbtCompound {
   343	        let mut compound = NbtCompound::new();
   344	        compound.put_string("Name", self.name.clone());
   345	        if !self.properties.is_empty() {
   346	            let mut props = NbtCompound::new();
   347	            for (k, v) in &self.properties {
   348	                props.put_string(k, v.clone());
   349	            }
   350	            compound.put_compound("Properties", props);
   351	        }
   352	        compound
   353	    }
   354	
   355	    /// Deserializes a palette entry from an NBT compound tag.
   356	    pub fn from_nbt_compound(entry_compound: &NbtCompound) -> Result<Self, TemplateError> {
   357	        let name = entry_compound
   358	            .get_string("Name")
   359	            .ok_or(TemplateError::MissingField("palette.Name"))?
   360	            .to_string();


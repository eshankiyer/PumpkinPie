    30	impl ItemBehaviour for BrushItem {
    31	    /// `BrushItem.useOn` (`BrushItem.java:37-45`) only starts the use animation; all of
    32	    /// the work happens in `onUseTick`. Vanilla's `Item.use` is not overridden, so
    33	    /// right-clicking air does nothing.
    34	    fn use_on_block<'a>(
    35	        &'a self,
    36	        _item: &'a mut ItemStack,
    37	        player: &'a Player,
    38	        _location: BlockPos,
    39	        _face: BlockDirection,
    40	        _cursor_pos: Vector3<f32>,
    41	        _block: &'a Block,

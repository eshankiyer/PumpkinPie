   358	    /// `CrafterMenu.slotChanged` (`CrafterMenu.java:119-122`), fired here after any click that
   359	    /// could have touched one of the nine input slots.
   360	    fn on_slot_click<'a>(
   361	        &'a mut self,
   362	        slot_index: i32,
   363	        button: i32,
   364	        action_type: pumpkin_protocol::java::server::play::SlotActionType,
   365	        player: &'a dyn InventoryPlayer,
   366	    ) -> ScreenHandlerFuture<'a, ()> {
   367	        Box::pin(async move {
   368	            self.internal_on_slot_click(slot_index, button, action_type, player)
   369	                .await;
   370	            if (0..CRAFTER_SLOT_COUNT as i32).contains(&slot_index) {
   371	                self.refresh_recipe_result().await;
   372	            }
   373	        })
   374	    }
   375	
   376	    /// `CrafterMenu.java:70-99`. Input slots push to the whole player area
   377	    /// (reversed); everything else pushes back into the nine input slots. The
   378	    /// result slot sits at index 45 but yields nothing, because
   379	    /// `NonInteractiveResultSlot` refuses to give up its stack.
   380	    fn quick_move<'a>(
   381	        &'a mut self,
   382	        player: &'a dyn InventoryPlayer,
   383	        slot_index: i32,
   384	    ) -> ItemStackFuture<'a> {
   385	        Box::pin(async move {
   386	            let mut stack_left = ItemStack::EMPTY.clone();
   387	            let slot = self.get_behaviour().slots[slot_index as usize].clone();
   388	
   389	            if slot.has_stack().await {
   390	                let mut slot_stack = slot.get_stack().await;
   391	                stack_left = slot_stack.clone();
   392	
   393	                if slot_index < CRAFTER_SLOT_COUNT as i32 {
   394	                    if !self
   395	                        .insert_item(&mut slot_stack, INV_SLOT_START, USE_ROW_SLOT_END, true)
   396	                        .await
   397	                    {
   398	                        return ItemStack::EMPTY.clone();
   399	                    }
   400	                } else if !self
   401	                    .insert_item(&mut slot_stack, 0, CRAFTER_SLOT_COUNT as i32, false)
   402	                    .await
   403	                {
   404	                    return ItemStack::EMPTY.clone();
   405	                }
   406	
   407	                if slot_stack.is_empty() {
   408	                    slot.set_stack(ItemStack::EMPTY.clone()).await;
   409	                } else {
   410	                    slot.set_stack(slot_stack.clone()).await;
   411	                }
   412	
   413	                // Either branch above may have touched an input slot (`slot_index < 9`, or a
   414	                // successful insert into `[0, 9)` from the player side): refresh the preview.
   415	                self.refresh_recipe_result().await;
   416	
   417	                // `CrafterMenu.java:91-95`.
   418	                if slot_stack.item_count == stack_left.item_count {
   419	                    return ItemStack::EMPTY.clone();
   420	                }
   421	                slot.on_take_item(player, &slot_stack).await;
   422	            }
   423	
   424	            stack_left
   425	        })
   426	    }
   427	}

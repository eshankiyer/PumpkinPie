   279	    /// Runs one function or function tag inside the current command chain.
   280	    ///
   281	    /// Port of the per-entry execution of vanilla's command queue
   282	    /// (`ExecutionContext.runCommandQueue`, `ExecutionContext.java:88-105`,
   283	    /// entries dispatched through `CommandQueueEntry.execute`,
   284	    /// `CommandQueueEntry.java:4-6`): every executed line costs one unit of the
   285	    /// chain quota, and an exhausted quota aborts the whole remaining chain with
   286	    /// vanilla's log message. Functions containing `$` macro lines are
   287	    /// instantiated first (`MacroFunction.instantiate`,
   288	    /// `MacroFunction.java:52-82`).
   289	    async fn execute_function_in_context(
   290	        &self,
   291	        server: &Arc<Server>,
   292	        source: &CommandSource,
   293	        name: &str,
   294	        arguments: Option<&NbtCompound>,
   295	        limit: i64,
   296	    ) -> Result<usize, ExecuteFunctionError> {
   297	        let (functions_to_run, is_tag) = if let Some(tag_name) = name.strip_prefix('#') {
   298	            let tags = self.function_tags.read().await;
   299	            let Some(fns) = tags.get(tag_name) else {
   300	                return Err(ExecuteFunctionError::Unknown(format!("#{tag_name}")));
   301	            };
   302	            (fns.clone(), true)
   303	        } else {
   304	            (vec![name.to_string()], false)
   305	        };
   306	
   307	        let all_fns = self.functions.read().await;
   308	        let mut total_executed = 0;
   309	
   310	        for fn_id in functions_to_run {
   311	            let Some(function) = all_fns.get(&fn_id) else {
   312	                if !is_tag {
   313	                    return Err(ExecuteFunctionError::Unknown(fn_id));
   314	                }
   315	                continue;
   316	            };
   317	
   318	            let lines = self.instantiate_lines(&fn_id, function, arguments)?;
   319	            for line in lines {
   320	                // Vanilla checks the quota before polling each queued entry and
   321	                // breaks out of the entire queue once it is spent
   322	                // (`ExecutionContext.java:89-92`).
   323	                let remaining = REMAINING_COMMAND_QUOTA.with(Cell::get);
   324	                if remaining <= 0 {
   325	                    // Vanilla logs the configured limit here
   326	                    // (`ExecutionContext.java:89-91`).
   327	                    info!("Command execution stopped due to limit (executed {limit} commands)");
   328	                    return Ok(total_executed);
   329	                }
   330	                REMAINING_COMMAND_QUOTA.with(|quota| quota.set(remaining - 1));
   331	
   332	                server
   333	                    .command_dispatcher
   334	                    .load()
   335	                    .handle_command(source, &line)
   336	                    .await;
   337	                total_executed += 1;
   338	            }
   339	        }
   340	
   341	        Ok(total_executed)
   342	    }

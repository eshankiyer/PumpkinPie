    91	                let _ = VarInt(i32::from(pumpkin_data::BlockState::to_be_network_id(
    92	                    state.id,
    93	                )))
    94	                .encode(&mut particle_data);
    95	                let look = player.living_entity.get_looking_vector();
    96	                let dust = match face {
    97	                    BlockDirection::Down | BlockDirection::Up => (look.z, -look.x),
    98	                    BlockDirection::North => (1.0, -0.1),
    99	                    BlockDirection::South => (-1.0, 0.1),
   100	                    BlockDirection::West => (-0.1, -1.0),
   101	                    BlockDirection::East => (0.1, 1.0),
   102	                };
   103	                let mut particle_position = position.to_centered_f64();
   104	                match face {
   105	                    BlockDirection::Down => particle_position.y -= 0.5,
   106	                    BlockDirection::Up => particle_position.y += 0.5,
   107	                    BlockDirection::North => particle_position.z -= 0.5,
   108	                    BlockDirection::South => particle_position.z += 0.5,
   109	                    BlockDirection::West => particle_position.x -= 0.5,
   110	                    BlockDirection::East => particle_position.x += 0.5,
   111	                }
   112	                world.spawn_particle_with_data(
   113	                    particle_position,
   114	                    Vector3::new((dust.0 * 3.0) as f32, 0.0, (dust.1 * 3.0) as f32),
   115	                    0.0,
   116	                    rand::random_range(7..12),
   117	                    pumpkin_data::particle::Particle::BlockCrumble,

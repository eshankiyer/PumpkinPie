   150	    fn take_jump_candidate(&mut self, mob: &dyn Mob) -> Option<PossibleJump> {
   151	        if self.candidates.is_empty() || self.total_weight <= 0 {
   152	            self.candidates.clear();
   153	            self.total_weight = 0;
   154	            return None;
   155	        }
   156	
   157	        let mut roll = mob.get_random().random_range(0..self.total_weight);
   158	        let mut index = self.candidates.len() - 1;
   159	        for (i, candidate) in self.candidates.iter().enumerate() {
   160	            roll -= candidate.weight;
   161	            if roll < 0 {
   162	                index = i;
   163	                break;
   164	            }
   165	        }
   166	
   167	        let candidate = self.candidates.swap_remove(index);
   168	        self.total_weight -= candidate.weight;
   169	        Some(candidate)
   170	    }

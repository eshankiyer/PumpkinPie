    77	    /// Fast non-blocking count of an item across all main inventory slots.
    78	    pub fn count_item(&self, item: &'static Item) -> u32 {
    79	        let mut total = 0u32;
    80	        if let Ok(inv) = self.main_inventory.try_read() {
    81	            for stack in inv.iter() {
    82	                if stack.get_item().id == item.id {
    83	                    total += u32::from(stack.item_count);
    84	                }
    85	            }
    86	        }
    87	        total
    88	    }

    81	        &self,
    82	        context: &'a CommandContext,
    83	        result: ReturnValue,
    84	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    85	        Box::pin(async move {
    86	            context.source.command_result_taker.call(result).await;
    87	        })
    88	    }
    89	}

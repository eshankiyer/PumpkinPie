   192	                    return ItemStack::EMPTY.clone();
   193	                }
   194	
   195	                if slot_stack.is_empty() {
   196	                    slot.set_stack(ItemStack::EMPTY.clone()).await;
   197	                } else {
   198	                    slot.set_stack(slot_stack).await;
   199	                }
   200	            }
   201	
   202	            stack_left
   203	        })
   204	    }

   232	    /// Vanilla `StructureBlockEntity.detectSize` (`StructureBlockEntity.java:264-288`)
   233	    /// searches nearby CORNER blocks with the same structure name and derives the inclusive
   234	    /// capture box. Only loaded positions can be inspected by this server-side world API.
   235	    pub async fn detect_size(&self, world: &Arc<World>) -> bool {
   236	        if self.mode.lock().await.as_str() != "SAVE" {
   237	            return false;
   238	        }
   239	
   240	        let name = self.name.lock().await.clone();
   241	        let x = self.position.0.x;
   242	        let z = self.position.0.z;
   243	        let mut corners = Vec::new();
   244	        for corner_x in x - 80..=x + 80 {
   245	            for corner_y in world.get_bottom_y()..=world.get_top_y() {
   246	                for corner_z in z - 80..=z + 80 {
   247	                    let candidate = BlockPos::new(corner_x, corner_y, corner_z);
   248	                    let Some(state_id) = world.get_block_state_id_if_loaded(&candidate) else {
   249	                        continue;
   250	                    };
   251	                    if Block::from_state_id(state_id).name != "structure_block" {
   252	                        continue;
   253	                    }
   254	                    let Some(block_entity) = world.get_block_entity(&candidate) else {
   255	                        continue;
   256	                    };
   257	                    let Some(corner) = block_entity.as_any().downcast_ref::<Self>() else {
   258	                        continue;
   259	                    };
   260	                    if corner.mode.lock().await.as_str() == "CORNER"
   261	                        && *corner.name.lock().await == name
   262	                    {
   263	                        corners.push(candidate);
   264	                    }
   265	                }
   266	            }
   267	        }
   268	
   269	        let Some(first) = corners.first().copied() else {
   270	            return false;
   271	        };
   272	        let (mut min_x, mut min_y, mut min_z) = (first.0.x, first.0.y, first.0.z);
   273	        let (mut max_x, mut max_y, mut max_z) = (min_x, min_y, min_z);
   274	        for corner in corners.iter().skip(1) {
   275	            min_x = min_x.min(corner.0.x);
   276	            min_y = min_y.min(corner.0.y);
   277	            min_z = min_z.min(corner.0.z);
   278	            max_x = max_x.max(corner.0.x);
   279	            max_y = max_y.max(corner.0.y);
   280	            max_z = max_z.max(corner.0.z);
   281	        }
   282	        if corners.len() == 1 {
   283	            min_x = min_x.min(x);
   284	            min_y = min_y.min(self.position.0.y);
   285	            min_z = min_z.min(z);
   286	            max_x = max_x.max(x);
   287	            max_y = max_y.max(self.position.0.y);
   288	            max_z = max_z.max(z);
   289	        }
   290	
   291	        let (delta_x, delta_y, delta_z) = (max_x - min_x, max_y - min_y, max_z - min_z);
   292	        if delta_x <= 1 || delta_y <= 1 || delta_z <= 1 {
   293	            return false;
   294	        }
   295	        self.set_structure_pos(BlockPos::new(
   296	            min_x - x + 1,
   297	            min_y - self.position.0.y + 1,
   298	            min_z - z + 1,
   299	        ))
   300	        .await;
   301	        self.set_structure_size(Vector3::new(delta_x - 1, delta_y - 1, delta_z - 1))
   302	            .await;
   303	        true
   304	    }

   167	/// `BrushableBlockEntity.getCompletionState` (`BrushableBlockEntity.java:230-238`).
   168	#[must_use]
   169	pub const fn completion_state(brush_count: i32) -> u8 {
   170	    if brush_count == 0 {
   171	        0
   172	    } else if brush_count < 3 {
   173	        1
   174	    } else if brush_count < 6 {
   175	        2
   176	    } else {
   177	        3
   178	    }
   179	}

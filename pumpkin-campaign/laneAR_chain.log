   226	   @Override
   227	   protected void affectNeighborsAfterRemoval(final BlockState state, final ServerLevel level, final BlockPos pos, final boolean movedByPiston) {
   228	      if (!movedByPiston) {
   229	         onRemoved(state, level, pos);
   230	      }
   231	   }
   232	
   233	   private static void onRemoved(final BlockState state, final Level level, final BlockPos pos) {
   234	      boolean attached = state.getValue(ATTACHED);
   235	      boolean powered = state.getValue(POWERED);
   236	      if (attached || powered) {
   237	         calculateState(level, pos, state, true, false, -1, null);
   238	      }
   239	
   240	      if (powered) {
   241	         notifyNeighbors(state.getBlock(), level, pos, state.getValue(FACING));
   242	      }
   243	   }

   131	    pub fn set_success_count(&self, count: u32) {
   132	        if let Self::CommandBlock(c, _) = self {
   133	            c.success_count
   134	                .store(count, std::sync::atomic::Ordering::SeqCst);
   135	        }
   136	    }

   185	        let mut angles = ALLOWED_ANGLES;
   186	        // `Collections.shuffle`, Fisher-Yates. Same shape as `breeze_jump.rs`.
   187	        for i in (1..angles.len()).rev() {
   188	            let j = mob.get_random().random_range(0..=i);
   189	            angles.swap(i, j);
   190	        }
   191	
   192	        let mob_pos = mob.get_entity().pos.load();
   193	        for angle in angles {
   194	            if let Some(velocity) = calculate_jump_vector_for_angle(
   195	                mob_pos,
   196	                target_pos,
   197	                gravity,
   198	                max_jump_velocity,
   199	                angle,
   200	            ) {
   201	                return Some(velocity);
   202	            }
   203	        }
   204	        None

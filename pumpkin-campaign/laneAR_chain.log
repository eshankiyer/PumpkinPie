   197	            self.target_delta_x.store(xa / dist * SPEED);
   198	            self.target_delta_y.store(ya / dist * SPEED);
   199	            self.target_delta_z.store(za / dist * SPEED);
   200	        }
   201	
   202	        self.current_dir.store(selected_dir, Ordering::Relaxed);
   203	        let steps = 10 + rand::rng().random_range(0..5) * 10;
   204	        self.flight_steps.store(steps, Ordering::Relaxed);
   205	    }

   107	
   108	   public static void calculateState(
   109	      final Level level,
   110	      final BlockPos pos,
   111	      final BlockState state,
   112	      final boolean isBeingDestroyed,
   113	      final boolean canUpdate,
   114	      final int wireSource,
   115	      final @Nullable BlockState wireSourceState
   116	   ) {
   117	      Optional<Direction> facingOptional = state.getOptionalValue(FACING);
   118	      if (facingOptional.isPresent()) {
   119	         Direction direction = facingOptional.get();
   120	         boolean wasAttached = state.getOptionalValue(ATTACHED).orElse(false);
   121	         boolean wasPowered = state.getOptionalValue(POWERED).orElse(false);
   122	         Block block = state.getBlock();
   123	         boolean attached = !isBeingDestroyed;
   124	         boolean powered = false;
   125	         int receiverPos = 0;
   126	         BlockState[] wireStates = new BlockState[42];
   127	
   128	         for (int i = 1; i < 42; i++) {
   129	            BlockPos testPos = pos.relative(direction, i);
   130	            BlockState wireState = level.getBlockState(testPos);
   131	            if (wireState.is(Blocks.TRIPWIRE_HOOK)) {
   132	               if (wireState.getValue(FACING) == direction.getOpposite()) {
   133	                  receiverPos = i;
   134	               }
   135	               break;
   136	            }
   137	
   138	            if (!wireState.is(Blocks.TRIPWIRE) && i != wireSource) {
   139	               wireStates[i] = null;
   140	               attached = false;
   141	            } else {
   142	               if (i == wireSource) {
   143	                  wireState = MoreObjects.firstNonNull(wireSourceState, wireState);
   144	               }
   145	
   146	               boolean wireArmed = !wireState.getValue(TripWireBlock.DISARMED);
   147	               boolean wirePowered = wireState.getValue(TripWireBlock.POWERED);
   148	               powered |= wireArmed && wirePowered;
   149	               wireStates[i] = wireState;
   150	               if (i == wireSource) {
   151	                  level.scheduleTick(pos, block, 10);
   152	                  attached &= wireArmed;
   153	               }
   154	            }
   155	         }
   156	
   157	         attached &= receiverPos > 1;
   158	         powered &= attached;
   159	         BlockState newState = block.defaultBlockState().trySetValue(ATTACHED, attached).trySetValue(POWERED, powered);
   160	         if (receiverPos > 0) {
   161	            BlockPos testPos = pos.relative(direction, receiverPos);
   162	            Direction opposite = direction.getOpposite();
   163	            level.setBlock(testPos, newState.setValue(FACING, opposite), 3);
   164	            notifyNeighbors(block, level, testPos, opposite);
   165	            if (!level.getBlockState(pos).is(Blocks.TRIPWIRE_HOOK)) {
   166	               onRemoved(newState, level, pos);
   167	               return;
   168	            }
   169	
   170	            emitState(level, testPos, attached, powered, wasAttached, wasPowered);
   171	         }
   172	
   173	         emitState(level, pos, attached, powered, wasAttached, wasPowered);
   174	         if (!isBeingDestroyed) {
   175	            level.setBlock(pos, newState.setValue(FACING, direction), 3);
   176	            if (canUpdate) {
   177	               notifyNeighbors(block, level, pos, direction);
   178	            }
   179	         }
   180	
   181	         if (wasAttached != attached) {
   182	            for (int i = 1; i < receiverPos; i++) {
   183	               BlockPos testPos = pos.relative(direction, i);
   184	               BlockState wireData = wireStates[i];
   185	               if (wireData != null) {
   186	                  BlockState testPosState = level.getBlockState(testPos);
   187	                  if (testPosState.is(Blocks.TRIPWIRE) || testPosState.is(Blocks.TRIPWIRE_HOOK)) {
   188	                     level.setBlock(testPos, wireData.trySetValue(ATTACHED, attached), 3);
   189	                  }
   190	               }
   191	            }
   192	         }
   193	      }
   194	   }

   350	enum BrushOutcome {
   351	    /// Cooldown, or a stroke that did not change the `dusted` stage.
   352	    Unchanged,
   353	    Dusted(u8),
   354	    Completed(Option<ItemStack>, BlockDirection),
   355	}

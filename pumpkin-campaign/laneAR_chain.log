    58	/// Represents the source of a command execution.
    59	///
    60	/// Different senders have different permissions, output targets, and
    61	/// positions in the world. This enum abstracts those differences for the
    62	/// command dispatcher.
    63	#[derive(Clone)]
    64	pub enum CommandSender {
    65	    /// A remote console connection via the RCON protocol.
    66	    ///
    67	    /// Stores an asynchronous buffer to capture command output
    68	    /// so it can be sent back over the network to the RCON client.
    69	    Rcon(Arc<tokio::sync::Mutex<Vec<String>>>),
    70	    /// The local server terminal/console.
    71	    ///
    72	    /// This sender typically has absolute permissions (bypass) and
    73	    /// outputs directly to the server logs.
    74	    Console,
    75	    /// A player currently connected to the server.
    76	    ///
    77	    /// Contains a reference to the [Player] struct to access their
    78	    /// location, permissions, and session.
    79	    Player(Arc<Player>),
    80	    /// A Command Block or Command Block Minecart.
    81	    ///
    82	    /// Contains the block entity responsible for the command and the
    83	    /// world context it exists in for coordinate-relative execution (e.g., `~ ~ ~`).
    84	    CommandBlock(Arc<CommandBlockEntity>, Arc<World>),
    85	    /// Nothingness. Anything sent to this sender is void.
    86	    /// Has the same permissions as that of `CommandBlock`.
    87	    Dummy,
    88	}
    89	
    90	impl fmt::Display for CommandSender {
    91	    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
    92	        write!(
    93	            f,
    94	            "{}",
    95	            match self {
    96	                Self::Console => "Server",
    97	                Self::Rcon(_) => "Rcon",
    98	                Self::Player(p) => &p.gameprofile.name,
    99	                Self::CommandBlock(..) => "@",
   100	                Self::Dummy => "",
   101	            }
   102	        )
   103	    }
   104	}

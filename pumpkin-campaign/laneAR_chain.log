   405	    /// Sends a message to this source.
   406	    pub async fn send_message(&self, message: TextComponent) {
   407	        if !self.silent {
   408	            self.output.send_message(message).await;
   409	        }
   410	    }
   411	
   412	    /// Sends a message to all online operators.
   413	    async fn send_to_ops(&self, message: TextComponent) {
   414	        let text = TextComponent::translate_cross(
   415	            "chat.type.admin",
   416	            "chat.type.admin",
   417	            &[self.display_name.clone(), message],
   418	        )
   419	        .color(Color::Named(NamedColor::Gray))
   420	        .italic();
   421	        let Some(server) = &self.server else {
   422	            return;
   423	        };
   424	        if server.level_info.load().game_rules.send_command_feedback {
   425	            let output_player = match &self.output {
   426	                CommandSender::Player(sender) => Some(sender),
   427	                _ => None,
   428	            };
   429	            for player in server.get_all_players() {
   430	                if output_player != Some(&player)
   431	                    && player.permission_lvl.load() >= server.basic_config.op_permission_level
   432	                {
   433	                    player.send_system_message(&text).await;
   434	                }
   435	            }
   436	        }
   437	    }
   438	
   439	    /// Sends feedback to this source.
   440	    pub async fn send_feedback(&self, message: TextComponent, broadcast_to_ops: bool) {
   441	        if !self.silent {
   442	            let should_send_to_output = self.output.should_receive_feedback();
   443	            let should_send_to_ops =
   444	                broadcast_to_ops && self.output.should_broadcast_console_to_ops();
   445	
   446	            if should_send_to_output {
   447	                self.output.send_message(message.clone()).await;
   448	            }
   449	            if should_send_to_ops {
   450	                self.send_to_ops(message).await;
   451	            }
   452	        }
   453	    }
   454	
   455	    /// Sends an error message to the console.
   456	    ///
   457	    /// # Note
   458	    /// Do not use this function if you want to report a [`CommandSyntaxError`].
   459	    /// Instead, wrap the error in an [`Err`] and return that (or use the `?` operator)
   460	    ///
   461	    /// However, there are still use cases of this function to send an error
   462	    /// without reporting command failure directly.
   463	    pub async fn send_error(&self, error: TextComponent) {
   464	        if !self.silent && self.output.should_track_output() {
   465	            self.output
   466	                .send_message(
   467	                    TextComponent::empty()
   468	                        .add_child(error)
   469	                        .color(Color::Named(NamedColor::Red)),
   470	                )
   471	                .await;
   472	        }
   473	    }

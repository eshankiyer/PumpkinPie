   337	    /// Returns a new [`CommandSource`] with the rotation changed in such
   338	    /// a way that the source faces the provided position and
   339	    /// everything else from the `source` provided.
   340	    #[must_use]
   341	    pub fn with_looking_at_pos(self, pos: Vector3<f64>) -> Self {
   342	        let source_pos = self.entity_anchor.position_at_source(&self);
   343	        let delta = pos.sub(&source_pos);
   344	        let horizontal_len = delta.horizontal_length();
   345	        let pitch = -delta.y.atan2(horizontal_len).to_degrees();
   346	        let yaw = delta.z.atan2(delta.x).to_degrees() - 90.0;
   347	        self.with_rotation(Vector2::new(
   348	            wrap_degrees(pitch as f32),
   349	            wrap_degrees(yaw as f32),
   350	        ))
   351	    }

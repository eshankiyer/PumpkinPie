   119	            for entry in entries.flatten() {
   120	                let pack_path = entry.path();
   121	                let file_name = entry.file_name().to_string_lossy().to_string();
   122	
   123	                if file_name.starts_with('.') || !pack_path.is_dir() {
   124	                    continue;
   125	                }
   126	
   127	                let pack_id = format!("file/{file_name}");
   128	                let is_enabled = enabled_packs

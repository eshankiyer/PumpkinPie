   323	    /// Inserts a specific count from a stack.
   324	    ///
   325	    /// Returns any leftover items.
   326	    fn insert_stack_count(&self, mut stack: ItemStack, count: u8) -> BoxFuture<'_, ItemStack> {
   327	        // Default implementation logic:
   328	        Box::pin(async move {
   329	            if !stack.is_empty() && self.can_insert(&stack).await {
   330	                let mut stack_self = self.get_stack().await;
   331	                // `Slot.safeInsert` (`Slot.java:137-140`) computes the headroom as a signed
   332	                // int and bails when it is not positive. Doing the subtraction on `u8`
   333	                // underflows whenever the slot already holds more items than the incoming
   334	                // stack's own max size allows -- e.g. shift-clicking ender pearls (max 16)
   335	                // onto a slot holding 64 cobblestone -- which panics in debug builds.
   336	                let headroom = self
   337	                    .get_max_item_count_for_stack(&stack)
   338	                    .await
   339	                    .saturating_sub(stack_self.item_count);
   340	                let min_count = count.min(stack.item_count).min(headroom);
   341	
   342	                if min_count != 0 {
   343	                    if stack_self.is_empty() {
   344	                        self.set_stack(stack.split(min_count)).await;
   345	                    } else if stack.are_items_and_components_equal(&stack_self) {
   346	                        stack.decrement(min_count);
   347	                        stack_self.increment(min_count);
   348	                        self.set_stack(stack_self).await;
   349	                    }

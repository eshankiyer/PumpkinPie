   124	
   125	async fn handle_growing_plant(
   126	    player: &Player,
   127	    location: &BlockPos,
   128	    block: &Block,
   129	    state_id: BlockStateId,
   130	) -> bool {
   131	    let is_growing_plant = block.id == Block::KELP.id
   132	        || block.id == Block::CAVE_VINES.id
   133	        || block.id == Block::CAVE_VINES_PLANT.id
   134	        || block.id == Block::TWISTING_VINES.id
   135	        || block.id == Block::WEEPING_VINES.id;
   136	
   137	    if !is_growing_plant {
   138	        return false;
   139	    }
   140	
   141	    let world = player.world();
   142	    let action = block.properties(state_id).and_then(|props| {
   143	        let prop_map = props.to_props();
   144	        prop_map
   145	            .iter()
   146	            .find(|(k, _)| *k == "age")
   147	            .and_then(|(_, age_str)| age_str.parse::<u8>().ok())
   148	            .filter(|&age| age < 25)
   149	            .map(|_| {
   150	                let new_props: Vec<(&str, &str)> = prop_map
   151	                    .iter()
   152	                    .map(|(k, v)| if *k == "age" { (*k, "25") } else { (*k, *v) })
   153	                    .collect();
   154	                block.from_properties(&new_props).to_state_id(block)
   155	            })
   156	    });
   157	
   158	    if let Some(new_state_id) = action {
   159	        world
   160	            .set_block_state(location, new_state_id, BlockFlags::NOTIFY_ALL)
   161	            .await;
   162	        world.play_sound(
   163	            Sound::BlockGrowingPlantCrop,
   164	            SoundCategory::Blocks,
   165	            &location.to_f64(),
   166	        );
   167	        player.damage_held_item(1).await;
   168	        return true;
   169	    }
   170	
   171	    false
   172	}
   173	
   174	async fn handle_beehive(
   175	    player: &Player,
   176	    location: &BlockPos,
   177	    block: &Block,
   178	    state_id: BlockStateId,
   179	) -> bool {
   180	    if block.id != Block::BEEHIVE.id && block.id != Block::BEE_NEST.id {
   181	        return false;
   182	    }
   183	
   184	    let world = player.world();
   185	    let action = block.properties(state_id).and_then(|props| {
   186	        let prop_map = props.to_props();
   187	        prop_map
   188	            .iter()
   189	            .find(|(k, v)| *k == "honey_level" && *v == "5")
   190	            .map(|_| {
   191	                let new_props: Vec<(&str, &str)> = prop_map
   192	                    .iter()
   193	                    .map(|(k, v)| {
   194	                        if *k == "honey_level" {
   195	                            (*k, "0")
   196	                        } else {
   197	                            (*k, *v)
   198	                        }
   199	                    })
   200	                    .collect();
   201	                block.from_properties(&new_props).to_state_id(block)
   202	            })
   203	    });
   204	
   205	    if let Some(new_state_id) = action {
   206	        world
   207	            .set_block_state(location, new_state_id, BlockFlags::NOTIFY_ALL)
   208	            .await;
   209	        world.play_sound(
   210	            Sound::BlockBeehiveShear,
   211	            SoundCategory::Blocks,
   212	            &location.to_f64(),
   213	        );
   214	
   215	        let drop_pos = Vector3::new(
   216	            f64::from(location.0.x) + 0.5,
   217	            f64::from(location.0.y) + 0.5,
   218	            f64::from(location.0.z) + 0.5,
   219	        );
   220	        let item_entity = Arc::new(ItemEntity::new(
   221	            Entity::new(world.clone(), drop_pos, &EntityType::ITEM),
   222	            ItemStack::new(3, &Item::HONEYCOMB),
   223	        ));
   224	        world.spawn_entity(item_entity).await;
   225	        player.damage_held_item(1).await;
   226	        return true;
   227	    }
   228	
   229	    false
   230	}
   231	
   232	async fn handle_pumpkin(player: &Player, location: &BlockPos, block: &Block) {
   233	    if block.id == Block::PUMPKIN.id {
   234	        let world = player.world();
   235	        let carved_state = Block::CARVED_PUMPKIN.default_state.id;
   236	        world
   237	            .set_block_state(location, carved_state, BlockFlags::NOTIFY_ALL)
   238	            .await;
   239	        world.play_sound(
   240	            Sound::BlockPumpkinCarve,
   241	            SoundCategory::Blocks,
   242	            &location.to_f64(),
   243	        );
   244	
   245	        let drop_pos = Vector3::new(
   246	            f64::from(location.0.x) + 0.5,
   247	            f64::from(location.0.y) + 0.5,
   248	            f64::from(location.0.z) + 0.5,
   249	        );
   250	        let item_entity = Arc::new(ItemEntity::new(
   251	            Entity::new(world.clone(), drop_pos, &EntityType::ITEM),
   252	            ItemStack::new(4, &Item::PUMPKIN_SEEDS),
   253	        ));
   254	        world.spawn_entity(item_entity).await;
   255	        player.damage_held_item(1).await;
   256	    }
   257	}

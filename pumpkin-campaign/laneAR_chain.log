   432	fn read_pack_mcmeta(pack_path: &Path) -> (String, u32) {
   433	    let mcmeta_path = pack_path.join("pack.mcmeta");
   434	    if let Ok(content) = fs::read_to_string(mcmeta_path)
   435	        && let Ok(val) = serde_json::from_str::<serde_json::Value>(&content)
   436	    {
   437	        let pack = val.get("pack");
   438	        let description = pack
   439	            .and_then(|p| p.get("description"))
   440	            .map(|d| {
   441	                d.as_str()
   442	                    .map_or_else(|| d.to_string(), ToString::to_string)
   443	            })
   444	            .unwrap_or_default();
   445	        let pack_format = pack
   446	            .and_then(|p| p.get("pack_format"))
   447	            .and_then(serde_json::Value::as_u64)
   448	            .unwrap_or(61) as u32;
   449	        return (description, pack_format);
   450	    }
   451	    (String::new(), 61)
   452	}

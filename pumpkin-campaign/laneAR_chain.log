    85	/// Returns the server-side step/fall sounds and the vanilla sound volume/pitch modifiers.
    86	/// `BlockBehaviour.getSoundType` returns the registered `SoundType` (`BlockBehaviour.java:405-407`);
    87	/// common material registrations are in `SoundType.java:10-46` and
    88	/// `Blocks.java:83-98,315-324,547-552,557-563`.
    89	#[must_use]
    90	#[expect(clippy::too_many_lines)]
    91	pub(crate) fn block_sound_type(block: &Block) -> (Sound, Sound, f32, f32) {
    92	    let name = block.name;
    93	    match name {
    94	        "anvil" => (Sound::BlockAnvilStep, Sound::BlockAnvilFall, 0.3, 1.0),
    95	        "slime_block" => (
    96	            Sound::BlockSlimeBlockStep,
    97	            Sound::BlockSlimeBlockFall,
    98	            1.0,
    99	            1.0,
   100	        ),
   101	        "honey_block" => (
   102	            Sound::BlockHoneyBlockStep,
   103	            Sound::BlockHoneyBlockFall,
   104	            1.0,
   105	            1.0,
   106	        ),
   107	        "powder_snow" => (
   108	            Sound::BlockPowderSnowStep,
   109	            Sound::BlockPowderSnowFall,
   110	            1.0,
   111	            1.0,
   112	        ),
   113	        "snow" | "snow_block" => (Sound::BlockSnowStep, Sound::BlockSnowFall, 1.0, 1.0),
   114	        "sand" | "red_sand" => (Sound::BlockSandStep, Sound::BlockSandFall, 1.0, 1.0),
   115	        "suspicious_sand" => (
   116	            Sound::BlockSuspiciousSandStep,
   117	            Sound::BlockSuspiciousSandFall,
   118	            1.0,
   119	            1.0,
   120	        ),
   121	        "gravel" => (Sound::BlockGravelStep, Sound::BlockGravelFall, 1.0, 1.0),
   122	        "suspicious_gravel" => (
   123	            Sound::BlockSuspiciousGravelStep,
   124	            Sound::BlockSuspiciousGravelFall,
   125	            1.0,
   126	            1.0,
   127	        ),
   128	        "glass" | "glass_pane" | "tinted_glass" => {
   129	            (Sound::BlockGlassStep, Sound::BlockGlassFall, 1.0, 1.0)
   130	        }
   131	        name if name.ends_with("_glass") || name.ends_with("_glass_pane") => {
   132	            (Sound::BlockGlassStep, Sound::BlockGlassFall, 1.0, 1.0)
   133	        }
   134	        "grass_block" | "short_grass" | "tall_grass" => {
   135	            (Sound::BlockGrassStep, Sound::BlockGrassFall, 1.0, 1.0)
   136	        }
   137	        name if name.ends_with("_leaves") => {
   138	            (Sound::BlockGrassStep, Sound::BlockGrassFall, 1.0, 1.0)
   139	        }
   140	        "dirt" | "coarse_dirt" | "podzol" | "mycelium" | "rooted_dirt" | "dirt_path"
   141	        | "farmland" | "clay" => (Sound::BlockGravelStep, Sound::BlockGravelFall, 1.0, 1.0),
   142	        "moss_block" => (Sound::BlockMossStep, Sound::BlockMossFall, 1.0, 1.0),
   143	        "mud" => (Sound::BlockMudStep, Sound::BlockMudFall, 1.0, 1.0),
   144	        "netherrack" => (
   145	            Sound::BlockNetherrackStep,
   146	            Sound::BlockNetherrackFall,
   147	            1.0,
   148	            1.0,
   149	        ),
   150	        name if name.starts_with("deepslate") => (
   151	            Sound::BlockDeepslateStep,
   152	            Sound::BlockDeepslateFall,
   153	            1.0,
   154	            1.0,
   155	        ),
   156	        name if name.starts_with("copper") || name.ends_with("_copper_block") => {
   157	            (Sound::BlockCopperStep, Sound::BlockCopperFall, 1.0, 1.0)
   158	        }
   159	        name if name.starts_with("tuff") => (Sound::BlockTuffStep, Sound::BlockTuffFall, 1.0, 1.0),
   160	        name if name.starts_with("resin") => {
   161	            (Sound::BlockResinStep, Sound::BlockResinFall, 1.0, 1.0)
   162	        }
   163	        name if name.starts_with("sulfur") => {
   164	            (Sound::BlockSulfurStep, Sound::BlockSulfurFall, 1.0, 1.0)
   165	        }
   166	        name if name.starts_with("cinnabar") => {
   167	            (Sound::BlockCinnabarStep, Sound::BlockCinnabarFall, 1.0, 1.0)
   168	        }
   169	        "bamboo" | "bamboo_sapling" => (Sound::BlockBambooStep, Sound::BlockBambooFall, 1.0, 1.0),
   170	        name if name.starts_with("bamboo_") => (
   171	            Sound::BlockBambooWoodStep,
   172	            Sound::BlockBambooWoodFall,
   173	            1.0,
   174	            1.0,
   175	        ),
   176	        name if name.starts_with("cherry_")
   177	            && (name.ends_with("_planks") || name.ends_with("_log") || name.ends_with("_wood")) =>
   178	        {
   179	            (
   180	                Sound::BlockCherryWoodStep,
   181	                Sound::BlockCherryWoodFall,
   182	                1.0,
   183	                1.0,
   184	            )
   185	        }
   186	        name if (name.starts_with("crimson_") || name.starts_with("warped_"))
   187	            && (name.ends_with("_planks")
   188	                || name.ends_with("_stem")
   189	                || name.ends_with("_hyphae")) =>
   190	        {
   191	            (
   192	                Sound::BlockNetherWoodStep,
   193	                Sound::BlockNetherWoodFall,
   194	                1.0,
   195	                1.0,
   196	            )
   197	        }
   198	        name if name.ends_with("_planks")
   199	            || name.ends_with("_log")
   200	            || name.ends_with("_wood")
   201	            || name.starts_with("stripped_") =>
   202	        {
   203	            (Sound::BlockWoodStep, Sound::BlockWoodFall, 1.0, 1.0)
   204	        }
   205	        name if name.ends_with("_wool") || name.ends_with("_carpet") => {
   206	            (Sound::BlockWoolStep, Sound::BlockWoolFall, 1.0, 1.0)
   207	        }
   208	        name if name == "iron_block" || name.ends_with("_iron_bars") => {
   209	            (Sound::BlockIronStep, Sound::BlockIronFall, 1.0, 1.0)
   210	        }
   211	        name if name.ends_with("_block") && (name.contains("gold") || name.contains("diamond")) => {
   212	            (Sound::BlockMetalStep, Sound::BlockMetalFall, 1.0, 1.0)
   213	        }
   214	        _ => (Sound::BlockStoneStep, Sound::BlockStoneFall, 1.0, 1.0),
   215	    }
   216	}

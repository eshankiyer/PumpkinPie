   212	// Free-standing step helpers (used inside async closures that can't capture self.*)
   213	const fn dir_step_x_s(dir: u8) -> i32 {
   214	    match dir {
   215	        DIR_EAST => 1,
   216	        DIR_WEST => -1,
   217	        _ => 0,
   218	    }
   219	}
   220	const fn dir_step_y_s(dir: u8) -> i32 {
   221	    match dir {
   222	        DIR_UP => 1,
   223	        DIR_DOWN => -1,
   224	        _ => 0,
   225	    }
   226	}
   227	const fn dir_step_z_s(dir: u8) -> i32 {
   228	    match dir {
   229	        DIR_SOUTH => 1,
   230	        DIR_NORTH => -1,
   231	        _ => 0,
   232	    }
   233	}
   234	
   235	/// Returns the axis ordinal (0=X, 1=Y, 2=Z) of a direction.
   236	/// Returns 255 for `DIR_NONE` or any unknown value.
   237	const fn dir_axis(dir: u8) -> u8 {
   238	    match dir {
   239	        DIR_EAST | DIR_WEST => 0,
   240	        DIR_UP | DIR_DOWN => 1,
   241	        DIR_NORTH | DIR_SOUTH => 2,
   242	        _ => 255,
   243	    }
   244	}
   245	
   246	/// `true` if the block one step in `dir` from `from` is air (the bullet
   247	/// can pass through it). Unloaded chunks are treated as empty.
   248	fn is_empty_block(world: &crate::world::World, from: &BlockPos, dir: u8) -> bool {
   249	    let nb = BlockPos::new(
   250	        from.0.x + dir_step_x_s(dir),
   251	        from.0.y + dir_step_y_s(dir),
   252	        from.0.z + dir_step_z_s(dir),
   253	    );
   254	    world
   255	        .get_block_state_if_loaded(&nb)
   256	        .is_none_or(pumpkin_data::BlockState::is_air)
   257	}

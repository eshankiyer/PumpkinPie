   130	                    .any(|p| p == &pack_id || p == &file_name);
   131	                if !is_enabled {
   132	                    continue;
   133	                }
   134	
   135	                let (description, pack_format) = read_pack_mcmeta(&pack_path);
   136	
   137	                let data_dir = pack_path.join("data");
   138	                let mut pack_recipe_count = 0;
   139	                let mut pack_function_count = 0;
   140	
   141	                if data_dir.is_dir()
   142	                    && let Ok(ns_entries) = fs::read_dir(&data_dir)
   143	                {
   144	                    for ns_entry in ns_entries.flatten() {
   145	                        let ns_path = ns_entry.path();
   146	                        if !ns_path.is_dir() {
   147	                            continue;
   148	                        }
   149	                        let namespace = ns_entry.file_name().to_string_lossy().to_string();
   150	
   151	                        // Load recipes
   152	                        for recipe_sub in ["recipe", "recipes"] {
   153	                            let recipe_dir = ns_path.join(recipe_sub);
   154	                            if recipe_dir.is_dir() {
   155	                                load_recipes_from_dir(
   156	                                    &namespace,
   157	                                    &recipe_dir,
   158	                                    &mut all_recipes,
   159	                                    &mut pack_recipe_count,
   160	                                );
   161	                            }
   162	                        }
   163	
   164	                        // Load functions
   165	                        for fn_sub in ["function", "functions"] {
   166	                            let fn_dir = ns_path.join(fn_sub);
   167	                            if fn_dir.is_dir() {
   168	                                let before = all_functions.len();
   169	                                function_loader::load_functions_from_dir(
   170	                                    &namespace,
   171	                                    &fn_dir,
   172	                                    &mut all_functions,
   173	                                );
   174	                                pack_function_count += all_functions.len() - before;
   175	                            }
   176	                        }
   177	
   178	                        // Load tags
   179	                        let tags_dir = ns_path.join("tags");
   180	                        if tags_dir.is_dir() {
   181	                            function_loader::load_function_tags_from_dir(
   182	                                &namespace,
   183	                                &tags_dir,
   184	                                &mut all_function_tags,
   185	                            );
   186	                        }
   187	                    }
   188	                }
   189	
   190	                info!(
   191	                    "Loaded datapack '{file_name}': {pack_recipe_count} recipe(s), {pack_function_count} function(s)"
   192	                );
   193	
   194	                loaded_packs_vec.push(LoadedDatapack {
   195	                    id: pack_id,
   196	                    name: file_name,
   197	                    description,
   198	                    pack_format,
   199	                    root_path: pack_path,
   200	                    recipe_count: pack_recipe_count,
   201	                    function_count: pack_function_count,
   202	                });
   203	            }
   204	        }
   205	
   206	        recipe_manager.set_recipes(all_recipes).await;
   207	        *self.loaded_packs.write().await = loaded_packs_vec;
   208	        *self.functions.write().await = all_functions;
   209	        *self.function_tags.write().await = all_function_tags;
   210	        // Instantiations of the old function set are invalid now; vanilla gets
   211	        // this for free because each reload builds fresh MacroFunction objects.
   212	        self.instantiation_caches
   213	            .lock()
   214	            .unwrap_or_else(std::sync::PoisonError::into_inner)
   215	            .clear();
   216	    }

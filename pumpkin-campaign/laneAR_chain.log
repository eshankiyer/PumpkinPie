   121	            if (current.getX() < targetPos.getX() && this.level().isEmptyBlock(current.east())) {
   122	               options.add(Direction.EAST);
   123	            } else if (current.getX() > targetPos.getX() && this.level().isEmptyBlock(current.west())) {
   124	               options.add(Direction.WEST);
   125	            }
   126	         }
   127	
   128	         if (avoidAxis != Direction.Axis.Y) {
   129	            if (current.getY() < targetPos.getY() && this.level().isEmptyBlock(current.above())) {
   130	               options.add(Direction.UP);
   131	            } else if (current.getY() > targetPos.getY() && this.level().isEmptyBlock(current.below())) {
   132	               options.add(Direction.DOWN);
   133	            }
   134	         }
   135	
   136	         if (avoidAxis != Direction.Axis.Z) {
   137	            if (current.getZ() < targetPos.getZ() && this.level().isEmptyBlock(current.south())) {
   138	               options.add(Direction.SOUTH);
   139	            } else if (current.getZ() > targetPos.getZ() && this.level().isEmptyBlock(current.north())) {
   140	               options.add(Direction.NORTH);
   141	            }
   142	         }
   143	
   144	         selection = Direction.getRandom(this.random);
   145	         if (options.isEmpty()) {

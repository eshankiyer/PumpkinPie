   124	   private void updateSource(final Level level, final BlockPos pos, final BlockState state) {
   125	      for (Direction direction : new Direction[]{Direction.SOUTH, Direction.WEST}) {
   126	         for (int i = 1; i < 42; i++) {
   127	            BlockPos testPos = pos.relative(direction, i);
   128	            BlockState block = level.getBlockState(testPos);
   129	            if (block.is(this.hook)) {
   130	               if (block.getValue(TripWireHookBlock.FACING) == direction.getOpposite()) {
   131	                  TripWireHookBlock.calculateState(level, testPos, block, false, true, i, state);
   132	               }
   133	               break;
   134	            }
   135	
   136	            if (!block.is(this)) {
   137	               break;
   138	            }
   139	         }
   140	      }
   141	   }

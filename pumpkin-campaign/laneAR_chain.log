   103	   private void selectNextMoveDirection(final Direction.@Nullable Axis avoidAxis, final @Nullable Entity target) {
   104	      double yOffset = 0.5;
   105	      BlockPos targetPos;
   106	      if (target == null) {
   107	         targetPos = this.blockPosition().below();
   108	      } else {
   109	         yOffset = target.getBbHeight() * 0.5;
   110	         targetPos = BlockPos.containing(target.getX(), target.getY() + yOffset, target.getZ());
   111	      }
   112	
   113	      double targetX = targetPos.getX() + 0.5;
   114	      double targetY = targetPos.getY() + yOffset;
   115	      double targetZ = targetPos.getZ() + 0.5;
   116	      Direction selection = null;
   117	      if (!targetPos.closerToCenterThan(this.position(), 2.0)) {
   118	         BlockPos current = this.blockPosition();
   119	         List<Direction> options = Lists.newArrayList();
   120	         if (avoidAxis != Direction.Axis.X) {
   121	            if (current.getX() < targetPos.getX() && this.level().isEmptyBlock(current.east())) {
   122	               options.add(Direction.EAST);
   123	            } else if (current.getX() > targetPos.getX() && this.level().isEmptyBlock(current.west())) {
   124	               options.add(Direction.WEST);
   125	            }
   126	         }
   127	
   128	         if (avoidAxis != Direction.Axis.Y) {
   129	            if (current.getY() < targetPos.getY() && this.level().isEmptyBlock(current.above())) {
   130	               options.add(Direction.UP);
   131	            } else if (current.getY() > targetPos.getY() && this.level().isEmptyBlock(current.below())) {
   132	               options.add(Direction.DOWN);
   133	            }
   134	         }
   135	
   136	         if (avoidAxis != Direction.Axis.Z) {
   137	            if (current.getZ() < targetPos.getZ() && this.level().isEmptyBlock(current.south())) {
   138	               options.add(Direction.SOUTH);
   139	            } else if (current.getZ() > targetPos.getZ() && this.level().isEmptyBlock(current.north())) {
   140	               options.add(Direction.NORTH);
   141	            }
   142	         }
   143	
   144	         selection = Direction.getRandom(this.random);
   145	         if (options.isEmpty()) {
   146	            for (int attempts = 5; !this.level().isEmptyBlock(current.relative(selection)) && attempts > 0; attempts--) {
   147	               selection = Direction.getRandom(this.random);
   148	            }
   149	         } else {
   150	            selection = options.get(this.random.nextInt(options.size()));
   151	         }
   152	
   153	         targetX = this.getX() + selection.getStepX();
   154	         targetY = this.getY() + selection.getStepY();
   155	         targetZ = this.getZ() + selection.getStepZ();
   156	      }
   157	
   158	      this.setMoveDirection(selection);
   159	      double xa = targetX - this.getX();
   160	      double ya = targetY - this.getY();
   161	      double za = targetZ - this.getZ();
   162	      double distance = Math.sqrt(xa * xa + ya * ya + za * za);
   163	      if (distance == 0.0) {
   164	         this.targetDeltaX = 0.0;
   165	         this.targetDeltaY = 0.0;
   166	         this.targetDeltaZ = 0.0;
   167	      } else {
   168	         this.targetDeltaX = xa / distance * 0.15;
   169	         this.targetDeltaY = ya / distance * 0.15;
   170	         this.targetDeltaZ = za / distance * 0.15;
   171	      }
   172	
   173	      this.needsSync = true;
   174	      this.flightSteps = 10 + this.random.nextInt(5) * 10;
   175	   }

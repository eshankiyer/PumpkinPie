   169	            let slot = self.get_behaviour().slots[slot_index as usize].clone();
   170	            let container_size = SHULKER_BOX_SIZE as i32;
   171	
   172	            if slot.has_stack().await {
   173	                let mut slot_stack = slot.get_stack().await;
   174	                stack_left = slot_stack.clone();
   175	
   176	                if slot_index < container_size {
   177	                    if !self
   178	                        .insert_item(
   179	                            &mut slot_stack,
   180	                            container_size,
   181	                            self.get_behaviour().slots.len() as i32,
   182	                            true,
   183	                        )
   184	                        .await
   185	                    {
   186	                        return ItemStack::EMPTY.clone();
   187	                    }

    88	impl TryFrom<i32> for Status {
    89	    type Error = InvalidStatus;
    90	
    91	    fn try_from(value: i32) -> Result<Self, Self::Error> {
    92	        match value {
    93	            0 => Ok(Self::StartedDigging),
    94	            1 => Ok(Self::CancelledDigging),
    95	            2 => Ok(Self::FinishedDigging),
    96	            3 => Ok(Self::DropItemStack),
    97	            4 => Ok(Self::DropItem),
    98	            5 => Ok(Self::ReleaseItemInUse),
    99	            6 => Ok(Self::SwapItem),
   100	            7 => Ok(Self::SpearJab),
   101	            _ => Err(InvalidStatus),
   102	        }
   103	    }
   104	}

    44	
    45	/// `LongJumpToRandomPos.FIND_JUMP_TRIES` (`LongJumpToRandomPos.java:31`).
    46	const FIND_JUMP_TRIES: i32 = 20;
    47	/// `LongJumpToRandomPos.PREPARE_JUMP_DURATION` (`LongJumpToRandomPos.java:32`).
    48	const PREPARE_JUMP_DURATION: i32 = 40;
    49	/// `LongJumpToRandomPos.MIN_PATHFIND_DISTANCE_TO_VALID_JUMP` (`LongJumpToRandomPos.java:33`).
    50	const MIN_PATHFIND_DISTANCE_TO_VALID_JUMP: f32 = 8.0;
    51	/// `LongJumpMidJump.TIME_OUT_DURATION` (`LongJumpMidJump.java:14`).
    52	const MID_JUMP_TIME_OUT: i32 = 100;
    53	/// `LongJumpToRandomPos.ALLOWED_ANGLES` (`LongJumpToRandomPos.java:34`).
    54	const ALLOWED_ANGLES: [i32; 4] = [65, 70, 75, 80];
    55	/// See the module doc: bounds the per-tick pathfinding that vanilla leaves unbounded.
    56	const CANDIDATES_PER_TICK: usize = 8;
    57	/// A launched goat needs at least this many ticks in the air before `onGround` is believed,
    58	/// since the flag is still set on the tick the launch velocity is applied.
    59	const MIN_AIRBORNE_TICKS: i32 = 2;
    60	
    61	/// One entry of `LongJumpToRandomPos.jumpCandidates`: a landing block and its selection weight

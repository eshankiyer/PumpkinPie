   444	            self.add_slot(Arc::new(NormalSlot::new(player_inventory.clone(), i)));
   445	        }
   446	    }
   447	
   448	    /// Adds main inventory slots (9-35) from the player inventory.
   449	    fn add_player_inventory_slots(&mut self, player_inventory: &Arc<dyn Inventory>) {

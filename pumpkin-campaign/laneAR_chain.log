    31	
    32	   protected StructureBlock(final BlockBehaviour.Properties properties) {
    33	      super(properties);
    34	      this.registerDefaultState(this.stateDefinition.any().setValue(MODE, StructureMode.LOAD));
    35	   }
    36	
    37	   @Override
    38	   public BlockEntity newBlockEntity(final BlockPos worldPosition, final BlockState blockState) {
    39	      return new StructureBlockEntity(worldPosition, blockState);

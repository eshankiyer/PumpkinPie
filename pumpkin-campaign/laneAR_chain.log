   106	impl CommandSender {
   107	    pub async fn send_message(&self, text: TextComponent) {
   108	        match self {
   109	            #[allow(clippy::print_stdout)]
   110	            Self::Console => println!("{}", text.to_pretty_console()),
   111	            Self::Player(c) => c.send_system_message(&text).await,
   112	            Self::Rcon(s) => s.lock().await.push(text.to_pretty_console()),
   113	            Self::CommandBlock(block_entity, world) => {
   114	                {
   115	                    let mut last_output = block_entity.last_output.lock().await;
   116	
   117	                    let now = time::OffsetDateTime::now_utc();
   118	                    let format = time::macros::format_description!("[hour]:[minute]:[second]");
   119	                    let timestamp = now
   120	                        .format(&format)
   121	                        .unwrap_or_else(|_| "00:00:00".to_string());
   122	
   123	                    *last_output = format!("[{}] {}", timestamp, text.get_text());
   124	                };
   125	                block_entity.on_updated(world);
   126	            }
   127	            Self::Dummy => {}
   128	        }
   129	    }

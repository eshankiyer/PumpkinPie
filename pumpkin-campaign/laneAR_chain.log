   858	    #[must_use]
   859	    pub fn get_bounding_box_static(
   860	        position: Vector3<i32>,
   861	        rotation: Rotation,
   862	        pivot: Vector3<i32>,
   863	        mirror: Mirror,
   864	        size: Vector3<i32>,
   865	    ) -> BlockBox {
   866	        let delta = Vector3::new(size.x - 1, size.y - 1, size.z - 1);
   867	        let corner1 = Self::transform_block_pos(Vector3::new(0, 0, 0), mirror, rotation, pivot);
   868	        let corner2 = Self::transform_block_pos(delta, mirror, rotation, pivot);
   869	        let min_x = corner1.x.min(corner2.x);
   870	        let min_y = corner1.y.min(corner2.y);
   871	        let min_z = corner1.z.min(corner2.z);
   872	        let max_x = corner1.x.max(corner2.x);
   873	        let max_y = corner1.y.max(corner2.y);
   874	        let max_z = corner1.z.max(corner2.z);
   875	        let mut bb = BlockBox::new(min_x, min_y, min_z, max_x, max_y, max_z);
   876	        bb.move_pos(position.x, position.y, position.z);
   877	        bb
   878	    }

   287	    /// `CrafterMenu.refreshRecipeResult` (`CrafterMenu.java:106-113`), called from
   288	    /// `slotChanged` (`CrafterMenu.java:119-122`) whenever an input slot changes. Populates the
   289	    /// non-interactive recipe-preview slot; it does not affect actual crafting, which
   290	    /// `CrafterBlockEntity`'s redstone-triggered tick already resolves independently via the
   291	    /// same [`match_crafting_recipe`].
   292	    async fn refresh_recipe_result(&self) {
   293	        let input = CrafterRecipeInput(self.inventory.clone());
   294	        let result = match_crafting_recipe(&input, None).await.map_or_else(
   295	            || ItemStack::EMPTY.clone(),
   296	            |matched| matched.to_item_stack(),
   297	        );
   298	        self.result_inventory.set_stack(0, result).await;
   299	    }

   306	        if let Some(direction) = state.hit_direction {
   307	            nbt.put_byte("hit_direction", direction.to_index() as i8);
   308	        }
   309	        if let Some(stack) = state.item.as_ref() {
   310	            let mut item_nbt = NbtCompound::new();
   311	            stack.write_item_stack(&mut item_nbt);

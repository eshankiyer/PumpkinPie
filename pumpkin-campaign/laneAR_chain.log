   418	
   419	impl ThrownItemEntity {
   420	    pub fn new(entity: Entity, owner: &Entity, gravity: f64) -> Self {
   421	        let mut owner_pos = owner.pos.load();
   422	        owner_pos.y += owner.get_eye_height() - 0.1;
   423	        entity.pos.store(owner_pos);
   424	        // `Projectile.getAddEntityPacket` (`Projectile.java:346-349`): the spawn packet's
   425	        // generic "data" int carries the owner's entity id (0 with no owner), which the
   426	        // client uses to attribute the projectile to its shooter.
   427	        entity.data.store(owner.entity_id, Ordering::Relaxed);
   428	        Self {
   429	            entity,
   430	            owner_id: Some(owner.entity_id),
   431	            collides_with_projectiles: false,
   432	            has_hit: AtomicBool::new(false),
   433	            gravity,
   434	        }
   435	    }
   436	
   437	    pub fn set_velocity_from(
   438	        &self,
   439	        shooter: &Entity,
   440	        pitch: f32,
   441	        yaw: f32,
   442	        roll: f32,
   443	        speed: f32,
   444	        divergence: f32,
   445	    ) {
   446	        let yaw_rad = yaw.to_radians();
   447	        let pitch_rad = pitch.to_radians();
   448	        let roll_rad = (pitch + roll).to_radians();
   449	
   450	        let x = -yaw_rad.sin() * pitch_rad.cos();
   451	        let y = -roll_rad.sin();
   452	        let z = yaw_rad.cos() * pitch_rad.cos();
   453	
   454	        self.set_velocity(
   455	            f64::from(x),
   456	            f64::from(y),
   457	            f64::from(z),
   458	            f64::from(speed),
   459	            f64::from(divergence),
   460	        );
   461	
   462	        // Vanilla `Projectile.shootFromRotation` inherits the shooter's known movement
   463	        // after aiming, omitting vertical movement while grounded (`Projectile.java:157-159`).
   464	        let source_movement = shooter.get_known_movement();
   465	        let velocity = add_known_movement(
   466	            self.entity.velocity.load(),
   467	            source_movement,
   468	            shooter.on_ground.load(Ordering::Relaxed),
   469	        );
   470	        self.entity.velocity.store(velocity);
   471	    }
   472	
   473	    pub fn set_velocity(&self, x: f64, y: f64, z: f64, power: f64, uncertainty: f64) {
   474	        fn next_triangular(mode: f64, deviation: f64) -> f64 {
   475	            deviation.mul_add(rand::random::<f64>() - rand::random::<f64>(), mode)
   476	        }
   477	        let velocity = Vector3::new(x, y, z)
   478	            .normalize()
   479	            .add_raw(
   480	                next_triangular(0.0, 0.017_227_5 * uncertainty),
   481	                next_triangular(0.0, 0.017_227_5 * uncertainty),
   482	                next_triangular(0.0, 0.017_227_5 * uncertainty),
   483	            )
   484	            .multiply(power, power, power);
   485	
   486	        self.entity.velocity.store(velocity);
   487	        let len = velocity.horizontal_length();
   488	        self.entity.set_rotation(
   489	            velocity.x.atan2(velocity.z) as f32 * 57.295_776,
   490	            velocity.y.atan2(len) as f32 * 57.295_776,
   491	        );
   492	    }
   493	}

   382	    // --- Synchronous Methods ---
   383	
   384	    /// Gets the window type for this screen handler.
   385	    fn window_type(&self) -> Option<WindowType> {
   386	        self.get_behaviour().window_type
   387	    }
   388	
   389	    /// Returns this screen handler as an Any reference.
   390	    fn as_any(&self) -> &dyn Any;
   391	
   392	    /// Returns this screen handler as a mutable Any reference.
   393	    fn as_any_mut(&mut self) -> &mut dyn Any;
   394	
   395	    /// Gets the sync ID for this screen handler.
   396	    fn sync_id(&self) -> u8 {
   397	        self.get_behaviour().sync_id
   398	    }
   399	
   400	    /// What must still hold at the position this menu was opened against.
   401	    ///
   402	    /// Vanilla equivalent: the `ContainerLevelAccess`/`Block` pair a menu passes to
   403	    /// `AbstractContainerMenu.stillValid` (`AbstractContainerMenu.java:93-95`), or the
   404	    /// backing container for the `Container.stillValidBlockEntity` family
   405	    /// (`Container.java:94-101`). Defaults to [`ContainerAccess::None`], i.e. a menu
   406	    /// with no backing position.
   407	    fn container_access(&self) -> ContainerAccess {
   408	        ContainerAccess::None
   409	    }
   410	
   411	    /// Checks if the player can still use this container.
   412	    ///
   413	    /// Port of `AbstractContainerMenu.stillValid(Player)`
   414	    /// (`AbstractContainerMenu.java:635`). The default routes
   415	    /// [`ScreenHandler::container_access`] through the player, so a menu stays valid
   416	    /// only while the player is in range of - and the expected block still stands at -
   417	    /// the position the menu was opened against.
   418	    fn can_use(&self, player: &dyn InventoryPlayer) -> bool {
   419	        player.evaluate_container_access(self.container_access())
   420	    }
   421	
   422	    /// Gets a reference to the screen handler behaviour.
   423	    fn get_behaviour(&self) -> &ScreenHandlerBehaviour;
   424	
   425	    /// Gets a mutable reference to the screen handler behaviour.
   426	    fn get_behaviour_mut(&mut self) -> &mut ScreenHandlerBehaviour;
   427	
   428	    /// Adds a slot to this screen handler.
   429	    ///
   430	    /// Assigns an ID and sets up tracking for the slot.
   431	    fn add_slot(&mut self, slot: Arc<dyn Slot>) -> Arc<dyn Slot> {
   432	        let behaviour = self.get_behaviour_mut();
   433	        slot.set_id(behaviour.slots.len());
   434	        behaviour.slots.push(slot.clone());
   435	        behaviour.tracked_stacks.push(ItemStack::EMPTY.clone());
   436	        behaviour.previous_tracked_stacks.push(TrackedStack::EMPTY);
   437	
   438	        slot
   439	    }
   440	
   441	    /// Adds hotbar slots (0-8) from the player inventory.
   442	    fn add_player_hotbar_slots(&mut self, player_inventory: &Arc<dyn Inventory>) {

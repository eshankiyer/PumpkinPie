   192	/// All mutable state, behind a single lock: two players brushing the same block must not
   193	/// interleave a read-modify-write of the counters.
   194	struct BrushState {
   195	    brush_count: i32,
   196	    brush_count_resets_at_tick: i64,
   197	    cool_down_ends_at_tick: i64,
   198	    item: Option<ItemStack>,
   199	    hit_direction: Option<BlockDirection>,
   200	    loot_table: Option<String>,
   201	    loot_table_seed: i64,
   202	}
   203	
   204	impl BrushState {
   205	    const fn new() -> Self {
   206	        Self {
   207	            brush_count: 0,
   208	            brush_count_resets_at_tick: 0,
   209	            cool_down_ends_at_tick: 0,
   210	            item: None,
   211	            hit_direction: None,
   212	            loot_table: None,
   213	            loot_table_seed: 0,
   214	        }
   215	    }
   216	
   217	    /// `BrushableBlockEntity.unpackLootTable` (`BrushableBlockEntity.java:88-114`).
   218	    ///
   219	    /// The `GENERATE_LOOT` advancement trigger and the luck / `TOOL` / `THIS_ENTITY` loot
   220	    /// parameters have no analogue here; none of the six archaeology tables reads them.
   221	    fn unpack_loot_table(&mut self) {
   222	        let Some(key) = self.loot_table.take() else {
   223	            return;
   224	        };
   225	        let Some(table) = archaeology_loot_table(&key) else {
   226	            self.item = None;
   227	            return;
   228	        };
   229	        let seed = if self.loot_table_seed == 0 {
   230	            rand::random()
   231	        } else {
   232	            self.loot_table_seed
   233	        };
   234	        let mut loot = generate_chest_loot(&table, seed);
   235	        // Vanilla warns and keeps the first stack when a table yields more than one.
   236	        self.item = if loot.is_empty() {
   237	            None
   238	        } else {
   239	            Some(loot.swap_remove(0))
   240	        };
   241	    }
   242	}
   243	
   244	pub struct BrushableBlockBlockEntity {
   245	    pub position: BlockPos,
   246	    state: Mutex<BrushState>,
   247	}
   248	
   249	impl BlockEntity for BrushableBlockBlockEntity {
   250	    fn resource_location(&self) -> &'static str {
   251	        Self::ID
   252	    }
   253	
   254	    fn get_position(&self) -> BlockPos {
   255	        self.position
   256	    }
   257	
   258	    /// `BrushableBlockEntity.loadAdditional` (`BrushableBlockEntity.java:205-215`): a
   259	    /// pending loot table wins over any stored item.
   260	    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self
   261	    where
   262	        Self: Sized,
   263	    {
   264	        let loot_table = nbt.get_string("LootTable").map(ToString::to_string);
   265	        let loot_table_seed = nbt.get_long("LootTableSeed").unwrap_or(0);
   266	        let item = if loot_table.is_some() {
   267	            None
   268	        } else {
   269	            nbt.get_compound("item")
   270	                .and_then(ItemStack::read_item_stack)
   271	        };
   272	        let hit_direction = nbt
   273	            .get_byte("hit_direction")
   274	            .and_then(|b| u8::try_from(b).ok())
   275	            .and_then(BlockDirection::from_index);
   276	
   277	        Self {
   278	            position,
   279	            state: Mutex::new(BrushState {
   280	                item,
   281	                hit_direction,
   282	                loot_table,
   283	                loot_table_seed,
   284	                ..BrushState::new()
   285	            }),
   286	        }
   287	    }
   288	
   289	    /// `BrushableBlockEntity.saveAdditional` (`BrushableBlockEntity.java:217-223`): the
   290	    /// rolled item is written only when no deferred loot table remains.
   291	    fn write_nbt<'a>(
   292	        &'a self,
   293	        nbt: &'a mut NbtCompound,
   294	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   295	        Box::pin(async move {
   296	            let state = self.state.lock().await;
   297	            write_state(&state, nbt);
   298	        })
   299	    }
   300	
   301	    /// `BrushableBlockEntity.getUpdateTag` (`BrushableBlockEntity.java:189-199`): the
   302	    /// client is told the hit direction and the revealed item, never the counters.
   303	    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
   304	        let state = self.state.try_lock().ok()?;
   305	        let mut nbt = NbtCompound::new();
   306	        if let Some(direction) = state.hit_direction {
   307	            nbt.put_byte("hit_direction", direction.to_index() as i8);
   308	        }
   309	        if let Some(stack) = state.item.as_ref() {
   310	            let mut item_nbt = NbtCompound::new();
   311	            stack.write_item_stack(&mut item_nbt);
   312	            nbt.put_compound("item", item_nbt);
   313	        }
   314	        Some(nbt)
   315	    }
   316	
   317	    fn take_loot_table(&self) -> Option<(String, i64)> {
   318	        let mut state = self.state.try_lock().ok()?;
   319	        let seed = state.loot_table_seed;
   320	        state.loot_table.take().map(|key| (key, seed))
   321	    }
   322	
   323	    fn has_loot_table(&self) -> bool {
   324	        self.state
   325	            .try_lock()
   326	            .is_ok_and(|state| state.loot_table.is_some())
   327	    }
   328	
   329	    fn as_any(&self) -> &dyn std::any::Any {
   330	        self
   331	    }
   332	}
   333	
   334	fn write_state(state: &BrushState, nbt: &mut NbtCompound) {
   335	    if let Some(key) = state.loot_table.as_ref() {
   336	        nbt.put_string("LootTable", key.clone());
   337	        if state.loot_table_seed != 0 {
   338	            nbt.put_long("LootTableSeed", state.loot_table_seed);
   339	        }
   340	    } else if let Some(stack) = state.item.as_ref() {
   341	        let mut item_nbt = NbtCompound::new();
   342	        stack.write_item_stack(&mut item_nbt);
   343	        nbt.put_compound("item", item_nbt);
   344	    }
   345	    if let Some(direction) = state.hit_direction {
   346	        nbt.put_byte("hit_direction", direction.to_index() as i8);
   347	    }
   348	}

   454	fn load_recipes_from_dir(
   455	    namespace: &str,
   456	    dir: &Path,
   457	    all_recipes: &mut Vec<DynamicRecipe>,
   458	    count: &mut usize,
   459	) {
   460	    let Ok(entries) = fs::read_dir(dir) else {
   461	        return;
   462	    };
   463	    for entry in entries.flatten() {
   464	        let path = entry.path();
   465	        if path.is_dir() {
   466	            load_recipes_from_dir(namespace, &path, all_recipes, count);
   467	        } else if path
   468	            .extension()
   469	            .is_some_and(|ext| ext.eq_ignore_ascii_case("json"))
   470	        {
   471	            let stem = path
   472	                .file_stem()
   473	                .map(|s| s.to_string_lossy().to_string())
   474	                .unwrap_or_default();
   475	            if let Ok(content) = fs::read_to_string(&path)
   476	                && let Some(recipe) = recipe_loader::parse_recipe(namespace, &stem, &content)
   477	            {
   478	                all_recipes.push(recipe);
   479	                *count += 1;
   480	            }
   481	        }
   482	    }
   483	}

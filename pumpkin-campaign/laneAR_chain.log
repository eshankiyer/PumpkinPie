   334	fn write_state(state: &BrushState, nbt: &mut NbtCompound) {
   335	    if let Some(key) = state.loot_table.as_ref() {
   336	        nbt.put_string("LootTable", key.clone());
   337	        if state.loot_table_seed != 0 {
   338	            nbt.put_long("LootTableSeed", state.loot_table_seed);
   339	        }
   340	    } else if let Some(stack) = state.item.as_ref() {
   341	        let mut item_nbt = NbtCompound::new();
   342	        stack.write_item_stack(&mut item_nbt);
   343	        nbt.put_compound("item", item_nbt);
   344	    }
   345	    if let Some(direction) = state.hit_direction {
   346	        nbt.put_byte("hit_direction", direction.to_index() as i8);
   347	    }
   348	}

   273	            .get_byte("hit_direction")
   274	            .and_then(|b| u8::try_from(b).ok())
   275	            .and_then(BlockDirection::from_index);
   276	
   277	        Self {
   278	            position,
   279	            state: Mutex::new(BrushState {
   280	                item,
   281	                hit_direction,
   282	                loot_table,
   283	                loot_table_seed,
   284	                ..BrushState::new()

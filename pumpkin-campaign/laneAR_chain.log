   169	#[allow(clippy::too_many_arguments, clippy::too_many_lines)]
   170	fn place_template_with_options_seed(
   171	    placer: &mut impl BlockPlacer,
   172	    template: &StructureTemplate,
   173	    origin: Vector3<i32>,
   174	    offset: (i32, i32),
   175	    rotation: Rotation,
   176	    skip_air: bool,
   177	    apply_waterlogging: bool,
   178	    processors: &[StructureProcessor],
   179	    chunk_box: Option<&pumpkin_util::math::block_box::BlockBox>,
   180	    keep_jigsaws: bool,
   181	    placement_seed: Option<u64>,
   182	) {
   183	    let (rotated_ox, rotated_oz) = rotation.rotate_offset(offset.0, offset.1);
   184	    let world_x = origin.x + rotated_ox;
   185	    let world_z = origin.z + rotated_oz;
   186	
   187	    let mut context_rng = LegacyRand::from_seed(hash_block_pos(world_x, origin.y, world_z) as u64);
   188	    let mut context = processor::ProcessorContext::new(origin, processors, &mut context_rng);
   189	
   190	    let mut placement_rng = placement_seed.map(LegacyRand::from_seed);
   191	
   192	    for block in &template.blocks {
   193	        let palette_entry = &template.palette[block.state as usize];
   194	
   195	        // Structure blocks are data markers.
   196	        if palette_entry.name == "minecraft:structure_block" {
   197	            continue;
   198	        }
   199	
   200	        let mut block_entity_nbt = block.nbt.clone();
   201	        let mut placed_entry = palette_entry.clone();
   202	
   203	        // Jigsaw blocks are replaced during template processing, before block entities are
   204	        // collected. Keeping this in the placement pipeline avoids stale jigsaw entities.
   205	        if !keep_jigsaws && palette_entry.name == "minecraft:jigsaw" {
   206	            let final_state = block_entity_nbt
   207	                .as_ref()
   208	                .and_then(|nbt| nbt.get_string("final_state"))
   209	                .unwrap_or("minecraft:air");
   210	            placed_entry = PaletteEntry::from_string(final_state);
   211	            block_entity_nbt = None;
   212	        }
   213	
   214	        // Structure void preserves the existing block, both from the palette itself and from a
   215	        // jigsaw final state.
   216	        if placed_entry.name == "minecraft:structure_void" {
   217	            continue;
   218	        }
   219	
   220	        // Resolve block state with rotation applied to directional properties
   221	        let Some(mut state) =
   222	            BlockStateResolver::resolve(&placed_entry, rotation, Mirror::default())
   223	        else {
   224	            continue;
   225	        };
   226	
   227	        // Rotate block position within template bounds
   228	        let local_pos = rotation.transform_pos(block.pos, template.size);
   229	
   230	        let wx = world_x + local_pos.x;
   231	        let wy = origin.y + local_pos.y;
   232	        let wz = world_z + local_pos.z;
   233	
   234	        if let Some(bbox) = chunk_box
   235	            && (wx < bbox.min.x
   236	                || wx > bbox.max.x
   237	                || wy < bbox.min.y
   238	                || wy > bbox.max.y
   239	                || wz < bbox.min.z
   240	                || wz > bbox.max.z)
   241	        {
   242	            continue;
   243	        }
   244	
   245	        let world_pos = Vector3::new(wx, wy, wz);
   246	
   247	        if apply_waterlogging
   248	            && placer.get_block_state(&world_pos).to_block_id() == pumpkin_data::Block::WATER.id
   249	            && let Some((_, waterlogged)) = placed_entry
   250	                .properties
   251	                .iter_mut()
   252	                .find(|(name, _)| name == "waterlogged")
   253	        {
   254	            *waterlogged = "true".to_string();
   255	            if let Some(waterlogged_state) =
   256	                BlockStateResolver::resolve(&placed_entry, rotation, Mirror::default())
   257	            {
   258	                state = waterlogged_state;
   259	            }
   260	        }
   261	
   262	        // Apply processors
   263	        let mut should_place = true;
   264	        let mut wy = wy;
   265	        let mut capped_idx = 0;
   266	        let mut local_rng =
   267	            LegacyRand::from_seed(hash_block_pos(world_pos.x, world_pos.y, world_pos.z) as u64);
   268	        let rng: &mut LegacyRand = placement_rng
   269	            .as_mut()
   270	            .map_or_else(|| &mut local_rng, |rng| rng);
   271	        for processor in processors {
   272	            if let StructureProcessor::Gravity { heightmap, offset } = processor {
   273	                // Vanilla `GravityProcessor.processBlock` (`GravityProcessor.java:29-56`):
   274	                // server-side placement resolves WG heightmaps to their post-generation
   275	                // variants (`:38-48`), then re-anchors the block at
   276	                // `getHeight(x, z) + offset + template-relative Y` (`:50-55`). XZ stays at
   277	                // the current target position; subsequent processors see the shifted one.
   278	                let heightmap = match heightmap {
   279	                    HeightmapType::WorldSurfaceWg | HeightmapType::WorldSurface => {
   280	                        HeightMap::WorldSurface
   281	                    }
   282	                    HeightmapType::OceanFloorWg | HeightmapType::OceanFloor => {
   283	                        HeightMap::OceanFloor
   284	                    }
   285	                    HeightmapType::MotionBlocking => HeightMap::MotionBlocking,
   286	                    HeightmapType::MotionBlockingNoLeaves => HeightMap::MotionBlockingNoLeaves,
   287	                };
   288	                wy = placer.get_top_y(&heightmap, wx, wz) + offset + block.pos.y;
   289	                // Vanilla re-checks the placement box against the *processed* position
   290	                // before setting blocks (`StructureTemplate.java:283`).
   100	impl TemplateFeature {
   101	    #[expect(clippy::too_many_arguments)]
   102	    pub fn generate<T: GenerationCache>(
   103	        &self,
   104	        chunk: &mut T,
   105	        _block_registry: &dyn WorldPortalExt,
   106	        _min_y: i8,
   107	        _height: u16,
   108	        _feature_name: pumpkin_data::placed_feature::PlacedFeature,
   109	        random: &mut RandomGenerator,
   110	        pos: BlockPos,
   111	    ) -> bool {
   112	        let total: i32 = self.templates.iter().map(|entry| entry.weight).sum();
   113	        if total <= 0 {
   114	            return false;
   115	        }
   116	        // `templates().getRandomOrThrow(random)` (`TemplateFeature.java:26`,
   117	        // `WeightedList.java:88-91`).
   118	        let selection = random.next_bounded_i32(total);
   119	        let weights: Vec<i32> = self.templates.iter().map(|entry| entry.weight).collect();
   120	        let Some(index) = weighted_index(&weights, selection) else {
   121	            return false;
   122	        };
   123	        let entry = &self.templates[index];
   124	
   125	        // `Util.getRandom(templateEntry.rotations(), random)` (`TemplateFeature.java:27`).
   126	        if entry.rotations.is_empty() {
   127	            return false;
   128	        }
   129	        let rotation = entry.rotations[random
   130	            .next_bounded_i32(entry.rotations.len() as i32)
   131	            .unsigned_abs() as usize];
   132	
   133	        let Some(template) = get_template(entry.id) else {
   134	            tracing::warn!(
   135	                "template feature references missing template '{}'",
   136	                entry.id
   137	            );
   138	            return false;
   139	        };
   140	
   141	        let (dx, dz) = template_offset(rotation, template.size);
   142	        let origin = Vector3::new(pos.0.x + dx, pos.0.y, pos.0.z + dz);
   143	
   144	        let mut placer = CachePlacer(chunk);
   145	        // Vanilla places with the default `StructurePlaceSettings`, which keeps neither
   146	        // `knownShape` nor an air filter set, so air is written and existing liquids are
   147	        // preserved around waterloggable blocks (`TemplateFeature.java:33-34`).
   148	        place_template(
   149	            &mut placer,
   150	            &template,
   151	            origin,
   152	            (0, 0),
   153	            rotation,
   154	            false,
   155	            true,
   156	            &[],
   157	            None,
   158	        );
   159	        true
   160	    }
   161	}

    50	    /// `StructureBlockEntity.setPlacedBy`: records the placing player's name as the author.
    51	    fn player_placed<'a>(&'a self, args: PlayerPlacedArgs<'a>) -> BlockFuture<'a, ()> {
    52	        Box::pin(async move {
    53	            let Some(block_entity) = args.world.get_block_entity(args.position) else {
    54	                return;
    55	            };
    56	            let Some(structure_block) = block_entity
    57	                .as_any()
    58	                .downcast_ref::<StructureBlockBlockEntity>()
    59	            else {
    60	                return;
    61	            };
    62	            *structure_block.author.lock().await = args.player.gameprofile.name.clone();
    63	        })
    64	    }
    65	
    66	    /// `StructureBlock.useWithoutItem`/`StructureBlockEntity.usedBy`: opens the editor GUI for
    67	    /// operators. `StructureBlock` is a `GameMasterBlock` gated on permission level 2, following
    68	    /// the same shape as `jigsaw.rs`'s `normal_use` (the jigsaw port's additional creative-mode
    69	    /// check has no vanilla citation and is deliberately not copied here, per the design doc).
    70	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
    71	        Box::pin(async move {
    72	            // `StructureBlockEntity.usedBy` requires `Player.canUseGameMasterBlocks`
    73	            // (`StructureBlockEntity.java:149-151`; `Player.java:1863-1865`).
    74	            if !args.player.can_use_game_master_blocks() {
    75	                return BlockActionResult::Pass;
    76	            }
    77	            let Some(block_entity) = args.world.get_block_entity(args.position) else {
    78	                return BlockActionResult::Pass;
    79	            };
    80	            args.world.update_block_entity(&block_entity);
    81	            BlockActionResult::SuccessServer
    82	        })
    83	    }
    84	
    85	    /// `StructureBlock.neighborChanged` (`StructureBlock.java:68-81`) triggers only on a rising
    86	    /// redstone edge; the entity's powered field retains that edge state between updates.
    87	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
    88	        Box::pin(async move {
    89	            let Some(block_entity) = args.world.get_block_entity(args.position) else {
    90	                return;
    91	            };
    92	            let Some(structure_block) = block_entity
    93	                .as_any()
    94	                .downcast_ref::<StructureBlockBlockEntity>()
    95	            else {
    96	                return;
    97	            };
    98	            let should_trigger = block_receives_redstone_power(args.world, args.position).await;
    99	            let is_powered = *structure_block.powered.lock().await;
   100	            if should_trigger && !is_powered {
   101	                *structure_block.powered.lock().await = true;
   102	                let mode = structure_block.mode.lock().await.clone();
   103	                match mode.as_str() {
   104	                    "LOAD" => {
   105	                        structure_block.place_structure(args.world).await;
   106	                    }
   107	                    "SAVE" => {
   108	                        structure_block.save_structure(args.world, false).await;
   109	                    }
   110	                    "CORNER" => {
   111	                        structure_block.unload_structure().await;
   112	                    }
   113	                    _ => {}
   114	                }
   115	            } else if !should_trigger && is_powered {
   116	                *structure_block.powered.lock().await = false;
   117	            }
   118	        })
   119	    }
   120	}


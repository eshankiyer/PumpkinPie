    15	/// `net.minecraft.world.level.block.StructureBlock`.
    16	///
    17	/// An operator-only block whose interesting behavior lives on `StructureBlockBlockEntity`.
    18	#[pumpkin_block("minecraft:structure_block")]
    19	pub struct StructureBlock;
    20	
    21	impl BlockBehaviour for StructureBlock {
    22	    /// Vanilla `GameMasterBlockItem.getPlacementState` (GameMasterBlockItem.java:15-18): the
    23	    /// structure block item is a `GameMasterBlockItem`, so a player who cannot use game-master
    24	    /// blocks gets no placement state and the block is never placed.
    25	    /// `Player.canUseGameMasterBlocks` (Player.java:1863-1865) requires instabuild plus
    26	    /// permission level 2; Pumpkin models instabuild through creative mode (the same mapping
    27	    /// `CommandBlock::can_place_at` uses). A `None` player context (no player involved in the
    28	    /// placement) passes, matching vanilla's null-player branch of the same check.
    29	    fn can_place_at(&self, args: CanPlaceAtArgs<'_>) -> bool {
    30	        let Some(player) = args.player else {
    31	            return true;
    32	        };
    33	        player.can_use_game_master_blocks()
    34	    }
    35	
    36	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    37	        Box::pin(async move {
    38	            let props = StructureBlockLikeProperties::default(args.block);
    39	            props.to_state_id(args.block)
    40	        })
    41	    }
    42	
    43	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    44	        Box::pin(async move {
    45	            args.world
    46	                .add_block_entity(Arc::new(StructureBlockBlockEntity::new(*args.position)));
    47	        })
    48	    }
    49	
    50	    /// `StructureBlockEntity.setPlacedBy`: records the placing player's name as the author.
    51	    fn player_placed<'a>(&'a self, args: PlayerPlacedArgs<'a>) -> BlockFuture<'a, ()> {
    52	        Box::pin(async move {
    53	            let Some(block_entity) = args.world.get_block_entity(args.position) else {
    54	                return;
    55	            };
    56	            let Some(structure_block) = block_entity
    57	                .as_any()
    58	                .downcast_ref::<StructureBlockBlockEntity>()
    59	            else {
    60	                return;
    61	            };
    62	            *structure_block.author.lock().await = args.player.gameprofile.name.clone();
    63	        })
    64	    }
    65	
    66	    /// `StructureBlock.useWithoutItem`/`StructureBlockEntity.usedBy`: opens the editor GUI for
    67	    /// operators. `StructureBlock` is a `GameMasterBlock` gated on permission level 2, following
    68	    /// the same shape as `jigsaw.rs`'s `normal_use` (the jigsaw port's additional creative-mode
    69	    /// check has no vanilla citation and is deliberately not copied here, per the design doc).
    70	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
    71	        Box::pin(async move {
    72	            // `StructureBlockEntity.usedBy` requires `Player.canUseGameMasterBlocks`
    73	            // (`StructureBlockEntity.java:149-151`; `Player.java:1863-1865`).
    74	            if !args.player.can_use_game_master_blocks() {
    75	                return BlockActionResult::Pass;
    76	            }

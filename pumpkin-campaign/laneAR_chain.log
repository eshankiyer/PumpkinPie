   171	
   172	   private void checkPressed(final Level level, final BlockPos pos, final List<? extends Entity> entities) {
   173	      BlockState state = level.getBlockState(pos);
   174	      boolean wasPressed = state.getValue(POWERED);
   175	      boolean shouldBePressed = false;
   176	      if (!entities.isEmpty()) {
   177	         for (Entity entity : entities) {
   178	            if (!entity.isIgnoringBlockTriggers()) {
   179	               shouldBePressed = true;
   180	               break;
   181	            }
   182	         }
   183	      }
   184	
   185	      if (shouldBePressed != wasPressed) {
   186	         state = state.setValue(POWERED, shouldBePressed);
   187	         level.setBlock(pos, state, 3);
   188	         this.updateSource(level, pos, state);
   189	      }
   190	
   191	      if (shouldBePressed) {
   192	         level.scheduleTick(new BlockPos(pos), this, 10);
   193	      } else if (wasPressed) {
   194	         level.scheduleTick(new BlockPos(pos), this, 0);
   195	      }
   196	   }

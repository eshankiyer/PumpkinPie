   127	            let Some(be) = world.get_block_entity(&position) else {
   128	                return;
   129	            };
   130	            let Some(brush_be) = be.as_any().downcast_ref::<BrushableBlockBlockEntity>() else {
   131	                return;
   132	            };
   133	
   134	            let game_time = world.get_world_age().await;
   135	            if brush_be.brush(&world, game_time, face).await {
   136	                player.damage_held_item(1).await;
   137	            }
   138	        })
   139	    }

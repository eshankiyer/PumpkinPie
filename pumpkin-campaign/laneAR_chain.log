   880	    pub fn get_jigsaws(
   881	        &mut self,
   882	        position: Vector3<i32>,
   883	        rotation: Rotation,
   884	    ) -> Vec<JigsawBlockInfo> {
   885	        if self.palettes.is_empty() {
   886	            return Vec::new();
   887	        }
   888	
   889	        let settings = StructurePlaceSettings::new().set_rotation(rotation);
   890	        let jigsaws = {
   891	            let palette = settings.get_random_palette(&self.palettes, position);
   892	            let mut pal_clone = palette.clone();
   893	            pal_clone.jigsaws().to_vec()
   894	        };
   895	
   896	        let mut result = Vec::with_capacity(jigsaws.len());
   897	        for jigsaw in jigsaws {
   898	            let block_info = &jigsaw.info;
   899	            let rel_pos = Self::calculate_relative_position(&settings, block_info.pos) + position;
   900	            let rotated_info = StructureBlockInfo::new(
   901	                rel_pos,
   902	                block_info.state.rotate(settings.get_rotation()),
   903	                block_info.nbt.clone(),
   904	            );
   905	            result.push(jigsaw.with_info(rotated_info));
   906	        }
   907	
   908	        result
   909	    }

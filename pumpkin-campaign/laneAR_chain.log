    90	    /// Fast non-blocking check if the main inventory contains a given item.
    91	    pub fn contains_item(&self, item: &'static Item) -> bool {
    92	        if let Ok(inv) = self.main_inventory.try_read() {
    93	            for stack in inv.iter() {
    94	                if !stack.is_empty() && stack.get_item().id == item.id {
    95	                    return true;
    96	                }
    97	            }
    98	        }
    99	        false
   100	    }

    27	import net.minecraft.world.phys.Vec3;
    28	import org.jspecify.annotations.Nullable;
    29	
    30	public class LongJumpToRandomPos<E extends Mob> extends Behavior<E> {
    31	   protected static final int FIND_JUMP_TRIES = 20;
    32	   private static final int PREPARE_JUMP_DURATION = 40;
    33	   protected static final int MIN_PATHFIND_DISTANCE_TO_VALID_JUMP = 8;
    34	   private static final int TIME_OUT_DURATION = 200;
    35	   private static final List<Integer> ALLOWED_ANGLES = Lists.newArrayList(65, 70, 75, 80);
    36	   private final UniformInt timeBetweenLongJumps;
    37	   protected final int maxLongJumpHeight;
    38	   protected final int maxLongJumpWidth;
    39	   protected final float maxJumpVelocityMultiplier;
    40	   protected List<LongJumpToRandomPos.PossibleJump> jumpCandidates = Lists.newArrayList();
    41	   protected Optional<Vec3> initialPosition = Optional.empty();
    42	   protected @Nullable Vec3 chosenJump;
    43	   protected int findJumpTries;
    44	   protected long prepareJumpStart;
    45	   private final Function<E, SoundEvent> getJumpSound;
    46	   private final BiPredicate<E, BlockPos> acceptableLandingSpot;
    47	
    48	   public LongJumpToRandomPos(
    49	      final UniformInt timeBetweenLongJumps,
    50	      final int maxLongJumpHeight,
    51	      final int maxLongJumpWidth,
    52	      final float maxJumpVelocityMultiplier,
    53	      final Function<E, SoundEvent> getJumpSound
    54	   ) {
    55	      this(
    56	         timeBetweenLongJumps, maxLongJumpHeight, maxLongJumpWidth, maxJumpVelocityMultiplier, getJumpSound, LongJumpToRandomPos::defaultAcceptableLandingSpot
    57	      );
    58	   }
    59	
    60	   public static <E extends Mob> boolean defaultAcceptableLandingSpot(final E body, final BlockPos targetPos) {
    61	      Level level = body.level();
    62	      BlockPos below = targetPos.below();
    63	      return level.getBlockState(below).isSolidRender() && body.getPathfindingMalus(WalkNodeEvaluator.getPathTypeStatic(body, targetPos)) == 0.0F;
    64	   }
    65	
    66	   public LongJumpToRandomPos(
    67	      final UniformInt timeBetweenLongJumps,
    68	      final int maxLongJumpHeight,
    69	      final int maxLongJumpWidth,
    70	      final float maxJumpVelocityMultiplier,
    71	      final Function<E, SoundEvent> getJumpSound,
    72	      final BiPredicate<E, BlockPos> acceptableLandingSpot
    73	   ) {
    74	      super(
    75	         ImmutableMap.of(
    76	            MemoryModuleType.LOOK_TARGET,
    77	            MemoryStatus.REGISTERED,
    78	            MemoryModuleType.LONG_JUMP_COOLDOWN_TICKS,
    79	            MemoryStatus.VALUE_ABSENT,
    80	            MemoryModuleType.LONG_JUMP_MID_JUMP,
    81	            MemoryStatus.VALUE_ABSENT
    82	         ),
    83	         200
    84	      );
    85	      this.timeBetweenLongJumps = timeBetweenLongJumps;
    86	      this.maxLongJumpHeight = maxLongJumpHeight;
    87	      this.maxLongJumpWidth = maxLongJumpWidth;
    88	      this.maxJumpVelocityMultiplier = maxJumpVelocityMultiplier;
    89	      this.getJumpSound = getJumpSound;
    90	      this.acceptableLandingSpot = acceptableLandingSpot;
    91	   }
    92	
    93	   protected boolean checkExtraStartConditions(final ServerLevel level, final Mob body) {
    94	      boolean canStart = body.onGround() && !body.isInWater() && !body.isInLava() && !level.getBlockState(body.blockPosition()).is(Blocks.HONEY_BLOCK);
    95	      if (!canStart) {
    96	         body.getBrain().setMemory(MemoryModuleType.LONG_JUMP_COOLDOWN_TICKS, this.timeBetweenLongJumps.sample(level.getRandom()) / 2);
    97	      }
    98	
    99	      return canStart;
   100	   }
   101	
   102	   protected boolean canStillUse(final ServerLevel level, final Mob body, final long timestamp) {
   103	      boolean isValid = this.initialPosition.isPresent()
   104	         && this.initialPosition.get().equals(body.position())
   105	         && this.findJumpTries > 0
   106	         && !body.isInWater()
   107	         && (this.chosenJump != null || !this.jumpCandidates.isEmpty());
   108	      if (!isValid && body.getBrain().getMemory(MemoryModuleType.LONG_JUMP_MID_JUMP).isEmpty()) {
   109	         body.getBrain().setMemory(MemoryModuleType.LONG_JUMP_COOLDOWN_TICKS, this.timeBetweenLongJumps.sample(level.getRandom()) / 2);
   110	         body.getBrain().eraseMemory(MemoryModuleType.LOOK_TARGET);
   111	      }
   112	
   113	      return isValid;
   114	   }
   115	
   116	   protected void start(final ServerLevel level, final E body, final long timestamp) {
   117	      this.chosenJump = null;
   118	      this.findJumpTries = 20;
   119	      this.initialPosition = Optional.of(body.position());
   120	      BlockPos mobPos = body.blockPosition();
   121	      int mobX = mobPos.getX();
   122	      int mobY = mobPos.getY();
   123	      int mobZ = mobPos.getZ();
   124	      this.jumpCandidates = BlockPos.betweenClosedStream(
   125	            mobX - this.maxLongJumpWidth,
   126	            mobY - this.maxLongJumpHeight,
   127	            mobZ - this.maxLongJumpWidth,
   128	            mobX + this.maxLongJumpWidth,
   129	            mobY + this.maxLongJumpHeight,
   130	            mobZ + this.maxLongJumpWidth
   131	         )
   132	         .filter(pos -> !pos.equals(mobPos))
   133	         .map(pos -> new LongJumpToRandomPos.PossibleJump(pos.immutable(), Mth.ceil(mobPos.distSqr(pos))))
   134	         .collect(Collectors.toCollection(Lists::newArrayList));
   135	   }
   136	
   137	   protected void tick(final ServerLevel level, final E body, final long timestamp) {
   138	      if (this.chosenJump != null) {
   139	         if (timestamp - this.prepareJumpStart >= 40L) {
   140	            body.setYRot(body.yBodyRot);
   141	            body.setDiscardFriction(true);
   142	            double orgLength = this.chosenJump.length();
   143	            double lengthWithJumpBoost = orgLength + body.getJumpBoostPower();
   144	            body.setDeltaMovement(this.chosenJump.scale(lengthWithJumpBoost / orgLength));
   145	            body.getBrain().setMemory(MemoryModuleType.LONG_JUMP_MID_JUMP, true);
   146	            level.playSound(null, body, this.getJumpSound.apply(body), SoundSource.NEUTRAL, 1.0F, 1.0F);
   147	         }
   148	      } else {
   149	         this.findJumpTries--;
   150	         this.pickCandidate(level, body, timestamp);
   151	      }
   152	   }
   153	
   154	   protected void pickCandidate(final ServerLevel level, final E body, final long timestamp) {
   155	      while (!this.jumpCandidates.isEmpty()) {
   156	         Optional<LongJumpToRandomPos.PossibleJump> optionalPosition = this.getJumpCandidate(level);
   157	         if (!optionalPosition.isEmpty()) {
   158	            LongJumpToRandomPos.PossibleJump position = optionalPosition.get();
   159	            BlockPos targetPos = position.targetPos();
   160	            if (this.isAcceptableLandingPosition(level, body, targetPos)) {
   161	               Vec3 targetPosition = Vec3.atCenterOf(targetPos);
   162	               Vec3 jumpVector = this.calculateOptimalJumpVector(body, targetPosition);
   163	               if (jumpVector != null) {
   164	                  body.getBrain().setMemory(MemoryModuleType.LOOK_TARGET, new BlockPosTracker(targetPos));
   165	                  PathNavigation navigation = body.getNavigation();
   166	                  Path path = navigation.createPath(targetPos, 0, 8);
   167	                  if (path == null || !path.canReach()) {
   168	                     this.chosenJump = jumpVector;
   169	                     this.prepareJumpStart = timestamp;
   170	                     return;
   171	                  }
   172	               }
   173	            }
   174	         }
   175	      }
   176	   }
   177	
   178	   protected Optional<LongJumpToRandomPos.PossibleJump> getJumpCandidate(final ServerLevel level) {
   179	      Optional<LongJumpToRandomPos.PossibleJump> randomItem = WeightedRandom.getRandomItem(
   180	         level.getRandom(), this.jumpCandidates, LongJumpToRandomPos.PossibleJump::weight
   181	      );
   182	      randomItem.ifPresent(this.jumpCandidates::remove);
   183	      return randomItem;
   184	   }
   185	
   186	   private boolean isAcceptableLandingPosition(final ServerLevel level, final E body, final BlockPos targetPos) {
   187	      BlockPos bodyPos = body.blockPosition();
   188	      int mobX = bodyPos.getX();
   189	      int mobZ = bodyPos.getZ();
   190	      return mobX == targetPos.getX() && mobZ == targetPos.getZ() ? false : this.acceptableLandingSpot.test(body, targetPos);
   191	   }
   192	
   193	   protected @Nullable Vec3 calculateOptimalJumpVector(final Mob body, final Vec3 targetPos) {
   194	      List<Integer> allowedAngles = Lists.newArrayList(ALLOWED_ANGLES);
   195	      Collections.shuffle(allowedAngles);
   196	      float maxJumpVelocity = (float)(body.getAttributeValue(Attributes.JUMP_STRENGTH) * this.maxJumpVelocityMultiplier);
   197	
   198	      for (int angle : allowedAngles) {
   199	         Optional<Vec3> velocityVector = LongJumpUtil.calculateJumpVectorForAngle(body, targetPos, maxJumpVelocity, angle, true);
   200	         if (velocityVector.isPresent()) {
   201	            return velocityVector.get();
   202	         }
   203	      }
   204	
   205	      return null;
   206	   }
   207	
   208	   public record PossibleJump(BlockPos targetPos, int weight) {
   209	   }
   210	}

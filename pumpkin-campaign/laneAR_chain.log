   192	/// All mutable state, behind a single lock: two players brushing the same block must not
   193	/// interleave a read-modify-write of the counters.
   194	struct BrushState {
   195	    brush_count: i32,
   196	    brush_count_resets_at_tick: i64,
   197	    cool_down_ends_at_tick: i64,
   198	    item: Option<ItemStack>,
   199	    hit_direction: Option<BlockDirection>,
   200	    loot_table: Option<String>,
   201	    loot_table_seed: i64,
   202	}
   203	
   204	impl BrushState {
   205	    const fn new() -> Self {
   206	        Self {
   207	            brush_count: 0,
   208	            brush_count_resets_at_tick: 0,
   209	            cool_down_ends_at_tick: 0,
   210	            item: None,
   211	            hit_direction: None,
   212	            loot_table: None,
   213	            loot_table_seed: 0,
   214	        }
   215	    }
   216	
   217	    /// `BrushableBlockEntity.unpackLootTable` (`BrushableBlockEntity.java:88-114`).
   218	    ///
   219	    /// The `GENERATE_LOOT` advancement trigger and the luck / `TOOL` / `THIS_ENTITY` loot
   220	    /// parameters have no analogue here; none of the six archaeology tables reads them.
   221	    fn unpack_loot_table(&mut self) {
   222	        let Some(key) = self.loot_table.take() else {
   223	            return;
   224	        };
   225	        let Some(table) = archaeology_loot_table(&key) else {
   226	            self.item = None;
   227	            return;
   228	        };
   229	        let seed = if self.loot_table_seed == 0 {
   230	            rand::random()
   231	        } else {
   232	            self.loot_table_seed
   233	        };
   234	        let mut loot = generate_chest_loot(&table, seed);
   235	        // Vanilla warns and keeps the first stack when a table yields more than one.
   236	        self.item = if loot.is_empty() {
   237	            None
   238	        } else {
   239	            Some(loot.swap_remove(0))
   240	        };
   241	    }
   242	}

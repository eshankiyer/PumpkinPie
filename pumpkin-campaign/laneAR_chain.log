    58	/// Abstraction over block placement, implemented by both [`ProtoChunk`] (worldgen) and
    59	/// [`WorldBlockPlacer`] (live `/place template` command).
    60	pub trait BlockPlacer {
    61	    fn get_block_state(&self, pos: &Vector3<i32>) -> BlockStateId;
    62	    fn set_block_state(&mut self, pos: &Vector3<i32>, state: &BlockState);
    63	    fn add_block_entity(&mut self, nbt: NbtCompound);
    64	
    65	    /// Heightmap query for the given world column, mirroring `LevelReader.getHeight`
    66	    /// (`net/minecraft/world/level/LevelReader.java`), which
    67	    /// `GravityProcessor.processBlock` uses to re-anchor blocks
    68	    /// (`GravityProcessor.java:51`).
    69	    fn get_top_y(&self, heightmap: &HeightMap, x: i32, z: i32) -> i32;
    70	}
    71	
    72	/// Places a template at a world origin with an un-rotated XZ offset.
    73	///
    74	/// All rotation is handled internally:
    75	/// - The offset is rotated to position the template correctly
    76	/// - Block positions within the template are rotated
    77	/// - Directional block properties (facing, axis, etc.) are rotated
    78	/// - Block entities are created from template NBT data
    79	///
    80	/// `origin` is the base world position (x, y, z).
    81	/// `offset` is the un-rotated XZ offset from origin (`x_offset`, `z_offset`) - rotation is applied automatically.
    82	#[allow(clippy::too_many_arguments)]
    83	pub fn place_template(
    84	    placer: &mut impl BlockPlacer,
    85	    template: &StructureTemplate,
    86	    origin: Vector3<i32>,
    87	    offset: (i32, i32),
    88	    rotation: Rotation,
    89	    skip_air: bool,
    90	    apply_waterlogging: bool,
    91	    processors: &[StructureProcessor],
    92	    chunk_box: Option<&pumpkin_util::math::block_box::BlockBox>,
    93	) {
    94	    place_template_with_options(
    95	        placer,
    96	        template,
    97	        origin,
    98	        offset,
    99	        rotation,
   100	        skip_air,
   101	        apply_waterlogging,
   102	        processors,
   103	        chunk_box,
   104	        false,
   105	    );

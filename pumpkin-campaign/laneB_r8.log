   140	         }
   141	
   142	         bellBlockEntity.onHit(direction);
   143	         level.playSound(null, pos, SoundEvents.BELL_BLOCK, SoundSource.BLOCKS, 2.0F, 1.0F);
   144	         level.gameEvent(ringingEntity, GameEvent.BLOCK_CHANGE, pos);
   145	         return true;

   215	    fn build_level_sections(proto_chunk: &ProtoChunk, dimension: &Dimension) -> ChunkSections {
   216	        // The chunk-data network packet has no explicit section-count field: the client derives
   217	        // how many sections to read from the *dimension's* registered height (e.g. 256 blocks /
   218	        // 16 sections for Nether/End, from `Dimension::THE_NETHER`/`THE_END`), not from how much
   219	        // of that space worldgen actually populated. `GenerationSettings.shape.height` (128 for
   220	        // Nether/End) only bounds the noise generator's own output - flat_block_map/
   221	        // flat_biome_map are sized to that smaller value, so indexing them past
   222	        // `proto_chunk.height()` is still out of bounds (the bug 845326f and this function's
   223	        // former version guarded against). The fix is to build the *full* dimension-height
   224	        // section array, sampling from the proto chunk only within its generated range and
   225	        // padding the rest with air, matching vanilla's real behavior above the noise
   226	        // generator's ceiling (e.g. buildable-but-never-generated space from y=128 to y=256 in
   227	        // the Nether) instead of truncating the chunk to the generated height.
   228	        let total_sections = dimension.height as usize / BlockPalette::SIZE;
   229	        let generated_sections = proto_chunk.height() as usize / BlockPalette::SIZE;
   230	        let biome_min_y = biome_coords::from_block(proto_chunk.bottom_y() as i32);
   231	
   232	        let mut block_sections = Vec::with_capacity(total_sections);
   233	        let mut biome_sections = Vec::with_capacity(total_sections);
   234	        for section_index in 0..total_sections {
   235	            if section_index < generated_sections {
   236	                block_sections.push(BlockPalette::from_fn(|x, y, z| {
   237	                    let y = section_index * BlockPalette::SIZE + y;
   238	                    proto_chunk.get_block_state_raw(x as i32, y as i32, z as i32)
   239	                }));
   240	                biome_sections.push(BiomePalette::from_fn(|x, y, z| {
   241	                    let y = section_index * BiomePalette::SIZE + y;
   242	                    proto_chunk.get_biome_id(x as i32, biome_min_y + y as i32, z as i32)
   243	                }));
   244	            } else {
   245	                // Above the noise generator's populated range: air, same as unbuilt space above
   246	                // generated terrain anywhere else. Biome has no meaning up here since nothing
   247	                // ever samples it naturally, so just repeat the topmost generated column.
   248	                block_sections.push(BlockPalette::default());
   249	                let repeated_biome = biome_sections.last().cloned().unwrap_or_default();
   250	                biome_sections.push(repeated_biome);
   251	            }
   252	        }
   253	
   254	        ChunkSections::from_palettes(
   255	            block_sections.into_boxed_slice(),
   256	            biome_sections.into_boxed_slice(),
   257	            dimension.min_y,
   258	        )
   259	    }

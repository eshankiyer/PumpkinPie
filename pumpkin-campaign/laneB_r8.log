   198	mod tests {
   199	    use super::*;
   200	    use pumpkin_data::block_properties::has_random_ticks;
   201	
   202	    #[test]
   203	    fn lit_redstone_ore_is_randomly_ticking() {
   204	        for block in [&Block::REDSTONE_ORE, &Block::DEEPSLATE_REDSTONE_ORE] {
   205	            let mut props = RedstoneOreLikeProperties::default(block);
   206	            props.lit = true;
   207	            assert!(has_random_ticks(props.to_state_id(block)), "lit {block:?}");
   208	            props.lit = false;
   209	            assert!(
   210	                !has_random_ticks(props.to_state_id(block)),
   211	                "unlit {block:?}"
   212	            );
   213	        }
   214	    }

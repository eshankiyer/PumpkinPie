   130	impl Sensor for NearestLivingEntitySensor {
   131	    /// `requires()` (`NearestLivingEntitySensor.java:28-30`).
   132	    fn requires(&self) -> &[MemoryKeyId] {
   133	        &REQUIRES
   134	    }
   135	

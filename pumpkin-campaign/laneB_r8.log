    64	/// Resolves an item tag's members. Shared by `TagEntry.createItemStack` (`TagEntry.java:46-48`,
    65	/// `expand: false`) below and by the pool-level `expand: true` fan-out
    66	/// (`TagEntry.expandTag`, `TagEntry.java:50-65`) in `LootTableExt::get_loot`.
    67	fn resolve_tag_items(name: &str) -> Vec<&'static Item> {
    68	    // `get_tag_values` keys its map by the full namespaced id (e.g. `"minecraft:wool"`,
    69	    // `crates/pumpkin-data/src/generated/tag.rs`), unlike `Item::from_registry_key` below,
    70	    // which wants the bare path with no namespace.
    71	    pumpkin_data::tag::get_tag_values(tag::RegistryKey::Item, name)
    72	        .unwrap_or_default()
    73	        .iter()
    74	        .filter_map(|registry_key| {
    75	            let item_key = registry_key
    76	                .strip_prefix("minecraft:")
    77	                .unwrap_or(registry_key);
    78	            Item::from_registry_key(item_key)
    79	        })
    80	        .collect()
    81	}

   136	   protected int ownSignal(final BlockState state, final BlockGetter level, final BlockPos pos) {
   137	      return state.getValue(POWERED) ? 15 : 0;
   138	   }
   139	
   140	   private void updateNeighbours(final BlockState state, final Level level, final BlockPos pos) {
   141	      Direction front = getConnectedDirection(state).getOpposite();
   142	      Orientation orientation = ExperimentalRedstoneUtils.initialOrientation(
   143	         level, front, front.getAxis().isHorizontal() ? Direction.UP : state.getValue(FACING)
   144	      );
   145	      level.updateNeighborsAt(pos, this, orientation);
   146	      level.updateNeighborsAt(pos.relative(front), this, orientation);
   147	   }

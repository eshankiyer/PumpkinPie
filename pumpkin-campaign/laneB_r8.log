   172	   @Override
   173	   public @Nullable BlockState getStateForPlacement(final BlockPlaceContext context) {
   174	      Direction clickedFace = context.getClickedFace();
   175	      BlockPos pos = context.getClickedPos();
   176	      Level level = context.getLevel();
   177	      Direction.Axis axis = clickedFace.getAxis();
   178	      if (axis == Direction.Axis.Y) {
   179	         BlockState state = this.defaultBlockState()
   180	            .setValue(ATTACHMENT, clickedFace == Direction.DOWN ? BellAttachType.CEILING : BellAttachType.FLOOR)
   181	            .setValue(FACING, context.getHorizontalDirection());
   182	         if (state.canSurvive(context.getLevel(), pos)) {
   183	            return state;
   184	         }
   185	      } else {
   186	         boolean doubleAttached = axis == Direction.Axis.X
   187	               && level.getBlockState(pos.west()).isFaceSturdy(level, pos.west(), Direction.EAST)
   188	               && level.getBlockState(pos.east()).isFaceSturdy(level, pos.east(), Direction.WEST)
   189	            || axis == Direction.Axis.Z
   190	               && level.getBlockState(pos.north()).isFaceSturdy(level, pos.north(), Direction.SOUTH)
   191	               && level.getBlockState(pos.south()).isFaceSturdy(level, pos.south(), Direction.NORTH);
   192	         BlockState state = this.defaultBlockState()
   193	            .setValue(FACING, clickedFace.getOpposite())
   194	            .setValue(ATTACHMENT, doubleAttached ? BellAttachType.DOUBLE_WALL : BellAttachType.SINGLE_WALL);
   195	         if (state.canSurvive(context.getLevel(), context.getClickedPos())) {
   196	            return state;
   197	         }
   198	
   199	         boolean canAttachBelow = level.getBlockState(pos.below()).isFaceSturdy(level, pos.below(), Direction.UP);
   200	         state = state.setValue(ATTACHMENT, canAttachBelow ? BellAttachType.FLOOR : BellAttachType.CEILING);
   201	         if (state.canSurvive(context.getLevel(), context.getClickedPos())) {
   202	            return state;
   203	         }
   204	      }
   205	
   206	      return null;
   207	   }

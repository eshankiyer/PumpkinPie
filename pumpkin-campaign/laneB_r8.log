   367	/// Vanilla `BucketItem#emptyContents` evaporation branch:
   368	/// `level.playSound(user, pos, FIRE_EXTINGUISH, BLOCKS, 0.5F, 2.6F + (rnd - rnd) * 0.8F)`,
   369	/// i.e. at the target block, for everyone nearby except the acting player.
   370	fn play_bucket_evaporation_by_player(world: &Arc<World>, player: &Player, pos: BlockPos) {
   371	    world.play_sound_raw_expect(
   372	        player,
   373	        Sound::BlockFireExtinguish as u16,
   374	        SoundCategory::Blocks,
   375	        &block_center(pos),
   376	        0.5,
   377	        (rand::random::<f32>() - rand::random::<f32>()).mul_add(0.8, 2.6),
   378	    );
   379	}
   380	
   381	/// Same sound without an acting player, for dispensers.
   382	pub(crate) fn play_bucket_evaporation(world: &Arc<World>, position: &Vector3<f64>) {
   383	    world.play_sound_raw(
   384	        Sound::BlockFireExtinguish as u16,
   385	        SoundCategory::Blocks,
   386	        position,
   387	        0.5,
   388	        (rand::random::<f32>() - rand::random::<f32>()).mul_add(0.8, 2.6),
   389	    );
   390	}

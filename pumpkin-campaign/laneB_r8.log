   121	        jukebox.start_playing(song.length_in_ticks());
   122	        Self::set_record_state(true, &Block::JUKEBOX, position, world).await;
   123	        world.update_neighbors(position, None).await;
   124	        world.update_comparators(position, &Block::JUKEBOX).await;

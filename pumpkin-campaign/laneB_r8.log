    68	/// `CreakingHeartBlock.updateState`: an UPROOTED heart that has gained its logs wakes to
    69	/// AWAKE or DORMANT depending on `creaking_active`. Any other state is left alone -- only
    70	/// the block entity's ticker moves a live heart between AWAKE and DORMANT.
    71	async fn update_state(
    72	    world: &World,
    73	    pos: &BlockPos,
    74	    props: &mut CreakingHeartLikeProperties,
    75	) -> bool {
    76	    if props.creaking_heart_state != CreakingHeartState::Uprooted
    77	        || !has_required_logs(world, pos, props.axis)
    78	    {
    79	        return false;
    80	    }
    81	    props.creaking_heart_state = if creaking_active(world).await {
    82	        CreakingHeartState::Awake
    83	    } else {
    84	        CreakingHeartState::Dormant
    85	    };
    86	    true
    87	}

   267	/// Returns the biome ids present in the center chunk and its eight neighbours.
   268	///
   269	/// `ChunkGenerator.applyBiomeDecoration` collects every biome holder from
   270	/// `ChunkPos.rangeClosed(center, 1)`, rather than only the center chunk. The
   271	/// generated data model stores biome ids directly, so this is the equivalent
   272	/// set operation available here.
   273	fn collect_possible_biomes_3x3<F>(center_x: i32, center_z: i32, mut chunk_biomes: F) -> Vec<u8>
   274	where
   275	    F: FnMut(i32, i32) -> Option<Vec<u8>>,
   276	{
   277	    let mut possible_biomes = Vec::new();
   278	    for chunk_x in (center_x - 1)..=(center_x + 1) {
   279	        for chunk_z in (center_z - 1)..=(center_z + 1) {
   280	            if let Some(biomes) = chunk_biomes(chunk_x, chunk_z) {
   281	                for biome_id in biomes {

   182	            return false;
   183	        }
   184	
   185	        // Vanilla TargetGoal.isWithinHome(target.blockPosition()). Pumpkin's position target
   186	        // and range are the existing home/restriction representation; a range of -1 is
   187	        // unrestricted, matching vanilla's homeRadius sentinel.
   188	        if !mob_entity.is_in_position_target_range_pos(&target.entity.block_pos.load()) {
   189	            return false;
   190	        }
   191	
   192	        if self.check_can_navigate {
   193	            let cooldown = self
   194	                .check_can_navigate_cooldown
   195	                .fetch_sub(1, Ordering::Relaxed)
   196	                - 1;
   197	            if cooldown <= 0 {
   198	                self.can_navigate_flag.store(UNSET, Ordering::Relaxed);
   199	            }
   200	
   201	            if self.can_navigate_flag.load(Ordering::Relaxed) == UNSET {
   202	                let can_reach = self.can_navigate_to_entity(mob, target).await;
   203	                self.can_navigate_flag.store(

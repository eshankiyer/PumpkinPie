   136	impl BlockBehaviour for JukeboxBlock {
   137	    /// Called when the jukebox is placed - creates the block entity
   138	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   139	        Box::pin(async move {
   140	            let block_entity = JukeboxBlockEntity::new(*args.position);
   141	            args.world.add_block_entity(Arc::new(block_entity));
   142	        })
   143	    }
   144	
   145	    /// Called when player right-clicks with empty hand or non-disc item
   146	    /// Vanilla: `JukeboxBlock.onUse()` - drops record if present
   147	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
   148	        Box::pin(async move {
   149	            let state_id = args.world.get_block_state(args.position).id;
   150	
   151	            // Vanilla: if (state.get(HAS_RECORD) && world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv)
   152	            if Self::has_record_state(args.block, state_id) {
   153	                // Drop the record
   154	                Self::drop_record(args.position, args.world).await;
   155	                // Stop the music and update block state
   156	                Self::stop_playing(args.block, args.position, args.world).await;
   157	                return BlockActionResult::Success;
   158	            }
   159	
   160	            BlockActionResult::Pass
   161	        })
   162	    }
   163	
   164	    /// Called when player right-clicks with an item
   165	    /// Vanilla: `JukeboxBlock.onUseWithItem()` -> `JukeboxPlayableComponent.tryPlayStack()`
   166	    fn use_with_item<'a>(
   167	        &'a self,
   168	        args: UseWithItemArgs<'a>,
   169	    ) -> BlockFuture<'a, BlockActionResult> {
   170	        Box::pin(async move {
   171	            let world = args.world;
   172	            let state_id = world.get_block_state(args.position).id;
   173	
   174	            // Vanilla: if (state.get(HAS_RECORD)) return PASS_TO_DEFAULT_BLOCK_ACTION
   175	            if Self::has_record_state(args.block, state_id) {
   176	                return BlockActionResult::PassToDefaultBlockAction;
   177	            }
   178	
   179	            let item_stack = &mut *args.item_stack;
   180	
   181	            // Vanilla: JukeboxPlayableComponent lv = stack.get(DataComponentTypes.JUKEBOX_PLAYABLE)
   182	            let jukebox_playable = item_stack
   183	                .get_data_component::<JukeboxPlayableImpl>()
   184	                .map(|i| i.song);
   185	
   186	            // Vanilla: if (lv == null) return PASS_TO_DEFAULT_BLOCK_ACTION
   187	            let Some(jukebox_playable) = jukebox_playable else {
   188	                return BlockActionResult::PassToDefaultBlockAction;
   189	            };
   190	
   191	            let Some(song_name) = jukebox_playable.split(':').nth(1) else {
   192	                return BlockActionResult::PassToDefaultBlockAction;
   193	            };
   194	
   195	            let Some(jukebox_song) = JukeboxSong::from_name(song_name) else {
   196	                error!("Jukebox playable song not registered: {song_name}");
   197	                return BlockActionResult::PassToDefaultBlockAction;
   198	            };
   199	
   200	            // Vanilla: ItemStack lv3 = stack.splitUnlessCreative(1, player)
   201	            let record = item_stack.split_unless_creative(args.player.gamemode.load(), 1);
   202	
   203	            // Vanilla: lv4.setStack(lv3)
   204	            if let Some(block_entity) = world.get_block_entity(args.position)
   205	                && let Some(jukebox_entity) =
   206	                    block_entity.as_any().downcast_ref::<JukeboxBlockEntity>()
   207	            {
   208	                jukebox_entity.set_record(record).await;
   209	                // Start tracking playback with song duration
   210	                jukebox_entity.start_playing(jukebox_song.length_in_ticks());
   211	            }
   212	
   213	            // Update block state to has_record = true
   214	            Self::set_record_state(true, args.block, args.position, world).await;
   215	
   216	            // Start playing the music (client-side audio)
   217	            Self::start_playing(args.position, world, jukebox_song.get_id());
   218	
   219	            args.player
   220	                .increment_stat(
   221	                    pumpkin_data::statistic::StatisticCategory::Custom,
   222	                    pumpkin_data::statistic::CustomStatistic::PlayRecord as i32,
   223	                    1,
   224	                )
   225	                .await;
   226	
   227	            // Vanilla JukeboxBlockEntity.java:44 -- emits BLOCK_CHANGE when a record is
   228	            // inserted. Vanilla's context carries the block's new state; Pumpkin's
   229	            // GameEventContext has no block-state variant, so this uses none() as a
   230	            // documented simplification, matching other emission sites this session.
   231	            let block_center = Vector3::new(
   232	                f64::from(args.position.0.x) + 0.5,
   233	                f64::from(args.position.0.y) + 0.5,
   234	                f64::from(args.position.0.z) + 0.5,
   235	            );
   236	            emit_game_event(
   237	                world,
   238	                GameEvent::BlockChange,
   239	                block_center,
   240	                GameEventContext::none(),
   241	            )
   242	            .await;
   243	
   244	            BlockActionResult::Success
   245	        })
   246	    }
   247	
   248	    /// Vanilla: `JukeboxBlock.onStateReplaced()` -> `ItemScatterer.onStateReplaced()`
   249	    fn on_state_replaced<'a>(&'a self, args: OnStateReplacedArgs<'a>) -> BlockFuture<'a, ()> {
   250	        Box::pin(async move {
   251	            args.world
   252	                .update_comparators(args.position, args.block)
   253	                .await;
   254	        })
   255	    }
   256	
   257	    /// Vanilla: `JukeboxBlock.emitsRedstonePower()` returns true
   258	    fn emits_redstone_power<'a>(
   259	        &'a self,
   260	        _args: EmitsRedstonePowerArgs<'a>,
   261	    ) -> BlockFuture<'a, bool> {
   262	        Box::pin(async move { true })
   263	    }
   264	
   265	    /// Vanilla: Returns 15 if playing, 0 otherwise
   266	    fn get_weak_redstone_power<'a>(
   267	        &'a self,
   268	        args: GetRedstonePowerArgs<'a>,
   269	    ) -> BlockFuture<'a, u8> {
   270	        Box::pin(async move {
   271	            // Vanilla: return world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv && lv.getManager().isPlaying() ? 15 : 0
   272	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   273	                && let Some(jukebox_entity) =
   274	                    block_entity.as_any().downcast_ref::<JukeboxBlockEntity>()
   275	                && jukebox_entity.is_playing()
   276	            {
   277	                15
   278	            } else {
   279	                0
   280	            }
   281	        })
   282	    }
   283	
   284	    /// Vanilla: Returns the song's comparator output (0-15)
   285	    fn get_comparator_output<'a>(
   286	        &'a self,
   287	        args: GetComparatorOutputArgs<'a>,
   288	    ) -> BlockFuture<'a, Option<u8>> {
   289	        Box::pin(async move {
   290	            // Vanilla: return world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv ? lv.getComparatorOutput() : 0
   291	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   292	                && let Some(jukebox_entity) =
   293	                    block_entity.as_any().downcast_ref::<JukeboxBlockEntity>()
   294	            {
   295	                let record = jukebox_entity.get_record().await;
   296	                // Get the song from the record's jukebox_playable component
   297	                if let Some(playable) = record.get_data_component::<JukeboxPlayableImpl>()
   298	                    && let Some(song_name) = playable.song.split(':').nth(1)
   299	                    && let Some(song) = JukeboxSong::from_name(song_name)
   300	                {
   301	                    return Some(song.comparator_output());
   302	                }
   303	            }
   304	            Some(0)
   305	        })
   306	    }
   307	}


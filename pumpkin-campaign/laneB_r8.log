    42	/// `CreakingHeartBlock.hasRequiredLogs`: both neighbours along the heart's axis must be
    43	/// pale oak logs sharing that same axis.
    44	pub fn has_required_logs(world: &World, pos: &BlockPos, axis: Axis) -> bool {
    45	    for direction in axis_directions(axis) {
    46	        let neighbour_pos = pos.offset(direction.to_offset());
    47	        let (block, state) = world.get_block_and_state(&neighbour_pos);
    48	        if !block.has_tag(&tag::Block::MINECRAFT_PALE_OAK_LOGS) {
    49	            return false;
    50	        }
    51	        // Read the axis through the log's own property type, not the heart's.
    52	        let props = PaleOakWoodLikeProperties::from_state_id(state.id, block);
    53	        if props.axis != axis {
    54	            return false;
    55	        }
    56	    }
    57	    true
    58	}
    59	
    60	const fn axis_directions(axis: Axis) -> [BlockDirection; 2] {
    61	    match axis {
    62	        Axis::X => [BlockDirection::West, BlockDirection::East],
    63	        Axis::Y => [BlockDirection::Down, BlockDirection::Up],
    64	        Axis::Z => [BlockDirection::North, BlockDirection::South],
    65	    }
    66	}

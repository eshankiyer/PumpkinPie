   485	    /// Reads a single biome cell from the chunk that owns it, the way vanilla's
   486	    /// `LevelReader.getNoiseBiome` routes through `QuartPos.toSection`. `None` when that chunk is
   487	    /// not in the cache.
   488	    fn biome_id_at_cell(&self, biome_x: i32, biome_y: i32, biome_z: i32) -> Option<u8> {
   489	        let dx = biome_coords::to_chunk(biome_x) - self.x;
   490	        let dz = biome_coords::to_chunk(biome_z) - self.z;
   491	        if dx < 0 || dz < 0 || dx >= self.size || dz >= self.size {
   492	            return None;
   493	        }
   494	        match &self.chunks[(dx * self.size + dz) as usize] {
   495	            Chunk::Proto(data) => Some(data.get_biome_id(biome_x, biome_y, biome_z)),
   496	            Chunk::Level(data) => data.section.get_rough_biome_absolute_y(

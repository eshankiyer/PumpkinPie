   131	   public @Nullable BlockEntity newBlockEntity(final BlockPos worldPosition, final BlockState blockState) {
   132	      return new CopperGolemStatueBlockEntity(worldPosition, blockState);
   133	   }
   134	
   135	   @Override
   136	   public boolean shouldChangedStateKeepBlockEntity(final BlockState oldState) {
   137	      return oldState.is(BlockTags.COPPER_GOLEM_STATUES);
   138	   }
   139	

    96	#[cfg(test)]
    97	mod tests {
    98	    use super::SkullBlockEntity;
    99	    use crate::block::entities::BlockEntity;
   100	    use pumpkin_nbt::compound::NbtCompound;
   101	    use pumpkin_util::math::position::BlockPos;
   102	
   103	    #[test]
   104	    fn custom_name_round_trips_through_nbt() {
   105	        let pos = BlockPos::new(3, 70, 5);
   106	        let entity = SkullBlockEntity::new(pos);
   107	        *futures::executor::block_on(entity.custom_name.lock()) =
   108	            Some("{\"text\":\"Steve\"}".to_string());
   109	
   110	        let mut nbt = NbtCompound::new();
   111	        futures::executor::block_on(entity.write_nbt(&mut nbt));
   112	        let loaded = SkullBlockEntity::from_nbt(&nbt, pos);
   113	
   114	        assert_eq!(
   115	            *futures::executor::block_on(loaded.custom_name.lock()),
   116	            Some("{\"text\":\"Steve\"}".to_string())
   117	        );
   118	    }
   119	
   120	    #[test]
   121	    fn absent_custom_name_stays_absent() {
   122	        let entity = SkullBlockEntity::new(BlockPos::new(0, 0, 0));
   123	        let mut nbt = NbtCompound::new();
   124	        futures::executor::block_on(entity.write_nbt(&mut nbt));
   125	        assert!(nbt.get_string("custom_name").is_none());
   126	    }
   127	}

   119	   protected void updatePose(final Level level, final BlockState state, final BlockPos pos, final Player player) {
   120	      level.playSound(null, pos, SoundEvents.COPPER_GOLEM_BECOME_STATUE, SoundSource.BLOCKS);
   121	      level.setBlock(pos, state.setValue(POSE, state.getValue(POSE).getNextPose()), 3);
   122	      level.gameEvent(player, GameEvent.BLOCK_CHANGE, pos);
   123	   }
   124	
   125	   @Override
   126	   protected boolean isPathfindable(final BlockState state, final PathComputationType type) {
   127	      return type == PathComputationType.WATER && state.getFluidState().is(FluidTags.WATER);
   128	   }

+            0, 0, 0, 0, // xRot
+            FLAG_ON_GROUND | FLAG_HORIZONTAL_COLLISION,
+        ][..];
+        let packet = SPlayerPositionRotation::read(
+            &mut input,
+            &pumpkin_util::version::JavaMinecraftVersion::V_26_2,
+        )

   367	/// Vanilla `BucketItem#emptyContents` evaporation branch:
   368	/// `level.playSound(user, pos, FIRE_EXTINGUISH, BLOCKS, 0.5F, 2.6F + (rnd - rnd) * 0.8F)`,
   369	/// i.e. at the target block, for everyone nearby except the acting player.
   370	fn play_bucket_evaporation_by_player(world: &Arc<World>, player: &Player, pos: BlockPos) {
   371	    world.play_sound_raw_expect(
   372	        player,
   373	        Sound::BlockFireExtinguish as u16,
   374	        SoundCategory::Blocks,
   375	        &block_center(pos),
   376	        0.5,
   377	        (rand::random::<f32>() - rand::random::<f32>()).mul_add(0.8, 2.6),
   378	    );
   379	}
   380	
   381	/// Same sound without an acting player, for dispensers.
   382	pub(crate) fn play_bucket_evaporation(world: &Arc<World>, position: &Vector3<f64>) {
   383	    world.play_sound_raw(
   384	        Sound::BlockFireExtinguish as u16,
   385	        SoundCategory::Blocks,
   386	        position,
   387	        0.5,
   388	        (rand::random::<f32>() - rand::random::<f32>()).mul_add(0.8, 2.6),
   389	    );
   390	}
   391	
   392	fn block_center(pos: BlockPos) -> Vector3<f64> {
   393	    Vector3::new(
   394	        f64::from(pos.0.x) + 0.5,
   395	        f64::from(pos.0.y) + 0.5,
   396	        f64::from(pos.0.z) + 0.5,
   397	    )
   398	}
   399	
   400	/// Vanilla `BucketItem#playEmptySound`: `BUCKET_EMPTY_LAVA` for lava, `BUCKET_EMPTY` otherwise,
   401	/// `SoundSource.BLOCKS`, volume 1.0, pitch 1.0. Mob buckets override it with their own sound and
   402	/// `SolidBucketItem` uses its own place sound, so neither goes through here.
   403	const fn bucket_empty_sound(item: &Item) -> Option<Sound> {
   404	    if item.id == Item::LAVA_BUCKET.id {
   405	        Some(Sound::ItemBucketEmptyLava)
   406	    } else if item.id == Item::WATER_BUCKET.id {
   407	        Some(Sound::ItemBucketEmpty)
   408	    } else {
   409	        None
   410	    }
   411	}
   412	
   413	/// Vanilla `BucketItem#use` plays `BucketPickup#getPickupSound` through `Player#playSound`, i.e.
   414	/// `SoundSource.PLAYERS`, volume 1.0, pitch 1.0, at the player, for everyone except the player.
   415	/// Sounds come from `WaterFluid#getPickupSound`, `LavaFluid#getPickupSound` and
   416	/// `PowderSnowBlock#getPickupSound`.
   417	const fn bucket_fill_sound(filled: &Item) -> Option<Sound> {
   418	    if filled.id == Item::WATER_BUCKET.id {
   419	        Some(Sound::ItemBucketFill)
   420	    } else if filled.id == Item::LAVA_BUCKET.id {
   421	        Some(Sound::ItemBucketFillLava)
   422	    } else if filled.id == Item::POWDER_SNOW_BUCKET.id {
   423	        Some(Sound::ItemBucketFillPowderSnow)
   424	    } else {
   425	        None
   426	    }
   427	}
   428	
   429	/// `TropicalFish.applyImplicitComponents`/`get`: reads back each independently present
   430	/// pattern/base/pattern-color component a bucket picked up a tropical fish saved
   431	/// (`TropicalFish.java:166-197, 200-206`). Vanilla applies every present component separately;
   432	/// absent components therefore remain at the freshly spawned fish's values.
   433	///
   434	/// A bucket with no fish data (e.g. from `/give`) returns `None` here and leaves the freshly
   435	/// spawned fish at whatever `TropicalFishEntity::new` rolled. This matches vanilla:
   436	/// `EntityType.create` (EntityType.java:200-204) always calls `finalizeSpawn` -- which for
   437	/// `TropicalFish` unconditionally rolls the 90/10 variant regardless of spawn reason -- and only
   438	/// *afterward* does `MobBucketItem.spawn`'s `postSpawnConfig` (EntityType.java:207-209)
   439	/// overwrite it from `BUCKET_ENTITY_DATA` if present, so a variant-less bucket also produces a
   440	/// random vanilla fish, not `DEFAULT_VARIANT`.
   441	fn read_tropical_fish_variant(
   442	    stack: &ItemStack,
   443	) -> Option<(Option<Pattern>, Option<DyeColor>, Option<DyeColor>)> {
   444	    let pattern = stack
   445	        .get_data_component::<TropicalFishPatternImpl>()
   446	        .map(|value| Pattern::from_name(&value.value));
   447	    let base_color = stack
   448	        .get_data_component::<TropicalFishBaseColorImpl>()
   449	        .map(|value| DyeColor::from(value.value.as_ref()));
   450	    let pattern_color = stack
   451	        .get_data_component::<TropicalFishPatternColorImpl>()
   452	        .map(|value| DyeColor::from(value.value.as_ref()));
   453	    (pattern.is_some() || base_color.is_some() || pattern_color.is_some()).then_some((
   454	        pattern,
   455	        base_color,
   456	        pattern_color,
   457	    ))
   458	}

   554	pub async fn drop_loot(
   555	    world: &Arc<World>,
   556	    block: &Block,
   557	    pos: &BlockPos,
   558	    experience: bool,
   559	    params: LootContextParameters,
   560	) {
   561	    // In 1.21 a tool's `block_experience` enchantment effects are folded over
   562	    // the sampled amount, and Silk Touch is the only enchantment that defines
   563	    // one: it sets the result to zero. Special-casing it is equivalent for
   564	    // now, but a general effect pass would be the faithful implementation.
   565	    // Read before `params` is moved into the loot table below.
   566	    let silk_touched = experience
   567	        && block.experience.is_some()
   568	        && params.tool.as_ref().is_some_and(|tool| {
   569	            tool.get_enchantment_level(&pumpkin_data::Enchantment::SILK_TOUCH) > 0
   570	        });
   571	
   572	    // Vanilla gates both item drops and experience on this rule, in
   573	    // `Block#popResource` and `Block#popExperience` respectively, so with the
   574	    // rule off an ore drops neither its item nor its experience orbs.
   575	    let block_drops = world.level_info.load().game_rules.block_drops;
   576	
   577	    if block_drops && let Some(loot_table) = &block.loot_table {
   578	        let items = loot_table.get_loot(params);
   579	        if !items.is_empty() {
   580	            let mut event = crate::plugin::block::block_drop_item::BlockDropItemEvent {
   581	                block_pos: *pos,
   582	                world: world.clone(),
   583	                player: None,
   584	                items,
   585	                cancelled: false,
   586	            };
   587	            if let Some(server) = world.server.upgrade() {
   588	                server.plugin_manager.fire(&server, &mut event).await;
   589	            }
   590	            if !event.cancelled {
   591	                for stack in event.items {
   592	                    world.drop_stack(pos, stack).await;
   593	                }
   594	            }
   595	        }
   596	    }
   597	
   598	    if block_drops
   599	        && experience
   600	        && !silk_touched
   601	        && let Some(experience) = &block.experience
   602	    {
   603	        let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(get_seed()));
   604	        let amount = experience.experience.get(&mut random);
   605	        if amount > 0 {
   606	            let mut event = crate::plugin::block::block_exp::BlockExpEvent {
   607	                block_pos: *pos,
   608	                world: world.clone(),
   609	                exp: amount,
   610	            };
   611	            if let Some(server) = world.server.upgrade() {
   612	                server.plugin_manager.fire(&server, &mut event).await;
   613	            }
   614	            if event.exp > 0 {
   615	                ExperienceOrbEntity::spawn(world, pos.to_f64(), event.exp as u32).await;
   616	            }
   617	        }
   618	    }
   619	}
   620	
   621	pub async fn calc_block_breaking(
   622	    player: &Player,
   623	    state: &BlockState,
   624	    block: &'static Block,
   625	) -> f32 {
   626	    let hardness = state.hardness;
   627	    #[expect(clippy::float_cmp)]
   628	    if hardness == -1.0 {
   629	        // unbreakable
   630	        return 0.0;
   631	    }
   632	    let i = if player.can_harvest(state, block).await {
   633	        30.0
   634	    } else {
   635	        100.0
   636	    };
   637	
   638	    player.get_mining_speed(block).await / hardness / i
   639	}
   640	
   641	#[derive(PartialEq, Eq, Debug)]
   642	pub enum BlockIsReplacing {
   643	    Itself(BlockStateId),
   644	    Water(u8),
   645	    Other,
   646	    None,
   647	}
   648	
   649	impl BlockIsReplacing {
   650	    #[must_use]
   651	    /// Returns true if the block was a water source block.
   652	    pub const fn water_source(&self) -> bool {
   653	        match self {
   654	            // Level 0 means the water is a source block
   655	            Self::Water(level) => *level == 0,
   656	            _ => false,
   657	        }
   658	    }
   659	}
   660	
   661	pub async fn calculate_comparator_output(
   662	    inventory: &dyn pumpkin_world::inventory::Inventory,
   663	) -> u8 {
   664	    let size = inventory.size();
   665	    if size == 0 {
   666	        return 0;
   667	    }
   668	    let mut fill_sum = 0.0;
   669	    let mut non_empty_count = 0;
   670	    for i in 0..size {
   671	        let stack = inventory.get_stack(i).await;
   672	        if !stack.is_empty() {
   673	            let max_stack = stack.get_max_stack_size() as f32;
   674	            let count = stack.item_count as f32;
   675	            fill_sum += count / max_stack;
   676	            non_empty_count += 1;
   677	        }
   678	    }
   679	    if non_empty_count == 0 {
   680	        return 0;
   681	    }
   682	    let percentage = fill_sum / (size as f32);
   683	    let output = 1.0 + percentage * 14.0;
   684	    output.floor() as u8
   685	}

   460	async fn try_place_powder_snow(
   461	    world: &Arc<World>,
   462	    pos: BlockPos,
   463	    direction: BlockDirection,
   464	) -> bool {
   465	    let state = world.get_block_state(&pos);
   466	    let target_pos = if state.replaceable() {
   467	        pos
   468	    } else {
   469	        pos.offset(direction.to_offset())
   470	    };
   471	    let target_state = world.get_block_state(&target_pos);
   472	    if !target_state.is_air() && !target_state.is_liquid() && !target_state.replaceable() {
   473	        return false;
   474	    }
   475	    world
   476	        .set_block_state(
   477	            &target_pos,
   478	            Block::POWDER_SNOW.default_state.id,
   479	            BlockFlags::NOTIFY_NEIGHBORS,
   480	        )
   481	        .await;
   482	    true
   483	}

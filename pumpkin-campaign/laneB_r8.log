    94	/// Extra methods for [`Player`] to send and manage the bossbar.
    95	impl Player {
    96	    pub async fn send_bossbar(&self, bossbar: &Bossbar) {
    97	        match self.client.as_ref() {
    98	            ClientPlatform::Java(java) => {
    99	                let boss_action = BosseventAction::Add {
   100	                    title: bossbar.title.clone(),
   101	                    health: bossbar.health,
   102	                    color: (bossbar.color as u8).into(),
   103	                    division: (bossbar.division as u8).into(),
   104	                    flags: bossbar.flags.bits(),
   105	                };
   106	
   107	                let packet = CBossEvent::new(&bossbar.uuid, boss_action);
   108	                java.enqueue_client_packet(&packet).await;
   109	            }
   110	            ClientPlatform::Bedrock(bedrock) => {
   111	                let packet = BBossEvent {
   112	                    boss_entity_id: VarLong(bossbar.uuid.as_u128() as i64),
   113	                    action: BossEventAction::Add {
   114	                        title: bossbar.title.clone().get_text(),
   115	                        health_percent: bossbar.health,
   116	                        color: bossbar.color.to_bedrock(),
   117	                        overlay: bossbar.division.to_bedrock(),
   118	                    },
   119	                };
   120	                bedrock.send_packet(&packet).await;
   121	            }
   122	        }
   123	    }
   124	

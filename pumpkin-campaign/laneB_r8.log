   116	            chunk,
   117	            random,
   118	            node,
   119	            foliage_height,
   120	            radius,
   121	            offset,
   122	            foliage_provider,
   123	        )
   124	    }
   125	
   126	    pub fn get_random_radius(&self, random: &mut RandomGenerator, base_height: i32) -> i32 {
   127	        match &self.r#type {
   128	            FoliageType::Pine(_) => PineFoliagePlacer::get_random_radius(self, random, base_height),
   129	            _ => self.radius.get(random),
   130	        }
   131	    }
   132	
   133	    pub fn place_foliage_block<T: GenerationCache>(
   134	        chunk: &mut T,
   135	        pos: BlockPos,
   136	        block_state: &BlockState,
   137	    ) -> bool {
   138	        let existing = GenerationCache::get_block_state(chunk, &pos.0);
   139	        if existing
   140	            .to_block()
   141	            .properties(existing)
   142	            .is_some_and(|props| {
   143	                props
   144	                    .to_props()
   145	                    .iter()
   146	                    .any(|(key, value)| *key == "persistent" && *value == "true")
   147	            })
   148	            || !TreeFeature::can_replace(existing.to_state(), existing.to_block_id())
   149	        {
   150	            return false;
   151	        }
   152	
   153	        // Vanilla `FoliagePlacer.tryPlaceLeaf` (`FoliagePlacer.java:173-183`) sets
   154	        // `waterlogged` to whether the target contains a water source.
   155	        let (fluid, fluid_state) = GenerationCache::get_fluid_and_fluid_state(chunk, &pos.0);
   156	        let foliage_state = Self::set_waterlogged(
   157	            block_state,
   158	            fluid_state.is_source && fluid.matches_type(&Fluid::WATER),
   159	        );
   160	        chunk.set_block_state(&pos.0, foliage_state);
   161	        true
   162	    }
   163	
   164	    // Mirrors `FoliagePlacer.tryPlaceLeaf` (`FoliagePlacer.java:175-179`), including
   165	    // clearing a provider state that was already waterlogged outside a water source.
   166	    fn set_waterlogged(block_state: &BlockState, waterlogged: bool) -> &BlockState {
   167	        let block = Block::from_state_id(block_state.id);
   168	        let Some(properties) = block.properties(block_state.id) else {
   169	            return block_state;
   170	        };
   171	        let mut properties = properties.to_props();
   172	        let Some(index) = properties.iter().position(|(key, _)| *key == "waterlogged") else {
   173	            return block_state;
   174	        };
   175	        properties[index] = ("waterlogged", if waterlogged { "true" } else { "false" });
   176	        BlockState::from_id(block.from_properties(&properties).to_state_id(block))
   177	    }
   178	
   179	    pub fn is_set<T: GenerationCache>(
   180	        chunk: &T,
   181	        pos: BlockPos,
   182	        foliage_provider: &BlockState,
   183	    ) -> bool {
   184	        GenerationCache::get_block_state(chunk, &pos.0) == foliage_provider.id
   185	    }
   186	
   187	    fn try_place_extension<T: GenerationCache>(
   188	        foliage_positions: &mut Vec<BlockPos>,
   189	        chunk: &mut T,
   190	        random: &mut RandomGenerator,
   280	                pos = pos.offset_dir(along_edge.to_offset(), 1);
   281	            }
   282	        }
   283	    }
   284	}

   179	pub fn sync_read_items_from_nbt(nbt: &NbtCompound, stacks: &mut [ItemStack]) {
   180	    if let Some(inventory_list) = nbt.get_list("Items") {
   181	        for tag in inventory_list {
   182	            if let Some(item_compound) = tag.extract_compound()
   183	                && let Some(slot_byte) = item_compound.get_byte("Slot")
   184	            {
   185	                let slot = slot_byte as usize;
   186	                if slot < stacks.len()
   187	                    && let Some(item_stack) = ItemStack::read_item_stack(item_compound)
   188	                {
   189	                    stacks[slot] = item_stack;
   190	                }
   191	            }
   192	        }
   193	    }
   194	}

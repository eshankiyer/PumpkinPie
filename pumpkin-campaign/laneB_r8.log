   212	        self.record_stack.lock().await.clone()
   213	    }
   214	
   215	    /// Set the record stack - matches vanilla's `setStack()`
   216	    /// Note: The caller is responsible for updating block state and playing music
   217	    pub async fn set_record(&self, stack: ItemStack) {
   218	        *self.record_stack.lock().await = stack;
   219	        self.mark_dirty();
   220	    }
   221	
   222	    /// Clear the stack and return what was there - used for dropping
   223	    pub async fn clear_record(&self) -> ItemStack {
   224	        self.stop_playing();
   225	        let mut record = self.record_stack.lock().await;
   226	        let taken = record.clone();
   227	        *record = ItemStack::EMPTY.clone();

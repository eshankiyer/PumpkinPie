   592	   @Override
   593	   public void handleCustomCommandSuggestions(final ServerboundCommandSuggestionPacket packet) {
   594	      PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
   595	      StringReader command = new StringReader(packet.getCommand());
   596	      if (command.canRead() && command.peek() == '/') {
   597	         command.skip();
   598	      }
   599	
   600	      ParseResults<CommandSourceStack> parse = this.server.getCommands().getDispatcher().parse(command, this.player.createCommandSourceStack());
   601	      this.server.getCommands().getDispatcher().getCompletionSuggestions(parse).thenAccept(results -> {
   602	         Suggestions suggestions = results.getList().size() <= 1000 ? results : new Suggestions(results.getRange(), results.getList().subList(0, 1000));
   603	         this.send(new ClientboundCommandSuggestionsPacket(packet.getId(), suggestions));
   604	      });
   605	   }

   252	   @Override
   253	   protected boolean canSurvive(final BlockState state, final LevelReader level, final BlockPos pos) {
   254	      Direction connectionDir = getConnectedDirection(state).getOpposite();
   255	      return connectionDir == Direction.UP
   256	         ? Block.canSupportCenter(level, pos.above(), Direction.DOWN)
   257	         : FaceAttachedHorizontalDirectionalBlock.canAttach(level, pos, connectionDir);
   258	   }
   259	
   260	   private static Direction getConnectedDirection(final BlockState state) {
   261	      return switch ((BellAttachType)state.getValue(ATTACHMENT)) {
   262	         case FLOOR -> Direction.UP;
   263	         case CEILING -> Direction.DOWN;
   264	         default -> state.getValue(FACING).getOpposite();
   265	      };
   266	   }

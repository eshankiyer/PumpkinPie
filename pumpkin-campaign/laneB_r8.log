    25	}
    26	
    27	const HEIGHT_BLENDING_RANGE_CELLS: i32 = (7 << 2) - 1; // QuartPos.fromSection(7) - 1
    28	const HEIGHT_BLENDING_RANGE_CHUNKS: i32 = (HEIGHT_BLENDING_RANGE_CELLS + 3) >> 2; // QuartPos.toSection(...)
    29	const DENSITY_BLENDING_RANGE_CELLS: i32 = 2;
    30	const DENSITY_BLENDING_RANGE_CHUNKS: i32 = 5 >> 2; // QuartPos.toSection(5)
    31	
    32	impl Blender {
    33	    #[must_use]
    34	    pub fn empty() -> Self {
    35	        Self {
    36	            height_and_biome_blending_data: FxHashMap::default(),
    37	            density_blending_data: FxHashMap::default(),
    38	        }
    39	    }
    40	
    41	    pub fn of<C: ProtoChunkCache>(cache: &C) -> Self {
    42	        let center_chunk = cache.get_center_chunk();
    43	        let center_x = center_chunk.x;
    44	        let center_z = center_chunk.z;
    45	
    46	        let mut height_and_biome_data = FxHashMap::default();
    47	        let mut density_data = FxHashMap::default();
    48	
    49	        let max_dist_sq = (HEIGHT_BLENDING_RANGE_CHUNKS + 1) * (HEIGHT_BLENDING_RANGE_CHUNKS + 1);
    50	
    51	        for dx in -HEIGHT_BLENDING_RANGE_CHUNKS..=HEIGHT_BLENDING_RANGE_CHUNKS {
    52	            for dz in -HEIGHT_BLENDING_RANGE_CHUNKS..=HEIGHT_BLENDING_RANGE_CHUNKS {
    53	                if dx * dx + dz * dz <= max_dist_sq {
    54	                    let chunk_x = center_x + dx;
    55	                    let chunk_z = center_z + dz;
    56	
    57	                    if let Some(blending_data) = cache.get_blending_data(chunk_x, chunk_z) {
    58	                        let packed = (chunk_x as u32 as u64) | ((chunk_z as u32 as u64) << 32);
    59	                        height_and_biome_data.insert(packed, blending_data.clone());
    60	
    61	                        if (-DENSITY_BLENDING_RANGE_CHUNKS..=DENSITY_BLENDING_RANGE_CHUNKS)
    62	                            .contains(&dx)
    63	                            && (-DENSITY_BLENDING_RANGE_CHUNKS..=DENSITY_BLENDING_RANGE_CHUNKS)
    64	                                .contains(&dz)
    65	                        {
    66	                            density_data.insert(packed, blending_data.clone());
    67	                        }
    68	                    }
    69	                }
    70	            }
    71	        }
    72	
    73	        if height_and_biome_data.is_empty() && density_data.is_empty() {
    74	            Self::empty()
    75	        } else {
    76	            Self {
    77	                height_and_biome_blending_data: height_and_biome_data,
    78	                density_blending_data: density_data,
    79	            }
    80	        }
    81	    }
    82	
    83	    #[must_use]
    84	    pub fn is_empty(&self) -> bool {
    85	        self.height_and_biome_blending_data.is_empty() && self.density_blending_data.is_empty()
    86	    }
    87	
    88	    #[must_use]
    89	    pub fn blend_offset_and_factor(&self, block_x: i32, block_z: i32) -> BlendingOutput {
    90	        let cell_x = biome_coords::from_block(block_x);
    91	        let cell_z = biome_coords::from_block(block_z);
    92	
    93	        let fixed_height = self.get_blending_data_value(
    94	            cell_x,
    95	            0,
    96	            cell_z,
    97	            blending_data::BlendingData::get_height,
    98	        );
    99	
   100	        if fixed_height != f64::MAX {
   101	            return BlendingOutput {
   102	                alpha: 0.0,
   103	                blending_offset: Self::height_to_offset(fixed_height),
   104	            };
   105	        }
   106	
   107	        let mut total_weight = 0.0;
   108	        let mut weighted_heights = 0.0;
   109	        let mut closest_distance = f64::INFINITY;
   110	
   111	        for (&packed_pos, blending_data) in &self.height_and_biome_blending_data {
   112	            let chunk_x = (packed_pos & 0xFFFFFFFF) as i32;
   113	            let chunk_z = (packed_pos >> 32) as i32;
   114	
   115	            blending_data.iterate_heights(
   116	                biome_coords::from_chunk(chunk_x),
   117	                biome_coords::from_chunk(chunk_z),
   118	                |test_cell_x, test_cell_z, height| {
   119	                    let dx = (cell_x - test_cell_x) as f64;
   120	                    let dz = (cell_z - test_cell_z) as f64;
   121	                    let distance = dx.hypot(dz);
   122	
   123	                    if distance <= HEIGHT_BLENDING_RANGE_CELLS as f64 {
   124	                        if distance < closest_distance {
   125	                            closest_distance = distance;
   126	                        }
   127	
   128	                        let weight = 1.0 / (distance * distance * distance * distance);
   129	                        weighted_heights += height * weight;
   130	                        total_weight += weight;
   131	                    }
   132	                },
   133	            );
   134	        }
   135	
   136	        if closest_distance == f64::INFINITY {
   137	            BlendingOutput {
   138	                alpha: 1.0,
   139	                blending_offset: 0.0,
   140	            }
   141	        } else {
   142	            let average_height = weighted_heights / total_weight;
   143	            let mut alpha =
   144	                (closest_distance / (HEIGHT_BLENDING_RANGE_CELLS + 1) as f64).clamp(0.0, 1.0);
   145	            alpha = 3.0 * alpha * alpha - 2.0 * alpha * alpha * alpha;
   146	            BlendingOutput {
   147	                alpha,
   148	                blending_offset: Self::height_to_offset(average_height),
   149	            }
   150	        }
   151	    }
   152	
   153	    fn height_to_offset(height: f64) -> f64 {
   154	        let target_y = height + 0.5;
   155	        let target_y_mod = target_y.rem_euclid(8.0);
   156	        (32.0 * (target_y - 128.0) - 3.0 * (target_y - 120.0) * target_y_mod
   157	            + 3.0 * target_y_mod * target_y_mod)
   158	            / (128.0 * (32.0 - 3.0 * target_y_mod))
   159	    }
   160	
   161	    #[must_use]
   162	    pub fn blend_density(&self, block_x: i32, block_y: i32, block_z: i32, noise_value: f64) -> f64 {
   163	        let cell_x = biome_coords::from_block(block_x);
   164	        let cell_y = block_y / 8;
   165	        let cell_z = biome_coords::from_block(block_z);
   166	
   167	        let fixed_density =
   168	            self.get_blending_data_value(cell_x, cell_y, cell_z, |data, x, y, z| {
   169	                data.get_density(x, y, z)
   170	            });
   171	
   172	        if fixed_density != f64::MAX {
   173	            return fixed_density;
   174	        }
   175	
   176	        let mut total_weight = 0.0;
   177	        let mut weighted_densities = 0.0;
   178	        let mut closest_distance = f64::INFINITY;
   179	
   180	        for (&packed_pos, blending_data) in &self.density_blending_data {
   181	            let chunk_x = (packed_pos & 0xFFFFFFFF) as i32;
   182	            let chunk_z = (packed_pos >> 32) as i32;
   183	
   184	            blending_data.iterate_densities(
   185	                biome_coords::from_chunk(chunk_x),
   186	                biome_coords::from_chunk(chunk_z),
   187	                cell_y - 1,
   188	                cell_y + 1,
   189	                |test_cell_x, test_cell_y, test_cell_z, density| {
   190	                    let dx = (cell_x - test_cell_x) as f64;
   191	                    let dy = ((cell_y - test_cell_y) * 2) as f64;
   192	                    let dz = (cell_z - test_cell_z) as f64;
   193	                    let distance = (dx * dx + dy * dy + dz * dz).sqrt();
   194	
   195	                    if distance <= 2.0 {
   196	                        if distance < closest_distance {
   197	                            closest_distance = distance;
   198	                        }
   199	
   200	                        let weight = 1.0 / (distance * distance * distance * distance);
   201	                        weighted_densities += density * weight;
   202	                        total_weight += weight;
   203	                    }
   204	                },
   205	            );
   206	        }
   207	
   208	        if closest_distance == f64::INFINITY {
   209	            noise_value
   210	        } else {
   211	            let average_density = weighted_densities / total_weight;
   212	            let alpha = (closest_distance / 3.0).clamp(0.0, 1.0);
   213	            alpha * noise_value + (1.0 - alpha) * average_density
   214	        }
   215	    }
   216	
   217	    fn get_blending_data_value<F>(&self, cell_x: i32, cell_y: i32, cell_z: i32, getter: F) -> f64
   218	    where
   219	        F: Fn(&BlendingData, i32, i32, i32) -> f64,
   220	    {
   221	        let chunk_x = biome_coords::to_chunk(cell_x);
   222	        let chunk_z = biome_coords::to_chunk(cell_z);
   223	        let min_x = cell_x.trailing_zeros() >= 2;
   224	        let min_z = cell_z.trailing_zeros() >= 2;
   225	
   226	        let mut value = self.get_data_value(&getter, chunk_x, chunk_z, cell_x, cell_y, cell_z);
   227	        if value == f64::MAX {
   228	            if min_x && min_z {
   229	                value =
   230	                    self.get_data_value(&getter, chunk_x - 1, chunk_z - 1, cell_x, cell_y, cell_z);
   231	            }
   232	
   233	            if value == f64::MAX {
   234	                if min_x {
   235	                    value =
   236	                        self.get_data_value(&getter, chunk_x - 1, chunk_z, cell_x, cell_y, cell_z);
   237	                }
   238	
   239	                if value == f64::MAX && min_z {
   240	                    value =
   241	                        self.get_data_value(&getter, chunk_x, chunk_z - 1, cell_x, cell_y, cell_z);
   242	                }
   243	            }
   244	        }
   245	
   246	        value
   247	    }
   248	
   249	    fn get_data_value<F>(
   250	        &self,
   251	        getter: &F,
   252	        chunk_x: i32,
   253	        chunk_z: i32,
   254	        cell_x: i32,
   255	        cell_y: i32,
   256	        cell_z: i32,
   257	    ) -> f64
   258	    where
   259	        F: Fn(&BlendingData, i32, i32, i32) -> f64,
   260	    {
   261	        let packed = (chunk_x as u32 as u64) | ((chunk_z as u32 as u64) << 32);
   262	        self.height_and_biome_blending_data
   263	            .get(&packed)
   264	            .map_or(f64::MAX, |data| {
   265	                getter(
   266	                    data,
   267	                    cell_x - biome_coords::from_chunk(chunk_x),
   268	                    cell_y,
   269	                    cell_z - biome_coords::from_chunk(chunk_z),
   270	                )
   271	            })
   272	    }
   273	
   274	    #[must_use]
   275	    pub fn blend_biome(
   276	        &self,
   277	        quart_x: i32,
   278	        quart_y: i32,
   279	        quart_z: i32,
   280	        shift_noise: &DoublePerlinNoiseSampler,
   281	    ) -> Option<&'static Biome> {
   282	        let mut closest_distance = f64::INFINITY;
   283	        let mut closest_biome = None;
   284	
   285	        for (&packed_pos, blending_data) in &self.height_and_biome_blending_data {
   286	            let chunk_x = (packed_pos & 0xFFFFFFFF) as i32;
   287	            let chunk_z = (packed_pos >> 32) as i32;
   288	
   289	            blending_data.iterate_biomes(
   290	                biome_coords::from_chunk(chunk_x),
   291	                quart_y,
   292	                biome_coords::from_chunk(chunk_z),
   293	                |test_cell_x, test_cell_z, biome| {
   294	                    let dx = (quart_x - test_cell_x) as f64;
   295	                    let dz = (quart_z - test_cell_z) as f64;
   296	                    let distance = dx.hypot(dz);
   297	
   298	                    if distance <= HEIGHT_BLENDING_RANGE_CELLS as f64 && distance < closest_distance
   299	                    {
   300	                        closest_biome = Some(biome);
   301	                        closest_distance = distance;
   302	                    }
   303	                },
   304	            );
   305	        }
   306	
   307	        if closest_distance == f64::INFINITY {
   308	            None
   309	        } else {
   310	            let shift = shift_noise.sample(quart_x as f64, 0.0, quart_z as f64) * 12.0;
   311	            let alpha = ((closest_distance + shift) / (HEIGHT_BLENDING_RANGE_CELLS + 1) as f64)
   312	                .clamp(0.0, 1.0);
   313	            if alpha > 0.5 { None } else { closest_biome }
   314	        }
   315	    }
   316	}
   317	
   318	pub struct BlenderBiomeSupplier<'a> {
   319	    base: &'a dyn BiomeSupplier,
   320	    blender: &'a Blender,
   321	    shift_noise: DoublePerlinNoiseSampler,
   322	}
   323	
   324	impl BiomeSupplier for BlenderBiomeSupplier<'_> {
   325	    fn biome(&self, x: i32, y: i32, z: i32, sampler: &mut MultiNoiseSampler<'_>) -> &'static Biome {
   326	        self.blender
   327	            .blend_biome(x, y, z, &self.shift_noise)
   328	            .unwrap_or_else(|| self.base.biome(x, y, z, sampler))
   329	    }
   330	}
   331	
   332	pub trait BlenderImpl {
   333	    fn blend_offset_and_factor(&self, block_x: i32, block_z: i32) -> BlendingOutput;
   334	
   335	    fn blend_density(&self, pos: &Vector3<i32>, density: f64) -> f64;
   336	
   337	    fn get_biome_supplier<'a>(
   338	        &'a self,
   339	        supplier: &'a dyn BiomeSupplier,
   340	    ) -> BlenderBiomeSupplier<'a>;
   341	}
   342	
   343	impl BlenderImpl for Blender {
   344	    fn blend_offset_and_factor(&self, block_x: i32, block_z: i32) -> BlendingOutput {
   345	        self.blend_offset_and_factor(block_x, block_z)
   346	    }
   347	
   348	    fn blend_density(&self, pos: &Vector3<i32>, density: f64) -> f64 {
   349	        self.blend_density(pos.x, pos.y, pos.z, density)
   350	    }
   351	
   352	    fn get_biome_supplier<'a>(
   353	        &'a self,
   354	        supplier: &'a dyn BiomeSupplier,
   355	    ) -> BlenderBiomeSupplier<'a> {
   356	        let mut random = Xoroshiro::from_seed(42);
   357	        let shift_noise = DoublePerlinNoiseSampler::from_params(
   358	            &mut random,
   359	            &DoublePerlinNoiseParameters::OFFSET,
   360	            false,
   361	        );
   362	        BlenderBiomeSupplier {
   363	            base: supplier,
   364	            blender: self,
   365	            shift_noise,
   366	        }
   367	    }
   368	}

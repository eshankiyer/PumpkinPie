   113	   public static boolean hasRequiredLogs(final BlockState state, final LevelReader level, final BlockPos pos) {
   114	      Direction.Axis axis = state.getValue(AXIS);
   115	
   116	      for (Direction dir : axis.getDirections()) {
   117	         BlockState neigbour = level.getBlockState(pos.relative(dir));
   118	         if (!neigbour.is(BlockTags.PALE_OAK_LOGS) || neigbour.getValue(AXIS) != axis) {
   119	            return false;
   120	         }
   121	      }
   122	
   123	      return true;
   124	   }

   363	fn old_chunk_carving_mask_filter(
   364	    old_chunks: Vec<(f64, f64, f64, f64)>,
   365	) -> impl Fn(i32, i32, i32) -> bool + Send + Sync + 'static {
   366	    let mut random = Xoroshiro::from_seed(42);
   367	    let shift_noise = DoublePerlinNoiseSampler::from_params(
   368	        &mut random,
   369	        &DoublePerlinNoiseParameters::OFFSET,
   370	        false,
   371	    );
   372	
   373	    move |x, y, z| {
   374	        let x = x as f64;
   375	        let y = y as f64;
   376	        let z = z as f64;
   377	        let shifted_x = x + 0.5 + shift_noise.sample(x, y, z) * 4.0;
   378	        let shifted_y = y + 0.5 + shift_noise.sample(y, z, x) * 4.0;
   379	        let shifted_z = z + 0.5 + shift_noise.sample(z, x, y) * 4.0;
   380	
   381	        old_chunks.iter().any(
   382	            |&(offset_x, offset_z, center_y, radius_y)| {
   383	                let delta_x = (shifted_x - 8.0 - offset_x).abs() - 8.0;
   384	                let delta_y = (shifted_y - center_y).abs() - radius_y;
   385	                let delta_z = (shifted_z - 8.0 - offset_z).abs() - 8.0;
   386	                let outside_x = delta_x.max(0.0);
   387	                let outside_y = delta_y.max(0.0);
   388	                let outside_z = delta_z.max(0.0);
   389	                (outside_x * outside_x + outside_y * outside_y + outside_z * outside_z).sqrt()
   390	                    < 4.0
   391	            },
   392	        )
   393	    }
   394	}

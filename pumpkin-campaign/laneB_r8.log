   350	    /// contains an empty slot (`JukeboxBlockEntity.java:147-150`).
   351	    fn can_take_item<'a>(
   352	        &'a self,
   353	        into: &'a dyn Inventory,
   354	        _slot: usize,
   355	        _stack: &'a ItemStack,
   356	    ) -> InventoryFuture<'a, bool> {
   357	        Box::pin(async move { into.contains_any_predicate(&|stack| stack.is_empty()).await })
   358	    }

    52	impl BlockEntity for JukeboxBlockEntity {
    53	    fn resource_location(&self) -> &'static str {
    54	        Self::ID
    55	    }
    56	
    57	    fn get_position(&self) -> BlockPos {
    58	        self.position
    59	    }
    60	
    61	    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self
    62	    where
    63	        Self: Sized,
    64	    {
    65	        let record_stack = nbt
    66	            .get_compound(RECORD_ITEM_NBT_KEY)
    67	            .and_then(ItemStack::read_item_stack)
    68	            .unwrap_or_else(|| ItemStack::EMPTY.clone());
    69	
    70	        let ticks_since_song_started =
    71	            nbt.get_long(TICKS_SINCE_SONG_STARTED_NBT_KEY).unwrap_or(0) as u64;
    72	        let song_length = song_length_ticks(&record_stack);
    73	
    74	        Self {
    75	            position,
    76	            record_stack: Arc::new(Mutex::new(record_stack)),
    77	            // Vanilla `loadAdditional` restores the song player with the saved tick count
    78	            // (`JukeboxBlockEntity.java:72-85`), and `setSongWithoutPlaying` retains it only
    79	            // while the song has not finished (`JukeboxSongPlayer.java:38-43`).
    80	            ticks_since_song_started: AtomicU64::new(if song_length > 0 {
    81	                ticks_since_song_started
    82	            } else {
    83	                0
    84	            }),
    85	            song_length_ticks: AtomicU64::new(song_length),
    86	            dirty: AtomicBool::new(false),
    87	        }
    88	    }
    89	
    90	    fn write_nbt<'a>(
    91	        &'a self,
    92	        nbt: &'a mut NbtCompound,
    93	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    94	        Box::pin(async move {
    95	            let record = self.record_stack.lock().await;
    96	            if !record.is_empty() {
    97	                let mut record_nbt = NbtCompound::new();
    98	                record.write_item_stack(&mut record_nbt);
    99	                nbt.put(RECORD_ITEM_NBT_KEY, record_nbt);
   100	            }
   101	
   102	            let ticks = self.ticks_since_song_started.load(Ordering::Relaxed);
   103	            if ticks > 0 {
   104	                nbt.put_long(TICKS_SINCE_SONG_STARTED_NBT_KEY, ticks as i64);
   105	            }
   106	        })
   107	    }
   108	
   109	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   110	        Box::pin(async move {
   111	            // Increment ticks if we're playing
   112	            let song_length = self.song_length_ticks.load(Ordering::Relaxed);
   113	            if song_length > 0 {
   114	                let ticks = self
   115	                    .ticks_since_song_started
   116	                    .fetch_add(1, Ordering::Relaxed);
   117	                // Check if song has finished (with vanilla's end-padding grace period)
   118	                if ticks >= song_length + SONG_END_PADDING_TICKS {
   119	                    self.stop_playing();
   120	                    world.update_neighbors(&self.position, None).await;
   121	                    world
   122	                        .update_comparators(&self.position, &Block::JUKEBOX)
   123	                        .await;
   124	                    self.emit_jukebox_event(world, GameEvent::JukeboxStopPlay)
   125	                        .await;
   126	                } else if ticks.is_multiple_of(20) {
   127	                    // JukeboxSongPlayer.PLAY_EVENT_INTERVAL_TICKS = 20 /
   128	                    // shouldEmitJukeboxPlayingEvent: ticksSinceSongStarted % 20 == 0,
   129	                    // checked against the pre-increment tick count (matches `ticks` here).
   130	                    // This is what keeps a dancing Allay in range considering the jukebox
   131	                    // "still playing" (Allay.java shouldStopDancing / setJukeboxPlaying).
   132	                    self.emit_jukebox_event(world, GameEvent::JukeboxPlay).await;
   133	                }
   134	            }
   135	        })
   136	    }

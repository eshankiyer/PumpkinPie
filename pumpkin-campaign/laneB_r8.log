    81	fn is_point_on_bell(
    82	    hit: &BlockHitResult,
    83	    attachment: BellAttachment,
    84	    block_face: HorizontalFacing,
    85	) -> bool {
    86	    if hit.face == &BlockDirection::Up || hit.face == &BlockDirection::Down {
    87	        return false;
    88	    }
    89	    if hit.cursor_pos.y <= 0.8124f32 {
    90	        match attachment {
    91	            BellAttachment::Floor => {
    92	                hit.face.to_axis() == block_face.to_block_direction().to_axis()
    93	            }
    94	            BellAttachment::SingleWall | BellAttachment::DoubleWall => {
    95	                hit.face.to_axis() != block_face.to_block_direction().to_axis()
    96	            }
    97	            BellAttachment::Ceiling => true,
    98	        }
    99	    } else {
   100	        false
   101	    }
   102	}

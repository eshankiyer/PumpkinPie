   289	pub(crate) const fn holds_no_fluid(item: &Item) -> bool {
   290	    item.id == Item::SULFUR_CUBE_BUCKET.id
   291	}
   292	
   293	/// Returns the aquatic entity carried by a vanilla mob bucket.
   294	///
   295	/// The bucket's `bucket_entity_data` component is currently an opaque marker in
   296	/// Pumpkin, so entity-specific NBT (such as a custom name or tropical-fish
   297	/// variant) cannot yet be restored here.  Spawning the correct base entity is
   298	/// still required after the water has been successfully placed.
   299	const fn mob_bucket_entity_type(item: &Item) -> Option<&'static EntityType> {
   300	    match item.id {
   301	        id if id == Item::AXOLOTL_BUCKET.id => Some(&EntityType::AXOLOTL),
   302	        id if id == Item::COD_BUCKET.id => Some(&EntityType::COD),
   303	        id if id == Item::SALMON_BUCKET.id => Some(&EntityType::SALMON),
   304	        id if id == Item::TROPICAL_FISH_BUCKET.id => Some(&EntityType::TROPICAL_FISH),
   305	        id if id == Item::PUFFERFISH_BUCKET.id => Some(&EntityType::PUFFERFISH),
   306	        id if id == Item::TADPOLE_BUCKET.id => Some(&EntityType::TADPOLE),
   307	        // `Items.java:1275-1279`: `MobBucketItem(EntityTypes.SULFUR_CUBE, Fluids.EMPTY, ...)`.
   308	        id if id == Item::SULFUR_CUBE_BUCKET.id => Some(&EntityType::SULFUR_CUBE),
   309	        _ => None,
   310	    }
   311	}
   312	
   313	/// Reverse of `mob_bucket_entity_type`: the filled bucket item obtained by catching
   314	/// this species with an empty bucket.
   315	const fn bucket_item_for_entity_type(entity_type: &EntityType) -> Option<&'static Item> {
   316	    match entity_type.id {
   317	        id if id == EntityType::AXOLOTL.id => Some(&Item::AXOLOTL_BUCKET),
   318	        id if id == EntityType::COD.id => Some(&Item::COD_BUCKET),
   319	        id if id == EntityType::SALMON.id => Some(&Item::SALMON_BUCKET),
   320	        id if id == EntityType::TROPICAL_FISH.id => Some(&Item::TROPICAL_FISH_BUCKET),
   321	        id if id == EntityType::PUFFERFISH.id => Some(&Item::PUFFERFISH_BUCKET),
   322	        id if id == EntityType::TADPOLE.id => Some(&Item::TADPOLE_BUCKET),
   323	        // `SulfurCube.getBucketItemStack` (`SulfurCube.java:207-210`); the mob implements
   324	        // `Bucketable` (`SulfurCube.java:80`) and is caught through the shared
   325	        // `Bucketable.bucketMobPickup` path (`SulfurCube.java:474`).
   326	        id if id == EntityType::SULFUR_CUBE.id => Some(&Item::SULFUR_CUBE_BUCKET),
   327	        _ => None,
   328	    }
   329	}
   330	
   331	/// Vanilla `Bucketable.getPickupSound` per species (Axolotl/Tadpole have their own
   332	/// sound, the four fish species all share `item.bucket.fill_fish`).
   333	const fn pickup_sound_for_entity_type(entity_type: &EntityType) -> Option<Sound> {
   334	    match entity_type.id {
   335	        id if id == EntityType::AXOLOTL.id => Some(Sound::ItemBucketFillAxolotl),
   336	        id if id == EntityType::TADPOLE.id => Some(Sound::ItemBucketFillTadpole),
   337	        id if id == EntityType::COD.id
   338	            || id == EntityType::SALMON.id
   339	            || id == EntityType::TROPICAL_FISH.id
   340	            || id == EntityType::PUFFERFISH.id =>
   341	        {
   342	            Some(Sound::ItemBucketFillFish)
   343	        }
   344	        // `SulfurCube.getPickupSound` (`SulfurCube.java:163-166`).
   345	        id if id == EntityType::SULFUR_CUBE.id => Some(Sound::ItemBucketFillSulfurCube),
   346	        _ => None,
   347	    }
   348	}
   349	
   350	const fn mob_bucket_empty_sound(item: &Item) -> Option<Sound> {
   351	    match item.id {
   352	        id if id == Item::AXOLOTL_BUCKET.id => Some(Sound::ItemBucketEmptyAxolotl),
   353	        id if id == Item::TADPOLE_BUCKET.id => Some(Sound::ItemBucketEmptyTadpole),
   354	        id if id == Item::COD_BUCKET.id
   355	            || id == Item::SALMON_BUCKET.id
   356	            || id == Item::TROPICAL_FISH_BUCKET.id
   357	            || id == Item::PUFFERFISH_BUCKET.id =>
   358	        {
   359	            Some(Sound::ItemBucketEmptyFish)
   360	        }
   361	        // `Items.java:1275-1279`: `SoundEvents.BUCKET_EMPTY_SULFUR_CUBE`.
   362	        id if id == Item::SULFUR_CUBE_BUCKET.id => Some(Sound::ItemBucketEmptySulfurCube),
   363	        _ => None,
   364	    }
   365	}

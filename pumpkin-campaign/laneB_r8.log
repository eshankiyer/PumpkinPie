    54	                props.powered = is_receiving_power;
    55	                args.world
    56	                    .set_block_state(
    57	                        args.position,
    58	                        props.to_state_id(args.block),
    59	                        BlockFlags::NOTIFY_LISTENERS,
    60	                    )
    61	                    .await;
    62	            }
    63	        })
    64	    }
    65	}

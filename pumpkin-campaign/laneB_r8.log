   141	   protected boolean hasAnalogOutputSignal(final BlockState state) {
   142	      return true;
   143	   }
   144	
   145	   @Override
   146	   protected int getAnalogOutputSignal(final BlockState state, final Level level, final BlockPos pos, final Direction direction) {
   147	      return state.getValue(POSE).ordinal() + 1;
   148	   }
   149	
   150	   @Override
   151	   protected ItemStack getCloneItemStack(final LevelReader level, final BlockPos pos, final BlockState state, final boolean includeData) {
   152	      return level.getBlockEntity(pos) instanceof CopperGolemStatueBlockEntity entity
   153	         ? entity.getItem(this.asItem().getDefaultInstance(), state.getValue(POSE))
   154	         : super.getCloneItemStack(level, pos, state, includeData);
   155	   }

   160	    pub fn get_data_component<T: DataComponentImpl + 'static>(&self) -> Option<&T> {
   161	        let to_get_id = &T::get_enum();
   162	        for (id, component) in &self.patch {
   163	            if id == to_get_id {
   164	                return component
   165	                    .as_ref()
   166	                    .map(|component| get::<T>(component.as_ref()));
   167	            }
   168	        }
   169	        for (id, component) in self.item.components {
   170	            if id == to_get_id {
   171	                return Some(get::<T>(*component));
   172	            }
   173	        }
   174	        None
   175	    }
   176	    #[must_use]
   177	    pub fn get_data_component_mut<T: DataComponentImpl + 'static>(&mut self) -> Option<&mut T> {
   178	        let to_get_id = T::get_enum();
   179	        if let Some(index) = self.patch.iter().position(|(id, _)| *id == to_get_id) {
   180	            return self.patch[index]
   181	                .1
   182	                .as_mut()
   183	                .map(|component| get_mut::<T>(component.as_mut()));
   184	        }
   185	
   186	        // If not in patch, clone from item to patch and return mut
   187	        let mut cloned = None;
   188	        for (id, component) in self.item.components {
   189	            if *id == to_get_id {
   190	                cloned = Some((*id, Some(component.clone_dyn())));
   191	                break;
   192	            }
   193	        }
   194	        if let Some((id, component)) = cloned {
   195	            self.patch.push((id, component));
   196	            return self
   197	                .patch
   198	                .last_mut()?
   199	                .1
   200	                .as_mut()
   201	                .map(|c| get_mut::<T>(c.as_mut()));
   202	        }
   203	        None
   204	    }

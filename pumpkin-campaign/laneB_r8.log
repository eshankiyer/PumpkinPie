    39	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    40	        Box::pin(async move {
    41	            let mut props = SkeletonSkullLikeProperties::default(args.block);
    42	            props.rotation = args.player.get_entity().get_rotation_16();
    43	            props.powered = block_receives_redstone_power(args.world, args.position).await;
    44	            props.to_state_id(args.block)

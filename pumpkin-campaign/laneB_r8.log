   400	/// Vanilla `BucketItem#playEmptySound`: `BUCKET_EMPTY_LAVA` for lava, `BUCKET_EMPTY` otherwise,
   401	/// `SoundSource.BLOCKS`, volume 1.0, pitch 1.0. Mob buckets override it with their own sound and
   402	/// `SolidBucketItem` uses its own place sound, so neither goes through here.
   403	const fn bucket_empty_sound(item: &Item) -> Option<Sound> {
   404	    if item.id == Item::LAVA_BUCKET.id {
   405	        Some(Sound::ItemBucketEmptyLava)
   406	    } else if item.id == Item::WATER_BUCKET.id {
   407	        Some(Sound::ItemBucketEmpty)
   408	    } else {
   409	        None
   410	    }
   411	}
   412	
   413	/// Vanilla `BucketItem#use` plays `BucketPickup#getPickupSound` through `Player#playSound`, i.e.
   414	/// `SoundSource.PLAYERS`, volume 1.0, pitch 1.0, at the player, for everyone except the player.
   415	/// Sounds come from `WaterFluid#getPickupSound`, `LavaFluid#getPickupSound` and
   416	/// `PowderSnowBlock#getPickupSound`.
   417	const fn bucket_fill_sound(filled: &Item) -> Option<Sound> {
   418	    if filled.id == Item::WATER_BUCKET.id {
   419	        Some(Sound::ItemBucketFill)
   420	    } else if filled.id == Item::LAVA_BUCKET.id {
   421	        Some(Sound::ItemBucketFillLava)
   422	    } else if filled.id == Item::POWDER_SNOW_BUCKET.id {
   423	        Some(Sound::ItemBucketFillPowderSnow)
   424	    } else {
   425	        None
   426	    }
   427	}

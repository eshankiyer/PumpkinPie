   100	impl BlockBehaviour for RedstoneOreBlock {
   101	    fn attack<'a>(&'a self, args: AttackArgs<'a>) -> BlockFuture<'a, ()> {
   102	        Box::pin(async move {
   103	            Self::interact(args.world, args.position, args.block, args.state).await;
   104	        })
   105	    }
   106	
   107	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
   108	        Box::pin(async move {
   109	            let state = args.world.get_block_state(args.position);
   110	            Self::interact(args.world, args.position, args.block, state).await;
   111	            BlockActionResult::Success
   112	        })
   113	    }
   114	
   115	    fn use_with_item<'a>(
   116	        &'a self,
   117	        args: UseWithItemArgs<'a>,
   118	    ) -> BlockFuture<'a, BlockActionResult> {
   119	        Box::pin(async move {
   120	            let state = args.world.get_block_state(args.position);
   121	            Self::interact(args.world, args.position, args.block, state).await;
   122	
   123	            // RedStoneOreBlock.useItemOn lights the ore before allowing a placeable block item
   124	            // to continue through BlockItem's placement path. `BlockPlaceContext.canPlace()` only
   125	            // checks whether the clicked block or the adjacent block can be replaced.
   126	            let can_place = state.replaceable()
   127	                || args
   128	                    .world
   129	                    .get_block_state(&BlockPos::new(
   130	                        args.position.0.x + args.hit.face.to_offset().x,
   131	                        args.position.0.y + args.hit.face.to_offset().y,
   132	                        args.position.0.z + args.hit.face.to_offset().z,
   133	                    ))
   134	                    .replaceable();
   135	            if Block::from_item_id(args.item_stack.item.id).is_some() && can_place {
   136	                BlockActionResult::Pass
   137	            } else {
   138	                BlockActionResult::Success
   139	            }
   140	        })
   141	    }
   142	
   143	    fn on_entity_step<'a>(&'a self, args: OnEntityStepArgs<'a>) -> BlockFuture<'a, ()> {
   144	        Box::pin(async move {
   145	            if args.entity.get_entity().is_sneaking() {
   146	                return;
   147	            }
   148	            let state = args.world.get_block_state(args.position);
   149	            Self::interact(args.world, args.position, args.block, state).await;
   150	        })
   151	    }
   152	
   153	    fn random_tick<'a>(&'a self, args: RandomTickArgs<'a>) -> BlockFuture<'a, ()> {
   154	        Box::pin(async move {
   155	            let state = args.world.get_block_state(args.position);
   156	            let mut props = RedstoneOreLikeProperties::from_state_id(state.id, args.block);
   157	
   158	            if props.lit {
   159	                props.lit = false;
   160	                args.world
   161	                    .set_block_state(
   162	                        args.position,
   163	                        props.to_state_id(args.block),
   164	                        BlockFlags::NOTIFY_ALL,
   165	                    )
   166	                    .await;
   167	            }
   168	        })
   169	    }
   170	
   171	    fn broken<'a>(&'a self, args: BrokenArgs<'a>) -> BlockFuture<'a, ()> {
   172	        Box::pin(async move {
   173	            // RedStoneOreBlock.spawnAfterBreak awards 1..=5 XP when normal block drops are
   174	            // enabled and the break is eligible for drops. Silk Touch is handled by the vanilla
   175	            // block-experience enchantment effect and therefore suppresses this award.
   176	            if args.player.gamemode.load() == pumpkin_util::GameMode::Creative
   177	                || !args.world.level_info.load().game_rules.block_drops
   178	                || !args
   179	                    .player
   180	                    .can_harvest(args.state, Block::from_state_id(args.state.id))
   181	                    .await
   182	            {
   183	                return;
   184	            }
   185	
   186	            let tool = args.player.inventory().held_item().await;
   187	            if tool.get_enchantment_level(&pumpkin_data::Enchantment::SILK_TOUCH) > 0 {
   188	                return;
   189	            }
   190	
   191	            let amount = rand::rng().random_range(1..=5);
   192	            ExperienceOrbEntity::spawn(args.world, args.position.to_centered_f64(), amount).await;
   193	        })
   194	    }
   195	}

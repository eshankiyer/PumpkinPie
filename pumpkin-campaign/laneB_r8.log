    26	async fn ring_bell(
    27	    position: BlockPos,
    28	    world: &Arc<World>,
    29	    hit_direction: Option<HorizontalFacing>,
    30	    entity: Option<Arc<dyn crate::entity::EntityBase>>,
    31	) -> bool {
    32	    let mut event = crate::plugin::block::bell_ring::BellRingEvent {
    33	        block_pos: position,
    34	        world: world.clone(),
    35	        direction: hit_direction.map(|d| d.to_block_direction()),
    36	        entity,
    37	        cancelled: false,
    38	    };
    39	    if let Some(server) = world.server.upgrade() {
    40	        server.plugin_manager.fire(&server, &mut event).await;
    41	    }
    42	    if event.cancelled {
    43	        return false;
    44	    }
    45	
    46	    let (block, state_id) = world.get_block_and_state_id(&position);
    47	
    48	    let props = BellLikeProperties::from_state_id(state_id, block);
    49	    let direction = hit_direction.unwrap_or(props.facing);
    50	
    51	    if let Some(block_entity) = world.get_block_entity(&position)
    52	        && let Some(be) = block_entity.as_any().downcast_ref::<BellBlockEntity>()
    53	    {
    54	        be.activate(direction);
    55	    }
    56	
    57	    world.play_sound_fine(
    58	        Sound::BlockBellUse,
    59	        SoundCategory::Blocks,
    60	        &position.to_centered_f64(),
    61	        2.0,
    62	        1.0,
    63	    );
    64	
    65	    emit_game_event(
    66	        world,
    67	        GameEvent::BlockChange,
    68	        position.to_centered_f64(),
    69	        GameEventContext::none(),
    70	    )
    71	    .await;
    72	    true
    73	}

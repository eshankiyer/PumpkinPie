    23	pub(crate) async fn can_entity_walk_on_powder_snow(entity: &dyn EntityBase) -> bool {
    24	    let base = entity.get_entity();
    25	    if base
    26	        .entity_type
    27	        .has_tag(&tag::EntityType::MINECRAFT_POWDER_SNOW_WALKABLE_MOBS)
    28	    {
    29	        return true;
    30	    }
    31	
    32	    let Some(living) = entity.get_living_entity() else {
    33	        return false;
    34	    };
    35	
    36	    let equipment = living.entity_equipment.lock().await;
    37	    equipment
    38	        .equipment
    39	        .get(&EquipmentSlot::FEET)
    40	        .is_some_and(|boots| boots.item == &Item::LEATHER_BOOTS)
    41	}
    42	
    43	fn is_entity_above_block(entity: &crate::entity::Entity, position: &BlockPos) -> bool {
    44	    let bb = entity.bounding_box.load();
    45	    let block_top = f64::from(position.0.y) + 1.0;
    46	    bb.min.y >= block_top - WALK_ON_EPSILON
    47	}
    48	
    49	fn is_entity_descending(entity: &crate::entity::Entity) -> bool {
    50	    entity.velocity.load().y < 0.0
    51	}

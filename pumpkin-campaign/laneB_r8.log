    11	    /// (`CarvingMask.Mask`, `CarvingMask.java:11,18,50-52`), defaulting to `(x, y, z) -> false`.
    12	    /// Its one real caller (`Blender.addAroundOldChunksCarvingMaskFilter`,
    13	    /// `Blender.java:337-343`) feeds a noise-based distance-to-old-chunk-edge closure, not
    14	    /// another `CarvingMask`, so this is stored as a closure rather than a second bitset.
    15	    additional_mask: Option<AdditionalMaskPredicate>,
    16	}
    17	
    18	impl CarvingMask {
    19	    #[must_use]
    20	    pub fn new(height: i32, min_y: i32) -> Self {
    21	        // Each u64 stores 64 bits. Total bits needed: 16 * 16 * height.
    22	        let total_bits = 16 * 16 * height;
    23	        let num_u64s = (total_bits as usize).div_ceil(64);
    24	        Self {
    25	            min_y,
    26	            mask: vec![0; num_u64s],
    27	            additional_mask: None,
    28	        }
    29	    }
    30	
    31	    const fn get_bit_index(&self, x: i32, y: i32, z: i32) -> usize {
    32	        // x: 0..16, z: 0..16, y: min_y..min_y+height
    33	        let rel_x = x & 15;
    34	        let rel_z = z & 15;
    35	        let rel_y = y - self.min_y;
    36	        (rel_x | (rel_z << 4) | (rel_y << 8)) as usize
    37	    }

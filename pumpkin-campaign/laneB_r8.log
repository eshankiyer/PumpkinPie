   145	      this.soundTick = this.soundTick == 0 ? this.random.nextIntBetweenInclusive(1, 80) : this.soundTick - 1;
   146	      if (this.soundTick == 0) {
   147	         this.playWhirlSound();
   148	      }
   149	
   150	      super.tick();
   151	   }

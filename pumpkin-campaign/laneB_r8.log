   201	        Self {
   202	            position,
   203	            record_stack: Arc::new(Mutex::new(ItemStack::EMPTY.clone())),
   204	            ticks_since_song_started: AtomicU64::new(0),
   205	            song_length_ticks: AtomicU64::new(0),

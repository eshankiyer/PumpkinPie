   125	   @Override
   126	   protected int getDirectSignal(final BlockState state, final BlockGetter level, final BlockPos pos, final Direction direction) {
   127	      return state.getValue(POWERED) && getConnectedDirection(state) == direction ? 15 : 0;
   128	   }
   129	

   172	        self.creaking_uuid.store(uuid);
   173	    }
   174	
   175	    /// `getAnalogOutputSignal`: the value cached by the last tick, not a fresh compute.
   176	    pub fn get_analog_output_signal(&self) -> u8 {
   177	        self.output_signal.load(Ordering::Relaxed).clamp(0, 15) as u8
   178	    }
   179	
   180	    /// `computeAnalogOutputSignal`: `15 - floor(clamp(dist, 0, 32) / 32 * 15)` for a live
   181	    /// protector, else 0. Always the 0 branch until the creaking binding is implemented.
   182	    pub const fn compute_analog_output_signal(&self) -> i32 {
   183	        0
   184	    }
   185	
   186	    /// `CreakingHeartBlockEntity.isProtector`. Since `spawn_protector`/`remove_protector` (the
   187	    /// mechanics that would reassign or clear `creaking_uuid` mid-game) aren't ported yet, this
   188	    /// is exactly "is this the creaking whose UUID we're holding" -- there is no live `Creaking`
   189	    /// reference stored here to compare identity against, only the persisted UUID.
   190	    pub fn is_protector(&self, creaking_uuid: Uuid) -> bool {
   191	        self.creaking_uuid.load() == Some(creaking_uuid)
   192	    }
   193	
   194	    /// `CreakingHeartBlockEntity.removeProtector(null)`
   195	    /// (`CreakingHeartBlockEntity.java:309-327`): removal without a damage source tears down
   196	    /// the bound creaking and clears the persisted binding atomically.
   197	    pub async fn remove_protector_on_removal(&self, world: &Arc<World>) {
   198	        let Some(uuid) = self.creaking_uuid.swap(None) else {
   199	            return;
   200	        };
   201	        if let Some(entity) = world.get_entity_by_uuid(uuid)
   202	            && let Some(creaking) = entity.cast_any().downcast_ref::<CreakingEntity>()
   203	        {
   204	            creaking.tear_down().await;
   205	        }
   206	    }
   207	
   208	    /// `CreakingHeartBlockEntity.creakingHurt`. The particle/resin-spread effects this drives
   209	    /// in vanilla are deliberately not ported here (same scope cut as this file's existing
   210	    /// doc comment already calls out for `spawnProtector`/`removeProtector`/`spreadResin`);
   211	    /// only the hurt sound is played.
   212	    pub fn creaking_hurt(&self, world: &Arc<World>) {
   213	        world.play_sound(
   214	            Sound::BlockCreakingHeartHurt,
   215	            SoundCategory::Blocks,
   216	            &self.position.to_f64(),
   217	        );
   218	    }
   219	}
   220	
   221	/// `UUIDUtil.CODEC`: four big-endian ints, most-significant first.
   222	const fn uuid_from_int_array(values: &[i32]) -> Option<Uuid> {
   223	    let &[a, b, c, d] = values else { return None };
   224	    Some(Uuid::from_u128(
   225	        ((a as u32 as u128) << 96)
   226	            | ((b as u32 as u128) << 64)
   227	            | ((c as u32 as u128) << 32)
   228	            | (d as u32 as u128),
   229	    ))
   230	}
   231	
   232	fn uuid_to_int_array(u: Uuid) -> NbtTag {
   233	    let v = u.as_u128();
   234	    NbtTag::IntArray(vec![
   235	        (v >> 96) as i32,
   236	        ((v >> 64) & 0xFFFF_FFFF) as i32,
   237	        ((v >> 32) & 0xFFFF_FFFF) as i32,
   238	        (v & 0xFFFF_FFFF) as i32,
   239	    ])
   240	}

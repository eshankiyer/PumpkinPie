   687	#[cfg(test)]
   688	mod tests {
   689	    use super::*;
   690	
   691	    /// Ore experience is data-driven through `Block.experience` and `block::drop_loot`, not a
   692	    /// per-block behaviour: `DropExperienceBlock.spawnAfterBreak` (DropExperienceBlock.java:30-35)
   693	    /// samples the registered range, which `Blocks.java:367-369` gives as `UniformInt.of(0, 2)`
   694	    /// for coal ore and `Blocks.java:1261-1263` as `UniformInt.of(3, 7)` for diamond ore.
   695	    #[test]
   696	    fn ores_carry_their_vanilla_experience_range() {
   697	        use pumpkin_util::random::{RandomGenerator, xoroshiro128::Xoroshiro};
   698	
   699	        let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(1));
   700	        for (block, min, max) in [
   701	            (&Block::COAL_ORE, 0, 2),
   702	            (&Block::DEEPSLATE_COAL_ORE, 0, 2),
   703	            (&Block::DIAMOND_ORE, 3, 7),
   704	            (&Block::EMERALD_ORE, 3, 7),
   705	            (&Block::LAPIS_ORE, 2, 5),
   706	            (&Block::NETHER_QUARTZ_ORE, 2, 5),
   707	            (&Block::NETHER_GOLD_ORE, 0, 1),
   708	            (&Block::IRON_ORE, 0, 0),
   709	            (&Block::GOLD_ORE, 0, 0),
   710	            (&Block::COPPER_ORE, 0, 0),
   711	        ] {
   712	            let experience = block
   713	                .experience
   714	                .as_ref()
   715	                .unwrap_or_else(|| panic!("{} has no experience range", block.name));
   716	            for _ in 0..64 {
   717	                let amount = experience.experience.get(&mut random);
   718	                assert!(
   719	                    (min..=max).contains(&amount),
   720	                    "{} rolled {amount}, outside {min}..={max}",
   721	                    block.name
   722	                );
   723	            }
   724	        }
   725	    }
   726	}


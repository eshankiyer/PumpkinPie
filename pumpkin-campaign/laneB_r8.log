   101	        CopperGolemPose::Standing => CopperGolemPose::Sitting,
   102	        CopperGolemPose::Sitting => CopperGolemPose::Running,
   103	        CopperGolemPose::Running => CopperGolemPose::Star,
   104	        CopperGolemPose::Star => CopperGolemPose::Standing,
   105	    }

   353	/// Vanilla `RedstoneTorchBlock.RECENT_TOGGLES`: a per-level FIFO of recent (pos, tick) toggles,
   354	/// used to detect a torch flipping state 8+ times within 60 ticks and force a burnout lockout.
   355	#[derive(Default)]
   356	pub struct RecentToggles {
   357	    toggles: Vec<(BlockPos, i64)>,
   358	}
   359	
   360	impl RecentToggles {
   361	    const RECENT_TOGGLE_TIMER: i64 = 60;
   362	    const MAX_RECENT_TOGGLES: usize = 8;
   363	
   364	    pub fn prune(&mut self, now: i64) {
   365	        while let Some(&(_, when)) = self.toggles.first() {
   366	            if now - when > Self::RECENT_TOGGLE_TIMER {
   367	                self.toggles.remove(0);
   368	            } else {
   369	                break;
   370	            }
   371	        }
   372	    }
   373	
   374	    pub fn is_toggled_too_frequently(&mut self, pos: BlockPos, now: i64, add: bool) -> bool {
   375	        if add {
   376	            self.toggles.push((pos, now));
   377	        }
   378	
   379	        let mut count = 0;
   380	        for &(toggle_pos, _) in &self.toggles {
   381	            if toggle_pos == pos {
   382	                count += 1;
   383	                if count >= Self::MAX_RECENT_TOGGLES {
   384	                    return true;
   385	                }
   386	            }
   387	        }
   388	        false
   389	    }
   390	}


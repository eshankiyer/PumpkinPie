   172	impl ShulkerBoxBlockEntity {
   173	    pub const INVENTORY_SIZE: usize = 27;
   174	    pub const OPEN_ANIMATION_EVENT_TYPE: u8 = 1;
   175	    pub const ID: &'static str = "minecraft:shulker_box";
   176	
   177	    #[must_use]
   178	    pub fn new(position: BlockPos) -> Self {
   179	        Self {
   180	            position,
   181	            items: RwLock::new(from_fn(|_| ItemStack::EMPTY.clone())),
   182	            dirty: AtomicBool::new(false),
   183	            animation_status: AtomicU8::new(AnimationStatus::Closed as u8),
   184	            animation_ticks: AtomicU8::new(0),
   185	            viewers: ViewerCountTracker::new(),
   186	        }
   187	    }
   188	
   189	    /// `ShulkerBoxBlockEntity.getAnimationStatus` (`ShulkerBoxBlockEntity.java:103-105`) is
   190	    /// consulted by the live `ShulkerBoxBlock.normal_use` path before opening another menu.
   191	    #[must_use]
   192	    pub fn get_animation_status(&self) -> AnimationStatus {
   193	        let status = match self.animation_status.load(Ordering::Relaxed) {
   194	            value if value == AnimationStatus::Opening as u8 => AnimationStatus::Opening,
   195	            value if value == AnimationStatus::Opened as u8 => AnimationStatus::Opened,
   196	            value if value == AnimationStatus::Closing as u8 => AnimationStatus::Closing,
   197	            _ => AnimationStatus::Closed,
   198	        };
   199	
   200	        if status == AnimationStatus::Closed && self.viewers.get_viewer_count() > 0 {
   201	            AnimationStatus::Opening
   202	        } else {
   203	            status
   204	        }
   205	    }
   206	
   207	    fn tick_animation(&self) {
   208	        let status = self.animation_status.load(Ordering::Relaxed);
   209	        if status != AnimationStatus::Opening as u8 && status != AnimationStatus::Closing as u8 {
   210	            return;
   211	        }
   212	
   213	        let ticks = self.animation_ticks.fetch_add(1, Ordering::Relaxed) + 1;
   214	        if ticks < 10 {
   215	            return;
   216	        }
   217	
   218	        self.animation_status.store(
   219	            if status == AnimationStatus::Opening as u8 {
   220	                AnimationStatus::Opened as u8
   221	            } else {
   222	                AnimationStatus::Closed as u8
   223	            },
   224	            Ordering::Relaxed,
   225	        );
   226	        self.animation_ticks.store(0, Ordering::Relaxed);
   227	    }
   228	
   229	    pub fn update_viewers(&self, world: &Arc<World>) {
   230	        let viewer_count = self.viewers.current.load(Ordering::Relaxed);
   231	        Self::play_sound(world, &self.position, i32::from(viewer_count));
   232	    }
   233	
   234	    fn play_sound(world: &World, position: &BlockPos, viewer_count: i32) {
   235	        let sound = if viewer_count > 0 {
   236	            Sound::BlockShulkerBoxOpen
   237	        } else {
   238	            Sound::BlockShulkerBoxClose
   239	        };
   240	
   241	        world.play_sound(sound, SoundCategory::Blocks, &position.to_f64());
   242	    }
   243	}

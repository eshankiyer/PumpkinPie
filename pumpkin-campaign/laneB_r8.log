     7	pub struct SkullBlockEntity {
     8	    pub position: BlockPos,
     9	    pub note_block_sound: Mutex<Option<String>>,
    10	    pub profile: Mutex<Option<NbtCompound>>,
    11	    /// `SkullBlockEntity.customName` (`SkullBlockEntity.java:29`), saved under `custom_name`
    12	    /// (`SkullBlockEntity.java:40`) as a serialized text component. Held as the raw JSON
    13	    /// string so it round-trips unchanged.
    14	    pub custom_name: Mutex<Option<String>>,
    15	}
    16	
    17	impl BlockEntity for SkullBlockEntity {
    18	    fn resource_location(&self) -> &'static str {
    19	        Self::ID
    20	    }
    21	
    22	    fn get_position(&self) -> BlockPos {
    23	        self.position
    24	    }
    25	
    26	    fn from_nbt(nbt: &pumpkin_nbt::compound::NbtCompound, position: BlockPos) -> Self
    27	    where
    28	        Self: Sized,
    29	    {
    30	        let note_block_sound = nbt.get_string("note_block_sound").map(ToString::to_string);
    31	        let profile = nbt.get_compound("profile").cloned();
    32	        let custom_name = nbt.get_string("custom_name").map(ToString::to_string);
    33	        Self {
    34	            position,
    35	            note_block_sound: Mutex::new(note_block_sound),
    36	            profile: Mutex::new(profile),
    37	            custom_name: Mutex::new(custom_name),
    38	        }
    39	    }
    40	
    41	    fn write_nbt<'a>(
    42	        &'a self,
    43	        nbt: &'a mut NbtCompound,
    44	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    45	        Box::pin(async move {
    46	            if let Some(sound) = self.note_block_sound.lock().await.as_ref() {
    47	                nbt.put_string("note_block_sound", sound.clone());
    48	            }
    49	            if let Some(prof) = self.profile.lock().await.as_ref() {
    50	                nbt.put_compound("profile", prof.clone());
    51	            }
    52	            if let Some(name) = self.custom_name.lock().await.as_ref() {
    53	                nbt.put_string("custom_name", name.clone());
    54	            }
    55	        })
    56	    }
    57	
    58	    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
    59	        let mut nbt = NbtCompound::new();
    60	        if let Ok(sound) = self.note_block_sound.try_lock()
    61	            && let Some(ref sound) = *sound
    62	        {
    63	            nbt.put_string("note_block_sound", sound.clone());
    64	        }
    65	        if let Ok(profile) = self.profile.try_lock()
    66	            && let Some(ref prof) = *profile
    67	        {
    68	            nbt.put_compound("profile", prof.clone());
    69	        }
    70	        if let Ok(name) = self.custom_name.try_lock()
    71	            && let Some(ref name) = *name
    72	        {
    73	            nbt.put_string("custom_name", name.clone());
    74	        }
    75	        Some(nbt)
    76	    }
    77	
    78	    fn as_any(&self) -> &dyn std::any::Any {
    79	        self
    80	    }
    81	}

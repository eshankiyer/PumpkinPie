     9	
    10	const GENERATION_STAGES: [StagedChunkEnum; 10] = [
    11	    StagedChunkEnum::Biomes,
    12	    StagedChunkEnum::StructureStart,
    13	    StagedChunkEnum::StructureReferences,
    14	    StagedChunkEnum::Noise,
    15	    StagedChunkEnum::Surface,
    16	    StagedChunkEnum::Carvers,
    17	    StagedChunkEnum::Features,
    18	    StagedChunkEnum::Lighting,
    19	    StagedChunkEnum::Spawn,
    20	    StagedChunkEnum::Full,
    21	];
    22	
    23	pub fn generate_single_chunk(
    24	    dimension: &Dimension,
    25	    biome_mixer_seed: i64,
    26	    generator: &WorldGenerator,
    27	    block_registry: &dyn WorldPortalExt,
    28	    chunk_x: i32,
    29	    chunk_z: i32,
    30	    target_stage: StagedChunkEnum,
    31	) -> Chunk {
    32	    // Every stage up to the target runs inside this one cache, so it has to be wide enough for
    33	    // the widest of them, not just the target's own radius. Surface, for instance, needs a ring
    34	    // even when the caller asks for Carvers.
    35	    let mut radius = 0;
    36	    for stage in GENERATION_STAGES {
    37	        if (stage as u8) > (target_stage as u8) {
    38	            break;
    39	        }
    40	        radius = radius.max(stage.get_direct_radius());
    41	    }
    42	
    43	    generate_single_chunk_with_radius(
    44	        dimension,
    45	        biome_mixer_seed,
    46	        generator,
    47	        block_registry,
    48	        chunk_x,
    49	        chunk_z,
    50	        target_stage,
    51	        radius,
    52	    )
    53	}
    54	
    55	#[expect(clippy::too_many_arguments)]
    56	pub fn generate_single_chunk_with_radius(
    57	    _dimension: &Dimension,
    58	    _biome_mixer_seed: i64,
    59	    generator: &WorldGenerator,
    60	    block_registry: &dyn WorldPortalExt,
    61	    chunk_x: i32,
    62	    chunk_z: i32,
    63	    target_stage: StagedChunkEnum,
    64	    radius: i32,
    65	) -> Chunk {
    66	    let mut cache = Cache::new(chunk_x - radius, chunk_z - radius, radius * 2 + 1);
    67	
    68	    for dx in -radius..=radius {
    69	        for dz in -radius..=radius {
    70	            let new_x = chunk_x + dx;
    71	            let new_z = chunk_z + dz;
    72	
    73	            let proto_chunk = Box::new(ProtoChunk::new(new_x, new_z, generator));
    74	
    75	            cache.chunks.push(Chunk::Proto(proto_chunk));
    76	        }
    77	    }
    78	
    79	    for &stage in &GENERATION_STAGES {
    80	        if stage as u8 > target_stage as u8 {
    81	            break;
    82	        }
    83	
    84	        if matches!(
    85	            stage,
    86	            StagedChunkEnum::Biomes
    87	                | StagedChunkEnum::StructureStart
    88	                | StagedChunkEnum::StructureReferences
    89	        ) {
    90	            cache.advance_all(
    91	                stage,
    92	                generator,
    93	                block_registry,
    94	                &LightingEngineConfig::Default,
    95	            );
    96	        } else {
    97	            cache.advance(
    98	                stage,
    99	                generator,
   100	                block_registry,
   101	                &LightingEngineConfig::Default,
   102	            );
   103	        }
   104	    }
   105	
   106	    let mid = ((cache.size * cache.size) >> 1) as usize;
   107	    cache.chunks.swap_remove(mid)
   108	}

   109	    pub async fn update_state(
   110	        &self,
   111	        mut properties: ChiseledBookshelfLikeProperties,
   112	        world: Arc<World>,
   113	        slot: usize,
   114	    ) {
   115	        if (0..Self::INVENTORY_SIZE).contains(&slot) {
   116	            self.last_interacted_slot
   117	                .store(slot as i8, Ordering::Relaxed);
   118	            self.mark_dirty();
   119	
   120	            let occupied = !self.get_stack(slot).await.is_empty();
   121	            match slot {
   122	                0 => properties.slot_0_occupied = occupied,
   123	                1 => properties.slot_1_occupied = occupied,
   124	                2 => properties.slot_2_occupied = occupied,
   125	                3 => properties.slot_3_occupied = occupied,
   126	                4 => properties.slot_4_occupied = occupied,
   127	                5 => properties.slot_5_occupied = occupied,
   128	                _ => {}
   129	            }
   130	
   131	            world
   132	                .set_block_state(
   133	                    &self.position,
   134	                    properties.to_state_id(&Block::CHISELED_BOOKSHELF),
   135	                    BlockFlags::NOTIFY_LISTENERS,
   136	                )
   137	                .await;
   138	        } else {
   139	            warn!(
   140	                "Invalid interacted slot: {} for chiseled bookshelf at position {:?}",
   141	                slot, self.position
   142	            );

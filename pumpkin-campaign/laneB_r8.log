    pub const fn static_new_java(item_count: u8, item: &'static Item) -> Self {
        Self {
            item_count,
            item,
            patch: Vec::new(),

            uid: match NonZero::new(1) {
                Some(v) => v,
                None => panic!("1 is non-zero"),
            },
        }
    }

    #[must_use]

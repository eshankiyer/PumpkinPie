+        let center_z = center.z;
+        let mut old_chunks = Vec::new();
+
+        if let Some(data) = &center.blending_data {
+            let radius_y = (data.max_y - data.min_y) as f64 / 2.0;
+            old_chunks.push((0.0, 0.0, data.min_y as f64 + radius_y, radius_y));
+        }

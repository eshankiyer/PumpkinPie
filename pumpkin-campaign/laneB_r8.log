    42	
    43	    /// `doTick` (`NearestItemSensor.java:24-34`): collect item entities in an inflated box,
    44	    /// sort by squared distance, keep the first that the mob wants, is within 32 blocks, and
    45	    /// has line of sight to; write it into `NEAREST_VISIBLE_WANTED_ITEM`.
    46	    fn do_tick<'a>(&'a mut self, mob: &'a dyn Mob, brain: &'a Brain) -> SensorFuture<'a> {
    47	        Box::pin(async move {
    48	            let mob_entity = mob.get_mob_entity();
    49	            let entity = &mob_entity.living_entity.entity;
    50	            let mob_pos = entity.pos.load();
    51	            let world = entity.world.load();
    52	
    53	            let search_box = entity
    54	                .bounding_box
    55	                .load()
    56	                .expand(XZ_RANGE, Y_RANGE, XZ_RANGE);
    57	            let mut candidates: Vec<(f64, Arc<dyn EntityBase>)> = world
    58	                .get_entities_at_box(&search_box)
    59	                .into_iter()
    60	                .filter_map(|candidate| {
    61	                    let candidate_pos = candidate.get_entity().pos.load();
    62	                    let distance = candidate_pos.squared_distance_to_vec(&mob_pos);
    63	                    (distance < MAX_DISTANCE_TO_WANTED_ITEM * MAX_DISTANCE_TO_WANTED_ITEM)
    64	                        .then_some((distance, candidate))
    65	                })
    66	                .collect();
    67	            candidates.sort_by(|a, b| a.0.total_cmp(&b.0));
    68	
    69	            let mut nearest: Option<Arc<dyn EntityBase>> = None;
    70	            for (_, candidate) in candidates {
    71	                let Some(item_entity) = candidate.clone().get_item_entity() else {
    72	                    continue;
    73	                };
    74	                // The item-stack guard is a tokio mutex, so clone the stack out and drop the
    75	                // guard before touching the brain's std mutex.
    76	                let stack = item_entity.get_item_stack().lock().await.clone();
    77	                if !mob.wants_to_pick_up_item(&world, &stack) {
    78	                    continue;
    79	                }
    80	
    81	                let has_line_of_sight = world
    82	                    .raycast_collision(
    83	                        entity.get_eye_pos(),
    84	                        candidate.get_eye_pos(),
    85	                        async |block_pos, world| {
    86	                            !world.get_block_state(block_pos).collision_shapes.is_empty()
    87	                        },
    88	                    )
    89	                    .await
    90	                    .is_none();
    91	                if has_line_of_sight {
    92	                    nearest = Some(candidate);
    93	                    break;
    94	                }
    95	            }
    96	
    97	            match nearest {
    98	                Some(item) => {
    99	                    brain.set::<NearestVisibleWantedItemMemory>(Arc::downgrade(&item));
   100	                }
   101	                None => brain.erase::<NearestVisibleWantedItemMemory>(),
   102	            }
   103	        })
   104	    }
   105	}

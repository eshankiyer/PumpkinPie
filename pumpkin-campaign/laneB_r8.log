    10	const GENERATION_STAGES: [StagedChunkEnum; 10] = [
    11	    StagedChunkEnum::Biomes,
    12	    StagedChunkEnum::StructureStart,
    13	    StagedChunkEnum::StructureReferences,
    14	    StagedChunkEnum::Noise,

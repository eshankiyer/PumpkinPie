+                let outside_y = delta_y.max(0.0);
+                let outside_z = delta_z.max(0.0);
+                (outside_x * outside_x + outside_y * outside_y + outside_z * outside_z).sqrt()
+                    < 4.0
+            },
+        )
+    }
+}

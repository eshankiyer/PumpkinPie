    67	        // `targeter instanceof Mob mob && !mob.getSensing().hasLineOfSight(target)`
    68	        // (`TargetingConditions.java:91-93`); sensors only run on mobs.
    69	        mob_entity.has_line_of_sight(candidate.as_ref()).await
    70	    }

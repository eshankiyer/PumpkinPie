   116	   private boolean isProperHit(final BlockState state, final Direction clickedDirection, final double clickY) {
   117	      if (clickedDirection.getAxis() != Direction.Axis.Y && !(clickY > 0.8124F)) {
   118	         Direction facing = state.getValue(FACING);
   119	         BellAttachType attachType = state.getValue(ATTACHMENT);
   120	
   121	         return switch (attachType) {
   122	            case FLOOR -> facing.getAxis() == clickedDirection.getAxis();
   123	            case SINGLE_WALL, DOUBLE_WALL -> facing.getAxis() != clickedDirection.getAxis();
   124	            case CEILING -> true;
   125	            default -> false;
   126	         };
   127	      } else {
   128	         return false;
   129	      }
   130	   }

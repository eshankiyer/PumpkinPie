   528	   @Override
   529	   public void handleAcceptTeleportPacket(final ServerboundAcceptTeleportationPacket packet) {
   530	      PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
   531	      if (packet.getId() == this.awaitingTeleport) {
   532	         if (this.awaitingPositionFromClient == null) {
   533	            this.disconnect(Component.translatable("multiplayer.disconnect.invalid_player_movement"));
   534	            return;
   535	         }
   536	
   537	         this.player
   538	            .absSnapTo(
   539	               this.awaitingPositionFromClient.x,
   540	               this.awaitingPositionFromClient.y,
   541	               this.awaitingPositionFromClient.z,
   542	               this.player.getYRot(),
   543	               this.player.getXRot()
   544	            );
   545	         this.lastGoodX = this.awaitingPositionFromClient.x;
   546	         this.lastGoodY = this.awaitingPositionFromClient.y;
   547	         this.lastGoodZ = this.awaitingPositionFromClient.z;
   548	         this.player.hasChangedDimension();
   549	         this.awaitingPositionFromClient = null;
   550	      }
   551	   }

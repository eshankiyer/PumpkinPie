+    fn old_chunk_carving_filter_rejects_distant_positions() {
+        let filter = old_chunk_carving_mask_filter(vec![(0.0, 0.0, 8.0, 8.0)]);
+
+        assert!(!filter(100, 8, 8));
+    }
+}

   220	   @Override
   221	   protected BlockState updateShape(
   222	      final BlockState state,
   223	      final LevelReader level,
   224	      final ScheduledTickAccess ticks,
   225	      final BlockPos pos,
   226	      final Direction directionToNeighbour,
   227	      final BlockPos neighbourPos,
   228	      final BlockState neighbourState,
   229	      final RandomSource random
   230	   ) {
   231	      BellAttachType attachment = state.getValue(ATTACHMENT);
   232	      Direction connectedDirection = getConnectedDirection(state).getOpposite();
   233	      if (connectedDirection == directionToNeighbour && !state.canSurvive(level, pos) && attachment != BellAttachType.DOUBLE_WALL) {
   234	         return Blocks.AIR.defaultBlockState();
   235	      }
   236	
   237	      if (directionToNeighbour.getAxis() == state.getValue(FACING).getAxis()) {
   238	         if (attachment == BellAttachType.DOUBLE_WALL && !neighbourState.isFaceSturdy(level, neighbourPos, directionToNeighbour)) {
   239	            return state.setValue(ATTACHMENT, BellAttachType.SINGLE_WALL).setValue(FACING, directionToNeighbour.getOpposite());
   240	         }
   241	
   242	         if (attachment == BellAttachType.SINGLE_WALL
   243	            && connectedDirection.getOpposite() == directionToNeighbour
   244	            && neighbourState.isFaceSturdy(level, neighbourPos, state.getValue(FACING))) {
   245	            return state.setValue(ATTACHMENT, BellAttachType.DOUBLE_WALL);
   246	         }
   247	      }
   248	
   249	      return super.updateShape(state, level, ticks, pos, directionToNeighbour, neighbourPos, neighbourState, random);
   250	   }

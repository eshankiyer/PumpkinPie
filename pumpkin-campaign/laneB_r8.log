    22	        let status = if version >= &JavaMinecraftVersion::V_1_9 {
    23	            bytebuf.get_var_int()?
    24	        } else {
    25	            VarInt(i32::from(bytebuf.get_u8()?))
    26	        };
    27	        let position = bytebuf.get_block_pos(version)?;
    28	        let face = bytebuf.get_u8()?;
    29	        let sequence = if version >= &JavaMinecraftVersion::V_1_19 {
    30	            bytebuf.get_var_int()?
    31	        } else {
    32	            VarInt(0)
    33	        };
    34	
    35	        Ok(Self {
    36	            status,
    37	            position,
    38	            face,
    39	            sequence,
    40	        })
    41	    }

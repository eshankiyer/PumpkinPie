   134	    /// `LongJump.calculateOptimalJumpVector`: tries each allowed launch angle (shuffled)
   135	    /// until one produces a valid ballistic solution under `max_jump_velocity`.
   136	    fn calculate_optimal_jump_vector(
   137	        mob_pos: Vector3<f64>,
   138	        target_pos: Vector3<f64>,
   139	        gravity: f64,
   140	        follow_range: f64,
   141	        random: &mut RandomGenerator,
   142	    ) -> Option<Vector3<f64>> {
   143	        let mut angles = ALLOWED_ANGLES;
   144	        // Fisher-Yates, matching `Util.shuffledCopy`'s effect of trying every angle in a
   145	        // random order.
   146	        for i in (1..angles.len()).rev() {
   147	            let j = (random.next_f32() * (i + 1) as f32) as usize;
   148	            angles.swap(i, j.min(i));
   149	        }
   150	
   151	        let max_jump_velocity = MAX_JUMP_VELOCITY_MULTIPLIER * follow_range;
   152	        for angle in angles {
   153	            if let Some(v) = calculate_jump_vector_for_angle(
   154	                mob_pos,
   155	                target_pos,
   156	                gravity,
   157	                max_jump_velocity,
   158	                angle,
   159	            ) {
   160	                return Some(v);
   161	            }
   162	        }
   163	        None
   164	    }
   165	}
   166	
   167	/// Port of `LongJumpUtil.calculateJumpVectorForAngle` with `checkCollision = false`.
   168	///
   169	/// This is the only mode the breeze ever uses - a closed-form ballistic-arc solve with
   170	/// no world access, so it is unit-testable in isolation.
   171	#[must_use]
   172	pub fn calculate_jump_vector_for_angle(
   173	    mob_pos: Vector3<f64>,
   174	    target_pos: Vector3<f64>,
   175	    gravity: f64,
   176	    max_jump_velocity: f64,
   177	    angle_deg: i32,
   178	) -> Option<Vector3<f64>> {
   179	    let direction_plane = Vector3::new(target_pos.x - mob_pos.x, 0.0, target_pos.z - mob_pos.z)
   180	        .normalize()
   181	        .multiply(0.5, 0.5, 0.5);
   182	    let aim_point = target_pos.sub(&direction_plane);
   183	    let direction = aim_point.sub(&mob_pos);
   184	
   185	    let angle_rad = f64::from(angle_deg) * std::f64::consts::PI / 180.0;
   186	    let xz_angle = direction.z.atan2(direction.x);
   187	    let r2 = direction.horizontal_length_squared();
   188	    let r = r2.sqrt();
   189	    let y = direction.y;
   190	
   191	    let sin_2ang = (2.0 * angle_rad).sin();
   192	    let cos_ang_sqr = angle_rad.cos().powi(2);
   193	    let sin_ang = angle_rad.sin();
   194	    let cos_ang = angle_rad.cos();
   195	
   196	    let v0_sqr = r2 * gravity / (r * sin_2ang - 2.0 * y * cos_ang_sqr);
   197	    if v0_sqr < 0.0 {
   198	        return None;
   199	    }
   200	    let v0 = v0_sqr.sqrt();
   201	    if v0 > max_jump_velocity {
   202	        return None;
   203	    }
   204	
   205	    let v0_r = v0 * cos_ang;
   206	    let v0_y = v0 * sin_ang;
   207	    Some(
   208	        Vector3::new(v0_r * xz_angle.cos(), v0_y, v0_r * xz_angle.sin()).multiply(0.95, 0.95, 0.95),
   209	    )
   210	}

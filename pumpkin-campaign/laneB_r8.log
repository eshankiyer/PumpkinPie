   254	    /// Start playing a song with the given length in ticks
   255	    pub fn start_playing(&self, length_in_ticks: u64) {
   256	        self.ticks_since_song_started.store(0, Ordering::Relaxed);
   257	        self.song_length_ticks
   258	            .store(length_in_ticks, Ordering::Relaxed);
   259	        self.mark_dirty();
   260	    }
   261	
   262	    /// Stop playing the current song
   263	    pub fn stop_playing(&self) {
   264	        self.ticks_since_song_started.store(0, Ordering::Relaxed);
   265	        self.song_length_ticks.store(0, Ordering::Relaxed);
   266	        self.mark_dirty();
   267	    }
   268	
   269	    /// Check if a song is currently playing
   270	    pub fn is_playing(&self) -> bool {
   271	        let song_length = self.song_length_ticks.load(Ordering::Relaxed);
   272	        if song_length == 0 {
   273	            return false;
   274	        }
   275	        let ticks = self.ticks_since_song_started.load(Ordering::Relaxed);
   276	        ticks < song_length + SONG_END_PADDING_TICKS
   277	    }

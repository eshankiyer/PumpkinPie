   328	    pub async fn has_line_of_sight(&self, target: &dyn EntityBase) -> bool {
   329	        let target_id = target.get_entity().entity_id;
   330	        {
   331	            let sensing = self.sensing.lock().unwrap();
   332	            if sensing.seen.contains(&target_id) {
   333	                return true;
   334	            }
   335	            if sensing.unseen.contains(&target_id) {
   336	                return false;
   337	            }
   338	        }
   339	
   340	        let entity = &self.living_entity.entity;
   341	        let target_entity = target.get_entity();
   342	        let from = entity.get_eye_pos();
   343	        let to = target_entity.get_eye_pos();
   344	        let has_line_of_sight = if from.squared_distance_to_vec(&to) > 128.0 * 128.0 {
   345	            false
   346	        } else {
   347	            let world = entity.world.load_full();
   348	            Arc::ptr_eq(&world, &target_entity.world.load_full())
   349	                && world
   350	                    .raycast_collision(from, to, async |block_pos, world| {
   351	                        !world.get_block_state(block_pos).collision_shapes.is_empty()
   352	                    })
   353	                    .await
   354	                    .is_none()
   355	        };
   356	
   357	        let mut sensing = self.sensing.lock().unwrap();
   358	        if has_line_of_sight {
   359	            sensing.seen.insert(target_id);
   360	        } else {
   361	            sensing.unseen.insert(target_id);
   362	        }
   363	        has_line_of_sight
   364	    }

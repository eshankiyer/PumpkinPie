+                    .get_chunk(center_x + offset_x, center_z + offset_z)
+                    .and_then(|chunk| chunk.blending_data.as_ref())
+                {
+                    let radius_y = (data.max_y - data.min_y) as f64 / 2.0;
+                    old_chunks.push((
+                        offset_x as f64 * 16.0,
+                        offset_z as f64 * 16.0,
+                        data.min_y as f64 + radius_y,
+                        radius_y,
+                    ));
+                }
+            }

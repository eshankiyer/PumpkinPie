+        .get_list("Items")?
+        .iter()
+        .filter_map(|tag| {
+            let item = tag.extract_compound()?;
+            let slot = item.get_byte("Slot")? as u8;
+            Some((slot, ItemStack::read_item_stack(item)?))
+        })
+        .collect();
+    Some(ContainerImpl { items })

   287	
   288	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   289	        Box::pin(async move {
   290	            update_neighbors(args.world, args.position).await;
   291	        })
   292	    }
   293	
   294	    fn on_state_replaced<'a>(&'a self, args: OnStateReplacedArgs<'a>) -> BlockFuture<'a, ()> {
   295	        Box::pin(async move {
   296	            update_neighbors(args.world, args.position).await;
   297	        })
   298	    }
   299	}
   300	
   301	pub async fn should_be_lit(world: &World, pos: &BlockPos, face: BlockDirection) -> bool {
   302	    let other_pos = pos.offset(face.to_offset());
   303	    let (block, state) = world.get_block_and_state(&other_pos);
   304	    get_redstone_power(block, state, world, &other_pos, face).await == 0
   305	}
   306	
   307	pub async fn update_neighbors(world: &Arc<World>, pos: &BlockPos) {
   308	    for dir in BlockDirection::all() {
   309	        let other_pos = pos.offset(dir.to_offset());
   310	        world.update_neighbors(&other_pos, None).await;
   311	    }
   312	}
   313	
   314	fn can_place_at(world: &dyn BlockAccessor, block_pos: &BlockPos, facing: BlockDirection) -> bool {
   315	    world
   316	        .get_block_state(&block_pos.offset(facing.to_offset()))
   317	        .is_side_solid(facing.opposite())
   318	}
   319	
   320	async fn handle_torch_tick(
   321	    world: &Arc<World>,
   322	    pos: &BlockPos,
   323	    block: &Block,
   324	    lit: &mut bool,
   325	    neighbor_signal: bool,
   326	    now: i64,
   327	) -> bool {
   328	    if *lit {
   329	        if neighbor_signal {
   330	            *lit = false;
   331	            if world
   332	                .is_redstone_torch_toggled_too_frequently(*pos, now, true)
   333	                .await
   334	            {
   335	                world.sync_world_event(WorldEvent::RedstoneTorchBurnout, *pos, 0);
   336	                world.schedule_block_tick(block, *pos, 160, TickPriority::Normal);
   337	            }
   338	            return true;
   339	        }
   340	        false


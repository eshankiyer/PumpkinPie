    76	    /// `CreakingHeartBlockEntity.serverTick`, minus the protector spawn/upkeep branch.
    77	    /// Vanilla's `CreakingHeartBlock.getTicker` returns null while the heart is UPROOTED,
    78	    /// so an uprooted heart does not tick here either.
    79	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    80	        Box::pin(async move {
    81	            let (block, state) = world.get_block_and_state(&self.position);
    82	            if block.id != Block::CREAKING_HEART.id {
    83	                return;
    84	            }
    85	            let mut props = CreakingHeartLikeProperties::from_state_id(state.id, block);
    86	            if props.creaking_heart_state == CreakingHeartState::Uprooted {
    87	                return;
    88	            }
    89	
    90	            let computed = self.compute_analog_output_signal();
    91	            if self.output_signal.swap(computed, Ordering::Relaxed) != computed {
    92	                world.update_comparators(&self.position, block).await;
    93	            }
    94	
    95	            // `if (entity.ticker-- < 0)`: post-decrement, so the body runs on the tick the
    96	            // pre-decrement value is negative. Reseeds to `nextInt(5) + 20`.
    97	            if self.ticker.fetch_sub(1, Ordering::Relaxed) >= 0 {
    98	                return;
    99	            }
   100	            self.ticker
   101	                .store(20 + rand::rng().random_range(0..5), Ordering::Relaxed);
   102	
   103	            // updateCreakingState: an uprooted-eligible heart (no logs, no bound creaking)
   104	            // goes UPROOTED, otherwise it tracks the creaking_active environment attribute.
   105	            let new_state = if has_required_logs(world, &self.position, props.axis)
   106	                || self.creaking_uuid.load().is_some()
   107	            {
   108	                if creaking_active(world).await {
   109	                    CreakingHeartState::Awake
   110	                } else {
   111	                    CreakingHeartState::Dormant
   112	                }
   113	            } else {
   114	                CreakingHeartState::Uprooted
   115	            };
   116	
   117	            if new_state != props.creaking_heart_state {
   118	                props.creaking_heart_state = new_state;
   119	                world
   120	                    .set_block_state(
   121	                        &self.position,
   122	                        props.to_state_id(block),
   123	                        BlockFlags::NOTIFY_ALL,
   124	                    )
   125	                    .await;
   126	            }
   127	        })
   128	    }

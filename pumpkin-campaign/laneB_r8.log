   607	   @Override
   608	   public void handleSetCommandBlock(final ServerboundSetCommandBlockPacket packet) {
   609	      PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
   610	      if (!this.player.canUseGameMasterBlocks()) {
   611	         this.player.sendSystemMessage(Component.translatable("advMode.notAllowed"));
   612	      } else {
   613	         BaseCommandBlock commandBlock = null;
   614	         CommandBlockEntity autoCommandBlock = null;
   615	         BlockPos blockPos = packet.getPos();
   616	         BlockEntity blockEntity = this.player.level().getBlockEntity(blockPos);
   617	         if (blockEntity instanceof CommandBlockEntity commandBlockEntity) {
   618	            autoCommandBlock = commandBlockEntity;
   619	            commandBlock = autoCommandBlock.getCommandBlock();
   620	         }
   621	
   622	         String command = packet.getCommand();
   623	         boolean trackOutput = packet.isTrackOutput();
   624	         if (commandBlock != null) {
   625	            CommandBlockEntity.Mode oldMode = autoCommandBlock.getMode();
   626	            BlockState currentBlockState = this.player.level().getBlockState(blockPos);
   627	            Direction direction = currentBlockState.getValue(CommandBlock.FACING);
   628	
   629	            BlockState baseBlockState = switch (packet.getMode()) {
   630	               case SEQUENCE -> Blocks.CHAIN_COMMAND_BLOCK.defaultBlockState();
   631	               case AUTO -> Blocks.REPEATING_COMMAND_BLOCK.defaultBlockState();
   632	               default -> Blocks.COMMAND_BLOCK.defaultBlockState();
   633	            };
   634	            BlockState blockState = baseBlockState.setValue(CommandBlock.FACING, direction).setValue(CommandBlock.CONDITIONAL, packet.isConditional());
   635	            if (blockState != currentBlockState) {
   636	               this.player.level().setBlock(blockPos, blockState, 2);
   637	               blockEntity.setBlockState(blockState);
   638	               this.player.level().getChunkAt(blockPos).setBlockEntity(blockEntity);
   639	            }
   640	
   641	            commandBlock.setCommand(command);
   642	            commandBlock.setTrackOutput(trackOutput);
   643	            if (!trackOutput) {
   644	               commandBlock.setLastOutput(null);
   645	            }
   646	
   647	            autoCommandBlock.setAutomatic(packet.isAutomatic());
   648	            if (oldMode != packet.getMode()) {
   649	               autoCommandBlock.onModeSwitch();
   650	            }
   651	
   652	            if (this.player.level().isCommandBlockEnabled()) {
   653	               commandBlock.onUpdated(this.player.level());
   654	            }
   655	
   656	            if (!StringUtil.isNullOrEmpty(command)) {
   657	               this.player
   658	                  .sendSystemMessage(
   659	                     Component.translatable(this.player.level().isCommandBlockEnabled() ? "advMode.setCommand.success" : "advMode.setCommand.disabled", command)
   660	                  );
   661	            }
   662	         }
   663	      }
   664	   }

    60	        // `LivingEntity.getVisibilityPercent`, LivingEntity.java:919-946).
    61	        let modifier = Self::visibility_percent(observer_type, candidate).await;
    62	        let visibility_distance = (follow_range * modifier).max(2.0);
    63	        if distance_sq > visibility_distance * visibility_distance {
    64	            return false;
    65	        }

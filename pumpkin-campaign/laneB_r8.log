   335	    /// Vanilla `JukeboxBlockEntity.canPlaceItem` (JukeboxBlockEntity.java:143-145):
   336	    /// hoppers may insert only a playable record, and only into the empty slot.
   337	    fn can_place_item<'a>(
   338	        &'a self,
   339	        slot: usize,
   340	        stack: &'a ItemStack,
   341	    ) -> InventoryFuture<'a, bool> {
   342	        Box::pin(async move {
   343	            slot == 0
   344	                && stack.get_data_component::<JukeboxPlayableImpl>().is_some()
   345	                && self.record_stack.lock().await.is_empty()
   346	        })

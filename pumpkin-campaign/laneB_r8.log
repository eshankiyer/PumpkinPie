   110	                .entity_equipment
   111	                .lock()
   112	                .await
   113	                .get(&EquipmentSlot::HEAD);
   114	            let disguised = (observer_type == &EntityType::SKELETON
   115	                && head_item.item == &Item::SKELETON_SKULL)
   116	                || (observer_type == &EntityType::ZOMBIE && head_item.item == &Item::ZOMBIE_HEAD)
   117	                || ((observer_type == &EntityType::PIGLIN
   118	                    || observer_type == &EntityType::PIGLIN_BRUTE)
   119	                    && head_item.item == &Item::PIGLIN_HEAD)
   120	                || (observer_type == &EntityType::CREEPER && head_item.item == &Item::CREEPER_HEAD);

    43	/// Vanilla `LootTable.createStackSplitter` (`LootTable.java:66-82`): a roll whose count is at
    44	/// or above the item's max stack size is emitted as several stacks of at most `max_stack_size`
    45	/// rather than one oversized stack.
    46	///
    47	/// The `isItemEnabled` feature-flag half of the vanilla lambda has no analogue here and is
    48	/// deliberately not modelled.
    49	fn push_split_stack(stacks: &mut Vec<ItemStack>, stack: ItemStack) {
    50	    let max = stack.get_max_stack_size().max(1);
    51	    if stack.item_count < max {
    52	        stacks.push(stack);
    53	        return;
    54	    }
    55	
    56	    let mut remaining = stack.item_count;
    57	    while remaining > 0 {
    58	        let count = max.min(remaining);
    59	        stacks.push(stack.copy_with_count(count));
    60	        remaining -= count;
    61	    }
    62	}

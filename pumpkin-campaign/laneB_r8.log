   445	                name: Some(name.to_string()),
   446	                ..Default::default()
   447	            }),
   448	            NbtTag::Compound(compound) => {
   449	                let name = compound.get_string("name").map(String::from);
   450	                let id = compound.get_int_array("id").and_then(|arr| {
   451	                    if arr.len() == 4 {
   452	                        Some([arr[0], arr[1], arr[2], arr[3]])
   453	                    } else {
   454	                        None
   455	                    }
   456	                });
   457	                let mut properties = Vec::new();
   458	                if let Some(props_list) = compound.get_list("properties") {
   459	                    for prop_tag in props_list {
   460	                        if let Some(prop_comp) = prop_tag.extract_compound()
   461	                            && let (Some(prop_name), Some(prop_value)) =
   462	                                (prop_comp.get_string("name"), prop_comp.get_string("value"))
   463	                        {
   464	                            properties.push(ProfileProperty {
   465	                                name: prop_name.to_string(),
   466	                                value: prop_value.to_string(),
   467	                                signature: prop_comp.get_string("signature").map(String::from),
   468	                            });
   469	                        }
   470	                    }
   471	                }
   472	                let texture = compound.get_string("texture").map(String::from);
   473	                let cape = compound.get_string("cape").map(String::from);
   474	                let elytra = compound.get_string("elytra").map(String::from);
   475	                let model = compound.get_string("model").map(String::from);
   476	                Some(Self {
   477	                    name,
   478	                    id,
   479	                    properties,
   480	                    texture,
   481	                    cape,
   482	                    elytra,
   483	                    model,
   484	                })
   485	            }
   486	            _ => None,
   487	        }
   488	    }
   489	}

    36	const RECORD_ITEM_NBT_KEY: &str = "RecordItem";
    37	const TICKS_SINCE_SONG_STARTED_NBT_KEY: &str = "ticks_since_song_started";
    38	/// Matches vanilla `JukeboxSong.SONG_END_PADDING_TICKS`: a song keeps "playing"
    39	/// for 20 extra ticks after its nominal length before actually stopping.
    40	const SONG_END_PADDING_TICKS: u64 = 20;
    41	
    42	// Vanilla restores the song holder and length through `setSongWithoutPlaying`
    43	// (`JukeboxBlockEntity.java:72-85`; `JukeboxSongPlayer.java:38-43`).
    44	fn song_length_ticks(stack: &ItemStack) -> u64 {
    45	    stack
    46	        .get_data_component::<JukeboxPlayableImpl>()
    47	        .and_then(|playable| playable.song.split(':').nth(1))
    48	        .and_then(JukeboxSong::from_name)
    49	        .map_or(0, |song| song.length_in_ticks())
    50	}

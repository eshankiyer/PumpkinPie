   105	      boolean disabled = state.getValue(STATE) == CreakingHeartState.UPROOTED;
   106	      return hasLogs && disabled
   107	         ? state.setValue(
   108	            STATE, level.environmentAttributes().getValue(EnvironmentAttributes.CREAKING_ACTIVE, pos) ? CreakingHeartState.AWAKE : CreakingHeartState.DORMANT
   109	         )
   110	         : state;
   111	   }

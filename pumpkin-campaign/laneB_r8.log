    46	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    47	        Box::pin(async move {
    48	            let world = args.world;
    49	            let block = args.block;
    50	            let location = args.position;
    51	
    52	            if args.direction == BlockDirection::Down {
    53	                let support_block = world.get_block_state(&location.down());
    54	                if support_block.is_center_solid(BlockDirection::Up) {
    55	                    return block.default_state.id;
    56	                }
    57	            }
    58	            let mut directions = args.player.get_entity().get_entity_facing_order();
    59	
    60	            if args.replacing == BlockIsReplacing::None {
    61	                let face = args.direction.to_facing();
    62	                let mut i = 0;
    63	                while i < directions.len() && directions[i] != face {
    64	                    i += 1;
    65	                }
    66	
    67	                if i > 0 {
    68	                    directions.copy_within(0..i, 1);
    69	                    directions[0] = face;
    70	                }
    71	            } else if directions[0] == Facing::Down {
    72	                let support_block = world.get_block_state(&location.down());
    73	                if support_block.is_center_solid(BlockDirection::Up) {
    74	                    return block.default_state.id;
    75	                }
    76	            }
    77	
    78	            for dir in directions {
    79	                if dir != Facing::Up
    80	                    && dir != Facing::Down
    81	                    && can_place_at(world, location, dir.to_block_direction())
    82	                {
    83	                    let mut torch_props = RWallTorchProps::default(&Block::REDSTONE_WALL_TORCH);
    84	                    if let Some(facing) = dir.opposite().to_horizontal_facing() {
    85	                        torch_props.facing = facing;

    59	impl PacketWrite for CMovePlayer {
    60	    fn write<W: Write>(&self, writer: &mut W) -> Result<(), Error> {
    61	        self.player_runtime_id.write(writer)?;
    62	        self.position.write(writer)?;
    63	        self.pitch.write(writer)?;
    64	        self.yaw.write(writer)?;
    65	        self.head_yaw.write(writer)?;
    66	        self.mode.write(writer)?;
    67	        self.on_ground.write(writer)?;
    68	        self.riding_runtime_id.write(writer)?;
    69	        (self.mode == Self::MODE_TELEPORT).write(writer)?;
    70	        if self.mode == Self::MODE_TELEPORT {
    71	            self.teleport_cause.write(writer)?;
    72	            self.teleport_source_entity_type.write(writer)?;
    73	        }
    74	        self.tick.write(writer)?;
    75	        Ok(())
    76	    }

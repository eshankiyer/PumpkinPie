   554	pub async fn drop_loot(
   555	    world: &Arc<World>,
   556	    block: &Block,
   557	    pos: &BlockPos,
   558	    experience: bool,
   559	    params: LootContextParameters,
   560	) {
   561	    // In 1.21 a tool's `block_experience` enchantment effects are folded over
   562	    // the sampled amount, and Silk Touch is the only enchantment that defines
   563	    // one: it sets the result to zero. Special-casing it is equivalent for
   564	    // now, but a general effect pass would be the faithful implementation.
   565	    // Read before `params` is moved into the loot table below.
   566	    let silk_touched = experience
   567	        && block.experience.is_some()
   568	        && params.tool.as_ref().is_some_and(|tool| {
   569	            tool.get_enchantment_level(&pumpkin_data::Enchantment::SILK_TOUCH) > 0
   570	        });
   571	
   572	    // Vanilla gates both item drops and experience on this rule, in
   573	    // `Block#popResource` and `Block#popExperience` respectively, so with the
   574	    // rule off an ore drops neither its item nor its experience orbs.
   575	    let block_drops = world.level_info.load().game_rules.block_drops;
   576	
   577	    if block_drops && let Some(loot_table) = &block.loot_table {
   578	        let items = loot_table.get_loot(params);
   579	        if !items.is_empty() {
   580	            let mut event = crate::plugin::block::block_drop_item::BlockDropItemEvent {
   581	                block_pos: *pos,
   582	                world: world.clone(),
   583	                player: None,
   584	                items,
   585	                cancelled: false,
   586	            };
   587	            if let Some(server) = world.server.upgrade() {
   588	                server.plugin_manager.fire(&server, &mut event).await;
   589	            }
   590	            if !event.cancelled {
   591	                for stack in event.items {
   592	                    world.drop_stack(pos, stack).await;
   593	                }
   594	            }
   595	        }
   596	    }
   597	
   598	    if block_drops
   599	        && experience
   600	        && !silk_touched
   601	        && let Some(experience) = &block.experience
   602	    {
   603	        let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(get_seed()));

   463	    fn build_biome_neighborhood(&self, mid: usize) -> Option<BiomeNeighborhood> {
   464	        // Without the surrounding ring there is nothing to resolve edge lookups against and the
   465	        // surface builder would silently fall back to the wrapped read, so make that loud.
   466	        debug_assert!(
   467	            self.size >= 3,
   468	            "surface generation needs a one-chunk ring to resolve edge biome lookups"
   469	        );
   470	        let Chunk::Proto(center) = &self.chunks[mid] else {
   471	            return None;
   472	        };
   473	        let (chunk_x, chunk_z) = (center.x, center.z);
   474	        let (bottom_y, height) = (center.bottom_y(), center.height());
   475	
   476	        Some(BiomeNeighborhood::build(
   477	            chunk_x,
   478	            chunk_z,
   479	            bottom_y,
   480	            height,

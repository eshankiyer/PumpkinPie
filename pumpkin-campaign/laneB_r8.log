+        // (`ServerboundMovePlayerPacket.java:225-229`).
+        let mut input = &[FLAG_ON_GROUND | FLAG_HORIZONTAL_COLLISION][..];
+        let packet = SSetPlayerGround::read(
+            &mut input,
+            &JavaMinecraftVersion::V_26_2,
+        )

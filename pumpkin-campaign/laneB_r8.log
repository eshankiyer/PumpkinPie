   113	        let world = entity.world.load_full();
   114	        let current_pos = entity.block_pos.load();
   115	
   116	        let (block, _) = world.get_block_and_state(&current_pos);
   117	        if block.id == pumpkin_data::Block::HONEY_BLOCK.id {
   118	            return false;
   119	        }
   120	
   121	        for i in 1..=REQUIRED_AIR_BLOCKS_ABOVE {
   122	            let pos = current_pos.up_height(i);
   123	            let state = world.get_block_state(&pos);
   124	            let fluid = world.get_fluid(&pos);
   125	            let is_water = fluid == &Fluid::WATER || fluid == &Fluid::FLOWING_WATER;
   126	            if !state.is_air() && !is_water {
   127	                return false;
   128	            }
   129	        }
   130	
   131	        true
   132	    }

    87	                    }
    88	                }
    89	            }
    90	
    91	            let support_block = world.get_block_state(&location.down());
    92	            if support_block.is_center_solid(BlockDirection::Up) {
    93	                block.default_state.id
    94	            } else {
    95	                BlockStateId::AIR
    96	            }
    97	        })
    98	    }

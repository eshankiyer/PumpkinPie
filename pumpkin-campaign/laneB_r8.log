    44	
    45	pub(crate) fn stop_vertical_movement_after_fall(entity: &dyn EntityBase) {
    46	    let entity = entity.get_entity();
    47	    let mut velocity = entity.velocity.load();
    48	    velocity.y = 0.0;
    49	    entity.velocity.store(velocity);
    50	}
    51	
    52	pub(crate) fn bounce_entity_after_fall(entity: &dyn EntityBase, bounce_multiplier: f64) {
    53	    let base_entity = entity.get_entity();
    54	    let mut velocity = base_entity.velocity.load();
    55	
    56	    if base_entity.is_sneaking() {
    57	        velocity.y = 0.0;
    58	    } else if velocity.y < 0.0 {
    59	        let entity_factor = if entity.get_living_entity().is_some() {
    60	            1.0
    61	        } else {
    62	            0.8
    63	        };
    64	        velocity.y = -velocity.y * bounce_multiplier * entity_factor;
    65	    }
    66	
    67	    base_entity.velocity.store(velocity);
    68	}

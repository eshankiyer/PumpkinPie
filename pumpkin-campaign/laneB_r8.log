    98	   public boolean onHit(
    99	      final Level level, final BlockState state, final BlockHitResult hitResult, final @Nullable Player player, final boolean requireHitFromCorrectSide
   100	   ) {
   101	      Direction direction = hitResult.getDirection();
   102	      BlockPos blockPos = hitResult.getBlockPos();
   103	      boolean properHit = !requireHitFromCorrectSide || this.isProperHit(state, direction, hitResult.getLocation().y - blockPos.getY());
   104	      if (properHit) {
   105	         boolean didRing = this.attemptToRing(player, level, blockPos, direction);
   106	         if (didRing && player != null) {
   107	            player.awardStat(Stats.BELL_RING);
   108	         }
   109	
   110	         return true;
   111	      } else {
   112	         return false;
   113	      }
   114	   }

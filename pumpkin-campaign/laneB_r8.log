   156	         case SINGLE_WALL -> (VoxelShape)SHAPE_SINGLE_WALL.get(facing);
   157	         case DOUBLE_WALL -> (VoxelShape)SHAPE_DOUBLE_WALL.get(facing.getAxis());
   158	         case CEILING -> SHAPE_CEILING;
   159	      };

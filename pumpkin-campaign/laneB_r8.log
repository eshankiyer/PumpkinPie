    53	pub(crate) async fn collision_shape_for_entity(
    54	    entity: &dyn EntityBase,
    55	    position: &BlockPos,
    56	) -> Option<BoundingBox> {
    57	    let fall_distance = entity
    58	        .get_living_entity()
    59	        .map_or(0.0, |living| living.fall_distance.load());
    60	
    61	    if fall_distance > 2.5f32 {
    62	        return Some(FALLING_COLLISION_SHAPE);
    63	    }
    64	
    65	    let base = entity.get_entity();
    66	    if base.entity_type == &EntityType::FALLING_BLOCK {
    67	        return Some(BoundingBox::full_block());
    68	    }
    69	
    70	    if can_entity_walk_on_powder_snow(entity).await
    71	        && is_entity_above_block(base, position)
    72	        && !is_entity_descending(base)
    73	    {
    74	        return Some(BoundingBox::full_block());
    75	    }
    76	
    77	    None
    78	}

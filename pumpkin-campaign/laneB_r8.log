   320	async fn handle_torch_tick(
   321	    world: &Arc<World>,
   322	    pos: &BlockPos,
   323	    block: &Block,
   324	    lit: &mut bool,
   325	    neighbor_signal: bool,
   326	    now: i64,
   327	) -> bool {
   328	    if *lit {
   329	        if neighbor_signal {
   330	            *lit = false;
   331	            if world
   332	                .is_redstone_torch_toggled_too_frequently(*pos, now, true)
   333	                .await
   334	            {
   335	                world.sync_world_event(WorldEvent::RedstoneTorchBurnout, *pos, 0);
   336	                world.schedule_block_tick(block, *pos, 160, TickPriority::Normal);
   337	            }
   338	            return true;
   339	        }
   340	        false
   341	    } else if !neighbor_signal
   342	        && !world
   343	            .is_redstone_torch_toggled_too_frequently(*pos, now, false)
   344	            .await
   345	    {
   346	        *lit = true;
   347	        true
   348	    } else {
   349	        false
   350	    }
   351	}

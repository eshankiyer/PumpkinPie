   232	    /// Vanilla `JukeboxBlockEntity.popOutTheItem` removes the record, spawns it above the
   233	    /// block, and uses the normal song-change callback (`JukeboxBlockEntity.java:48-61`).
   234	    pub(crate) async fn pop_out_the_item(&self, world: &Arc<World>) {
   235	        let record = self.clear_record().await;
   236	        if record.is_empty() {
   237	            return;
   238	        }
   239	
   240	        let spawn_pos = Vector3::new(
   241	            f64::from(self.position.0.x) + 0.5 + rand::rng().random_range(-0.35..0.35),
   242	            f64::from(self.position.0.y) + 1.01,
   243	            f64::from(self.position.0.z) + 0.5 + rand::rng().random_range(-0.35..0.35),
   244	        );
   245	        let entity = crate::entity::Entity::new(
   246	            world.clone(),
   247	            spawn_pos,
   248	            &pumpkin_data::entity::EntityType::ITEM,
   249	        );
   250	        let item_entity = Arc::new(crate::entity::item::ItemEntity::new(entity, record));
   251	        world.spawn_entity(item_entity).await;
   252	    }

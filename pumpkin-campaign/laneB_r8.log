   392	fn block_center(pos: BlockPos) -> Vector3<f64> {
   393	    Vector3::new(
   394	        f64::from(pos.0.x) + 0.5,
   395	        f64::from(pos.0.y) + 0.5,
   396	        f64::from(pos.0.z) + 0.5,
   397	    )
   398	}

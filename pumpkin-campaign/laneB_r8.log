+        assert_eq!(
+            packet.collision & FLAG_HORIZONTAL_COLLISION,
+            FLAG_HORIZONTAL_COLLISION
+        );
+        assert_eq!(packet.collision & FLAG_ON_GROUND, FLAG_ON_GROUND);

    89	   public void pull(BlockState state, final Level level, final BlockPos pos, final @Nullable Player player) {
    90	      state = state.cycle(POWERED);
    91	      level.setBlock(pos, state, 3);
    92	      this.updateNeighbours(state, level, pos);
    93	      playSound(player, level, pos, state);

   448	    fn mob_tick<'a>(&'a self, _caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   449	        Box::pin(async move {
   450	            let entity = &self.mob_entity.living_entity.entity;
   451	            if !entity.is_alive() {
   452	                return;
   453	            }
   454	
   455	            if self
   456	                .invulnerability_animation_remaining_ticks
   457	                .load(Ordering::Relaxed)
   458	                > 0
   459	            {
   460	                self.invulnerability_animation_remaining_ticks
   461	                    .fetch_sub(1, Ordering::Relaxed);
   462	            }
   463	            if self
   464	                .attack_animation_remaining_ticks
   465	                .load(Ordering::Relaxed)
   466	                > 0
   467	            {
   468	                self.attack_animation_remaining_ticks
   469	                    .fetch_sub(1, Ordering::Relaxed);
   470	            }
   471	
   472	            let can_move = self.can_move();
   473	            let now_can_move = self.check_can_move().await;
   474	
   475	            if now_can_move != can_move {
   476	                let world = entity.world.load();
   477	                if now_can_move {
   478	                    world.play_sound_fine(
   479	                        Sound::EntityCreakingUnfreeze,
   480	                        SoundCategory::Hostile,
   481	                        &entity.pos.load(),
   482	                        1.0,
   483	                        1.0,
   484	                    );
   485	                } else {
   486	                    self.stop_in_place();
   487	                    world.play_sound_fine(
   488	                        Sound::EntityCreakingFreeze,
   489	                        SoundCategory::Hostile,
   490	                        &entity.pos.load(),
   491	                        1.0,
   492	                        1.0,
   493	                    );
   494	                }
   495	                self.set_can_move(now_can_move);
   496	                self.emit_entity_action().await;
   497	            }
   498	
   499	            // Home Creaking Heart check
   500	            if let Some(home_pos) = self.get_home_pos() {
   501	                let world = entity.world.load();
   502	                let has_protection = world.get_block_entity(&home_pos).is_some_and(|be| {
   503	                    be.as_any()
   504	                        .downcast_ref::<CreakingHeartBlockEntity>()
   505	                        .is_some_and(|heart_be| heart_be.is_protector(entity.entity_uuid))
   506	                });
   507	
   508	                if !has_protection {
   509	                    self.mob_entity.living_entity.health.store(0.0);
   510	                }
   511	            }
   512	
   513	            // Teardown / death tick
   514	            if self.is_heart_bound() && self.is_tearing_down() {
   515	                let death_time = self.death_time.fetch_add(1, Ordering::Relaxed) + 1;
   516	                if death_time > TWITCH_DEATH_DURATION && !entity.is_removed() {
   517	                    self.tear_down().await;
   518	                }
   519	            }
   520	        })
   521	    }
   522	
   523	    fn pre_damage<'a>(
   524	        &'a self,
   525	        damage_type: DamageType,
   526	        _source: Option<&'a dyn EntityBase>,
   527	    ) -> EntityBaseFuture<'a, bool> {
   528	        Box::pin(async move {
   529	            let entity = &self.mob_entity.living_entity.entity;
   530	
   531	            // `Creaking.hurtServer`: the gate is the `BYPASSES_INVULNERABILITY` damage-type
   532	            // tag, not just out-of-world.
   533	            if self.is_heart_bound()
   534	                && !damage_type.has_tag(&tag::DamageType::MINECRAFT_BYPASSES_INVULNERABILITY)
   535	            {
   536	                if self
   537	                    .invulnerability_animation_remaining_ticks
   538	                    .load(Ordering::Relaxed)
   539	                    <= 0
   540	                    && entity.is_alive()
   541	                {
   542	                    self.invulnerability_animation_remaining_ticks
   543	                        .store(8, Ordering::Relaxed);
   544	
   545	                    let world = entity.world.load();
   546	                    world.broadcast_to_chunk(
   547	                        entity.chunk_pos.load(),
   548	                        &CEntityStatus::new(entity.entity_id, 66),
   549	                    );
   550	                    self.emit_entity_action().await;
   551	
   552	                    if let Some(home_pos) = self.get_home_pos()
   553	                        && let Some(be) = world.get_block_entity(&home_pos)
   554	                        && let Some(heart_be) =
   555	                            be.as_any().downcast_ref::<CreakingHeartBlockEntity>()
   556	                        && heart_be.is_protector(entity.entity_uuid)
   557	                    {
   558	                        heart_be.creaking_hurt(&world);
   559	                        self.play_sound(Sound::EntityCreakingSway);
   560	                    }
   561	                }
   562	                // Return false so heart-bound Creaking does not lose health from normal damage
   563	                return false;
   564	            }
   565	            true
   566	        })
   567	    }
   568	}

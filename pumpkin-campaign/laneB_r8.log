   441	    #[test]
   442	    fn try_place_leaf_matches_vanilla_waterlogged_selection() {
   443	        // Vanilla `FoliagePlacer.tryPlaceLeaf` (`FoliagePlacer.java:175-179`) writes both
   444	        // outcomes of the water-source predicate to a waterloggable foliage state.
   445	        let wet = FoliagePlacer::set_waterlogged(Block::OAK_LEAVES.default_state, true);
   446	        let dry = FoliagePlacer::set_waterlogged(wet, false);
   447	        assert!(!dry.is_waterlogged());
   448	        assert!(wet.is_waterlogged());
   449	    }

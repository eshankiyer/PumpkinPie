    29	    fn do_tick<'a>(&'a mut self, mob: &'a dyn Mob, brain: &'a Brain) -> SensorFuture<'a>;
    30	
    31	    /// Countdown state backing `Sensor.tick`'s scan-rate gate.
    32	    fn ticks_until_scan(&mut self) -> &mut i64;
    33	
    34	    /// `Sensor.DEFAULT_SCAN_RATE = 20` (`sensing/Sensor.java:14,36-38`).
    35	    fn scan_rate(&self) -> i64 {
    36	        20
    37	    }
    38	
    39	    /// `Sensor.tick` (`sensing/Sensor.java:44-50`): pre-decrement, fire at `<= 0`, reset to the
    40	    /// full scan rate.
    41	    ///
    42	    /// `updateTargetingConditionRanges` (`:52-60`) is not ported: it mutates shared static
    43	    /// `TargetingConditions` singletons, which has no Rust analogue and is only consulted by
    44	    /// the targeting sensors this stage does not port.
    45	    fn tick<'a>(&'a mut self, mob: &'a dyn Mob, brain: &'a Brain) -> SensorFuture<'a> {
    46	        let scan_rate = self.scan_rate();
    47	        let remaining = self.ticks_until_scan();
    48	        *remaining -= 1;
    49	        if *remaining > 0 {
    50	            return Box::pin(async {});
    51	        }
    52	        *remaining = scan_rate;
    53	        self.do_tick(mob, brain)
    54	    }
    55	}
    56	
    57	/// `Sensor.randomlyDelayStart` (`sensing/Sensor.java:40-42`), called once per sensor at brain
    58	/// creation (`Brain.java:84`) so that mobs spawned in the same tick do not all scan on the
    59	/// same tick.
    60	#[must_use]
    61	pub fn randomly_delayed_start(scan_rate: i64) -> i64 {
    62	    use rand::RngExt;
    63	    rand::rng().random_range(0..scan_rate)
    64	}

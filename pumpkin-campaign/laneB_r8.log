-            pitch: bytebuf.get_f32_be()?,
-            ground: bytebuf.get_bool()?,
+            yaw,
+            pitch,
+            ground: flags & FLAG_ON_GROUND != 0,
+            horizontal_collision: flags & FLAG_HORIZONTAL_COLLISION != 0,
         })
     }
 }
@@ -32,7 +40,35 @@

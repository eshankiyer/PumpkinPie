    66	      if (level.isClientSide()) {
    67	         BlockState stateAfter = stateBefore.cycle(POWERED);
    68	         if (stateAfter.getValue(POWERED)) {
    69	            makeParticle(stateAfter, level, pos, 1.0F);
    70	         }
    71	      } else {
    72	         this.pull(stateBefore, level, pos, null);
    73	      }

   136	            this.emitJumpTrailParticles();
   137	      }
   138	
   139	      this.idle.startIfStopped(this.tickCount);
   140	      if (pose != Pose.SLIDING && this.slide.isStarted()) {
   141	         this.slideBack.start(this.tickCount);
   142	         this.slide.stop();
   143	      }

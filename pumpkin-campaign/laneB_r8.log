   299	    async fn suck_in_items(&self, world: &Arc<World>) -> bool {
   300	        // TODO getEntityContainer
   301	        let pos_up = &self.position.up();
   302	        let mut search_event = crate::plugin::api::events::inventory::hopper_inventory_search::HopperInventorySearchEvent::new(
   303	            self.position,
   304	            *pos_up,
   305	        );
   306	        if let Some(server) = world.server.upgrade() {
   307	            server.plugin_manager.fire(&server, &mut search_event).await;
   308	        }
   309	        if search_event.cancelled {
   310	            return false;
   311	        }
   312	
   313	        if let Some(entity) = world.get_block_entity(pos_up)
   314	            && let Some(container) = entity.clone().get_inventory()
   315	        {
   316	            // The hopper sits below the container, i.e. touches its bottom (Down) face.
   317	            let slots = container.slots_for_face(pumpkin_data::BlockDirection::Down);
   318	            for i in slots {
   319	                let mut item = container.get_stack(i).await;
   320	                if !item.is_empty()
   321	                    && container.can_transfer_to(self, i, &item)
   322	                    // Vanilla `Container.canTakeItem` is a source-to-destination gate
   323	                    // (`JukeboxBlockEntity.java:147-150`).
   324	                    && container.can_take_item(self, i, &item).await
   325	                    && container
   326	                        .can_extract_through_face(i, &item, pumpkin_data::BlockDirection::Down)
   327	                        .await
   328	                {
   329	                    let one_item = item.split(1);
   330	                    if Self::add_one_item(container.as_ref(), self, one_item, &[0, 1, 2, 3, 4])
   331	                        .await
   332	                    {
   333	                        container.set_stack(i, item).await;
   334	                        crate::block::blocks::jukebox::JukeboxBlock::refresh_after_inventory_transfer(
   335	                            world, pos_up,
   336	                        )
   337	                        .await;
   338	                        // A hopper pulls through the raw container, so it never runs the result
   339	                        // slot's take hook: vanilla banks the furnace's experience until a player
   340	                        // takes the output or breaks the block. Popping orbs at the hopper turned
   341	                        // every auto-smelter into an orb fountain.
   342	                        return true;
   343	                    }
   344	                }
   345	            }
   346	            return false;
   347	        }
   348	        // A composter has no block entity: vanilla reaches it through
   349	        // `WorldlyContainerHolder.getContainer` (`ComposterBlock.java:365-373`) instead, so the
   350	        // block-entity lookup above never finds one. `getSourceContainer` still returns a
   351	        // container for a composter at any level, so a hopper under one never falls through to
   352	        // sucking up dropped items.
   353	        if world.get_block(pos_up) == &Block::COMPOSTER {
   354	            if composter::hopper_output_ready(world, pos_up, BlockDirection::Down) {
   355	                let bone_meal = ItemStack::new(1, &pumpkin_data::item::Item::BONE_MEAL);
   356	                if Self::add_one_item(self, self, bone_meal, &[0, 1, 2, 3, 4]).await {
   357	                    composter::hopper_take_output(world, pos_up).await;
   358	                    return true;
   359	                }
   360	            }
   361	            return false;
   362	        }
   363	
   364	        let (block, state) = world.get_block_and_state(pos_up);
   365	        if !blocks_hopper_suction(block, state) {
   366	            let entities = world.get_entities_at_box(&suck_box(self.position));
   367	            for entity_base in entities {
   368	                if let Some(item_entity) = entity_base.clone().get_item_entity() {
   369	                    let mut stack = item_entity.get_item_stack().lock().await;
   370	                    if stack.is_empty() {
   371	                        continue;
   372	                    }
   373	                    let mut pickup_event = crate::plugin::api::events::inventory::inventory_pickup_item::InventoryPickupItemEvent::new(
   374	                        self.position,
   375	                        item_entity.get_entity().entity_id,
   376	                        stack.item.registry_key.to_string(),
   377	                    );
   378	                    if let Some(server) = world.server.upgrade() {
   379	                        server.plugin_manager.fire(&server, &mut pickup_event).await;
   380	                    }
   381	                    if pickup_event.cancelled {
   382	                        continue;
   383	                    }
   384	                    // `HopperBlockEntity.addItem(container, entity)` offers the WHOLE stack and
   385	                    // leaves whatever did not fit on the entity, so a dropped stack of 64 is
   386	                    // swallowed in one tick rather than one item every eight ticks. Only the
   387	                    // container-to-container path moves a single item per cycle.
   388	                    let mut moved = false;
   389	                    while !stack.is_empty() {
   390	                        let one_item = stack.split(1);
   391	                        let count = one_item.item_count;
   392	                        if Self::add_one_item(self, self, one_item, &[0, 1, 2, 3, 4]).await {
   393	                            moved = true;
   394	                        } else {
   395	                            stack.item_count += count;
   396	                            break;
   397	                        }
   398	                    }
   399	                    if moved {
   400	                        if stack.is_empty() {
   401	                            item_entity.get_entity().remove().await;
   402	                        }
   403	                        return true;
   404	                    }
   405	                }
   406	            }
   407	        }
   408	        false
   409	    }

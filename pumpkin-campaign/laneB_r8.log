+    fn rotation_reads_horizontal_collision_flag() {
+        // `Rot.read` decodes the packed movement status byte
+        // (`ServerboundMovePlayerPacket.java:195-201`).
+        let mut input = &[0, 0, 0, 0, 0, 0, 0, 0, FLAG_HORIZONTAL_COLLISION][..];

+        let packet = SSetPlayerGround::read(
+            &mut input,
+            &JavaMinecraftVersion::V_26_2,
+        )
+        .expect("status-only packet should decode");
+
+        assert!(packet.on_ground);
+        assert!(packet.horizontal_collision);
+    }
+}

    25	impl RedstoneOreBlock {
    26	    fn spawn_particles(world: &Arc<World>, pos: &BlockPos) {
    27	        let mut random = rng();
    28	        let mut data = Vec::with_capacity(8);
    29	        let _ = data.write_i32_be(0x00FF0000);
    30	        let _ = data.write_f32_be(1.0);
    31	
    32	        for (dx, dy, dz) in [
    33	            (1, 0, 0),
    34	            (-1, 0, 0),
    35	            (0, 1, 0),
    36	            (0, -1, 0),
    37	            (0, 0, 1),
    38	            (0, 0, -1),
    39	        ] {
    40	            let relative = BlockPos::new(pos.0.x + dx, pos.0.y + dy, pos.0.z + dz);
    41	            let adjacent_state = world.get_block_state(&relative);
    42	            let adjacent_block = Block::from_state_id(adjacent_state.id);
    43	            if adjacent_state.is_full_cube()
    44	                && adjacent_state.opacity >= 15
    45	                && adjacent_block.name != "tinted_glass"
    46	            {
    47	                continue;
    48	            }
    49	            let x = if dx != 0 {
    50	                0.5 + 0.5625 * f64::from(dx)
    51	            } else {
    52	                random.random::<f64>()
    53	            };
    54	            let y = if dy != 0 {
    55	                0.5 + 0.5625 * f64::from(dy)
    56	            } else {
    57	                random.random::<f64>()
    58	            };
    59	            let z = if dz != 0 {
    60	                0.5 + 0.5625 * f64::from(dz)
    61	            } else {
    62	                random.random::<f64>()
    63	            };
    64	            let particle_pos = Vector3::new(
    65	                f64::from(pos.0.x) + x,
    66	                f64::from(pos.0.y) + y,
    67	                f64::from(pos.0.z) + z,
    68	            );
    69	            for player in world.players.load().iter() {
    70	                if player.position().squared_distance_to_vec(&particle_pos) <= 32.0 * 32.0 {
    71	                    player.spawn_particle_with_data(
    72	                        particle_pos,
    73	                        Vector3::new(0.0, 0.0, 0.0),
    74	                        0.0,
    75	                        1,
    76	                        Particle::Dust,
    77	                        &data,
    78	                    );
    79	                }
    80	            }
    81	        }
    82	    }
    83	
    84	    async fn light_up(world: &Arc<World>, pos: &BlockPos, block: &Block, state: &BlockState) {
    85	        let mut props = RedstoneOreLikeProperties::from_state_id(state.id, block);
    86	        if !props.lit {
    87	            props.lit = true;
    88	            world
    89	                .set_block_state(pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
    90	                .await;
    91	        }
    92	    }
    93	
    94	    async fn interact(world: &Arc<World>, pos: &BlockPos, block: &Block, state: &BlockState) {
    95	        Self::spawn_particles(world, pos);
    96	        Self::light_up(world, pos, block, state).await;
    97	    }
    98	}

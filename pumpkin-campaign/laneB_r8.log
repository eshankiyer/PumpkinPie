   146	    fn remembers_visible_target(&self, has_line_of_sight: bool) -> bool {
   147	        if has_line_of_sight {
   148	            self.time_without_visibility.store(0, Ordering::Relaxed);
   149	            true
   150	        } else {
   151	            let unseen_ticks = self.time_without_visibility.fetch_add(1, Ordering::Relaxed) + 1;
   152	            unseen_ticks <= to_goal_ticks(self.max_time_without_visibility)
   153	        }
   154	    }

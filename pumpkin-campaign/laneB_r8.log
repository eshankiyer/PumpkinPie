    31	fn lid_open_bounding_box(
    32	    position: &pumpkin_util::math::position::BlockPos,
    33	    facing: BlockDirection,
    34	) -> BoundingBox {
    35	    let block = BoundingBox::from_block(position);
    36	    let offset = facing.to_offset();
    37	    let mut min = block.min;
    38	    let mut max = block.max;
    39	
    40	    if offset.x < 0 {
    41	        min.x += f64::from(offset.x) * 0.5;
    42	        max.x += f64::from(offset.x);
    43	    } else if offset.x > 0 {
    44	        min.x += f64::from(offset.x);
    45	        max.x += f64::from(offset.x) * 0.5;
    46	    }
    47	    if offset.y < 0 {
    48	        min.y += f64::from(offset.y) * 0.5;
    49	        max.y += f64::from(offset.y);
    50	    } else if offset.y > 0 {
    51	        min.y += f64::from(offset.y);
    52	        max.y += f64::from(offset.y) * 0.5;
    53	    }
    54	    if offset.z < 0 {
    55	        min.z += f64::from(offset.z) * 0.5;
    56	        max.z += f64::from(offset.z);
    57	    } else if offset.z > 0 {
    58	        min.z += f64::from(offset.z);
    59	        max.z += f64::from(offset.z) * 0.5;
    60	    }
    61	
    62	    BoundingBox::new(min, max).contract_all(1.0e-6)
    63	}

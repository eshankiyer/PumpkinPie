   495	        }
   496	        if let Some(id) = &self.id {
   497	            compound.put("id", NbtTag::IntArray(id.to_vec()));
   498	        }
   499	        if !self.properties.is_empty() {
   500	            let mut props_list = Vec::new();
   501	            for prop in &self.properties {
   502	                let mut prop_comp = NbtCompound::new();
   503	                prop_comp.put_string("name", prop.name.clone());
   504	                prop_comp.put_string("value", prop.value.clone());
   505	                if let Some(sig) = &prop.signature {
   506	                    prop_comp.put_string("signature", sig.clone());
   507	                }
   508	                props_list.push(NbtTag::Compound(prop_comp));
   509	            }
   510	            compound.put_list("properties", props_list);
   511	        }
   512	        if let Some(texture) = &self.texture {
   513	            compound.put_string("texture", texture.clone());
   514	        }
   515	        if let Some(cape) = &self.cape {
   516	            compound.put_string("cape", cape.clone());
   517	        }
   518	        if let Some(elytra) = &self.elytra {
   519	            compound.put_string("elytra", elytra.clone());
   520	        }
   521	        if let Some(model) = &self.model {
   522	            compound.put_string("model", model.clone());
   523	        }
   524	        NbtTag::Compound(compound)
   525	    }

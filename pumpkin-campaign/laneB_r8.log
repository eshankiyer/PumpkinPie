    76	    /// tokio mutex, so the read is awaited inside this helper before any brain lock is taken.
    77	    async fn visibility_percent(observer_type: &EntityType, target: &Arc<dyn EntityBase>) -> f64 {
    78	        let mut percent = 1.0;
    79	
    80	        let entity = target.get_entity();
    81	        // `isDiscrete()` -> the sneaking flag (`Entity.java`).
    82	        if entity.sneaking.load(Ordering::Relaxed) {
    83	            percent *= 0.8;
    84	        }

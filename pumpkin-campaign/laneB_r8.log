   189	
   190	async fn targeter_visibility_modifier(targeter: &LivingEntity, target: &LivingEntity) -> f64 {
   191	    let mut modifier = 1.0;
   192	
   193	    // `LivingEntity.getVisibilityPercent` (`LivingEntity.java:919-922`): a discrete target is
   194	    // 20% harder to see. `Entity.isDiscrete` (`Entity.java:2689-2691`) is just
   195	    // `isShiftKeyDown`, i.e. the sneaking flag.
   196	    if target.entity.is_sneaking() {
   197	        modifier *= 0.8;
   198	    }
   199	
   200	    if target.entity.invisible.load(Relaxed) {
   201	        let equipment = target.entity_equipment.lock().await;
   202	        let armor_slots = [
   203	            EquipmentSlot::HEAD,
   204	            EquipmentSlot::CHEST,
   205	            EquipmentSlot::LEGS,
   206	            EquipmentSlot::FEET,
   207	        ];
   208	        let mut covered = 0;
   209	        for slot in &armor_slots {
   210	            if !equipment.get(slot).is_empty() {
   211	                covered += 1;
   212	            }
   213	        }
   214	        modifier *= 0.7 * (f64::from(covered as u8) / 4.0).max(0.1);
   215	    }
   216	
   217	    let head_item = target
   218	        .entity_equipment
   219	        .lock()
   220	        .await
   221	        .get(&EquipmentSlot::HEAD)
   222	        .item
   223	        .id;
   224	    let target_type = targeter.entity.entity_type;
   225	    let head_reduces_visibility = (target_type == &EntityType::SKELETON
   226	        && head_item == Item::SKELETON_SKULL.id)
   227	        || (target_type == &EntityType::ZOMBIE && head_item == Item::ZOMBIE_HEAD.id)
   228	        || ((target_type == &EntityType::PIGLIN || target_type == &EntityType::PIGLIN_BRUTE)
   229	            && head_item == Item::PIGLIN_HEAD.id)
   230	        || (target_type == &EntityType::CREEPER && head_item == Item::CREEPER_HEAD.id);
   231	    if head_reduces_visibility {
   232	        modifier *= 0.5;
   233	    }
   234	
   235	    modifier
   236	}
   237	
   238	#[cfg(test)]
   239	mod tests {
   240	    #[test]
   241	    fn invisible_targets_without_armor_keep_minimum_visibility() {
   242	        let modifier: f64 = 0.7 * 0.1;
   243	        assert!((modifier - 0.07).abs() < f64::EPSILON);
   244	    }
   245	
   246	    /// `LivingEntity.java:919-922`: sneaking multiplies visibility by 0.8, which shortens a
   247	    /// 16-block follow range to 12.8 blocks. Guards the term itself, since the surrounding
   248	    /// calculation needs a live world.
   249	    #[test]
   250	    fn sneaking_shortens_the_effective_detection_range() {
   251	        let base_max_distance: f64 = 16.0;
   252	        let sneaking_modifier: f64 = 0.8;
   253	        assert!(
   254	            (base_max_distance * sneaking_modifier - 12.8).abs() < 1.0e-9,
   255	            "a sneaking target should be detected only within 12.8 blocks"
   256	        );
   257	        assert!(base_max_distance * sneaking_modifier > super::MIN_DISTANCE);
   258	    }
   259	}

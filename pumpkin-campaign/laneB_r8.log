   199	        if !stack.is_empty() {
   200	            let mut item_nbt = NbtCompound::new();
   201	            item_nbt.put_byte("Slot", i as i8);
   202	            stack.write_item_stack(&mut item_nbt);
   203	            slots.push(NbtTag::Compound(item_nbt));
   204	        }
   205	    }

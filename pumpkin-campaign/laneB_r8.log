   243	                    args.world,
   244	                    args.position,
   245	                    args.block,
   246	                    &mut props.lit,
   247	                    neighbor_signal,
   248	                    now,
   249	                )
   250	                .await
   251	                {
   252	                    args.world
   253	                        .set_block_state(
   254	                            args.position,
   255	                            props.to_state_id(args.block),
   256	                            BlockFlags::NOTIFY_ALL,
   257	                        )
   258	                        .await;
   259	                    update_neighbors(args.world, args.position).await;
   260	                }
   261	            } else if args.block == &Block::REDSTONE_TORCH {
   262	                let mut props = RTorchProps::from_state_id(state.id, args.block);
   263	                let neighbor_signal =
   264	                    !should_be_lit(args.world, args.position, BlockDirection::Down).await;
   265	                if handle_torch_tick(
   266	                    args.world,
   267	                    args.position,
   268	                    args.block,
   269	                    &mut props.lit,
   270	                    neighbor_signal,
   271	                    now,
   272	                )
   273	                .await
   274	                {
   275	                    args.world
   276	                        .set_block_state(
   277	                            args.position,
   278	                            props.to_state_id(args.block),
   279	                            BlockFlags::NOTIFY_ALL,
   280	                        )
   281	                        .await;
   282	                    update_neighbors(args.world, args.position).await;
   283	                }
   284	            }
   285	        })

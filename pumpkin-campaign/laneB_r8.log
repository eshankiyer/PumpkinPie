   159	                // (`damageSources().badRespawnPointExplosion`) has no equivalent yet --
   160	                // entities hurt by this blast are attributed the generic explosion damage
   161	                // type instead of a respawn-anchor-specific one; narrow, admin/edge-case
   162	                // divergence, left as-is.
   163	                let mut in_water = false;
   164	                for direction in [
   165	                    BlockDirection::North,
   166	                    BlockDirection::South,
   167	                    BlockDirection::East,
   168	                    BlockDirection::West,
   169	                ] {
   170	                    if is_water_that_would_flow(
   171	                        args.world,
   172	                        args.position.offset(direction.to_offset()),
   173	                    ) {
   174	                        in_water = true;
   175	                        break;
   176	                    }
   177	                }
   178	                if !in_water {
   179	                    let (above_fluid, _) =
   180	                        args.world.get_fluid_and_fluid_state(&args.position.up());
   181	                    in_water = above_fluid.matches_type(&Fluid::WATER);
   182	                }
   183	
   184	                args.world
   185	                    .explode_with_fire_and_calculator(
   186	                        args.position.to_centered_f64(),
   187	                        5.0,
   188	                        crate::world::ExplosionInteraction::Block,
   189	                        Arc::new(RespawnAnchorExplosionCalculator {
   190	                            anchor_pos: *args.position,
   191	                            in_water,
   192	                        }),
   193	                    )
   194	                    .await;
   195	                return BlockActionResult::SuccessServer;
   196	            }
   197	
   198	            let state_id = args.world.get_block_state_id(args.position);
   199	            let mut props = RespawnAnchorLikeProperties::from_state_id(state_id, args.block);
   200	            if props.charges == 0 {
   201	                args.player
   202	                    .send_system_message(&pumpkin_macros::translate_cross!(
   203	                        translation::java::BLOCK_MINECRAFT_BED_NO_SLEEP,
   204	                        translation::bedrock::TILE_BED_NOSLEEP
   205	                    ))
   206	                    .await;
   207	                return BlockActionResult::SuccessServer;
   208	            }
   209	
   210	            let changed = args
   211	                .player
   212	                .set_respawn_point(
   213	                    args.world.dimension.clone(),
   214	                    *args.position,
   215	                    args.player.get_entity().yaw.load(),
   216	                    args.player.get_entity().pitch.load(),
   217	                    false,
   218	                )
   219	                .await;
   220	            if changed {
   221	                props.charges -= 1;
   222	                args.world
   223	                    .set_block_state(
   224	                        args.position,
   225	                        props.to_state_id(args.block),
   226	                        BlockFlags::NOTIFY_ALL,
   227	                    )
   228	                    .await;
   229	                args.world.play_sound(
   230	                    Sound::BlockRespawnAnchorSetSpawn,
   231	                    SoundCategory::Blocks,
   232	                    &args.position.to_centered_f64(),
   233	                );
   234	                args.player
   235	                    .send_system_message(&pumpkin_macros::translate_cross!(
   236	                        translation::java::BLOCK_MINECRAFT_SET_SPAWN,
   237	                        translation::bedrock::TILE_BED_RESPAWNSET
   238	                    ))
   239	                    .await;
   240	            }
   241	            BlockActionResult::SuccessServer
   242	        })
   243	    }
   244	
   245	    fn get_comparator_output<'a>(
   246	        &'a self,
   247	        args: GetComparatorOutputArgs<'a>,
   248	    ) -> BlockFuture<'a, Option<u8>> {
   249	        Box::pin(async move {
   250	            let props = RespawnAnchorLikeProperties::from_state_id(args.state.id, args.block);
   251	            Some(Self::charges_to_comparator_output(props.charges))
   252	        })
   253	    }
   254	}
   255	
   256	#[cfg(test)]
   257	mod tests {
   258	    use super::*;
   259	
   260	    #[test]
   261	    fn comparator_output_matches_vanilla_scaling() {
   262	        assert_eq!(RespawnAnchorBlock::charges_to_comparator_output(0), 0);
   263	        assert_eq!(RespawnAnchorBlock::charges_to_comparator_output(1), 3);
   264	        assert_eq!(RespawnAnchorBlock::charges_to_comparator_output(2), 7);
   265	        assert_eq!(RespawnAnchorBlock::charges_to_comparator_output(3), 11);
   266	        assert_eq!(RespawnAnchorBlock::charges_to_comparator_output(4), 15);
   267	    }
   268	}


   164	///NOTE: This makes lots of small writes; make sure there is a buffer somewhere down the line
   165	pub struct StreamEncryptor<W: AsyncWrite + Unpin> {
   166	    cipher: Aes128Cfb8Enc,
   167	    write: W,
   168	    last_unwritten_encrypted_byte: Option<u8>,
   169	}
   170	
   171	impl<W: AsyncWrite + Unpin> StreamEncryptor<W> {
   172	    pub fn new(cipher: Aes128Cfb8Enc, stream: W) -> Self {
   173	        debug_assert_eq!(Aes128Cfb8Enc::block_size(), 1);
   174	        Self {
   175	            cipher,
   176	            write: stream,
   177	            last_unwritten_encrypted_byte: None,
   178	        }
   179	    }
   180	}
   181	
   182	impl<W: AsyncWrite + Unpin> AsyncWrite for StreamEncryptor<W> {
   183	    fn poll_write(
   184	        self: Pin<&mut Self>,
   185	        cx: &mut Context<'_>,
   186	        buf: &[u8],
   187	    ) -> Poll<Result<usize, Error>> {
   188	        let ref_self = self.get_mut();
   189	        let cipher = &mut ref_self.cipher;
   190	
   191	        let mut total_written = 0;
   192	        // Decrypt the raw data, note that our block size is 1 byte, so this is always safe
   193	        for block in buf.chunks(Aes128Cfb8Enc::block_size()) {
   194	            let mut out = [0u8];
   195	
   196	            if let Some(out_to_use) = ref_self.last_unwritten_encrypted_byte {
   197	                // This assumes that this `poll_write` is called on the same stream of bytes which I
   198	                // think is a fair assumption, since thats an invariant for the TCP stream anyway.
   199	
   200	                // This should never panic
   201	                out[0] = out_to_use;
   202	            } else {
   203	                let out_block: &mut Array<u8, U1> = (&mut out[..])
   204	                    .try_into()
   205	                    .map_err(|_| Error::other("Output slice size does not match block size"))?;
   206	                cipher
   207	                    .encrypt_b2b(block, out_block)
   208	                    .map_err(|_| Error::other("Encryption failed"))?;
   209	            }
   210	
   211	            let write = Pin::new(&mut ref_self.write);
   212	            match write.poll_write(cx, &out) {
   213	                Poll::Pending => {
   214	                    ref_self.last_unwritten_encrypted_byte = Some(out[0]);
   215	                    if total_written == 0 {
   216	                        //If we didn't write anything, return pending
   217	                        return Poll::Pending;
   218	                    }
   219	                    // Otherwise, we actually did write something
   220	                    return Poll::Ready(Ok(total_written));
   221	                }
   222	                Poll::Ready(result) => {
   223	                    ref_self.last_unwritten_encrypted_byte = None;
   224	                    match result {
   225	                        Ok(written) => total_written += written,
   226	                        Err(err) => return Poll::Ready(Err(err)),
   227	                    }
   228	                }
   229	            }
   230	        }
   231	
   232	        Poll::Ready(Ok(total_written))
   233	    }
   234	
   235	    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Error>> {
   236	        let ref_self = self.get_mut();
   237	        let write = Pin::new(&mut ref_self.write);
   238	        write.poll_flush(cx)
   239	    }
   240	
   241	    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Result<(), Error>> {
   242	        let ref_self = self.get_mut();
   243	        let write = Pin::new(&mut ref_self.write);
   244	        write.poll_shutdown(cx)
   245	    }
   246	}

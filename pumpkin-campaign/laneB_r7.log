   124	   private BlockState getConnectionState(final BlockGetter level, BlockState state, final BlockPos pos) {
   125	      boolean wasDot = isDot(state);
   126	      state = this.getMissingConnections(level, this.defaultBlockState().setValue(POWER, state.getValue(POWER)), pos);
   127	      if (wasDot && isDot(state)) {
   128	         return state;
   129	      }
   130	
   131	      boolean north = state.getValue(NORTH).isConnected();
   132	      boolean south = state.getValue(SOUTH).isConnected();
   133	      boolean east = state.getValue(EAST).isConnected();
   134	      boolean west = state.getValue(WEST).isConnected();
   135	      boolean northSouthEmpty = !north && !south;
   136	      boolean eastWestEmpty = !east && !west;
   137	      if (!west && northSouthEmpty) {
   138	         state = state.setValue(WEST, RedstoneSide.SIDE);
   139	      }
   140	
   141	      if (!east && northSouthEmpty) {
   142	         state = state.setValue(EAST, RedstoneSide.SIDE);
   143	      }
   144	
   145	      if (!north && eastWestEmpty) {
   146	         state = state.setValue(NORTH, RedstoneSide.SIDE);
   147	      }
   148	
   149	      if (!south && eastWestEmpty) {
   150	         state = state.setValue(SOUTH, RedstoneSide.SIDE);
   151	      }
   152	
   153	      return state;
   154	   }

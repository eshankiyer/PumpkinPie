   396	      } else if (blockState.is(Blocks.REPEATER)) {
   397	         Direction repeaterDirection = blockState.getValue(RepeaterBlock.FACING);
   398	         return repeaterDirection == direction || repeaterDirection.getOpposite() == direction;
   399	      } else {
   400	         return blockState.is(Blocks.OBSERVER) ? direction == blockState.getValue(ObserverBlock.FACING) : blockState.isSignalSource() && direction != null;
   401	      }
   402	   }

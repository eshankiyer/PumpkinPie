   496	    pub index: usize,
   497	    /// Protocol ID for this slot (assigned by screen handler).
   498	    pub id: AtomicU8,
   499	}
   500	
   501	impl BeaconPaymentSlot {
   502	    #[must_use]
   503	    pub fn new(inventory: Arc<dyn Inventory>, index: usize) -> Self {
   504	        Self {
   505	            inventory,
   506	            index,
   507	            id: AtomicU8::new(0),
   508	        }
   509	    }
   510	}
   511	
   512	impl Slot for BeaconPaymentSlot {
   513	    fn get_inventory(&self) -> Arc<dyn Inventory> {
   514	        self.inventory.clone()
   515	    }
   516	
   517	    fn get_index(&self) -> usize {
   518	        self.index
   519	    }
   520	
   521	    fn set_id(&self, id: usize) {
   522	        self.id.store(id as u8, Ordering::Relaxed);
   523	    }
   524	
   525	    /// `BeaconMenu.PaymentSlot.mayPlace` (`BeaconMenu.java:171-174`).
   526	    fn can_insert<'a>(&'a self, stack: &'a ItemStack) -> BoxFuture<'a, bool> {
   527	        Box::pin(async move {
   528	            stack
   529	                .item
   530	                .has_tag(&pumpkin_data::tag::Item::MINECRAFT_BEACON_PAYMENT_ITEMS)
   531	        })
   532	    }
   533	
   534	    fn mark_dirty(&self) -> BoxFuture<'_, ()> {
   535	        Box::pin(async move {
   536	            self.inventory.mark_dirty();
   537	        })
   538	    }
   539	
   540	    /// `BeaconMenu.PaymentSlot.getMaxStackSize` (`BeaconMenu.java:177-179`).
   541	    fn get_max_item_count(&self) -> BoxFuture<'_, u8> {
   542	        Box::pin(async move { 1 })
   543	    }
   544	}

   687	    #[test]
   688	    fn occupant_releases_only_after_min_ticks() {
   689	        let mut occupant = Occupant::of(NbtCompound::new(), "minecraft:bee");
   690	        for _ in 0..=MIN_OCCUPATION_TICKS_NECTARLESS {

+                return;
+            }
+            let item = if args.block.id == Block::BEE_NEST.id {
+                &Item::BEE_NEST
+            } else {
+                &Item::BEEHIVE
+            };
+            let mut components = collect_components_from_block_entity(block_entity.as_ref()).await;

   750	    #[must_use]
   751	    pub fn read_item_stack(compound: &NbtCompound) -> Option<Self> {
   752	        // Get ID, which is a string like "minecraft:diamond_sword"
   753	        let full_id = compound.get_string("id")?;
   754	
   755	        // Remove the "minecraft:" prefix if present
   756	        let registry_key = full_id.strip_prefix("minecraft:").unwrap_or(full_id);
   757	
   758	        // Try to get item by registry key
   759	        let item = Item::from_registry_key(registry_key)?;
   760	
   761	        let count = compound.get_int("count")? as u8;
   762	
   763	        // Create the item stack
   764	        let mut item_stack = Self::new(count, item);
   765	
   766	        // Process any additional data in the components compound
   767	        if let Some(tag) = compound.get_compound("components") {
   768	            for (name, data) in &tag.child_tags {
   769	                if let Some(name) = name.strip_prefix("!") {
   770	                    item_stack
   771	                        .patch
   772	                        .push((DataComponent::try_from_name(name)?, None));
   773	                } else {
   774	                    let id = DataComponent::try_from_name(name)?;
   775	                    item_stack.patch.push((id, Some(read_data(id, data)?)));
   776	                }
   777	            }
   778	        }
   779	
   780	        Some(item_stack)
   781	    }

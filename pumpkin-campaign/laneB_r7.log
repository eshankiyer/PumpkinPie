    31	impl BlockBehaviour for RedstoneWireBlock {
    32	    fn can_place_at(&self, args: CanPlaceAtArgs<'_>) -> bool {
    33	        can_place_at(args.block_accessor, args.position)
    34	    }
    35	
    36	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    37	        Box::pin(async move {
    38	            let mut wire = RedstoneWireProperties::default(args.block);
    39	            wire.power = calculate_power(args.world, args.position).await;
    40	            wire = get_regulated_sides(wire, args.world, args.position).await;
    41	            if is_dot(wire) {
    42	                wire = make_cross(wire.power);
    43	            }
    44	
    45	            wire.to_state_id(args.block)
    46	        })
    47	    }
    48	
    49	    fn get_state_for_neighbor_update<'a>(
    50	        &'a self,
    51	        args: GetStateForNeighborUpdateArgs<'a>,
    52	    ) -> BlockFuture<'a, BlockStateId> {
    53	        Box::pin(async move {
    54	            let mut wire = RedstoneWireProperties::from_state_id(args.state_id, args.block);
    55	            let old_state = wire;
    56	
    57	            let new_side: WireConnection = match args.direction {
    58	                BlockDirection::Up => {
    59	                    return args.state_id;
    60	                }
    61	                BlockDirection::Down => {
    62	                    return get_regulated_sides(wire, args.world, args.position)
    63	                        .await
    64	                        .to_state_id(args.block);
    65	                }
    66	                BlockDirection::North => {
    67	                    let side = get_side(args.world, args.position, BlockDirection::North).await;
    68	                    wire.north = side.to_north();
    69	                    side
    70	                }
    71	                BlockDirection::South => {
    72	                    let side = get_side(args.world, args.position, BlockDirection::South).await;
    73	                    wire.south = side.to_south();
    74	                    side
    75	                }
    76	                BlockDirection::East => {
    77	                    let side = get_side(args.world, args.position, BlockDirection::East).await;
    78	                    wire.east = side.to_east();
    79	                    side
    80	                }
    81	                BlockDirection::West => {
    82	                    let side = get_side(args.world, args.position, BlockDirection::West).await;
    83	                    wire.west = side.to_west();
    84	                    side
    85	                }
    86	            };
    87	
    88	            wire = get_regulated_sides(wire, args.world, args.position).await;
    89	            wire.power = calculate_power(args.world, args.position).await;
    90	
    91	            if is_cross(old_state) && new_side.is_none() {
    92	                return wire.to_state_id(args.block);
    93	            }
    94	            if !is_dot(old_state) && is_dot(wire) {
    95	                let power = wire.power;
    96	                wire = make_cross(power);
    97	            }
    98	            wire.to_state_id(args.block)
    99	        })
   100	    }
   101	
   102	    fn prepare<'a>(&'a self, args: PrepareArgs<'a>) -> BlockFuture<'a, ()> {
   103	        Box::pin(async move {
   104	            let wire_props =
   105	                RedstoneWireLikeProperties::from_state_id(args.state_id, &Block::REDSTONE_WIRE);
   106	
   107	            for direction in BlockDirection::horizontal() {
   108	                let other_block_pos = args.position.offset(direction.to_offset());
   109	                let other_block = args.world.get_block(&other_block_pos);
   110	
   111	                if wire_props.is_side_connected(direction) && other_block != &Block::REDSTONE_WIRE {
   112	                    let up_block_pos = other_block_pos.up();
   113	                    let up_block = args.world.get_block(&up_block_pos);
   114	                    if up_block == &Block::REDSTONE_WIRE {
   115	                        args.world
   116	                            .replace_with_state_for_neighbor_update(
   117	                                &up_block_pos,
   118	                                direction.opposite().to_block_direction(),
   119	                                args.flags,
   120	                            )
   121	                            .await;
   122	                    }
   123	
   124	                    let down_block_pos = other_block_pos.down();
   125	                    let down_block = args.world.get_block(&down_block_pos);
   126	                    if down_block == &Block::REDSTONE_WIRE {
   127	                        args.world
   128	                            .replace_with_state_for_neighbor_update(
   129	                                &down_block_pos,
   130	                                direction.opposite().to_block_direction(),
   131	                                args.flags,
   132	                            )
   133	                            .await;
   134	                    }
   135	                }
   136	            }
   137	            for side_dir in BlockDirection::all() {
   138	                let side_block_pos = args.position.offset(side_dir.to_offset());
   139	                for dir in BlockDirection::all() {
   140	                    if dir.opposite() == side_dir {
   141	                        continue;
   142	                    }
   143	                    let side_neighbor_pos = side_block_pos.offset(dir.to_offset());
   144	                    let side_neighbor_block = args.world.get_block(&side_neighbor_pos);
   145	                    if side_neighbor_block == &Block::REDSTONE_WALL_TORCH
   146	                        || side_neighbor_block == &Block::PISTON
   147	                        || side_neighbor_block == &Block::STICKY_PISTON
   148	                    {
   149	                        args.world
   150	                            .update_neighbor(&side_neighbor_pos, &Block::REDSTONE_WIRE)
   151	                            .await;
   152	                    }
   153	                }
   154	            }
   155	        })
   156	    }
   157	
   158	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
   159	        Box::pin(async move {
   160	            // RedStoneWireBlock.useWithoutItem (vanilla: RedStoneWireBlock.java:490-506)
   161	            // does not toggle the shape when the player may not build.
   162	            if !args.player.abilities.lock().await.allow_modify_world {
   163	                return BlockActionResult::Pass;
   164	            }
   165	
   166	            let state = args.world.get_block_state(args.position);
   167	            let wire = RedstoneWireProperties::from_state_id(state.id, args.block);
   168	            if on_use(wire, args.world, args.position).await {
   169	                BlockActionResult::Success
   170	            } else {
   171	                BlockActionResult::Pass
   172	            }
   173	        })
   174	    }
   175	
   176	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
   177	        Box::pin(async move {
   178	            if can_place_at(args.world.as_ref(), args.position) {
   179	                let state = args.world.get_block_state(args.position);
   180	                let mut wire = RedstoneWireProperties::from_state_id(state.id, args.block);
   181	                let new_power = calculate_power(args.world, args.position).await;
   182	                if wire.power != new_power {
   183	                    wire.power = new_power;
   184	                    args.world
   185	                        .set_block_state(
   186	                            args.position,
   187	                            wire.to_state_id(&Block::REDSTONE_WIRE),
   188	                            BlockFlags::empty(),
   189	                        )
   190	                        .await;
   191	                    RedstoneWireTurbo::update_surrounding_neighbors(args.world, *args.position)
   192	                        .await;
   193	                }
   194	            } else {
   195	                args.world
   196	                    .break_block(args.position, None, BlockFlags::NOTIFY_ALL)
   197	                    .await;
   198	            }
   199	        })
   200	    }

   231	   private void trySpawnDripParticles(final Level level, final BlockPos pos, final BlockState state) {
   232	      if (state.getFluidState().isEmpty() && !(level.getRandom().nextFloat() < 0.3F)) {
   233	         VoxelShape collisionShape = state.getCollisionShape(level, pos);
   234	         double topSideHeight = collisionShape.max(Direction.Axis.Y);
   235	         if (topSideHeight >= 1.0 && !state.is(BlockTags.IMPERMEABLE)) {
   236	            double bottomSideHeight = collisionShape.min(Direction.Axis.Y);
   237	            if (bottomSideHeight > 0.0) {
   238	               this.spawnParticle(level, pos, collisionShape, pos.getY() + bottomSideHeight - 0.05);
   239	            } else {
   240	               BlockPos below = pos.below();
   241	               BlockState belowState = level.getBlockState(below);
   242	               VoxelShape belowShape = belowState.getCollisionShape(level, below);
   243	               double belowTopSideHeight = belowShape.max(Direction.Axis.Y);
   244	               if ((belowTopSideHeight < 1.0 || !belowState.isCollisionShapeFullBlock(level, below)) && belowState.getFluidState().isEmpty()) {
   245	                  this.spawnParticle(level, pos, collisionShape, pos.getY() - 0.05);
   246	               }
   247	            }
   248	         }
   249	      }
   250	   }

+            bees: Cow::Owned(entries
+                .iter()
+                .filter_map(|entry| match entry {
+                    NbtTag::Compound(compound) => Some(compound.clone()),
+                    _ => None,
+                })
+                .collect()),
+        })
+    }
+}

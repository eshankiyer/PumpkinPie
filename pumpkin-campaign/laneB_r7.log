   157	    async fn ensure_listener_registered(&self, world: &Arc<World>) {
   158	        if self.listener_registered.swap(true, Ordering::AcqRel) {
   159	            return;
   160	        }
   161	        let already_present = world
   162	            .game_event_listeners
   163	            .lock()
   164	            .await
   165	            .iter()
   166	            .any(|listener| {
   167	                matches!(
   168	                    listener.listener_source(),
   169	                    crate::world::game_event::PositionSource::Block(pos) if pos == self.position
   170	                )
   171	            });

   202	    fn get_weak_redstone_power<'a>(
   203	        &'a self,
   204	        args: GetRedstonePowerArgs<'a>,
   205	    ) -> BlockFuture<'a, u8> {
   206	        Box::pin(async move {
   207	            let wire = RedstoneWireProperties::from_state_id(args.state.id, args.block);
   208	            let is_connected = args
   209	                .direction
   210	                .opposite()
   211	                .to_horizontal_facing()
   212	                .is_some_and(|f| wire.is_side_connected(f));
   213	            if args.direction == BlockDirection::Up || is_connected {
   214	                wire.power
   215	            } else {
   216	                0
   217	            }
   218	        })
   219	    }

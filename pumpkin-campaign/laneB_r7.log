   490	   @Override
   491	   protected InteractionResult useWithoutItem(
   492	      final BlockState state, final Level level, final BlockPos pos, final Player player, final BlockHitResult hitResult
   493	   ) {
   494	      if (!player.getAbilities().mayBuild) {
   495	         return InteractionResult.PASS;
   496	      }
   497	
   498	      if (isCross(state) || isDot(state)) {
   499	         BlockState newState = isCross(state) ? this.defaultBlockState() : this.crossState;
   500	         newState = newState.setValue(POWER, state.getValue(POWER));
   501	         newState = this.getConnectionState(level, newState, pos);
   502	         if (newState != state) {
   503	            level.setBlock(pos, newState, 3);
   504	            this.updatesOnShapeChange(level, pos, state, newState);
   505	            return InteractionResult.SUCCESS;
   506	         }
   507	      }
   508	
   509	      return InteractionResult.PASS;
   510	   }

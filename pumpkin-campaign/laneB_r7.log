   181	   @VisibleForTesting
   182	   public static <T> DataResult<PalettedContainer<T>> unpack(final Strategy<T> strategy, final PalettedContainerRO.PackedData<T> discData) {
   183	      List<T> paletteEntries = discData.paletteEntries();
   184	      int entryCount = strategy.entryCount();
   185	      Configuration storedConfiguration = strategy.getConfigurationForPaletteSize(paletteEntries.size());
   186	      int bitsOnDisc = storedConfiguration.bitsInStorage();
   187	      if (discData.bitsPerEntry() != -1 && bitsOnDisc != discData.bitsPerEntry()) {
   188	         return DataResult.error(() -> "Invalid bit count, calculated " + bitsOnDisc + ", but container declared " + discData.bitsPerEntry());
   189	      }
   190	
   191	      BitStorage storage;
   192	      Palette<T> palette;
   193	      if (storedConfiguration.bitsInMemory() == 0) {
   194	         palette = storedConfiguration.createPalette(strategy, paletteEntries);
   195	         storage = new ZeroBitStorage(entryCount);
   196	      } else {
   197	         Optional<LongStream> dataOpt = discData.storage();
   198	         if (dataOpt.isEmpty()) {
   199	            return DataResult.error(() -> "Missing values for non-zero storage");
   200	         }
   201	
   202	         long[] data = dataOpt.get().toArray();
   203	
   204	         try {
   205	            if (!storedConfiguration.alwaysRepack() && storedConfiguration.bitsInMemory() == bitsOnDisc) {
   206	               palette = storedConfiguration.createPalette(strategy, paletteEntries);
   207	               storage = new SimpleBitStorage(storedConfiguration.bitsInMemory(), entryCount, data);
   208	            } else {
   209	               Palette<T> oldPalette = new HashMapPalette<>(bitsOnDisc, paletteEntries);
   210	               SimpleBitStorage oldStorage = new SimpleBitStorage(bitsOnDisc, entryCount, data);
   211	               Palette<T> newPalette = storedConfiguration.createPalette(strategy, paletteEntries);
   212	               int[] newContents = reencodeContents(oldStorage, oldPalette, newPalette);
   213	               palette = newPalette;
   214	               storage = new SimpleBitStorage(storedConfiguration.bitsInMemory(), entryCount, newContents);
   215	            }
   216	         } catch (SimpleBitStorage.InitializationException exception) {
   217	            return DataResult.error(() -> "Failed to read PalettedContainer: " + exception.getMessage());
   218	         }
   219	      }
   220	
   221	      return DataResult.success(new PalettedContainer<>(strategy, storedConfiguration, storage, palette));
   222	   }

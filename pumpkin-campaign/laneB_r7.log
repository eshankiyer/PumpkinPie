    70	pub async fn get_redstone_power(
    71	    block: &Block,
    72	    state: &BlockState,
    73	    world: &World,
    74	    pos: &BlockPos,
    75	    facing: BlockDirection,
    76	) -> u8 {
    77	    if state.is_solid_block() {

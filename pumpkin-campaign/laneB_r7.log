    15	/// Unlike vanilla's absolute `anger_end_time` game tick, this tracks a remaining-tick
    16	/// counter decremented in `tick`.
    17	pub struct PersistentAnger {
    18	    angry_at: Mutex<Option<Uuid>>,
    19	    remaining_ticks: AtomicI32,
    20	}
    21	
    22	impl Default for PersistentAnger {
    23	    fn default() -> Self {
    24	        Self {
    25	            angry_at: Mutex::new(None),
    26	            remaining_ticks: AtomicI32::new(0),
    27	        }
    28	    }
    29	}
    30	
    31	impl PersistentAnger {
    32	    pub async fn angry_at(&self) -> Option<Uuid> {
    33	        *self.angry_at.lock().await
    34	    }
    35	
    36	    #[must_use]
    37	    pub fn is_angry(&self) -> bool {
    38	        self.remaining_ticks.load(Relaxed) > 0
    39	    }
    40	
    41	    pub async fn is_angry_at(&self, target: Uuid) -> bool {
    42	        self.is_angry() && *self.angry_at.lock().await == Some(target)
    43	    }
    44	
    45	    /// Vanilla `NeutralMob.isAngryAtAllPlayers`: true while angry with no specific grudge
    46	    /// target, gated behind the `universal_anger` game rule (checked by the caller).
    47	    pub async fn is_angry_at_all_players(&self, universal_anger_rule: bool) -> bool {
    48	        universal_anger_rule && self.is_angry() && self.angry_at.lock().await.is_none()
    49	    }
    50	
    51	    /// Vanilla `NeutralMob.forgetCurrentTargetAndRefreshUniversalAnger`: `stopBeingAngry()`
    52	    /// then `startPersistentAngerTimer()`, leaving `angry_at` cleared so `isAngryAtAllPlayers`
    53	    /// becomes true for the duration of the new timer.
    54	    pub async fn forget_current_target_and_refresh_universal_anger(&self) {
    55	        self.stop_being_angry().await;
    56	        self.start_timer();
    57	    }
    58	
    59	    pub async fn set_angry_at(&self, target: Option<Uuid>) {
    60	        *self.angry_at.lock().await = target;
    61	    }
    62	
    63	    /// Vanilla `startPersistentAngerTimer`: `setTimeToRemainAngry(PERSISTENT_ANGER_TIME.sample(random))`.
    64	    pub fn start_timer(&self) {
    65	        let ticks =
    66	            rand::rng().random_range(PERSISTENT_ANGER_MIN_TICKS..=PERSISTENT_ANGER_MAX_TICKS);
    67	        self.remaining_ticks.store(ticks, Relaxed);
    68	    }
    69	
    70	    /// Vanilla `stopBeingAngry`: clears target and anger end time (last-hurt-by/target
    71	    /// clearing is the consumer's responsibility since it touches entity/AI state).
    72	    pub async fn stop_being_angry(&self) {
    73	        *self.angry_at.lock().await = None;
    74	        self.remaining_ticks.store(0, Relaxed);
    75	    }
    76	
    77	    /// Per-tick decrement, auto-clearing the target once the timer expires.
    78	    pub async fn tick(&self) {
    79	        let prev = self.remaining_ticks.fetch_sub(1, Relaxed);
    80	        if prev <= 0 {
    81	            self.remaining_ticks.store(0, Relaxed);
    82	        } else if prev == 1 {
    83	            *self.angry_at.lock().await = None;
    84	        }
    85	    }
    86	
    87	    // Vanilla `NeutralMob.java:44-46` legacy read path: a plain int holding the
    88	    // remaining-ticks count (`AngerTime` -> `setTimeToRemainAngry`), unlike the modern
    89	    // `anger_end_time` long which stores an absolute game tick this primitive doesn't track.
    90	    pub async fn write_nbt(&self, nbt: &mut NbtCompound) {
    91	        nbt.put_int("AngerTime", self.remaining_ticks.load(Relaxed).max(0));
    92	        if let Some(uuid) = self.angry_at().await {
    93	            nbt.put_uuid("angry_at", uuid);
    94	        }
    95	    }
    96	
    97	    pub async fn read_nbt(&self, nbt: &NbtCompound) {
    98	        self.remaining_ticks
    99	            .store(nbt.get_int("AngerTime").unwrap_or(0).max(0), Relaxed);
   100	        *self.angry_at.lock().await = nbt.get_uuid("angry_at");

   203	   @Override
   204	   protected void spreadTo(final LevelAccessor level, final BlockPos pos, final BlockState state, final Direction direction, final FluidState target) {
   205	      if (direction == Direction.DOWN) {
   206	         FluidState fluidState = level.getFluidState(pos);
   207	         if (this.is(FluidTags.LAVA) && fluidState.is(FluidTags.WATER)) {
   208	            if (state.getBlock() instanceof LiquidBlock) {
   209	               level.setBlock(pos, Blocks.STONE.defaultBlockState(), 3);
   210	            }
   211	
   212	            this.fizz(level, pos);
   213	            return;
   214	         }
   215	      }
   216	
   217	      super.spreadTo(level, pos, state, direction, target);
   218	   }

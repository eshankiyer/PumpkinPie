    80	   @Override
    81	   public void randomTick(final ServerLevel level, final BlockPos pos, final FluidState fluidState, final RandomSource random) {
    82	      if (level.canSpreadFireAround(pos)) {
    83	         int passes = random.nextInt(3);
    84	         if (passes > 0) {
    85	            BlockPos testPos = pos;
    86	
    87	            for (int pass = 0; pass < passes; pass++) {
    88	               testPos = testPos.offset(random.nextInt(3) - 1, 1, random.nextInt(3) - 1);
    89	               if (!level.isLoaded(testPos)) {
    90	                  return;
    91	               }
    92	
    93	               BlockState blockState = level.getBlockState(testPos);
    94	               if (blockState.isAir()) {
    95	                  if (this.hasFlammableNeighbours(level, testPos)) {
    96	                     level.setBlockAndUpdate(testPos, BaseFireBlock.getState(level, testPos));
    97	                     return;
    98	                  }
    99	               } else if (blockState.blocksMotion()) {
   100	                  return;
   101	               }
   102	            }
   103	         } else {
   104	            for (int i = 0; i < 3; i++) {
   105	               BlockPos testPos = pos.offset(random.nextInt(3) - 1, 0, random.nextInt(3) - 1);
   106	               if (!level.isLoaded(testPos)) {
   107	                  return;
   108	               }
   109	
   110	               if (level.isEmptyBlock(testPos.above()) && this.isFlammable(level, testPos)) {
   111	                  level.setBlockAndUpdate(testPos.above(), BaseFireBlock.getState(level, testPos));
   112	               }
   113	            }
   114	         }
   115	      }
   116	   }

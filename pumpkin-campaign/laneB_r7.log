   351	    /// `BeehiveBlockEntity.isFireNearby`.
   352	    #[must_use]
   353	    pub fn is_fire_nearby(&self, world: &World) -> bool {
   354	        for x in -1..=1 {
   355	            for y in -1..=1 {
   356	                for z in -1..=1 {
   357	                    let pos = BlockPos::new(
   358	                        self.position.0.x + x,
   359	                        self.position.0.y + y,
   360	                        self.position.0.z + z,
   361	                    );
   362	                    let block = world.get_block(&pos);
   363	                    if block.id == Block::FIRE.id || block.id == Block::SOUL_FIRE.id {
   364	                        return true;
   365	                    }
   366	                }
   367	            }
   368	        }
   369	        false
   370	    }
   371	
   372	    /// `BeehiveBlockEntity.storeBee`.
   373	    pub async fn store_bee(&self, occupant: Occupant) {
   374	        self.bees.lock().await.push(occupant);
   375	        self.mark_dirty();
   376	    }
   377	
   378	    /// `BeehiveBlockEntity.addOccupant`: stores the bee's NBT and removes the live entity.
   379	    ///
   380	    /// Returns `false` when the hive is already full, in which case the bee is left alone.
   381	    pub async fn add_occupant(
   382	        &self,
   383	        world: &Arc<World>,
   384	        bee: &Arc<dyn EntityBase>,
   385	        bee_flower_pos: Option<BlockPos>,
   386	    ) -> bool {
   387	        if self.is_full().await {
   388	            return false;
   389	        }
   390	
   391	        let mut entity_data = NbtCompound::new();
   392	        if let Some(living) = bee.get_living_entity() {
   393	            living.write_nbt(&mut entity_data).await;
   394	        }
   395	        bee.write_nbt(&mut entity_data).await;
   396	        self.store_bee(Occupant::of(entity_data, "minecraft:bee"))
   397	            .await;
   398	
   399	        if let Some(flower_pos) = bee_flower_pos {
   400	            let mut saved = self.flower_pos.lock().await;
   401	            if saved.is_none() || rand::rng().random::<bool>() {
   402	                *saved = Some(flower_pos);
   403	            }
   404	        }
   405	
   406	        world.play_sound(
   407	            Sound::BlockBeehiveEnter,
   408	            SoundCategory::Blocks,
   409	            &self.position.to_f64(),
   410	        );
   411	        world.remove_entity(bee.as_ref()).await;
   412	        true
   413	    }
   414	
   415	    /// `BeehiveBlockEntity.emptyAllLivingFromHive`.
   416	    ///
   417	    /// `player` angers the released bees at the harvesting player, or, when the hive is
   418	    /// sedated by a campfire below it, keeps them out of the hive for 400 ticks instead.
   419	    pub async fn empty_all_living_from_hive(
   420	        &self,
   421	        world: &Arc<World>,
   422	        player: Option<&Arc<Player>>,
   423	        release_status: BeeReleaseStatus,
   424	    ) -> Vec<Arc<dyn EntityBase>> {
   425	        let sedated = self.is_sedated(world);
   426	        let released = self.release_all_occupants(world, release_status).await;
   427	
   428	        if let Some(player) = player {
   429	            let player_pos = player.get_entity().pos.load();
   430	            for entity in &released {
   431	                let Some(bee) = crate::entity::passive::bee::as_bee(entity) else {
   432	                    continue;
   433	                };
   434	                if entity
   435	                    .get_entity()
   436	                    .pos
   437	                    .load()
   438	                    .squared_distance_to_vec(&player_pos)
   439	                    > 16.0
   440	                {
   441	                    continue;
   442	                }
   443	                if sedated {
   444	                    bee.set_stay_out_of_hive_countdown(SEDATED_STAY_OUT_TICKS);
   445	                } else {
   446	                    bee.set_mob_target(Some(player.clone() as Arc<dyn EntityBase>))
   447	                        .await;
   448	                }
   449	            }
   450	        }
   451	
   452	        released
   453	    }
   454	
   455	    /// Removes the occupants at `indices` from the stored list.
   456	    ///
   457	    /// Releasing has to await (it spawns an entity), so the list cannot be held locked across
   458	    /// it, and a concurrent `add_occupant` may push in the meantime. `add_occupant` only ever
   459	    /// pushes, so the snapshot indices stay valid and the released entries are removed
   460	    /// back-to-front rather than the whole vector being overwritten -- overwriting would
   461	    /// silently drop a bee that entered during the release window, after `add_occupant` had
   462	    /// already removed its live entity.
   463	    async fn remove_released(&self, indices: &[usize]) {
   464	        if indices.is_empty() {
   465	            return;
   466	        }
   467	        let mut bees = self.bees.lock().await;
   468	        for &index in indices.iter().rev() {
   469	            if index < bees.len() {
   470	                bees.remove(index);
   471	            }
   472	        }
   473	        drop(bees);
   474	        self.mark_dirty();
   475	    }
   476	
   477	    /// `BeehiveBlockEntity.releaseAllOccupants`.
   478	    async fn release_all_occupants(
   479	        &self,
   480	        world: &Arc<World>,
   481	        release_status: BeeReleaseStatus,
   482	    ) -> Vec<Arc<dyn EntityBase>> {
   483	        let saved_flower_pos = *self.flower_pos.lock().await;
   484	        let occupants: Vec<Occupant> = self.bees.lock().await.clone();
   485	
   486	        let mut spawned = Vec::new();
   487	        let mut released = Vec::new();
   488	        for (index, occupant) in occupants.iter().enumerate() {
   489	            if let Some(entity) = self
   490	                .release_occupant(world, occupant, release_status, saved_flower_pos)
   491	                .await
   492	            {
   493	                spawned.push(entity);
   494	                released.push(index);
   495	            }
   496	        }
   497	
   498	        self.remove_released(&released).await;
   499	        spawned
   500	    }
   501	
   502	    /// `BeehiveBlockEntity.tickOccupants`.
   503	    async fn tick_occupants(&self, world: &Arc<World>) {
   504	        let saved_flower_pos = *self.flower_pos.lock().await;
   505	
   506	        // The counters are advanced under the lock so a concurrent `add_occupant` cannot lose
   507	        // a tick; the releases themselves happen after it is dropped.
   508	        let ready: Vec<(usize, Occupant)> = {
   509	            let mut bees = self.bees.lock().await;
   510	            let mut ready = Vec::new();
   511	            for (index, occupant) in bees.iter_mut().enumerate() {
   512	                if occupant.tick() {
   513	                    ready.push((index, occupant.clone()));
   514	                }
   515	            }
   516	            ready
   517	        };
   518	        if ready.is_empty() {
   519	            return;
   520	        }
   521	
   522	        let mut released = Vec::new();
   523	        for (index, occupant) in &ready {
   524	            let release_status = if occupant.has_nectar() {
   525	                BeeReleaseStatus::HoneyDelivered
   526	            } else {
   527	                BeeReleaseStatus::BeeReleased
   528	            };
   529	            if self
   530	                .release_occupant(world, occupant, release_status, saved_flower_pos)
   531	                .await
   532	                .is_some()
   533	            {
   534	                released.push(*index);
   535	            }
   536	        }
   537	
   538	        self.remove_released(&released).await;
   539	    }
   540	
   541	    /// `BeehiveBlockEntity.releaseOccupant`.
   542	    ///
   543	    /// Returns the spawned entity, or `None` when the release is refused (night/rain outside an
   544	    /// emergency, a blocked hive mouth, or an occupant whose stored type is not a bee).
   545	    async fn release_occupant(
   546	        &self,
   547	        world: &Arc<World>,
   548	        occupant: &Occupant,
   549	        release_status: BeeReleaseStatus,
   550	        saved_flower_pos: Option<BlockPos>,
   551	    ) -> Option<Arc<dyn EntityBase>> {
   552	        let emergency = release_status == BeeReleaseStatus::Emergency;
   553	        if !emergency && bees_stay_in_hive(world).await {
   554	            return None;
   555	        }
   556	
   557	        let (block, state) = world.get_block_and_state(&self.position);
   558	        if !is_beehive(block) {
   559	            return None;
   560	        }
   561	        let props = BeeNestLikeProperties::from_state_id(state.id, block);
   562	        let facing = props.facing.to_offset();
   563	        let facing_pos = BlockPos::new(
   564	            self.position.0.x + facing.x,
   565	            self.position.0.y + facing.y,
   566	            self.position.0.z + facing.z,
   567	        );
   568	        let front_blocked = world.get_block_state(&facing_pos).is_solid();
   569	        if front_blocked && !emergency {
   570	            return None;
   571	        }
   572	
   573	        let id = occupant.entity_data.get_string("id")?;
   574	        let entity_type = EntityType::from_name(id.strip_prefix("minecraft:").unwrap_or(id))?;
   575	        if entity_type.id != EntityType::BEE.id {
   576	            return None;
   577	        }
   578	
   579	        let width = f64::from(entity_type.dimension[0]);
   580	        let height = f64::from(entity_type.dimension[1]);
   581	        let delta = if front_blocked {
   582	            0.0
   583	        } else {
   584	            0.55 + width / 2.0
   585	        };
   586	        let spawn_pos = Vector3::new(
   587	            f64::from(self.position.0.x) + 0.5 + delta * f64::from(facing.x),
   588	            f64::from(self.position.0.y) + 0.5 - height / 2.0,
   589	            f64::from(self.position.0.z) + 0.5 + delta * f64::from(facing.z),
   590	        );
   591	
   592	        let entity = from_type(entity_type, spawn_pos, world, uuid::Uuid::new_v4());
   593	        if let Some(living) = entity.get_living_entity() {
   594	            living.read_nbt_non_mut(&occupant.entity_data).await;
   595	        }
   596	        entity.read_nbt_non_mut(&occupant.entity_data).await;
   597	        // `read_nbt_non_mut` restores a saved position; the occupant NBT has none, but the
   598	        // living read still normalises the entity, so the hive-mouth spawn is applied after it.
   599	        entity.get_entity().pos.store(spawn_pos);
   600	        entity.get_entity().velocity.store(Vector3::default());
   601	
   602	        if let Some(bee) = crate::entity::passive::bee::as_bee(&entity) {
   603	            bee.set_hive_pos(Some(self.position));
   604	            if let Some(flower_pos) = saved_flower_pos
   605	                && bee.flower_pos.load().is_none()
   606	                && rand::rng().random::<f32>() < 0.9
   607	            {
   608	                bee.flower_pos.store(Some(flower_pos));
   609	            }
   610	
   611	            if release_status == BeeReleaseStatus::HoneyDelivered {
   612	                bee.drop_off_nectar();
   613	                self.grow_honey(world, block, state.id).await;
   614	            }
   615	        }
   616	
   617	        world.play_sound(
   618	            Sound::BlockBeehiveExit,
   619	            SoundCategory::Blocks,
   620	            &self.position.to_f64(),
   621	        );
   622	        world.spawn_entity(entity.clone()).await;
   623	        Some(entity)
   624	    }
   625	
   626	    /// The honey-level half of `BeehiveBlockEntity.releaseOccupant`: `+1`, or `+2` on a
   627	    /// 1-in-100 roll, clamped to `MAX_HONEY_LEVELS`.
   628	    async fn grow_honey(&self, world: &Arc<World>, block: &Block, state_id: BlockStateId) {
   629	        let mut props = BeeNestLikeProperties::from_state_id(state_id, block);
   630	        if props.honey_level >= MAX_HONEY_LEVELS {
   631	            return;
   632	        }
   633	        let mut increase = if rand::rng().random_range(0..100) == 0 {
   634	            2
   635	        } else {
   636	            1
   637	        };
   638	        if props.honey_level + increase > MAX_HONEY_LEVELS {
   639	            increase -= 1;
   640	        }
   641	        props.honey_level += increase;
   642	        world
   643	            .set_block_state(
   644	                &self.position,
   645	                props.to_state_id(block),
   646	                BlockFlags::NOTIFY_ALL,
   647	            )
   648	            .await;
   649	    }
   650	}

   192	   private static boolean releaseOccupant(
   193	      final Level level,
   194	      final BlockPos blockPos,
   195	      final BlockState state,
   196	      final BeehiveBlockEntity.Occupant beeData,
   197	      final @Nullable List<Entity> spawned,
   198	      final BeehiveBlockEntity.BeeReleaseStatus releaseStatus,
   199	      final @Nullable BlockPos savedFlowerPos
   200	   ) {
   201	      if (level.environmentAttributes().getValue(EnvironmentAttributes.BEES_STAY_IN_HIVE, blockPos)
   202	         && releaseStatus != BeehiveBlockEntity.BeeReleaseStatus.EMERGENCY) {
   203	         return false;
   204	      }
   205	
   206	      Direction facing = state.getValue(BeehiveBlock.FACING);
   207	      BlockPos facingPos = blockPos.relative(facing);
   208	      boolean frontBlocked = !level.getBlockState(facingPos).getCollisionShape(level, facingPos).isEmpty();
   209	      if (frontBlocked && releaseStatus != BeehiveBlockEntity.BeeReleaseStatus.EMERGENCY) {
   210	         return false;
   211	      }
   212	
   213	      Entity entity = beeData.createEntity(level, blockPos);
   214	      if (entity != null) {
   215	         if (entity instanceof Bee bee) {
   216	            RandomSource random = level.getRandom();
   217	            if (savedFlowerPos != null && !bee.hasSavedFlowerPos() && random.nextFloat() < 0.9F) {
   218	               bee.setSavedFlowerPos(savedFlowerPos);
   219	            }
   220	
   221	            if (releaseStatus == BeehiveBlockEntity.BeeReleaseStatus.HONEY_DELIVERED) {
   222	               bee.dropOffNectar();
   223	               if (state.is(BlockTags.BEEHIVES, s -> s.hasProperty(BeehiveBlock.HONEY_LEVEL))) {
   224	                  int honeyLevel = getHoneyLevel(state);
   225	                  if (honeyLevel < 5) {
   226	                     int levelIncrease = random.nextInt(100) == 0 ? 2 : 1;
   227	                     if (honeyLevel + levelIncrease > 5) {
   228	                        levelIncrease--;
   229	                     }
   230	
   231	                     level.setBlockAndUpdate(blockPos, state.setValue(BeehiveBlock.HONEY_LEVEL, honeyLevel + levelIncrease));
   232	                  }
   233	               }
   234	            }
   235	
   236	            if (spawned != null) {
   237	               spawned.add(bee);
   238	            }
   239	
   240	            float bbWidth = entity.getBbWidth();
   241	            double delta = frontBlocked ? 0.0 : 0.55 + bbWidth / 2.0F;
   242	            double spawnX = blockPos.getX() + 0.5 + delta * facing.getStepX();
   243	            double spawnY = blockPos.getY() + 0.5 - entity.getBbHeight() / 2.0F;
   244	            double spawnZ = blockPos.getZ() + 0.5 + delta * facing.getStepZ();
   245	            entity.snapTo(spawnX, spawnY, spawnZ, entity.getYRot(), entity.getXRot());
   246	         }
   247	
   248	         level.playSound(null, blockPos, SoundEvents.BEEHIVE_EXIT, SoundSource.BLOCKS, 1.0F, 1.0F);
   249	         level.gameEvent(GameEvent.BLOCK_CHANGE, blockPos, GameEvent.Context.of(entity, level.getBlockState(blockPos)));
   250	         return level.addFreshEntity(entity);
   251	      } else {
   252	         return false;
   253	      }
   254	   }

   512	   private void updatesOnShapeChange(final Level level, final BlockPos pos, final BlockState oldState, final BlockState newState) {
   513	      Orientation orientation = ExperimentalRedstoneUtils.initialOrientation(level, null, Direction.UP);
   514	
   515	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   516	         BlockPos relativePos = pos.relative(direction);
   517	         if (oldState.getValue(PROPERTY_BY_DIRECTION.get(direction)).isConnected() != newState.getValue(PROPERTY_BY_DIRECTION.get(direction)).isConnected()
   518	            && level.getBlockState(relativePos).isRedstoneConductor(level, relativePos)) {
   519	            level.updateNeighborsAtExceptFromFacing(
   520	               relativePos, newState.getBlock(), direction.getOpposite(), ExperimentalRedstoneUtils.withFront(orientation, direction)
   521	            );
   522	         }
   523	      }
   524	   }

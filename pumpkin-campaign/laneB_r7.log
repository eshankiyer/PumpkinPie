   542	    /// `BeehiveBlockEntity.tickOccupants`.
   543	    async fn tick_occupants(&self, world: &Arc<World>) {
   544	        let saved_flower_pos = *self.flower_pos.lock().await;
   545	
   546	        // The counters are advanced under the lock so a concurrent `add_occupant` cannot lose
   547	        // a tick; the releases themselves happen after it is dropped.
   548	        let ready: Vec<(usize, Occupant)> = {
   549	            let mut bees = self.bees.lock().await;
   550	            let mut ready = Vec::new();
   551	            for (index, occupant) in bees.iter_mut().enumerate() {
   552	                if occupant.tick() {
   553	                    ready.push((index, occupant.clone()));
   554	                }
   555	            }
   556	            ready
   557	        };
   558	        if ready.is_empty() {
   559	            return;
   560	        }
   561	
   562	        let mut released = Vec::new();
   563	        for (index, occupant) in &ready {
   564	            let release_status = if occupant.has_nectar() {
   565	                BeeReleaseStatus::HoneyDelivered
   566	            } else {
   567	                BeeReleaseStatus::BeeReleased
   568	            };
   569	            if self
   570	                .release_occupant(world, occupant, release_status, saved_flower_pos, None)
   571	                .await
   572	                .is_some()
   573	            {
   574	                released.push(*index);
   575	            }
   576	        }
   577	
   578	        self.remove_released(&released).await;
   579	    }

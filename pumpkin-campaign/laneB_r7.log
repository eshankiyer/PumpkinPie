  2678	        // async AI boundary so the synchronous MoveControl tick can use the same evaluator.
  2747	        if mob.should_tick_brain()
  2748	            && let Some(brain) = &mob_entity.brain
  2749	        {
  2750	            let game_time = mob_entity
  2751	                .living_entity
  2752	                .entity
  2753	                .world
  2754	                .load_full()
  2755	                .get_world_age()
  2756	                .await;
  2757	            brain.tick(mob, game_time).await;
  2758	        }

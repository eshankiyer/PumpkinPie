   168	/// `BeehiveBlock.angerNearbyBees`: every bee within the box that has no target picks a random
   169	/// nearby player to be angry at.
   170	///
   171	/// Reduction: Pumpkin's entity queries are spherical, so the 8/6/8 box becomes a radius-8
   172	/// sphere. That is a superset on the Y axis by at most two blocks.
   173	async fn anger_nearby_bees(world: &Arc<World>, position: &BlockPos) {
   174	    let centre = position.to_f64();
   175	    let players = world.get_nearby_players(centre, ANGER_RADIUS);
   176	    if players.is_empty() {
   177	        return;
   178	    }
   179	
   180	    for entity in world
   181	        .get_nearby_entities(centre, ANGER_RADIUS)
   182	        .into_values()
   183	    {
   184	        let Some(bee) = as_bee(&entity) else {
   185	            continue;
   186	        };
   187	        if bee.mob_entity.get_target().await.is_some() {
   188	            continue;
   189	        }
   190	        let index = rand::rng().random_range(0..players.len());
   191	        let target: Arc<dyn EntityBase> = players[index].clone();
   192	        bee.set_mob_target(Some(target)).await;
   193	    }
   194	}


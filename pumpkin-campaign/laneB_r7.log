   452	            fluidState = newFluidState;
   453	            blockState = fluidState.createLegacyBlock();
   454	            level.setBlock(pos, blockState, 3);
   455	            level.scheduleTick(pos, fluidState.getType(), tickDelay);
   456	         }
   457	      }
   458	
   459	      this.spread(level, pos, blockState, fluidState);
   460	   }

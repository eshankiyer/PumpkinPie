   228	   private void merge(final ExperienceOrb orb) {
   229	      this.count = this.count + orb.count;
   230	      this.age = Math.min(this.age, orb.age);
   230	      this.age = Math.min(this.age, orb.age);
   231	      orb.discard();
   232	   }

   206	   private static boolean tryMergeToExisting(final ServerLevel level, final Vec3 pos, final int value) {
   207	      AABB box = AABB.ofSize(pos, 1.0, 1.0, 1.0);
   208	      int id = level.getRandom().nextInt(40);
   209	      List<ExperienceOrb> orbs = level.getEntities(EntityTypeTest.forClass(ExperienceOrb.class), box, orbx -> canMerge(orbx, id, value));
   210	      if (!orbs.isEmpty()) {
   211	         ExperienceOrb orb = orbs.get(0);
   212	         orb.count++;
   213	         orb.age = 0;
   214	         return true;
   215	      } else {
   216	         return false;
   217	      }
   218	   }

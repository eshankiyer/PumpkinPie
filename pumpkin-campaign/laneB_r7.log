   451	pub async fn get_regulated_sides(
   452	    wire: RedstoneWireProperties,
   453	    world: &World,
   454	    pos: &BlockPos,
   455	) -> RedstoneWireProperties {
   456	    let mut state = get_all_sides(wire, world, pos).await;
   457	    if is_dot(wire) && is_dot(state) {
   458	        return state;
   459	    }
   460	    let north_none = state.north == NorthRedstone::None;
   461	    let south_none = state.south == SouthRedstone::None;
   462	    let east_none = state.east == EastRedstone::None;
   463	    let west_none = state.west == WestRedstone::None;
   464	    let north_south_none = north_none && south_none;
   465	    let east_west_none = east_none && west_none;
   466	    if north_none && east_west_none {
   467	        state.north = NorthRedstone::Side;
   468	    }
   469	    if south_none && east_west_none {
   470	        state.south = SouthRedstone::Side;
   471	    }
   472	    if east_none && north_south_none {
   473	        state.east = EastRedstone::Side;
   474	    }
   475	    if west_none && north_south_none {
   476	        state.west = WestRedstone::Side;
   477	    }
   478	    state
   479	}

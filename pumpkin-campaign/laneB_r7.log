   652	#[cfg(test)]
   653	mod tests {
   654	    use super::{MIN_OCCUPATION_TICKS_NECTAR, MIN_OCCUPATION_TICKS_NECTARLESS, Occupant};
   655	    use pumpkin_nbt::compound::NbtCompound;
   656	
   657	    #[test]
   658	    fn occupant_min_ticks_depends_on_nectar() {
   659	        let mut with_nectar = NbtCompound::new();
   660	        with_nectar.put_bool("HasNectar", true);
   661	        assert_eq!(
   662	            Occupant::of(with_nectar, "minecraft:bee").min_ticks_in_hive,
   663	            MIN_OCCUPATION_TICKS_NECTAR
   664	        );
   665	        assert_eq!(
   666	            Occupant::of(NbtCompound::new(), "minecraft:bee").min_ticks_in_hive,
   667	            MIN_OCCUPATION_TICKS_NECTARLESS
   668	        );
   669	    }
   670	
   671	    #[test]
   672	    fn occupant_of_strips_identity_tags() {
   673	        let mut nbt = NbtCompound::new();
   674	        nbt.put_uuid("UUID", uuid::Uuid::new_v4());
   675	        nbt.put(
   676	            "hive_pos",
   677	            pumpkin_nbt::tag::NbtTag::IntArray(vec![1, 2, 3]),
   678	        );
   679	        nbt.put_bool("HasStung", true);
   680	        let occupant = Occupant::of(nbt, "minecraft:bee");
   681	        assert!(!occupant.entity_data.has("UUID"));
   682	        assert!(!occupant.entity_data.has("hive_pos"));
   683	        assert_eq!(occupant.entity_data.get_bool("HasStung"), Some(true));
   684	        assert_eq!(occupant.entity_data.get_string("id"), Some("minecraft:bee"));
   685	    }

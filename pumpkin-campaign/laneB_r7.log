   231	    /// Tries to take a stack in the given range.
   232	    ///
   233	    /// Returns `None` if can't take items or if slot is empty.
   234	    /// For result slots, cannot take partial stacks.
   235	    ///
   236	    /// Mojang name: `tryRemove`
   237	    fn try_take_stack_range<'a>(
   238	        &'a self,
   239	        min: u8,
   240	        max: u8,
   241	        player: &'a dyn InventoryPlayer,
   242	    ) -> BoxFuture<'a, Option<ItemStack>> {
   243	        // Default implementation logic:
   244	        Box::pin(async move {
   245	            if !self.can_take_items(player).await {
   246	                return None;
   247	            }
   248	            if !self.allow_modification(player).await
   249	                && self.get_cloned_stack().await.item_count > max
   250	            {
   251	                // If the slot is not allowed to be modified, we cannot take a partial stack from it.
   252	                return None;
   253	            }
   254	            let min = min.min(max);
   255	            let stack = self.take_stack(min).await;
   256	
   257	            if stack.is_empty() {
   258	                None
   259	            } else {
   260	                if self.get_cloned_stack().await.is_empty() {
   260	                if self.get_cloned_stack().await.is_empty() {
   261	                    self.set_stack_prev(ItemStack::EMPTY.clone(), stack.clone())
   262	                        .await;
   263	                }
   264	
   265	                Some(stack)
   266	            }
   267	        })
   268	    }

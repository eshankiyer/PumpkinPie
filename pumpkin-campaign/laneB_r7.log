  6673	    pub fn get_fluid(&self, position: &BlockPos) -> &'static pumpkin_data::fluid::Fluid {
  6674	        let id = self.get_block_state_id(position);
  6675	        if Block::from_state_id(id) == &Block::BUBBLE_COLUMN {
  6676	            return Fluid::FLOWING_WATER.to_flowing();
  6677	        }
  6678	        let fluid = Fluid::from_state_id(id).ok_or(&Fluid::EMPTY);
  6679	        if let Ok(fluid) = fluid {
  6680	            return fluid.to_flowing();
  6681	        }
  6682	        let block = Block::from_state_id(id);
  6683	        // `SeagrassBlock.getFluidState` (SeagrassBlock.java:85-88) and
  6684	        // `TallSeagrassBlock.getFluidState` (TallSeagrassBlock.java:78-80) always report a full
  6685	        // water source; neither block has a `waterlogged` property to derive the fluid from.
  6686	        // Like the waterlogged path below, water presence is reported as FLOWING_WATER.
  6687	        if block.name == "seagrass" || block.name == "tall_seagrass" {
  6688	            return &Fluid::FLOWING_WATER;
  6689	        }
  6690	        block
  6691	            .properties(id)
  6692	            .and_then(|props| {
  6693	                props
  6694	                    .to_props()
  6695	                    .into_iter()
  6696	                    .find(|p| p.0 == "waterlogged")
  6697	                    .map(|(_, value)| {
  6698	                        if value == "true" {
  6699	                            &Fluid::FLOWING_WATER
  6700	                        } else {
  6701	                            &Fluid::EMPTY
  6702	                        }
  6703	                    })
  6704	            })
  6705	            .unwrap_or(&Fluid::EMPTY)
  6706	    }

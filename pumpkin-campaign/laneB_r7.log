    54	   @Override
    55	   public Vec3 getFlow(final BlockGetter level, final BlockPos pos, final FluidState fluidState) {
    56	      double flowX = 0.0;
    57	      double flowZ = 0.0;
    58	      BlockPos.MutableBlockPos blockPos = new BlockPos.MutableBlockPos();
    59	
    60	      for (Direction direction : Direction.Plane.HORIZONTAL) {
    61	         blockPos.setWithOffset(pos, direction);
    62	         FluidState neighbourFluid = level.getFluidState(blockPos);
    63	         if (this.affectsFlow(neighbourFluid)) {
    64	            float neighborHeight = neighbourFluid.getOwnHeight();
    65	            float distance = 0.0F;
    66	            if (neighborHeight == 0.0F) {
    67	               if (!level.getBlockState(blockPos).blocksMotion()) {
    68	                  BlockPos neighborPos = blockPos.below();
    69	                  FluidState belowNeighborState = level.getFluidState(neighborPos);
    70	                  if (this.affectsFlow(belowNeighborState)) {
    71	                     neighborHeight = belowNeighborState.getOwnHeight();
    72	                     if (neighborHeight > 0.0F) {
    73	                        distance = fluidState.getOwnHeight() - (neighborHeight - 0.8888889F);
    74	                     }
    75	                  }
    76	               }
    77	            } else if (neighborHeight > 0.0F) {
    78	               distance = fluidState.getOwnHeight() - neighborHeight;
    79	            }
    80	
    81	            if (distance != 0.0F) {
    82	               flowX += direction.getStepX() * distance;
    83	               flowZ += direction.getStepZ() * distance;
    84	            }
    85	         }
    86	      }
    87	
    88	      Vec3 flow = new Vec3(flowX, 0.0, flowZ);
    89	      if (fluidState.getValue(FALLING)) {
    90	         for (Direction direction : Direction.Plane.HORIZONTAL) {
    91	            blockPos.setWithOffset(pos, direction);
    92	            if (this.isSolidFace(level, blockPos, direction) || this.isSolidFace(level, blockPos.above(), direction)) {
    93	               flow = flow.normalize().add(0.0, -6.0, 0.0);
    94	               break;
    95	            }
    96	         }
    97	      }
    98	
    99	      return flow.normalize();
   100	   }
   101	
   102	   private boolean affectsFlow(final FluidState neighbourFluid) {
   103	      return neighbourFluid.isEmpty() || neighbourFluid.getType().isSame(this);
   104	   }
   105	
   106	   protected boolean isSolidFace(final BlockGetter level, final BlockPos pos, final Direction direction) {
   107	      BlockState state = level.getBlockState(pos);
   108	      FluidState fluidState = level.getFluidState(pos);
   109	      if (fluidState.getType().isSame(this)) {
   110	         return false;
   111	      } else if (direction == Direction.UP) {
   112	         return true;
   113	      } else {
   114	         return state.getBlock() instanceof IceBlock ? false : state.isFaceSturdy(level, pos, direction);
   115	      }
   116	   }

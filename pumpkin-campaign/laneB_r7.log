    60	    /// Returns correct fluid properties for a state, treating waterlogged blocks as water sources
    61	    /// (level 8, non-falling). Returns `None` if the state doesn't contain this fluid.
    62	    fn get_effective_props(
    63	        &self,
    64	        fluid: &Fluid,
    65	        state_id: BlockStateId,
    66	    ) -> Option<FlowingFluidProperties> {
    67	        if fluid.states.iter().any(|s| s.block_state_id == state_id) {
    68	            return Some(FlowingFluidProperties::from_state_id(state_id, fluid));
    69	        }
    70	        if fluid.id == Fluid::FLOWING_WATER.id || fluid.id == Fluid::WATER.id {
    71	            let block = Block::from_state_id(state_id);
    72	            if block.is_waterlogged(state_id) {
    73	                return Some(self.get_source(fluid, false));
    74	            }
    75	        }
    76	        None
    77	    }

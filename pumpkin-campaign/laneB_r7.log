   104	    let mut digest = Digest::new(Crc32Iscsi);
   105	    digest.update(&[12u8]);
   106	    digest.update(&(val.len() as u32).to_le_bytes());
   107	    let byte = val.as_bytes();
   108	    for i in byte {
   109	        digest.update(&[*i, 0u8]);
   110	    }
   111	    digest.finalize() as u32
   112	}

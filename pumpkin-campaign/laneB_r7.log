   169	   @Override
   170	   protected BlockState updateShape(
   171	      final BlockState state,
   172	      final LevelReader level,
   173	      final ScheduledTickAccess ticks,
   174	      final BlockPos pos,
   175	      final Direction directionToNeighbour,
   176	      final BlockPos neighbourPos,
   177	      final BlockState neighbourState,
   178	      final RandomSource random
   179	   ) {
   180	      if (directionToNeighbour == Direction.DOWN) {
   181	         return !this.canSurviveOn(level, neighbourPos, neighbourState) ? Blocks.AIR.defaultBlockState() : state;
   182	      }
   183	
   184	      if (directionToNeighbour == Direction.UP) {
   185	         return this.getConnectionState(level, state, pos);
   186	      }
   187	
   188	      RedstoneSide sideConnection = this.getConnectingSide(level, pos, directionToNeighbour);
   189	      return sideConnection.isConnected() == state.getValue(PROPERTY_BY_DIRECTION.get(directionToNeighbour)).isConnected() && !isCross(state)
   190	         ? state.setValue(PROPERTY_BY_DIRECTION.get(directionToNeighbour), sideConnection)
   191	         : this.getConnectionState(
   192	            level, this.crossState.setValue(POWER, state.getValue(POWER)).setValue(PROPERTY_BY_DIRECTION.get(directionToNeighbour), sideConnection), pos
   193	         );

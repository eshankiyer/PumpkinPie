   260	   private static void tickOccupants(
   261	      final Level level, final BlockPos pos, final BlockState state, final List<BeehiveBlockEntity.BeeData> stored, final @Nullable BlockPos savedFlowerPos
   262	   ) {
   263	      boolean changed = false;
   264	      Iterator<BeehiveBlockEntity.BeeData> iterator = stored.iterator();
   265	
   266	      while (iterator.hasNext()) {
   267	         BeehiveBlockEntity.BeeData data = iterator.next();
   268	         if (data.tick()) {
   269	            BeehiveBlockEntity.BeeReleaseStatus releaseStatus = data.hasNectar()
   270	               ? BeehiveBlockEntity.BeeReleaseStatus.HONEY_DELIVERED
   271	               : BeehiveBlockEntity.BeeReleaseStatus.BEE_RELEASED;
   272	            if (releaseOccupant(level, pos, state, data.toOccupant(), null, releaseStatus, savedFlowerPos)) {
   273	               changed = true;
   274	               iterator.remove();
   275	            }
   276	         }
   277	      }
   278	
   279	      if (changed) {
   280	         setChanged(level, pos, state);
   281	      }
   282	   }

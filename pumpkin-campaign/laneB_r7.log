   623	    /// The per-save (not per-dimension) root directory vanilla calls the "world path", used
   624	    /// as the base for `LevelResource.GENERATED_DIR` (`generated`) among other shared data.
   625	    ///
   626	    /// The nether/end store their region files under `<world>/DIM-1` and `<world>/DIM1`
   627	    /// (see `pumpkin_world::dimension::into_level`), so `level_folder.root_folder` is
   628	    /// dimension-specific; this walks back up to the shared save root the same way
   629	    /// `Level::from_root_folder`'s local `main_folder` does.
   630	    pub fn save_root_folder(&self) -> std::path::PathBuf {
   631	        let root = &self.level.level_folder.root_folder;
   632	        if self.dimension.minecraft_name == Dimension::OVERWORLD.minecraft_name {
   633	            root.clone()
   634	        } else {
   635	            root.parent().unwrap_or(root).to_path_buf()
   636	        }
   637	    }

   235	    fn random_tick<'a>(
   236	        &'a self,
   237	        _fluid: &'a Fluid,
   238	        world: &'a Arc<World>,
   239	        block_pos: &'a BlockPos,
   240	    ) -> BlockFuture<'a, ()> {
   241	        Box::pin(async move {
   242	            if !Self::can_spread_fire_around(world, block_pos) {
   243	                return;
   244	            }
   245	
   246	            let passes = rand::random_range(0..3);
   247	            if passes > 0 {
   248	                let mut test_pos = *block_pos;
   249	
   250	                for _ in 0..passes {
   251	                    test_pos = test_pos.offset(Vector3::new(
   252	                        rand::random_range(-1..=1),
   253	                        1,
   254	                        rand::random_range(-1..=1),
   255	                    ));
   256	
   257	                    if !world.is_loaded(&test_pos) {
   258	                        return;
   259	                    }
   260	
   261	                    let Some(block_state) = world.get_block_state_if_loaded(&test_pos) else {
   262	                        return;
   263	                    };
   264	
   265	                    if block_state.is_air() {
   266	                        if Self::has_flammable_neighbours(world, &test_pos) {
   267	                            Self::ignite_fire_if_possible(world, &test_pos).await;
   268	                            return;
   269	                        }
   270	                    } else if blocks_movement(block_state, block_state.id.to_block_id()) {
   271	                        return;
   272	                    }
   273	                }
   274	            } else {
   275	                for _ in 0..3 {
   276	                    let test_pos = block_pos.offset(Vector3::new(
   277	                        rand::random_range(-1..=1),
   278	                        0,
   279	                        rand::random_range(-1..=1),
   280	                    ));
   281	
   282	                    if !world.is_loaded(&test_pos) {
   283	                        return;
   284	                    }
   285	
   286	                    let above_pos = test_pos.up();
   287	                    if !world.is_loaded(&above_pos) {
   288	                        return;
   289	                    }
   290	
   291	                    if world
   292	                        .get_block_state_if_loaded(&above_pos)
   293	                        .is_some_and(BlockState::is_air)
   294	                        && Self::is_flammable(world, &test_pos)
   295	                    {
   296	                        Self::ignite_fire_if_possible(world, &above_pos).await;
   297	                    }
   298	                }
   299	            }
   300	        })
   301	    }
   302	}

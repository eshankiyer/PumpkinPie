   187	/// Applies the modeled implicit block-entity component from a placed item.
   188	///
   189	/// `BlockItem.updateBlockEntityComponents` calls
   190	/// `BlockEntity.applyComponentsFromItemStack` before `setPlacedBy` and the block-place game
   191	/// event; randomizable containers apply their `ContainerLoot` component as the vanilla
   192	/// `LootTable` fields (`BlockItem.java:101-106`; `BlockEntity.java:276-300`;
   193	/// `RandomizableContainerBlockEntity.java:98-112`).
   194	#[must_use]
   195	pub fn apply_components_from_item_stack(
   196	    entity: &dyn BlockEntity,
   197	    stack: &ItemStack,
   198	) -> Option<Arc<dyn BlockEntity>> {
   199	    // `ShelfBlockEntity.applyImplicitComponents` copies the item container into its three slots
   200	    // (`ShelfBlockEntity.java:104-107`), and BlockItem invokes that hook before `setChanged`
   201	    // (`BlockItem.java:101-106`).
   202	    if entity.as_any().is::<shelf::ShelfBlockEntity>() {
   203	        let position = entity.get_position();
   204	        let mut nbt = NbtCompound::new();
   205	        nbt.put_string("id", entity.resource_location().to_string());
   206	        nbt.put_int("x", position.0.x);
   207	        nbt.put_int("y", position.0.y);
   208	        nbt.put_int("z", position.0.z);
   209	        let container = stack.get_data_component::<ContainerImpl>();
   210	        let items: [ItemStack; shelf::ShelfBlockEntity::INVENTORY_SIZE] = from_fn(|slot| {
   211	            container
   212	                .and_then(|container| {
   213	                    container
   214	                        .items
   215	                        .iter()
   216	                        .find(|(item_slot, _)| usize::from(*item_slot) == slot)
   217	                        .map(|(_, item)| item.clone())
   218	                })
   219	                .unwrap_or_else(|| ItemStack::EMPTY.clone())
   220	        });
   221	        pumpkin_world::inventory::sync_write_items_to_nbt(&items, &mut nbt);
   222	        return block_entity_from_nbt_at(&nbt, position);
   223	    }
   224	
   225	    let data = stack.get_data_component::<ContainerLootImpl>()?;
   226	    let position = entity.get_position();
   227	    let mut nbt = NbtCompound::new();
   228	    nbt.put_string("id", entity.resource_location().to_string());
   229	    nbt.put_int("x", position.0.x);
   230	    nbt.put_int("y", position.0.y);
   231	    nbt.put_int("z", position.0.z);
   232	    nbt.put_string("LootTable", data.loot_table.clone());
   233	    if data.seed != 0 {
   234	        nbt.put_long("LootTableSeed", data.seed);
   235	    }
   236	    block_entity_from_nbt_at(&nbt, position)
   237	}

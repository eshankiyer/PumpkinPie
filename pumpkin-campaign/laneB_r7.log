   221	#[cfg(test)]
   222	mod tests {
   223	    use super::ShelfBlockEntity;
   224	    use crate::block::entities::BlockEntity;
   225	    use pumpkin_nbt::compound::NbtCompound;
   226	    use pumpkin_util::math::position::BlockPos;
   227	    use std::sync::atomic::Ordering;
   228	
   229	    #[test]
   230	    fn align_items_to_bottom_round_trips_through_nbt() {
   231	        let pos = BlockPos::new(1, 64, 2);
   232	        let entity = ShelfBlockEntity::new(pos);
   233	        entity.align_items_to_bottom.store(true, Ordering::Relaxed);
   234	
   235	        let mut nbt = NbtCompound::new();
   236	        futures::executor::block_on(entity.write_nbt(&mut nbt));
   237	        assert_eq!(nbt.get_bool("align_items_to_bottom"), Some(true));
   238	
   239	        let loaded = ShelfBlockEntity::from_nbt(&nbt, pos);
   240	        assert!(loaded.align_items_to_bottom.load(Ordering::Relaxed));
   241	    }
   242	
   243	    #[test]
   244	    fn align_items_to_bottom_defaults_to_false() {
   245	        let loaded = ShelfBlockEntity::from_nbt(&NbtCompound::new(), BlockPos::new(0, 0, 0));
   246	        assert!(!loaded.align_items_to_bottom.load(Ordering::Relaxed));
   247	    }
   248	}

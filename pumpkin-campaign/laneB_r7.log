   224	   @Override
   225	   public PalettedContainerRO.PackedData<T> pack(final Strategy<T> strategy) {
   226	      this.acquire();
   227	
   228	      try {
   229	         BitStorage currentStorage = this.data.storage;
   230	         Palette<T> currentPalette = this.data.palette;
   231	         HashMapPalette<T> newPalette = new HashMapPalette<>(currentStorage.getBits());
   232	         int entryCount = strategy.entryCount();
   233	         int[] newContents = reencodeContents(currentStorage, currentPalette, newPalette);
   234	         Configuration storedConfiguration = strategy.getConfigurationForPaletteSize(newPalette.getSize());
   235	         int bitsOnDisc = storedConfiguration.bitsInStorage();
   236	         Optional<LongStream> values;
   237	         if (bitsOnDisc != 0) {
   238	            SimpleBitStorage storage = new SimpleBitStorage(bitsOnDisc, entryCount, newContents);
   239	            values = Optional.of(Arrays.stream(storage.getRaw()));
   240	         } else {
   241	            values = Optional.empty();
   242	         }
   243	
   244	         return new PalettedContainerRO.PackedData<>(newPalette.getEntries(), values, bitsOnDisc);
   245	      } finally {
   246	         this.release();
   247	      }
   248	   }

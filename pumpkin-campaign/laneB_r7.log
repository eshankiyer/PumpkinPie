    40	pub async fn update_wire_neighbors(world: &Arc<World>, pos: &BlockPos) {
    41	    for direction in BlockDirection::all() {
    42	        let neighbor_pos = pos.offset(direction.to_offset());
    43	        let block = world.get_block(&neighbor_pos);
    44	        world
    45	            .block_registry
    46	            .on_neighbor_update(world, block, &neighbor_pos, block, true)
    47	            .await;
    48	
    49	        for n_direction in BlockDirection::all() {
    50	            let n_neighbor_pos = neighbor_pos.offset(n_direction.to_offset());
    51	            let block = world.get_block(&n_neighbor_pos);
    52	            world
    53	                .block_registry
    54	                .on_neighbor_update(world, block, &n_neighbor_pos, block, true)
    55	                .await;
    56	        }
    57	    }
    58	}

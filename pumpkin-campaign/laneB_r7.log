   506	            index,
   507	            id: AtomicU8::new(0),
   508	        }
   509	    }
   510	}
   511	
   512	impl Slot for BeaconPaymentSlot {
   513	    fn get_inventory(&self) -> Arc<dyn Inventory> {
   514	        self.inventory.clone()
   515	    }
   516	
   517	    fn get_index(&self) -> usize {
   518	        self.index
   519	    }
   520	
   521	    fn set_id(&self, id: usize) {
   522	        self.id.store(id as u8, Ordering::Relaxed);
   523	    }
   524	
   525	    /// `BeaconMenu.PaymentSlot.mayPlace` (`BeaconMenu.java:171-174`).

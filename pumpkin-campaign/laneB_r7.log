   179	   @Override
   180	   public int getSpreadDelay(final Level level, final BlockPos pos, final FluidState oldFluidState, final FluidState newFluidState) {
   181	      int result = this.getTickDelay(level);
   182	      if (!oldFluidState.isEmpty()
   183	         && !newFluidState.isEmpty()
   184	         && !oldFluidState.getValue(FALLING)
   185	         && !newFluidState.getValue(FALLING)
   186	         && newFluidState.getHeight(level, pos) > oldFluidState.getHeight(level, pos)
   187	         && level.getRandom().nextInt(4) != 0) {
   188	         result *= 4;
   189	      }
   190	
   191	      return result;
   192	   }

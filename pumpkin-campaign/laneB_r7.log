   210	   @Override
   211	   protected void updateIndirectNeighbourShapes(
   212	      final BlockState state, final LevelAccessor level, final BlockPos pos, final @Block.UpdateFlags int updateFlags, final int updateLimit
   213	   ) {
   214	      BlockPos.MutableBlockPos blockPos = new BlockPos.MutableBlockPos();
   215	
   216	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   217	         RedstoneSide value = state.getValue(PROPERTY_BY_DIRECTION.get(direction));
   218	         if (value != RedstoneSide.NONE && !level.getBlockState(blockPos.setWithOffset(pos, direction)).is(this)) {
   219	            blockPos.move(Direction.DOWN);
   220	            BlockState blockStateDown = level.getBlockState(blockPos);
   221	            if (blockStateDown.is(this)) {
   222	               BlockPos neighborPos = blockPos.relative(direction.getOpposite());
   223	               level.neighborShapeChanged(direction.getOpposite(), blockPos, neighborPos, level.getBlockState(neighborPos), updateFlags, updateLimit);
   224	            }
   225	
   226	            blockPos.setWithOffset(pos, direction).move(Direction.UP);
   227	            BlockState blockStateUp = level.getBlockState(blockPos);
   228	            if (blockStateUp.is(this)) {
   229	               BlockPos neighborPos = blockPos.relative(direction.getOpposite());
   230	               level.neighborShapeChanged(direction.getOpposite(), blockPos, neighborPos, level.getBlockState(neighborPos), updateFlags, updateLimit);
   231	            }
   232	         }
   233	      }
   234	   }

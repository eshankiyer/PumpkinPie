    38	
    39	#[pumpkin_block_from_tag("minecraft:wooden_shelves")]
    40	pub struct ShelfBlock;
    41	
    42	// --- `SideChainPart` (`SideChainPart.java:27-65`) ---
    43	
    44	const fn part_is_connected(part: SideChainPart) -> bool {
    45	    !matches!(part, SideChainPart::Unconnected)
    46	}
    47	
    48	const fn part_is_chain_end(part: SideChainPart) -> bool {
    49	    !matches!(part, SideChainPart::Center)
    50	}
    51	
    52	fn part_is_connection_towards(part: SideChainPart, end_part: SideChainPart) -> bool {
    53	    matches!(part, SideChainPart::Center) || part == end_part
    54	}
    55	
    56	const fn when_connected_to_the_right(part: SideChainPart) -> SideChainPart {
    57	    match part {
    58	        SideChainPart::Unconnected | SideChainPart::Left => SideChainPart::Left,
    59	        SideChainPart::Right | SideChainPart::Center => SideChainPart::Center,
    60	    }
    61	}
    62	
    63	const fn when_connected_to_the_left(part: SideChainPart) -> SideChainPart {
    64	    match part {
    65	        SideChainPart::Unconnected | SideChainPart::Right => SideChainPart::Right,
    66	        SideChainPart::Center | SideChainPart::Left => SideChainPart::Center,
    67	    }
    68	}
    69	
    70	const fn when_disconnected_from_the_right(part: SideChainPart) -> SideChainPart {
    71	    match part {
    72	        SideChainPart::Unconnected | SideChainPart::Left => SideChainPart::Unconnected,
    73	        SideChainPart::Right | SideChainPart::Center => SideChainPart::Right,
    74	    }
    75	}
    76	
    77	const fn when_disconnected_from_the_left(part: SideChainPart) -> SideChainPart {
    78	    match part {
    79	        SideChainPart::Unconnected | SideChainPart::Right => SideChainPart::Unconnected,
    80	        SideChainPart::Center | SideChainPart::Left => SideChainPart::Left,
    81	    }
    82	}
    83	
    84	// --- `SideChainPartBlock` (`SideChainPartBlock.java`), whose sole implementor is `ShelfBlock` ---
    85	
    86	/// `ShelfBlock.isConnectable` (`ShelfBlock.java:267-270`): a powered wooden shelf.
    87	fn is_connectable(block: &Block, state_id: BlockStateId) -> bool {
    88	    block.has_tag(&tag::Block::MINECRAFT_WOODEN_SHELVES)
    89	        && ShelfProperties::from_state_id(state_id, block).powered
    90	}
    91	
    92	/// One side-chain neighbour. `None` data is `SideChainPartBlock.EmptyNeighbor`
    93	/// (`SideChainPartBlock.java:106-121`).
    94	struct Neighbor {
    95	    pos: BlockPos,
    96	    data: Option<(&'static Block, BlockStateId, SideChainPart)>,
    97	}
    98	
    99	impl Neighbor {
   100	    const fn is_connectable(&self) -> bool {
   101	        self.data.is_some()
   102	    }
   103	
   104	    /// `SideChainPartBlock.Neighbor.isUnconnectableOrChainEnd`.
   105	    fn is_unconnectable_or_chain_end(&self) -> bool {
   106	        self.data.is_none_or(|(_, _, part)| part_is_chain_end(part))
   107	    }
   108	
   109	    /// `SideChainPartBlock.Neighbor.connectsTowards`.
   110	    fn connects_towards(&self, end_part: SideChainPart) -> bool {
   111	        self.data
   112	            .is_some_and(|(_, _, part)| part_is_connection_towards(part, end_part))
   113	    }
   114	}
   115	
   116	/// `SideChainPartBlock.Neighbors.createNewNeighbor` (`SideChainPartBlock.java:150-154`): only a
   117	/// connectable shelf that faces the same way as the centre counts.
   118	fn read_neighbor(world: &World, pos: BlockPos, facing: HorizontalFacing) -> Neighbor {
   119	    let block = world.get_block(&pos);
   120	    let state_id = world.get_block_state_id(&pos);
   121	    if is_connectable(block, state_id) {
   122	        let props = ShelfProperties::from_state_id(state_id, block);
   123	        if props.facing == facing {
   124	            return Neighbor {
   125	                pos,
   126	                data: Some((block, state_id, props.side_chain)),
   127	            };
   128	        }
   129	    }
   130	    Neighbor { pos, data: None }
   131	}
   132	
   133	/// `SideChainPartBlock.Neighbors.left` (`SideChainPartBlock.java:160-162`).
   134	fn left_pos(center: &BlockPos, facing: HorizontalFacing, steps: i32) -> BlockPos {
   135	    center.offset(facing.to_block_direction().rotate_clockwise().to_offset() * steps)
   136	}
   137	
   138	/// `SideChainPartBlock.Neighbors.right` (`SideChainPartBlock.java:164-166`).
   139	fn right_pos(center: &BlockPos, facing: HorizontalFacing, steps: i32) -> BlockPos {
   140	    center.offset(
   141	        facing
   142	            .to_block_direction()
   143	            .rotate_counter_clockwise()
   144	            .to_offset()
   145	            * steps,
   146	    )
   147	}
   148	
   149	/// `SideChainPartBlock.setPart` (`SideChainPartBlock.java:99-104`).
   150	async fn set_part(world: &Arc<World>, pos: &BlockPos, new_part: SideChainPart) {
   151	    let block = world.get_block(pos);
   152	    let state_id = world.get_block_state_id(pos);
   153	    if !block.has_tag(&tag::Block::MINECRAFT_WOODEN_SHELVES) {
   154	        return;
   155	    }
   156	    let mut props = ShelfProperties::from_state_id(state_id, block);
   157	    if props.side_chain == new_part {
   158	        return;
   159	    }
   160	    props.side_chain = new_part;
   161	    world
   162	        .set_block_state(pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
   163	        .await;
   164	}
   165	
   166	/// `SideChainPartBlock.addBlocksConnectingTowards` (`SideChainPartBlock.java:40-53`): the
   167	/// connectable blocks from the centre outwards towards `end_part`, in outward order.
   168	fn blocks_connecting_towards(
   169	    world: &World,
   170	    center: &BlockPos,
   171	    facing: HorizontalFacing,
   172	    towards_left: bool,
   173	    end_part: SideChainPart,
   174	) -> Vec<BlockPos> {
   175	    let mut found = Vec::new();
   176	    for steps in 1..MAX_CHAIN_LENGTH {
   177	        let pos = if towards_left {
   178	            left_pos(center, facing, steps)
   179	        } else {
   180	            right_pos(center, facing, steps)
   181	        };
   182	        let neighbor = read_neighbor(world, pos, facing);
   183	        if neighbor.connects_towards(end_part) {
   184	            found.push(pos);
   185	        }
   186	        if neighbor.is_unconnectable_or_chain_end() {
   187	            break;
   188	        }
   189	    }
   190	    found
   191	}
   192	
   193	/// `SideChainPartBlock.getAllBlocksConnectedTo` (`SideChainPartBlock.java:22-38`). The centre is
   194	/// first; blocks connecting towards LEFT are prepended (so they end up leftmost, furthest first)
   195	/// and blocks connecting towards RIGHT are appended, yielding leftmost..rightmost order.
   196	fn get_all_blocks_connected_to(world: &World, pos: &BlockPos) -> Vec<BlockPos> {
   197	    let block = world.get_block(pos);
   198	    let state_id = world.get_block_state_id(pos);
   199	    if !is_connectable(block, state_id) {
   200	        return Vec::new();
   201	    }
   202	    let facing = ShelfProperties::from_state_id(state_id, block).facing;
   203	    let mut results = vec![*pos];
   204	    let mut left = blocks_connecting_towards(world, pos, facing, true, SideChainPart::Left);
   205	    left.reverse();
   206	    results.extend(left);
   207	    results.extend(blocks_connecting_towards(
   208	        world,
   209	        pos,
   210	        facing,
   211	        false,
   212	        SideChainPart::Right,
   213	    ));
   214	    results
   215	}
   216	
   217	/// `SideChainPartBlock.canConnect` (`SideChainPartBlock.java:85-87`).
   218	const fn can_connect(new_blocks_to_connect_to: i32, current_chain_length: i32) -> bool {
   219	    new_blocks_to_connect_to > 0
   220	        && current_chain_length + new_blocks_to_connect_to <= MAX_CHAIN_LENGTH
   221	}
   222	
   223	/// `SideChainPartBlock.updateNeighborsAfterPoweringDown` (`SideChainPartBlock.java:55-59`).
   224	async fn update_neighbors_after_powering_down(
   225	    world: &Arc<World>,
   226	    pos: &BlockPos,
   227	    facing: HorizontalFacing,
   228	) {
   229	    let left = read_neighbor(world, left_pos(pos, facing, 1), facing);
   230	    if let Some((_, _, part)) = left.data {
   231	        set_part(world, &left.pos, when_disconnected_from_the_right(part)).await;
   232	    }
   233	    let right = read_neighbor(world, right_pos(pos, facing, 1), facing);
   234	    if let Some((_, _, part)) = right.data {
   235	        set_part(world, &right.pos, when_disconnected_from_the_left(part)).await;
   236	    }
   237	}
   238	
   239	/// `SideChainPartBlock.isBeingUpdatedByNeighbor` (`SideChainPartBlock.java:89-93`).
   240	fn is_being_updated_by_neighbor(
   241	    state_id: BlockStateId,
   242	    block: &Block,
   243	    old_state_id: BlockStateId,
   244	) -> bool {
   245	    let is_getting_connected =
   246	        part_is_connected(ShelfProperties::from_state_id(state_id, block).side_chain);
   247	    let old_block = Block::from_state_id(old_state_id);
   248	    let has_been_connected_before = is_connectable(old_block, old_state_id)
   249	        && part_is_connected(ShelfProperties::from_state_id(old_state_id, old_block).side_chain);
   250	    is_getting_connected || has_been_connected_before
   251	}
   252	
   253	/// `SideChainPartBlock.updateSelfAndNeighborsOnPoweringUp` (`SideChainPartBlock.java:61-83`).
   254	async fn update_self_and_neighbors_on_powering_up(
   255	    world: &Arc<World>,
   256	    pos: &BlockPos,
   257	    block: &Block,
   258	    state_id: BlockStateId,
   259	    old_state_id: BlockStateId,
   260	) {
   261	    if !is_connectable(block, state_id) {
   262	        return;
   263	    }
   264	    if is_being_updated_by_neighbor(state_id, block, old_state_id) {
   265	        return;
   266	    }
   267	
   268	    let facing = ShelfProperties::from_state_id(state_id, block).facing;

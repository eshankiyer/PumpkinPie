    79	        &'a self,
    80	        args: UseWithItemArgs<'a>,
    81	    ) -> BlockFuture<'a, BlockActionResult> {
    82	        Box::pin(async move {
    83	            let state_id = args.world.get_block_state_id(args.position);
    84	            let props = BeeNestLikeProperties::from_state_id(state_id, args.block);
    85	            if props.honey_level < MAX_HONEY_LEVELS {
    86	                return BlockActionResult::PassToDefaultBlockAction;
    87	            }
    88	
    89	            let player_pos = args.player.get_entity().pos.load();
    90	            let item = args.item_stack.item;
    91	            if item.id == Item::SHEARS.id {
    92	                drop_honeycomb(args.world, args.position).await;
    93	                args.world
    94	                    .play_sound(Sound::BlockBeehiveShear, SoundCategory::Blocks, &player_pos);
    95	                args.player.damage_held_item(1).await;
    96	            } else if item.id == Item::GLASS_BOTTLE.id {
    97	                if args.player.gamemode.load() != GameMode::Creative {
    98	                    args.item_stack.decrement(1);
    99	                }
   100	                args.world
   101	                    .play_sound(Sound::ItemBottleFill, SoundCategory::Blocks, &player_pos);
   102	                let mut honey = ItemStack::new(1, &Item::HONEY_BOTTLE);
   103	                if !args
   104	                    .player
   105	                    .inventory()
   106	                    .insert_stack_anywhere(&mut honey)
   107	                    .await
   108	                {
   109	                    args.player.drop_item(honey).await;
   110	                }
   111	            } else {
   112	                return BlockActionResult::PassToDefaultBlockAction;
   113	            }
   114	
   115	            // `hiveEmptied`: the harvest happened, so the honey level resets either way, and the
   116	            // bees stay calm only if a campfire is smoking underneath the hive.
   117	            let sedated = is_smokey_pos(args.world, args.position);
   118	            reset_honey_level(args.world, args.block, args.position, state_id).await;
   119	
   120	            if !sedated
   121	                && let Some(handle) = args.world.get_block_entity(args.position)
   122	                && let Some(hive) = handle.as_any().downcast_ref::<BeehiveBlockEntity>()
   123	            {
   124	                if !hive.is_empty().await {
   125	                    anger_nearby_bees(args.world, args.position).await;
   126	                }
   127	                hive.empty_all_living_from_hive(
   128	                    args.world,
   129	                    Some(args.player),
   130	                    BeeReleaseStatus::Emergency,
   131	                )
   132	                .await;
   133	            }
   134	
   135	            BlockActionResult::Success
   136	        })
   137	    }
   138	}

   240	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   241	        Box::pin(async move {
   242	            update_wire_neighbors(args.world, args.position).await;
   243	        })
   244	    }

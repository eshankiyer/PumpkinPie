   486	///
   487	/// Vanilla `BeaconMenu.PaymentSlot` (`BeaconMenu.java:166-180`): `mayPlace` restricts
   488	/// insertion to `ItemTags.BEACON_PAYMENT_ITEMS`, and `getMaxStackSize` caps it at 1. The
   489	/// same restriction is duplicated on the anonymous `SimpleContainer`'s `canPlaceItem`
   490	/// override backing the slot (`BeaconMenu.java:26-36`).
   491	// BeaconMenu.PaymentSlot
   492	pub struct BeaconPaymentSlot {
   493	    /// The inventory containing this slot (the beacon block entity).
   494	    pub inventory: Arc<dyn Inventory>,

   320	   private boolean canPassThrough(
   321	      final BlockGetter level,
   322	      final Fluid fluid,
   323	      final BlockPos sourcePos,
   324	      final BlockState sourceState,
   325	      final Direction direction,
   326	      final BlockPos testPos,
   327	      final BlockState testState,
   328	      final FluidState testFluidState
   329	   ) {
   330	      return this.canMaybePassThrough(level, sourcePos, sourceState, direction, testPos, testState, testFluidState)
   331	         && canHoldSpecificFluid(level, testPos, testState, fluid);
   332	   }
   333	
   334	   private boolean canMaybePassThrough(
   335	      final BlockGetter level,
   336	      final BlockPos sourcePos,
   337	      final BlockState sourceState,
   338	      final Direction direction,
   339	      final BlockPos testPos,
   340	      final BlockState testState,
   341	      final FluidState testFluidState
   342	   ) {
   343	      return !this.isSourceBlockOfThisType(testFluidState)
   344	         && canHoldAnyFluid(testState)
   345	         && canPassThroughWall(direction, level, sourcePos, sourceState, testPos, testState);
   346	   }

   154	/// `BeehiveBlock.dropHoneycomb`.
   155	async fn drop_honeycomb(world: &Arc<World>, position: &BlockPos) {
   156	    let drop_pos = Vector3::new(
   157	        f64::from(position.0.x) + 0.5,
   158	        f64::from(position.0.y) + 0.5,
   159	        f64::from(position.0.z) + 0.5,
   160	    );
   161	    let item_entity = Arc::new(ItemEntity::new(
   162	        Entity::new(world.clone(), drop_pos, &EntityType::ITEM),
   163	        ItemStack::new(HONEYCOMB_PER_HARVEST, &Item::HONEYCOMB),
   164	    ));
   165	    world.spawn_entity(item_entity).await;
   166	}

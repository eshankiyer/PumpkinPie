    86	/// `BeehiveBlockEntity.Occupant` fused with its mutable `BeeData` wrapper: vanilla keeps a
    87	/// separate `BeeData` only so the immutable record can stay a codec target.
    88	#[derive(Clone, Debug)]
    89	pub struct Occupant {
    90	    /// `Occupant.entityData`, a compound carrying the entity id under `"id"`.
    91	    pub entity_data: NbtCompound,
    92	    /// `BeeData.ticksInHive`.
    93	    pub ticks_in_hive: i32,
    94	    /// `Occupant.minTicksInHive`.
    95	    pub min_ticks_in_hive: i32,
    96	}
    97	
    98	impl Occupant {
    99	    /// `BeeData.hasNectar`.
   100	    fn has_nectar(&self) -> bool {
   101	        self.entity_data.get_bool("HasNectar").unwrap_or(false)
   102	    }
   103	
   104	    /// `BeeData.tick`.
   105	    const fn tick(&mut self) -> bool {
   106	        let ready = self.ticks_in_hive > self.min_ticks_in_hive;
   107	        self.ticks_in_hive += 1;
   108	        ready
   109	    }
   110	
   111	    /// `Occupant.of`.
   112	    #[must_use]
   113	    pub fn of(mut entity_data: NbtCompound, entity_id: &str) -> Self {
   114	        for key in IGNORED_BEE_TAGS {
   115	            entity_data.child_tags.remove(key);
   116	        }
   117	        entity_data.put_string("id", entity_id.to_string());
   118	        let has_nectar = entity_data.get_bool("HasNectar").unwrap_or(false);
   119	        Self {
   120	            entity_data,
   121	            ticks_in_hive: 0,
   122	            min_ticks_in_hive: if has_nectar {
   123	                MIN_OCCUPATION_TICKS_NECTAR
   124	            } else {
   125	                MIN_OCCUPATION_TICKS_NECTARLESS
   126	            },
   127	        }
   128	    }
   129	
   130	    fn to_nbt(&self) -> NbtTag {
   131	        let mut compound = NbtCompound::new();
   132	        compound.put_compound("entity_data", self.entity_data.clone());
   133	        compound.put_int("ticks_in_hive", self.ticks_in_hive);
   134	        compound.put_int("min_ticks_in_hive", self.min_ticks_in_hive);
   135	        NbtTag::Compound(compound)
   136	    }
   137	
   138	    fn from_nbt(tag: &NbtTag) -> Option<Self> {
   139	        let NbtTag::Compound(compound) = tag else {
   140	            return None;
   141	        };
   142	        Some(Self {
   143	            entity_data: compound.get_compound("entity_data")?.clone(),
   144	            ticks_in_hive: compound.get_int("ticks_in_hive").unwrap_or(0),
   145	            min_ticks_in_hive: compound
   146	                .get_int("min_ticks_in_hive")
   147	                .unwrap_or(MIN_OCCUPATION_TICKS_NECTARLESS),
   148	        })
   149	    }
   150	}

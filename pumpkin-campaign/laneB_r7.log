   201	    fn count_source_neighbors<'a>(
   202	        &'a self,
   203	        world: &'a Arc<World>,
   204	        fluid: &'a Fluid,
   205	        block_pos: &'a BlockPos,
   206	    ) -> impl std::future::Future<Output = i32> + Send + 'a {
   207	        async move {
   208	            let mut count = 0;
   209	            for direction in [
   210	                BlockDirection::North,
   211	                BlockDirection::South,
   212	                BlockDirection::West,
   213	                BlockDirection::East,
   214	            ] {
   215	                let neighbor_pos = block_pos.offset(direction.to_offset());
   216	                let neighbor_id = world.get_block_state_id(&neighbor_pos);
   217	                if self
   218	                    .get_effective_props(fluid, neighbor_id)
   219	                    .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False)
   220	                {
   220	                {
   221	                    count += 1;
   222	                }
   223	            }
   224	            count
   225	        }
   226	    }

   102	async fn get_max_strong_power(world: &World, pos: &BlockPos, dust_power: bool) -> u8 {
   103	    let mut max_power = 0;
   104	    for side in BlockDirection::all() {
   105	        let (block, state) = world.get_block_and_state(&pos.offset(side.to_offset()));
   106	        max_power = max_power.max(
   107	            get_strong_power(
   108	                block,
   109	                state,
   110	                world,
   111	                &pos.offset(side.to_offset()),
   112	                side,
   113	                dust_power,
   114	            )
   115	            .await,
   116	        );
   117	    }
   118	    max_power
   119	}

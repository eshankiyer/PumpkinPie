   190	pub async fn diode_get_input_strength(world: &World, pos: &BlockPos, facing: BlockDirection) -> u8 {
   191	    let input_pos = pos.offset(facing.to_offset());
   192	    let (input_block, input_state) = world.get_block_and_state(&input_pos);
   193	    let power: u8 = get_redstone_power(input_block, input_state, world, &input_pos, facing).await;
   194	    if power == 0 && input_state.is_solid_block() {
   195	        return get_max_weak_power(world, &input_pos, true).await;
   196	    }
   197	    power
   198	}

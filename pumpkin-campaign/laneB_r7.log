   192	/// `RandomizableContainerBlockEntity.java:98-112`).
   193	#[must_use]
   194	pub fn apply_components_from_item_stack(
   195	    entity: &dyn BlockEntity,
   196	    stack: &ItemStack,
   197	) -> Option<Arc<dyn BlockEntity>> {
   198	    let data = stack.get_data_component::<ContainerLootImpl>()?;
   199	    let position = entity.get_position();
   200	    let mut nbt = NbtCompound::new();
   201	    nbt.put_string("id", entity.resource_location().to_string());
   202	    nbt.put_int("x", position.0.x);
   203	    nbt.put_int("y", position.0.y);
   204	    nbt.put_int("z", position.0.z);
   205	    nbt.put_string("LootTable", data.loot_table.clone());
   206	    if data.seed != 0 {
   207	        nbt.put_long("LootTableSeed", data.seed);
   208	    }
   209	    block_entity_from_nbt_at(&nbt, position)
   210	}

  1990	    #[expect(clippy::float_cmp)]
  1991	    async fn adjust_movement_for_collisions(
  1992	        &self,
  1993	        movement: Vector3<f64>,
  1994	        caller: &dyn EntityBase,
  1995	    ) -> Vector3<f64> {
  1996	        if movement.length_squared() == 0.0 {
  1997	            return movement;
  1998	        }
  1999	
  2000	        self.on_ground.store(false, Ordering::SeqCst);
  2001	        self.supporting_block_pos.store(None);
  2002	        self.horizontal_collision.store(false, Ordering::SeqCst);
  2003	
  2004	        let bounding_box = self.bounding_box.load();
  2005	
  2006	        let (collisions, block_positions) = self
  2007	            .world
  2008	            .load()
  2009	            .get_block_collisions(bounding_box.stretch(movement), caller)
  2010	            .await;
  2011	
  2012	        if collisions.is_empty() {
  2013	            return movement;
  2014	        }
  2015	
  2016	        let mut adjusted_movement = movement;
  2017	
  2018	        // Y-Axis adjustment
  2019	        if movement.get_axis(Axis::Y) != 0.0 {
  2020	            let mut max_time = 1.0;
  2021	            let mut positions = block_positions.into_iter();
  2022	            if let Some((mut collisions_len, mut position)) = positions.next() {
  2023	                let mut supporting_block_pos = None;
  2024	
  2025	                for (i, inert_box) in collisions.iter().enumerate() {
  2026	                    if i == collisions_len {
  2027	                        let Some((next_len, next_pos)) = positions.next() else {
  2028	                            break;
  2029	                        };
  2030	                        collisions_len = next_len;
  2031	                        position = next_pos;
  2032	                    }
  2033	
  2034	                    if let Some(collision_time) = bounding_box.calculate_collision_time(
  2035	                        inert_box,
  2036	                        adjusted_movement,
  2037	                        Axis::Y,
  2038	                        max_time,
  2039	                    ) {
  2040	                        max_time = collision_time;
  2041	
  2042	                        // If the entity is moving downwards and collides, set the supporting block position
  2043	                        if movement.get_axis(Axis::Y) < 0.0 {
  2044	                            supporting_block_pos = Some(position);
  2045	                        }
  2046	                    }
  2047	                }
  2048	
  2049	                if max_time != 1.0 {
  2050	                    let changed_component = adjusted_movement.get_axis(Axis::Y) * max_time;
  2051	                    adjusted_movement.set_axis(Axis::Y, changed_component);
  2052	                }
  2053	
  2054	                self.on_ground
  2055	                    .store(supporting_block_pos.is_some(), Ordering::SeqCst);
  2056	                self.supporting_block_pos.store(supporting_block_pos);
  2057	            }
  2058	        }
  2059	
  2060	        let mut horizontal_collision = false;
  2061	
  2062	        for axis in Axis::horizontal() {
  2063	            if movement.get_axis(axis) == 0.0 {
  2064	                continue;
  2065	            }
  2066	
  2067	            let mut max_time = 1.0;
  2068	
  2069	            for inert_box in &collisions {
  2070	                if let Some(collision_time) = bounding_box.calculate_collision_time(
  2071	                    inert_box,
  2072	                    adjusted_movement,
  2073	                    axis,
  2074	                    max_time,
  2075	                ) {
  2076	                    max_time = collision_time;
  2077	                }
  2078	            }
  2079	
  2080	            if max_time != 1.0 {
  2081	                let changed_component = adjusted_movement.get_axis(axis) * max_time;
  2082	                adjusted_movement.set_axis(axis, changed_component);
  2083	                horizontal_collision = true;
  2084	            }
  2085	        }
  2086	
  2087	        self.horizontal_collision
  2088	            .store(horizontal_collision, Ordering::SeqCst);
  2089	
  2090	        adjusted_movement
  2091	    }

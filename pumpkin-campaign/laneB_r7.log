  2264	    pub fn get_fluid_collisions(self: &Arc<Self>, bounding_box: BoundingBox) -> Vec<&Fluid> {
  2265	        let mut collisions = Vec::new();
  2266	
  2267	        let min = bounding_box.min_block_pos();
  2268	
  2269	        let max = bounding_box.max_block_pos();
  2270	
  2271	        for x in min.0.x..=max.0.x {
  2272	            for y in min.0.y..=max.0.y {
  2273	                for z in min.0.z..=max.0.z {
  2274	                    let pos = BlockPos::new(x, y, z);
  2275	
  2276	                    let (fluid, state) = self.get_fluid_and_fluid_state(&pos);
  2277	
  2278	                    if fluid.id != Fluid::EMPTY.id {
  2279	                        let height = self.get_fluid_height(&pos, fluid, state);
  2280	
  2281	                        if height >= bounding_box.min.y {
  2282	                            collisions.push(fluid);
  2283	                        }
  2284	                    }
  2285	                }
  2286	            }
  2287	        }
  2288	
  2289	        collisions
  2290	    }

   324	               Vec3 destination = positionSource.getPosition(level).orElse(origin);
   325	               int travelTimeInTicks = data.getTravelTimeInTicks();
   326	               int initialTravelTime = user.calculateTravelTimeInTicks(data.currentVibration.distance());
   327	               double alpha = 1.0 - (double)travelTimeInTicks / initialTravelTime;
   328	               double newInitialX = Mth.lerp(alpha, origin.x, destination.x);
   329	               double newInitialY = Mth.lerp(alpha, origin.y, destination.y);
   330	               double newInitialZ = Mth.lerp(alpha, origin.z, destination.z);

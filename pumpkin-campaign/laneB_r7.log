    28	type ShelfProperties = AcaciaShelfLikeProperties;
    29	
    30	/// `ShelfBlock.getMaxChainLength` (`ShelfBlock.java:272-274`).
    31	const MAX_CHAIN_LENGTH: i32 = 3;
    32	
    33	/// `ShelfBlock.getRows` (`ShelfBlock.java:146-148`).
    34	const ROWS: i32 = 1;
    35	
    36	/// `ShelfBlock.getColumns` (`ShelfBlock.java:151-153`).

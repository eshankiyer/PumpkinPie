   282	   protected int getSlopeDistance(
   283	      final LevelReader level, final BlockPos pos, final int pass, final Direction from, final BlockState state, final FlowingFluid.SpreadContext context
   284	   ) {
   285	      int lowest = 1000;
   286	
   287	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   288	         if (direction != from) {
   289	            BlockPos testPos = pos.relative(direction);
   290	            BlockState testState = context.getBlockState(testPos);
   291	            FluidState testFluidState = testState.getFluidState();
   292	            if (this.canPassThrough(level, this.getFlowing(), pos, state, direction, testPos, testState, testFluidState)) {
   293	               if (context.isHole(testPos)) {
   294	                  return pass;
   295	               }
   296	
   297	               if (pass < this.getSlopeFindDistance(level)) {
   298	                  int v = this.getSlopeDistance(level, testPos, pass + 1, direction.getOpposite(), testState, context);
   299	                  if (v < lowest) {
   300	                     lowest = v;
   301	                  }
   302	               }
   303	            }
   304	         }
   305	      }
   306	
   307	      return lowest;
   308	   }

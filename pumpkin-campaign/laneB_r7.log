+                return;
+            };
+            let props = BeeNestLikeProperties::from_state_id(args.state.id, args.block);
+            if hive.is_empty().await && props.honey_level == 0 {
+                return;
+            }
+            let item = if args.block.id == Block::BEE_NEST.id {
+                &Item::BEE_NEST
+            } else {
+                &Item::BEEHIVE
+            };

   246	    fn on_state_replaced<'a>(&'a self, args: OnStateReplacedArgs<'a>) -> BlockFuture<'a, ()> {
   247	        Box::pin(async move {
   248	            // RedStoneWireBlock.affectNeighborsAfterRemoval (vanilla:
   249	            // RedStoneWireBlock.java:315-325) skips piston moves and updates the
   250	            // surrounding wire network after any ordinary replacement. The generic
   251	            // World::set_block_state path reaches this hook for non-player removals too.
   252	            if !args.moved {
   253	                update_wire_neighbors(args.world, args.position).await;
   254	            }
   255	        })
   256	    }

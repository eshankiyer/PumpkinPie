   467	    /// Checks if infinite source formation conditions are met.
   468	    ///
   469	    /// Requirements:
   470	    /// - 2+ horizontally adjacent source blocks (level 8, non-falling)
   471	    /// - Block below is either solid OR a source of the same fluid
   472	    ///
   473	    /// # Returns
   474	    /// `true` if position should convert to a source block
   475	    fn check_infinite_source_formation<'a>(
   476	        &'a self,
   477	        world: &'a Arc<World>,
   478	        fluid: &'a Fluid,
   479	        pos: &'a BlockPos,
   480	    ) -> impl std::future::Future<Output = bool> + Send + 'a {
   481	        async move {
   482	            // Count adjacent horizontal source blocks
   483	            let mut source_count = 0;
   484	            for direction in [
   485	                BlockDirection::North,
   486	                BlockDirection::South,
   487	                BlockDirection::West,
   488	                BlockDirection::East,
   489	            ] {
   490	                let neighbor_pos = pos.offset(direction.to_offset());
   491	                let neighbor_state_id = world.get_block_state_id(&neighbor_pos);
   492	
   493	                if self
   494	                    .get_effective_props(fluid, neighbor_state_id)
   495	                    .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False)
   496	                {
   497	                    source_count += 1;
   498	                }
   499	            }
   500	
   501	            // Need at least 2 source neighbors
   502	            if source_count < 2 {
   503	                return false;
   504	            }
   505	
   506	            // Check the block below
   507	            let below_pos = pos.down();
   508	            let below_state = world.get_block_state(&below_pos);
   509	            let below_state_id = below_state.id;
   510	
   511	            // Check if block below is a stable source of the same fluid
   512	            let below_is_same_source = self
   513	                .get_effective_props(fluid, below_state_id)
   514	                .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False);
   515	
   516	            // Convert to source if below is solid or a source of same fluid
   517	            below_is_same_source || below_state.is_solid_block()
   518	        }
   519	    }
   520	
   521	    /// `FlowingFluid.beforeDestroyingBlock` (`FlowingFluid.java:280`), called from `spreadTo`
   522	    /// (`FlowingFluid.java:268-278`) for every non-air block the fluid is about to overwrite.
   523	    ///
   524	    /// The two fluids differ here, and the difference is visible in any lava flow:
   525	    /// `WaterFluid` drops the block's resources (`WaterFluid.java:80-84`), while `LavaFluid`
   526	    /// drops nothing and plays the fizz level event instead (`LavaFluid.java:144-147`, which
   527	    /// calls `fizz` -> `levelEvent(1501, ...)` at `LavaFluid.java:193-195`). Water washing a
   528	    /// torch away therefore yields a torch item; lava consuming one yields nothing.
   529	    fn before_destroying_block<'a>(
   530	        &'a self,
   531	        world: &'a Arc<World>,
   532	        pos: &'a BlockPos,
   533	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
   534	        async move {
   535	            world.break_block(pos, None, BlockFlags::NOTIFY_ALL).await;
   536	        }
   537	    }
   538	
   539	    /// Spreads fluid to a target position with the given state.
   540	    ///
   541	    /// Default implementation delegates to `apply_spread`. Implementations like
   542	    /// lava can override to add fluid-specific logic (e.g., water -> stone conversion).
   543	    fn spread_to<'a>(
   544	        &'a self,
   545	        world: &'a Arc<World>,
   546	        fluid: &'a Fluid,
   547	        pos: &'a BlockPos,
   548	        state_id: BlockStateId,
   549	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
   550	        async move {
   551	            let new_props = FlowingFluidProperties::from_state_id(state_id, fluid);
   552	            self.apply_spread(world, fluid, pos, state_id, new_props)
   553	                .await;
   554	        }
   555	    }
   556	
   557	    /// Spreads fluid horizontally to adjacent positions using pathfinding.
   558	    ///
   559	    /// Uses `get_spread` to find optimal flow directions (shortest distance to holes)
   560	    /// and the computed fluid state for each target position.
   561	    fn flow_to_sides<'a>(
   562	        &'a self,
   563	        world: &'a Arc<World>,
   564	        fluid: &'a Fluid,
   565	        block_pos: &'a BlockPos,
   566	        props: &'a FlowingFluidProperties,
   567	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
   568	        async move {
   569	            let drop_off = self.get_level_decrease_per_block(world);
   570	            let current_level = i32::from(props.level.to_index()) + 1;
   571	            let effective_level = if props.falling == Falling::True {
   572	                7
   573	            } else {
   574	                current_level - drop_off
   575	            };
   576	
   577	            if effective_level <= 0 {
   578	                return;
   579	            }
   580	
   581	            let (spread_dirs, count) = pathfinder::get_spread(self, world, fluid, block_pos).await;
   582	
   583	            for &(direction, state_id) in spread_dirs.iter().take(count) {
   584	                let side_pos = block_pos.offset(direction.to_offset());
   585	
   586	                self.spread_to(world, fluid, &side_pos, state_id).await;
   587	            }
   588	        }
   589	    }
   590	}


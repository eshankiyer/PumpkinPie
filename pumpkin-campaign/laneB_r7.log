    44	pub(crate) fn stop_vertical_movement_after_fall(entity: &dyn EntityBase) {
    45	    let entity = entity.get_entity();
    46	    let mut velocity = entity.velocity.load();
    47	    velocity.y = 0.0;
    48	    entity.velocity.store(velocity);
    49	}
    50	
    51	pub(crate) fn bounce_entity_after_fall(entity: &dyn EntityBase, bounce_multiplier: f64) {
    52	    let base_entity = entity.get_entity();
    53	    let mut velocity = base_entity.velocity.load();
    54	
    55	    if base_entity.is_sneaking() {
    56	        velocity.y = 0.0;
    57	    } else if velocity.y < 0.0 {
    58	        let entity_factor = if entity.get_living_entity().is_some() {
    59	            1.0
    60	        } else {
    61	            0.8
    62	        };
    63	        velocity.y = -velocity.y * bounce_multiplier * entity_factor;
    64	    }
    65	
    66	    base_entity.velocity.store(velocity);
    67	}

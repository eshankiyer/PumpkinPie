   268	   protected void spreadTo(final LevelAccessor level, final BlockPos pos, final BlockState state, final Direction direction, final FluidState target) {
   269	      if (state.getBlock() instanceof LiquidBlockContainer container) {
   270	         container.placeLiquid(level, pos, state, target);
   271	      } else {
   272	         if (!state.isAir()) {
   273	            this.beforeDestroyingBlock(level, pos, state);
   274	         }
   275	
   276	         level.setBlock(pos, target.createLegacyBlock(), 3);
   277	      }
   278	   }

   394	pub async fn get_side(world: &World, pos: &BlockPos, side: BlockDirection) -> WireConnection {
   395	    let neighbor_pos: BlockPos = pos.offset(side.to_offset());
   396	    let (neighbor, state) = world.get_block_and_state(&neighbor_pos);
   397	
   398	    if can_connect_to(world, neighbor, side, state).await {
   399	        return WireConnection::Side;
   400	    }
   401	
   402	    let up_pos = pos.offset(BlockDirection::Up.to_offset());
   403	    let up_state = world.get_block_state(&up_pos);
   404	
   405	    if !up_state.is_solid_block()
   406	        && state.is_side_solid(side.opposite())
   407	        && can_connect_diagonal_to(
   408	            world.get_block(&neighbor_pos.offset(BlockDirection::Up.to_offset())),
   409	        )
   410	    {
   411	        WireConnection::Up
   412	    } else if !state.is_solid_block()
   413	        && can_connect_diagonal_to(
   414	            world.get_block(&neighbor_pos.offset(BlockDirection::Down.to_offset())),
   415	        )
   416	    {
   417	        WireConnection::Side
   418	    } else {
   419	        WireConnection::None
   420	    }
   421	}

   161	   protected FluidState getNewLiquid(final ServerLevel level, final BlockPos pos, final BlockState state) {
   162	      int highestNeighbor = 0;
   163	      int neighbourSources = 0;
   164	      BlockPos.MutableBlockPos mutablePos = new BlockPos.MutableBlockPos();
   165	
   166	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   167	         BlockPos relativePos = mutablePos.setWithOffset(pos, direction);
   168	         BlockState blockState = level.getBlockState(relativePos);
   169	         FluidState fluidState = blockState.getFluidState();
   170	         if (fluidState.getType().isSame(this) && canPassThroughWall(direction, level, pos, state, relativePos, blockState)) {
   171	            if (fluidState.isSource()) {
   172	               neighbourSources++;
   173	            }
   174	
   175	            highestNeighbor = Math.max(highestNeighbor, fluidState.getAmount());
   176	         }
   177	      }
   178	
   179	      if (neighbourSources >= 2 && this.canConvertToSource(level)) {
   180	         BlockState belowState = level.getBlockState(mutablePos.setWithOffset(pos, Direction.DOWN));
   181	         FluidState belowFluid = belowState.getFluidState();
   182	         if (belowState.isSolid() || this.isSourceBlockOfThisType(belowFluid)) {
   183	            return this.getSource(false);
   184	         }
   185	      }
   186	
   187	      BlockPos abovePos = mutablePos.setWithOffset(pos, Direction.UP);
   188	      BlockState aboveState = level.getBlockState(abovePos);
   189	      FluidState aboveFluid = aboveState.getFluidState();
   190	      if (!aboveFluid.isEmpty() && aboveFluid.getType().isSame(this) && canPassThroughWall(Direction.UP, level, pos, state, abovePos, aboveState)) {
   191	         return this.getFlowing(8, true);
   192	      }
   193	
   194	      int amount = highestNeighbor - this.getDropOff(level);
   195	      return amount <= 0 ? Fluids.EMPTY.defaultFluidState() : this.getFlowing(amount, false);
   196	   }
   197	
   198	   private static boolean canPassThroughWall(
   199	      final Direction direction,
   200	      final BlockGetter level,
   201	      final BlockPos sourcePos,
   202	      final BlockState sourceState,
   203	      final BlockPos targetPos,
   204	      final BlockState targetState
   205	   ) {
   206	      if (!SharedConstants.DEBUG_DISABLE_LIQUID_SPREADING && (!SharedConstants.DEBUG_ONLY_GENERATE_HALF_THE_WORLD || targetPos.getZ() >= 0)) {
   207	         VoxelShape targetShape = targetState.getCollisionShape(level, targetPos);
   208	         if (targetShape == Shapes.block()) {
   209	            return false;
   210	         }
   211	
   212	         VoxelShape sourceShape = sourceState.getCollisionShape(level, sourcePos);
   213	         if (sourceShape == Shapes.block()) {
   214	            return false;
   215	         }
   216	
   217	         if (sourceShape == Shapes.empty() && targetShape == Shapes.empty()) {
   218	            return true;
   219	         }
   220	
   220	
   221	         Object2ByteLinkedOpenHashMap<FlowingFluid.BlockStatePairKey> cache;
   222	         if (!sourceState.getBlock().hasDynamicShape() && !targetState.getBlock().hasDynamicShape()) {
   223	            cache = OCCLUSION_CACHE.get();
   224	         } else {
   225	            cache = null;
   226	         }
   227	
   228	         FlowingFluid.BlockStatePairKey key;
   229	         if (cache != null) {
   230	            key = new FlowingFluid.BlockStatePairKey(sourceState, targetState, direction);
   231	            byte cached = cache.getAndMoveToFirst(key);
   232	            if (cached != 127) {
   233	               return cached != 0;
   234	            }
   235	         } else {
   236	            key = null;
   237	         }
   238	
   239	         boolean result = !Shapes.mergedFaceOccludes(sourceShape, targetShape, direction);
   240	         if (cache != null) {
   241	            if (cache.size() == 200) {
   242	               cache.removeLastByte();
   243	            }
   244	
   245	            cache.putAndMoveToFirst(key, (byte)(result ? 1 : 0));
   246	         }
   247	
   248	         return result;
   249	      } else {
   250	         return false;
   251	      }
   252	   }

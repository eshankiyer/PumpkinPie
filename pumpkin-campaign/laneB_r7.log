   274	/// Permutes the four connection sides for a mirror transform. The `RedstoneSide` value at
   275	/// each direction is untouched, only which direction key holds which value changes.
   276	fn mirror_wire(wire: RedstoneWireProperties, mirror: Mirror) -> RedstoneWireProperties {
   277	    match mirror {
   278	        Mirror::LeftRight => RedstoneWireProperties {
   279	            north: wire.south.to_wire_connection().to_north(),
   280	            south: wire.north.to_wire_connection().to_south(),
   281	            ..wire
   282	        },
   283	        Mirror::FrontBack => RedstoneWireProperties {
   284	            east: wire.west.to_wire_connection().to_east(),
   285	            west: wire.east.to_wire_connection().to_west(),
   286	            ..wire
   287	        },
   288	        Mirror::None => wire,
   289	    }
   290	}
   291	
   292	/// Permutes the four connection sides for a rotation transform, matching vanilla
   293	/// `RedStoneWireBlock.rotate`.
   294	fn rotate_wire(wire: RedstoneWireProperties, rotation: Rotation) -> RedstoneWireProperties {
   295	    match rotation {
   296	        Rotation::Clockwise90 => RedstoneWireProperties {
   297	            north: wire.west.to_wire_connection().to_north(),
   298	            east: wire.north.to_wire_connection().to_east(),
   299	            south: wire.east.to_wire_connection().to_south(),
   300	            west: wire.south.to_wire_connection().to_west(),
   301	            power: wire.power,
   302	        },
   303	        Rotation::Rotate180 => RedstoneWireProperties {
   304	            north: wire.south.to_wire_connection().to_north(),
   305	            east: wire.west.to_wire_connection().to_east(),
   306	            south: wire.north.to_wire_connection().to_south(),
   307	            west: wire.east.to_wire_connection().to_west(),
   308	            power: wire.power,
   309	        },
   310	        Rotation::CounterClockwise90 => RedstoneWireProperties {
   311	            north: wire.east.to_wire_connection().to_north(),
   312	            east: wire.south.to_wire_connection().to_east(),
   313	            south: wire.west.to_wire_connection().to_south(),
   314	            west: wire.north.to_wire_connection().to_west(),
   315	            power: wire.power,
   316	        },
   317	        Rotation::None => wire,
   318	    }
   319	}

+impl BeesImpl {
+    pub fn read_data(data: &NbtTag) -> Option<Self> {
+        let NbtTag::List(entries) = data else {
+            return None;
+        };
+        Some(Self {
+            bees: Cow::Owned(entries
+                .iter()
+                .filter_map(|entry| match entry {
+                    NbtTag::Compound(compound) => Some(compound.clone()),
+                    _ => None,
+                })
+                .collect()),
+        })
+    }
+}

   368	   protected Map<Direction, FluidState> getSpread(final ServerLevel level, final BlockPos pos, final BlockState state) {
   369	      int lowest = 1000;
   370	      Map<Direction, FluidState> result = Maps.newEnumMap(Direction.class);
   371	      FlowingFluid.SpreadContext context = null;
   372	
   373	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   374	         BlockPos testPos = pos.relative(direction);
   375	         BlockState testState = level.getBlockState(testPos);
   376	         FluidState testFluidState = testState.getFluidState();
   377	         if (this.canMaybePassThrough(level, pos, state, direction, testPos, testState, testFluidState)) {
   378	            FluidState newFluid = this.getNewLiquid(level, testPos, testState);
   379	            if (canHoldSpecificFluid(level, testPos, testState, newFluid.getType())) {
   380	               if (context == null) {
   381	                  context = new FlowingFluid.SpreadContext(level, pos);
   382	               }
   383	
   384	               int distance;
   385	               if (context.isHole(testPos)) {
   386	                  distance = 0;
   387	               } else {
   388	                  distance = this.getSlopeDistance(level, testPos, 1, direction.getOpposite(), testState, context);
   389	               }
   390	
   391	               if (distance < lowest) {
   392	                  result.clear();
   393	               }
   394	
   395	               if (distance <= lowest) {
   396	                  if (testFluidState.canBeReplacedWith(level, testPos, newFluid.getType(), direction)) {
   397	                     result.put(direction, newFluid);
   398	                  }
   399	
   400	                  lowest = distance;
   401	               }
   402	            }
   403	         }
   404	      }
   405	
   406	      return result;
   407	   }

   326	
   327	   private void updateNeighborsOfNeighboringWires(final Level level, final BlockPos pos) {
   328	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   329	         this.checkCornerChangeAt(level, pos.relative(direction));
   330	      }
   331	
   332	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   333	         BlockPos target = pos.relative(direction);
   334	         if (level.getBlockState(target).isRedstoneConductor(level, target)) {
   335	            this.checkCornerChangeAt(level, target.above());
   336	         } else {
   337	            this.checkCornerChangeAt(level, target.below());
   338	         }
   339	      }
   340	   }
   340	   }

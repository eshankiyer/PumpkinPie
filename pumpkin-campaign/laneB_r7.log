  6708	    pub fn get_block_and_fluid(
  6709	        &self,
  6710	        position: &BlockPos,
  6711	    ) -> (
  6712	        &'static pumpkin_data::Block,
  6713	        &'static pumpkin_data::fluid::Fluid,
  6714	    ) {
  6715	        let id = self.get_block_state_id(position);
  6716	        let block = Block::from_state_id(id);
  6717	
  6718	        if block == &Block::BUBBLE_COLUMN {
  6719	            return (block, Fluid::FLOWING_WATER.to_flowing());
  6720	        }
  6721	
  6722	        let fluid = if block.name == "seagrass" || block.name == "tall_seagrass" {
  6723	            &Fluid::FLOWING_WATER
  6724	        } else {
  6725	            Fluid::from_state_id(id)
  6726	                .map(Fluid::to_flowing)
  6727	                .ok_or(&Fluid::EMPTY)
  6728	                .unwrap_or_else(|_| {
  6729	                    block
  6730	                        .properties(id)
  6731	                        .and_then(|props| {
  6732	                            props
  6733	                                .to_props()
  6734	                                .into_iter()
  6735	                                .find(|p| p.0 == "waterlogged")
  6736	                                .map(|(_, value)| {
  6737	                                    if value == "true" {
  6738	                                        &Fluid::FLOWING_WATER
  6739	                                    } else {
  6740	                                        &Fluid::EMPTY
  6741	                                    }
  6742	                                })
  6743	                        })
  6744	                        .unwrap_or(&Fluid::EMPTY)
  6745	                })
  6746	        };
  6747	        (block, fluid)
  6748	    }

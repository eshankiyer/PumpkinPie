   950	
   951	/// Represents the different types of data encoding used in Minecraft's bit-packed chunk sections.
   952	///
   953	/// Minecraft uses a "Palette" system to compress chunk data. Instead of sending a full
   954	/// 15-bit `BlockState` ID for every block, it sends a smaller index (e.g., 4 bits) that
   955	/// points to a value in these palettes.
   956	pub enum NetworkPalette<V> {
   957	    /// **Single Value Palette (Bits per entry: 0)**
   958	    ///
   959	    /// Used when an entire chunk section (16x16x16) consists of only one type of block or biome.
   960	    /// No data array follows this palette in the network buffer.
   961	    Single(V),
   962	    /// **Indirect Palette (Bits per entry: 1-8 for blocks, 1-3 for biomes)**
   963	    ///
   964	    /// A list of unique values present in the section. The data array contains indices
   965	    /// pointing into this list.
   966	    Indirect(Box<[V]>),
   967	    /// **Direct Palette (Bits per entry: 15+ for blocks, 6+ for biomes)**
   968	    ///
   969	    /// Used when the section is too complex for a small palette. The data array
   970	    /// contains global Registry IDs directly. No palette list is sent.
   971	    Direct,
   972	}
   973	
   974	pub struct NetworkSerialization<V> {
   975	    pub bits_per_entry: u8,
   976	    pub palette: NetworkPalette<V>,
   977	    pub packed_data: Box<[i64]>,
   978	}
   979	
   980	pub struct BeNetworkSerialization<V> {
   981	    pub bits_per_entry: u8,
   982	    pub palette: NetworkPalette<V>,
   983	    pub packed_data: Box<[u32]>,
   984	}
   985	
   986	// According to the wiki, palette serialization for disk and network is different. Disk
   987	// serialization always uses a palette if greater than one entry. Network serialization packs ids
   988	// directly instead of using a palette above a certain bits-per-entry
   989	
   990	// TODO: Do our own testing; do we really need to handle network and disk serialization differently?
   991	pub type BlockPalette = PalettedContainer<BlockStateId, 16>;
   992	const BLOCK_DISK_MIN_BITS: u8 = 4;
   993	const BLOCK_NETWORK_MIN_MAP_BITS: u8 = 4;
   994	const BLOCK_NETWORK_MAX_MAP_BITS: u8 = 8;
   995	pub(crate) const BLOCK_NETWORK_MAX_BITS: u8 = 15;
   996	
   997	pub type BiomePalette = PalettedContainer<u8, 4>;
   998	const BIOME_DISK_MIN_BITS: u8 = 0;
   999	const BIOME_NETWORK_MIN_MAP_BITS: u8 = 1;
  1000	const BIOME_NETWORK_MAX_MAP_BITS: u8 = 3;
  1001	pub(crate) const BIOME_NETWORK_MAX_BITS: u8 = 7;

   352	pub const fn make_cross(power: u8) -> RedstoneWireProperties {
   353	    RedstoneWireProperties {
   354	        north: NorthRedstone::Side,
   355	        south: SouthRedstone::Side,
   356	        east: EastRedstone::Side,
   357	        west: WestRedstone::Side,
   358	        power,
   359	    }
   360	}
   361	
   362	async fn can_connect_to(
   363	    world: &World,
   364	    block: &Block,
   365	    side: BlockDirection,
   366	    state: &BlockState,
   367	) -> bool {
   368	    // `RedStoneWireBlock.shouldConnectTo` checks wire, repeater and observer BEFORE the generic
   369	    // signal-source fallback. An observer is a signal source in every direction, so testing that
   370	    // first made dust bend into all four of its sides instead of only its output face.
   371	    if block == &Block::REDSTONE_WIRE {
   372	        return true;
   373	    }
   374	    if block == &Block::REPEATER {
   375	        let repeater_props = RepeaterLikeProperties::from_state_id(state.id, block);
   376	        return repeater_props.facing.to_block_direction() == side
   377	            || repeater_props.facing.to_block_direction() == side.opposite();
   378	    }
   379	    if block == &Block::OBSERVER {
   380	        let observer_props = ObserverLikeProperties::from_state_id(state.id, block);
   381	        return observer_props.facing == side.to_facing();
   382	    }
   383	
   384	    world
   385	        .block_registry
   386	        .emits_redstone_power(block, state, side)
   387	        .await
   388	}

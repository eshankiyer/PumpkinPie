   338	   private static class BeeData {
   339	      private final BeehiveBlockEntity.Occupant occupant;
   340	      private int ticksInHive;
   341	
   342	      private BeeData(final BeehiveBlockEntity.Occupant occupant) {
   343	         this.occupant = occupant;
   344	         this.ticksInHive = occupant.ticksInHive();
   345	      }
   346	
   347	      public boolean tick() {
   348	         return this.ticksInHive++ > this.occupant.minTicksInHive;
   349	      }
   350	
   351	      public BeehiveBlockEntity.Occupant toOccupant() {
   352	         return new BeehiveBlockEntity.Occupant(this.occupant.entityData, this.ticksInHive, this.occupant.minTicksInHive);
   353	      }
   354	
   355	      public boolean hasNectar() {
   356	         return this.occupant.entityData.getUnsafe().getBooleanOr("HasNectar", false);
   357	      }
   358	   }
   359	
   360	   public enum BeeReleaseStatus {
   361	      HONEY_DELIVERED,
   362	      BEE_RELEASED,
   363	      EMERGENCY;
   364	   }
   365	
   366	   public record Occupant(TypedEntityData<EntityType<?>> entityData, int ticksInHive, int minTicksInHive) {
   367	      public static final Codec<BeehiveBlockEntity.Occupant> CODEC = RecordCodecBuilder.create(
   368	         i -> i.group(
   369	               TypedEntityData.codec(EntityType.CODEC).fieldOf("entity_data").forGetter(BeehiveBlockEntity.Occupant::entityData),
   370	               Codec.INT.fieldOf("ticks_in_hive").forGetter(BeehiveBlockEntity.Occupant::ticksInHive),
   371	               Codec.INT.fieldOf("min_ticks_in_hive").forGetter(BeehiveBlockEntity.Occupant::minTicksInHive)
   372	            )
   373	            .apply(i, BeehiveBlockEntity.Occupant::new)
   374	      );
   375	      public static final Codec<List<BeehiveBlockEntity.Occupant>> LIST_CODEC = CODEC.listOf();
   376	      public static final StreamCodec<RegistryFriendlyByteBuf, BeehiveBlockEntity.Occupant> STREAM_CODEC = StreamCodec.composite(
   377	         TypedEntityData.streamCodec(EntityType.STREAM_CODEC),
   378	         BeehiveBlockEntity.Occupant::entityData,
   379	         ByteBufCodecs.VAR_INT,
   380	         BeehiveBlockEntity.Occupant::ticksInHive,
   381	         ByteBufCodecs.VAR_INT,
   382	         BeehiveBlockEntity.Occupant::minTicksInHive,
   383	         BeehiveBlockEntity.Occupant::new
   384	      );
   385	
   386	      public static BeehiveBlockEntity.Occupant of(final Entity entity) {
   387	         try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(entity.problemPath(), BeehiveBlockEntity.LOGGER)) {
   388	            TagValueOutput output = TagValueOutput.createWithContext(reporter, entity.registryAccess());
   389	            entity.save(output);
   390	            BeehiveBlockEntity.IGNORED_BEE_TAGS.forEach(output::discard);
   391	            CompoundTag entityTag = output.buildResult();
   392	            boolean hasNectar = entityTag.getBooleanOr("HasNectar", false);
   393	            return new BeehiveBlockEntity.Occupant(TypedEntityData.of(entity.getType(), entityTag), 0, hasNectar ? 2400 : 600);
   394	         }
   395	      }
   396	
   397	      public static BeehiveBlockEntity.Occupant create(final int ticksInHive) {
   398	         return new BeehiveBlockEntity.Occupant(TypedEntityData.of(EntityTypes.BEE, new CompoundTag()), ticksInHive, 600);
   399	      }
   400	
   401	      public @Nullable Entity createEntity(final Level level, final BlockPos hivePos) {
   402	         CompoundTag entityTag = this.entityData.copyTagWithoutId();
   403	         BeehiveBlockEntity.IGNORED_BEE_TAGS.forEach(entityTag::remove);
   404	         Entity entity = EntityType.loadEntityRecursive(this.entityData.type(), entityTag, level, EntitySpawnReason.LOAD, EntityProcessor.NOP);
   405	         if (entity != null && entity.is(EntityTypeTags.BEEHIVE_INHABITORS)) {
   406	            entity.setNoGravity(true);
   407	            if (entity instanceof Bee bee) {
   408	               bee.setHivePos(hivePos);
   409	               setBeeReleaseData(this.ticksInHive, bee);
   410	            }
   411	
   412	            return entity;
   413	         } else {
   414	            return null;
   415	         }
   416	      }
   417	
   418	      private static void setBeeReleaseData(final int ticksInHive, final Bee bee) {
   419	         updateBeeAge(ticksInHive, bee);
   420	         bee.setInLoveTime(Math.max(0, bee.getInLoveTime() - ticksInHive));
   421	      }
   422	
   423	      private static void updateBeeAge(final int ticksInHive, final Bee bee) {
   424	         if (!bee.isAgeLocked()) {
   425	            int age = bee.getAge();
   426	            if (age < 0) {
   427	               bee.setAge(Math.min(0, age + ticksInHive));
   428	            } else if (age > 0) {
   429	               bee.setAge(Math.max(0, age - ticksInHive));
   430	            }
   431	         }
   432	      }
   433	   }


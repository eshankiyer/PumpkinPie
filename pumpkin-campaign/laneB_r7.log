   221	    fn get_strong_redstone_power<'a>(
   222	        &'a self,
   223	        args: GetRedstonePowerArgs<'a>,
   224	    ) -> BlockFuture<'a, u8> {
   225	        Box::pin(async move {
   226	            let wire = RedstoneWireProperties::from_state_id(args.state.id, args.block);
   227	            let is_connected = args
   228	                .direction
   229	                .opposite()
   230	                .to_horizontal_facing()
   231	                .is_some_and(|f| wire.is_side_connected(f));
   232	            if args.direction == BlockDirection::Up || is_connected {
   233	                wire.power
   234	            } else {
   235	                0
   236	            }
   237	        })
   238	    }

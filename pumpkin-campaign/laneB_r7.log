   473	   @Override
   474	   protected BlockState mirror(final BlockState state, final Mirror mirror) {
   475	      switch (mirror) {
   476	         case LEFT_RIGHT:
   477	            return state.setValue(NORTH, state.getValue(SOUTH)).setValue(SOUTH, state.getValue(NORTH));
   478	         case FRONT_BACK:
   479	            return state.setValue(EAST, state.getValue(WEST)).setValue(WEST, state.getValue(EAST));
   480	         default:
   481	            return super.mirror(state, mirror);
   482	      }
   483	   }

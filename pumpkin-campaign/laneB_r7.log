   140	/// `BeehiveBlock.resetHoneyLevel`.
   141	async fn reset_honey_level(
   142	    world: &Arc<World>,
   143	    block: &Block,
   144	    position: &BlockPos,
   145	    state_id: BlockStateId,
   146	) {
   147	    let mut props = BeeNestLikeProperties::from_state_id(state_id, block);
   148	    props.honey_level = 0;

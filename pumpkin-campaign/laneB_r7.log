  6750	    pub fn get_fluid_and_fluid_state(
  6751	        &self,
  6752	        position: &BlockPos,
  6753	    ) -> (&'static Fluid, &'static FluidState) {
  6754	        let id = self.get_block_state_id(position);
  6755	
  6756	        let Some(raw_fluid) = Fluid::from_state_id(id) else {
  6757	            let block = Block::from_state_id(id);
  6758	            if block == &Block::BUBBLE_COLUMN {
  6759	                return crate::block::blocks::bubble_column::BubbleColumnBlock::fluid_state();
  6760	            }
  6761	            // `SeagrassBlock.getFluidState` (SeagrassBlock.java:85-88) and
  6762	            // `TallSeagrassBlock.getFluidState` (TallSeagrassBlock.java:78-80) always report a
  6763	            // full water source; neither block has a `waterlogged` property, so mirror the
  6764	            // waterlogged branch below by reporting the source WATER fluid state.
  6765	            if block.name == "seagrass" || block.name == "tall_seagrass" {
  6766	                return (&Fluid::WATER, &Fluid::WATER.states[0]);
  6767	            }
  6768	            if let Some(properties) = block.properties(id) {
  6769	                for (name, value) in properties.to_props() {
  6770	                    if name == "waterlogged" {
  6771	                        if value == "true" {
  6772	                            let state = &Fluid::WATER.states[0];
  6773	                            return (&Fluid::WATER, state);
  6774	                        }
  6775	
  6776	                        break;
  6777	                    }
  6778	                }
  6779	            }
  6780	
  6781	            let state = &Fluid::EMPTY.states[0];
  6782	            return (&Fluid::EMPTY, state);
  6783	        };
  6784	
  6785	        // Air is represented by the EMPTY fluid registry entry. It has no
  6786	        // fluid properties, so asking it for an indexed state would panic.
  6787	        if raw_fluid == &Fluid::EMPTY {
  6788	            return (&Fluid::EMPTY, &Fluid::EMPTY.states[0]);
  6789	        }
  6790	
  6791	        // Keep the state variant selected by the block state.  Converting source water/lava
  6792	        // to its flowing registry entry and then taking states[0] loses the level/height of
  6793	        // partial fluid blocks, which is observable by entity eye-fluid checks. Only the
  6794	        // flowing fluids carry a level property; `Fluid::properties` panics for the others,
  6795	        // and air maps to `Fluid::EMPTY`, which every entity tick asks about.
  6796	        let state = if raw_fluid == &Fluid::FLOWING_WATER || raw_fluid == &Fluid::FLOWING_LAVA {
  6797	            let index = raw_fluid.properties(id).to_index() as usize;
  6798	            &raw_fluid.states[index]
  6799	        } else {
  6800	            &raw_fluid.states[0]
  6801	        };
  6802	
  6803	        (raw_fluid, state)
  6804	    }

   162	/// `CampfireBlock.isSmokeyPos` (`CampfireBlock.java:261`), reduced to a solid-block test in
   163	/// place of the `SHAPE_VIRTUAL_POST` collision join, which Pumpkin has no equivalent for.
   164	#[must_use]
   165	pub fn is_smokey_pos(world: &World, pos: &BlockPos) -> bool {
   166	    for i in 1..=5 {
   167	        let to_check = BlockPos::new(pos.0.x, pos.0.y - i, pos.0.z);
   168	        let (block, state) = world.get_block_and_state(&to_check);
   169	        if is_lit_campfire(block, state.id) {
   170	            return true;
   171	        }
   172	        if state.is_solid_block() {
   173	            let below = BlockPos::new(to_check.0.x, to_check.0.y - 1, to_check.0.z);
   174	            let (below_block, below_state) = world.get_block_and_state(&below);
   175	            return is_lit_campfire(below_block, below_state.id);
   176	        }
   177	    }
   178	    false
   179	}
   180	
   181	/// `CampfireBlock.isLitCampfire`.
   182	fn is_lit_campfire(block: &Block, state_id: BlockStateId) -> bool {
   183	    if block.id != Block::CAMPFIRE.id && block.id != Block::SOUL_CAMPFIRE.id {
   184	        return false;
   185	    }
   186	    CampfireLikeProperties::from_state_id(state_id, block).lit
   187	}

   621	pub async fn calc_block_breaking(
   622	    player: &Player,
   623	    state: &BlockState,
   624	    block: &'static Block,
   625	) -> f32 {
   626	    let hardness = state.hardness;
   627	    #[expect(clippy::float_cmp)]
   628	    if hardness == -1.0 {
   629	        // unbreakable
   630	        return 0.0;
   631	    }
   632	    let i = if player.can_harvest(state, block).await {
   633	        30.0
   634	    } else {
   635	        100.0
   636	    };
   637	
   638	    player.get_mining_speed(block).await / hardness / i
   639	}

   442	   @Override
   443	   public void tick(final ServerLevel level, final BlockPos pos, BlockState blockState, FluidState fluidState) {
   444	      if (!fluidState.isSource()) {
   445	         FluidState newFluidState = this.getNewLiquid(level, pos, level.getBlockState(pos));
   446	         int tickDelay = this.getSpreadDelay(level, pos, fluidState, newFluidState);
   447	         if (newFluidState.isEmpty()) {
   448	            fluidState = newFluidState;
   449	            blockState = Blocks.AIR.defaultBlockState();

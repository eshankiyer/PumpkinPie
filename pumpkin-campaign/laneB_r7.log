   156	   private BlockState getMissingConnections(final BlockGetter level, BlockState state, final BlockPos pos) {
   157	      boolean canConnectUp = !level.getBlockState(pos.above()).isRedstoneConductor(level, pos);
   158	
   159	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   160	         if (!state.getValue(PROPERTY_BY_DIRECTION.get(direction)).isConnected()) {
   161	            RedstoneSide sideConnection = this.getConnectingSide(level, pos, direction, canConnectUp);
   162	            state = state.setValue(PROPERTY_BY_DIRECTION.get(direction), sideConnection);
   163	         }
   164	      }

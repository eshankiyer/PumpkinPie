   131	/// This trait abstracts the player's ability to:
   132	/// - Drop items into the world
   133	/// - Receive inventory packets
   134	/// - Change equipment
   135	/// - Receive experience
   136	///
   137	/// Implementors are typically player entities that can open containers.
   138	/// Server-side analogue of vanilla's `ContainerLevelAccess` predicate
   139	/// (`net/minecraft/world/inventory/ContainerLevelAccess.java:9-37`), describing what
   140	/// still has to hold at the position a menu was opened against for the menu to stay
   141	/// usable.
   142	///
   143	/// Vanilla splits menu validation into two families:
   144	///
   145	/// * `AbstractContainerMenu.stillValid(ContainerLevelAccess, Player, Block)`
   146	///   (`AbstractContainerMenu.java:93-95`) - the block at the opening position must
   147	///   still be the expected block, and the player must still be within
   148	///   `blockInteractionRange() + 4.0` of it (`Player.java:2014-2016`). Crafting table,
   149	///   enchanting table, beacon, grindstone, loom, stonecutter, cartography table and
   150	///   the `ItemCombinerMenu` subclasses (`ItemCombinerMenu.java:110-112`) use this.
   151	/// * `Container.stillValidBlockEntity` (`Container.java:94-101`) - the block entity at
   152	///   the opening position must still be the same object, plus the same range check.
   153	///   Chest, furnace family, brewing stand, hopper, shulker box, crafter and lectern use
   154	///   this via `container.stillValid(player)`.
   155	///
   156	/// Pumpkin has no stable block-entity identity to compare against here, so the second
   157	/// family is modelled as [`ContainerAccess::RangeOnly`]; the "block entity replaced"
   158	/// half is covered separately by `World::close_container_screens_at`.
   159	#[derive(Clone, Copy)]
   160	pub enum ContainerAccess {
   161	    /// The menu has no backing world position and is never invalidated by movement
   162	    /// (the player's own inventory, merchant menus, plugin GUIs). Equivalent to
   163	    /// `ContainerLevelAccess.NULL`, whose `evaluate` yields `Optional.empty()` and so
   164	    /// falls through to `stillValid`'s `.orElse(true)`
   165	    /// (`ContainerLevelAccess.java:10-15`, `AbstractContainerMenu.java:93-95`).
   166	    None,
   167	    /// Range check only, mirroring `Container.stillValidBlockEntity`
   168	    /// (`Container.java:94-101`).
   169	    RangeOnly,
   170	    /// Range check plus a predicate on the block currently at the opening position,
   171	    /// mirroring `AbstractContainerMenu.stillValid`'s `state.is(block)` test
   172	    /// (`AbstractContainerMenu.java:93-95`) and `ItemCombinerMenu.isValidBlock`
   173	    /// (`ItemCombinerMenu.java:32`, `AnvilMenu.java:65-67`, `SmithingMenu.java:66-68`).
   174	    Block(fn(&Block) -> bool),
   175	}
   176	
   177	impl ContainerAccess {
   178	    /// Whether this access has a backing world position at all. `false` corresponds to
   179	    /// `ContainerLevelAccess.NULL` (`ContainerLevelAccess.java:10-15`), which makes
   180	    /// `stillValid` fall through to `.orElse(true)`.
   181	    #[must_use]
   182	    pub const fn requires_position(self) -> bool {
   183	        !matches!(self, Self::None)
   184	    }
   185	
   186	    /// Applies the block half of `AbstractContainerMenu.stillValid`
   187	    /// (`AbstractContainerMenu.java:93-95`) to the block currently at the opening
   188	    /// position. Accesses with no block requirement accept anything.
   189	    #[must_use]
   190	    pub fn accepts_block(self, block: &Block) -> bool {
   191	        match self {
   192	            Self::None | Self::RangeOnly => true,
   193	            Self::Block(predicate) => predicate(block),
   194	        }
   195	    }
   196	}

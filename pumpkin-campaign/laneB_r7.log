   196	   public static void awardWithDirection(final ServerLevel level, final Vec3 pos, final Vec3 roughDirection, int amount) {
   197	      while (amount > 0) {
   198	         int newCount = getExperienceValue(amount);
   199	         amount -= newCount;
   200	         if (!tryMergeToExisting(level, pos, newCount)) {
   201	            level.addFreshEntity(new ExperienceOrb(level, pos, roughDirection, newCount));
   202	         }
   203	      }
   204	   }

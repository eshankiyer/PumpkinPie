   174	pub async fn block_receives_redstone_power(world: &World, pos: &BlockPos) -> bool {
   175	    for facing in BlockDirection::all() {
   176	        let neighbor_pos = pos.offset(facing.to_offset());
   177	        let (block, state) = world.get_block_and_state(&neighbor_pos);
   178	        if is_emitting_redstone_power(block, state, world, &neighbor_pos, facing).await {
   179	            return true;
   180	        }
   181	    }
   182	    false
   183	}

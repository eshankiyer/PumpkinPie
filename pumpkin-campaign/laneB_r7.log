    79	    /// Core fluid tick handler that updates fluid state and triggers spreading.
    80	    ///
    81	    /// Processes scheduled fluid ticks by:
    82	    /// 1. Validating the block contains fluid
    83	    /// 2. Updating non-source fluid levels based on neighbors
    84	    /// 3. Triggering fluid spread to adjacent positions
    85	    ///
    86	    /// Sources (level 8, non-falling) always spread without state changes.
    87	    fn on_scheduled_tick_internal<'a>(
    88	        &'a self,
    89	        world: &'a Arc<World>,
    90	        fluid: &'a Fluid,
    91	        block_pos: &'a BlockPos,
    92	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
    93	        async move {
    94	            //let block = world.get_block(block_pos);
    95	            let current_block_state_id = world.get_block_state_id(block_pos);
    96	            let block = Block::from_state_id(current_block_state_id);
    97	
    98	            if !self.has_fluid_at(fluid, current_block_state_id) {
    99	                return;
   100	            }
   101	
   102	            let waterlogged = block.is_waterlogged(current_block_state_id);
   103	            let Some(current_fluid_state) = self.get_effective_props(fluid, current_block_state_id)
   104	            else {
   105	                return;
   106	            };
   107	            let is_source = current_fluid_state.level == Level::L8
   108	                && current_fluid_state.falling != Falling::True;
   109	            let state_for_spreading: FlowingFluidProperties;
   110	
   111	            // Update state if non-source
   112	            if !is_source && !waterlogged {
   113	                let new_fluid_state = self.get_new_liquid(world, fluid, block_pos).await;
   114	
   115	                if let Some(new_state) = new_fluid_state {
   116	                    let new_state_id = new_state.to_state_id(fluid);
   117	
   118	                    if new_state_id != current_block_state_id {
   119	                        world
   120	                            .set_block_state(block_pos, new_state_id, BlockFlags::NOTIFY_ALL)
   121	                            .await;
   122	
   123	                        // Schedule next tick for this position
   124	                        let old_state =
   125	                            FlowingFluidProperties::from_state_id(current_block_state_id, fluid);
   126	                        let tick_delay = self.get_spread_delay(world, &old_state, &new_state);
   127	                        world.schedule_fluid_tick(
   128	                            fluid,
   129	                            *block_pos,
   130	                            tick_delay,
   131	                            TickPriority::Normal,
   132	                        );
   133	                    }
   134	
   135	                    // Use the new state for spreading
   136	                    state_for_spreading = new_state;
   137	                } else {
   138	                    if !waterlogged {
   139	                        world
   140	                            .set_block_state(
   141	                                block_pos,
   142	                                Block::AIR.default_state.id,
   143	                                BlockFlags::NOTIFY_ALL,
   144	                            )
   145	                            .await;
   146	                    }
   147	                    return; // Don't spread if fluid is gone
   148	                }
   149	            } else {
   150	                // Sources use their current state
   151	                state_for_spreading = current_fluid_state;
   152	            }
   153	
   154	            // Then, spread using the appropriate state
   155	            self.try_flow(world, fluid, block_pos, &state_for_spreading)
   156	                .await;
   157	        }
   158	    }
   159	
   160	    /// Attempts to flow fluid from a position, prioritizing downward flow.
   161	    ///
   162	    /// Flow priority:
   163	    /// 1. Down - if space below, create falling fluid (level 8)
   164	    /// 2. Sides - spread horizontally using pathfinding
   165	    ///
   166	    /// Sources with 3+ adjacent sources also spread to sides when flowing down.
   167	    fn try_flow<'a>(
   168	        &'a self,
   169	        world: &'a Arc<World>,
   170	        fluid: &'a Fluid,
   171	        block_pos: &'a BlockPos,
   172	        props: &'a FlowingFluidProperties,
   173	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
   174	        async move {
   175	            let below_pos = block_pos.down();
   176	            let below_state = world.get_block_state(&below_pos);
   177	            let below_block = Block::from_state_id(below_state.id);
   178	            let is_hole = physics::can_be_replaced(below_state, below_block, fluid);
   179	
   180	            // Try to flow down first
   181	            if is_hole {
   182	                let falling_props = self.get_flowing(fluid, Level::L8, true);
   183	                self.spread_to(world, fluid, &below_pos, falling_props.to_state_id(fluid))
   184	                    .await;
   185	
   186	                // Check if we should also spread to sides
   187	                if props.level == Level::L8 && props.falling == Falling::False {
   188	                    let source_count = self.count_source_neighbors(world, fluid, block_pos).await;
   189	                    if source_count >= 3 {
   190	                        self.flow_to_sides(world, fluid, block_pos, props).await;
   191	                    }
   192	                }
   193	                return;
   194	            }
   195	
   196	            // Check if fluid should flow to the side(s)
   197	            self.flow_to_sides(world, fluid, block_pos, props).await;
   198	        }
   199	    }
   200	
   201	    fn count_source_neighbors<'a>(
   202	        &'a self,
   203	        world: &'a Arc<World>,
   204	        fluid: &'a Fluid,
   205	        block_pos: &'a BlockPos,
   206	    ) -> impl std::future::Future<Output = i32> + Send + 'a {
   207	        async move {
   208	            let mut count = 0;
   209	            for direction in [
   210	                BlockDirection::North,
   211	                BlockDirection::South,
   212	                BlockDirection::West,
   213	                BlockDirection::East,
   214	            ] {
   215	                let neighbor_pos = block_pos.offset(direction.to_offset());
   216	                let neighbor_id = world.get_block_state_id(&neighbor_pos);
   217	                if self
   218	                    .get_effective_props(fluid, neighbor_id)
   219	                    .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False)
   220	                {
   220	                {
   221	                    count += 1;
   222	                }
   223	            }
   224	            count
   225	        }
   226	    }
   227	
   228	    /// Calculates the new fluid state for a position based on neighbors and environment.
   229	    ///
   230	    /// Priority order:
   231	    /// 1. Sources remain unchanged
   232	    /// 2. Infinite source formation (2+ adjacent sources + solid/source below)
   233	    /// 3. Fluid above forces falling state (level 8, falling)
   234	    /// 4. Standard flow calculation from highest neighbor minus dropoff
   235	    ///
   236	    /// # Returns
   237	    /// New fluid properties, or None if fluid should drain
   238	    fn get_new_liquid<'a>(
   239	        &'a self,
   240	        world: &'a Arc<World>,
   241	        fluid: &'a Fluid,
   242	        block_pos: &'a BlockPos,
   243	    ) -> impl std::future::Future<Output = Option<FlowingFluidProperties>> + Send + 'a {
   244	        async move {
   245	            let current_state_id = world.get_block_state_id(block_pos);
   246	            let current_props = FlowingFluidProperties::from_state_id(current_state_id, fluid);
   247	
   248	            // Sources never change
   249	            if current_props.level == Level::L8 && current_props.falling != Falling::True {
   250	                return Some(current_props);
   251	            }
   252	
   253	            // First: check horizontal neighbors for infinite source formation
   254	            let mut highest_neighbor = 0;
   255	            let mut neighbor_source_count = 0;
   256	            for direction in [
   257	                BlockDirection::North,
   258	                BlockDirection::South,
   259	                BlockDirection::West,
   260	                BlockDirection::East,
   261	            ] {
   262	                let neighbor_pos = block_pos.offset(direction.to_offset());
   263	                let neighbor_state_id = world.get_block_state_id(&neighbor_pos);
   264	                let Some(neighbor_props) = self.get_effective_props(fluid, neighbor_state_id)
   265	                else {
   266	                    continue;
   267	                };
   268	
   269	                // Count horizontal non-falling sources for infinite source formation
   270	                if neighbor_props.level == Level::L8 && neighbor_props.falling == Falling::False {
   271	                    neighbor_source_count += 1;
   272	                }
   273	
   274	                // Falling water from the side counts as level 8
   275	                let neighbor_level = if neighbor_props.falling == Falling::True {
   276	                    8
   277	                } else {
   278	                    i32::from(neighbor_props.level.to_index()) + 1
   279	                };
   280	
   281	                highest_neighbor = highest_neighbor.max(neighbor_level);
   282	            }
   283	
   284	            // Attempt infinite source formation first
   285	            if self.can_convert_to_source(world) && neighbor_source_count >= 2 {
   286	                let below_pos = block_pos.down();
   287	                let below_state = world.get_block_state(&below_pos);
   288	                let below_state_id = below_state.id;
   289	
   290	                // Check if block below is a stable source of the same fluid
   291	                let below_is_same_source = self
   292	                    .get_effective_props(fluid, below_state_id)
   293	                    .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False);
   294	
   295	                // If the block below is solid (solid block) or a source of same fluid, form a source here.
   296	                if below_is_same_source || below_state.is_solid_block() {
   297	                    return Some(self.get_source(fluid, false));
   298	                }
   299	                // Otherwise continue to standard falling/flowing logic
   300	            }
   301	
   302	            // Then: if there's water above, this block is ALWAYS level 8, falling=true
   303	            let above_pos = block_pos.up();
   304	            let above_state_id = world.get_block_state_id(&above_pos);
   305	
   306	            if self.has_fluid_at(fluid, above_state_id) {
   307	                return Some(self.get_flowing(fluid, Level::L8, true));
   308	            }
   309	
   310	            // Standard flowing calculation
   311	            let drop_off = self.get_level_decrease_per_block(world);
   312	            let new_level = highest_neighbor - drop_off;
   313	
   314	            if new_level <= 0 {
   315	                None
   316	            } else {
   317	                Some(self.get_flowing(fluid, Level::from_index(new_level as u16 - 1), false))
   318	            }
   319	        }
   320	    }
   321	
   322	    /// Core spread logic with quiescence checks and state updates.
   323	    ///
   324	    /// Implements:
   325	    /// - Quiescence: prevents unnecessary updates (e.g., source blocks, lower levels)
   326	    /// - Infinite source formation checks (before and after placement)
   327	    /// - Block replacement for non-fluid blocks
   328	    /// - Fluid tick scheduling for non-source blocks
   329	    ///
   330	    /// Called by `spread_to` implementations after fluid-specific pre-checks.
   331	    #[allow(clippy::too_many_lines)]
   332	    fn apply_spread<'a>(
   333	        &'a self,
   334	        world: &'a Arc<World>,
   335	        fluid: &'a Fluid,
   336	        pos: &'a BlockPos,
   337	        state_id: BlockStateId,
   338	        new_props: FlowingFluidProperties,
   339	    ) -> impl std::future::Future<Output = ()> + Send + 'a {
   340	        async move {
   341	            let current_state_id = world.get_block_state_id(pos);
   342	            if let Some(current_props) = self.get_effective_props(fluid, current_state_id) {
   343	                let current_level = i32::from(current_props.level.to_index()) + 1;
   344	                let new_level = i32::from(new_props.level.to_index()) + 1;
   345	                let current_is_source =
   346	                    current_props.level == Level::L8 && current_props.falling == Falling::False;
   347	                let new_is_source =
   348	                    new_props.level == Level::L8 && new_props.falling == Falling::False;
   349	
   350	                // Never overwrite a source with anything
   351	                if current_is_source {
   352	                    return;
   353	                }
   354	
   355	                // Check for infinite source formation before quiescence checks
   356	                if !current_is_source && self.can_convert_to_source(world) {
   357	                    let should_convert = self
   358	                        .check_infinite_source_formation(world, fluid, pos)
   359	                        .await;
   360	
   361	                    if should_convert {
   362	                        let source_props = self.get_source(fluid, false);
   363	                        let source_state_id = source_props.to_state_id(fluid);
   364	                        world
   365	                            .set_block_state(pos, source_state_id, BlockFlags::NOTIFY_ALL)
   366	                            .await;
   367	
   368	                        // Sources don't need ticks
   369	                        return;
   370	                    }
   371	                }
   372	
   373	                // If new is a source, always accept it
   374	                if new_is_source {
   375	                    // Continue to set state below
   376	                } else if current_props.falling == new_props.falling {
   377	                    // Same falling state - check level
   378	                    if new_level <= current_level {
   379	                        return;
   380	                    }
   381	                }
   382	            } else {
   383	                // Replace non-fluid blocks
   384	                let block = world.get_block(pos);
   385	                let state = world.get_block_state(pos);
   386	                if fluid.matches_type(&Fluid::WATER)
   387	                    && (block == &Block::CAMPFIRE || block == &Block::SOUL_CAMPFIRE)
   388	                {
   389	                    crate::block::blocks::campfire::CampfireBlock::place_liquid(
   390	                        world, pos, block, state.id, fluid,
   391	                    )
   392	                    .await;
   393	                    return;
   394	                }
   395	                if fluid.matches_type(&Fluid::WATER)
   396	                    && block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_CANDLES)
   397	                    && crate::block::blocks::candles::CandleBlock::place_liquid(
   398	                        world, pos, block, state.id, fluid,
   399	                    )
   400	                    .await
   401	                {
   402	                    return;
   403	                }
   404	                if let Some(waterlogged_state) =
   405	                    physics::waterlogged_replacement_state(state, block, fluid)
   406	                {
   407	                    world
   408	                        .set_block_state(pos, waterlogged_state, BlockFlags::NOTIFY_ALL)
   409	                        .await;
   410	                    world.schedule_fluid_tick(
   411	                        fluid,
   412	                        *pos,
   413	                        self.get_flow_speed(world),
   414	                        TickPriority::Normal,
   415	                    );
   416	                    return;
   417	                }
   418	                if block.id != Block::AIR.id {
   419	                    self.before_destroying_block(world, pos).await;
   420	                }
   421	            }
   422	
   423	            let mut event = crate::plugin::api::events::block::block_from_to::BlockFromToEvent::new(
   424	                *pos,
   425	                *pos,
   426	                &pumpkin_data::Block::WATER,
   427	            );
   428	            if let Some(server) = world.server.upgrade() {
   429	                server.plugin_manager.fire(&server, &mut event).await;
   430	            }
   431	            if event.cancelled {
   432	                return;
   433	            }
   434	
   435	            world
   436	                .set_block_state(pos, state_id, BlockFlags::NOTIFY_ALL)
   437	                .await;
   438	
   439	            // Check for infinite source formation after placing new fluid
   440	            if self.can_convert_to_source(world) {
   441	                let should_convert = self
   442	                    .check_infinite_source_formation(world, fluid, pos)
   443	                    .await;
   444	
   445	                if should_convert {
   446	                    let source_props = self.get_source(fluid, false);
   447	                    let source_state_id = source_props.to_state_id(fluid);
   448	                    world
   449	                        .set_block_state(pos, source_state_id, BlockFlags::NOTIFY_ALL)
   450	                        .await;
   451	
   452	                    // Sources don't need ticks
   453	                    return;
   454	                }
   455	            }
   456	
   457	            // Only schedule tick if not a source
   458	            let is_source = new_props.level == Level::L8 && new_props.falling == Falling::False;
   459	
   460	            if !is_source {
   461	                let tick_delay = self.get_flow_speed(world);
   462	                world.schedule_fluid_tick(fluid, *pos, tick_delay, TickPriority::Normal);
   463	            }
   464	        }
   465	    }

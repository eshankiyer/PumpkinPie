   467	    /// Checks if infinite source formation conditions are met.
   468	    ///
   469	    /// Requirements:
   470	    /// - 2+ horizontally adjacent source blocks (level 8, non-falling)
   471	    /// - Block below is either solid OR a source of the same fluid
   472	    ///
   473	    /// # Returns
   474	    /// `true` if position should convert to a source block
   475	    fn check_infinite_source_formation<'a>(
   476	        &'a self,
   477	        world: &'a Arc<World>,
   478	        fluid: &'a Fluid,
   479	        pos: &'a BlockPos,
   480	    ) -> impl std::future::Future<Output = bool> + Send + 'a {
   481	        async move {
   482	            // Count adjacent horizontal source blocks
   483	            let mut source_count = 0;
   484	            for direction in [
   485	                BlockDirection::North,
   486	                BlockDirection::South,
   487	                BlockDirection::West,
   488	                BlockDirection::East,
   489	            ] {
   490	                let neighbor_pos = pos.offset(direction.to_offset());
   491	                let neighbor_state_id = world.get_block_state_id(&neighbor_pos);
   492	
   493	                if self
   494	                    .get_effective_props(fluid, neighbor_state_id)
   495	                    .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False)
   496	                {
   497	                    source_count += 1;
   498	                }
   499	            }
   500	
   501	            // Need at least 2 source neighbors
   502	            if source_count < 2 {
   503	                return false;
   504	            }
   505	
   506	            // Check the block below
   507	            let below_pos = pos.down();
   508	            let below_state = world.get_block_state(&below_pos);
   509	            let below_state_id = below_state.id;
   510	
   511	            // Check if block below is a stable source of the same fluid
   512	            let below_is_same_source = self
   513	                .get_effective_props(fluid, below_state_id)
   514	                .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False);
   515	
   516	            // Convert to source if below is solid or a source of same fluid
   517	            below_is_same_source || below_state.is_solid_block()
   518	        }
   519	    }

   111	/// Performs iterative BFS search to find the shortest distance to a downward flow opportunity.
   112	///
   113	/// Uses stack-allocated array for zero heap allocations. Searches up to `get_max_flow_distance`
   114	/// (dynamic) horizontally from the starting position.
   115	///
   116	/// # Returns
   117	/// Distance to nearest hole, or 1000 if no hole found within search distance
   118	pub fn get_in_flow_down_distance_iterative<T: FlowingFluid + Sync + ?Sized>(
   119	    fluid_impl: &T,
   120	    world: &Arc<World>,
   121	    fluid: &Fluid,
   122	    start_pos: BlockPos,
   123	    initial_exclude_dir: BlockDirection,
   124	) -> i32 {
   125	    const MAX_QUEUE_SIZE: usize = 64;
   126	
   127	    let mut queue: [PathNode; MAX_QUEUE_SIZE] = [PathNode {
   128	        pos: BlockPos::new(0, 0, 0),
   129	        distance: 0,
   130	        exclude_dir: BlockDirection::North,
   131	    }; MAX_QUEUE_SIZE];
   132	
   133	    let mut queue_start = 0;
   134	    let mut queue_end = 0;
   135	
   136	    queue[queue_end] = PathNode {
   137	        pos: start_pos,
   138	        distance: 1,
   139	        exclude_dir: initial_exclude_dir,
   140	    };
   141	    queue_end = 1;
   142	
   143	    let mut visited_bitset = [0u64; 4];
   144	    let slope_find_distance = fluid_impl.get_max_flow_distance(world);
   145	
   146	    let get_bit_index = |pos: BlockPos| -> Option<usize> {
   147	        let dx = pos.0.x - start_pos.0.x + slope_find_distance;
   148	        let dz = pos.0.z - start_pos.0.z + slope_find_distance;
   149	        let grid_size = slope_find_distance * 2 + 1;
   150	        (dx >= 0 && dx < grid_size && dz >= 0 && dz < grid_size)
   151	            .then(|| (dz * grid_size + dx) as usize)
   152	    };
   153	
   154	    while queue_start < queue_end {
   155	        let node = queue[queue_start];
   156	        queue_start += 1;
   157	
   158	        if node.distance > slope_find_distance {
   159	            continue;
   160	        }
   161	
   162	        if let Some(bit_idx) = get_bit_index(node.pos) {
   163	            let word_idx = bit_idx / 64;
   164	            let bit_pos = bit_idx % 64;
   165	            if (visited_bitset[word_idx] & (1u64 << bit_pos)) != 0 {
   166	                continue;
   167	            }
   168	            visited_bitset[word_idx] |= 1u64 << bit_pos;
   169	        }
   170	
   171	        // Check for hole (downward flow opportunity)
   172	        let below_pos = node.pos.down();
   173	        let below_state = world.get_block_state(&below_pos);
   174	        let below_block = Block::from_state_id(below_state.id);
   175	        if physics::can_be_replaced(below_state, below_block, fluid) {
   176	            return node.distance;
   177	        }
   178	
   179	        for direction in [
   180	            BlockDirection::North,
   181	            BlockDirection::South,
   182	            BlockDirection::West,
   183	            BlockDirection::East,
   184	        ] {
   185	            if direction == node.exclude_dir {
   186	                continue;
   187	            }
   188	
   189	            let next_pos = node.pos.offset(direction.to_offset());
   190	
   191	            let next_state = world.get_block_state(&next_pos);
   192	            let next_block = Block::from_state_id(next_state.id);
   193	            if !physics::can_be_replaced(next_state, next_block, fluid) {
   194	                continue;
   195	            }
   196	
   197	            // Source blocks (including waterlogged) block horizontal pathfinding
   198	            let next_state_id = world.get_block_state_id(&next_pos);
   199	            if fluid_impl
   200	                .get_effective_props(fluid, next_state_id)
   201	                .is_some_and(|p| p.level == Level::L8 && p.falling == Falling::False)
   202	            {
   203	                continue;
   204	            }
   205	
   206	            if queue_end < MAX_QUEUE_SIZE {
   207	                queue[queue_end] = PathNode {
   208	                    pos: next_pos,
   209	                    distance: node.distance + 1,
   210	                    exclude_dir: direction.opposite(),
   211	                };
   212	                queue_end += 1;
   213	            }
   214	        }
   215	    }
   216	
   217	    1000
   218	}

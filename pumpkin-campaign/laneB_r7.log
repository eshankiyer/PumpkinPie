   504	   protected class SpreadContext {
   505	      private final BlockGetter level;
   506	      private final BlockPos origin;
   507	      private final Short2ObjectMap<BlockState> stateCache = new Short2ObjectOpenHashMap<>();
   508	      private final Short2BooleanMap holeCache = new Short2BooleanOpenHashMap();
   509	
   510	      private SpreadContext(final BlockGetter level, final BlockPos origin) {
   511	         this.level = level;
   512	         this.origin = origin;
   513	      }
   514	
   515	      public BlockState getBlockState(final BlockPos pos) {
   516	         return this.getBlockState(pos, this.getCacheKey(pos));
   517	      }
   518	
   519	      private BlockState getBlockState(final BlockPos pos, final short key) {
   520	         return this.stateCache.computeIfAbsent(key, k -> this.level.getBlockState(pos));
   521	      }
   522	
   523	      public boolean isHole(final BlockPos pos) {
   524	         return this.holeCache.computeIfAbsent(this.getCacheKey(pos), key -> {
   525	            BlockState state = this.getBlockState(pos, key);
   526	            BlockPos below = pos.below();
   527	            BlockState belowState = this.level.getBlockState(below);
   528	            return FlowingFluid.this.isWaterHole(this.level, pos, state, below, belowState);
   529	         });
   530	      }
   531	
   532	      private short getCacheKey(final BlockPos pos) {
   533	         int relativeX = pos.getX() - this.origin.getX();
   534	         int relativeZ = pos.getZ() - this.origin.getZ();
   535	         return (short)((relativeX + 128 & 0xFF) << 8 | relativeZ + 128 & 0xFF);
   536	      }
   537	   }
   538	}

   298	   private int repairPlayerItems(final ServerPlayer player, final int amount) {
   299	      Optional<EnchantedItemInUse> selected = EnchantmentHelper.getRandomItemWith(EnchantmentEffectComponents.REPAIR_WITH_XP, player, ItemStack::isDamaged);
   300	      if (selected.isPresent()) {
   301	         ItemStack itemStack = selected.get().itemStack();
   302	         int toRepairFromXpAmount = EnchantmentHelper.modifyDurabilityToRepairFromXp(player.level(), itemStack, amount);
   303	         int repair = Math.min(toRepairFromXpAmount, itemStack.getDamageValue());
   304	         itemStack.setDamageValue(itemStack.getDamageValue() - repair);
   305	         if (repair > 0) {
   306	            int remaining = amount - repair * amount / toRepairFromXpAmount;
   307	            if (remaining > 0) {
   308	               return this.repairPlayerItems(player, remaining);
   309	            }
   310	         }
   311	
   312	         return 0;
   313	      } else {
   314	         return amount;
   315	      }
   316	   }

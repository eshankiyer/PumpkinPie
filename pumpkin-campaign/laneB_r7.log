   454	   @Override
   455	   protected BlockState rotate(final BlockState state, final Rotation rotation) {
   456	      return switch (rotation) {
   457	         case CLOCKWISE_180 -> (BlockState)state.setValue(NORTH, state.getValue(SOUTH))
   458	            .setValue(EAST, state.getValue(WEST))
   459	            .setValue(SOUTH, state.getValue(NORTH))
   460	            .setValue(WEST, state.getValue(EAST));
   461	         case COUNTERCLOCKWISE_90 -> (BlockState)state.setValue(NORTH, state.getValue(EAST))
   462	            .setValue(EAST, state.getValue(SOUTH))
   463	            .setValue(SOUTH, state.getValue(WEST))
   464	            .setValue(WEST, state.getValue(NORTH));
   465	         case CLOCKWISE_90 -> (BlockState)state.setValue(NORTH, state.getValue(WEST))
   466	            .setValue(EAST, state.getValue(NORTH))
   467	            .setValue(SOUTH, state.getValue(EAST))
   468	            .setValue(WEST, state.getValue(SOUTH));
   469	         default -> state;
   470	      };
   471	   }

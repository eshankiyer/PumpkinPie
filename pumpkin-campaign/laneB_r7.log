   125	   public void emptyAllLivingFromHive(final @Nullable Player player, final BlockState state, final BeehiveBlockEntity.BeeReleaseStatus releaseReason) {
   126	      List<Entity> releasedFromHive = this.releaseAllOccupants(state, releaseReason);

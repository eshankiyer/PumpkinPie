+    let Some(hive) = entity.as_any().downcast_ref::<beehive::BeehiveBlockEntity>() else {
+        return Vec::new();
+    };
+    vec![(
+        pumpkin_data::data_component::DataComponent::Bees,
+        Some(Box::new(hive.bees_component().await).to_dyn()),
+    )]

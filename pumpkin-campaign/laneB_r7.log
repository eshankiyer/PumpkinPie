    28	/// Determines valid spread directions for fluid flow using hole-first priority.
    29	///
    30	/// - Holes (downward flow opportunities) get distance 0 priority
    31	/// - All directions with equal minimum distance are returned
    32	/// - Returns up to 4 directions with their computed fluid states
    33	pub async fn get_spread<T: FlowingFluid + Sync + ?Sized>(
    34	    fluid_impl: &T,
    35	    world: &Arc<World>,
    36	    fluid: &Fluid,
    37	    block_pos: &BlockPos,
    38	) -> ([(BlockDirection, BlockStateId); 4], usize) {
    39	    let mut min_dist = 1000;
    40	    let mut result = [(BlockDirection::North, BlockStateId::default()); 4];
    41	    let mut result_count = 0;
    42	
    43	    for direction in [
    44	        BlockDirection::North,
    45	        BlockDirection::South,
    46	        BlockDirection::West,
    47	        BlockDirection::East,
    48	    ] {
    49	        let side_pos = block_pos.offset(direction.to_offset());
    50	        let side_state = world.get_block_state(&side_pos);
    51	        let side_state_id = side_state.id;
    52	        let side_block = Block::from_state_id(side_state.id);
    53	
    54	        let side_fluid_props = fluid_impl.get_effective_props(fluid, side_state_id);
    55	
    56	        // Check if we can pass through (not a solid source block or waterlogged)
    57	        if !physics::can_be_replaced(side_state, side_block, fluid)
    58	            || side_fluid_props
    59	                .as_ref()
    60	                .is_some_and(|p| p.level == Level::L8 && p.falling != Falling::True)
    61	        {
    62	            continue;
    63	        }
    64	
    65	        // Skip if no valid fluid state for this position
    66	        let Some(new_fluid_props) = fluid_impl.get_new_liquid(world, fluid, &side_pos).await else {
    67	            continue;
    68	        };
    69	
    70	        let new_state_id = new_fluid_props.to_state_id(fluid);
    71	
    72	        // Holes get distance 0
    73	        let slope_dist = if is_hole(world, fluid, &side_pos) {
    74	            0
    75	        } else {
    76	            get_in_flow_down_distance_iterative(
    77	                fluid_impl,
    78	                world,
    79	                fluid,
    80	                side_pos,
    81	                direction.opposite(),
    82	            )
    83	        };
    84	
    85	        // Clear results if we find a shorter path
    86	        if slope_dist < min_dist {
    87	            result_count = 0;
    88	        }
    89	
    90	        // Add all directions with equal minimum distance
    91	        if slope_dist <= min_dist {
    92	            // Check if the fluid at this position can be replaced
    93	            let can_replace = side_fluid_props.as_ref().is_none_or(|sp| {
    94	                // Can replace if new level is higher or if target is falling
    95	                let target_level = i32::from(sp.level.to_index()) + 1;
    96	                let new_level = i32::from(new_fluid_props.level.to_index()) + 1;
    97	                new_level > target_level || sp.falling == Falling::True
    98	            });
    99	
   100	            if can_replace && result_count < 4 {
   101	                result[result_count] = (direction, new_state_id);
   102	                result_count += 1;
   103	            }
   104	
   105	            min_dist = slope_dist;
   106	        }
   107	    }
   108	    (result, result_count)
   109	}

   546	/// A slot whose `mayPlace` is a plain predicate function.
   547	///
   548	/// For the many vanilla menus that define an anonymous `Slot` subclass purely to override
   549	/// `mayPlace` (e.g. `CartographyTableMenu.java:49-60`'s map/paper slots, and its
   550	/// always-`false` result slot at `CartographyTableMenu.java:61-65`).
   551	pub struct PredicateSlot {
   552	    /// The inventory containing this slot.
   553	    pub inventory: Arc<dyn Inventory>,
   554	    /// Index of this slot within its inventory.
   555	    pub index: usize,
   556	    /// Protocol ID for this slot (assigned by screen handler).
   557	    pub id: AtomicU8,
   558	    /// The `mayPlace` predicate.
   559	    pub may_place: fn(&ItemStack) -> bool,
   560	}
   561	
   562	impl PredicateSlot {
   563	    #[must_use]
   564	    pub fn new(
   565	        inventory: Arc<dyn Inventory>,
   566	        index: usize,
   567	        may_place: fn(&ItemStack) -> bool,
   568	    ) -> Self {
   569	        Self {
   570	            inventory,
   571	            index,
   572	            id: AtomicU8::new(0),
   573	            may_place,
   574	        }
   575	    }
   576	}
   577	
   578	impl Slot for PredicateSlot {
   579	    fn get_inventory(&self) -> Arc<dyn Inventory> {
   580	        self.inventory.clone()
   581	    }
   582	
   583	    fn get_index(&self) -> usize {
   584	        self.index
   585	    }
   586	
   587	    fn set_id(&self, id: usize) {
   588	        self.id.store(id as u8, Ordering::Relaxed);
   589	    }
   590	
   591	    fn can_insert<'a>(&'a self, stack: &'a ItemStack) -> BoxFuture<'a, bool> {
   592	        let may_place = self.may_place;
   593	        Box::pin(async move { may_place(stack) })
   594	    }
   595	
   596	    fn mark_dirty(&self) -> BoxFuture<'_, ()> {
   597	        Box::pin(async move {
   598	            self.inventory.mark_dirty();
   599	        })
   600	    }
   601	}

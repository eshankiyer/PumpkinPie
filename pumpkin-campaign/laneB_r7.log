   434	   @Override
   435	   public void animateTick(final BlockState state, final Level level, final BlockPos pos, final RandomSource random) {
   436	      int power = state.getValue(POWER);
   437	      if (power != 0) {
   438	         for (Direction horizontal : Direction.Plane.HORIZONTAL) {
   439	            RedstoneSide connection = state.getValue(PROPERTY_BY_DIRECTION.get(horizontal));
   440	            switch (connection) {
   441	               case UP:
   442	                  spawnParticlesAlongLine(level, random, pos, COLORS[power], horizontal, Direction.UP, -0.5F, 0.5F);
   443	               case SIDE:
   444	                  spawnParticlesAlongLine(level, random, pos, COLORS[power], Direction.DOWN, horizontal, 0.0F, 0.5F);
   445	                  break;
   446	               case NONE:
   447	               default:
   448	                  spawnParticlesAlongLine(level, random, pos, COLORS[power], Direction.DOWN, horizontal, 0.0F, 0.3F);
   449	            }
   450	         }
   451	      }
   452	   }

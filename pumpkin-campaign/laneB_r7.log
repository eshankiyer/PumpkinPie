  2175	    async fn tick_precipitation_chunk(self: &Arc<Self>, chunk_pos: Vector2<i32>) {
  2176	        let local_x = rng().random_range(0..16);
  2177	        let local_z = rng().random_range(0..16);
  2178	        let x = (chunk_pos.x << 4) + local_x;
  2179	        let z = (chunk_pos.y << 4) + local_z;
  2180	        let surface_y = self.get_heightmap_height(MotionBlocking, x, z);
  2181	        let top = BlockPos::new(x, surface_y + 1, z);
  2182	        let below = top.down();
  2183	        // Whether it snows/freezes here is a property of the biome. With no resolvable
  2184	        // biome there is nothing to decide from, so skip this chunk's precipitation tick
  2185	        // instead of applying some other biome's weather.
  2186	        let Some(biome) = self.level.get_rough_biome(&top) else {
  2187	            return;
  2188	        };
  2189	
  2190	        // Freezing is unconditional on rain/snow falling right now: only temperature, light and
  2191	        // the lake-edge rule gate it (`ServerLevel#tickPrecipitation`, before the `isRaining`
  2192	        // check).
  2193	        if self.should_freeze_at(biome, &below) {
  2194	            self.clone()
  2195	                .set_block_state(&below, Block::ICE.default_state.id, BlockFlags::NOTIFY_ALL)
  2196	                .await;
  2197	        }
  2198	
  2199	        if !self.weather.lock().await.raining {
  2200	            return;
  2201	        }
  2202	
  2203	        let maximum_layers = self
  2204	            .level_info
  2205	            .load()
  2206	            .game_rules
  2207	            .max_snow_accumulation_height
  2208	            .clamp(0, 8) as u8;
  2209	        if maximum_layers > 0 && self.should_snow_at(biome, &top) {
  2210	            let state_id = self.get_block_state_id(&top);
  2211	            if state_id == Block::SNOW.default_state.id {
  2212	                let mut properties = SnowLikeProperties::from_state_id(state_id, &Block::SNOW);
  2213	                if properties.layers < maximum_layers {
  2214	                    properties.layers += 1;
  2215	                    self.clone()
  2216	                        .set_block_state(
  2217	                            &top,
  2218	                            properties.to_state_id(&Block::SNOW),
  2219	                            BlockFlags::NOTIFY_ALL,
  2220	                        )
  2221	                        .await;
  2222	                }
  2223	            } else {
  2224	                self.clone()
  2225	                    .set_block_state(&top, Block::SNOW.default_state.id, BlockFlags::NOTIFY_ALL)
  2226	                    .await;
  2227	            }
  2228	        }
  2229	
  2230	        // `Biome#getPrecipitationAt(belowPos, seaLevel)` + `Block#handlePrecipitation`: fills
  2231	        // cauldrons standing in the open. Independent of the freeze/snow branches above, and
  2232	        // evaluated at `below`, not `top`.
  2233	        let precipitation =
  2234	            if biome
  2235	                .weather
  2236	                .is_snow_at(below.0.x, below.0.y, below.0.z, self.sea_level)
  2237	            {
  2238	                Some(Precipitation::Snow)
  2239	            } else if biome
  2240	                .weather
  2241	                .is_rain_at(below.0.x, below.0.y, below.0.z, self.sea_level)
  2242	            {
  2243	                Some(Precipitation::Rain)
  2244	            } else {
  2245	                None
  2246	            };
  2247	        if let Some(precipitation) = precipitation {
  2248	            let below_state_id = self.get_block_state_id(&below);
  2249	            let below_block = Block::from_state_id(below_state_id);
  2250	            if let Some(pumpkin_block) = self.block_registry.get_pumpkin_block(below_block.id) {
  2251	                pumpkin_block
  2252	                    .handle_precipitation(HandlePrecipitationArgs {
  2253	                        world: self,
  2254	                        block: below_block,
  2255	                        state_id: below_state_id,
  2256	                        position: &below,
  2257	                        precipitation,
  2258	                    })
  2259	                    .await;
  2260	            }
  2261	        }
  2262	    }

   284	   public static void serverTick(final Level level, final BlockPos blockPos, final BlockState state, final BeehiveBlockEntity entity) {
   285	      tickOccupants(level, blockPos, state, entity.stored, entity.savedFlowerPos);
   286	      if (!entity.stored.isEmpty() && level.getRandom().nextDouble() < 0.005) {
   287	         double x = blockPos.getX() + 0.5;
   288	         double y = blockPos.getY();
   289	         double z = blockPos.getZ() + 0.5;
   290	         level.playSound(null, x, y, z, SoundEvents.BEEHIVE_WORK, SoundSource.BLOCKS, 1.0F, 1.0F);
   291	      }
   292	   }

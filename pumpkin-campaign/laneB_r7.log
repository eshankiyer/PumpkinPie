   313	impl BeehiveBlockEntity {
   314	    pub const ID: &'static str = "minecraft:beehive";
   315	
   316	    #[must_use]
   317	    pub const fn new(position: BlockPos) -> Self {
   318	        Self {
   319	            position,
   320	            bees: Mutex::const_new(Vec::new()),
   321	            flower_pos: Mutex::const_new(None),
   322	            dirty: AtomicBool::new(false),
   323	        }
   324	    }
   325	
   326	    fn mark_dirty(&self) {
   327	        self.dirty.store(true, Ordering::Relaxed);
   328	    }
   329	
   330	    /// `BeehiveBlockEntity.isEmpty`.
   331	    pub async fn is_empty(&self) -> bool {
   332	        self.bees.lock().await.is_empty()
   333	    }
   334	
   335	    /// `BeehiveBlockEntity.isFull`.
   336	    pub async fn is_full(&self) -> bool {
   337	        self.bees.lock().await.len() >= MAX_OCCUPANTS
   338	    }
   339	
   340	    /// `BeehiveBlockEntity.getOccupantCount`.
   341	    pub async fn occupant_count(&self) -> usize {
   342	        self.bees.lock().await.len()
   343	    }
   344	
   345	    /// `BeehiveBlockEntity.isSedated`.
   346	    #[must_use]
   347	    pub fn is_sedated(&self, world: &World) -> bool {
   348	        is_smokey_pos(world, &self.position)
   349	    }

    20	/// Checks if a position has a hole (downward flow opportunity) below it.
    21	fn is_hole(world: &Arc<World>, fluid: &Fluid, pos: &BlockPos) -> bool {
    22	    let below_pos = pos.down();
    23	    let below_state = world.get_block_state(&below_pos);
    24	    let below_block = Block::from_state_id(below_state.id);
    25	    physics::can_be_replaced(below_state, below_block, fluid)
    26	}

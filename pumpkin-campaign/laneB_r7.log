   218	    }
   219	
   220	    /// Checks if this slot can be modified by the player.
   221	    ///
   222	    /// Mojang name: `allowModification`
   223	    fn allow_modification<'a>(&'a self, player: &'a dyn InventoryPlayer) -> BoxFuture<'a, bool> {
   224	        // Default implementation logic:
   225	        Box::pin(async move {
   226	            self.can_insert(&self.get_cloned_stack().await).await
   227	                && self.can_take_items(player).await
   228	        })
   229	    }

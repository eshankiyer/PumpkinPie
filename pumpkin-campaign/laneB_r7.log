    96	    async fn receive_neighbor_fluids(
    97	        world: &Arc<World>,
    98	        _fluid: &Fluid,
    99	        block_pos: &BlockPos,
   100	    ) -> bool {
   101	        // Logic to determine if we should replace the fluid with any of (cobble, obsidian, stone, etc.)
   102	        let below_is_soul_soil = world
   103	            .get_block(&block_pos.offset(BlockDirection::Down.to_offset()))
   104	            == &Block::SOUL_SOIL;
   105	        let is_still = world.get_block_state_id(block_pos) == Block::LAVA.default_state.id;
   106	
   107	        // `LiquidBlock.shouldSpreadLiquid` walks POSSIBLE_FLOW_DIRECTIONS and dereferences the
   108	        // OPPOSITE of each, so the neighbours it tests are up, north, south, west and east. The
   109	        // block below is deliberately never tested, and the test is on the neighbour's fluid
   110	        // state, so a waterlogged slab or stairs counts as water.
   111	        for dir in BlockDirection::all() {
   112	            if dir == BlockDirection::Down {
   113	                continue;
   114	            }
   115	            let neighbor_pos = block_pos.offset(dir.to_offset());
   116	            let (neighbor_fluid, _) = world.get_fluid_and_fluid_state(&neighbor_pos);
   117	            if neighbor_fluid == &Fluid::WATER || neighbor_fluid == &Fluid::FLOWING_WATER {
   118	                let block = if is_still {
   119	                    Block::OBSIDIAN
   120	                } else {
   121	                    Block::COBBLESTONE
   122	                };
   123	                world
   124	                    .set_block_state(
   125	                        block_pos,
   126	                        block.default_state.id,
   127	                        BlockFlags::NOTIFY_NEIGHBORS,
   128	                    )
   129	                    .await;
   130	                world.sync_world_event(WorldEvent::LavaFizz, *block_pos, 0);
   131	                return false;
   132	            }
   133	            if below_is_soul_soil && world.get_block(&neighbor_pos) == &Block::BLUE_ICE {
   134	                if let Some(server) = world.server.upgrade() {
   135	                    let mut event =
   136	                        crate::plugin::api::events::block::block_form::BlockFormEvent::new(
   137	                            *block_pos,
   138	                            &Block::BASALT,
   139	                        );
   140	                    server.plugin_manager.fire(&server, &mut event).await;
   141	                    if event.cancelled {
   142	                        return false;
   143	                    }
   144	                }
   145	                world
   146	                    .set_block_state(
   147	                        block_pos,
   148	                        Block::BASALT.default_state.id,
   149	                        BlockFlags::NOTIFY_NEIGHBORS,
   150	                    )
   151	                    .await;
   152	                world.sync_world_event(WorldEvent::LavaFizz, *block_pos, 0);
   153	                return false;
   154	            }
   155	        }
   156	        true
   157	    }
   158	}

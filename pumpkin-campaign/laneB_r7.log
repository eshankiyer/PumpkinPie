    54	    /// Returns true if `state_id` represents the given fluid — either as a direct fluid state
    55	    /// or as a waterlogged block (when the fluid is water-type).
    56	    fn has_fluid_at(&self, fluid: &Fluid, state_id: BlockStateId) -> bool {
    57	        self.get_effective_props(fluid, state_id).is_some()
    58	    }

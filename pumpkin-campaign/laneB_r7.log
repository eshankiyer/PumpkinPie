   152	/// `EnvironmentAttributes.BEES_STAY_IN_HIVE`: raised by `WeatherAttributes` while it is raining
   153	/// and by the `Timelines` keyframes at day-time 12542 (on) and 23460 (off).
   154	pub async fn bees_stay_in_hive(world: &World) -> bool {
   155	    if world.weather.lock().await.raining {
   156	        return true;
   157	    }
   158	    let time_of_day = world.get_time_of_day().await.rem_euclid(24_000);
   159	    (12_542..23_460).contains(&time_of_day)
   160	}

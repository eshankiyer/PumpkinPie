+}
 impl DataComponentImpl for BeesImpl {
+    fn write_data(&self) -> NbtTag {
+        NbtTag::List(
+            self.bees
+                .iter()
+                .cloned()
+                .map(NbtTag::Compound)
+                .collect(),
+        )
+    }
+
     default_impl!(Bees);

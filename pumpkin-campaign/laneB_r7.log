   409	   private static boolean canHoldAnyFluid(final BlockState state) {
   410	      Block block = state.getBlock();
   411	      if (block instanceof LiquidBlockContainer) {
   412	         return true;
   413	      } else {
   414	         return state.blocksMotion()
   415	            ? false
   416	            : !(block instanceof DoorBlock)
   417	               && !state.is(BlockTags.SIGNS)
   418	               && !state.is(Blocks.LADDER)
   419	               && !state.is(Blocks.SUGAR_CANE)
   420	               && !state.is(Blocks.BUBBLE_COLUMN)
   421	               && !state.is(Blocks.NETHER_PORTAL)
   422	               && !state.is(Blocks.END_PORTAL)
   423	               && !state.is(Blocks.END_GATEWAY)
   424	               && !state.is(Blocks.STRUCTURE_VOID);
   425	      }
   426	   }

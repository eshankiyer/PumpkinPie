   118	   protected void spread(final ServerLevel level, final BlockPos pos, final BlockState state, final FluidState fluidState) {
   119	      if (!fluidState.isEmpty()) {
   120	         BlockPos belowPos = pos.below();
   121	         BlockState belowState = level.getBlockState(belowPos);
   122	         FluidState belowFluid = belowState.getFluidState();
   123	         if (this.canMaybePassThrough(level, pos, state, Direction.DOWN, belowPos, belowState, belowFluid)) {
   124	            FluidState newBelowFluid = this.getNewLiquid(level, belowPos, belowState);
   125	            Fluid newBelowFluidType = newBelowFluid.getType();
   126	            if (belowFluid.canBeReplacedWith(level, belowPos, newBelowFluidType, Direction.DOWN)
   127	               && canHoldSpecificFluid(level, belowPos, belowState, newBelowFluidType)) {
   128	               this.spreadTo(level, belowPos, belowState, Direction.DOWN, newBelowFluid);
   129	               if (this.sourceNeighborCount(level, pos) >= 3) {
   130	                  this.spreadToSides(level, pos, fluidState, state);
   131	               }
   132	
   133	               return;
   134	            }
   135	         }
   136	
   137	         if (fluidState.isSource() || !this.isWaterHole(level, pos, state, belowPos, belowState)) {
   138	            this.spreadToSides(level, pos, fluidState, state);
   139	         }
   140	      }
   141	   }
   142	
   143	   private void spreadToSides(final ServerLevel level, final BlockPos pos, final FluidState fluidState, final BlockState state) {
   144	      int neighbor = fluidState.getAmount() - this.getDropOff(level);
   145	      if (fluidState.getValue(FALLING)) {
   146	         neighbor = 7;
   147	      }
   148	
   149	      if (neighbor > 0) {
   150	         Map<Direction, FluidState> spreads = this.getSpread(level, pos, state);
   151	
   152	         for (Entry<Direction, FluidState> entry : spreads.entrySet()) {
   153	            Direction spread = entry.getKey();
   154	            FluidState newNeighborFluid = entry.getValue();
   155	            BlockPos neighborPos = pos.relative(spread);
   156	            this.spreadTo(level, neighborPos, level.getBlockState(neighborPos), spread, newNeighborFluid);
   157	         }
   158	      }
   159	   }

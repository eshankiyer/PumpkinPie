+            .expect("bees component should rebuild the hive entity");
+        let hive = applied
+            .as_any()
+            .downcast_ref::<BeehiveBlockEntity>()
+            .expect("component application should preserve the hive type");
+        assert_eq!(hive.occupant_count().await, 1);
+    }

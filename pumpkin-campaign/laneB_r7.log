   601	fn max_wire_power(wire_power: u8, world: &World, pos: BlockPos) -> u8 {
   602	    let (block, block_state) = world.get_block_and_state(&pos);
   603	    if block == &Block::REDSTONE_WIRE {
   604	        let wire = RedstoneWireProperties::from_state_id(block_state.id, block);
   605	        wire_power.max(wire.power)
   606	    } else {
   607	        wire_power
   608	    }
   609	}
   610	
   611	async fn calculate_power(world: &World, pos: &BlockPos) -> u8 {
   612	    let mut block_power: u8 = 0;
   613	    let mut wire_power: u8 = 0;
   614	
   615	    let up_pos = pos.offset(BlockDirection::Up.to_offset());
   616	    let up_state = world.get_block_state(&up_pos);
   617	
   618	    for side in BlockDirection::all() {
   619	        let neighbor_pos = pos.offset(side.to_offset());
   620	        wire_power = max_wire_power(wire_power, world, neighbor_pos);
   621	        let (neighbor, neighbor_state) = world.get_block_and_state(&neighbor_pos);
   622	        block_power = block_power.max(
   623	            get_redstone_power_no_dust(neighbor, neighbor_state, world, neighbor_pos, side).await,
   624	        );
   625	        if side.is_horizontal() {
   626	            if !up_state.is_solid_block() && neighbor_state.is_solid_block() {
   627	                wire_power = max_wire_power(
   628	                    wire_power,
   629	                    world,
   630	                    neighbor_pos.offset(BlockDirection::Up.to_offset()),
   631	                );
   632	            }
   633	
   634	            if !neighbor_state.is_solid_block() {
   635	                wire_power = max_wire_power(
   636	                    wire_power,
   637	                    world,
   638	                    neighbor_pos.offset(BlockDirection::Down.to_offset()),
   639	                );
   640	            }
   641	        }
   642	    }
   643	
   644	    block_power.max(wire_power.saturating_sub(1))
   645	}

   250	   private static <T> int[] reencodeContents(final BitStorage storage, final Palette<T> oldPalette, final Palette<T> newPalette) {
   251	      int[] buffer = new int[storage.getSize()];
   252	      storage.unpack(buffer);
   253	      PaletteResize<T> dummyResizer = PaletteResize.noResizeExpected();
   254	      int lastReadId = -1;
   255	      int lastWrittenId = -1;
   256	
   257	      for (int index = 0; index < buffer.length; index++) {
   258	         int id = buffer[index];
   259	         if (id != lastReadId) {
   260	            lastReadId = id;
   261	            lastWrittenId = newPalette.idFor(oldPalette.valueFor(id), dummyResizer);
   262	         }
   263	
   264	         buffer[index] = lastWrittenId;
   265	      }
   266	
   267	      return buffer;
   268	   }

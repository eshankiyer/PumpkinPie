   850	    /// First tries to stack with existing items, then fills empty slots.
   851	    fn insert_item<'a>(
   852	        &'a mut self,
   853	        stack: &'a mut ItemStack,
   854	        start_index: i32,
   855	        end_index: i32,
   856	        from_last: bool,
   857	    ) -> ScreenHandlerFuture<'a, bool> {
   858	        Box::pin(async move {
   859	            let mut success = false;
   860	            let mut current_index = if from_last {
   861	                end_index - 1
   862	            } else {
   863	                start_index
   864	            };
   865	
   866	            if stack.is_stackable() {
   867	                while !stack.is_empty()
   868	                    && (if from_last {
   869	                        current_index >= start_index
   870	                    } else {
   871	                        current_index < end_index
   872	                    })
   873	                {
   874	                    let slot = self.get_behaviour().slots[current_index as usize].clone();
   875	                    let mut slot_stack = slot.get_stack().await;
   876	
   877	                    if !slot_stack.is_empty() && slot_stack.are_items_and_components_equal(stack) {
   878	                        let combined_count = slot_stack.item_count + stack.item_count;
   879	                        let max_slot_count = slot.get_max_item_count_for_stack(&slot_stack).await;
   880	                        if combined_count <= max_slot_count {
   881	                            stack.set_count(0);
   882	                            slot_stack.set_count(combined_count);
   883	                            slot.set_stack(slot_stack).await;
   884	                            success = true;
   885	                        } else if slot_stack.item_count < max_slot_count {
   886	                            stack.decrement(max_slot_count - slot_stack.item_count);
   887	                            slot_stack.set_count(max_slot_count);
   888	                            slot.set_stack(slot_stack).await;
   889	                            success = true;
   890	                        }
   891	                    }
   892	
   893	                    if from_last {
   894	                        current_index -= 1;
   895	                    } else {
   896	                        current_index += 1;
   897	                    }
   898	                }
   899	            }
   900	
   901	            if !stack.is_empty() {
   902	                if from_last {
   903	                    current_index = end_index - 1;
   904	                } else {
   905	                    current_index = start_index;
   906	                }
   907	
   908	                while if from_last {
   909	                    current_index >= start_index
   910	                } else {
   911	                    current_index < end_index
   912	                } {
   913	                    let slot = self.get_behaviour().slots[current_index as usize].clone();
   914	                    let slot_stack = slot.get_stack().await;
   915	
   916	                    if slot_stack.is_empty() && slot.can_insert(stack).await {
   917	                        let max_count = slot.get_max_item_count_for_stack(stack).await;
   918	                        slot.set_stack(stack.split(max_count.min(stack.item_count)))

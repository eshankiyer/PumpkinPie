   310	   private boolean isWaterHole(
   311	      final BlockGetter level, final BlockPos topPos, final BlockState topState, final BlockPos bottomPos, final BlockState bottomState
   312	   ) {
   313	      if (!canPassThroughWall(Direction.DOWN, level, topPos, topState, bottomPos, bottomState)) {
   314	         return false;
   315	      } else {
   316	         return bottomState.getFluidState().getType().isSame(this) ? true : canHoldFluid(level, bottomPos, bottomState, this.getFlowing());
   317	      }
   318	   }

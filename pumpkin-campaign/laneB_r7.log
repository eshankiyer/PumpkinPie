   195	pub struct BeehiveBlockEntity {
   196	    pub position: BlockPos,
   197	    /// `BeehiveBlockEntity.stored`.
   198	    pub bees: Mutex<Vec<Occupant>>,
   199	    /// `BeehiveBlockEntity.savedFlowerPos`.
   200	    pub flower_pos: Mutex<Option<BlockPos>>,
   201	    dirty: AtomicBool,
   202	}
   203	
   204	impl BlockEntity for BeehiveBlockEntity {
   205	    fn resource_location(&self) -> &'static str {
   206	        Self::ID
   207	    }
   208	
   209	    fn get_position(&self) -> BlockPos {
   210	        self.position
   211	    }
   212	
   213	    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self
   214	    where
   215	        Self: Sized,
   216	    {
   217	        let bees = nbt
   218	            .get_list("bees")
   219	            .map(|list| list.iter().filter_map(Occupant::from_nbt).collect())
   220	            .unwrap_or_default();
   221	        let flower_pos = nbt
   222	            .get_int_array("flower_pos")
   223	            .and_then(|array| match array {
   224	                &[x, y, z] => Some(BlockPos::new(x, y, z)),
   225	                _ => None,
   226	            });
   227	        Self {
   228	            position,
   229	            bees: Mutex::new(bees),
   230	            flower_pos: Mutex::new(flower_pos),
   231	            dirty: AtomicBool::new(false),
   232	        }
   233	    }
   234	
   235	    fn write_nbt<'a>(
   236	        &'a self,
   237	        nbt: &'a mut NbtCompound,
   238	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   239	        Box::pin(async move {
   240	            nbt.put_list(
   241	                "bees",
   242	                self.bees
   243	                    .lock()
   244	                    .await
   245	                    .iter()
   246	                    .map(Occupant::to_nbt)
   247	                    .collect(),
   248	            );
   249	            let flower_pos = *self.flower_pos.lock().await;
   250	            if let Some(pos) = flower_pos {
   251	                nbt.put(
   252	                    "flower_pos",
   253	                    NbtTag::IntArray(vec![pos.0.x, pos.0.y, pos.0.z]),
   254	                );
   255	            }
   256	        })
   257	    }
   258	
   259	    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
   260	        let mut nbt = NbtCompound::new();
   261	        if let Ok(bees) = self.bees.try_lock() {
   262	            nbt.put_list("bees", bees.iter().map(Occupant::to_nbt).collect());
   263	        }
   264	        let flower_pos = self.flower_pos.try_lock().ok().and_then(|guard| *guard);
   265	        if let Some(pos) = flower_pos {
   266	            nbt.put(
   267	                "flower_pos",
   268	                NbtTag::IntArray(vec![pos.0.x, pos.0.y, pos.0.z]),
   269	            );
   270	        }
   271	        Some(nbt)
   272	    }
   273	
   274	    /// `BeehiveBlockEntity.serverTick`, plus the fire check `setChanged` runs before every
   275	    /// other mutation.
   276	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   277	        Box::pin(async move {
   278	            if self.bees.lock().await.is_empty() {
   279	                return;
   280	            }
   281	
   282	            if self.is_fire_nearby(world) {
   283	                self.empty_all_living_from_hive(world, None, BeeReleaseStatus::Emergency)
   284	                    .await;
   285	                return;
   286	            }
   287	
   288	            self.tick_occupants(world).await;
   289	
   290	            if !self.bees.lock().await.is_empty() && rand::rng().random::<f64>() < 0.005 {
   291	                world.play_sound(
   292	                    Sound::BlockBeehiveWork,
   293	                    SoundCategory::Blocks,
   294	                    &self.position.to_f64(),
   295	                );
   296	            }
   297	        })
   298	    }
   299	
   300	    fn is_dirty(&self) -> bool {
   301	        self.dirty.load(Ordering::Relaxed)
   302	    }
   303	
   304	    fn clear_dirty(&self) {
   305	        self.dirty.store(false, Ordering::Relaxed);
   306	    }
   307	
   308	    fn as_any(&self) -> &dyn std::any::Any {
   309	        self
   310	    }
   311	}

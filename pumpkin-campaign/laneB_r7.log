    34	public abstract class FlowingFluid extends Fluid {
    35	   public static final BooleanProperty FALLING = BlockStateProperties.FALLING;
    36	   public static final IntegerProperty LEVEL = BlockStateProperties.LEVEL_FLOWING;
    37	   private static final int CACHE_SIZE = 200;
    38	   private static final ThreadLocal<Object2ByteLinkedOpenHashMap<FlowingFluid.BlockStatePairKey>> OCCLUSION_CACHE = ThreadLocal.withInitial(() -> {
    39	      Object2ByteLinkedOpenHashMap<FlowingFluid.BlockStatePairKey> map = new Object2ByteLinkedOpenHashMap<FlowingFluid.BlockStatePairKey>(200) {
    40	         @Override
    41	         protected void rehash(final int newN) {
    42	         }
    43	      };
    44	      map.defaultReturnValue((byte)127);
    45	      return map;
    46	   });
    47	   private final Map<FluidState, VoxelShape> shapes = Maps.newIdentityHashMap();

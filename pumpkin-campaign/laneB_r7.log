    58	/// The subset of `BeehiveBlockEntity.IGNORED_BEE_TAGS` that Pumpkin's bee actually writes.
    59	/// Keeping any of these would respawn the bee with a duplicate identity, at its old position,
    60	/// or already homed to the hive it is being released from.
    61	const IGNORED_BEE_TAGS: [&str; 11] = [
    62	    "UUID",
    63	    "Pos",
    64	    "Motion",
    65	    "Rotation",
    66	    "OnGround",
    67	    "FallDistance",
    68	    "Fire",
    69	    "hive_pos",
    70	    // Vanilla strips these three too. Keeping `TicksSincePollination` in particular would
    71	    // release a bee that entered because it was tired of looking for nectar still tired, so it
    72	    // would want back in immediately and never pollinate again.
    73	    "TicksSincePollination",
    74	    "CannotEnterHiveTicks",
    75	    "CropsGrownSincePollination",
    76	];

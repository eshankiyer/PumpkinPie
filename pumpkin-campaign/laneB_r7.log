  2294	
  2295	        let max = bounding_box.max_block_pos();
  2296	
  2297	        for x in min.0.x..=max.0.x {
  2298	            for y in min.0.y..=max.0.y {
  2299	                for z in min.0.z..=max.0.z {
  2300	                    let pos = BlockPos::new(x, y, z);
  2301	
  2302	                    let (fluid, state) = self.get_fluid_and_fluid_state(&pos);
  2303	
  2304	                    if fluid.id != Fluid::EMPTY.id {
  2305	                        let height = self.get_fluid_height(&pos, fluid, state);
  2306	
  2307	                        if height >= bounding_box.min.y {
  2308	                            return true;
  2309	                        }
  2310	                    }
  2311	                }
  2312	            }
  2313	        }
  2314	
  2315	        false
  2316	    }

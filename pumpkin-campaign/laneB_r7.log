   326	async fn on_use(wire: RedstoneWireProperties, world: &Arc<World>, block_pos: &BlockPos) -> bool {
   327	    if is_cross(wire) || is_dot(wire) {
   328	        let mut new_wire = if is_cross(wire) {
   329	            RedstoneWireProperties::default(&Block::REDSTONE_WIRE)
   330	        } else {
   331	            make_cross(wire.power)
   332	        };
   333	        new_wire.power = wire.power;
   334	
   335	        new_wire = get_regulated_sides(new_wire, world, block_pos).await;
   336	        if wire != new_wire {
   337	            world
   338	                .set_block_state(
   339	                    block_pos,
   340	                    new_wire.to_state_id(&Block::REDSTONE_WIRE),
   341	                    BlockFlags::empty(),
   342	                )
   343	                .await;
   344	            update_wire_neighbors(world, block_pos).await;
   345	            return true;
   346	        }
   347	    }
   348	    false
   349	}

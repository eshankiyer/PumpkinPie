   317	      private static void tryReloadVibrationParticle(final ServerLevel level, final VibrationSystem.Data data, final VibrationSystem.User user) {
   318	         if (data.shouldReloadVibrationParticle()) {
   319	            if (data.currentVibration == null) {
   320	               data.setReloadVibrationParticle(false);
   321	            } else {
   322	               Vec3 origin = data.currentVibration.pos();

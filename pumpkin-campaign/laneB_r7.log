   413	   private static void spawnParticlesAlongLine(
   414	      final Level level,
   415	      final RandomSource random,
   416	      final BlockPos pos,
   417	      final int color,
   418	      final Direction side,
   419	      final Direction along,
   420	      final float from,
   421	      final float to
   422	   ) {
   423	      float span = to - from;
   424	      if (!(random.nextFloat() >= 0.2F * span)) {
   425	         float sideOfBlock = 0.4375F;
   426	         float positionOnLine = from + span * random.nextFloat();
   427	         double x = 0.5 + 0.4375F * side.getStepX() + positionOnLine * along.getStepX();
   428	         double y = 0.5 + 0.4375F * side.getStepY() + positionOnLine * along.getStepY();
   429	         double z = 0.5 + 0.4375F * side.getStepZ() + positionOnLine * along.getStepZ();
   430	         level.addParticle(new DustParticleOptions(color, 1.0F), pos.getX() + x, pos.getY() + y, pos.getZ() + z, 0.0, 0.0, 0.0);
   431	      }
   432	   }

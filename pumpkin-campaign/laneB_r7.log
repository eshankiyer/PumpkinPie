   124	    /// (`sendBlockUpdated(pos, state, state, 3)`), which is how clients see shelf contents change
   125	    /// without a block-state edit.
   126	    ///
   127	    /// The vanilla caller (`ShelfBlock.swapSingleItem`, `ShelfBlock.java:213-217`) suppresses the
   128	    /// vibration only when the new item carries a `minecraft:use_effects` component with
   129	    /// `interact_vibrations=false`; that flag is not modelled in this fork's component data
   130	    /// (vanilla defaults it to `true`, `UseEffects.java:9`), so callers here always pass
   131	    /// [`Some`] to keep the default vibration behaviour.
   132	    pub async fn set_changed_with_game_event(&self, world: &Arc<World>, event: Option<GameEvent>) {
   133	        self.mark_dirty();
   134	        let state_id = world.get_block_state_id(&self.position);
   135	        if let Some(event) = event {
   136	            emit_game_event(
   137	                world,
   138	                event,
   139	                self.position.to_centered_f64(),
   140	                GameEventContext {
   141	                    source_entity: None,
   142	                    affected_block_state: Some(state_id),
   143	                },
   144	            )
   145	            .await;
   146	        }
   147	        world
   148	            .set_block_state(&self.position, state_id, BlockFlags::NOTIFY_ALL)
   149	            .await;
   150	    }
   151	}
   152	
   153	impl Inventory for ShelfBlockEntity {
   154	    fn size(&self) -> usize {
   155	        Self::INVENTORY_SIZE
   156	    }
   157	
   158	    fn is_empty(&self) -> InventoryFuture<'_, bool> {
   159	        Box::pin(async move {
   160	            let items = self.items.read().await;
   161	            items.iter().all(ItemStack::is_empty)
   162	        })
   163	    }
   164	
   165	    fn get_stack(&self, slot: usize) -> InventoryFuture<'_, ItemStack> {
   166	        Box::pin(async move {
   167	            let items = self.items.read().await;
   168	            items[slot].clone()
   169	        })
   170	    }
   171	
   172	    fn remove_stack(&self, slot: usize) -> InventoryFuture<'_, ItemStack> {
   173	        Box::pin(async move {
   174	            let mut items = self.items.write().await;
   175	            let removed = std::mem::replace(&mut items[slot], ItemStack::EMPTY.clone());
   176	            self.mark_dirty();
   177	            removed
   178	        })
   179	    }
   180	
   181	    fn remove_stack_specific(&self, slot: usize, amount: u8) -> InventoryFuture<'_, ItemStack> {
   182	        Box::pin(async move {
   183	            let mut items = self.items.write().await;
   184	            let res = if !items[slot].is_empty() && amount > 0 {
   185	                items[slot].split(amount)
   186	            } else {
   187	                ItemStack::EMPTY.clone()
   188	            };
   189	            self.mark_dirty();
   190	            res
   191	        })
   192	    }
   193	
   194	    fn set_stack(&self, slot: usize, stack: ItemStack) -> InventoryFuture<'_, ()> {
   195	        Box::pin(async move {
   196	            let mut items = self.items.write().await;
   197	            items[slot] = stack;
   198	            self.mark_dirty();
   199	        })
   200	    }
   201	
   202	    fn mark_dirty(&self) {
   203	        self.dirty.store(true, Ordering::Relaxed);
   204	    }
   205	
   206	    fn as_any(&self) -> &dyn Any {
   207	        self
   208	    }
   209	}
   210	
   211	impl Clearable for ShelfBlockEntity {
   212	    fn clear(&self) -> Pin<Box<dyn Future<Output = ()> + Send + '_>> {
   213	        Box::pin(async move {
   214	            let mut items = self.items.write().await;
   215	            items.fill_with(|| ItemStack::EMPTY.clone());
   216	            self.mark_dirty();
   217	        })
   218	    }
   219	}

   292	    /// Inserts a stack into this slot.
   293	    ///
   294	    /// Returns any leftover items that couldn't fit.
   295	    fn insert_stack(&self, stack: ItemStack) -> BoxFuture<'_, ItemStack> {
   296	        // Default implementation logic:
   297	        Box::pin(async move {
   298	            let stack_item_count = stack.item_count;
   299	            self.insert_stack_count(stack, stack_item_count).await
   300	        })
   301	    }
   302	
   303	    /// Inserts a specific count from a stack.
   304	    ///
   305	    /// Returns any leftover items.
   306	    fn insert_stack_count(&self, mut stack: ItemStack, count: u8) -> BoxFuture<'_, ItemStack> {
   307	        // Default implementation logic:
   308	        Box::pin(async move {
   309	            if !stack.is_empty() && self.can_insert(&stack).await {
   310	                let mut stack_self = self.get_stack().await;
   311	                // `Slot.safeInsert` (`Slot.java:137-140`) computes the headroom as a signed
   312	                // int and bails when it is not positive. Doing the subtraction on `u8`
   313	                // underflows whenever the slot already holds more items than the incoming
   314	                // stack's own max size allows -- e.g. shift-clicking ender pearls (max 16)
   315	                // onto a slot holding 64 cobblestone -- which panics in debug builds.
   316	                let headroom = self
   317	                    .get_max_item_count_for_stack(&stack)
   318	                    .await
   319	                    .saturating_sub(stack_self.item_count);
   320	                let min_count = count.min(stack.item_count).min(headroom);
   321	
   322	                if min_count != 0 {
   323	                    if stack_self.is_empty() {
   324	                        self.set_stack(stack.split(min_count)).await;
   325	                    } else if stack.are_items_and_components_equal(&stack_self) {
   326	                        stack.decrement(min_count);
   327	                        stack_self.increment(min_count);
   328	                        self.set_stack(stack_self).await;
   329	                    }
   330	                }
   331	            }
   332	            if stack.is_empty() {
   333	                ItemStack::EMPTY.clone()
   334	            } else {
   335	                stack
   336	            }
   337	        })
   338	    }
   339	}

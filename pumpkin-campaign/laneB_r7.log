    77	#[must_use]
    78	pub fn waterlogged_replacement_state(
    79	    block_state: &BlockState,
    80	    block: &Block,
    81	    fluid: &Fluid,
    82	) -> Option<BlockStateId> {
    83	    if fluid.matches_type(&Fluid::WATER)
    84	        && block.has_tag(&tag::Block::MINECRAFT_SLABS)
    85	        && !crate::block::blocks::slabs::can_place_liquid(block, block_state.id)
    86	    {
    87	        return None;
    88	    }
    89	
    90	    fluid
    91	        .matches_type(&Fluid::WATER)
    92	        .then(|| block.with_waterlogged(block_state.id))
    93	        .flatten()
    94	        .map(|state| {
    95	            if block.has_tag(&tag::Block::MINECRAFT_CANDLES) {
    96	                // The live fluid path calls `CandleBlock::place_liquid` first so it can perform
    97	                // the vanilla extinguish side effects. This pure helper still clears `lit` for
    98	                // callers that only need the resulting waterlogged state.
    99	                let mut props = block
   100	                    .properties(state.id)
   101	                    .expect("waterlogged candle state has properties")
   102	                    .to_props();
   103	                if let Some((_, value)) = props.iter_mut().find(|(key, _)| *key == "lit") {
   104	                    *value = "false";
   105	                }
   106	                block.from_properties(&props).to_state_id(block)
   107	            } else {
   108	                state.id
   109	            }
   110	        })
   111	}

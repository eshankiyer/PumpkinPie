    51	   @Override
    52	   public void animateTick(final Level level, final BlockPos pos, final FluidState fluidState, final RandomSource random) {
    53	      BlockPos above = pos.above();
    54	      if (level.getBlockState(above).isAir() && !level.getBlockState(above).isSolidRender()) {
    55	         if (random.nextInt(100) == 0) {
    56	            double xx = pos.getX() + random.nextDouble();
    57	            double yy = pos.getY() + 1.0;
    58	            double zz = pos.getZ() + random.nextDouble();
    59	            level.addParticle(ParticleTypes.LAVA, xx, yy, zz, 0.0, 0.0, 0.0);
    60	            level.playLocalSound(
    61	               xx, yy, zz, SoundEvents.LAVA_POP, SoundSource.AMBIENT, 0.2F + random.nextFloat() * 0.2F, 0.9F + random.nextFloat() * 0.15F, false
    62	            );
    63	         }
    64	
    65	         if (random.nextInt(200) == 0) {
    66	            level.playLocalSound(
    67	               pos.getX(),
    68	               pos.getY(),
    69	               pos.getZ(),
    70	               SoundEvents.LAVA_AMBIENT,
    71	               SoundSource.AMBIENT,
    72	               0.2F + random.nextFloat() * 0.2F,
    73	               0.9F + random.nextFloat() * 0.15F,
    74	               false
    75	            );
    76	         }
    77	      }
    78	   }

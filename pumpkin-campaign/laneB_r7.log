   389	/// An armor equipment slot.
   390	///
   391	/// Restricts which items can be placed based on the equipment slot type:
   392	/// - Head: Helmets, skulls, carved pumpkins
   393	/// - Chest: Chestplates, elytra
   394	/// - Legs: Leggings
   395	/// - Feet: Boots
   396	// ArmorSlot.java
   397	pub struct ArmorSlot {
   398	    /// The inventory containing this slot (usually player inventory).
   399	    pub inventory: Arc<dyn Inventory>,
   400	    /// Index of this slot within its inventory.
   401	    pub index: usize,
   402	    /// Protocol ID for this slot (assigned by screen handler).
   403	    pub id: AtomicU8,
   404	    /// The equipment slot type (head, chest, legs, feet, or off-hand).
   405	    pub equipment_slot: EquipmentSlot,
   406	}
   407	
   408	impl ArmorSlot {
   409	    /// Creates a new armor slot.
   410	    ///
   411	    /// # Arguments
   412	    /// - `inventory` - The containing inventory
   413	    /// - `index` - The slot index
   414	    /// - `equipment_slot` - The equipment slot type (head, chest, legs, feet)
   415	    pub fn new(inventory: Arc<dyn Inventory>, index: usize, equipment_slot: EquipmentSlot) -> Self {
   416	        Self {
   417	            inventory,
   418	            index,
   419	            id: AtomicU8::new(0),
   420	            equipment_slot,
   421	        }
   422	    }
   423	}
   424	
   425	impl Slot for ArmorSlot {
   426	    fn get_inventory(&self) -> Arc<dyn Inventory> {
   427	        self.inventory.clone()
   428	    }
   429	
   430	    fn get_index(&self) -> usize {
   431	        self.index
   432	    }
   433	
   434	    fn set_id(&self, id: usize) {
   435	        self.id.store(id as u8, Ordering::Relaxed);
   436	    }
   437	
   438	    /// Restricts inserts to appropriate armor types.
   439	    fn can_insert<'a>(&'a self, stack: &'a ItemStack) -> BoxFuture<'a, bool> {
   440	        Box::pin(async move {
   441	            match self.equipment_slot {
   442	                EquipmentSlot::Head(_) => {
   443	                    stack.is_helmet() || stack.is_skull() || stack.item == &Item::CARVED_PUMPKIN
   444	                }
   445	                EquipmentSlot::Chest(_) => stack.is_chestplate() || stack.item == &Item::ELYTRA,
   446	                EquipmentSlot::Legs(_) => stack.is_leggings(),
   447	                EquipmentSlot::Feet(_) => stack.is_boots(),
   448	                _ => true,
   449	            }
   450	        })
   451	    }
   452	
   453	    fn set_stack_prev(&self, stack: ItemStack, _previous_stack: ItemStack) -> BoxFuture<'_, ()> {
   454	        Box::pin(async move {
   455	            //TODO: this.entity.onEquipStack(this.equipmentSlot, previousStack, stack);
   456	            self.set_stack_no_callbacks(stack).await;
   457	        })
   458	    }
   459	
   460	    fn mark_dirty(&self) -> BoxFuture<'_, ()> {
   461	        Box::pin(async move {
   462	            self.inventory.mark_dirty();
   463	        })
   464	    }
   465	
   466	    /// Armor slots can only hold one item.
   467	    fn get_max_item_count(&self) -> BoxFuture<'_, u8> {
   468	        Box::pin(async move { 1 })
   469	    }
   470	
   471	    fn can_take_items(&self, player: &dyn InventoryPlayer) -> BoxFuture<'_, bool> {
   472	        let is_creative = player.is_creative();
   473	        Box::pin(async move {
   474	            if is_creative {
   475	                return true;
   476	            }
   477	            self.get_cloned_stack()
   478	                .await
   479	                .get_enchantment_level(&Enchantment::BINDING_CURSE)
   480	                <= 0
   481	        })
   482	    }
   483	}

   270	    /// Safely tries to take a stack of items from the slot.
   271	    ///
   272	    /// Returns an empty stack if can't take. Triggers callbacks.
   273	    ///
   274	    /// Mojang name: `safeTake`
   275	    fn safe_take<'a>(
   276	        &'a self,
   277	        min: u8,
   278	        max: u8,
   279	        player: &'a dyn InventoryPlayer,
   280	    ) -> BoxFuture<'a, ItemStack> {
   281	        Box::pin(async move {
   282	            let stack = self.try_take_stack_range(min, max, player).await;
   283	
   284	            if let Some(stack) = &stack {
   285	                self.on_take_item(player, stack).await;
   286	            }
   287	
   288	            stack.unwrap_or_else(|| ItemStack::EMPTY.clone())
   289	        })
   290	    }

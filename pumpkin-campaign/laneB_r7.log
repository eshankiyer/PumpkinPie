     7	/// Check if a specific block can be replaced by fluid (based on block properties)
     8	#[must_use]
     9	pub fn can_be_replaced(block_state: &BlockState, block: &Block, fluid: &Fluid) -> bool {
    10	    if fluid.matches_type(&Fluid::WATER)
    11	        && block.has_tag(&tag::Block::MINECRAFT_SLABS)
    12	        && !crate::block::blocks::slabs::can_place_liquid(block, block_state.id)
    13	    {
    14	        return false;
    15	    }
    16	
    17	    // An already waterlogged block retains its host state and is not replaceable.
    18	    if block.is_waterlogged(block_state.id) {
    19	        return false;
    20	    }
    21	
    22	    // Vanilla `LiquidBlockContainer` accepts water into a dry waterloggable block. The caller
    23	    // must change it to the waterlogged state rather than replace the block with a fluid state.
    24	    if fluid.matches_type(&Fluid::WATER) && block.with_waterlogged(block_state.id).is_some() {
    25	        return true;
    26	    }
    27	
    28	    // Fluid Logic
    29	    if let Some(other_fluid) = Fluid::from_state_id(block_state.id) {
    30	        if !fluid.matches_type(other_fluid) {
    31	            return true;
    32	        }
    33	        // Replace current fluid if it is a falling source
    34	        if other_fluid.is_source(block_state.id) && other_fluid.is_falling(block_state.id) {
    35	            return true;
    36	        }
    37	    }
    38	
    39	    let id = block.id;
    40	
    41	    // Blocks that fluid should never replace
    42	    if block.has_tag(&tag::Block::MINECRAFT_DOORS)
    43	        || block.has_tag(&tag::Block::MINECRAFT_BEDS)
    44	        || block.has_tag(&tag::Block::MINECRAFT_LEAVES)
    45	        || block.has_tag(&tag::Block::MINECRAFT_PRESSURE_PLATES)
    46	        || block.has_tag(&tag::Block::C_CLUSTERS)
    47	        || block.has_tag(&tag::Block::MINECRAFT_WALL_CORALS)
    48	        || block.has_tag(&tag::Block::MINECRAFT_SHULKER_BOXES)
    49	        || block.has_tag(&tag::Block::MINECRAFT_PORTALS)
    50	        || id == Block::BELL.id
    51	        || id == Block::BIG_DRIPLEAF.id
    52	        || id == Block::BIG_DRIPLEAF_STEM.id
    53	        || id == Block::SMALL_DRIPLEAF.id
    54	        || id == Block::CAKE.id
    55	        || id == Block::CONDUIT.id
    56	        || id == Block::CAMPFIRE.id
    57	        || id == Block::DRAGON_EGG.id
    58	        || id == Block::KELP.id
    59	        || id == Block::KELP_PLANT.id
    60	        || id == Block::SEAGRASS.id
    61	        || id == Block::TALL_SEAGRASS.id
    62	        || id == Block::LADDER.id
    63	        || id == Block::POINTED_DRIPSTONE.id
    64	        || id == Block::SCAFFOLDING.id
    65	    {
    66	        return false;
    67	    }
    68	
    69	    // Only replace air, explicitly replaceable blocks, or carpets
    70	    block_state.replaceable()
    71	        || id == Block::AIR.id
    72	        || block.has_tag(&tag::Block::MINECRAFT_WOOL_CARPETS)
    73	        // Only use PistonBehavior::Destroy if it didn't pass the checks above
    74	        || block_state.piston_behavior == pumpkin_data::block_state::PistonBehavior::Destroy
    75	}

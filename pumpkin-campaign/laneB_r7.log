   135	        NbtTag::Compound(compound)
   136	    }
   137	
   138	    fn from_nbt(tag: &NbtTag) -> Option<Self> {
   139	        let NbtTag::Compound(compound) = tag else {
   140	            return None;
   141	        };
   142	        Some(Self {
   143	            entity_data: compound.get_compound("entity_data")?.clone(),
   144	            ticks_in_hive: compound.get_int("ticks_in_hive").unwrap_or(0),
   145	            min_ticks_in_hive: compound
   146	                .get_int("min_ticks_in_hive")
   147	                .unwrap_or(MIN_OCCUPATION_TICKS_NECTARLESS),
   148	        })
   149	    }
   150	}
   151	
   152	/// `EnvironmentAttributes.BEES_STAY_IN_HIVE`: raised by `WeatherAttributes` while it is raining
   153	/// and by the `Timelines` keyframes at day-time 12542 (on) and 23460 (off).
   154	pub async fn bees_stay_in_hive(world: &World) -> bool {
   155	    if world.weather.lock().await.raining {
   156	        return true;
   157	    }
   158	    let time_of_day = world.get_time_of_day().await.rem_euclid(24_000);
   159	    (12_542..23_460).contains(&time_of_day)
   160	}
   161	
   162	/// `CampfireBlock.isSmokeyPos` (`CampfireBlock.java:261`), reduced to a solid-block test in
   163	/// place of the `SHAPE_VIRTUAL_POST` collision join, which Pumpkin has no equivalent for.
   164	#[must_use]
   165	pub fn is_smokey_pos(world: &World, pos: &BlockPos) -> bool {
   166	    for i in 1..=5 {
   167	        let to_check = BlockPos::new(pos.0.x, pos.0.y - i, pos.0.z);
   168	        let (block, state) = world.get_block_and_state(&to_check);
   169	        if is_lit_campfire(block, state.id) {
   170	            return true;
   171	        }
   172	        if state.is_solid_block() {
   173	            let below = BlockPos::new(to_check.0.x, to_check.0.y - 1, to_check.0.z);
   174	            let (below_block, below_state) = world.get_block_and_state(&below);
   175	            return is_lit_campfire(below_block, below_state.id);
   176	        }
   177	    }
   178	    false
   179	}
   180	
   181	/// `CampfireBlock.isLitCampfire`.
   182	fn is_lit_campfire(block: &Block, state_id: BlockStateId) -> bool {
   183	    if block.id != Block::CAMPFIRE.id && block.id != Block::SOUL_CAMPFIRE.id {
   184	        return false;
   185	    }
   186	    CampfireLikeProperties::from_state_id(state_id, block).lit
   187	}

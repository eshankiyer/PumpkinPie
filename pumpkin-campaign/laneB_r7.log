   279	   @Override
   280	   public void playerTouch(final Player player) {
   281	      if (player instanceof ServerPlayer serverPlayer) {
   282	         if (player.takeXpDelay == 0) {
   283	            player.takeXpDelay = 2;
   284	            player.take(this, 1);
   285	            int remaining = this.repairPlayerItems(serverPlayer, this.getValue());
   286	            if (remaining > 0) {
   287	               player.giveExperiencePoints(remaining);
   288	            }
   289	
   290	            this.count--;
   291	            if (this.count == 0) {
   292	               this.discard();
   293	            }
   294	         }
   295	      }
   296	   }

   236	   private RedstoneSide getConnectingSide(final BlockGetter level, final BlockPos pos, final Direction direction) {
   237	      return this.getConnectingSide(level, pos, direction, !level.getBlockState(pos.above()).isRedstoneConductor(level, pos));
   238	   }
   239	
   240	   private RedstoneSide getConnectingSide(final BlockGetter level, final BlockPos pos, final Direction direction, final boolean canConnectUp) {
   240	   private RedstoneSide getConnectingSide(final BlockGetter level, final BlockPos pos, final Direction direction, final boolean canConnectUp) {
   241	      BlockPos relativePos = pos.relative(direction);
   242	      BlockState relativeState = level.getBlockState(relativePos);
   243	      if (canConnectUp) {
   244	         boolean isPlaceableAbove = relativeState.getBlock() instanceof TrapDoorBlock || this.canSurviveOn(level, relativePos, relativeState);
   245	         if (isPlaceableAbove && shouldConnectTo(level.getBlockState(relativePos.above()))) {
   246	            if (relativeState.isFaceSturdy(level, relativePos, direction.getOpposite())) {
   247	               return RedstoneSide.UP;
   248	            }
   249	
   250	            return RedstoneSide.SIDE;
   251	         }
   252	      }
   253	
   254	      return !shouldConnectTo(relativeState, direction)
   255	            && (relativeState.isRedstoneConductor(level, relativePos) || !shouldConnectTo(level.getBlockState(relativePos.below())))
   256	         ? RedstoneSide.NONE
   257	         : RedstoneSide.SIDE;
   258	   }

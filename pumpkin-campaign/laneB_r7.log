   118	   @Override
   119	   protected void entityInside(final Level level, final BlockPos pos, final Entity entity, final InsideBlockEffectApplier effectApplier) {
   120	      effectApplier.apply(InsideBlockEffectType.CLEAR_FREEZE);
   121	      effectApplier.apply(InsideBlockEffectType.LAVA_IGNITE);
   122	      effectApplier.runAfter(InsideBlockEffectType.LAVA_IGNITE, Entity::lavaHurt);
   123	   }
   124	
   125	   private boolean hasFlammableNeighbours(final LevelReader level, final BlockPos pos) {
   126	      for (Direction direction : Direction.values()) {
   127	         if (this.isFlammable(level, pos.relative(direction))) {
   128	            return true;
   129	         }
   130	      }
   131	
   132	      return false;
   133	   }
   134	
   135	   private boolean isFlammable(final LevelReader level, final BlockPos pos) {
   136	      return level.isInsideBuildHeight(pos.getY()) && !level.hasChunkAt(pos) ? false : level.getBlockState(pos).ignitedByLava();
   137	   }

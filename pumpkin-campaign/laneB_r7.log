  2662	            mob_entity.living_entity.jumping.store(false, Relaxed);
  2663	            mob_entity.jump_requested.store(false, Relaxed);
  2664	            return;
  2665	        }
  2666	
  2667	        // An exclusive brain activity (see `Mob::suppress_ai_goals`) still ticks the brain, so
  2668	        // `mob_tick` - which is where such a state counts itself down - runs, but nothing that
  2669	        // could produce movement does.
  2670	        if mob.suppress_ai_goals() {
  2671	            mob_entity.living_entity.jumping.store(false, Relaxed);
  2672	            mob_entity.jump_requested.store(false, Relaxed);

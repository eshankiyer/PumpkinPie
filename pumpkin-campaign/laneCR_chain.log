   171	   private static Optional<BlockPos> getRandomNamedJigsaw(
   172	      final StructurePoolElement element,
   173	      final Identifier targetJigsawId,
   174	      final BlockPos position,
   175	      final Rotation rotation,
   176	      final StructureTemplateManager structureTemplateManager,
   177	      final WorldgenRandom random
   178	   ) {
   179	      for (StructureTemplate.JigsawBlockInfo jigsaw : element.getShuffledJigsawBlocks(structureTemplateManager, position, rotation, random)) {
   180	         if (targetJigsawId.equals(jigsaw.name())) {
   181	            return Optional.of(jigsaw.info().pos());
   182	         }
   183	      }
   184	
   185	      return Optional.empty();
   186	   }

    99	macro_rules! memory_keys {
   100	    ($($key:ident => $id:ident : $value:ty, $name:literal;)*) => {
   101	        $(
   102	            pub struct $key;
   103	            impl MemoryKey for $key {
   104	                type Value = $value;
   105	                const ID: MemoryKeyId = MemoryKeyId::$id;
   106	                const NAME: &'static str = $name;
   107	            }
   108	        )*
   109	    };

--- crates/pumpkin/src/net/java/play/command_suggestion.rs
     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_command_suggestion(
     6	        &self,
     7	        player: &Arc<Player>,
     8	        packet: SCommandSuggestion<'_>,
     9	        server: &Arc<Server>,
    10	    ) {
    11	        let Some(cmd) = &packet.command.get(1..) else {
    12	            return;
    13	        };
    14	
    15	        let Some((last_word_start, _)) = cmd.char_indices().rfind(|(_, c)| c.is_whitespace())
    16	        else {
    17	            return;
    18	        };
    19	
    20	        let suggestions = server
    21	            .command_dispatcher
    22	            .load()
    23	            .suggest(cmd, &player.get_command_source(server).await)
    24	            .await;
    25	
    26	        let response = CCommandSuggestions::new(
    27	            packet.id,
    28	            ((last_word_start + 2) as i32).into(),
    29	            ((cmd.len() - last_word_start - 1) as i32).into(),
    30	            suggestions.into(),
    31	        );
    32	
    33	        self.enqueue_client_packet(&response).await;
    34	    }
    35	}

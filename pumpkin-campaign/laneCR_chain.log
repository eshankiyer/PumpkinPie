     2	
     3	import com.mojang.math.OctahedralGroup;
     4	import com.mojang.serialization.Codec;
     5	import net.minecraft.core.Direction;
     6	import net.minecraft.network.chat.Component;
     7	import net.minecraft.util.ExtraCodecs;
     8	import net.minecraft.util.StringRepresentable;
     9	
    10	public enum Mirror implements StringRepresentable {
    11	   NONE("none", OctahedralGroup.IDENTITY),
    12	   LEFT_RIGHT("left_right", OctahedralGroup.INVERT_Z),
    13	   FRONT_BACK("front_back", OctahedralGroup.INVERT_X);
    14	
    15	   public static final Codec<Mirror> CODEC = StringRepresentable.fromEnum(Mirror::values);
    16	   @Deprecated
    17	   public static final Codec<Mirror> LEGACY_CODEC = ExtraCodecs.legacyEnum(Mirror::valueOf);
    18	   private final String id;
    19	   private final Component symbol;
    20	   private final OctahedralGroup rotation;
    21	
    22	   Mirror(final String id, final OctahedralGroup rotation) {
    23	      this.id = id;
    24	      this.symbol = Component.translatable("mirror." + id);
    25	      this.rotation = rotation;
    26	   }
    27	
    28	   public int mirror(final int rotation, final int steps) {
    29	      int halfSteps = steps / 2;
    30	      int correctedRotation = rotation > halfSteps ? rotation - steps : rotation;
    31	
    32	      return switch (this) {
    33	         case LEFT_RIGHT -> (halfSteps - correctedRotation + steps) % steps;
    34	         case FRONT_BACK -> (steps - correctedRotation) % steps;
    35	         default -> rotation;
    36	      };
    37	   }
    38	
    39	   public Rotation getRotation(final Direction value) {
    40	      Direction.Axis axis = value.getAxis();
    41	      return (this != LEFT_RIGHT || axis != Direction.Axis.Z) && (this != FRONT_BACK || axis != Direction.Axis.X) ? Rotation.NONE : Rotation.CLOCKWISE_180;
    42	   }
    43	
    44	   public Direction mirror(final Direction direction) {
    45	      if (this == FRONT_BACK && direction.getAxis() == Direction.Axis.X) {
    46	         return direction.getOpposite();
    47	      } else {
    48	         return this == LEFT_RIGHT && direction.getAxis() == Direction.Axis.Z ? direction.getOpposite() : direction;
    49	      }
    50	   }
    51	
    52	   public OctahedralGroup rotation() {
    53	      return this.rotation;
    54	   }
    55	
    56	   public Component symbol() {
    57	      return this.symbol;
    58	   }
    59	
    60	   @Override
    61	   public String getSerializedName() {
    62	      return this.id;
    63	   }
    64	}
     1	//! Block rotation and mirroring transformations.
     2	//!
     3	//! These transformations are used to rotate and mirror blocks
     4	//! when placing them in the world, matching vanilla Minecraft behavior.
     5	
     6	use crate::BlockDirection;
     7	use crate::block_properties::HorizontalFacing;
     8	use pumpkin_util::math::vector3::Vector3;
     9	use serde::Deserialize;
    10	
    11	/// Rotation around the Y axis in 90-degree increments.
    12	#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize)]
    13	#[serde(rename_all = "snake_case")]
    14	pub enum Rotation {
    15	    /// No rotation (0 degrees)
    16	    #[default]
    17	    None,
    18	    /// 90 degrees clockwise
    19	    Clockwise90,
    20	    /// 180 degrees
    21	    Rotate180,
    22	    /// 270 degrees clockwise (90 degrees counter-clockwise)
    23	    CounterClockwise90,
    24	}
    25	
    26	impl Rotation {
    27	    /// Returns all possible rotations.
    28	    #[must_use]
    29	    pub const fn values() -> [Self; 4] {
    30	        [
    31	            Self::None,
    32	            Self::Clockwise90,
    33	            Self::Rotate180,
    34	            Self::CounterClockwise90,
    35	        ]
    36	    }
    37	
    38	    /// Gets a random rotation from the given random value (0-3).
    39	    #[must_use]
    40	    pub const fn from_index(index: u8) -> Self {
    41	        match index % 4 {
    42	            0 => Self::None,
    43	            1 => Self::Clockwise90,
    44	            2 => Self::Rotate180,
    45	            _ => Self::CounterClockwise90,
    46	        }
    47	    }
    48	
    49	    /// Transforms a position within the template bounds according to this rotation.
    50	    ///
    51	    /// The position is rotated around the Y axis. The `size` parameter defines
    52	    /// the template dimensions, used to calculate the pivot point.
    53	    #[must_use]
    54	    pub const fn transform_pos(&self, pos: Vector3<i32>, size: Vector3<i32>) -> Vector3<i32> {
    55	        match self {
    56	            Self::None => pos,
    57	            Self::Clockwise90 => Vector3::new(size.z - 1 - pos.z, pos.y, pos.x),
    58	            Self::Rotate180 => Vector3::new(size.x - 1 - pos.x, pos.y, size.z - 1 - pos.z),
    59	            Self::CounterClockwise90 => Vector3::new(pos.z, pos.y, size.x - 1 - pos.x),
    60	        }
    61	    }
    62	
    63	    /// Rotates an X/Z offset around the origin.
    64	    ///
    65	    /// Unlike `transform_pos` which rotates within template bounds,
    66	    /// this rotates a simple offset (e.g. sub-template positioning).
    67	    #[must_use]
    68	    pub const fn rotate_offset(self, x: i32, z: i32) -> (i32, i32) {
    69	        match self {
    70	            Self::None => (x, z),
    71	            Self::Clockwise90 => (-z, x),
    72	            Self::Rotate180 => (-x, -z),
    73	            Self::CounterClockwise90 => (z, -x),
    74	        }
    75	    }
    76	
    77	    /// Rotates the template size dimensions according to this rotation.
    78	    ///
    79	    /// For 90 and 270 degree rotations, X and Z dimensions are swapped.
    80	    #[must_use]
    81	    pub const fn transform_size(&self, size: Vector3<i32>) -> Vector3<i32> {
    82	        match self {
    83	            Self::None | Self::Rotate180 => size,
    84	            Self::Clockwise90 | Self::CounterClockwise90 => Vector3::new(size.z, size.y, size.x),
    85	        }
    86	    }
    87	
    88	    /// Rotates a horizontal facing direction.
    89	    ///
    90	    /// Takes a facing string (north/south/east/west) and returns the rotated facing.
    91	    #[must_use]
    92	    pub fn rotate_facing(&self, facing: &str) -> &'static str {
    93	        match self {
    94	            Self::None => match facing {
    95	                "north" => "north",
    96	                "south" => "south",
    97	                "east" => "east",
    98	                "west" => "west",
    99	                "up" => "up",
   100	                "down" => "down",
   101	                _ => leak_str(facing),
   102	            },
   103	            Self::Clockwise90 => match facing {
   104	                "north" => "east",
   105	                "east" => "south",
   106	                "south" => "west",
   107	                "west" => "north",
   108	                "up" => "up",
   109	                "down" => "down",
   110	                _ => leak_str(facing),
   111	            },
   112	            Self::Rotate180 => match facing {
   113	                "north" => "south",
   114	                "south" => "north",
   115	                "east" => "west",
   116	                "west" => "east",
   117	                "up" => "up",
   118	                "down" => "down",
   119	                _ => leak_str(facing),
   120	            },
   121	            Self::CounterClockwise90 => match facing {
   122	                "north" => "west",
   123	                "west" => "south",
   124	                "south" => "east",
   125	                "east" => "north",
   126	                "up" => "up",
   127	                "down" => "down",
   128	                _ => leak_str(facing),
   129	            },
   130	        }
   131	    }
   132	
   133	    /// Rotates a horizontal axis.
   134	    ///
   135	    /// Takes an axis string (x/z) and returns the rotated axis.
   136	    #[must_use]
   137	    pub fn rotate_axis(&self, axis: &str) -> &'static str {
   138	        match self {
   139	            Self::None | Self::Rotate180 => match axis {
   140	                "x" => "x",
   141	                "z" => "z",
   142	                "y" => "y",
   143	                _ => leak_str(axis),
   144	            },
   145	            Self::Clockwise90 | Self::CounterClockwise90 => match axis {
   146	                "x" => "z",
   147	                "z" => "x",
   148	                "y" => "y",
   149	                _ => leak_str(axis),
   150	            },
   151	        }
   152	    }
   153	
   154	    /// Rotates a block rotation value (0-15, used for signs and banners).
   155	    #[must_use]
   156	    pub const fn rotate_block_rotation(&self, rotation: i32) -> i32 {
   157	        match self {
   158	            Self::None => rotation,
   159	            Self::Clockwise90 => (rotation + 4) % 16,
   160	            Self::Rotate180 => (rotation + 8) % 16,
   161	            Self::CounterClockwise90 => (rotation + 12) % 16,
   162	        }
   163	    }
   164	
   165	    /// Combines this rotation with another rotation.
   166	    #[must_use]
   167	    pub const fn then(&self, other: Self) -> Self {
   168	        match self {
   169	            Self::None => other,
   170	            Self::Clockwise90 => match other {
   171	                Self::None => Self::Clockwise90,
   172	                Self::Clockwise90 => Self::Rotate180,
   173	                Self::Rotate180 => Self::CounterClockwise90,
   174	                Self::CounterClockwise90 => Self::None,
   175	            },
   176	            Self::Rotate180 => match other {
   177	                Self::None => Self::Rotate180,
   178	                Self::Clockwise90 => Self::CounterClockwise90,
   179	                Self::Rotate180 => Self::None,
   180	                Self::CounterClockwise90 => Self::Clockwise90,
   181	            },
   182	            Self::CounterClockwise90 => match other {
   183	                Self::None => Self::CounterClockwise90,
   184	                Self::Clockwise90 => Self::None,
   185	                Self::Rotate180 => Self::Clockwise90,
   186	                Self::CounterClockwise90 => Self::Rotate180,
   187	            },
   188	        }
   189	    }
   190	
   191	    /// Returns the inverse of this rotation.
   192	    #[must_use]
   193	    pub const fn inverse(&self) -> Self {
   194	        match self {
   195	            Self::None => Self::None,
   196	            Self::Clockwise90 => Self::CounterClockwise90,
   197	            Self::Rotate180 => Self::Rotate180,
   198	            Self::CounterClockwise90 => Self::Clockwise90,
   199	        }
   200	    }
   201	
   202	    /// Converts rotation to a primary axis for bounding box creation.
   203	    #[must_use]
   204	    pub const fn to_axis(self) -> pumpkin_util::math::vector3::Axis {
   205	        match self {
   206	            Self::None | Self::Rotate180 => pumpkin_util::math::vector3::Axis::Z,
   207	            Self::Clockwise90 | Self::CounterClockwise90 => pumpkin_util::math::vector3::Axis::X,
   208	        }
   209	    }
   210	
   211	    /// Rotates a 3D block direction according to this rotation around the Y axis.
   212	    #[must_use]
   213	    pub const fn rotate(&self, direction: BlockDirection) -> BlockDirection {
   214	        if matches!(direction, BlockDirection::Down | BlockDirection::Up) {
   215	            return direction;
   216	        }
   217	        match self {
   218	            Self::None => direction,
   219	            Self::Clockwise90 => direction.rotate_clockwise(),
   220	            Self::Rotate180 => direction.opposite(),
   221	            Self::CounterClockwise90 => direction.rotate_counter_clockwise(),
   222	        }
   223	    }
   224	
   225	    /// Rotates a horizontal facing direction according to this rotation.
   226	    #[must_use]
   227	    pub const fn rotate_horizontal(&self, facing: HorizontalFacing) -> HorizontalFacing {
   228	        match self {
   229	            Self::None => facing,
   230	            Self::Clockwise90 => facing.rotate_clockwise(),
   231	            Self::Rotate180 => facing.opposite(),
   232	            Self::CounterClockwise90 => facing.rotate_counter_clockwise(),
   233	        }
   234	    }
   235	}
   236	
   237	/// Mirror transformation for structure templates.
   238	#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize)]
   239	#[serde(rename_all = "snake_case")]
   240	pub enum Mirror {
   241	    /// No mirroring
   242	    #[default]
   243	    None,
   244	    /// Mirror along the Z axis (`OctahedralGroup.INVERT_Z` in vanilla) - flips north/south
   245	    LeftRight,
   246	    /// Mirror along the X axis (`OctahedralGroup.INVERT_X` in vanilla) - flips east/west
   247	    FrontBack,
   248	}
   249	
   250	impl Mirror {
   251	    /// Returns all possible mirrors.
   252	    #[must_use]
   253	    pub const fn values() -> [Self; 3] {
   254	        [Self::None, Self::LeftRight, Self::FrontBack]
   255	    }
   256	
   257	    /// Transforms a position within the template bounds according to this mirror.
   258	    #[must_use]
   259	    pub const fn transform_pos(&self, pos: Vector3<i32>, size: Vector3<i32>) -> Vector3<i32> {
   260	        match self {
   261	            Self::None => pos,
   262	            Self::LeftRight => Vector3::new(pos.x, pos.y, size.z - 1 - pos.z),
   263	            Self::FrontBack => Vector3::new(size.x - 1 - pos.x, pos.y, pos.z),
   264	        }
   265	    }
   266	
   267	    /// Mirrors a horizontal facing direction.
   268	    #[must_use]
   269	    pub fn mirror_facing(&self, facing: &str) -> &'static str {
   270	        match self {
   271	            Self::None => match facing {
   272	                "north" => "north",
   273	                "south" => "south",
   274	                "east" => "east",
   275	                "west" => "west",
   276	                "up" => "up",
   277	                "down" => "down",
   278	                _ => leak_str(facing),
   279	            },
   280	            Self::LeftRight => match facing {
   281	                "north" => "south",
   282	                "south" => "north",
   283	                "east" => "east",
   284	                "west" => "west",
   285	                "up" => "up",
   286	                "down" => "down",
   287	                _ => leak_str(facing),
   288	            },
   289	            Self::FrontBack => match facing {
   290	                "east" => "west",
   291	                "west" => "east",
   292	                "north" => "north",
   293	                "south" => "south",
   294	                "up" => "up",
   295	                "down" => "down",
   296	                _ => leak_str(facing),
   297	            },
   298	        }
   299	    }
   300	
   301	    /// Mirrors a block rotation value (0-15, used for signs and banners).
   302	    ///
   303	    /// Matches vanilla `Mirror.mirror(rotation, steps)` for `steps == 16`: vanilla first
   304	    /// corrects `rotation` into `-8..=8` before applying the formula, but for `steps == 16`
   305	    /// that correction is a no-op modulo 16 over the `0..16` input range this takes, so it's
   306	    /// omitted here.
   307	    #[must_use]
   308	    pub const fn mirror_block_rotation(&self, rotation: i32) -> i32 {
   309	        match self {
   310	            Self::None => rotation,
   311	            Self::LeftRight => (8 - rotation + 16) % 16,
   312	            Self::FrontBack => (16 - rotation) % 16,
   313	        }
   314	    }
   315	
   316	    /// Returns the rotation needed to achieve this mirror from a base rotation.
   317	    ///
   318	    /// Unlike the other methods on this type, this has no identified vanilla counterpart
   319	    /// (vanilla's `Mirror.getRotation` takes a `Direction`, not a `Rotation`) and currently
   320	    /// has no callers, so its behavior is left as-is rather than guessed at.
   321	    #[must_use]
   322	    pub const fn get_rotation(&self, rotation: Rotation) -> Rotation {
   323	        match self {
   324	            Self::None => rotation,
   325	            Self::LeftRight => match rotation {
   326	                Rotation::None => Rotation::None,
   327	                Rotation::Clockwise90 => Rotation::CounterClockwise90,
   328	                Rotation::Rotate180 => Rotation::Rotate180,
   329	                Rotation::CounterClockwise90 => Rotation::Clockwise90,
   330	            },
   331	            Self::FrontBack => match rotation {
   332	                Rotation::None => Rotation::Rotate180,
   333	                Rotation::Clockwise90 => Rotation::Clockwise90,
   334	                Rotation::Rotate180 => Rotation::None,
   335	                Rotation::CounterClockwise90 => Rotation::CounterClockwise90,
   336	            },
   337	        }
   338	    }
   339	
   340	    /// Mirrors a 3D block direction according to this mirror plane.
   341	    #[must_use]
   342	    pub const fn mirror(&self, direction: BlockDirection) -> BlockDirection {
   343	        match self {
   344	            Self::None => direction,
   345	            Self::LeftRight => match direction {
   346	                BlockDirection::North => BlockDirection::South,
   347	                BlockDirection::South => BlockDirection::North,
   348	                _ => direction,
   349	            },
   350	            Self::FrontBack => match direction {
   351	                BlockDirection::East => BlockDirection::West,
   352	                BlockDirection::West => BlockDirection::East,
   353	                _ => direction,
   354	            },
   355	        }
   356	    }
   357	
   358	    /// Mirrors a horizontal facing direction according to this mirror plane.
   359	    #[must_use]
   360	    pub const fn mirror_horizontal(&self, facing: HorizontalFacing) -> HorizontalFacing {
   361	        match self {
   362	            Self::None => facing,
   363	            Self::LeftRight => match facing {
   364	                HorizontalFacing::North => HorizontalFacing::South,
   365	                HorizontalFacing::South => HorizontalFacing::North,
   366	                _ => facing,
   367	            },
   368	            Self::FrontBack => match facing {
   369	                HorizontalFacing::East => HorizontalFacing::West,
   370	                HorizontalFacing::West => HorizontalFacing::East,
   371	                _ => facing,
   372	            },
   373	        }
   374	    }
   375	
   376	    /// Returns the rotation required for mirroring a direction with this mirror.
   377	    #[must_use]
   378	    pub const fn get_rotation_for_direction(&self, direction: BlockDirection) -> Rotation {
   379	        match self {
   380	            Self::LeftRight
   381	                if matches!(direction, BlockDirection::North | BlockDirection::South) =>
   382	            {
   383	                Rotation::Rotate180
   384	            }
   385	            Self::FrontBack if matches!(direction, BlockDirection::East | BlockDirection::West) => {
   386	                Rotation::Rotate180
   387	            }
   388	            _ => Rotation::None,
   389	        }
   390	    }
   391	
   392	    /// Returns the rotation required for mirroring a horizontal facing with this mirror.
   393	    #[must_use]
   394	    pub const fn get_rotation_for_horizontal(&self, facing: HorizontalFacing) -> Rotation {
   395	        match self {
   396	            Self::LeftRight
   397	                if matches!(facing, HorizontalFacing::North | HorizontalFacing::South) =>
   398	            {
   399	                Rotation::Rotate180
   400	            }
   401	            Self::FrontBack
   402	                if matches!(facing, HorizontalFacing::East | HorizontalFacing::West) =>
   403	            {
   404	                Rotation::Rotate180
   405	            }
   406	            _ => Rotation::None,
   407	        }
   408	    }
   409	}
   410	
   411	/// Block names that carry `north`/`south`/`east`/`west` properties but which vanilla
   412	/// deliberately leaves untransformed: `FireBlock` (`FireBlock.java:30`) and
   413	/// `ChorusPlantBlock` (`ChorusPlantBlock.java:18`) declare neither `rotate` nor `mirror`,
   414	/// so `BlockBehaviour.rotate`/`mirror` (`BlockBehaviour.java:256-262`) returns the state
   415	/// unchanged for them.
   416	const SIDE_PERMUTATION_EXEMPT: [&str; 2] = ["fire", "chorus_plant"];
   417	
   418	fn permutes_sides(block_name: &str) -> bool {
   419	    !SIDE_PERMUTATION_EXEMPT.contains(&block_name)
   420	}
   421	
   422	fn is_direction(value: &str) -> bool {
   423	    matches!(value, "north" | "south" | "east" | "west" | "up" | "down")
   424	}
   425	
   426	/// Maps a `0..16` rotation index to a static string, avoiding an allocation on the
   427	/// structure-placement hot path.
   428	const fn rotation16_to_str(rotation: i32) -> &'static str {
   429	    match rotation.rem_euclid(16) {
   430	        1 => "1",
   431	        2 => "2",
   432	        3 => "3",
   433	        4 => "4",
   434	        5 => "5",
   435	        6 => "6",
   436	        7 => "7",
   437	        8 => "8",
   438	        9 => "9",
   439	        10 => "10",
   440	        11 => "11",
   441	        12 => "12",
   442	        13 => "13",
   443	        14 => "14",
   444	        15 => "15",
   445	        _ => "0",
   446	    }
   447	}
   448	
   449	/// Recombines a `FrontAndTop` pair into the `orientation` property value used by
   450	/// jigsaw blocks and crafters. Returns `None` when the pair is not one of the twelve
   451	/// valid combinations.
   452	fn orientation_value(front: &str, top: &str) -> Option<&'static str> {
   453	    Some(match (front, top) {
   454	        ("down", "east") => "down_east",
   455	        ("down", "north") => "down_north",
   456	        ("down", "south") => "down_south",
   457	        ("down", "west") => "down_west",
   458	        ("up", "east") => "up_east",
   459	        ("up", "north") => "up_north",
   460	        ("up", "south") => "up_south",
   461	        ("up", "west") => "up_west",
   462	        ("west", "up") => "west_up",
   463	        ("east", "up") => "east_up",
   464	        ("north", "up") => "north_up",
   465	        ("south", "up") => "south_up",
   466	        _ => return None,
   467	    })
   468	}
   469	
   470	impl Rotation {
   471	    /// Rotates a rail shape.
   472	    ///
   473	    /// Mirrors `BaseRailBlock.rotate(RailShape, Rotation)`
   474	    /// (`BaseRailBlock.java:146-228`). Returns `None` for values that are not rail
   475	    /// shapes, such as the stair shapes, which vanilla's `StairBlock.rotate`
   476	    /// (`StairBlock.java:169-171`) leaves untouched.
   477	    #[must_use]
   478	    pub fn rotate_rail_shape(self, shape: &str) -> Option<&'static str> {
   479	        Some(match self {
   480	            Self::None => return None,
   481	            Self::Clockwise90 => match shape {
   482	                "north_south" => "east_west",
   483	                "east_west" => "north_south",
   484	                "ascending_east" => "ascending_south",
   485	                "ascending_west" => "ascending_north",
   486	                "ascending_north" => "ascending_east",
   487	                "ascending_south" => "ascending_west",
   488	                "south_east" => "south_west",
   489	                "south_west" => "north_west",
   490	                "north_west" => "north_east",
   491	                "north_east" => "south_east",
   492	                _ => return None,
   493	            },
   494	            Self::Rotate180 => match shape {
   495	                "north_south" => "north_south",
   496	                "east_west" => "east_west",
   497	                "ascending_east" => "ascending_west",
   498	                "ascending_west" => "ascending_east",
   499	                "ascending_north" => "ascending_south",
   500	                "ascending_south" => "ascending_north",
   501	                "south_east" => "north_west",
   502	                "south_west" => "north_east",
   503	                "north_west" => "south_east",
   504	                "north_east" => "south_west",
   505	                _ => return None,
   506	            },
   507	            Self::CounterClockwise90 => match shape {
   508	                "north_south" => "east_west",
   509	                "east_west" => "north_south",
   510	                "ascending_east" => "ascending_north",
   511	                "ascending_west" => "ascending_south",
   512	                "ascending_north" => "ascending_west",
   513	                "ascending_south" => "ascending_east",
   514	                "south_east" => "north_east",
   515	                "south_west" => "south_east",
   516	                "north_west" => "south_west",
   517	                "north_east" => "north_west",
   518	                _ => return None,
   519	            },
   520	        })
   521	    }
   522	
   523	    /// Rotates a jigsaw/crafter `orientation` value.
   524	    ///
   525	    /// Vanilla applies the rotation's `OctahedralGroup` to the `FrontAndTop`
   526	    /// (`JigsawBlock.java:41-43`, `CrafterBlock.java:234-236`), which for a rotation
   527	    /// about Y is the same as rotating the front and top directions independently.
   528	    #[must_use]
   529	    pub fn rotate_orientation(self, value: &str) -> Option<&'static str> {
   530	        let (front, top) = value.split_once('_')?;
   531	        if !is_direction(front) || !is_direction(top) {
   532	            return None;
   533	        }
   534	        orientation_value(self.rotate_facing(front), self.rotate_facing(top))
   535	    }
   536	
   537	    /// Applies this rotation to a block state's property list in place.
   538	    ///
   539	    /// This is the property-driven equivalent of vanilla's per-block `rotate`
   540	    /// overrides: rotating whichever of `facing`, `axis`, `rotation`, `shape`,
   541	    /// `orientation` and the four side properties a state happens to carry.
   542	    pub fn apply_to_props(self, block_name: &str, props: &mut [(&'static str, &'static str)]) {
   543	        if self == Self::None {
   544	            return;
   545	        }
   546	        let sides = permutes_sides(block_name);
   547	        for (key, value) in props.iter_mut() {
   548	            match *key {
   549	                // HorizontalDirectionalBlock.java:21-23, DirectionalBlock subclasses.
   550	                "facing" if is_direction(*value) => *value = self.rotate_facing(*value),
   551	                // RotatedPillarBlock.rotatePillar, RotatedPillarBlock.java:31-45.
   552	                "axis" => *value = self.rotate_axis(*value),
   553	                // StandingSignBlock.java:72-74, BannerBlock, SkullBlock.
   554	                "rotation" => {
   555	                    if let Ok(parsed) = value.parse::<i32>() {
   556	                        *value = rotation16_to_str(self.rotate_block_rotation(parsed));
   557	                    }
   558	                }
   559	                "shape" => {
   560	                    if let Some(rotated) = self.rotate_rail_shape(*value) {
   561	                        *value = rotated;
   562	                    }
   563	                }
   564	                "orientation" => {
   565	                    if let Some(rotated) = self.rotate_orientation(*value) {
   566	                        *value = rotated;
   567	                    }
   568	                }
   569	                // CrossCollisionBlock.java:96-112, WallBlock.java:271-287,
   570	                // MultifaceBlock, VineBlock, TripWireBlock, RedStoneWireBlock: the
   571	                // value stays put and moves to the rotated side.
   572	                "north" | "south" | "east" | "west" if sides => *key = self.rotate_facing(*key),
   573	                _ => {}
   574	            }
   575	        }
   576	    }
   577	}
   578	
   579	impl Mirror {
   580	    /// Mirrors a rail shape.
   581	    ///
   582	    /// Mirrors `BaseRailBlock.mirror(RailShape, Mirror)` (`BaseRailBlock.java:230-276`).
   583	    #[must_use]
   584	    pub fn mirror_rail_shape(self, shape: &str) -> Option<&'static str> {
   585	        Some(match self {
   586	            Self::None => return None,
   587	            Self::LeftRight => match shape {
   588	                "ascending_north" => "ascending_south",
   589	                "ascending_south" => "ascending_north",
   590	                "south_east" => "north_east",
   591	                "south_west" => "north_west",
   592	                "north_west" => "south_west",
   593	                "north_east" => "south_east",
   594	                _ => return None,
   595	            },
   596	            Self::FrontBack => match shape {
   597	                "ascending_east" => "ascending_west",
   598	                "ascending_west" => "ascending_east",
   599	                "south_east" => "south_west",
   600	                "south_west" => "south_east",
   601	                "north_west" => "north_east",
   602	                "north_east" => "north_west",
   603	                _ => return None,
   604	            },
   605	        })
   606	    }
   607	
   608	    /// Mirrors a stair `shape`, given whether this mirror flipped the stair's facing.
   609	    ///
   610	    /// `StairBlock.mirror` (`StairBlock.java:174-212`) only remaps the shape when the
   611	    /// facing lies on the mirrored axis, and the two mirrors are deliberately
   612	    /// asymmetric: `LEFT_RIGHT` swaps both the inner and the outer corners, while
   613	    /// `FRONT_BACK` swaps only the outer ones.
   614	    #[must_use]
   615	    pub fn mirror_stairs_shape(self, shape: &str, facing_flipped: bool) -> Option<&'static str> {
   616	        if !facing_flipped {
   617	            return None;
   618	        }
   619	        Some(match self {
   620	            Self::None => return None,
   621	            Self::LeftRight => match shape {
   622	                "inner_left" => "inner_right",
   623	                "inner_right" => "inner_left",
   624	                "outer_left" => "outer_right",
   625	                "outer_right" => "outer_left",
   626	                _ => return None,
   627	            },
   628	            Self::FrontBack => match shape {
   629	                "outer_left" => "outer_right",
   630	                "outer_right" => "outer_left",
   631	                _ => return None,
   632	            },
   633	        })
   634	    }
   635	
   636	    /// Mirrors a jigsaw/crafter `orientation` value
   637	    /// (`JigsawBlock.java:46-48`, `CrafterBlock.java:239-241`).
   638	    #[must_use]
   639	    pub fn mirror_orientation(self, value: &str) -> Option<&'static str> {
   640	        let (front, top) = value.split_once('_')?;
   641	        if !is_direction(front) || !is_direction(top) {
   642	            return None;
   643	        }
   644	        orientation_value(self.mirror_facing(front), self.mirror_facing(top))
   645	    }
   646	
   647	    /// Applies this mirror to a block state's property list in place.
   648	    pub fn apply_to_props(self, block_name: &str, props: &mut [(&'static str, &'static str)]) {
   649	        if self == Self::None {
   650	            return;
   651	        }
   652	        let sides = permutes_sides(block_name);
   653	        // StairBlock.mirror reads the pre-mirror facing to decide the shape remap.
   654	        let facing_flipped = props
   655	            .iter()
   656	            .find(|(key, _)| *key == "facing")
   657	            .map(|(_, value)| *value)
   658	            .is_some_and(|value| self.mirror_facing(value) != value);
   659	        for (key, value) in props.iter_mut() {
   660	            match *key {
   661	                "facing" if is_direction(*value) => *value = self.mirror_facing(*value),
   662	                // Mirror.java: INVERT_X / INVERT_Z never swap axes, so `axis` is fixed.
   663	                "rotation" => {
   664	                    if let Ok(parsed) = value.parse::<i32>() {
   665	                        *value = rotation16_to_str(self.mirror_block_rotation(parsed));
   666	                    }
   667	                }
   668	                // DoorBlock.java:257-259 cycles HINGE for any non-NONE mirror, even
   669	                // when the facing itself is unaffected.
   670	                "hinge" => {
   671	                    *value = match *value {
   672	                        "left" => "right",
   673	                        "right" => "left",
   674	                        other => other,
   675	                    };
   676	                }
   677	                "shape" => {
   678	                    if let Some(mirrored) = self
   679	                        .mirror_rail_shape(*value)
   680	                        .or_else(|| self.mirror_stairs_shape(*value, facing_flipped))
   681	                    {
   682	                        *value = mirrored;
   683	                    }
   684	                }
   685	                "orientation" => {
   686	                    if let Some(mirrored) = self.mirror_orientation(*value) {
   687	                        *value = mirrored;
   688	                    }
   689	                }
   690	                "north" | "south" | "east" | "west" if sides => *key = self.mirror_facing(*key),
   691	                _ => {}
   692	            }
   693	        }
   694	    }
   695	}
   696	
   697	/// Leaks a string to get a 'static str.
   698	/// This is used for non-standard property values that aren't covered by static strings.
   699	pub fn leak_str(s: &str) -> &'static str {
   700	    s.to_string().leak()
   701	}

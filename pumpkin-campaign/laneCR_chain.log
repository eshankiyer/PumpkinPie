   233	#[derive(Clone, Copy, Default)]
   234	// We actually only use the first 4 bits ;)
   235	pub struct Controls(u8);
   236	
   237	impl Controls {
   238	    pub const MOVE: Self = Self(1);
   239	    pub const LOOK: Self = Self(2);
   240	    pub const JUMP: Self = Self(4);
   241	    pub const TARGET: Self = Self(8);
   242	
   243	    pub const ITER: [Self; 4] = [Self::MOVE, Self::LOOK, Self::JUMP, Self::TARGET];
   244	
   245	    #[must_use]
   246	    pub fn empty() -> Self {
   247	        Self::default()
   248	    }
   249	
   250	    pub const fn set(&mut self, control: Self, val: bool) {
   251	        if val {
   252	            self.0 |= control.0;
   253	        } else {
   254	            self.0 &= !control.0;
   255	        }
   256	    }
   257	
   258	    #[must_use]
   259	    pub const fn get(&self, control: Self) -> bool {
   260	        self.0 & control.0 != 0
   261	    }
   262	
   263	    #[must_use]
   264	    pub fn idx(&self) -> usize {
   265	        for (i, control) in Self::ITER.into_iter().enumerate() {
   266	            if self.get(control) {
   267	                return i;
   268	            }
   269	        }
   270	        tracing::error!("Controls::idx called with no controls set");
   271	        0
   272	    }
   273	}
   274	
   275	impl BitOr for Controls {
   276	    type Output = Self;
   277	    fn bitor(self, rhs: Self) -> Self::Output {
   278	        Self(self.0 | rhs.0)
   279	    }
   280	}

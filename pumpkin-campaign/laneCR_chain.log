   112	    pub suffix: IntegerSuffix,
   113	}
   114	
   115	impl IntegerLiteral {
   116	    pub const fn get_signed_prefix_or_default(&self) -> SignedPrefix {
   117	        match (self.suffix.0, self.base) {
   118	            (SignedPrefix::None, Base::Binary | Base::Hexadecimal) => SignedPrefix::Unsigned,
   119	            (SignedPrefix::None, Base::Decimal) => SignedPrefix::Signed,
   120	            (prefix, _) => prefix,
   121	        }
   122	    }
   123	}

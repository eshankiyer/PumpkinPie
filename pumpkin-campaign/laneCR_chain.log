   157	}
   158	
   159	fn ceiling_supports(world: &World, position: &BlockPos) -> bool {
   160	    world
   161	        .get_block_state(&position.up())
   162	        .is_center_solid(BlockDirection::Down)
   163	}
   164	
   165	fn can_place_at(world: &World, position: &BlockPos) -> bool {
   166	    //idk why this don't update with .is_center_solid so this is a 'temporary patch'
   167	    if world
   168	        .get_block(&position.down())
   169	        .has_tag(&tag::Block::C_FENCE_GATES)
   170	    {

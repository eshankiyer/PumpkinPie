    57	            for condition in behavior.required_memories() {
    58	                if !required_memories.contains(condition) {
    59	                    required_memories.push(*condition);
    60	                }
    61	            }
    62	        }
    63	        Self {
    64	            entry_condition,
    65	            required_memories,
    66	            exit_erased_memories,
    67	            order_policy,
    68	            running_policy,

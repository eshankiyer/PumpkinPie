   395	    #[test]
   396	    fn randomized_int_provider_sets_sampled_age() {
   397	        let world_gen = WorldGenerator::Noise(Box::new(VanillaGenerator::new(
   398	            Seed(1),
   399	            Dimension::OVERWORLD,
   400	        )));
   401	        let chunk = ProtoChunk::new(0, 0, &world_gen);
   402	        let registry = NoopWorldPortal;
   403	        let mut random = RandomGenerator::Legacy(LegacyRand::from_seed(1));
   404	
   405	        let provider = RandomizedIntBlockStateProvider {
   406	            source: Box::new(BlockStateProvider::Simple(SimpleStateProvider {
   407	                state: Block::CAVE_VINES.default_state,
   408	            })),
   409	            property: "age".to_string(),
   410	            values: IntProvider::Constant(7),
   411	        };
   412	
   413	        let pos = BlockPos::new(0, 0, 0);
   414	        let result = provider.get(&mut random, pos, &chunk, &registry);
   415	
   416	        let block = Block::from_state_id(result.id);
   417	        let props = block.properties(result.id).unwrap().to_props();
   418	        let age = props
   419	            .iter()
   420	            .find(|(key, _)| *key == "age")
   421	            .map(|(_, value)| *value);
   422	        assert_eq!(age, Some("7"));
   423	    }

--- final input handler ---
     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_player_input(
     6	        &self,
     7	        player: &Arc<Player>,
     8	        input: SPlayerInput,
     9	        server: &Arc<Server>,
    10	    ) {
    11	        let mut input_event =
    12	            crate::plugin::api::events::player::player_input::PlayerInputEvent::new(
    13	                player.clone(),
    14	                format!("{:b}", input.input),
    15	            );
    16	        server.plugin_manager.fire(server, &mut input_event).await;
    17	        if input_event.cancelled {
    18	            return;
    19	        }
    20	
    21	        player.last_input.store(input.input, Ordering::Relaxed);
    22	        // Vanilla refreshes the idle-action timer for input from a loaded client
    23	        // (`ServerGamePacketListenerImpl.java:421-428`).
    24	        if player.has_client_loaded() {
    25	            player.update_last_action_time();
    26	        }
    27	
    28	        let sneak = input.input & SPlayerInput::SNEAK != 0;
    29	        if sneak
    30	            && player.gamemode.load() == GameMode::Spectator
    31	            && player.camera_target_id.load().is_some()
    32	        {
    33	            player.camera_target_id.store(None);
    34	            player
    35	                .send_client_packet(&CSetCamera::new(player.entity_id().into()))
    36	                .await;
    37	        }
    38	
    39	        if player.get_entity().is_sneaking() != sneak {
    40	            send_cancellable! {{
    41	                server;
    42	                PlayerToggleSneakEvent::new(player.clone(), sneak);
    43	                'after: {
    44	                    player.get_entity().set_sneaking(event.is_sneaking).await;
    45	                    if event.is_sneaking {
    46	                        let vehicle = player.get_entity().vehicle.lock().await.clone();
    47	                        if let Some(vehicle) = vehicle {
    48	                            vehicle
    49	                                .get_entity()
    50	                                .remove_passenger(player.entity_id())
    51	                                .await;
    52	                        }
    53	                    }
    54	                }
    55	            }}
    56	        } else if sneak {
    57	            let vehicle = player.get_entity().vehicle.lock().await.clone();
    58	            if let Some(vehicle) = vehicle {
    59	                vehicle
    60	                    .get_entity()
    61	                    .remove_passenger(player.entity_id())
    62	                    .await;
    63	            }
    64	        }
    65	    }
    66	}

    87	    /// `ShufflingList.shuffle` (`ShufflingList.java:76-80`): each entry gets a sort key of
    88	    /// `-nextFloat().powf(1.0 / weight)` and the list is sorted ascending by it. That is the
    89	    /// standard weighted-reservoir ordering -- higher weight means a key closer to -1, so it
    90	    /// sorts earlier and is tried first.
    91	    fn shuffle(&mut self) {
    92	        let mut rng = rand::rng();
    93	        let mut keyed: Vec<(f32, usize)> = (0..self.behaviors.len())
    94	            .map(|index| {
    95	                let weight = self.behaviors[index].1;
    96	                let roll: f32 = rng.random::<f32>();
    97	                #[allow(clippy::cast_precision_loss)]
    98	                let key = -roll.powf(1.0 / weight as f32);
    99	                (key, index)
   100	            })
   101	            .collect();
   102	        keyed.sort_by(|a, b| a.0.total_cmp(&b.0));
   103	
   104	        let mut reordered: Vec<Option<(Box<dyn Behavior>, i32)>> =
   105	            self.behaviors.drain(..).map(Some).collect();
   106	        self.behaviors = keyed
   107	            .into_iter()
   108	            .filter_map(|(_, index)| reordered[index].take())
   109	            .collect();
   110	    }
   111	}

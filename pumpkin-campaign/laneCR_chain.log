     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	use pumpkin_inventory::crafter_screen_handler::CrafterScreenHandler;
     4	use pumpkin_protocol::java::server::play::SContainerSlotStateChanged;
     5	use pumpkin_util::GameMode;
     6	
     7	use crate::block::entities::crafter::CrafterBlockEntity;
     8	
     9	impl JavaClient {
    10	    /// `ServerGamePacketListenerImpl.handleContainerSlotStateChanged`
    11	    /// (`ServerGamePacketListenerImpl.java:1040-1047`): non-spectators may toggle a crafter
    12	    /// input slot on the menu they actually have open. Vanilla routes the toggle to
    13	    /// `CrafterBlockEntity.setSlotState` (`CrafterBlockEntity.java:76-81`), not to
    14	    /// `CrafterMenu.setSlotState`, so the `slotCanBeDisabled` gate (the slot must be empty)
    15	    /// applies.
    16	    pub async fn handle_container_slot_state_changed(
    17	        &self,
    18	        player: &Player,
    19	        packet: &SContainerSlotStateChanged,
    20	    ) {
    21	        debug!(
    22	            "Player {} container {} slot {} state changed to {}",
    23	            player.gameprofile.name, packet.container_id.0, packet.slot_id.0, packet.new_state
    24	        );
    25	
    26	        if player.gamemode.load() == GameMode::Spectator {
    27	            return;
    28	        }
    29	
    30	        let screen_handler = player.current_screen_handler.lock().await.clone();
    31	        let screen_handler = screen_handler.lock().await;
    32	
    33	        if i32::from(screen_handler.sync_id()) != packet.container_id.0 {
    34	            return;
    35	        }
    36	
    37	        let Some(crafter_handler) = screen_handler
    38	            .as_any()
    39	            .downcast_ref::<CrafterScreenHandler>()
    40	        else {
    41	            return;
    42	        };
    43	
    44	        let Ok(slot) = usize::try_from(packet.slot_id.0) else {
    45	            return;
    46	        };
    47	
    48	        if let Some(crafter) = crafter_handler
    49	            .inventory
    50	            .as_any()
    51	            .downcast_ref::<CrafterBlockEntity>()
    52	        {
    53	            crafter.set_slot_state(slot, packet.new_state).await;
    54	        }
    55	    }
    56	}

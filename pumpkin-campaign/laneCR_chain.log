   449	            "No variables in macro"
   450	        );
   451	    }
   452	
   453	    #[test]
   454	    fn substitute_interleaves_segments_and_values() {
   455	        let t = template("tp $(x) $(y)");
   456	        assert_eq!(
   457	            t.substitute(&["10".to_string(), "64".to_string()])
   458	                .expect("fits"),
   459	            "tp 10 64"
   460	        );
   461	    }
   462	
   463	    #[test]
   464	    fn stringify_follows_vanilla_switch() {
   465	        // Exact doubles print without trailing zeros, matching
   466	        // `DecimalFormat("#", maxFrac=15)` (`MacroFunction.java:31-33`).
   467	        assert_eq!(stringify(&NbtTag::Float(1.5)), "1.5");
   468	        assert_eq!(stringify(&NbtTag::Float(2.0)), "2");
   469	        assert_eq!(stringify(&NbtTag::Float(-0.5)), "-0.5");
   470	        assert_eq!(stringify(&NbtTag::Double(12.375)), "12.375");
   471	        assert_eq!(stringify(&NbtTag::Float(1.0)), "1"); // trailing zero stripped
   472	        assert_eq!(stringify(&NbtTag::Byte(-1)), "-1");
   473	        assert_eq!(stringify(&NbtTag::Short(300)), "300");
   474	        assert_eq!(stringify(&NbtTag::Long(i64::MAX)), "9223372036854775807");
   475	        assert_eq!(stringify(&NbtTag::Int(42)), "42"); // default -> toString
   476	        assert_eq!(stringify(&NbtTag::String("hi".into())), "hi");
   477	    }
   478	
   479	    #[test]
   480	    fn cache_moves_hits_to_back_and_evicts_lru() {
   481	        let mut cache = InstantiationCache::default();
   482	        let key = |v: &str| vec![v.to_string()];
   483	        let make = |v: &'static str| move || Ok(vec![v.to_string()]);
   484	
   485	        for name in ["a", "b", "c", "d", "e", "f", "g", "h"] {
   486	            cache
   487	                .get_or_insert_with(&key(name), make(name))
   488	                .expect("compute ok");
   489	        }
   490	        // Cache is full; "a" is LRU. Touching "b" makes "a" the eviction victim.
   491	        assert_eq!(
   492	            cache
   493	                .get_or_insert_with(&key("b"), || Ok(vec!["should-not-run".to_string()]))
   494	                .expect("hit"),
   495	            vec!["b".to_string()]
   496	        );
   497	        cache
   498	            .get_or_insert_with(&key("i"), make("i"))
   499	            .expect("insert ok");
   500	        // "a" was evicted; "b" survived thanks to the recency bump.
   501	        assert_eq!(
   502	            cache
   503	                .get_or_insert_with(&key("b"), || Ok(vec!["recomputed".to_string()]))
   504	                .expect("still cached"),
   505	            vec!["b".to_string()]
   506	        );
   507	        assert_eq!(
   508	            cache
   509	                .get_or_insert_with(&key("a"), make("recomputed-a"))
   510	                .expect("miss recomputes"),
   511	            vec!["recomputed-a".to_string()]
   512	        );
   513	    }

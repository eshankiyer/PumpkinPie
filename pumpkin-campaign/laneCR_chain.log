     8	
     9	public class ServerboundPlayerAbilitiesPacket implements Packet<ServerGamePacketListener> {
    10	   public static final StreamCodec<FriendlyByteBuf, ServerboundPlayerAbilitiesPacket> STREAM_CODEC = Packet.codec(
    11	      ServerboundPlayerAbilitiesPacket::write, ServerboundPlayerAbilitiesPacket::new
    12	   );
    13	   private static final int FLAG_FLYING = 2;
    14	   private final boolean isFlying;
    15	
    16	   public ServerboundPlayerAbilitiesPacket(final Abilities abilities) {
    17	      this.isFlying = abilities.flying;
    18	   }
    19	
    20	   private ServerboundPlayerAbilitiesPacket(final FriendlyByteBuf input) {
    21	      byte bitfield = input.readByte();
    22	      this.isFlying = (bitfield & 2) != 0;
    23	   }
    24	
    25	   private void write(final FriendlyByteBuf output) {
    26	      byte bitfield = 0;
    27	      if (this.isFlying) {
    28	         bitfield = (byte)(bitfield | 2);
    29	      }
    30	
    31	      output.writeByte(bitfield);
    32	   }
    33	
    34	   @Override
    35	   public PacketType<ServerboundPlayerAbilitiesPacket> type() {
    36	      return GamePacketTypes.SERVERBOUND_PLAYER_ABILITIES;
    37	   }
    38	
    39	   public void handle(final ServerGamePacketListener listener) {
    40	      listener.handlePlayerAbilities(this);
    41	   }
    42	
    43	   public boolean isFlying() {
    44	      return this.isFlying;
    45	   }
    46	}

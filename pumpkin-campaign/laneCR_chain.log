   159	   private static boolean isStartTooCloseToWorldHeightLimits(
   160	      final LevelHeightAccessor heightAccessor, final DimensionPadding dimensionPadding, final BoundingBox centerPieceBb
   161	   ) {
   162	      if (dimensionPadding == DimensionPadding.ZERO) {
   163	         return false;
   164	      }
   165	
   166	      int minYWithPadding = heightAccessor.getMinY() + dimensionPadding.bottom();
   167	      int maxYWithPadding = heightAccessor.getMaxY() - dimensionPadding.top();
   168	      return centerPieceBb.minY() < minYWithPadding || centerPieceBb.maxY() > maxYWithPadding;
   169	   }

   414	fn map_function_condition_error(error: ExecuteFunctionError) -> CommandSyntaxError {
   415	    match error {
   416	        ExecuteFunctionError::Unknown(function_id) => {
   417	            ERROR_UNKNOWN_FUNCTION.create_without_context(TextComponent::text(function_id))
   418	        }
   419	        ExecuteFunctionError::InstantiationFailure {
   420	            function_id,
   421	            reason,
   422	        } => ERROR_FUNCTION_INSTANTIATION_FAILURE
   423	            .create_without_context(TextComponent::text(function_id), reason),
   424	    }
   425	}
   426	
   427	fn function_condition_matches(executed_count: usize, expected: bool) -> bool {
   428	    (executed_count != 0) == expected
   429	}
   430	
   431	/// Implements the function branch of vanilla `ExecuteCommand.scheduleFunctionConditionsAndTest`
   432	/// (`ExecuteCommand.java:652-657,1057-1113`) using the existing datapack function executor.
   433	fn execute_function_modifier<'a>(
   434	    context: &'a CommandContext,
   435	    expected: bool,
   436	) -> crate::command::node::RedirectModifierResult<'a> {
   437	    Box::pin(async move {
   438	        let name = StringArgumentType::get(context, "name")?;
   439	        let executed_count = context
   440	            .server()
   441	            .datapack_manager
   442	            .execute_function(context.server(), &context.source, name, None)
   443	            .await
   444	            .map_err(map_function_condition_error)?;
   445	
   446	        if function_condition_matches(executed_count, expected) {
   447	            Ok(vec![context.source.clone()])
   448	        } else {
   449	            Ok(vec![])
   450	        }
   451	    })
   452	}
   453	
   454	fn execute_if_function_modifier<'a>(
   455	    context: &'a CommandContext,
   456	) -> crate::command::node::RedirectModifierResult<'a> {
   457	    execute_function_modifier(context, true)
   458	}
   459	
   460	fn execute_unless_function_modifier<'a>(
   461	    context: &'a CommandContext,
   462	) -> crate::command::node::RedirectModifierResult<'a> {
   463	    execute_function_modifier(context, false)
   464	}

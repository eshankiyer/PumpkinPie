    31	impl BlockBehaviour for SkullBlock {
    32	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    33	        Box::pin(async move {
    34	            let entity = SkullBlockEntity::new(*args.position);
    35	            args.world.add_block_entity(Arc::new(entity));

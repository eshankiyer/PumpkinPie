    60	                        doors = rememberDoorToClose(doorsMemory, doors, level, fromPos);
    61	                     }
    62	
    63	                     BlockPos toPos = toNode.asBlockPos();
    64	                     BlockState toState = level.getBlockState(toPos);
    65	                     if (toState.is(BlockTags.MOB_INTERACTABLE_DOORS, s -> s.getBlock() instanceof DoorBlock)) {
    66	                        DoorBlock door = (DoorBlock)toState.getBlock();
    67	                        if (!door.isOpen(toState)) {
    68	                           door.setOpen(body, level, toState, toPos, true);
    69	                           doors = rememberDoorToClose(doorsMemory, doors, level, toPos);
    70	                        }
    71	                     }
    72	
    73	                     doors.ifPresent(
    74	                        doorSet -> closeDoorsThatIHaveOpenedOrPassedThrough(level, body, fromNode, toNode, (Set<GlobalPos>)doorSet, i.tryGet(nearestEntities))
    75	                     );
    76	                     return true;
    77	                  } else {
    78	                     return false;
    79	                  }
    80	               }
    81	            )
    82	      );
    83	   }
    84	
    85	   public static void closeDoorsThatIHaveOpenedOrPassedThrough(
    86	      final ServerLevel level,
    87	      final LivingEntity body,
    88	      final @Nullable Node movingFromNode,
    89	      final @Nullable Node movingToNode,
    90	      final Set<GlobalPos> doors,
    91	      final Optional<List<LivingEntity>> nearestEntities
    92	   ) {
    93	      Iterator<GlobalPos> iterator = doors.iterator();
    94	
    95	      while (iterator.hasNext()) {
    96	         GlobalPos doorGlobalPos = iterator.next();
    97	         BlockPos doorPos = doorGlobalPos.pos();
    98	         if ((movingFromNode == null || !movingFromNode.asBlockPos().equals(doorPos)) && (movingToNode == null || !movingToNode.asBlockPos().equals(doorPos))) {
    99	            if (isDoorTooFarAway(level, body, doorGlobalPos)) {
   100	               iterator.remove();
   101	            } else {
   102	               BlockState state = level.getBlockState(doorPos);
   103	               if (!state.is(BlockTags.MOB_INTERACTABLE_DOORS, s -> s.getBlock() instanceof DoorBlock)) {
   104	                  iterator.remove();
   105	               } else {
   106	                  DoorBlock block = (DoorBlock)state.getBlock();
   107	                  if (!block.isOpen(state)) {
   108	                     iterator.remove();
   109	                  } else if (areOtherMobsComingThroughDoor(body, doorPos, nearestEntities)) {
   110	                     iterator.remove();
   111	                  } else {
   112	                     block.setOpen(body, level, state, doorPos, false);
   113	                     iterator.remove();
   114	                  }
   115	               }
   116	            }
   117	         }
   118	      }
   119	   }
   120	
   121	   private static boolean areOtherMobsComingThroughDoor(final LivingEntity body, final BlockPos doorPos, final Optional<List<LivingEntity>> nearestEntities) {
   122	      return nearestEntities.isEmpty()
   123	         ? false
   124	         : nearestEntities.get()
   125	            .stream()
   126	            .filter(otherMob -> otherMob.getType() == body.getType())
   127	            .filter(otherMob -> doorPos.closerToCenterThan(otherMob.position(), 2.0))
   128	            .anyMatch(otherMob -> isMobComingThroughDoor(otherMob.getBrain(), doorPos));
   129	   }
   130	
   131	   private static boolean isMobComingThroughDoor(final Brain<?> otherBrain, final BlockPos doorPos) {
   132	      if (!otherBrain.hasMemoryValue(MemoryModuleType.PATH)) {
   133	         return false;
   134	      }
   135	
   136	      Path path = otherBrain.getMemory(MemoryModuleType.PATH).get();
   137	      if (path.isDone()) {
   138	         return false;
   139	      }
   140	
   141	      Node movingFromNode = path.getPreviousNode();
   142	      if (movingFromNode == null) {
   143	         return false;
   144	      }
   145	
   146	      Node movingToNode = path.getNextNode();
   147	      return doorPos.equals(movingFromNode.asBlockPos()) || doorPos.equals(movingToNode.asBlockPos());
   148	   }
   149	
   150	   private static boolean isDoorTooFarAway(final ServerLevel level, final LivingEntity body, final GlobalPos doorGlobalPos) {
   151	      return doorGlobalPos.dimension() != level.dimension() || !doorGlobalPos.pos().closerToCenterThan(body.position(), 3.0);
   152	   }
   153	
   154	   private static Optional<Set<GlobalPos>> rememberDoorToClose(
   155	      final MemoryAccessor<Mu, Set<GlobalPos>> doorsMemory, final Optional<Set<GlobalPos>> doors, final ServerLevel level, final BlockPos doorPos
   156	   ) {
   157	      GlobalPos globalDoorPos = GlobalPos.of(level.dimension(), doorPos);
   158	      return Optional.of(doors.<Set<GlobalPos>>map(set -> {
   159	         set.add(globalDoorPos);
   160	         return set;
   161	      }).orElseGet(() -> {
   162	         Set<GlobalPos> set = Sets.newHashSet(globalDoorPos);
   163	         doorsMemory.set(set);
   164	         return set;
   165	      }));
   166	   }
   167	}


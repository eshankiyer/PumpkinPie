   280	pub struct NoiseBlockStateProviderBase {
   281	    pub seed: i64,
   282	    pub noise: DoublePerlinNoiseParametersCodec,
   283	    pub scale: f32,
   284	}
   285	
   286	impl NoiseBlockStateProviderBase {
   287	    pub fn get_noise(&self, pos: BlockPos) -> f64 {
   288	        let sampler = DoublePerlinNoiseSampler::new(
   289	            &mut RandomGenerator::Legacy(LegacyRand::from_seed(self.seed as u64)),
   290	            self.noise.first_octave,
   291	            &self.noise.amplitudes,
   292	            self.noise.amplitude,
   293	            false,
   294	        );
   295	        sampler.sample(
   296	            pos.0.x as f64 * self.scale as f64,
   297	            pos.0.y as f64 * self.scale as f64,
   298	            pos.0.z as f64 * self.scale as f64,
   299	        )
   300	    }
   301	}
   302	
   303	pub struct NoiseBlockStateProvider {
   304	    pub base: NoiseBlockStateProviderBase,
   305	    pub states: Vec<&'static BlockState>,
   306	}
   307	
   308	impl NoiseBlockStateProvider {
   309	    pub fn get(&self, pos: BlockPos) -> &'static BlockState {
   310	        let value = self.base.get_noise(pos);
   311	        Self::get_state_by_value(&self.states, value)
   312	    }
   313	
   314	    fn get_state_by_value(states: &[&'static BlockState], value: f64) -> &'static BlockState {
   315	        let val = f64::midpoint(1.0, value).clamp(0.0, 0.9999);
   316	        states[(val * states.len() as f64) as usize]
   317	    }
   318	}
   319	
   320	pub struct NoiseThresholdBlockStateProvider {
   321	    pub base: NoiseBlockStateProviderBase,
   322	    pub threshold: f32,
   323	    pub high_chance: f32,
   324	    pub default_state: &'static BlockState,
   325	    pub low_states: Vec<&'static BlockState>,
   326	    pub high_states: Vec<&'static BlockState>,
   327	}
   328	
   329	impl NoiseThresholdBlockStateProvider {
   330	    pub fn get(&self, random: &mut RandomGenerator, pos: BlockPos) -> &'static BlockState {
   331	        let value = self.base.get_noise(pos);
   332	        if value < self.threshold as f64 {
   333	            return self.low_states[random.next_bounded_i32(self.low_states.len() as i32) as usize];
   334	        }
   335	        if random.next_f32() < self.high_chance {
   336	            return self.high_states
   337	                [random.next_bounded_i32(self.high_states.len() as i32) as usize];
   338	        }
   339	        self.default_state
   340	    }
   341	}

   113	                return;
   114	            };
   115	            let Some(banner) = entity.as_any().downcast_ref::<BannerBlockEntity>() else {
   116	                return;
   117	            };
   118	            let Some(color) = block.name.strip_suffix("_banner") else {
   119	                return;
   120	            };
   121	            let decoration_name = format!("banner_{color}");
   122	            let Some(decoration_type) = MapDecorationType::from_name(&decoration_name) else {
   123	                return;
   124	            };
   125	            let display_name = banner

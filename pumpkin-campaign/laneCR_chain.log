    30	
    31	struct ContributorCache {
    32	    fetched_at: Instant,
    33	    data: Vec<Contributor>,
    34	}
    35	
    36	static CONTRIBUTORS_CACHE: LazyLock<Mutex<Option<ContributorCache>>> =
    37	    LazyLock::new(|| Mutex::new(None));
    38	
    39	fn fetch_all_contributors_cached() -> Vec<Contributor> {
    40	    if let Ok(guard) = CONTRIBUTORS_CACHE.lock()
    41	        && let Some(cache) = guard.as_ref()
    42	        && cache.fetched_at.elapsed() < CACHE_DURATION
    43	    {
    44	        return cache.data.clone();
    45	    }
    46	
    47	    let contributors = fetch_all_contributors();
    48	    if !contributors.is_empty() {
    49	        if let Ok(mut guard) = CONTRIBUTORS_CACHE.lock() {
    50	            *guard = Some(ContributorCache {
    51	                fetched_at: Instant::now(),
    52	                data: contributors.clone(),
    53	            });
    54	        }
    55	    } else if let Ok(guard) = CONTRIBUTORS_CACHE.lock()
    56	        && let Some(cache) = guard.as_ref()
    57	    {
    58	        return cache.data.clone();
    59	    }
    60	
    61	    contributors
    62	}
    63	
    64	fn fetch_all_contributors() -> Vec<Contributor> {
    65	    let mut all_contributors = Vec::new();
    66	    let mut next_url = Some(
    67	        "https://api.github.com/repos/eshankiyer/PumpkinPie/contributors?per_page=100".to_string(),
    68	    );
    69	
    70	    while let Some(url) = next_url {
    71	        let response = ureq::get(&url).header("User-Agent", "PumpkinPie").call();
    72	
    73	        match response {
    74	            Ok(mut res) => {
    75	                if let Ok(contributors) = res.body_mut().read_json::<Vec<Contributor>>() {
    76	                    all_contributors.extend(contributors);
    77	                } else {
    78	                    break;
    79	                }
    80	                let link_header = res.headers().get("link").map(|s| s.to_str().unwrap_or(""));
    81	
    82	                next_url = link_header.and_then(extract_next_url);
    83	            }
    84	            Err(_) => break,
    85	        }
    86	    }
    87	
    88	    if all_contributors.is_empty() {
    89	        return vec![];
    90	    }
    91	
    92	    all_contributors
    93	}
    94	
    95	fn extract_next_url(header: &str) -> Option<String> {
    96	    header
    97	        .split(',')
    98	        .find(|part| part.contains("rel=\"next\""))
    99	        .and_then(|part| {
   100	            let start = part.find('<')? + 1;
   101	            let end = part.find('>')?;
   102	            Some(part[start..end].to_string())
   103	        })
   104	}

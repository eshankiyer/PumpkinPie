   120	                } else {
   121	                    Sound::EntityItemFramePlace
   122	                },
   123	                SoundCategory::Blocks,
   124	                &position,
   125	            );
   126	
   127	            if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id) {
   128	                emit_game_event(
   129	                    &world,
   130	                    GameEvent::EntityPlace,
   131	                    position,
   132	                    GameEventContext::of_entity(player_arc),
   133	                )
   134	                .await;
   135	            }
   136	
   137	            world.spawn_entity(Arc::new(frame)).await;

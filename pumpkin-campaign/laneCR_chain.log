   513	    #[test]
   514	    fn set_get_erase_roundtrip() {
   515	        let mut store = MemoryStore::new();
   516	        store.register(MemoryKeyId::LikedNoteblockCooldownTicks);
   517	        assert!(!store.has_value::<LikedNoteblockCooldownTicksMemory>());
   518	        store.set::<LikedNoteblockCooldownTicksMemory>(600);
   519	        assert_eq!(store.get::<LikedNoteblockCooldownTicksMemory>(), Some(&600));
   520	        store.erase::<LikedNoteblockCooldownTicksMemory>();
   521	        assert!(!store.has_value::<LikedNoteblockCooldownTicksMemory>());
   522	    }
   523	
   524	    #[test]

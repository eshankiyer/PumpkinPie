    10	public class EndPlatformFeature extends Feature<NoneFeatureConfiguration> {
    11	   public EndPlatformFeature(final Codec<NoneFeatureConfiguration> codec) {
    12	      super(codec);
    13	   }
    14	
    15	   @Override
    16	   public boolean place(final FeaturePlaceContext<NoneFeatureConfiguration> context) {
    17	      createEndPlatform(context.level(), context.origin(), false);
    18	      return true;
    19	   }
    20	
    21	   public static void createEndPlatform(final ServerLevelAccessor newLevel, final BlockPos origin, final boolean dropResources) {
    22	      BlockPos.MutableBlockPos pos = origin.mutable();
    23	
    24	      for (int dz = -2; dz <= 2; dz++) {
    25	         for (int dx = -2; dx <= 2; dx++) {
    26	            for (int dy = -1; dy < 3; dy++) {
    27	               BlockPos blockPos = pos.set(origin).move(dx, dy, dz);
    28	               Block block = dy == -1 ? Blocks.OBSIDIAN : Blocks.AIR;
    29	               if (!newLevel.getBlockState(blockPos).is(block)) {
    30	                  if (dropResources) {
    31	                     newLevel.destroyBlock(blockPos, true, null);
    32	                  }
    33	
    34	                  newLevel.setBlock(blockPos, block.defaultBlockState(), 3);
    35	               }
    36	            }
    37	         }
    38	      }
    39	   }
    40	}

   119	impl SStatusRequest {
   120	    pub async fn decode(packet: &mut RawQueryPacket) -> Result<Self, DecodeError> {
   121	        let session_id = packet
   122	            .reader
   123	            .read_i32()
   124	            .await
   125	            .map_err(|_| DecodeError::UnexpectedEof)?;
   126	        let challenge_token = packet
   127	            .reader
   128	            .read_i32()
   129	            .await
   130	            .map_err(|_| DecodeError::UnexpectedEof)?;
   131	
   132	        let position = packet.reader.position();
   133	        let total_len = packet.reader.get_ref().len() as u64;
   134	        let remaining = total_len.saturating_sub(position);
   135	
   136	        let is_full_request = match remaining {
   137	            0 => false,
   138	            4 => {
   139	                packet.reader.set_position(position + 4);
   140	                true
   141	            }
   142	            _ => return Err(DecodeError::MalformedPayload),
   143	        };
   144	
   145	        Ok(Self {
   146	            session_id,
   147	            challenge_token,
   148	            is_full_request,
   149	        })
   150	    }
   151	}

    66	      BlockPos pos = this.mob.blockPosition();
    67	
    68	      for (int i = 0; i < 10; i++) {
    69	         BlockPos randomPos = pos.offset(random.nextInt(20) - 10, random.nextInt(6) - 3, random.nextInt(20) - 10);
    70	         if (!this.level.canSeeSky(randomPos) && this.mob.getWalkTargetValue(randomPos) < 0.0F) {
    71	            return Vec3.atBottomCenterOf(randomPos);

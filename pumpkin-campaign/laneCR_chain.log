--- crates/pumpkin/src/net/java/play/chat_command.rs
     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_chat_command(
     6	        &self,
     7	        player: &Arc<Player>,
     8	        server: &Arc<Server>,
     9	        command: &SChatCommand<'_>,
    10	    ) {
    11	        player.update_last_action_time();
    12	        if player.check_chat_spam(server).await {
    13	            return;
    14	        }
    15	        let player_clone = player.clone();
    16	        let server_clone = server.clone();
    17	        let command_str = command.command.strip_prefix('/').unwrap_or(command.command);
    18	        send_cancellable! {{
    19	            server;
    20	            PlayerCommandSendEvent {
    21	                player: player.clone(),
    22	                command: command_str.to_string(),
    23	                cancelled: false
    24	            };
    25	
    26	            'after: {
    27	                let command = event.command;
    28	                let command_clone = command.clone();
    29	                // Some commands can take a long time to execute. If they do, they block packet processing for the player.
    30	                // That's why we will spawn a task instead.
    31	                server.spawn_task(async move {
    32	                    let dispatcher = server_clone.command_dispatcher.load();
    33	                    dispatcher.handle_command(
    34	                        &player_clone.get_command_source(&server_clone).await,
    35	                        &command_clone
    36	                    ).await;
    37	                });
    38	
    39	                if server.advanced_config.commands.log_console {
    40	                    info!(
    41	                        "Player ({}): executed command /{}",
    42	                        player.gameprofile.name,
    43	                        command
    44	                    );
    45	                }
    46	            }
    47	        }}
    48	    }
    49	}
--- crates/pumpkin/src/net/java/play/edit_book.rs
     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_edit_book(&self, player: &Player, packet: SEditBook<'_>) {
     6	        let held_stack = player.inventory().held_item().await;
     7	        if held_stack.item.id != Item::WRITABLE_BOOK.id {
     8	            return;
     9	        }
    10	
    11	        let pages: Vec<String> = packet.pages.iter().map(|p| (*p).to_string()).collect();
    12	
    13	        if let Some(title) = packet.title {
    14	            let mut written_book = ItemStack::new(1, &Item::WRITTEN_BOOK);
    15	            let content = WrittenBookContentImpl {
    16	                title: title.to_string(),
    17	                author: player.gameprofile.name.clone(),
    18	                pages,
    19	                generation: 0,
    20	            };
    21	            written_book
    22	                .patch
    23	                .push((DataComponent::WrittenBookContent, Some(content.to_dyn())));
    24	            player.inventory().set_held_item(written_book).await;
    25	        } else {
    26	            let mut writable_book = held_stack;
    27	            let content = WritableBookContentImpl { pages };
    28	            writable_book
    29	                .patch
    30	                .retain(|(component, _)| *component != DataComponent::WritableBookContent);
    31	            writable_book
    32	                .patch
    33	                .push((DataComponent::WritableBookContent, Some(content.to_dyn())));
    34	            player.inventory().set_held_item(writable_book).await;
    35	        }
    36	    }
    37	}
--- crates/pumpkin/src/net/java/play/interact.rs
     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    #[expect(clippy::too_many_lines)]
     6	    pub async fn handle_interact(
     7	        &self,
     8	        player: &Arc<Player>,
     9	        interact: SInteract,
    10	        server: &Arc<Server>,
    11	    ) {
    12	        if !player.has_client_loaded() {
    13	            return;
    14	        }
    15	        player.update_last_action_time();
    16	        let entity_id = interact.entity_id;
    17	
    18	        let sneaking = interact.sneaking;
    19	        let player_entity = &player.get_entity();
    20	        if player_entity.is_sneaking() != sneaking {
    21	            player_entity.set_sneaking(sneaking).await;
    22	        }
    23	        let Ok(action) = ActionType::try_from(interact.r#type.0) else {
    24	            self.kick(TextComponent::text("Invalid action type")).await;
    25	            return;
    26	        };
    27	
    28	        // Resolve the target entity for the event
    29	        let world = player_entity.world.load_full();
    30	        let player_target = world.get_player_by_id(entity_id.0);
    31	        let target: Option<Arc<dyn EntityBase>> = player_target
    32	            .as_ref()
    33	            .map(|p| Arc::clone(p) as Arc<dyn EntityBase>)
    34	            .or_else(|| world.get_entity_by_id(entity_id.0));
    35	
    36	        if let Some(target) = target {
    37	            // `ServerGamePacketListenerImpl.handleInteract` (`ServerGamePacketListenerImpl.java:
    38	            // 1837-1840`) rejects an entity interaction outside the player's interaction range
    39	            // before dispatching either spectator camera selection or the interaction event.
    40	            if target.get_entity().is_removed()
    41	                || !player.is_within_entity_interaction_range(
    42	                    target.get_entity().bounding_box.load(),
    43	                    3.0,
    44	                )
    45	            {
    46	                return;
    47	            }
    48	
    49	            if player.gamemode.load() == GameMode::Spectator {
    50	                player.camera_target_id.store(Some(entity_id.0));
    51	                player.send_client_packet(&CSetCamera::new(entity_id)).await;
    52	                return;
    53	            }
    54	            send_cancellable! {{
    55	                server;
    56	                PlayerInteractEntityEvent::new(
    57	                    player,
    58	                    Arc::clone(&target),
    59	                    action,
    60	                    interact.target_position,
    61	                    sneaking,
    62	                );
    63	
    64	                'after: {
    65	                    match event.action {
    66	                        ActionType::Attack => {
    67	                            let config = &server.advanced_config.pvp;
    68	                            if entity_id.0 == player.entity_id() {
    69	                                self.kick(TextComponent::translate_cross(translation::java::MULTIPLAYER_DISCONNECT_INVALID_ENTITY_ATTACKED, translation::java::MULTIPLAYER_DISCONNECT_INVALID_ENTITY_ATTACKED, [],))
    70	                                .await;
    71	                                return;
    72	                            }
    73	
    74	                            let main_hand = player.inventory().held_item().await;
    75	                            // `Player.isWithinAttackRange` uses the held weapon's attack range
    76	                            // for attack interactions (`Player.java:2010-2012`).
    77	                            if !player.is_within_attack_range(
    78	                                &main_hand,
    79	                                event.target.get_entity().bounding_box.load(),
    80	                                ATTACK_PACKET_RANGE_BUFFER,
    81	                            ) {
    82	                                return;
    83	                            }
    84	
    85	                            if !pvp_allows_attack(config.enabled, player_target.is_some()) {
    86	                                return;
    87	                            }
    88	
    89	                            if let Some(player_victim) = &player_target {
    90	                                if player_victim.living_entity.health.load() <= 0.0 {
    91	                                    return;
    92	                                }
    93	                                if config.protect_creative
    94	                                    && player_victim.gamemode.load() == GameMode::Creative
    95	                                {
    96	                                    world
    97	                                        .play_sound(
    98	                                            Sound::EntityPlayerAttackNodamage,
    99	                                            SoundCategory::Players,
   100	                                            &player_victim.position(),
   101	                                        )
   102	                                        ;
   103	                                    return;
   104	                                }
   105	                            }
   106	                            player.attack(event.target).await;
   107	                        }
   108	                        ActionType::Interact | ActionType::InteractAt => {
   109	                            if event.action == ActionType::InteractAt
   110	                                && let Some(pos) = interact.target_position
   111	                            {
   112	                                let mut at_event = crate::plugin::api::events::player::player_interact_at_entity::PlayerInteractAtEntityEvent::new(
   113	                                    player.clone(),
   114	                                    entity_id.0,
   115	                                    pos.x,
   116	                                    pos.y,
   117	                                    pos.z,
   118	                                    u8::from(interact.hand.map_or(0, |h| h.0) != 0),
   119	                                );
   120	                                server.plugin_manager.fire(server, &mut at_event).await;
   121	                                if at_event.cancelled {
   122	                                    return;
   123	                                }
   124	                            }
   125	                            let mut stack = player.inventory().held_item().await;
   126	                            let original_stack = stack.clone();
   127	                            let creative = player.gamemode.load() == GameMode::Creative;
   128	                            // CuredZombieVillager fires when conversion actually completes
   129	                            // (ZombieVillagerEntity::finish_conversion), gated on the zombie
   130	                            // villager having Weakness -- not immediately on this click,
   131	                            // regardless of whether curing even started.
   132	                            let target_entity = event.target.get_entity();
   133	                            if target_entity.entity_type.resource_name == "zombie_villager"
   134	                                && stack.item.registry_key == "golden_apple"
   135	                            {
   136	                                player.trigger_advancement(crate::entity::player::advancement::trigger::AdvancementTrigger::CuredZombieVillager).await;
   137	                            }
   138	
   139	                            let interacted = event.target.interact(player, &mut stack).await;
   140	                            if interacted {
   141	                                if creative {
   142	                                    // `Player.interactOn` restores a creative stack's count
   143	                                    // after a consuming entity interaction (`Player.java:832-840`).
   144	                                    crate::entity::player::restore_creative_interaction_count(
   145	                                        &mut stack,
   146	                                        original_stack.item_count,

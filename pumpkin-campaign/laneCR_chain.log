   795	    fn get<'a>(props: &'a [(&'static str, &'static str)], key: &str) -> &'a str {
   796	        props
   797	            .iter()
   798	            .find(|(k, _)| *k == key)
   799	            .map(|(_, v)| *v)
   800	            .unwrap_or_else(|| panic!("missing property {key}"))

   143	                        random,
   144	                        pools,
   145	                        centerPiece,
   146	                        pieces,
   147	                        shape,
   148	                        poolAliasLookup,
   149	                        liquidSettings
   150	                     );
   151	                     pieces.forEach(builder::addPiece);
   152	                  }
   153	               }
   154	            )
   155	         );
   156	      }
   157	   }

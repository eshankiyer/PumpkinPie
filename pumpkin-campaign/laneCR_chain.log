    33	    /// Returns the context-dependent collision pieces from
    34	    /// `ScaffoldingBlock.getCollisionShape` (`ScaffoldingBlock.java:137-145`). The generated
    35	    /// stable pieces already contain `SHAPE_STABLE`; the lower slab is the additional piece in
    36	    /// `SHAPE_UNSTABLE_BOTTOM`.
    37	    pub(crate) fn collision_shapes_for_context(
    38	        state_id: BlockStateId,
    39	        above_block: bool,
    40	        above_below_block: bool,
    41	        descending: bool,
    42	    ) -> Vec<BoundingBox> {
    43	        let state = pumpkin_data::BlockState::from_id(state_id);
    44	        let props = ScaffoldingLikeProperties::from_state_id(state_id, &Block::SCAFFOLDING);
    45	
    46	        if above_block && !descending {
    47	            return state.get_block_collision_shapes().collect();
    48	        }
    49	
    50	        if props.r#distance != 0 && props.r#bottom && above_below_block {
    51	            return vec![BoundingBox::new_array([0.0, 0.0, 0.0], [1.0, 0.125, 1.0])];
    52	        }
    53	
    54	        Vec::new()
    55	    }

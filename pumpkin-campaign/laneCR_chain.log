   115	impl BlockBehaviour for SpongeBlock {
   116	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   117	        Box::pin(async move {
   118	            // Attempt to absorb water on placement
   119	            Self::absorb_water(args.world, args.position).await;
   120	        })
   121	    }
   122	
   123	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
   124	        Box::pin(async move {
   125	            // Vanilla's `neighborChanged` always retries the absorb BFS, since it's the
   126	            // traversal itself (now fluid-tag based) that determines whether there's
   127	            // water nearby, not the identity of whatever neighbor changed.
   128	            Self::absorb_water(args.world, args.position).await;
   129	        })
   130	    }
   131	}

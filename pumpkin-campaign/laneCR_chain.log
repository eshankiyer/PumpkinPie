     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_client_information_config(
     6	        &self,
     7	        client_information: SClientInformationConfig<'_>,
     8	    ) {
     9	        debug!("Handling client settings");
    10	        if client_information.view_distance <= 0 {
    11	            self.kick(TextComponent::text(
    12	                "Cannot have zero or negative view distance!",
    13	            ))
    14	            .await;
    15	            return;
    16	        }
    17	
    18	        if let (Ok(main_hand), Ok(chat_mode)) = (
    19	            Hand::try_from(client_information.main_hand.0),
    20	            ChatMode::try_from(client_information.chat_mode.0),
    21	        ) {
    22	            self.config.store(Arc::new(PlayerConfig {
    23	                locale: client_information.locale.to_string(),
    24	                // client_information.view_distance was checked above to be > 0 so compiler should optimize this out.
    25	                view_distance: NonZero::new(client_information.view_distance as u8)
    26	                    .unwrap_or(NonZero::<u8>::MIN),
    27	                chat_mode,
    28	                chat_colors: client_information.chat_colors,
    29	                skin_parts: client_information.skin_parts,
    30	                main_hand,
    31	                text_filtering: client_information.text_filtering,
    32	                server_listing: client_information.server_listing,
    33	            }));
    34	        } else {
    35	            self.kick(TextComponent::text("Invalid hand or chat type"))
    36	                .await;
    37	        }
    38	    }
    39	}

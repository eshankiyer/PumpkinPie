    89	impl CommandExecutor for LootExecutor {
    90	    #[allow(clippy::too_many_lines)]
    91	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    92	        Box::pin(async move {
    93	            let mut stacks = Vec::new();
    94	
    95	            match self.source {
    96	                Source::Loot => {
    97	                    let loot_table_str = StringArgumentType::get(context, "loot_table")?;
    98	                    let formatted_key = if loot_table_str.contains(':') {
    99	                        loot_table_str.to_string()
   100	                    } else {
   101	                        format!("minecraft:{loot_table_str}")
   102	                    };
   103	
   104	                    let chest_table =
   105	                        pumpkin_data::chest_loot_table::get_chest_loot_table(&formatted_key);
   106	                    if let Some(table) = chest_table {
   107	                        let seed: i64 = rand::random();
   108	                        stacks = crate::world::loot::generate_chest_loot(table, seed);
   109	                    } else {
   110	                        return Err(ERROR_INVALID_LOOT_TABLE.create_without_context(
   111	                            TextComponent::text(loot_table_str.to_string()),
   112	                        ));
   113	                    }
   114	                }
   115	                Source::Kill => {
   116	                    let target_entities =
   117	                        EntityArgumentType::get_entities(context, "target_entity").await?;
   118	                    let mut has_loot = false;
   119	                    for entity in target_entities {
   120	                        if let Some(loot_table) = &entity.get_entity().entity_type.loot_table {
   121	                            has_loot = true;
   122	                            let params = crate::world::loot::LootContextParameters {
   123	                                world_time: context.world().level_info.load().day_time as u64,
   124	                                // `LootContext.Builder.create` resolves named sequences with the
   125	                                // world seed (`LootContext.java:138-142`; `MinecraftServer.java:1766-1767`).
   126	                                world_seed: context.world().level.seed.0,
   127	                                ..Default::default()
   128	                            };
   129	                            stacks.extend(loot_table.get_loot(params));
   130	                        }
   131	                    }
   132	                    if !has_loot {
   133	                        let entity_name = "selected entity".to_string();
   134	                        return Err(ERROR_ENTITY_NO_LOOT_TABLE
   135	                            .create_without_context(TextComponent::text(entity_name)));
   136	                    }
   137	                }
   138	                Source::Mine { has_tool } => {
   139	                    let pos = BlockPosArgumentType::get_block_pos(context, "mine_pos")
   140	                        .or_else(|_| BlockPosArgumentType::get_block_pos(context, "pos"))?;
   141	                    let world = context.world();
   142	                    let block = world.get_block(&pos);
   143	
   144	                    if let Some(loot_table) = &block.loot_table {
   145	                        let tool_item = if has_tool {
   146	                            let tool_str = StringArgumentType::get(context, "tool")?;
   147	                            let key = tool_str.strip_prefix("minecraft:").unwrap_or(tool_str);
   148	                            pumpkin_data::item::Item::from_registry_key(key)
   149	                        } else {
   150	                            None
   151	                        };
   152	
   153	                        let tool_stack =
   154	                            tool_item.map(|item| pumpkin_data::item_stack::ItemStack::new(1, item));
   155	
   156	                        let params = crate::world::loot::LootContextParameters {
   157	                            block_state: Some(world.get_block_state(&pos)),
   158	                            tool: tool_stack,
   159	                            world_time: world.level_info.load().day_time as u64,
   160	                            // `LootContext.Builder.create` resolves named sequences with the
   161	                            // world seed (`LootContext.java:138-142`; `MinecraftServer.java:1766-1767`).
   162	                            world_seed: world.level.seed.0,
   163	                            ..Default::default()
   164	                        };
   165	
   166	                        stacks.extend(loot_table.get_loot(params));
   167	                    }
   168	                }
   169	            }
   170	
   171	            let total_items: i32 = stacks.iter().map(|s| s.item_count as i32).sum();
   172	
   173	            match self.target {
   174	                Target::Give => {
   175	                    let targets = EntityArgumentType::get_players(context, "targets").await?;
   176	                    for player in &targets {
   177	                        for stack in &stacks {
   178	                            let mut remaining = stack.clone();
   179	                            player.inventory.insert_stack_anywhere(&mut remaining).await;
   180	                            if !remaining.is_empty() {
   181	                                player.drop_item(remaining).await;
   182	                            }
   183	                        }
   184	                    }
   185	                }
   186	                Target::Spawn => {
   187	                    let pos = BlockPosArgumentType::get_block_pos(context, "pos")?;
   188	                    let world = context.world();
   189	                    for stack in stacks {
   190	                        world.drop_stack(&pos, stack).await;
   191	                    }
   192	                }
   193	                Target::Insert => {
   194	                    let pos = BlockPosArgumentType::get_block_pos(context, "pos")?;
   195	                    let world = context.world();
   196	                    if let Some(block_entity) = world.get_block_entity(&pos) {
   197	                        if let Some(inventory) = block_entity.get_inventory() {
   198	                            for stack in stacks {
   199	                                let remaining =
   200	                                    insert_into_inventory(inventory.as_ref(), stack).await;
   201	                                if !remaining.is_empty() {
   202	                                    world.drop_stack(&pos, remaining).await;
   203	                                }
   204	                            }
   205	                        } else {
   206	                            return Err(ERROR_NO_CONTAINER
   207	                                .create_without_context(TextComponent::text(pos.to_string())));
   208	                        }
   209	                    } else {
   210	                        return Err(ERROR_NO_CONTAINER
   211	                            .create_without_context(TextComponent::text(pos.to_string())));
   212	                    }
   213	                }
   214	            }
   215	
   216	            let msg = TextComponent::translate_cross(
   217	                translation::bedrock::COMMANDS_LOOT_SUCCESS,
   218	                translation::bedrock::COMMANDS_LOOT_SUCCESS,
   219	                [TextComponent::text(total_items.to_string())],
   220	            );
   221	            context.source.send_feedback(msg, true).await;
   222	
   223	            Ok(total_items)
   224	        })
   225	    }
   226	}

     1	use std::sync::Arc;
     2	use std::sync::atomic::AtomicBool;
     3	
     4	use crate::{
     5	    entity::{
     6	        Entity, EntityBase, EntityBaseFuture, NBTStorage,
     7	        projectile::{ProjectileHit, ThrownItemEntity},
     8	    },
     9	    server::Server,
    10	};
    11	
    12	const GRAVITY: f64 = 0.0;
    13	
    14	pub struct SmallFireballEntity {
    15	    pub thrown: ThrownItemEntity,
    16	}
    17	
    18	impl SmallFireballEntity {
    19	    #[must_use]
    20	    pub const fn new(entity: Entity) -> Self {
    21	        let thrown = ThrownItemEntity {
    22	            entity,
    23	            owner_id: None,
    24	            collides_with_projectiles: false,
    25	            has_hit: AtomicBool::new(false),
    26	            gravity: GRAVITY,
    27	        };
    28	
    29	        Self { thrown }
    30	    }
    31	
    32	    #[must_use]
    33	    pub fn new_shot(entity: Entity, shooter: &Entity) -> Self {
    34	        let thrown = ThrownItemEntity::new(entity, shooter, GRAVITY);
    35	        Self { thrown }
    36	    }
    37	}
    38	
    39	impl NBTStorage for SmallFireballEntity {}
    40	
    41	impl EntityBase for SmallFireballEntity {
    42	    fn tick<'a>(
    43	        &'a self,
    44	        caller: &'a Arc<dyn EntityBase>,
    45	        server: &'a Server,
    46	    ) -> EntityBaseFuture<'a, ()> {
    47	        Box::pin(async move { self.thrown.process_tick(caller, server).await })
    48	    }
    49	
    50	    fn get_entity(&self) -> &Entity {
    51	        self.thrown.get_entity()
    52	    }
    53	
    54	    fn get_living_entity(&self) -> Option<&crate::entity::living::LivingEntity> {
    55	        None
    56	    }
    57	
    58	    fn as_nbt_storage(&self) -> &dyn NBTStorage {
    59	        self
    60	    }
    61	
    62	    fn cast_any(&self) -> &dyn std::any::Any {
    63	        self
    64	    }
    65	
    66	    fn on_hit(&self, hit: ProjectileHit) -> EntityBaseFuture<'_, ()> {
    67	        Box::pin(async move {
    68	            match hit {
    69	                ProjectileHit::Entity { ref entity, .. } => {
    70	                    use std::sync::atomic::Ordering;
    71	
    72	                    let target = entity.get_entity();
    73	                    let remaining_fire_ticks = target.fire_ticks.load(Ordering::Relaxed);
    74	                    target.set_on_fire_for(5.0);
    75	                    let hurt = entity
    76	                        .damage(self, 5.0, pumpkin_data::damage::DamageType::FIREBALL)
    77	                        .await;
    78	                    if !hurt {
    79	                        target
    80	                            .fire_ticks
    81	                            .store(remaining_fire_ticks, Ordering::Relaxed);
    82	                    }
    83	                }
    84	                ProjectileHit::Block { pos, face, .. } => {
    85	                    let world = self.get_entity().world.load();
    86	
    87	                    let owner = self
    88	                        .thrown
    89	                        .owner_id
    90	                        .and_then(|id| world.get_entity_by_id(id));
    91	                    let owner_is_mob = owner.is_some_and(|owner| owner.get_player().is_none());
    92	                    let mob_griefing = world.level_info.load().game_rules.mob_griefing;
    93	
    94	                    if !owner_is_mob || mob_griefing {
    95	                        let block_to_place = match face {
    96	                            pumpkin_data::BlockDirection::Up => pos.up(),
    97	                            pumpkin_data::BlockDirection::Down => pos.down(),
    98	                            pumpkin_data::BlockDirection::North => pos.north(),
    99	                            pumpkin_data::BlockDirection::South => pos.south(),
   100	                            pumpkin_data::BlockDirection::West => pos.west(),
   101	                            pumpkin_data::BlockDirection::East => pos.east(),
   102	                        };
   103	                        if world
   104	                            .get_block_state_if_loaded(&block_to_place)
   105	                            .is_some_and(pumpkin_data::BlockState::is_air)
   106	                        {
   107	                            // `SmallFireball#onHitBlock` (SmallFireball.java:58) places
   108	                            // `BaseFireBlock.getState(level, pos)`, which yields SOUL_FIRE
   109	                            // when the block below can host soul fire
   110	                            // (BaseFireBlock.java:45-48).
   111	                            let fire_state =
   112	                                crate::block::blocks::fire::FireBlockBase::get_fire_type(
   113	                                    &world,
   114	                                    &block_to_place,
   115	                                )
   116	                                .default_state
   117	                                .id;
   118	                            world
   119	                                .set_block_state(
   120	                                    &block_to_place,
   121	                                    fire_state,
   122	                                    pumpkin_world::world::BlockFlags::NOTIFY_ALL,
   123	                                )
   124	                                .await;
   125	                        }
   126	                    }
   127	                }
   128	            }
   129	            self.get_entity().remove().await;
   130	        })
   131	    }
   132	}


    70	/// `WallSkullBlock`: the wall-mounted skull variants.
    71	///
    72	/// They share `AbstractSkullBlock`'s block entity and redstone-powered state with the floor
    73	/// skulls, but carry `facing` where those carry `rotation` (WallSkullBlock.java:22), so they
    74	/// cannot simply join `SkullBlock`'s id list.
    75	pub struct WallSkullBlock;
    76	
    77	impl BlockMetadata for WallSkullBlock {
    78	    fn ids() -> Box<[BlockId]> {
    79	        [
    80	            BlockId::SKELETON_WALL_SKULL,
    81	            BlockId::PLAYER_WALL_HEAD,
    82	            BlockId::ZOMBIE_WALL_HEAD,
    83	            BlockId::CREEPER_WALL_HEAD,
    84	            BlockId::PIGLIN_WALL_HEAD,
    85	            BlockId::DRAGON_WALL_HEAD,
    86	        ]
    87	        .into()
    88	    }
    89	}
    90	
    91	impl BlockBehaviour for WallSkullBlock {
    92	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    93	        Box::pin(async move {
    94	            let entity = SkullBlockEntity::new(*args.position);
    95	            args.world.add_block_entity(Arc::new(entity));
    96	        })
    97	    }
    98	
    99	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   100	        Box::pin(async move {
   101	            let mut props = SkeletonWallSkullLikeProperties::default(args.block);
   102	            // `WallSkullBlock.getStateForPlacement` faces away from the wall it is placed on.
   103	            props.facing = args
   104	                .direction
   105	                .to_horizontal_facing()
   106	                .unwrap_or(HorizontalFacing::North);
   107	            props.powered = block_receives_redstone_power(args.world, args.position).await;
   108	            props.to_state_id(args.block)
   109	        })
   110	    }
   111	
   112	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
   113	        Box::pin(async move {
   114	            let state = args.world.get_block_state(args.position);
   115	            let mut props = SkeletonWallSkullLikeProperties::from_state_id(state.id, args.block);
   116	            let is_receiving_power = block_receives_redstone_power(args.world, args.position).await;
   117	            if props.powered != is_receiving_power {
   118	                props.powered = is_receiving_power;
   119	                args.world
   120	                    .set_block_state(
   121	                        args.position,
   122	                        props.to_state_id(args.block),
   123	                        BlockFlags::NOTIFY_LISTENERS,
   124	                    )
   125	                    .await;
   126	            }
   127	        })
   128	    }
   129	}

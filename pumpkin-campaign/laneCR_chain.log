   475	// ActionResult.java
   476	#[derive(Debug, PartialEq, Eq)]
   477	pub enum BlockActionResult {
   478	    /// Action was successful | Same as SUCCESS in vanilla
   479	    Success,
   480	    /// Action was successful and we should swing the hand for the server | Same as `SUCCESS_SERVER` in vanilla
   481	    SuccessServer,
   482	    /// Block other actions from being executed | Same as CONSUME in vanilla
   483	    Consume,
   484	    /// Allow other actions to be executed, but indicate it failed | Same as FAIL in vanilla
   485	    Fail,
   486	    /// Allow other actions to be executed | Same as PASS in vanilla
   487	    Pass,
   488	    /// Use default action for the block: `normal_use` | Same as `PASS_TO_DEFAULT_BLOCK_ACTION` in vanilla
   489	    PassToDefaultBlockAction,
   490	}
   491	
   492	impl BlockActionResult {
   493	    #[must_use]
   494	    pub const fn consumes_action(&self) -> bool {
   495	        matches!(self, Self::Consume | Self::Success | Self::SuccessServer)
   496	    }
   497	}

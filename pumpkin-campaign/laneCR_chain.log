   347	    use super::*;
   348	
   349	    #[test]
   350	    fn direction_within_radians_stays_in_the_axis_aligned_box() {
   351	        let mut rng = rand::rng();
   352	        for _ in 0..2000 {
   353	            if let Some(direction) = generate_random_direction_within_radians(
   354	                &mut rng,
   355	                0.0,
   356	                10.0,
   357	                7,
   358	                1.0,
   359	                0.0,
   360	                std::f64::consts::FRAC_PI_2,
   361	            ) {
   362	                assert!(direction.x.abs() <= 10, "x={}", direction.x);
   363	                assert!(direction.z.abs() <= 10, "z={}", direction.z);
   364	                assert!(direction.y.abs() <= 7, "y={}", direction.y);
   365	            }
   366	        }
   367	    }
   368	
   369	    #[test]
   370	    fn direction_within_radians_respects_the_cone() {
   371	        // Pointing at +X with a PI/2 half-cone: every accepted sample must have a
   372	        // non-negative X component, since the sampled angle stays within +/-PI/2 of the
   373	        // direction. Guards the `-PI/2` phase shift in `RandomPos.java:35`, which is easy
   374	        // to drop and silently sends the mob sideways.
   375	        let mut rng = rand::rng();
   376	        let mut accepted = 0;
   377	        for _ in 0..2000 {
   378	            if let Some(direction) = generate_random_direction_within_radians(
   379	                &mut rng,
   380	                0.0,
   381	                10.0,
   382	                7,
   383	                1.0,
   384	                0.0,
   385	                std::f64::consts::FRAC_PI_2,
   386	            ) {
   387	                accepted += 1;
   388	                assert!(direction.x >= -1, "x={}", direction.x);
   389	            }
   390	        }
   391	        assert!(accepted > 0);
   392	    }
   393	
   394	    #[test]
   395	    fn plain_direction_is_bounded() {
   396	        let mut rng = rand::rng();
   397	        for _ in 0..500 {
   398	            let direction = generate_random_direction(&mut rng, 10, 7);
   399	            assert!(direction.x.abs() <= 10);
   400	            assert!(direction.y.abs() <= 7);
   401	            assert!(direction.z.abs() <= 10);
   402	        }
   403	    }
   404	}


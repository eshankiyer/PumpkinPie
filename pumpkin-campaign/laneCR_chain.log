   154	
   155	impl ItemBehaviour for SplashPotionItem {
   156	    fn normal_use<'a>(
   157	        &'a self,
   158	        _item: &'a Item,
   159	        player: &'a Player,
   160	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   161	        Box::pin(async move {
   162	            let position = player.position();
   163	            let world = player.world();
   164	            // Vanilla `SplashPotionItem.use` plays this sound before delegating to
   165	            // `ThrowablePotionItem.use` (`SplashPotionItem.java:21-32`).
   166	            world.play_sound_fine(
   167	                pumpkin_data::sound::Sound::EntitySplashPotionThrow,
   168	                pumpkin_data::sound::SoundCategory::Players,
   169	                &position,
   170	                0.5,
   171	                super::throw_sound_pitch(rand::random()),
   172	            );
   173	            let entity = Entity::new(world.clone(), position, &EntityType::SPLASH_POTION);
   174	            let splash = SplashPotionEntity::new_shot(entity, player.get_entity());
   175	
   176	            // Copy the held item stack data into the projectile
   177	            let main_s = player.inventory.held_item().await;
   178	            let mut used_main = true;
   179	            let mut stack = (!main_s.is_empty()
   180	                && main_s.item.id == pumpkin_data::item::Item::SPLASH_POTION.id)
   181	                .then_some(main_s);
   182	            if stack.is_none() {
   183	                let off_s = player.inventory.off_hand_item().await;
   184	                if !off_s.is_empty() && off_s.item.id == pumpkin_data::item::Item::SPLASH_POTION.id
   185	                {
   186	                    stack = Some(off_s);
   187	                    used_main = false;
   188	                }
   189	            }
   190	            let stack = stack.unwrap_or_else(|| ItemStack::EMPTY.clone());
   191	            splash.set_item_stack(stack).await;
   192	
   193	            let (yaw, pitch) = player.rotation();
   194	            splash
   195	                .thrown
   196	                .set_velocity_from(player.get_entity(), pitch, yaw, Y_OFFSET, POWER, 1.0);
   197	
   198	            world.spawn_entity(Arc::new(splash)).await;
   199	
   200	            // Decrement the used stack (clear)
   201	            if used_main {
   202	                let mut s = player.inventory.held_item().await;
   203	                s.decrement_unless_creative(player.gamemode.load(), 1);
   204	                player.inventory.set_held_item(s).await;
   205	            } else {
   206	                let mut s = player.inventory.off_hand_item().await;
   207	                s.decrement_unless_creative(player.gamemode.load(), 1);
   208	                player
   209	                    .inventory
   210	                    .set_stack_in_hand(pumpkin_util::Hand::Left, s)
   211	                    .await;
   212	            }
   213	
   214	            // `ThrowablePotionItem.use` awards ITEM_USED after spawning and consuming
   215	            // (`ThrowablePotionItem.java:23-31`).
   216	            player
   217	                .increment_stat(StatisticCategory::Used, Item::SPLASH_POTION.id as i32, 1)
   218	                .await;
   219	        })
   220	    }
   221	
   222	    fn as_any(&self) -> &dyn std::any::Any {
   223	        self
   224	    }
   225	}

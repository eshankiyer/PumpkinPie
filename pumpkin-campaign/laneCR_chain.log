    40	   @Override
    41	   public BlockState getStateForPlacement(final BlockPlaceContext context) {
    42	      BlockState state = super.getStateForPlacement(context);
    43	      BlockGetter level = context.getLevel();
    44	      BlockPos pos = context.getClickedPos();
    45	      Direction[] directions = context.getNearestLookingDirections();
    46	
    47	      for (Direction direction : directions) {
    48	         if (direction.getAxis().isHorizontal()) {
    49	            Direction facing = direction.getOpposite();
    50	            state = state.setValue(FACING, facing);
    51	            if (!level.getBlockState(pos.relative(direction)).canBeReplaced(context)) {
    52	               return state;
    53	            }
    54	         }
    55	      }
    56	
    57	      return null;
    58	   }

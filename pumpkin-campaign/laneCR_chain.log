   276	pub fn register(dispatcher: &mut CommandDispatcher, registry: &PermissionRegistry) {
   277	    registry.register_permission_or_panic(Permission::new(
   278	        PERMISSION,
   279	        DESCRIPTION,
   280	        PermissionDefault::Allow,
   281	    ));
   282	
   283	    dispatcher.register(
   284	        command("trigger", DESCRIPTION).requires(PERMISSION).then(
   285	            argument(ARG_OBJECTIVE, ObjectiveArgumentType)
   286	                .suggests(TriggerObjectiveSuggestionProvider)
   287	                .executes(SimpleTriggerExecutor)
   288	                .then(literal("add").then(
   289	                    argument(ARG_VALUE, IntegerArgumentType::any()).executes(AddTriggerExecutor),
   290	                ))
   291	                .then(literal("set").then(
   292	                    argument(ARG_VALUE, IntegerArgumentType::any()).executes(SetTriggerExecutor),
   293	                )),
   294	        ),
   295	    );
   296	}
   220	    pub fn is_visible_by(&self) -> bool {
   221	        match self {
   222	            Self::Block { .. } => true,
   223	            Self::Entity { entity, .. } => entity
   224	                .upgrade()
   225	                .is_some_and(|entity| entity.get_entity().is_alive()),
   226	        }
   227	    }
   228	}

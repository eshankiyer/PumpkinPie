   620	    /// Ports `DoubleHighBlockItem.placeBlock` (`DoubleHighBlockItem.java:16-21`) for the
   621	    /// server's generic block-item placement path. Vanilla writes water back to the upper
   622	    /// position when it was water and otherwise clears the replaceable position to air before
   623	    /// placing the lower half. `TallPlantBlock::placed` then installs the upper half.
   624	    async fn prepare_double_high_block_placement(
   625	        world: &Arc<World>,
   626	        block: &Block,
   627	        position: &BlockPos,
   628	    ) {
   629	        if !TallPlantBlock::ids().contains(&block.id) {
   630	            return;
   631	        }
   632	
   633	        let above = position.up();
   634	        let (above_block, above_state) = world.get_block_and_state(&above);
   635	        if !above_state.replaceable() {
   636	            return;
   637	        }
   638	
   639	        let replacement = if above_block == &Block::WATER {
   640	            Block::WATER.default_state.id
   641	        } else {
   642	            Block::AIR.default_state.id
   643	        };
   644	        world
   645	            .set_block_state(&above, replacement, BlockFlags::NOTIFY_ALL)
   646	            .await;
   647	    }

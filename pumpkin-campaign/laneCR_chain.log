   315	    /// Selects the appropriate hanging sign variant.
   316	    fn select_hanging_variant(args: &OnPlaceArgs, support: &SupportInfo) -> Option<BlockId> {
   317	        if args.direction == BlockDirection::Down && support.above_is_valid {
   318	            Some(args.block.id) // Ceiling hanging
   319	        } else if (args.direction.is_horizontal() || args.direction == BlockDirection::Up)
   320	            && support.side_direction.is_some()
   321	        {
   322	            Some(get_sign_variant(args.block, true)) // Wall-hanging with post
   323	        } else if support.above_is_valid {
   324	            Some(args.block.id)
   325	        } else {
   326	            None // No valid placement
   327	        }
   328	    }
   329	
   330	    /// Selects the appropriate standing sign variant.
   331	    fn select_standing_variant(args: &OnPlaceArgs, support: &SupportInfo) -> BlockId {
   332	        if args.direction.is_horizontal() && support.side_direction.is_some() {
   333	            get_sign_variant(args.block, false) // Wall sign
   334	        } else {

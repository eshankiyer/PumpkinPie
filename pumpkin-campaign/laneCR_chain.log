   157	        let (send, recv) = tokio::sync::mpsc::channel(4096);
   158	        let (priority_send, priority_recv) = tokio::sync::mpsc::channel(4096);
   159	
   160	        Self {
   161	            id: pending.id,
   162	            gameprofile,
   163	            config: ArcSwap::from_pointee(config),
   164	            server_address: pending.server_address,
   165	            address: pending.address,

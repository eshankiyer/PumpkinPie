   120	         return Optional.of(
   121	            new Structure.GenerationStub(
   122	               new BlockPos(centerX, centerY, centerZ),
   123	               builder -> {
   124	                  List<PoolElementStructurePiece> pieces = Lists.newArrayList();
   125	                  pieces.add(centerPiece);
   126	                  if (maxDepth > 0) {
   127	                     AABB aabb = new AABB(
   128	                        centerX - maxDistanceFromCenter.horizontal(),
   129	                        Math.max(centerY - maxDistanceFromCenter.vertical(), heightAccessor.getMinY() + dimensionPadding.bottom()),
   130	                        centerZ - maxDistanceFromCenter.horizontal(),
   131	                        centerX + maxDistanceFromCenter.horizontal() + 1,
   132	                        Math.min(centerY + maxDistanceFromCenter.vertical() + 1, heightAccessor.getMaxY() + 1 - dimensionPadding.top()),
   133	                        centerZ + maxDistanceFromCenter.horizontal() + 1
   134	                     );

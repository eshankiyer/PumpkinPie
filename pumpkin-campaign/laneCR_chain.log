   304	/// Converts an NBT tag to its macro substitution string.
   305	///
   306	/// Port of `MacroFunction.stringify` (`MacroFunction.java:84-94`): floats and
   307	/// doubles go through [`format_decimal`], byte/short/long render as bare
   308	/// integers, strings render unquoted, and everything else (ints, lists,
   309	/// compounds) falls back to `tag.toString()`.
   310	#[must_use]
   311	pub fn stringify(tag: &NbtTag) -> String {
   312	    match tag {
   313	        NbtTag::Float(value) => format_decimal(f64::from(*value)),
   314	        NbtTag::Double(value) => format_decimal(*value),
   315	        NbtTag::Byte(value) => value.to_string(),
   316	        NbtTag::Short(value) => value.to_string(),
   317	        NbtTag::Long(value) => value.to_string(),
   318	        NbtTag::String(value) => value.to_string(),
   319	        other => other.to_string(),
   320	    }
   321	}

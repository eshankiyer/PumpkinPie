   434	/// `SculkVeinBlock.attemptPlaceSculk` (lines 105-137).
   435	async fn attempt_place_sculk(
   436	    world: &dyn SculkWorld,
   437	    spreader: &SculkSpreaderConfig,
   438	    pos: BlockPos,
   439	    random: &mut RandomGenerator,
   440	) -> bool {
   441	    let state = world.accessor().get_block_state(&pos);
   442	    let Some(faces) = existing_vein_faces(state) else {
   443	        return false;
   444	    };
   445	
   446	    for support in multiface_spreader::shuffled_directions(random) {
   447	        if !faces.contains(support) {
   448	            continue;
   449	        }
   450	        let support_pos = pos.offset(support.to_offset());
   451	        let support_block = world.accessor().get_block(&support_pos);
   452	        if !support_block.has_tag(spreader.replaceable_blocks()) {
   453	            continue;
   454	        }
   455	
   456	        world
   457	            .set_block(support_pos, Block::SCULK.default_state.id)
   458	            .await;
   459	        world.push_entities_up(support_pos);
   460	        world.play_block_sound(support_pos, Sound::BlockSculkSpread);
   461	
   462	        let vein_config = SculkVeinSpreaderConfig::vein(false);
   463	        multiface_spreader::spread_all(&vein_config, world, FaceSet::EMPTY, support_pos).await;
   464	
   465	        let skip = support.opposite();
   466	        for direction in BlockDirection::all() {
   467	            if direction == skip {
   468	                continue;
   469	            }
   470	            let vein_pos = support_pos.offset(direction.to_offset());
   471	            let vein_state = world.accessor().get_block_state(&vein_pos);
   472	            if Block::from_state_id(vein_state.id) == &Block::SCULK_VEIN {
   473	                SculkVeinBlock.on_discharged(world, vein_pos, random).await;
   474	            }
   475	        }
   476	
   477	        return true;
   478	    }
   479	
   480	    false
   481	}

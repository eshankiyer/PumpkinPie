    47	/// `RandomPos.generateRandomDirection` (`RandomPos.java:18-23`).
    48	fn generate_random_direction(rng: &mut ThreadRng, horizontal: i32, vertical: i32) -> Vector3<i32> {
    49	    Vector3::new(
    50	        rng.random_range(-horizontal..=horizontal),
    51	        rng.random_range(-vertical..=vertical),
    52	        rng.random_range(-horizontal..=horizontal),
    53	    )
    54	}
    55	
    56	/// `RandomPos.generateRandomDirectionWithinRadians` (`RandomPos.java:25-46`).
    57	///
    58	/// Returns `None` for the same reason vanilla does: the polar sample is drawn on a circle of
    59	/// radius `dist * sqrt(2)`, so it can land outside the axis-aligned `max_horizontal` box, and
    60	/// vanilla rejects rather than clamping (which is what makes the resulting distribution
    61	/// roughly uniform over the box instead of piling up on its edges).
    62	fn generate_random_direction_within_radians(
    63	    rng: &mut ThreadRng,
    64	    min_horizontal: f64,
    65	    max_horizontal: f64,
    66	    vertical: i32,
    67	    x_dir: f64,
    68	    z_dir: f64,
    69	    max_xz_radians_from_dir: f64,
    70	) -> Option<Vector3<i32>> {
    71	    let y_radians_center = z_dir.atan2(x_dir) - std::f64::consts::FRAC_PI_2;
    72	    let y_radians = f64::from(2.0f32.mul_add(rng.random::<f32>(), -1.0))
    73	        .mul_add(max_xz_radians_from_dir, y_radians_center);
    74	    let t = rng.random::<f64>().sqrt();
    75	    let dist = t.mul_add(max_horizontal - min_horizontal, min_horizontal) * SQRT_OF_TWO;
    76	    let xt = -dist * y_radians.sin();
    77	    let zt = dist * y_radians.cos();
    78	    if xt.abs() > max_horizontal || zt.abs() > max_horizontal {
    79	        return None;
    80	    }
    81	    let yt = rng.random_range(-vertical..=vertical);
    82	    Some(Vector3::new(xt.floor() as i32, yt, zt.floor() as i32))
    83	}

    30	use crate::entity::EntityBase;
    31	
    32	/// `MemoryStatus` (`memory/MemoryStatus.java`), the full enum.
    33	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    34	pub enum MemoryStatus {
    35	    ValuePresent,
    36	    ValueAbsent,
    37	    /// The slot exists on this brain at all. `Brain.checkMemory` returns `false` for an
    38	    /// unregistered type regardless of the requested status (`Brain.java:242-249`), which is
    39	    /// why `MemoryStore` tracks registration separately from "has a value".
    40	    Registered,
    41	}
    42	
    43	/// Dense, compiler-checked index for every memory type this port covers.
    44	///
    45	/// Vanilla declares ~120 `MemoryModuleType` constants (`memory/MemoryModuleType.java:33-152`)
    46	/// in a registry that assigns each a stable identity. Only the subset reachable from Allay's
    47	/// brain is declared here; adding a mob means adding variants, and `COUNT`/`ALL` must be kept
    48	/// in sync (there is a `debug_assert` covering that in `MemoryStore::new`).
    49	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    50	pub enum MemoryKeyId {
    51	    WalkTarget,
    52	    LookTarget,
    53	    CantReachWalkTargetSince,
    54	    IsPanicking,
    55	    HurtBy,
    56	    LikedPlayer,
    57	    LikedNoteblockPosition,
    58	    LikedNoteblockCooldownTicks,
    59	    ItemPickupCooldownTicks,
    60	    NearestVisibleWantedItem,
    61	    NearestLivingEntities,
    62	    NearestVisibleLivingEntities,
    63	}
    64	
    65	impl MemoryKeyId {
    66	    pub const ALL: [Self; 12] = [
    67	        Self::WalkTarget,
    68	        Self::LookTarget,
    69	        Self::CantReachWalkTargetSince,
    70	        Self::IsPanicking,
    71	        Self::HurtBy,
    72	        Self::LikedPlayer,
    73	        Self::LikedNoteblockPosition,
    74	        Self::LikedNoteblockCooldownTicks,
    75	        Self::ItemPickupCooldownTicks,
    76	        Self::NearestVisibleWantedItem,
    77	        Self::NearestLivingEntities,
    78	        Self::NearestVisibleLivingEntities,
    79	    ];
    80	    pub const COUNT: usize = Self::ALL.len();
    81	
    82	    #[must_use]
    83	    pub const fn index(self) -> usize {

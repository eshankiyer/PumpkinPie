    16	/// `SpongeBlock.MAX_DEPTH`: the breadth-first traversal stops expanding past this depth,
    17	/// which for orthogonal steps is the taxicab distance from the sponge.
    18	const MAX_DEPTH: i32 = 6;
    19	/// `SpongeBlock.MAX_COUNT`: the traversal aborts once this many nodes have been accepted,
    20	/// and the sponge itself is the first of them.
    21	const MAX_COUNT: usize = 65;

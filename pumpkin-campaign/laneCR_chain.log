+    fn handle_client_tick_end(&self, player: &Player) {
+        if should_clear_known_movement(self.received_movement_this_tick.swap(false, Ordering::Relaxed)) {
+            player
+                .get_entity()
+                .set_known_movement(Vector3::default());

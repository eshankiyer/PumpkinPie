    53	async fn insert_into_inventory(
    54	    inventory: &dyn pumpkin_world::inventory::Inventory,
    55	    mut stack: pumpkin_data::item_stack::ItemStack,
    56	) -> pumpkin_data::item_stack::ItemStack {
    57	    for i in 0..inventory.size() {
    58	        if stack.is_empty() {
    59	            break;
    60	        }
    61	        let mut slot_stack = inventory.get_stack(i).await;
    62	        if !slot_stack.is_empty() && slot_stack.get_item().id == stack.get_item().id {
    63	            let max_stack_size = 64;
    64	            let space = max_stack_size - slot_stack.item_count;
    65	            if space > 0 {
    66	                let to_add = stack.item_count.min(space);
    67	                slot_stack.item_count += to_add;
    68	                stack.item_count -= to_add;
    69	                inventory.set_stack(i, slot_stack).await;
    70	            }
    71	        }
    72	    }
    73	
    74	    for i in 0..inventory.size() {
    75	        if stack.is_empty() {
    76	            break;
    77	        }
    78	        let slot_stack = inventory.get_stack(i).await;
    79	        if slot_stack.is_empty() {
    80	            inventory.set_stack(i, stack.clone()).await;
    81	            stack.item_count = 0;
    82	            break;
    83	        }
    84	    }
    85	
    86	    stack
    87	}

   391	fn execute_unless_dimension_modifier<'a>(
   392	    context: &'a CommandContext,
   393	) -> crate::command::node::RedirectModifierResult<'a> {
   394	    Box::pin(async move {
   395	        let dimension_key = ResourceKeyArgument::get_registry_key(
   396	            context,
   397	            "dimension",
   398	            &Identifier::vanilla_static("dimension"),
   399	            &ERROR_INVALID_DIMENSION,
   400	        )?;
   401	        let dimension_name = dimension_key.identifier.to_string();
   402	
   403	        if let Some(ref world) = context.source.world {
   404	            if world.dimension.minecraft_name != dimension_name {
   405	                return Ok(vec![context.source.clone()]);
   406	            }
   407	        } else {
   408	            return Ok(vec![context.source.clone()]);
   409	        }
   410	        Ok(vec![])
   411	    })
   412	}

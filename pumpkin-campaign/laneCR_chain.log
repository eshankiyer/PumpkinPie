   218	
   219	impl DualNoiseBlockStateProvider {
   220	    pub fn get(&self, pos: BlockPos) -> &'static BlockState {
   221	        let sampler = DoublePerlinNoiseSampler::new(
   222	            &mut RandomGenerator::Legacy(LegacyRand::from_seed(self.base.base.seed as u64)),
   223	            self.slow_noise.first_octave,
   224	            &self.slow_noise.amplitudes,
   225	            self.slow_noise.amplitude,
   226	            false,
   227	        );
   228	        let slow_noise =
   229	            self.get_slow_noise(pos.0.x as f64, pos.0.y as f64, pos.0.z as f64, &sampler);
   230	        let mapped = clamped_map(
   231	            slow_noise,
   232	            -1.0,
   233	            1.0,
   234	            self.variety[0] as f64,
   235	            self.variety[1] as f64 + 1.0,
   236	        ) as i32;
   237	        let mut list = Vec::with_capacity(mapped as usize);
   238	        for i in 0..mapped {
   239	            let value = self.get_slow_noise(i as f64 * 54545.0, 0.0, i as f64 * 34234.0, &sampler);
   240	            list.push(NoiseBlockStateProvider::get_state_by_value(
   241	                &self.base.states,
   242	                value,
   243	            ));
   244	        }
   245	        let value = self.base.base.get_noise(pos);
   246	        NoiseBlockStateProvider::get_state_by_value(&list, value)
   247	    }
   248	
   249	    fn get_slow_noise(&self, x: f64, y: f64, z: f64, sampler: &DoublePerlinNoiseSampler) -> f64 {
   250	        sampler.sample(
   251	            x * self.slow_scale,
   252	            y * self.slow_scale,
   253	            z * self.slow_scale,
   254	        )
   255	    }
   256	}

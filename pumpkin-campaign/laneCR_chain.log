   186	/// `TreeGrower.isTwoByTwoSapling` (`TreeGrower.java:181-187`): compares blocks, not states.
   187	fn is_two_by_two(world: &World, pos: &BlockPos, block: &Block, dx: i32, dz: i32) -> bool {
   188	    [(dx, dz), (dx + 1, dz), (dx, dz + 1), (dx + 1, dz + 1)]
   189	        .into_iter()
   190	        .all(|(ox, oz)| world.get_block(&pos.offset(Vector3::new(ox, 0, oz))) == block)
   191	}
   192	
   193	/// `TreeGrower.hasFlowers` (`TreeGrower.java:189-197`): any flower in the 5x3x5 box around the
   194	/// sapling selects the bee-nest variant.
   195	fn has_flowers(world: &World, pos: &BlockPos) -> bool {
   196	    for dx in -2..=2 {
   197	        for dy in -1..=1 {
   198	            for dz in -2..=2 {
   199	                if world
   200	                    .get_block(&pos.offset(Vector3::new(dx, dy, dz)))
   201	                    .has_tag(&tag::Block::MINECRAFT_FLOWERS)
   202	                {
   203	                    return true;
   204	                }
   205	            }
   206	        }
   207	    }
   208	    false
   209	}

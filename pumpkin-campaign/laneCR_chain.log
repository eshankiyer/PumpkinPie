   131	        }
   132	        self.status = BehaviorStatus::Running;
   133	        if matches!(self.order_policy, OrderPolicy::Shuffled) {
   134	            self.shuffle();
   135	        }
   136	        match self.running_policy {
   137	            RunningPolicy::RunOne => {
   138	                for (behavior, _) in &mut self.behaviors {
   139	                    if behavior.status() == BehaviorStatus::Stopped
   140	                        && behavior.try_start(mob, brain, game_time)
   141	                    {
   142	                        break;
   143	                    }
   144	                }
   145	            }
   146	            RunningPolicy::TryAll => {
   147	                for (behavior, _) in &mut self.behaviors {
   148	                    if behavior.status() == BehaviorStatus::Stopped {
   149	                        behavior.try_start(mob, brain, game_time);
   150	                    }
   151	                }
   152	            }
   153	        }
   154	        true
   155	    }
   156	
   157	    /// `tickOrStop` (`GateBehavior.java:79-85`): the gate stops itself once no child is running.
   158	    fn tick_or_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   159	        for (behavior, _) in &mut self.behaviors {
   160	            if behavior.status() == BehaviorStatus::Running {
   161	                behavior.tick_or_stop(mob, brain, game_time);
   162	            }
   163	        }
   164	        if self
   165	            .behaviors
   166	            .iter()
   167	            .all(|(behavior, _)| behavior.status() != BehaviorStatus::Running)
   168	        {
   169	            self.do_stop(mob, brain, game_time);
   170	        }
   171	    }
   172	
   173	    /// `doStop` (`GateBehavior.java:87-92`).
   174	    fn do_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   175	        self.status = BehaviorStatus::Stopped;
   176	        for (behavior, _) in &mut self.behaviors {
   177	            if behavior.status() == BehaviorStatus::Running {
   178	                behavior.do_stop(mob, brain, game_time);
   179	            }
   180	        }
   181	        if !self.exit_erased_memories.is_empty() {
   182	            let mut store = brain.memory.lock().unwrap();
   183	            for id in &self.exit_erased_memories {
   184	                store.erase_by_id(*id);
   185	            }
   186	        }
   187	    }
   188	
   189	    fn debug_name(&self) -> &'static str {
   190	        "GateBehavior"
   191	    }
   192	}

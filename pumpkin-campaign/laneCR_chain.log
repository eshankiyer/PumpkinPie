     1	use crate::{
     2	    ServerPacket,
     3	    ser::{NetworkReadExt, ReadingError},
     4	};
     5	use pumpkin_data::packet::serverbound::play::PLAYER_INPUT;
     6	use pumpkin_macros::java_packet;
     7	use pumpkin_util::version::JavaMinecraftVersion;
     8	
     9	#[java_packet(PLAYER_INPUT)]
    10	pub struct SPlayerInput {
    11	    // Yep, exactly how it looks like
    12	    pub input: i8,
    13	}
    14	
    15	impl SPlayerInput {
    16	    pub const FORWARD: i8 = 1;
    17	    pub const BACKWARD: i8 = 2;
    18	    pub const LEFT: i8 = 4;
    19	    pub const RIGHT: i8 = 8;
    20	    pub const JUMP: i8 = 16;
    21	    pub const SNEAK: i8 = 32;
    22	    pub const SPRINT: i8 = 64;
    23	}
    24	
    25	impl<'a> ServerPacket<'a> for SPlayerInput {
    26	    fn read(bytebuf: &mut &'a [u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
    27	        if version >= &JavaMinecraftVersion::V_1_21_2 {
    28	            Ok(Self {
    29	                input: bytebuf.get_i8()?,
    30	            })
    31	        } else {
    32	            let sideways = bytebuf.get_f32_be()?;
    33	            let forward = bytebuf.get_f32_be()?;
    34	            let jumping = bytebuf.get_bool()?;
    35	            let sneaking = bytebuf.get_bool()?;
    36	
    37	            let mut input: i8 = 0;
    38	            if forward > 0.0 {
    39	                input |= Self::FORWARD;
    40	            } else if forward < 0.0 {
    41	                input |= Self::BACKWARD;
    42	            }
    43	            if sideways > 0.0 {
    44	                input |= Self::LEFT;
    45	            } else if sideways < 0.0 {
    46	                input |= Self::RIGHT;
    47	            }
    48	            if jumping {
    49	                input |= Self::JUMP;
    50	            }
    51	            if sneaking {
    52	                input |= Self::SNEAK;
    53	            }
    54	
    55	            Ok(Self { input })
    56	        }
    57	    }
    58	}
    59	
    60	impl crate::ClientPacket for SPlayerInput {
    61	    fn write_packet_data(
    62	        &self,
    63	        mut write: impl std::io::Write,
    64	        version: &JavaMinecraftVersion,
    65	    ) -> Result<(), crate::ser::WritingError> {
    66	        use crate::ser::NetworkWriteExt;
    67	        if version >= &JavaMinecraftVersion::V_1_21_2 {
    68	            write.write_i8(self.input)?;
    69	        } else {
    70	            let mut sideways: f32 = 0.0;
    71	            let mut forward: f32 = 0.0;
    72	            if (self.input & Self::FORWARD) != 0 {
    73	                forward += 1.0;
    74	            }
    75	            if (self.input & Self::BACKWARD) != 0 {
    76	                forward -= 1.0;
    77	            }
    78	            if (self.input & Self::LEFT) != 0 {
    79	                sideways += 1.0;
    80	            }
    81	            if (self.input & Self::RIGHT) != 0 {
    82	                sideways -= 1.0;
    83	            }
    84	            let jumping = (self.input & Self::JUMP) != 0;
    85	            let sneaking = (self.input & Self::SNEAK) != 0;
    86	            write.write_f32_be(sideways)?;
    87	            write.write_f32_be(forward)?;
    88	            write.write_bool(jumping)?;
    89	            write.write_bool(sneaking)?;
    90	        }
    91	        Ok(())
    92	    }
    93	}


   127	    /// registers every memory the children touch.
   128	    fn try_start(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool {
   129	        if !brain.check_memories(&self.entry_condition) {
   130	            return false;
   131	        }
   132	        self.status = BehaviorStatus::Running;
   133	        if matches!(self.order_policy, OrderPolicy::Shuffled) {
   134	            self.shuffle();

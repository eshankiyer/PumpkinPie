   145	/// `CropBlock.hasSufficientLight` (`CropBlock.java:149-151`): raw brightness at least
   146	/// [`MIN_SURVIVE_LIGHT`].
   147	///
   148	/// An accessor with no light engine behind it (worldgen) reports `None`; the gate is then
   149	/// skipped, matching the previous unconditional behaviour rather than uprooting crops during
   150	/// chunk generation.
   151	pub fn has_sufficient_light(block_accessor: &dyn BlockAccessor, pos: &BlockPos) -> bool {
   152	    block_accessor
   153	        .get_raw_brightness(pos, 0)
   154	        .is_none_or(|light| light >= MIN_SURVIVE_LIGHT)
   155	}
   156	
   157	/// Raw brightness a crop needs to *stay planted*, `CropBlock.hasSufficientLight`
   158	/// (`CropBlock.java:149-151`). One less than [`MIN_GROWTH_LIGHT`]: a crop at exactly 8 survives
   159	/// but never advances.
   160	pub const MIN_SURVIVE_LIGHT: u8 = 8;
   161	
   162	/// Raw brightness a crop or stem needs to advance a growth stage.
   163	///
   164	/// Vanilla checks `getRawBrightness(pos, 0)`, so the sky light is not reduced
   165	/// by the time of day and crops keep growing at night.
   166	pub const MIN_GROWTH_LIGHT: u8 = 9;
   167	
   168	pub async fn get_available_moisture(world: &Arc<World>, pos: &BlockPos, block: &Block) -> f32 {
   169	    let mut moisture = 1.0;
   170	    let down_pos = pos.down();
   171	
   172	    for dx in -1..=1 {
   173	        for dz in -1..=1 {
   174	            let mut local_moisture = 0.0;
   175	
   176	            let (block, block_state) =
   177	                world.get_block_and_state_id(&down_pos.offset(Vector3 { x: dx, y: 0, z: dz }));
   178	            if block == &Block::FARMLAND {
   179	                local_moisture = 1.0;
   180	                let props = FarmlandProperties::from_state_id(block_state, block);
   181	                if props.moisture != 0 {
   182	                    local_moisture = 3.0;
   183	                }
   184	            }
   185	
   186	            if dx != 0 || dz != 0 {
   187	                local_moisture /= 4.0;
   188	            }
   189	
   190	            moisture += local_moisture;
   191	        }
   192	    }
   193	
   194	    let north = pos.offset(North.to_offset());
   195	    let south = pos.offset(South.to_offset());
   196	    let west = pos.offset(West.to_offset());
   197	    let east = pos.offset(East.to_offset());
   198	    let horizontal = world.get_block(&west) == block || world.get_block(&east) == block;
   199	    let vertical = world.get_block(&north) == block || world.get_block(&south) == block;
   200	    if (horizontal && vertical)
   201	        || world.get_block(&west.offset(North.to_offset())) == block
   202	        || world.get_block(&east.offset(North.to_offset())) == block
   203	        || world.get_block(&east.offset(South.to_offset())) == block
   204	        || world.get_block(&west.offset(South.to_offset())) == block
   205	    {
   206	        moisture /= 2.0;
   207	    }
   208	
   209	    moisture
   210	}

    65	    fn bonemeal_age_increase(&self) -> i32 {
    66	        rand::rng().random_range(2..=5)
    67	    }
    68	
    69	    fn is_valid_bonemeal_target(&self, world: &World, pos: &BlockPos) -> bool {
    70	        let (block, state) = world.get_block_and_state_id(pos);
    71	        self.get_age(state, block) < self.max_age()
    72	    }
    73	
    74	    async fn perform_bonemeal(&self, world: &Arc<World>, pos: &BlockPos) {
    75	        let (block, state) = world.get_block_and_state_id(pos);
    76	        let age = self.get_age(state, block);
    77	        let new_age = (age + self.bonemeal_age_increase()).min(self.max_age());
    78	        world
    79	            .set_block_state(
    80	                pos,
    81	                self.state_with_age(block, state, new_age),
    82	                BlockFlags::NOTIFY_LISTENERS,
    83	            )
    84	            .await;
    85	    }
    86	
    87	    async fn random_tick(&self, world: &Arc<World>, pos: &BlockPos) {
    88	        if world.get_raw_brightness(pos, 0) < MIN_GROWTH_LIGHT {
    89	            return;
    90	        }
    91	        let (block, state) = world.get_block_and_state_id(pos);
    92	        let age = self.get_age(state, block);
    93	        if age < self.max_age() {
    94	            let f = get_available_moisture(world, pos, block).await;
    95	            if rand::rng().random_range(0..=(25.0 / f).floor() as i64) == 0 {
    96	                let mut new_state_id = self.state_with_age(block, state, age + 1);
    97	                if let Some(server) = world.server.upgrade() {
    98	                    let mut event = BlockGrowEvent::new(
    99	                        world.clone(),
   100	                        block,
   101	                        state,
   102	                        Block::from_state_id(new_state_id),
   103	                        new_state_id,
   104	                        *pos,
   105	                    );
   106	                    server.plugin_manager.fire(&server, &mut event).await;
   107	                    if event.cancelled {
   108	                        return;
   109	                    }
   110	                    new_state_id = event.new_state_id;
   111	                }
   112	                world
   113	                    .set_block_state(pos, new_state_id, BlockFlags::NOTIFY_NEIGHBORS)
   114	                    .await;
   115	            }
   116	        }
   117	    }
   118	}

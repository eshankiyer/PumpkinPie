   136	impl BlockBehaviour for WetSpongeBlock {
   137	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   138	        Box::pin(async move {
   139	            // Check if placed in Nether, if so, dry out
   140	            if args.world.dimension == Dimension::THE_NETHER {
   141	                args.world
   142	                    .set_block_state(
   143	                        args.position,
   144	                        Block::SPONGE.default_state.id,
   145	                        BlockFlags::NOTIFY_ALL,
   146	                    )
   147	                    .await;
   148	
   149	                // Play dry sound and spawn smoke particles
   150	                args.world.play_block_sound(
   151	                    Sound::BlockWetSpongeDries,
   152	                    SoundCategory::Blocks,
   153	                    *args.position,
   154	                );
   155	
   156	                args.world.spawn_particle(

   188	   private static void addPieces(
   189	      final RandomState randomState,
   190	      final int maxDepth,
   191	      final boolean doExpansionHack,
   192	      final ChunkGenerator chunkGenerator,
   193	      final StructureTemplateManager structureTemplateManager,
   194	      final LevelHeightAccessor heightAccessor,
   195	      final RandomSource random,
   196	      final Registry<StructureTemplatePool> pools,
   197	      final PoolElementStructurePiece centerPiece,
   198	      final List<PoolElementStructurePiece> pieces,
   199	      final VoxelShape shape,
   200	      final PoolAliasLookup poolAliasLookup,
   201	      final LiquidSettings liquidSettings
   202	   ) {
   203	      JigsawPlacement.Placer placer = new JigsawPlacement.Placer(pools, maxDepth, chunkGenerator, structureTemplateManager, pieces, random);
   204	      placer.tryPlacingChildren(centerPiece, new MutableObject<>(shape), 0, doExpansionHack, heightAccessor, randomState, poolAliasLookup, liquidSettings);
   205	
   206	      while (placer.placing.hasNext()) {
   207	         JigsawPlacement.PieceState state = placer.placing.next();
   208	         placer.tryPlacingChildren(state.piece, state.free, state.depth, doExpansionHack, heightAccessor, randomState, poolAliasLookup, liquidSettings);
   209	      }
   210	   }

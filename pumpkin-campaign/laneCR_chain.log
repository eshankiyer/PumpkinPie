    40	public class WallHangingSignBlock extends SignBlock implements HangingSignBlock {
    41	   public static final MapCodec<WallHangingSignBlock> CODEC = RecordCodecBuilder.mapCodec(
    42	      i -> i.group(WoodType.CODEC.fieldOf("wood_type").forGetter(SignBlock::type), propertiesCodec()).apply(i, WallHangingSignBlock::new)
    43	   );
    44	   public static final EnumProperty<Direction> FACING = HorizontalDirectionalBlock.FACING;
    45	   private static final Map<Direction.Axis, VoxelShape> SHAPES_PLANK = Shapes.rotateHorizontalAxis(Block.column(16.0, 4.0, 14.0, 16.0));
    46	   private static final Map<Direction.Axis, VoxelShape> SHAPES = Shapes.rotateHorizontalAxis(
    47	      Shapes.or(SHAPES_PLANK.get(Direction.Axis.Z), Block.column(14.0, 2.0, 0.0, 10.0))
    48	   );
    49	
    50	   @Override
    51	   public MapCodec<WallHangingSignBlock> codec() {
    52	      return CODEC;
    53	   }
    54	
    55	   public WallHangingSignBlock(final WoodType type, final BlockBehaviour.Properties properties) {
    56	      super(type, properties.sound(type.hangingSignSoundType()));
    57	      this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH).setValue(WATERLOGGED, false));
    58	   }
    59	
    60	   @Override
    61	   protected InteractionResult useItemOn(
    62	      final ItemStack itemStack,
    63	      final BlockState state,
    64	      final Level level,
    65	      final BlockPos pos,
    66	      final Player player,
    67	      final InteractionHand hand,
    68	      final BlockHitResult hitResult
    69	   ) {
    70	      return level.getBlockEntity(pos) instanceof SignBlockEntity signEntity
    71	            && this.shouldTryToChainAnotherHangingSign(state, player, hitResult, signEntity, itemStack)
    72	         ? InteractionResult.PASS
    73	         : super.useItemOn(itemStack, state, level, pos, player, hand, hitResult);
    74	   }
    75	
    76	   private boolean shouldTryToChainAnotherHangingSign(
    77	      final BlockState state, final Player player, final BlockHitResult hitResult, final SignBlockEntity signEntity, final ItemStack itemStack
    78	   ) {
    79	      return !signEntity.canExecuteClickCommands(signEntity.isFacingFrontText(player), player)
    80	         && itemStack.getItem() instanceof HangingSignItem
    81	         && !this.isHittingEditableSide(hitResult, state);
    82	   }
    83	
    84	   private boolean isHittingEditableSide(final BlockHitResult hitResult, final BlockState state) {
    85	      return hitResult.getDirection().getAxis() == state.getValue(FACING).getAxis();
    86	   }
    87	
    88	   @Override
    89	   protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
    90	      return SHAPES.get(state.getValue(FACING).getAxis());
    91	   }
    92	
    93	   @Override
    94	   protected VoxelShape getBlockSupportShape(final BlockState state, final BlockGetter level, final BlockPos pos) {
    95	      return this.getShape(state, level, pos, CollisionContext.empty());

     9	/// Enables mobs to interact with doors (open and close) while navigating.
    10	/// Ported from vanilla's `DoorInteractGoal` and `OpenDoorGoal`.
    11	///
    12	/// This goal allows mobs to open mob-interactable doors when walking through them,
    13	/// and optionally close them after passing through.
    14	pub struct InteractWithDoorGoal {
    15	    close_door_after: bool,
    16	    /// Vanilla: `RaiderOpenDoorGoal.canUse() = super.canUse() && hasActiveRaid()`. When set, this
    17	    /// goal only opens doors while the mob has an active raid membership.
    18	    only_during_raid: bool,
    19	    door_pos: Option<BlockPos>,
    20	    passed_door: bool,
    21	    door_open_dir_x: f32,
    22	    door_open_dir_z: f32,
    23	}
    24	
    25	impl InteractWithDoorGoal {
    26	    #[must_use]
    27	    pub const fn new(close_door_after: bool) -> Self {
    28	        Self {
    29	            close_door_after,
    30	            only_during_raid: false,
    31	            door_pos: None,
    32	            passed_door: false,
    33	            door_open_dir_x: 0.0,
    34	            door_open_dir_z: 0.0,
    35	        }
    36	    }
    37	
    38	    /// Vanilla: `Vindicator`'s `RaiderOpenDoorGoal` -- gates door-opening on `hasActiveRaid()`.
    39	    #[must_use]
    40	    pub const fn raid_gated(mut self, only_during_raid: bool) -> Self {
    41	        self.only_during_raid = only_during_raid;
    42	        self
    43	    }
    44	
    45	    /// Checks if a block is a mob-interactable door
    46	    pub(crate) fn is_mob_interactable_door(world: &World, pos: &BlockPos) -> bool {
    47	        let block = world.get_block(pos);
    48	        // DoorInteractGoal.canUse (`DoorInteractGoal.java:59-74`) delegates this
    49	        // decision to DoorBlock.isWoodenDoor (`DoorBlock.java:271-277`).
    50	        crate::block::blocks::doors::is_wooden_door(block)
    51	    }
    52	
    53	    /// Checks if the door at the given position is currently open
    54	    pub(crate) fn is_door_open(world: &World, pos: &BlockPos) -> bool {
    55	        let (block, state_id) = world.get_block_and_state_id(pos);
    56	        let door_props = OakDoorLikeProperties::from_state_id(state_id, block);
    57	        door_props.open
    58	    }
    59	}

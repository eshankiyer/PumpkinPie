    14	
    15	impl<'a> ServerPacket<'a> for SKeepAlive {
    16	    fn read(bytebuf: &mut &'a [u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
    17	        let keep_alive_id = if version >= &JavaMinecraftVersion::V_1_12_2 {
    18	            bytebuf.get_i64_be()?
    19	        } else if version >= &JavaMinecraftVersion::V_1_8 {
    20	            i64::from(bytebuf.get_var_int()?.0)
    21	        } else {
    22	            i64::from(bytebuf.get_i32_be()?)
    23	        };
    24	        Ok(Self { keep_alive_id })
    25	    }
    26	}
    27	
    28	impl crate::ClientPacket for SKeepAlive {
    29	    fn write_packet_data(
    30	        &self,
    31	        mut write: impl std::io::Write,
    32	        version: &JavaMinecraftVersion,
    33	    ) -> Result<(), crate::ser::WritingError> {
    34	        use crate::ser::NetworkWriteExt;
    35	        if version >= &JavaMinecraftVersion::V_1_12_2 {
    36	            write.write_i64_be(self.keep_alive_id)?;
    37	        } else if version >= &JavaMinecraftVersion::V_1_8 {
    38	            write.write_var_int(&VarInt(self.keep_alive_id as i32))?;
    39	        } else {
    40	            write.write_i32_be(self.keep_alive_id as i32)?;
    41	        }
    42	        Ok(())
    43	    }
    44	}

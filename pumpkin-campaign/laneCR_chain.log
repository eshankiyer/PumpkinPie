   115	pub struct TestInstanceBlockData<'a> {
   116	    pub test: Option<&'a str>,
   117	    pub size: VarIntVector3,
   118	    pub rotation: pumpkin_data::block_rotation::Rotation,
   119	    pub ignore_entities: bool,
   120	    pub status: TestInstanceBlockStatus,
   121	    pub error_message: Option<&'a str>,
   122	}
   123	
   124	impl<'a> TestInstanceBlockData<'a> {
   125	    fn read(bytebuf: &mut &'a [u8]) -> Result<Self, ReadingError> {
   126	        let test = bytebuf.get_option(crate::ser::NetworkReadSliceExt::get_str_borrowed)?;
   127	        let size = VarIntVector3::read(bytebuf)?;
   128	        let rotation = match bytebuf.get_var_int()?.0 {
   129	            0 => pumpkin_data::block_rotation::Rotation::None,
   130	            1 => pumpkin_data::block_rotation::Rotation::Clockwise90,
   131	            2 => pumpkin_data::block_rotation::Rotation::Rotate180,
   132	            3 => pumpkin_data::block_rotation::Rotation::CounterClockwise90,
   133	            _ => return Err(ReadingError::Message("Invalid Rotation".to_string())),
   134	        };
   135	        let ignore_entities = bytebuf.get_bool()?;
   136	        let status = match bytebuf.get_var_int()?.0 {
   137	            0 => TestInstanceBlockStatus::Cleared,
   138	            1 => TestInstanceBlockStatus::Running,
   139	            2 => TestInstanceBlockStatus::Success,
   140	            3 => TestInstanceBlockStatus::Failed,
   141	            _ => {
   142	                return Err(ReadingError::Message(
   143	                    "Invalid TestInstanceBlockStatus".to_string(),
   144	                ));
   145	            }
   146	        };
   147	        let error_message =
   148	            bytebuf.get_option(crate::ser::NetworkReadSliceExt::get_str_borrowed)?;
   149	
   150	        Ok(Self {
   151	            test,
   152	            size,
   153	            rotation,
   154	            ignore_entities,
   155	            status,
   156	            error_message,
   157	        })
   158	    }
   159	
   160	    fn write(
   161	        &self,
   162	        write: &mut impl crate::ser::NetworkWriteExt,
   163	    ) -> Result<(), crate::ser::WritingError> {
   164	        write.write_option(&self.test, |w, t| w.write_string(t))?;
   165	        self.size.write(write)?;
   166	        let rot_val = match self.rotation {
   167	            pumpkin_data::block_rotation::Rotation::None => 0,
   168	            pumpkin_data::block_rotation::Rotation::Clockwise90 => 1,
   169	            pumpkin_data::block_rotation::Rotation::Rotate180 => 2,
   170	            pumpkin_data::block_rotation::Rotation::CounterClockwise90 => 3,
   171	        };
   172	        write.write_var_int(&VarInt(rot_val))?;
   173	        write.write_bool(self.ignore_entities)?;
   174	        let status_val = match self.status {
   175	            TestInstanceBlockStatus::Cleared => 0,
   176	            TestInstanceBlockStatus::Running => 1,
   177	            TestInstanceBlockStatus::Success => 2,
   178	            TestInstanceBlockStatus::Failed => 3,
   179	        };
   180	        write.write_var_int(&VarInt(status_val))?;
   181	        write.write_option(&self.error_message, |w, msg| w.write_string(msg))?;
   182	        Ok(())
   183	    }
   184	}
   185	
   186	#[derive(Clone, Copy, Debug)]
   187	pub enum TestInstanceBlockStatus {
   188	    Cleared,
   189	    Running,
   190	    Success,
   191	    Failed,
   192	}


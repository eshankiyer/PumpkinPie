    50	   public static Optional<Structure.GenerationStub> addPieces(
    51	      final Structure.GenerationContext context,
    52	      final Holder<StructureTemplatePool> startPool,
    53	      final Optional<Identifier> startJigsaw,
    54	      final int maxDepth,

   271	/// `MultifaceSpreader.spreadFromFaceTowardAllDirections`.
   272	pub async fn spread_from_face_toward_all_directions(
   273	    config: &dyn SpreadConfig,
   274	    target: &dyn SpreadTarget,
   275	    faces: FaceSet,
   276	    pos: BlockPos,
   277	    starting_face: BlockDirection,
   278	) -> u64 {
   279	    let mut count = 0;
   280	    for spread_direction in BlockDirection::all() {
   281	        if spread_from_face_toward_direction(
   282	            config,
   283	            target,
   284	            faces,
   285	            pos,
   286	            starting_face,
   287	            spread_direction,
   288	        )
   289	        .await
   290	        .is_some()
   291	        {
   292	            count += 1;
   293	        }
   294	    }
   295	    count
   296	}

    40	        Box::pin(async move {
    41	            let mut props = SkeletonSkullLikeProperties::default(args.block);
    42	            props.rotation = args.player.get_entity().get_rotation_16();
    43	            props.powered = block_receives_redstone_power(args.world, args.position).await;
    44	            props.to_state_id(args.block)
    45	        })
    46	    }
    47	
    48	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
    49	        Box::pin(async move {
    50	            let state = args.world.get_block_state(args.position);
    51	            let mut props = SkeletonSkullLikeProperties::from_state_id(state.id, args.block);
    52	            let is_receiving_power = block_receives_redstone_power(args.world, args.position).await;
    53	            if props.powered != is_receiving_power {
    54	                props.powered = is_receiving_power;
    55	                args.world
    56	                    .set_block_state(
    57	                        args.position,
    58	                        props.to_state_id(args.block),
    59	                        BlockFlags::NOTIFY_LISTENERS,

    99	            if item.item.id != Item::FILLED_MAP.id || !block.has_tag(&tag::Block::MINECRAFT_BANNERS)
   100	            {
   101	                return;
   102	            }
   103	            let Some(map_id) = item
   104	                .get_data_component::<MapIdImpl>()
   105	                .map(|component| component.id)

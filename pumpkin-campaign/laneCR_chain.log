   267	fn build_spline_recursive(spline_repr: &SplineRepr) -> SplineValue {
   268	    match spline_repr {
   269	        SplineRepr::Standard {
   270	            location_function_index,
   271	            points,
   272	        } => {
   273	            let points = points
   274	                .iter()
   275	                .map(|point| {
   276	                    let value = build_spline_recursive(point.value);
   277	                    SplinePoint::new(point.location, value, point.derivative)
   278	                })
   279	                .collect();
   280	            SplineValue::Spline(Spline::new(*location_function_index, points))
   281	        }
   282	        // Top level splines always take a density function as input
   283	        SplineRepr::Fixed { value } => SplineValue::Fixed(*value),
   284	    }
   285	}

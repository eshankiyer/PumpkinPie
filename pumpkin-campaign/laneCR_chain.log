    13	    /// Vanilla `Player.maybeBackOffFromEdge` (`Player.java:880-940`) trims a sneaking player's
    14	    /// horizontal movement in 0.05-block increments while the inset footprint would otherwise
    15	    /// fall farther than `STEP_HEIGHT`.
    16	    fn maybe_back_off_from_edge(
    17	        player: &Player,
    18	        world: &World,
    19	        position: Vector3<f64>,
    20	        last_position: Vector3<f64>,
    21	        flying: bool,
    22	    ) -> Vector3<f64> {
    23	        let entity = player.get_entity();
    24	        let delta = position - last_position;
    25	        let max_down_step = player
    26	            .living_entity
    27	            .get_attribute_value(&pumpkin_data::attributes::Attributes::STEP_HEIGHT);
    28	        let can_fall_at_least = |delta_x: f64, delta_z: f64, min_height: f64| {
    29	            let bounding_box = entity.bounding_box.load();
    30	            world.is_space_empty(BoundingBox::new(
    31	                Vector3::new(
    32	                    bounding_box.min.x + 1.0E-7 + delta_x,
    33	                    bounding_box.min.y - min_height - 1.0E-7,
    34	                    bounding_box.min.z + 1.0E-7 + delta_z,
    35	                ),
    36	                Vector3::new(
    37	                    bounding_box.max.x - 1.0E-7 + delta_x,
    38	                    bounding_box.min.y,
    39	                    bounding_box.max.z - 1.0E-7 + delta_z,
    40	                ),
    41	            ))
    42	        };
    43	
    44	        let fall_distance = player.living_entity.fall_distance.load();
    45	        let above_ground = entity.on_ground.load(Ordering::Relaxed)
    46	            || (f64::from(fall_distance) < max_down_step
    47	                && !can_fall_at_least(0.0, 0.0, max_down_step - f64::from(fall_distance)));
    48	        if flying || delta.y > 0.0 || !entity.sneaking.load(Ordering::Relaxed) || !above_ground {
    49	            return position;
    50	        }
    51	
    52	        let can_fall =
    53	            |delta_x: f64, delta_z: f64| can_fall_at_least(delta_x, delta_z, max_down_step);
    54	        let mut delta_x = delta.x;
    55	        let mut delta_z = delta.z;
    56	        let step_x = delta_x.signum() * 0.05;
    57	        let step_z = delta_z.signum() * 0.05;
    58	
    59	        while delta_x != 0.0 && can_fall(delta_x, 0.0) {
    60	            if delta_x.abs() <= 0.05 {
    61	                delta_x = 0.0;
    62	                break;
    63	            }
    64	            delta_x -= step_x;
    65	        }
    66	        while delta_z != 0.0 && can_fall(0.0, delta_z) {
    67	            if delta_z.abs() <= 0.05 {
    68	                delta_z = 0.0;
    69	                break;
    70	            }
    71	            delta_z -= step_z;
    72	        }
    73	        while delta_x != 0.0 && delta_z != 0.0 && can_fall(delta_x, delta_z) {
    74	            if delta_x.abs() <= 0.05 {
    75	                delta_x = 0.0;
    76	            } else {
    77	                delta_x -= step_x;
    78	            }
    79	            if delta_z.abs() <= 0.05 {
    80	                delta_z = 0.0;
    81	            } else {
    82	                delta_z -= step_z;
    83	            }
    84	        }

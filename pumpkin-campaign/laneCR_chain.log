   219	
   220	struct PlacingQueue {
   221	    queues: BTreeMap<std::cmp::Reverse<i32>, VecDeque<PieceState>>,
   222	}
   223	
   224	impl PlacingQueue {
   225	    const fn new() -> Self {
   226	        Self {
   227	            queues: BTreeMap::new(),
   228	        }
   229	    }
   230	
   231	    fn add(&mut self, state: PieceState, priority: i32) {
   232	        self.queues
   233	            .entry(std::cmp::Reverse(priority))
   234	            .or_default()
   235	            .push_back(state);
   236	    }
   237	
   238	    fn next(&mut self) -> Option<PieceState> {
   239	        let mut empty_key = None;
   240	        let mut result = None;
   241	        for (&priority_rev, queue) in &mut self.queues {
   242	            if let Some(state) = queue.pop_front() {
   243	                result = Some(state);
   244	                if queue.is_empty() {
   245	                    empty_key = Some(priority_rev);
   246	                }
   247	                break;
   248	            }
   249	        }
   250	        if let Some(key) = empty_key {
   251	            self.queues.remove(&key);
   252	        }
   253	        result
   254	    }
   255	
   256	    fn has_next(&self) -> bool {
   257	        self.queues.values().any(|q| !q.is_empty())
   258	    }
   259	}
   260	
   261	#[allow(clippy::vec_box)]
   262	struct Placer {
   263	    max_depth: i32,
   264	    pieces: Vec<Box<PoolElementStructurePiece>>,
   265	    placing: PlacingQueue,
   266	}
   267	
   268	impl Placer {
   269	    #[allow(clippy::vec_box)]
   270	    fn new(max_depth: i32, center_piece: Box<PoolElementStructurePiece>) -> Self {
   271	        Self {
   272	            max_depth,
   273	            pieces: vec![center_piece],
   274	            placing: PlacingQueue::new(),
   275	        }
   276	    }
   277	
   278	    #[expect(clippy::too_many_arguments)]
   279	    #[expect(clippy::too_many_lines)]
   280	    #[expect(clippy::needless_pass_by_value)]
   281	    fn try_placing_children(
   282	        &mut self,
   283	        source_piece_idx: usize,
   284	        context_free: Rc<RefCell<FreeSpace>>,
   285	        depth: i32,
   286	        do_expansion_hack: bool,
   287	        height_sampler: &mut Option<&mut (dyn HeightSampler + '_)>,
   288	        random: &mut RandomGenerator,
   289	        pool_alias_lookup: &PoolAliasLookup,
   290	        liquid_settings: LiquidSettings,
   291	    ) {
   292	        let source_element = self.pieces[source_piece_idx].element.clone();
   293	        let source_box_position = self.pieces[source_piece_idx].pos;
   294	        let source_rotation = self.pieces[source_piece_idx].rotation;
   295	        let source_projection = source_element.projection;
   296	        let source_rigid = source_projection == JigsawProjection::Rigid;
   297	        let mut source_free: Option<Rc<RefCell<FreeSpace>>> = None;
   298	        let source_bb = self.pieces[source_piece_idx].piece.bounding_box;
   299	        let source_box_y = source_bb.min.y;
   300	
   301	        let source_jigsaws =
   302	            source_element.get_shuffled_jigsaw_blocks(source_box_position, source_rotation, random);
   303	
   304	        'source_jigsaws: for source_jigsaw in source_jigsaws {
   305	            let source_direction = source_jigsaw.facing;
   306	            let source_jigsaw_pos = source_jigsaw.pos;
   307	            let target_jigsaw_pos = source_jigsaw_pos.add(
   308	                source_direction.to_vector().x,
   309	                source_direction.to_vector().y,
   310	                source_direction.to_vector().z,
   311	            );
   312	            let source_jigsaw_local_y = source_jigsaw_pos.0.y - source_box_y;
   313	            let mut source_jigsaw_base_height = i32::MIN;
   314	
   315	            let pool_name = pool_alias_lookup.lookup(&source_jigsaw.pool, random);
   316	            if pool_name == "minecraft:empty" || pool_name.is_empty() {
   317	                continue;
   318	            }
   319	            let Some(target_pool) = TemplatePool::discover(pool_name) else {
   320	                tracing::warn!("Empty or non-existent pool: {}", pool_name);
   321	                continue;
   322	            };
   323	
   324	            if target_pool.elements.is_empty() && target_pool.id != "minecraft:empty" {
   325	                tracing::warn!("Empty or non-existent pool: {}", pool_name);
   326	                continue;
   327	            }
   328	
   329	            let fallback_pool_name = pool_alias_lookup.lookup(&target_pool.fallback, random);
   330	            let fallback_pool = TemplatePool::discover(fallback_pool_name);
   331	
   332	            let attach_inside_source = source_bb.contains(
   333	                target_jigsaw_pos.0.x,
   334	                target_jigsaw_pos.0.y,
   335	                target_jigsaw_pos.0.z,
   336	            );
   337	            let children_free = if attach_inside_source {
   338	                source_free
   339	                    .get_or_insert_with(|| Rc::new(RefCell::new(FreeSpace::from_bounds(source_bb))))
   340	                    .clone()
   341	            } else {
   342	                context_free.clone()
   343	            };
   344	
   345	            let mut target_pieces = Vec::new();
   346	            if depth != self.max_depth {
   347	                target_pieces.extend(target_pool.get_shuffled_elements(random));
   348	            }
   349	            if let Some(fb) = &fallback_pool {
   350	                target_pieces.extend(fb.get_shuffled_elements(random));
   351	            }
   352	
   353	            let placement_priority = source_jigsaw.placement_priority;
   354	
   355	            for target_element in target_pieces {
   356	                if target_element.is_empty() {
   357	                    break;
   358	                }
   359	
   360	                let mut rotations = Rotation::values();
   361	                for i in (1..4).rev() {
   362	                    let j = random.next_bounded_i32(i as i32 + 1) as usize;
   363	                    rotations.swap(i, j);
   364	                }
   365	
   366	                for target_rotation in rotations {
   367	                    let target_jigsaws = target_element.get_shuffled_jigsaw_blocks(
   368	                        BlockPos::ZERO,
   369	                        target_rotation,
   370	                        random,
   371	                    );
   372	                    let hack_box = target_element.get_bounding_box(BlockPos::ZERO, target_rotation);
   373	                    let hack_box_y_span = hack_box.max.y - hack_box.min.y + 1;
   374	
   375	                    let mut expand_to = 0;
   376	                    if do_expansion_hack && hack_box_y_span <= 16 {
   377	                        for target_jigsaw_x in &target_jigsaws {
   378	                            let target_jigsaw_relative = target_jigsaw_x.pos.add(
   379	                                target_jigsaw_x.facing.to_vector().x,
   380	                                target_jigsaw_x.facing.to_vector().y,
   381	                                target_jigsaw_x.facing.to_vector().z,
   382	                            );
   383	                            if !hack_box.contains(
   384	                                target_jigsaw_relative.0.x,
   385	                                target_jigsaw_relative.0.y,
   386	                                target_jigsaw_relative.0.z,
   387	                            ) {
   388	                                continue;
   389	                            }
   390	
   391	                            let child_pool_name =
   392	                                pool_alias_lookup.lookup(&target_jigsaw_x.pool, random);
   393	                            let child_pool = TemplatePool::discover(child_pool_name);
   394	                            let child_pool_size =
   395	                                child_pool.as_ref().map_or(0, TemplatePool::get_max_size);
   396	                            let child_fallback_size = child_pool
   397	                                .as_ref()
   398	                                .and_then(|p| {
   399	                                    let fb_name = pool_alias_lookup.lookup(&p.fallback, random);
   400	                                    TemplatePool::discover(fb_name)
   401	                                })
   402	                                .map_or(0, |p| p.get_max_size());
   403	
   404	                            expand_to = expand_to.max(child_pool_size.max(child_fallback_size));
   405	                        }
   406	                    }
   407	
   408	                    for target_jigsaw in target_jigsaws {
   409	                        if can_attach(&source_jigsaw, &target_jigsaw) {
   410	                            let target_jigsaw_local_pos = target_jigsaw.pos;
   411	                            let raw_target_box_pos = BlockPos::new(
   412	                                target_jigsaw_pos.0.x - target_jigsaw_local_pos.0.x,
   413	                                target_jigsaw_pos.0.y - target_jigsaw_local_pos.0.y,
   414	                                target_jigsaw_pos.0.z - target_jigsaw_local_pos.0.z,
   415	                            );
   416	                            let raw_target_bb = target_element
   417	                                .get_bounding_box(raw_target_box_pos, target_rotation);
   418	                            let raw_target_y = raw_target_bb.min.y;
   419	                            let target_projection = target_element.projection;
   420	                            let target_rigid = target_projection == JigsawProjection::Rigid;
   421	                            let target_jigsaw_local_y = target_jigsaw_local_pos.0.y;
   422	                            let delta_y = source_jigsaw_local_y - target_jigsaw_local_y
   423	                                + source_direction.to_vector().y;
   424	
   425	                            let target_box_y = if source_rigid && target_rigid {
   426	                                source_box_y + delta_y
   427	                            } else {
   428	                                if source_jigsaw_base_height == i32::MIN {
   429	                                    source_jigsaw_base_height = height_sampler.as_mut().map_or(
   430	                                        source_jigsaw_pos.0.y,
   431	                                        |s| {
   432	                                            s.estimate_height(
   433	                                                source_jigsaw_pos.0.x,
   434	                                                source_jigsaw_pos.0.z,
   435	                                            )
   436	                                        },
   437	                                    );
   438	                                }
   439	                                source_jigsaw_base_height - target_jigsaw_local_y
   440	                            };
   441	
   442	                            let y_offset = target_box_y - raw_target_y;
   443	                            let mut target_bb = raw_target_bb;
   444	                            target_bb.move_pos(0, y_offset, 0);
   445	                            let target_box_position = raw_target_box_pos.add(0, y_offset, 0);
   446	
   447	                            if expand_to > 0 {
   448	                                let new_size =
   449	                                    (expand_to + 1).max(target_bb.max.y - target_bb.min.y);
   450	                                target_bb.max.y = target_bb.min.y + new_size;
   451	                            }
   452	
   453	                            if children_free.borrow().can_fit(&target_bb) {
   454	                                children_free.borrow_mut().occupy(target_bb);
   455	
   456	                                let source_ground_level_delta =
   457	                                    self.pieces[source_piece_idx].ground_level_delta;
   458	                                let target_ground_level_delta = if target_rigid {
   459	                                    source_ground_level_delta - delta_y
   460	                                } else {
   461	                                    target_element.get_ground_level_delta()
   462	                                };
   463	
   464	                                let mut target_piece = Box::new(PoolElementStructurePiece {
   465	                                    piece: StructurePiece::new(
   466	                                        StructurePieceType::Jigsaw,
   467	                                        target_bb,
   468	                                        depth as u32 + 1,
   469	                                    ),
   470	                                    element: target_element.clone(),
   471	                                    pos: target_box_position,
   472	                                    rotation: target_rotation,
   473	                                    mirror: Mirror::None,
   474	                                    jigsaw_blocks: Vec::new(),
   475	                                    junctions: Vec::new(),
   476	                                    ground_level_delta: target_ground_level_delta,
   477	                                    liquid_settings,
   478	                                    projection: target_projection,
   479	                                });
   480	
   481	                                let junction_y = if source_rigid {
   482	                                    source_box_y + source_jigsaw_local_y
   483	                                } else if target_rigid {
   484	                                    target_box_y + target_jigsaw_local_y
   485	                                } else {
   486	                                    if source_jigsaw_base_height == i32::MIN {
   487	                                        source_jigsaw_base_height = height_sampler.as_mut().map_or(
   488	                                            source_jigsaw_pos.0.y,
   489	                                            |s| {
   490	                                                s.estimate_height(
   491	                                                    source_jigsaw_pos.0.x,
   492	                                                    source_jigsaw_pos.0.z,
   493	                                                )
   494	                                            },
   495	                                        );
   496	                                    }
   497	                                    source_jigsaw_base_height + delta_y / 2
   498	                                };
   499	
   500	                                self.pieces[source_piece_idx].add_junction(JigsawJunction {
   501	                                    source_x: target_jigsaw_pos.0.x,
   502	                                    source_ground_y: junction_y - source_jigsaw_local_y
   503	                                        + source_ground_level_delta,
   504	                                    source_z: target_jigsaw_pos.0.z,
   505	                                    delta_y,
   506	                                    projection: target_projection,
   507	                                });
   508	
   509	                                target_piece.add_junction(JigsawJunction {
   510	                                    source_x: source_jigsaw_pos.0.x,
   511	                                    source_ground_y: junction_y - target_jigsaw_local_y
   512	                                        + target_ground_level_delta,
   513	                                    source_z: source_jigsaw_pos.0.z,
   514	                                    delta_y: -delta_y,
   515	                                    projection: source_projection,
   516	                                });
   517	
   518	                                let target_piece_idx = self.pieces.len();
   519	                                self.pieces.push(target_piece);
   520	
   521	                                if depth < self.max_depth {
   522	                                    self.placing.add(
   523	                                        PieceState {
   524	                                            piece_idx: target_piece_idx,
   525	                                            free: children_free.clone(),
   526	                                            depth: depth + 1,
   527	                                        },
   528	                                        placement_priority,
   529	                                    );
   530	                                }
   531	
   532	                                continue 'source_jigsaws;
   533	                            }
   534	                        }
   535	                    }
   536	                }
   537	            }
   538	        }
   539	    }
   540	}
   541	
   542	impl JigsawPlacement {
   543	    #[expect(clippy::too_many_arguments)]
   544	    #[expect(clippy::too_many_lines)]
   545	    pub fn add_pieces(
   546	        context: &mut StructureGeneratorContext,
   547	        start_pool_id: &str,
   548	        start_jigsaw: Option<&str>,
   549	        max_depth: i32,
   550	        position: BlockPos,
   551	        do_expansion_hack: bool,
   552	        project_start_to_heightmap: bool,
   553	        max_distance_from_center: &MaxDistance,
   554	        dimension_padding: DimensionPadding,
   555	        liquid_settings: LiquidSettings,
   556	        pool_alias_lookup: &PoolAliasLookup,
   557	    ) -> Option<StructurePosition> {
   558	        if max_distance_from_center.horizontal > MAX_TOTAL_STRUCTURE_RANGE {
   559	            return None;
   560	        }
   561	
   562	        let max_depth = max_depth.clamp(MIN_DEPTH, MAX_DEPTH);
   563	
   564	        let actual_start_pool_id = pool_alias_lookup.lookup(start_pool_id, &mut context.random);
   565	        let pool = TemplatePool::discover(actual_start_pool_id)?;
   566	        let center_rotation = Rotation::from_index(context.random.next_bounded_i32(4) as u8);
   567	        let center_element = pool.get_random_element(&mut context.random).clone();
   568	        if center_element.is_empty() {
   569	            return None;
   570	        }
   571	
   572	        let (local_anchor_position, adjusted_position) =
   573	            if let Some(target_jigsaw_id) = start_jigsaw {
   574	                let mut found_anchor = None;
   575	                let center_jigsaws = center_element.get_shuffled_jigsaw_blocks(
   576	                    position,
   577	                    center_rotation,
   578	                    &mut context.random,
   579	                );
   580	                for jigsaw in center_jigsaws {
   581	                    if jigsaw.name == target_jigsaw_id {
   582	                        found_anchor = Some(jigsaw.pos);
   583	                        break;
   584	                    }
   585	                }
   586	
   587	                let Some(anchor) = found_anchor else {
   588	                    tracing::error!(
   589	                        "No starting jigsaw {} found in start pool {}",
   590	                        target_jigsaw_id,
   591	                        start_pool_id
   592	                    );
   593	                    return None;
   594	                };
   595	                let local_anchor = anchor.0.sub(&position.0);
   596	                (local_anchor, BlockPos(position.0.sub(&local_anchor)))
   597	            } else {
   598	                (Vector3::new(0, 0, 0), position)
   599	            };
   600	
   601	        let mut box_ = center_element.get_bounding_box(adjusted_position, center_rotation);
   602	
   603	        let center_x = i32::midpoint(box_.max.x, box_.min.x);
   604	        let center_z = i32::midpoint(box_.max.z, box_.min.z);
   605	
   606	        let bottom_y = if project_start_to_heightmap {
   607	            position.0.y
   608	                + context
   609	                    .height_sampler
   610	                    .as_mut()
   611	                    .map_or(0, |sampler| sampler.estimate_height(center_x, center_z))
   612	        } else {
   613	            adjusted_position.0.y
   614	        };
   615	
   616	        let ground_level_delta = center_element.get_ground_level_delta();
   617	        let old_absolute_ground_y = box_.min.y + ground_level_delta;
   618	        let y_offset = bottom_y - old_absolute_ground_y;
   619	        box_.move_pos(0, y_offset, 0);
   620	        let piece_pos = adjusted_position.add(0, y_offset, 0);
   621	
   622	        let max_y = context.min_y + 384 - 1;
   623	        if is_start_too_close_to_world_height_limits(context.min_y, max_y, dimension_padding, &box_)
   624	        {
   625	            tracing::debug!(
   626	                "Center piece with bounding box {:?} does not fit dimension padding {:?}",
   627	                box_,
   628	                dimension_padding
   629	            );
   630	            return None;
   631	        }
   632	
   633	        let center_y = bottom_y + local_anchor_position.y;
   634	
   635	        let global_bounding_box = BlockBox::new(
   636	            center_x - max_distance_from_center.horizontal,
   637	            (center_y - max_distance_from_center.vertical)
   638	                .max(context.min_y + dimension_padding.bottom),
   639	            center_z - max_distance_from_center.horizontal,
   640	            center_x + max_distance_from_center.horizontal,
   641	            (center_y + max_distance_from_center.vertical).min(max_y - dimension_padding.top),
   642	            center_z + max_distance_from_center.horizontal,
   643	        );
   644	
   645	        let center_piece = Box::new(PoolElementStructurePiece {
   646	            piece: StructurePiece::new(StructurePieceType::Jigsaw, box_, 0),
   647	            element: center_element,
   648	            pos: piece_pos,
   649	            rotation: center_rotation,
   650	            mirror: Mirror::None,
   651	            jigsaw_blocks: Vec::new(),
   652	            junctions: Vec::new(),
   653	            ground_level_delta,
   654	            liquid_settings,
   655	            projection: pool.elements[0].projection,
   656	        });
   657	
   658	        let mut collector = super::StructurePiecesCollector::new();
   659	
   660	        if max_depth > 0 {
   661	            let global_free = Rc::new(RefCell::new(FreeSpace::new(global_bounding_box, box_)));
   662	            let mut placer = Placer::new(max_depth, center_piece);
   663	
   664	            let mut height_sampler = context
   665	                .height_sampler
   666	                .as_mut()
   667	                .map(|s| &mut **s as &mut dyn HeightSampler);
   668	
   669	            placer.try_placing_children(
   670	                0,
   671	                global_free,
   672	                0,
   673	                do_expansion_hack,
   674	                &mut height_sampler,
   675	                &mut context.random,
   676	                pool_alias_lookup,
   677	                liquid_settings,
   678	            );
   679	
   680	            while placer.placing.has_next() {
   681	                if let Some(state) = placer.placing.next() {
   682	                    placer.try_placing_children(
   683	                        state.piece_idx,
   684	                        state.free,
   685	                        state.depth,
   686	                        do_expansion_hack,
   687	                        &mut height_sampler,
   688	                        &mut context.random,
   689	                        pool_alias_lookup,
   690	                        liquid_settings,
   691	                    );
   692	                }
   693	            }
   694	
   695	            for piece in placer.pieces {
   696	                collector.add_piece(piece);
   697	            }
   698	        } else {
   699	            collector.add_piece(center_piece);
   700	        }
   701	
   702	        Some(StructurePosition {
   703	            start_pos: BlockPos::new(center_x, center_y, center_z),
   704	            collector: Arc::new(std::sync::Mutex::new(collector)),
   705	        })
   706	    }
   707	}
   708	
   709	const fn is_start_too_close_to_world_height_limits(
   710	    min_y: i32,
   711	    max_y: i32,
   712	    dimension_padding: DimensionPadding,
   713	    center_piece_bb: &BlockBox,
   714	) -> bool {
   715	    if dimension_padding.top == 0 && dimension_padding.bottom == 0 {
   716	        return false;
   717	    }
   718	
   719	    let min_y_with_padding = min_y + dimension_padding.bottom;
   720	    let max_y_with_padding = max_y - dimension_padding.top;
   721	    center_piece_bb.min.y < min_y_with_padding || center_piece_bb.max.y > max_y_with_padding
   722	}
   723	
   724	const fn is_box_inside(outer: &BlockBox, inner: &BlockBox) -> bool {
   725	    inner.min.x >= outer.min.x
   726	        && inner.max.x <= outer.max.x
   727	        && inner.min.y >= outer.min.y
   728	        && inner.max.y <= outer.max.y
   729	        && inner.min.z >= outer.min.z
   730	        && inner.max.z <= outer.max.z
   731	}
   732	
   733	const fn boxes_intersect(a: &BlockBox, b: &BlockBox) -> bool {
   734	    a.max.x >= b.min.x
   735	        && a.min.x <= b.max.x
   736	        && a.max.y >= b.min.y
   737	        && a.min.y <= b.max.y
   738	        && a.max.z >= b.min.z
   739	        && a.min.z <= b.max.z
   740	}
   741	
   742	#[must_use]
   743	pub const fn rotate_pos(pos: Vector3<i32>, rotation: Rotation) -> Vector3<i32> {
   744	    let (x, z) = rotation.rotate_offset(pos.x, pos.z);
   745	    Vector3::new(x, pos.y, z)
   746	}
   747	
   748	#[must_use]
   749	pub fn rotated_box(origin: BlockPos, size: Vector3<i32>, rotation: Rotation) -> BlockBox {
   750	    let corner = rotate_pos(Vector3::new(size.x - 1, size.y - 1, size.z - 1), rotation);
   751	    BlockBox::new(
   752	        origin.0.x.min(origin.0.x + corner.x),
   753	        origin.0.y,
   754	        origin.0.z.min(origin.0.z + corner.z),
   755	        origin.0.x.max(origin.0.x + corner.x),
   756	        origin.0.y + corner.y,
   757	        origin.0.z.max(origin.0.z + corner.z),
   758	    )
   759	}
   760	
   761	#[must_use]
   762	pub const fn rotate_direction(
   763	    dir: pumpkin_util::BlockDirection,
   764	    rotation: Rotation,
   765	) -> pumpkin_util::BlockDirection {
   766	    use pumpkin_util::BlockDirection;
   767	    match rotation {
   768	        Rotation::None => dir,
   769	        Rotation::Clockwise90 => match dir {
   770	            BlockDirection::North => BlockDirection::East,
   771	            BlockDirection::East => BlockDirection::South,
   772	            BlockDirection::South => BlockDirection::West,
   773	            BlockDirection::West => BlockDirection::North,
   774	            _ => dir,
   775	        },
   776	        Rotation::Rotate180 => match dir {
   777	            BlockDirection::North => BlockDirection::South,
   778	            BlockDirection::South => BlockDirection::North,
   779	            BlockDirection::West => BlockDirection::East,
   780	            BlockDirection::East => BlockDirection::West,
   781	            _ => dir,
   782	        },
   783	        Rotation::CounterClockwise90 => match dir {
   784	            BlockDirection::North => BlockDirection::West,
   785	            BlockDirection::West => BlockDirection::South,
   786	            BlockDirection::South => BlockDirection::East,
   787	            BlockDirection::East => BlockDirection::North,
   788	            _ => dir,
   789	        },
   790	    }

   175	/// A parsed `$` macro line: literal segments interleaved with variable names.
   176	///
   177	/// Port of vanilla's record `StringTemplate(List<String> segments,
   178	/// List<String> variables)` (`StringTemplate.java:7`); `segments.len()` is
   179	/// either `variables.len()` or `variables.len() + 1`.
   180	#[derive(Clone, Debug, PartialEq, Eq)]
   181	pub struct MacroTemplate {
   182	    pub segments: Vec<String>,
   183	    pub variables: Vec<String>,
   184	}
   185	
   186	impl MacroTemplate {
   187	    /// Parses the body of a `$` line (without the leading `$`).
   188	    ///
   189	    /// Port of `StringTemplate.fromString` (`StringTemplate.java:8-45`): a `$`
   190	    /// followed by `(` opens a variable closed by the next `)`; any other `$`
   191	    /// is a literal dollar sign. Fails with vanilla's messages for an
   192	    /// unterminated variable (`:20`), an invalid variable name (`:25`) and a
   193	    /// macro without any variable (`:37`).
   194	    pub fn from_string(input: &str) -> Result<Self, String> {
   195	        let bytes = input.as_bytes();
   196	        let mut segments = Vec::new();
   197	        let mut variables = Vec::new();
   198	        let mut start = 0usize;
   199	        let mut search = 0usize;
   200	
   201	        while let Some(index) = find_ascii_byte(bytes, search, b'$') {
   202	            // `input.charAt(index + 1) == '('` guard (`StringTemplate.java:16`);
   203	            // `$` and `(` are ASCII, so byte indexing cannot split a code point.
   204	            if index + 1 < bytes.len() && bytes[index + 1] == b'(' {
   205	                segments.push(input[start..index].to_string());
   206	
   207	                let Some(close) = find_ascii_byte(bytes, index + 2, b')') else {
   208	                    return Err("Unterminated macro variable".to_string());
   209	                };
   210	
   211	                let variable = &input[index + 2..close];
   212	                if !Self::is_valid_variable_name(variable) {
   213	                    return Err(format!("Invalid macro variable name '{variable}'"));
   214	                }
   215	
   216	                variables.push(variable.to_string());
   217	                start = close + 1;
   218	                search = start;
   219	            } else {
   220	                search = index + 1;
   221	            }
   222	        }
   223	
   224	        if start == 0 {
   225	            return Err("No variables in macro".to_string());
   226	        }
   227	
   228	        if start != bytes.len() {
   229	            segments.push(input[start..].to_string());
   230	        }
   231	
   232	        Ok(Self {
   233	            segments,
   234	            variables,
   235	        })
   236	    }
   237	
   238	    /// Port of `StringTemplate.isValidVariableName`
   239	    /// (`StringTemplate.java:47-56`): letters, digits and underscores.
   240	    fn is_valid_variable_name(variable: &str) -> bool {
   241	        variable.chars().all(|c| c.is_alphanumeric() || c == '_')
   242	    }
   243	
   244	    /// Substitutes concrete values for this template's variables.
   245	    ///
   246	    /// Port of `StringTemplate.substitute` (`StringTemplate.java:58-72`),
   247	    /// including the per-concatenation line-length guard of
   248	    /// `CommandFunction.checkCommandLineLength`
   249	    /// (`CommandFunction.java:89-94`).
   250	    ///
   251	    /// # Errors
   252	    /// Fails if `arguments` is shorter than the template's variable count
   253	    /// (cannot happen through [`LoadedFunction`], which always passes one value
   254	    /// per registered parameter) or if the resulting line exceeds
   255	    /// [`MAX_COMMAND_LINE_LENGTH`].
   256	    pub fn substitute(&self, arguments: &[String]) -> Result<String, String> {
   257	        let mut builder = String::new();
   258	
   259	        for (i, variable) in self.variables.iter().enumerate() {
   260	            let value = arguments
   261	                .get(i)
   262	                .ok_or_else(|| format!("Missing macro argument '{variable}' for template"))?;
   263	            builder.push_str(&self.segments[i]);
   264	            builder.push_str(value);
   265	            check_command_line_length(&builder)?;
   266	        }
   267	
   268	        // `segments.len() > variables.len()` guarantees a final segment exists.
   269	        if self.segments.len() > self.variables.len()
   270	            && let Some(last) = self.segments.last()
   271	        {
   272	            builder.push_str(last);
   273	        }
   274	
   275	        check_command_line_length(&builder)?;
   276	        Ok(builder)
   277	    }
   278	}

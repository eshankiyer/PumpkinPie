    70	      StructureTemplatePool centerPool = startPool.unwrapKey()
    71	         .flatMap(key -> pools.getOptional(poolAliasLookup.lookup((ResourceKey<StructureTemplatePool>)key)))
    72	         .orElse(startPool.value());
    73	      StructurePoolElement centerElement = centerPool.getRandomTemplate(random);
    74	      if (centerElement == EmptyPoolElement.INSTANCE) {
    75	         return Optional.empty();
    76	      }
    77	
    78	      BlockPos anchoredPosition;
    79	      if (startJigsaw.isPresent()) {
    80	         Identifier targetJigsawId = startJigsaw.get();
    81	         Optional<BlockPos> anchor = getRandomNamedJigsaw(centerElement, targetJigsawId, position, centerRotation, structureTemplateManager, random);

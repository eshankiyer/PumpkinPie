   247	struct LocateBiomeExecutor;
   248	
   249	impl CommandExecutor for LocateBiomeExecutor {
   250	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   251	        Box::pin(async move {
   252	            // Vanilla obtains this through `ResourceOrTagArgument.getResourceOrTag`
   253	            // (`ResourceOrTagArgument.java:52-64`) before resolving the biome.

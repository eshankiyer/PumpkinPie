    28	
    29	impl BlockStateProvider {
    30	    pub fn get_for_bonemeal(
    31	        &self,
    32	        random: &mut RandomGenerator,
    33	        pos: BlockPos,
    34	    ) -> Option<&'static BlockState> {
    35	        match self {
    36	            Self::NoiseThreshold(provider) => Some(provider.get(random, pos)),
    37	            Self::NoiseProvider(provider) => Some(provider.get(pos)),
    38	            Self::Simple(provider) => Some(provider.get(pos)),
    39	            Self::Weighted(provider) => Some(provider.get(random)),
    40	            Self::DualNoise(provider) => Some(provider.get(pos)),
    41	            Self::Pillar(provider) => Some(provider.get(random)),
    42	            Self::RandomizedInt(_) | Self::Rule(_) => None,
    43	        }
    44	    }
    45	
    46	    pub fn get<T: GenerationCache>(
    47	        &self,
    48	        random: &mut RandomGenerator,
    49	        pos: BlockPos,
    50	        chunk: &T,
    51	        block_registry: &dyn WorldPortalExt,
    52	    ) -> &'static BlockState {
    53	        match self {
    54	            Self::NoiseThreshold(provider) => provider.get(random, pos),
    55	            Self::NoiseProvider(provider) => provider.get(pos),
    56	            Self::Simple(provider) => provider.get(pos),
    57	            Self::Weighted(provider) => provider.get(random),
    58	            Self::DualNoise(provider) => provider.get(pos),
    59	            Self::Pillar(provider) => provider.get(random),
    60	            Self::RandomizedInt(provider) => provider.get(random, pos, chunk, block_registry),
    61	            Self::Rule(provider) => provider.get(block_registry, chunk, random, pos),
    62	        }
    63	    }
    64	
    65	    pub fn get_with_context<T: GenerationCache>(
    66	        &self,
    67	        block_registry: &dyn WorldPortalExt,
    68	        chunk: &T,
    69	        random: &mut RandomGenerator,
    70	        pos: BlockPos,
    71	    ) -> &'static BlockState {
    72	        match self {
    73	            Self::Rule(provider) => provider.get(block_registry, chunk, random, pos),
    74	            _ => self.get(random, pos, chunk, block_registry),
    75	        }
    76	    }
    77	
    78	    pub fn get_optional<T: GenerationCache>(
    79	        &self,
    80	        block_registry: &dyn WorldPortalExt,
    81	        chunk: &T,
    82	        random: &mut RandomGenerator,
    83	        pos: BlockPos,
    84	    ) -> Option<&'static BlockState> {
    85	        match self {
    86	            Self::Rule(provider) => provider.get_optional(block_registry, chunk, random, pos),
    87	            _ => Some(self.get(random, pos, chunk, block_registry)),
    88	        }
    89	    }

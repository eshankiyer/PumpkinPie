    56	
    57	impl ItemBehaviour for MinecartItem {
    58	    fn use_on_block<'a>(
    59	        &'a self,
    60	        item: &'a mut ItemStack,
    61	        player: &'a Player,
    62	        location: BlockPos,
    63	        _face: BlockDirection,
    64	        _cursor_pos: Vector3<f32>,
    65	        block: &'a Block,
    66	        _server: &'a Server,
    67	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    68	        Box::pin(async move {
    69	            let world = player.world();
    70	
    71	            if !block.has_tag(&tag::Block::MINECRAFT_RAILS) {
    72	                return;
    73	            }
    74	            let state_id = world.get_block_state_id(&location);
    75	            let is_ascending = if PoweredRailLikeProperties::handles_block_id(block.id) {
    76	                PoweredRailLikeProperties::from_state_id(state_id, block)
    77	                    .shape
    78	                    .is_ascending()
    79	            } else {
    80	                RailLikeProperties::from_state_id(state_id, block)
    81	                    .shape
    82	                    .is_ascending()
    83	            };
    84	            let height = if is_ascending { 0.5 } else { 0.0 };
    85	            let entity_type = Self::item_to_entity(item.item);
    86	            let pos = location.to_f64();
    87	            let entity = Entity::new(
    88	                world.clone(),
    89	                Vector3::new(pos.x, pos.y + 0.0625 + height, pos.z),
    90	                entity_type,
    91	            );
    92	            let minecart_entity = Arc::new(MinecartEntity::new(entity));
    93	            world.spawn_entity(minecart_entity).await;
    94	
    95	            // Vanilla: `serverLevel.gameEvent(GameEvent.ENTITY_PLACE, pos, Context.of(player,
    96	            // blockState below))`. Pumpkin's `GameEventContext` has no block-state-carrying
    97	            // variant yet, so only the entity source is passed.
    98	            if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id) {
    99	                emit_game_event(
   100	                    &world,
   101	                    GameEvent::EntityPlace,
   102	                    pos,
   103	                    GameEventContext::of_entity(player_arc),
   104	                )
   105	                .await;
   106	            }
   107	
   108	            // Vanilla `MinecartItem#useOn` ends with `itemStack.shrink(1)`.
   109	            item.decrement_unless_creative(player.gamemode.load(), 1);
   110	        })
   111	    }
   112	
   113	    fn as_any(&self) -> &dyn std::any::Any {
   114	        self
   115	    }
   116	}

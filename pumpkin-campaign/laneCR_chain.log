   484	    /// `SculkVeinBlock.onDischarged` (lines 69-87): strip any face pointing at a now-
   485	    /// `SCULK` neighbour; revert to air/water if no faces remain.
   486	    fn on_discharged<'a>(
   487	        &'a self,
   488	        world: &'a dyn SculkWorld,
   489	        pos: BlockPos,
   490	        _random: &'a mut RandomGenerator,
   491	    ) -> BlockFuture<'a, ()> {
   492	        Box::pin(async move {
   493	            let existing_state = world.accessor().get_block_state(&pos);
   494	            let Some(mut faces) = existing_vein_faces(existing_state) else {
   495	                return;
   496	            };
   497	
   498	            for direction in BlockDirection::all() {
   499	                if faces.contains(direction) {
   500	                    let neighbour = pos.offset(direction.to_offset());
   501	                    if world.accessor().get_block(&neighbour) == &Block::SCULK {
   502	                        faces = faces.without(direction);
   503	                    }
   504	                }
   505	            }
   506	
   507	            let new_state_id = if faces.is_empty() {
   508	                if world.accessor().get_fluid(&pos) == pumpkin_data::fluid::Fluid::EMPTY {
   509	                    Block::AIR.default_state.id
   510	                } else {
   511	                    Block::WATER.default_state.id
   512	                }
   513	            } else {
   514	                let mut props =
   515	                    GlowLichenLikeProperties::from_state_id(existing_state.id, &Block::SCULK_VEIN);
   516	                props.set_faces(faces);
   517	                props.to_state_id(&Block::SCULK_VEIN)
   518	            };
   519	            world.set_block(pos, new_state_id).await;
   520	        })
   521	    }

    78	               ReadOnlyScoreInfo scoreInfo = scoreboard.getPlayerScoreInfo(entity, objective);
    79	               if (scoreInfo != null && !scoreInfo.isLocked()) {
    80	                  result.add(objective.getName());
    81	               }
    82	            }
    83	         }
    84	      }

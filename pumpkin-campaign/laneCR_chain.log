    97	      BlockPos adjustedPosition = position.subtract(localAnchorPosition);
    98	      PoolElementStructurePiece centerPiece = new PoolElementStructurePiece(
    99	         structureTemplateManager,
   100	         centerElement,
   101	         adjustedPosition,
   102	         centerElement.getGroundLevelDelta(),
   103	         centerRotation,
   104	         centerElement.getBoundingBox(structureTemplateManager, adjustedPosition, centerRotation),
   105	         liquidSettings
   106	      );

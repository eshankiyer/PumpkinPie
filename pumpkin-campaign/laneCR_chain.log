   211	/// `TreeGrower.growTree` (`TreeGrower.java:127-179`).
   212	///
   213	/// The sapling is cleared before the feature runs and restored if the feature declines. Here
   214	/// both the clear and the tree are buffered in one [`FeatureCache`], so declining simply means
   215	/// never committing - see `crate::world::feature_placer`.
   216	///
   217	/// Divergence: vanilla replaces the sapling with `getFluidState(pos).createLegacyBlock()`, which
   218	/// only differs from air for a waterlogged propagule, and propagules are not grown here.
   219	async fn grow_tree(world: &Arc<World>, pos: &BlockPos, block: &Block) -> bool {
   220	    let Some(grower) = grower_for(block) else {
   221	        return false;
   222	    };
   223	    let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(rand::rng().random()));
   224	    let air = Block::AIR.default_state.id;
   225	
   226	    if let Some(mega) = grower.mega_feature(&mut random) {
   227	        for dx in [0, -1] {
   228	            for dz in [0, -1] {
   229	                if !is_two_by_two(world, pos, block, dx, dz) {
   230	                    continue;
   231	                }
   232	                let mut cache = FeatureCache::new(world);
   233	                for (ox, oz) in [(dx, dz), (dx + 1, dz), (dx, dz + 1), (dx + 1, dz + 1)] {
   234	                    cache.set_block(pos.offset(Vector3::new(ox, 0, oz)), air);
   235	                }
   236	                let base = pos.offset(Vector3::new(dx, 0, dz));
   237	                if cache.place(mega, base, &mut random) {
   238	                    return cache.commit().await;
   239	                }
   240	                return false;
   241	            }
   242	        }
   243	    }
   244	
   245	    let Some(feature) = grower.feature(&mut random, has_flowers(world, pos)) else {
   246	        return false;
   247	    };
   248	    let mut cache = FeatureCache::new(world);
   249	    cache.set_block(*pos, air);
   250	    if cache.place(feature, *pos, &mut random) {
   251	        cache.commit().await
   252	    } else {
   253	        false
   254	    }
   255	}
   256	
   257	/// `SaplingBlock.advanceTree` (`SaplingBlock.java:51-57`): stage 0 only ticks the stage up; from
   258	/// stage 1 the tree grows.
   259	async fn advance_tree(world: &Arc<World>, pos: &BlockPos, block: &Block, state_id: BlockStateId) {
   260	    if stage_of(block, state_id) == Some(0) {
   261	        if let Some(new_state_id) = with_stage(block, state_id, "1") {
   262	            world
   263	                .set_block_state(pos, new_state_id, BlockFlags::NOTIFY_ALL)
   264	                .await;
   265	        }
   266	        return;
   267	    }
   268	    grow_tree(world, pos, block).await;
   269	}

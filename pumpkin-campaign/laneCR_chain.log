   211	struct SetTriggerExecutor;
   212	
   213	impl CommandExecutor for SetTriggerExecutor {
   214	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   215	        Box::pin(async move {
   216	            let player = context.source.player_or_err()?;
   217	            let player_name = &player.gameprofile.name;
   218	            let objective_name = ObjectiveArgumentType::get(context, ARG_OBJECTIVE)?;
   219	            let value = IntegerArgumentType::get(context, ARG_VALUE)?;
   220	
   221	            let world = context.world();
   222	            let mut scoreboard = world.scoreboard.lock().await;
   223	
   224	            let objective = scoreboard
   225	                .get_objectives()
   226	                .get(objective_name)
   227	                .ok_or_else(|| INVALID_TRIGGER_ERROR.create_without_context())?;
   228	
   229	            if &*objective.criterion != "trigger" {
   230	                return Err(INVALID_TRIGGER_ERROR.create_without_context());
   231	            }
   232	
   233	            let objective_display_name = objective.display_name.clone();
   234	
   235	            let is_locked = scoreboard
   236	                .get_scores()
   237	                .get(objective_name)
   238	                .and_then(|m| m.get(player_name))
   239	                .is_none_or(|s| s.locked);
   240	
   241	            if is_locked {
   242	                return Err(UNPRIMED_TRIGGER_ERROR.create_without_context());
   243	            }
   244	
   245	            let updated_score = ScoreboardScore {
   246	                entity_name: player_name.clone(),
   247	                objective_name: objective_name.to_string(),
   248	                value: VarInt(value),
   249	                display_name: None,
   250	                number_format: None,
   251	                locked: true,
   252	            };
   253	
   254	            scoreboard.update_score(world, updated_score).await;
   255	
   256	            context
   257	                .source
   258	                .send_feedback(
   259	                    TextComponent::translate_cross(
   260	                        translation::java::COMMANDS_TRIGGER_SET_SUCCESS,
   261	                        translation::java::COMMANDS_TRIGGER_SET_SUCCESS,
   262	                        [
   263	                            objective_display_name,
   264	                            TextComponent::text(value.to_string()),
   265	                        ],
   266	                    ),
   267	                    false,
   268	                )
   269	                .await;
   270	
   271	            Ok(value)
   272	        })
   273	    }
   274	}

   416	        let t = template("tp $(x) $(y) $(z)");
   417	        assert_eq!(t.variables, vec!["x", "y", "z"]);
   418	        assert_eq!(t.segments, vec!["tp ", " ", " "]);
   419	    }
   420	
   421	    #[test]
   422	    fn literal_dollar_is_not_a_variable() {
   423	        // `$$(` is a literal `$` followed by a variable open paren.
   424	        let t = template("cost $$(price)");
   425	        assert_eq!(t.variables, vec!["price".to_string()]);
   426	        assert_eq!(t.segments, vec!["cost $".to_string()]);
   427	    }
   428	
   429	    #[test]

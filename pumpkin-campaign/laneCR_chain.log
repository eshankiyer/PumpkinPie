    65	            }
    66	         );
    67	         level.playSound(null, pos, SoundEvents.PUMPKIN_CARVE, SoundSource.BLOCKS, 1.0F, 1.0F);
    68	         level.setBlock(pos, Blocks.CARVED_PUMPKIN.defaultBlockState().setValue(CarvedPumpkinBlock.FACING, direction), 11);
    69	         itemStack.hurtAndBreak(1, player, hand.asEquipmentSlot());
    70	         level.gameEvent(player, GameEvent.SHEAR, pos);
    71	         player.awardStat(Stats.ITEM_USED.get(Items.SHEARS));
    72	         return InteractionResult.SUCCESS;
    73	      } else {
    74	         return InteractionResult.SUCCESS;
    75	      }

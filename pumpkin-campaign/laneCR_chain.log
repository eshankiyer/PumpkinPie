     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_player_input(
     6	        &self,
     7	        player: &Arc<Player>,
     8	        input: SPlayerInput,
     9	        server: &Arc<Server>,
    10	    ) {
    11	        let mut input_event =
    12	            crate::plugin::api::events::player::player_input::PlayerInputEvent::new(
    13	                player.clone(),
    14	                format!("{:b}", input.input),
    15	            );
    16	        server.plugin_manager.fire(server, &mut input_event).await;
    17	        if input_event.cancelled {
    18	            return;
    19	        }
    20	
    21	        player.last_input.store(input.input, Ordering::Relaxed);
    22	
    23	        let sneak = input.input & SPlayerInput::SNEAK != 0;
    24	        if sneak
    25	            && player.gamemode.load() == GameMode::Spectator
    26	            && player.camera_target_id.load().is_some()
    27	        {
    28	            player.camera_target_id.store(None);
    29	            player
    30	                .send_client_packet(&CSetCamera::new(player.entity_id().into()))
    31	                .await;
    32	        }
    33	
    34	        if player.get_entity().is_sneaking() != sneak {
    35	            send_cancellable! {{
    36	                server;
    37	                PlayerToggleSneakEvent::new(player.clone(), sneak);
    38	                'after: {
    39	                    player.get_entity().set_sneaking(event.is_sneaking).await;
    40	                    if event.is_sneaking {
    41	                        let vehicle = player.get_entity().vehicle.lock().await.clone();
    42	                        if let Some(vehicle) = vehicle {
    43	                            vehicle
    44	                                .get_entity()
    45	                                .remove_passenger(player.entity_id())
    46	                                .await;
    47	                        }
    48	                    }
    49	                }
    50	            }}
    51	        } else if sneak {
    52	            let vehicle = player.get_entity().vehicle.lock().await.clone();
    53	            if let Some(vehicle) = vehicle {
    54	                vehicle
    55	                    .get_entity()
    56	                    .remove_passenger(player.entity_id())
    57	                    .await;
    58	            }
    59	        }
    60	    }
    61	}

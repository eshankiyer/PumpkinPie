   330	/// `MemorySlot<T>` (`memory/MemorySlot.java`). `time_to_live: None` is vanilla's
   331	/// `NEVER_EXPIRE` (`Long.MAX_VALUE`, `:7`).
   332	struct MemorySlot {
   333	    value: Option<Box<dyn Any + Send>>,
   334	    time_to_live: Option<i64>,
   335	}
   336	
   337	impl MemorySlot {
   338	    const fn empty() -> Self {
   339	        Self {
   340	            value: None,
   341	            time_to_live: None,
   342	        }
   343	    }
   344	
   345	    /// `MemorySlot.tick()` (`memory/MemorySlot.java:16-24`): only ticks when a value is
   346	    /// present *and* the slot can expire, clears at `<= 0` before decrementing.
   347	    fn tick(&mut self) {
   348	        if self.value.is_none() {
   349	            return;
   350	        }
   351	        if let Some(ttl) = self.time_to_live {
   352	            if ttl <= 0 {
   353	                self.value = None;
   354	                self.time_to_live = None;
   355	            } else {
   356	                self.time_to_live = Some(ttl - 1);
   357	            }
   358	        }
   359	    }
   360	
   361	    const fn has_value(&self) -> bool {
   362	        self.value.is_some()
   363	    }
   364	}
   365	
   366	/// The memory map of a `Brain` (`Brain.java:40`).
   367	///
   368	/// LOCK ORDER: this store's mutex is a leaf. Never acquire it while holding the mob's
   369	/// `navigator`, `look_control` or `move_control` lock; read what you need into locals, drop
   370	/// this guard, then take the controller lock. Every accessor here is a plain field access, so
   371	/// no guard ever needs to survive an `.await`.
   372	pub struct MemoryStore {
   373	    slots: Vec<MemorySlot>,
   374	    registered: Vec<bool>,
   375	}
   376	
   377	impl Default for MemoryStore {
   378	    fn default() -> Self {
   379	        Self::new()
   380	    }
   381	}
   382	
   383	impl MemoryStore {
   384	    #[must_use]
   385	    pub fn new() -> Self {
   386	        debug_assert_eq!(MemoryKeyId::COUNT, MemoryKeyId::ALL.len());
   387	        Self {
   388	            slots: (0..MemoryKeyId::COUNT)
   389	                .map(|_| MemorySlot::empty())
   390	                .collect(),
   391	            registered: vec![false; MemoryKeyId::COUNT],
   392	        }
   393	    }
   394	
   395	    /// `Brain.registerMemory` (`Brain.java:78-89`), called for every memory a sensor writes
   396	    /// and every memory a behavior lists as a required memory.
   397	    pub fn register(&mut self, id: MemoryKeyId) {
   398	        self.registered[id.index()] = true;
   399	    }
   400	
   401	    #[must_use]
   402	    pub fn is_registered(&self, id: MemoryKeyId) -> bool {
   403	        self.registered[id.index()]
   404	    }
   405	
   406	    #[must_use]
   407	    pub fn get<K: MemoryKey>(&self) -> Option<&K::Value> {
   408	        self.slots[K::ID.index()]
   409	            .value
   410	            .as_ref()
   411	            .and_then(|value| value.downcast_ref::<K::Value>())
   412	    }
   413	
   414	    pub fn set<K: MemoryKey>(&mut self, value: K::Value) {
   415	        // `Brain.setMemoryInternal` clears empty collections instead of storing them
   416	        // (`Brain.java:201-213`).
   417	        if is_empty_collection(&value) {
   418	            self.erase_by_id(K::ID);
   419	        } else {
   420	            self.slots[K::ID.index()] = MemorySlot {
   421	                value: Some(Box::new(value)),
   422	                time_to_live: None,
   423	            };
   424	        }
   425	    }
   426	
   427	    pub fn set_with_expiry<K: MemoryKey>(&mut self, value: K::Value, time_to_live: i64) {
   428	        // The expiry overload applies the same empty-collection clearing rule
   429	        // (`Brain.java:186-199`).
   430	        if is_empty_collection(&value) {
   431	            self.erase_by_id(K::ID);
   432	        } else {
   433	            self.slots[K::ID.index()] = MemorySlot {
   434	                value: Some(Box::new(value)),
   435	                time_to_live: Some(time_to_live),
   436	            };
   437	        }
   438	    }
   439	
   440	    pub fn erase<K: MemoryKey>(&mut self) {
   441	        self.erase_by_id(K::ID);
   442	    }
   443	
   444	    pub fn erase_by_id(&mut self, id: MemoryKeyId) {
   445	        self.slots[id.index()] = MemorySlot::empty();
   446	    }
   447	
   448	    #[must_use]
   449	    pub fn has_value<K: MemoryKey>(&self) -> bool {
   450	        self.slots[K::ID.index()].has_value()
   451	    }
   452	
   453	    /// `Brain.getTimeUntilExpiry` (`Brain.java:225-227`) via `MemorySlot.timeToLive`
   454	    /// (`memory/MemorySlot.java:59-61`). A slot with no expiry (`time_to_live: None`) reports
   455	    /// vanilla's `NEVER_EXPIRE` sentinel (`Long.MAX_VALUE`).
   456	    #[must_use]
   457	    pub fn time_until_expiry<K: MemoryKey>(&self) -> i64 {
   458	        self.slots[K::ID.index()].time_to_live.unwrap_or(i64::MAX)
   459	    }
   460	
   461	    /// `Brain.checkMemory` (`Brain.java:242-249`). Note the leading null check: an
   462	    /// unregistered memory fails *every* status, including `REGISTERED`.
   463	    #[must_use]
   464	    pub fn check(&self, id: MemoryKeyId, status: MemoryStatus) -> bool {
   465	        if !self.registered[id.index()] {
   466	            return false;
   467	        }
   468	        match status {
   469	            MemoryStatus::Registered => true,
   470	            MemoryStatus::ValuePresent => self.slots[id.index()].has_value(),
   471	            MemoryStatus::ValueAbsent => !self.slots[id.index()].has_value(),
   472	        }
   473	    }
   474	
   475	    /// `Brain.forgetOutdatedMemories` (`Brain.java:397-399`), the first of the four steps of
   476	    /// `Brain.tick`.
   477	    pub fn tick_expiry(&mut self) {
   478	        for slot in &mut self.slots {
   479	            slot.tick();
   480	        }
   481	    }
   482	
   483	    /// `Brain.clearMemories` (`Brain.java:154-156`).
   484	    pub fn clear(&mut self) {
   485	        for slot in &mut self.slots {
   486	            *slot = MemorySlot::empty();
   487	        }
   488	    }
   489	
   490	    /// `Brain.memories.isEmpty()` (`Brain.java:454-455`): registration creates the slots, so
   491	    /// an empty memory store has no registered memory modules.
   492	    #[must_use]
   493	    pub fn is_empty(&self) -> bool {
   494	        self.registered.iter().all(|registered| !registered)
   495	    }
   496	}
   497	
   498	/// `Brain.isEmptyCollection` (`Brain.java:186-213`) applies to the collection-valued memory
   499	/// keys represented in this port.
   500	fn is_empty_collection(value: &dyn Any) -> bool {
   501	    value
   502	        .downcast_ref::<Vec<Weak<dyn EntityBase>>>()
   503	        .is_some_and(Vec::is_empty)
   504	        || value
   505	            .downcast_ref::<NearestVisibleLivingEntities>()
   506	            .is_some_and(|entities| entities.entities.is_empty())
   507	}

   186	#[derive(Clone, Debug, Default)]
   187	pub enum PosRuleTest {
   188	    #[default]
   189	    AlwaysTrue,
   190	    LinearPos {
   191	        min_dist: i32,
   192	        max_dist: i32,
   193	        min_chance: f32,
   194	        max_chance: f32,
   195	    },
   196	    AxisAlignedLinearPos {
   197	        axis: Axis,
   198	        min_dist: i32,
   199	        max_dist: i32,
   200	        min_chance: f32,
   201	        max_chance: f32,
   202	    },
   203	}
   204	
   205	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
   206	pub enum Axis {
   207	    X,
   208	    #[default]
   209	    Y,
   210	    Z,
   211	}
   212	
   213	impl PosRuleTest {
   214	    #[must_use]
   215	    pub fn test(
   216	        &self,
   217	        pos: Vector3<i32>,
   218	        structure_start: Vector3<i32>,
   219	        rng: &mut impl RandomImpl,
   220	    ) -> bool {
   221	        match self {
   222	            Self::AlwaysTrue => true,
   223	            Self::LinearPos {
   224	                min_dist,
   225	                max_dist,
   226	                min_chance,
   227	                max_chance,
   228	            } => {
   229	                let dx = (pos.x - structure_start.x).abs();
   230	                let dy = (pos.y - structure_start.y).abs();
   231	                let dz = (pos.z - structure_start.z).abs();
   232	                let dist = dx + dy + dz;
   233	                let chance =
   234	                    calculate_linear_chance(dist, *min_dist, *max_dist, *min_chance, *max_chance);
   235	                rng.next_f32() < chance
   236	            }
   237	            Self::AxisAlignedLinearPos {
   238	                axis,
   239	                min_dist,
   240	                max_dist,
   241	                min_chance,
   242	                max_chance,
   243	            } => {
   244	                let dist = match axis {
   245	                    Axis::X => (pos.x - structure_start.x).abs(),
   246	                    Axis::Y => (pos.y - structure_start.y).abs(),
   247	                    Axis::Z => (pos.z - structure_start.z).abs(),
   248	                };
   249	                let chance =
   250	                    calculate_linear_chance(dist, *min_dist, *max_dist, *min_chance, *max_chance);
   251	                rng.next_f32() < chance
   252	            }
   253	        }
   254	    }
   255	}
   256	
   257	fn calculate_linear_chance(
   258	    dist: i32,
   259	    min_dist: i32,
   260	    max_dist: i32,
   261	    min_chance: f32,
   262	    max_chance: f32,
   263	) -> f32 {
   264	    if max_dist <= min_dist {
   265	        if dist <= min_dist {
   266	            min_chance.clamp(0.0, 1.0)
   267	        } else {
   268	            max_chance.clamp(0.0, 1.0)
   269	        }
   270	    } else if dist <= min_dist {
   271	        min_chance.clamp(0.0, 1.0)
   272	    } else if dist >= max_dist {
   273	        max_chance.clamp(0.0, 1.0)
   274	    } else {
   275	        let t = (dist - min_dist) as f32 / (max_dist - min_dist) as f32;
   276	        (t * (max_chance - min_chance) + min_chance).clamp(0.0, 1.0)
   277	    }
   278	}

   249	        for (key, value) in kv_pairs {
   250	            buf.extend_from_slice(CString::new(*key).ok()?.as_bytes_with_nul());
   251	            buf.extend_from_slice(value.as_bytes_with_nul());
   252	        }
   253	
   254	        // End padding + null terminator for the key-value section.
   255	        buf.extend_from_slice(&PADDING_END);
   256	
   257	        // Player list, each null-terminated, followed by a final null.
   258	        for player in &self.players {
   259	            buf.extend_from_slice(player.as_bytes_with_nul());
   260	        }
   261	        buf.push(0x00);
   262	
   263	        Some(buf)
   264	    }
   265	}

     1	#[allow(clippy::wildcard_imports)]
     2	use super::*;
     3	
     4	impl JavaClient {
     5	    pub async fn handle_resource_pack_response(
     6	        &self,
     7	        server: &Server,
     8	        packet: SConfigResourcePack,
     9	    ) {
    10	        let resource_config = &server.advanced_config.resource_pack.java;
    11	        if resource_config.enabled {
    12	            let expected_uuid =
    13	                uuid::Uuid::new_v3(&uuid::Uuid::NAMESPACE_DNS, resource_config.url.as_bytes());
    14	
    15	            if packet.uuid == expected_uuid {
    16	                match packet.response_result() {
    17	                    ResourcePackResponseResult::DownloadSuccess => {
    18	                        trace!(
    19	                            "Client {} successfully downloaded the resource pack",
    20	                            self.id
    21	                        );
    22	                    }
    23	                    ResourcePackResponseResult::DownloadFail => {
    24	                        warn!(
    25	                            "Client {} failed to downloaded the resource pack. Is it available on the internet?",
    26	                            self.id
    27	                        );
    28	                    }
    29	                    ResourcePackResponseResult::Downloaded => {
    30	                        trace!("Client {} already has the resource pack", self.id);
    31	                    }
    32	                    ResourcePackResponseResult::Accepted => {
    33	                        trace!("Client {} accepted the resource pack", self.id);
    34	
    35	                        // Return here to wait for the next response update
    36	                        return;
    37	                    }
    38	                    ResourcePackResponseResult::Declined => {
    39	                        trace!("Client {} declined the resource pack", self.id);
    40	                    }
    41	                    ResourcePackResponseResult::InvalidUrl => {
    42	                        warn!(
    43	                            "Client {} reported that the resource pack URL is invalid!",
    44	                            self.id
    45	                        );
    46	                    }
    47	                    ResourcePackResponseResult::ReloadFailed => {
    48	                        trace!("Client {} failed to reload the resource pack", self.id);
    49	                    }
    50	                    ResourcePackResponseResult::Discarded => {
    51	                        trace!("Client {} discarded the resource pack", self.id);
    52	                    }
    53	                    ResourcePackResponseResult::Unknown(result) => {
    54	                        warn!(
    55	                            "Client {} responded with a bad result: {}!",
    56	                            self.id, result
    57	                        );
    58	                    }
    59	                }
    60	            } else {
    61	                warn!(
    62	                    "Client {} returned a response for a resource pack we did not set!",
    63	                    self.id
    64	                );
    65	            }
    66	        } else {
    67	            warn!(
    68	                "Client {} returned a response for a resource pack that was not enabled!",
    69	                self.id
    70	            );
    71	        }
    72	        self.send_known_packs().await;
    73	    }
    74	
    75	    pub async fn send_known_packs(&self) {
    76	        let version_str = self.version.load().to_string();
    77	        self.send_packet(&CKnownPacks::new(&[KnownPack {
    78	            namespace: "minecraft",
    79	            id: "core",
    80	            version: &version_str,
    81	        }]))
    82	        .await;
    83	    }
    84	}


    96	        Box::pin(async move {
    97	            let Some(witch) = mob.cast_any().downcast_ref::<WitchEntity>() else {
    98	                return false;
    99	            };
   100	            if witch.heal_cooldown.load(Relaxed) > 0 {
   101	                return false;
   102	            }

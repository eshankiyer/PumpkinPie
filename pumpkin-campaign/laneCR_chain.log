   511	fn block_item_place_sound(block: &Block) -> (Sound, f32, f32) {
   512	    // BlockItem gets the sound and its volume/pitch from the placed state's SoundType
   513	    // (`BlockItem.java:86-87`; `SoundType.java:1-11, 47-54`). The generated block data does not
   514	    // retain SoundType, so use exact generated sound names first and the shared families used by
   515	    // the vanilla block definitions (`Blocks.java:96-99, 627-638, 1038-1050`).
   516	    let direct_name = format!("block.{}.place", block.name);
   517	    let family_name = match block.name {
   518	        "anvil" => "block.anvil.place",
   519	        name if name.ends_with("_wool") || name.ends_with("_carpet") => "block.wool.place",
   520	        "glass" | "glass_pane" => "block.glass.place",
   521	        "iron_block" => "block.iron.place",
   522	        "gold_block" => "block.metal.place",
   523	        name if name.starts_with("copper") => "block.copper.place",
   524	        name if name.starts_with("deepslate") => "block.deepslate.place",
   525	        name if name.ends_with("_planks")
   526	            || name.ends_with("_log")
   527	            || name.ends_with("_wood")
   528	            || name.ends_with("_hyphae")
   529	            || name.ends_with("_stem") =>
   530	        {
   531	            "block.wood.place"
   532	        }
   533	        _ => "block.stone.place",
   534	    };
   535	    let sound = Sound::from_name(&direct_name)
   536	        .or_else(|| Sound::from_name(family_name))
   537	        .unwrap_or(Sound::BlockStonePlace);
   538	    let (volume, pitch) = match block.name {
   539	        "anvil" => (0.3, 1.0),
   540	        "iron_block" | "gold_block" => (1.0, 1.5),
   541	        _ => (1.0, 1.0),
   542	    };
   543	    (sound, f32::midpoint(volume, 1.0), pitch * 0.8)
   544	}

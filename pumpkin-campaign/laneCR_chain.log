   131	/// `mobGriefing` is enabled. The collision dispatcher already supplies the server world and the
   132	/// colliding entity, so this is shared by the concrete crops that extend vanilla `CropBlock`.
   133	pub async fn ravager_destroy_crop(
   134	    world: &Arc<World>,
   135	    position: &BlockPos,
   136	    entity: &dyn EntityBase,
   137	) {
   138	    if entity.get_entity().entity_type == &EntityType::RAVAGER
   139	        && world.level_info.load().game_rules.mob_griefing

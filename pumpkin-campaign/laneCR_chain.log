   129	struct OutgoingPacket {
   130	    data: Bytes,
   131	    completion: Option<oneshot::Sender<()>>,
   132	}
   133	
   134	impl OutgoingPacket {
   135	    const fn normal(data: Bytes) -> Self {
   136	        Self {
   137	            data,
   138	            completion: None,
   139	        }
   140	    }
   141	
   142	    const fn high_priority(data: Bytes, completion: oneshot::Sender<()>) -> Self {
   143	        Self {
   144	            data,
   145	            completion: Some(completion),
   146	        }
   147	    }
   148	}

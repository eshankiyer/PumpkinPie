   336	        }
   337	    }
   338	
   339	    /// Calculates orientation for wall-hanging signs.
   340	    fn calculate_wall_hanging_orientation(
   341	        args: &OnPlaceArgs,
   342	        support: &SupportInfo,
   343	        is_sneaking: bool,
   344	    ) -> (Option<String>, Option<u8>, bool) {
   345	        let wall_dir = if args.direction.is_horizontal() {
   346	            args.direction
   347	        } else {
   348	            support.side_direction.unwrap_or(args.direction)
   349	        };
   350	
   351	        let player_yaw = args.player.get_entity().yaw.load();
   352	        let facing = Self::calculate_wall_hanging_facing(wall_dir, player_yaw);
   353	
   354	        let player_rot = args.player.get_entity().get_flipped_rotation_16();
   355	        let rotation = Self::calculate_wall_hanging_rotation(wall_dir, player_rot, is_sneaking);
   356	
   357	        let is_angled = rotation % 4 != 0;
   358	        let attached = is_angled || is_sneaking;
   359	
   360	        (Some(facing.to_string()), Some(rotation), attached)
   361	    }
   362	
   363	    /// Calculates orientation for ceiling-hanging signs.
   364	    fn calculate_ceiling_orientation(
   365	        args: &OnPlaceArgs,
   366	        is_sneaking: bool,
   367	    ) -> (Option<String>, Option<u8>, bool) {
   368	        let rotation = if is_sneaking {
   369	            args.player.get_entity().get_flipped_rotation_16()
   370	        } else {
   371	            // Snap to nearest cardinal
   372	            let index = args.player.get_entity().get_flipped_rotation_16();
   373	            ((index + 2) / 4 * 4) % 16
   374	        };
   375	
   376	        let is_angled = rotation % 4 != 0;
   377	        let attached = is_angled || is_sneaking;
   378	
   379	        (None, Some(rotation), attached)
   380	    }

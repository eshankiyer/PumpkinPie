   640	    /// A `SpreadTarget` writing into a shared, in-memory `occupied` set, so tests can
   641	    /// assert on read/write interleaving without a real `World`. `BlockAccessor` is
   642	    /// implemented directly on the mutex-guarded state, locking per call, so
   643	    /// `accessor()` can hand out `&self` without holding a guard across the borrow.
   644	    struct RecordingTarget {
   645	        occupied: Mutex<HashSet<BlockPos>>,
   646	        default: &'static BlockState,
   647	    }
   648	
   649	    impl RecordingTarget {
   650	        fn new(default: &'static BlockState) -> Self {
   651	            Self {
   652	                occupied: Mutex::new(HashSet::new()),
   653	                default,
   654	            }
   655	        }
   656	
   657	        fn placed_count(&self) -> usize {
   658	            self.occupied.lock().unwrap().len()
   659	        }
   660	    }
   661	
   662	    impl BlockAccessor for RecordingTarget {
   663	        fn get_block(&self, position: &BlockPos) -> &'static Block {
   664	            Block::from_state_id(self.get_block_state(position).id)
   665	        }
   666	
   667	        fn get_block_state(&self, position: &BlockPos) -> &'static BlockState {
   668	            if self.occupied.lock().unwrap().contains(position) {
   669	                Block::STONE.default_state
   670	            } else {
   671	                self.default
   672	            }
   673	        }
   674	
   675	        fn get_block_state_id(&self, position: &BlockPos) -> pumpkin_data::BlockStateId {
   676	            self.get_block_state(position).id
   677	        }
   678	
   679	        fn get_block_and_state(
   680	            &self,
   681	            position: &BlockPos,
   682	        ) -> (&'static Block, &'static BlockState) {
   683	            let state = self.get_block_state(position);
   684	            (Block::from_state_id(state.id), state)
   685	        }
   686	
   687	        fn get_fluid(&self, _position: &BlockPos) -> pumpkin_data::fluid::Fluid {
   688	            pumpkin_data::fluid::Fluid::EMPTY
   689	        }
   690	    }
   691	
   692	    impl SpreadTarget for RecordingTarget {
   693	        fn accessor(&self) -> &dyn BlockAccessor {
   694	            self
   695	        }
   696	
   697	        fn place(&self, spread_pos: SpreadPos) -> BlockFuture<'_, bool> {
   698	            Box::pin(async move {
   699	                let mut occupied = self.occupied.lock().unwrap();
   700	                if occupied.contains(&spread_pos.pos) {
   701	                    false
   702	                } else {
   703	                    occupied.insert(spread_pos.pos);
   704	                    true
   705	                }
   706	            })
   707	        }
   708	    }
   709	
   710	    #[tokio::test]
   711	    async fn spread_all_places_and_counts_successful_spreads() {
   712	        let target = RecordingTarget::new(Block::AIR.default_state);
   713	        let config = OpenAirConfig;
   714	        let faces = FaceSet::from_directions([BlockDirection::North]);
   715	        let pos = BlockPos::new(0, 0, 0);
   716	
   717	        let count = spread_all(&config, &target, faces, pos).await;
   718	        assert!(count > 0);
   719	
   720	        assert_eq!(count, target.placed_count() as u64);
   721	    }
   722	
   723	    #[tokio::test]
   724	    async fn spread_all_does_not_double_place_the_same_position() {
   725	        // SAME_POSITION candidates for every non-North spread direction all target the
   726	        // origin itself; only the first should succeed, later ones must see it already
   727	        // occupied and be rejected by `can_spread_into` — this only holds if writes and
   728	        // reads are interleaved rather than computed from a pre-collected snapshot.
   729	        let target = RecordingTarget::new(Block::AIR.default_state);
   730	        let config = OpenAirConfig;
   731	        let faces = FaceSet::from_directions([BlockDirection::North]);
   732	        let pos = BlockPos::new(0, 0, 0);
   733	
   734	        let count = spread_from_face_toward_all_directions(
   735	            &config,
   736	            &target,
   737	            faces,
   738	            pos,
   739	            BlockDirection::North,
   740	        )
   741	        .await;
   742	
   743	        // Exactly one spread direction (the first non-same-axis one tried, Down) can
   744	        // land its SAME_POSITION candidate at `pos`; every other direction must fall
   745	        // through to SAME_PLANE/WRAP_AROUND (different positions) or fail entirely.
   746	        assert!(count >= 1);
   747	        assert_eq!(count, target.placed_count() as u64);
   748	    }
   749	}


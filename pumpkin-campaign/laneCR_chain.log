     1	use crate::block::{
     2	    BlockBehaviour, BlockFuture, BlockMetadata, GetStateForNeighborUpdateArgs, OnPlaceArgs,
     3	};
     4	use pumpkin_data::block_properties::{BlockProperties, BrownMushroomBlockLikeProperties};
     5	use pumpkin_data::{BlockDirection, BlockId, BlockStateId};
     6	
     7	/// Shared behaviour for `red_mushroom_block`, `brown_mushroom_block`, and `mushroom_stem`.
     8	///
     9	/// Vanilla: `net.minecraft.world.level.block.HugeMushroomBlock`.
    10	type MushroomProperties = BrownMushroomBlockLikeProperties;
    11	
    12	pub struct HugeMushroomBlock;
    13	
    14	impl BlockMetadata for HugeMushroomBlock {
    15	    fn ids() -> Box<[BlockId]> {
    16	        [
    17	            BlockId::BROWN_MUSHROOM_BLOCK,
    18	            BlockId::RED_MUSHROOM_BLOCK,
    19	            BlockId::MUSHROOM_STEM,
    20	        ]
    21	        .into()
    22	    }
    23	}
    24	
    25	/// Sets the boolean face property corresponding to `direction` on `props`.
    26	///
    27	/// Mirrors `HugeMushroomBlock.PROPERTY_BY_DIRECTION` (backed by `PipeBlock.PROPERTY_BY_DIRECTION`).
    28	const fn set_face(props: &mut MushroomProperties, direction: BlockDirection, value: bool) {
    29	    match direction {
    30	        BlockDirection::Up => props.up = value,
    31	        BlockDirection::Down => props.down = value,
    32	        BlockDirection::North => props.north = value,
    33	        BlockDirection::South => props.south = value,
    34	        BlockDirection::East => props.east = value,
    35	        BlockDirection::West => props.west = value,
    36	    }
    37	}
    38	
    39	impl BlockBehaviour for HugeMushroomBlock {
    40	    /// `HugeMushroomBlock.getStateForPlacement`: every face starts "outward" (true) except
    41	    /// the ones touching an already-placed block of the exact same type (checked with `is(this)`,
    42	    /// i.e. same block id, not just any huge-mushroom block).
    43	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    44	        Box::pin(async move {
    45	            let mut props = MushroomProperties::default(args.block);
    46	            for direction in BlockDirection::all() {
    47	                let neighbor_pos = args.position.offset(direction.to_offset());
    48	                let neighbor_block = args.world.get_block(&neighbor_pos);
    49	                set_face(&mut props, direction, neighbor_block != args.block);
    50	            }
    51	            props.to_state_id(args.block)
    52	        })
    53	    }
    54	
    55	    /// `HugeMushroomBlock.updateShape`: only ever clears a face to `false` when the neighbor in
    56	    /// that direction is the exact same block; it never restores `true` (a one-way quirk that
    57	    /// matches vanilla and must not be "fixed").
    58	    fn get_state_for_neighbor_update<'a>(
    59	        &'a self,
    60	        args: GetStateForNeighborUpdateArgs<'a>,
    61	    ) -> BlockFuture<'a, BlockStateId> {
    62	        Box::pin(async move {
    63	            let neighbor_block = args.world.get_block(args.neighbor_position);
    64	            if neighbor_block != args.block {
    65	                return args.state_id;
    66	            }
    67	            let mut props = MushroomProperties::from_state_id(args.state_id, args.block);
    68	            set_face(&mut props, args.direction, false);
    69	            props.to_state_id(args.block)
    70	        })
    71	    }
    72	}
    73	
    74	#[cfg(test)]
    75	mod tests {
    76	    use super::*;
    77	    use pumpkin_data::Block;
    78	
    79	    #[test]
    80	    fn set_face_only_touches_requested_direction() {
    81	        let mut props = MushroomProperties::default(&Block::BROWN_MUSHROOM_BLOCK);
    82	        assert!(props.up && props.down && props.north);
    83	
    84	        set_face(&mut props, BlockDirection::Up, false);
    85	        assert!(!props.up);
    86	        assert!(props.down && props.north && props.south && props.east && props.west);
    87	    }
    88	}


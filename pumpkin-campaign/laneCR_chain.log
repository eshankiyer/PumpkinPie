    22	   @Override
    23	   public InteractionResult useOn(final UseOnContext context) {
    24	      Level level = context.getLevel();
    25	      BlockPos pos = context.getClickedPos();
    26	      BlockState blockState = level.getBlockState(pos);
    27	      if (!blockState.is(Blocks.OBSIDIAN) && !blockState.is(Blocks.BEDROCK)) {
    28	         return InteractionResult.FAIL;
    29	      }
    30	
    31	      BlockPos above = pos.above();
    32	      if (!level.isEmptyBlock(above)) {
    33	         return InteractionResult.FAIL;
    34	      }
    35	
    36	      double x = above.getX();
    37	      double y = above.getY();
    38	      double z = above.getZ();
    39	      List<Entity> entities = level.getEntities(null, new AABB(x, y, z, x + 1.0, y + 2.0, z + 1.0));
    40	      if (!entities.isEmpty()) {
    41	         return InteractionResult.FAIL;
    42	      }
    43	
    44	      if (level instanceof ServerLevel serverLevel) {
    45	         EndCrystal crystal = new EndCrystal(level, x + 0.5, y, z + 0.5);
    46	         crystal.setShowBottom(false);
    47	         level.addFreshEntity(crystal);
    48	         level.gameEvent(context.getPlayer(), GameEvent.ENTITY_PLACE, above);
    49	         EnderDragonFight fight = serverLevel.getDragonFight();
    50	         if (fight != null) {
    51	            fight.tryRespawn();
    52	         }
    53	      }
    54	
    55	      context.getItemInHand().shrink(1);
    56	      return InteractionResult.SUCCESS;
    57	   }
    58	}

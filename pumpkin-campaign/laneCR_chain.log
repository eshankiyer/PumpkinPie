   117	    /// falling/destroying transition. The block's separate `canSurvive` predicate is
   118	    /// `getDistance(level, pos) < 7` (`ScaffoldingBlock.java:131-134`), but this hook is the
   119	    /// placement-time check in Pumpkin's block-item path.
   120	    fn can_place_at(&self, args: CanPlaceAtArgs<'_>) -> bool {
   121	        let _ = args;
   122	        true
   123	    }

    81	        let mut props = MushroomProperties::default(&Block::BROWN_MUSHROOM_BLOCK);
    82	        assert!(props.up && props.down && props.north);
    83	
    84	        set_face(&mut props, BlockDirection::Up, false);
    85	        assert!(!props.up);
    86	        assert!(props.down && props.north && props.south && props.east && props.west);
    87	    }

   280	#[derive(Clone, Debug)]
   281	pub enum BlockEntityModifier {
   282	    AppendLoot { loot_table: String },
   283	    AppendStatic { data: NbtCompound },
   284	    Clear,
   285	    Passthrough,
   286	}
   287	
   288	impl BlockEntityModifier {
   289	    pub fn apply(
   290	        &self,
   291	        nbt: &mut Option<NbtCompound>,
   292	        _pos: Vector3<i32>,
   293	        rng: &mut impl RandomImpl,
   294	    ) {
   295	        match self {
   296	            Self::AppendLoot { loot_table } => {
   297	                let compound = nbt.get_or_insert_with(NbtCompound::new);
   298	                compound.put_string("LootTable", loot_table.clone());
   299	                compound.put_long("LootTableSeed", rng.next_i64());
   300	            }
   301	            Self::AppendStatic { data } => {
   302	                let compound = nbt.get_or_insert_with(NbtCompound::new);
   303	                for (k, v) in &data.child_tags {
   304	                    compound.child_tags.insert(k.clone(), v.clone());
   305	                }
   306	            }
   307	            Self::Clear => {
   308	                *nbt = None;
   309	            }
   310	            Self::Passthrough => {}
   311	        }
   312	    }
   313	}
   314	
   315	#[must_use]
   316	pub fn check_block_has_tag(block_id: BlockId, tag: &str) -> bool {
   317	    let raw_tag = tag.strip_prefix('#').unwrap_or(tag);
   318	    let block = Block::from_id(block_id);
   319	    if block.is_tagged_with(raw_tag).unwrap_or(false) {
   320	        return true;
   321	    }
   322	    if !raw_tag.contains(':') {
   323	        let with_namespace = format!("minecraft:{raw_tag}");
   324	        if block.is_tagged_with(&with_namespace).unwrap_or(false) {
   325	            return true;
   326	        }
   327	    }
   328	    false
   329	}

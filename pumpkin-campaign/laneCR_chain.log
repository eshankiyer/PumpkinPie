    20	public class ShovelItem extends Item {
    21	   protected static final Map<Block, BlockState> FLATTENABLES = Maps.newHashMap(
    22	      new Builder()
    23	         .put(Blocks.GRASS_BLOCK, Blocks.DIRT_PATH.defaultBlockState())
    24	         .put(Blocks.DIRT, Blocks.DIRT_PATH.defaultBlockState())
    25	         .put(Blocks.PODZOL, Blocks.DIRT_PATH.defaultBlockState())
    26	         .put(Blocks.COARSE_DIRT, Blocks.DIRT_PATH.defaultBlockState())
    27	         .put(Blocks.MYCELIUM, Blocks.DIRT_PATH.defaultBlockState())
    28	         .put(Blocks.ROOTED_DIRT, Blocks.DIRT_PATH.defaultBlockState())
    29	         .build()
    30	   );

   683	    /// Serializes a live entity into its current chunk's entity data. The live
   684	    /// entity list is the source of truth while a chunk is loaded (its saved NBT
   685	    /// is consumed on load), so this simply appends the entity to the chunk it is
   686	    /// currently in; the chunk is rewritten from scratch every unload cycle, so
   687	    /// there is nothing stale to deduplicate.
   688	    async fn save_entity(&self, entity: &Arc<dyn EntityBase>) {

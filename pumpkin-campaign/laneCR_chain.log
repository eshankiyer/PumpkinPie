    69	#[derive(Copy, Clone, Debug, PartialEq, Eq)]
    70	pub enum Base {
    71	    Binary,
    72	    Decimal,
    73	    Hexadecimal,
    74	}
    75	
    76	impl Base {
    77	    #[must_use]
    78	    pub const fn should_allow(self, c: char) -> bool {
    79	        matches!(
    80	            (self, c),
    81	            (_, '_') |
    82	            (Self::Binary, '0' | '1') |
    83	            (Self::Decimal, '0'..='9') |
    84	            (Self::Hexadecimal, '0'..='9' | 'A'..='F' | 'a'..='f')
    85	        )
    86	    }
    87	
    88	    #[must_use]
    89	    pub const fn no_value_error_type(self) -> &'static CommandErrorType<0> {
    90	        match self {
    91	            Self::Binary => &EXPECTED_BINARY_NUMERAL,
    92	            Self::Decimal => &EXPECTED_DECIMAL_NUMERAL,
    93	            Self::Hexadecimal => &EXPECTED_HEX_NUMERAL,
    94	        }
    95	    }
    96	
    97	    #[must_use]
    98	    pub const fn radix(self) -> u32 {
    99	        match self {
   100	            Self::Binary => 2,
   101	            Self::Decimal => 10,
   102	            Self::Hexadecimal => 16,
   103	        }
   104	    }
   105	}

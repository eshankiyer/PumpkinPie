   214	    /// DEVIATION: vanilla's `EntityTracker.isVisibleBy` (`behavior/EntityTracker.java:37-48`)
   215	    /// requires the target to appear in the observer's `NEAREST_VISIBLE_LIVING_ENTITIES`
   216	    /// memory. That memory needs a `NearestLivingEntitiesSensor`, which this stage does not
   217	    /// port, so the check degrades to "the entity still exists and is alive". A mob will
   218	    /// therefore keep looking at a target through a wall where vanilla would drop it.
   219	    #[must_use]
   220	    pub fn is_visible_by(&self) -> bool {
   221	        match self {
   222	            Self::Block { .. } => true,
   223	            Self::Entity { entity, .. } => entity
   224	                .upgrade()
   225	                .is_some_and(|entity| entity.get_entity().is_alive()),

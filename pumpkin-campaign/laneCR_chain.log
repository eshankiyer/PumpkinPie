    59	    fn state_with_age(&self, block: &Block, state: BlockStateId, age: i32) -> BlockStateId {
    60	        let mut props = CropProperties::from_state_id(state, block);
    61	        props.age = age as u8;
    62	        props.to_state_id(block)

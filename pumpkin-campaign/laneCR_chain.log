   286	impl NoiseBlockStateProviderBase {
   287	    pub fn get_noise(&self, pos: BlockPos) -> f64 {
   288	        let sampler = DoublePerlinNoiseSampler::new(
   289	            &mut RandomGenerator::Legacy(LegacyRand::from_seed(self.seed as u64)),
   290	            self.noise.first_octave,
   291	            &self.noise.amplitudes,
   292	            self.noise.amplitude,
   293	            false,
   294	        );
   295	        sampler.sample(
   296	            pos.0.x as f64 * self.scale as f64,
   297	            pos.0.y as f64 * self.scale as f64,
   298	            pos.0.z as f64 * self.scale as f64,
   299	        )
   300	    }

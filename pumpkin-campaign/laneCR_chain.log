   281	    /// Determines the block variant and placement properties for a sign.
   282	    fn determine_placement(args: &OnPlaceArgs, support: &SupportInfo) -> Option<SignPlacement> {
   283	        let is_hanging = args.block.name.contains("hanging");
   284	        let is_sneaking = args.player.get_entity().is_sneaking();
   285	
   286	        // Select block variant
   287	        let block_id = if is_hanging {
   288	            Self::select_hanging_variant(args, support)?
   289	        } else {
   290	            Self::select_standing_variant(args, support)
   291	        };
   292	
   293	        let actual_block = Block::from_id(block_id);
   294	        let is_wall_hanging = is_hanging && actual_block.name.contains("wall_hanging");
   295	
   296	        // Calculate orientation
   297	        let (facing, rotation, attached) = if is_wall_hanging {
   298	            Self::calculate_wall_hanging_orientation(args, support, is_sneaking)
   299	        } else if is_hanging {
   300	            Self::calculate_ceiling_orientation(args, is_sneaking)
   301	        } else if actual_block.name.contains("wall") {
   302	            Self::calculate_wall_orientation(args)
   303	        } else {
   304	            Self::calculate_standing_orientation(args)
   305	        };
   306	
   307	        Some(SignPlacement {
   308	            block_id,
   309	            facing,
   310	            rotation,
   311	            attached,
   312	        })
   313	    }

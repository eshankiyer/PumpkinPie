                {
                    self.equip_saddle(player, item_stack).await;
                    return true;
                }
            }

            self.do_player_ride(player).await;
            true
        })
    }

    /// `AbstractHorse.addAdditionalSaveData` (`AbstractHorse.java:788-793`, minus `Owner`/`Tame`

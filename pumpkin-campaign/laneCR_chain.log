   158	struct LocateStructureExecutor;
   159	
   160	impl CommandExecutor for LocateStructureExecutor {
   161	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   162	        Box::pin(async move {
   163	            let searched = context.get_argument::<ResourceOrTag>(ARG_STRUCTURE)?;
   164	
   165	            // The generator's placement data models vanilla's structure sets,
   166	            // so ids resolve against those. There is no structure tag data,
   167	            // hence tags cannot name any known structure (yet).
   168	            let set = if let ResourceOrTag::Resource(id) = searched
   169	                && id.is_vanilla()
   170	            {
   171	                StructureSet::get(id.path())
   172	            } else {
   173	                None
   174	            };
   175	
   176	            let Some(set) = set else {
   177	                return Err(STRUCTURE_INVALID_ERROR_TYPE
   178	                    .create_without_context(TextComponent::text(searched.printable())));
   179	            };
   180	
   181	            let origin = BlockPos::floored_v(context.source.position);
   182	
   183	            let world = context.source.world();
   184	            let seed = world.level.seed.0;
   185	            let world_gen = world.level.world_gen.load_full();
   186	
   187	            // Scanning up to `STRUCTURE_SEARCH_RADIUS` regions of placement
   188	            // data is CPU-bound just like the biome spiral, so keep it off
   189	            // the async workers too.
   190	            let found = tokio::task::spawn_blocking(move || {
   191	                match &set.placement.placement_type {
   192	                    // Strongholds come out of the pre-computed ring cache, which
   193	                    // already holds positions they really occupy.
   194	                    StructurePlacementType::ConcentricRings(_) => {
   195	                        world_gen.global_structure_cache().and_then(|global_cache| {
   196	                            find_nearest_structure(
   197	                                origin,
   198	                                &[&set.placement],
   199	                                STRUCTURE_SEARCH_RADIUS,
   200	                                seed as i64,
   201	                                global_cache,
   202	                            )
   203	                        })
   204	                    }
   205	                    // Everything else is spread over a grid whose candidate chunks
   206	                    // are only *possible* sites: the biome at a candidate can still
   207	                    // reject every structure in the set. Resolving the start makes
   208	                    // sure the reported position actually holds one.
   209	                    StructurePlacementType::RandomSpread(_) => {
   210	                        let targets: Vec<StructureKeys> =
   211	                            set.structures.iter().map(|entry| entry.structure).collect();
   212	                        find_nearest_structure_start(
   213	                            origin,
   214	                            set,
   215	                            &targets,
   216	                            STRUCTURE_SEARCH_RADIUS,
   217	                            &world_gen,
   218	                        )
   219	                    }
   220	                }
   221	            })
   222	            .await
   223	            .map_err(|_| SEARCH_FAILED_ERROR_TYPE.create_without_context())?;
   224	
   225	            let Some(target) = found else {
   226	                return Err(STRUCTURE_NOT_FOUND_ERROR_TYPE
   227	                    .create_without_context(TextComponent::text(searched.printable())));
   228	            };
   229	
   230	            let distance = horizontal_distance(&origin, &target);
   231	            send_success(
   232	                context,
   233	                translation::java::COMMANDS_LOCATE_STRUCTURE_SUCCESS,
   234	                translation::bedrock::COMMANDS_LOCATE_STRUCTURE_SUCCESS,
   235	                searched.printable(),
   236	                &target,
   237	                false,
   238	                distance,
   239	            )
   240	            .await;
   241	
   242	            Ok(distance)
   243	        })
   244	    }
   245	}
   246	
   247	struct LocateBiomeExecutor;
   248	
   249	impl CommandExecutor for LocateBiomeExecutor {
   250	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   251	        Box::pin(async move {
   252	            // Vanilla obtains this through `ResourceOrTagArgument.getResourceOrTag`
   253	            // (`ResourceOrTagArgument.java:52-64`) before resolving the biome.
   254	            let searched =
   255	                ResourceOrTagArgument::get_resource_or_tag(context, ARG_BIOME, BIOME_REGISTRY)?
   256	                    .clone();
   257	
   258	            let targets: FxHashSet<u8> = match &searched {
   259	                ResourceOrTag::Resource(id) => Biome::from_name(id.path())
   260	                    .map(|biome| biome.id)
   261	                    .into_iter()
   262	                    .collect(),
   263	                ResourceOrTag::Tag(id) => {
   264	                    tag::get_tag_values(RegistryKey::WorldgenBiome, &id.to_string())
   265	                        .into_iter()
   266	                        .flatten()
   267	                        .filter_map(|name| Biome::from_name(name))
   268	                        .map(|biome| biome.id)
   269	                        .collect()
   270	                }
   271	            };
   272	
   273	            let not_found = || {
   274	                BIOME_NOT_FOUND_ERROR_TYPE
   275	                    .create_without_context(TextComponent::text(searched.printable()))
   276	            };
   277	            if targets.is_empty() {
   278	                return Err(not_found());
   279	            }
   280	
   281	            let origin = BlockPos::floored_v(context.source.position);
   282	            let world = context.source.world().clone();
   283	            let world_gen = world.level.world_gen.load_full();
   284	
   285	            // The spiral scan can probe hundreds of thousands of noise
   286	            // points when the biome is rare, so keep it off the async
   287	            // workers.
   288	            let found = tokio::task::spawn_blocking(move || {
   289	                find_closest_biome_3d(
   290	                    &world_gen,
   291	                    origin,
   292	                    &targets,
   293	                    BIOME_SEARCH_RADIUS,
   294	                    BIOME_SEARCH_HORIZONTAL_STEP,
   295	                    BIOME_SEARCH_VERTICAL_STEP,
   296	                )
   297	            })
   298	            .await
   299	            .map_err(|_| SEARCH_FAILED_ERROR_TYPE.create_without_context())?;
   300	
   301	            let Some((target, biome)) = found else {
   302	                return Err(not_found());
   303	            };
   304	
   305	            let distance = absolute_distance(&origin, &target);
   306	            send_success(
   307	                context,
   308	                translation::java::COMMANDS_LOCATE_BIOME_SUCCESS,
   309	                translation::bedrock::COMMANDS_LOCATE_BIOME_SUCCESS,
   310	                result_name(&searched, &format!("minecraft:{}", biome.registry_id)),
   311	                &target,
   312	                true,
   313	                distance,
   314	            )
   315	            .await;
   316	
   317	            Ok(distance)
   318	        })
   319	    }
   320	}
   321	
   322	struct LocatePoiExecutor;
   323	
   324	impl CommandExecutor for LocatePoiExecutor {
   325	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   326	        Box::pin(async move {
   327	            // Vanilla obtains this through `ResourceOrTagArgument.getResourceOrTag`
   328	            // (`ResourceOrTagArgument.java:52-64`) before resolving the POI type.
   329	            let searched =
   330	                ResourceOrTagArgument::get_resource_or_tag(context, ARG_POI, &POI_REGISTRY)?;
   331	
   332	            // POI entries store namespaced type ids, tag data uses bare
   333	            // vanilla names; normalize everything to `namespace:path`.
   334	            let targets: FxHashSet<String> = match searched {
   335	                ResourceOrTag::Resource(id) => std::iter::once(id.to_string()).collect(),
   336	                ResourceOrTag::Tag(id) => {
   337	                    tag::get_tag_values(RegistryKey::PointOfInterestType, &id.to_string())
   338	                        .into_iter()
   339	                        .flatten()
   340	                        .map(|name| {
   341	                            if name.contains(':') {
   342	                                (*name).to_string()
   343	                            } else {
   344	                                format!("minecraft:{name}")
   345	                            }
   346	                        })
   347	                        .collect()
   348	                }
   349	            };
   350	
   351	            let origin = BlockPos::floored_v(context.source.position);
   352	            let world = context.source.world().clone();
   353	
   354	            let found = {
   355	                let mut poi_storage = world.portal_poi.lock().await;
   356	                poi_storage.find_closest_matching(origin, POI_SEARCH_RADIUS, |poi_type| {
   357	                    targets.contains(poi_type)
   358	                })
   359	            };
   360	
   361	            let Some((target, poi_type)) = found else {
   362	                return Err(POI_NOT_FOUND_ERROR_TYPE
   363	                    .create_without_context(TextComponent::text(searched.printable())));
   364	            };
   365	
   366	            let distance = horizontal_distance(&origin, &target);
   367	            send_success(
   368	                context,
   369	                translation::java::COMMANDS_LOCATE_POI_SUCCESS,
   370	                translation::java::COMMANDS_LOCATE_POI_SUCCESS,
   371	                result_name(searched, &poi_type),
   372	                &target,
   373	                false,
   374	                distance,
   375	            )
   376	            .await;
   377	
   378	            Ok(distance)
   379	        })
   380	    }
   381	}
   382	
   383	pub fn register(dispatcher: &mut CommandDispatcher, registry: &PermissionRegistry) {
   384	    registry.register_permission_or_panic(Permission::new(
   385	        PERMISSION,
   386	        DESCRIPTION,
   387	        PermissionDefault::Op(PermissionLvl::Two),
   388	    ));
   389	
   390	    dispatcher.register(
   391	        command("locate", DESCRIPTION)
   392	            .requires(PERMISSION)
   393	            .then(
   394	                literal("structure").then(
   395	                    argument(
   396	                        ARG_STRUCTURE,
   397	                        ResourceOrTagKeyArgument(STRUCTURE_REGISTRY.clone()),
   398	                    )
   399	                    .executes(LocateStructureExecutor),
   400	                ),
   401	            )
   402	            .then(
   403	                literal("biome").then(
   404	                    argument(ARG_BIOME, ResourceOrTagArgument(BIOME_REGISTRY.clone()))
   405	                        .executes(LocateBiomeExecutor),
   406	                ),
   407	            )
   408	            .then(
   409	                literal("poi").then(
   410	                    argument(ARG_POI, ResourceOrTagArgument(POI_REGISTRY.clone()))
   411	                        .executes(LocatePoiExecutor),
   412	                ),
   413	            ),
   414	    );
   415	}

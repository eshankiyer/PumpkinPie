    88	/// Typed key into a `MemoryStore`, the Rust analogue of `MemoryModuleType<U>`
    89	/// (`memory/MemoryModuleType.java:153-179`).
    90	///
    91	/// Implementors are zero-sized; the value type is
    92	/// carried in the associated type so callers never downcast.
    93	pub trait MemoryKey: 'static {
    94	    type Value: Send + 'static;
    95	    const ID: MemoryKeyId;
    96	    const NAME: &'static str;
    97	}
    98	
    99	macro_rules! memory_keys {
   100	    ($($key:ident => $id:ident : $value:ty, $name:literal;)*) => {
   101	        $(
   102	            pub struct $key;
   103	            impl MemoryKey for $key {
   104	                type Value = $value;
   105	                const ID: MemoryKeyId = MemoryKeyId::$id;
   106	                const NAME: &'static str = $name;
   107	            }
   108	        )*
   109	    };
   110	}

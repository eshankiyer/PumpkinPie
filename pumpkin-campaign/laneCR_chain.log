   703	#[cfg(test)]
   704	mod mirror_tests {
   705	    use super::*;
   706	
   707	    // Vanilla `Mirror.java`: LEFT_RIGHT is OctahedralGroup.INVERT_Z and only flips
   708	    // directions on the Z axis (north/south). FRONT_BACK is INVERT_X and only flips
   709	    // directions on the X axis (east/west).
   710	
   711	    #[test]
   712	    fn left_right_flips_north_south() {
   713	        assert_eq!(Mirror::LeftRight.mirror_facing("north"), "south");
   714	        assert_eq!(Mirror::LeftRight.mirror_facing("south"), "north");
   715	    }
   716	
   717	    #[test]
   718	    fn left_right_leaves_east_west_unchanged() {
   719	        assert_eq!(Mirror::LeftRight.mirror_facing("east"), "east");
   720	        assert_eq!(Mirror::LeftRight.mirror_facing("west"), "west");
   721	    }
   722	
   723	    #[test]
   724	    fn front_back_flips_east_west() {
   725	        assert_eq!(Mirror::FrontBack.mirror_facing("east"), "west");
   726	        assert_eq!(Mirror::FrontBack.mirror_facing("west"), "east");
   727	    }
   728	
   729	    #[test]
   730	    fn front_back_leaves_north_south_unchanged() {
   731	        assert_eq!(Mirror::FrontBack.mirror_facing("north"), "north");
   732	        assert_eq!(Mirror::FrontBack.mirror_facing("south"), "south");
   733	    }
   734	
   735	    #[test]
   736	    fn left_right_transform_pos_flips_z() {
   737	        let size = Vector3::new(4, 1, 6);
   738	        let pos = Vector3::new(1, 0, 2);
   739	        assert_eq!(
   740	            Mirror::LeftRight.transform_pos(pos, size),
   741	            Vector3::new(1, 0, 3)
   742	        );
   743	    }
   744	
   745	    #[test]
   746	    fn front_back_transform_pos_flips_x() {
   747	        let size = Vector3::new(4, 1, 6);
   748	        let pos = Vector3::new(1, 0, 2);
   749	        assert_eq!(
   750	            Mirror::FrontBack.transform_pos(pos, size),
   751	            Vector3::new(2, 0, 2)
   752	        );
   753	    }
   754	
   755	    #[test]
   756	    fn left_right_block_rotation_matches_vanilla_formula() {
   757	        // vanilla: (halfSteps - correctedRotation + steps) % steps, steps=16, halfSteps=8
   758	        for rotation in 0..16 {
   759	            assert_eq!(
   760	                Mirror::LeftRight.mirror_block_rotation(rotation),
   761	                (8 - rotation + 16) % 16
   762	            );
   763	        }
   764	    }
   765	
   766	    #[test]
   767	    fn front_back_block_rotation_matches_vanilla_formula() {
   768	        // vanilla: (steps - correctedRotation) % steps, steps=16
   769	        for rotation in 0..16 {
   770	            assert_eq!(
   771	                Mirror::FrontBack.mirror_block_rotation(rotation),
   772	                (16 - rotation) % 16
   773	            );
   774	        }
   775	    }
   776	
   777	    #[test]
   778	    fn none_is_identity() {
   779	        assert_eq!(Mirror::None.mirror_facing("north"), "north");
   780	        assert_eq!(Mirror::None.mirror_block_rotation(5), 5);
   781	        let size = Vector3::new(4, 1, 6);
   782	        let pos = Vector3::new(1, 0, 2);
   783	        assert_eq!(Mirror::None.transform_pos(pos, size), pos);
   784	    }
   785	}

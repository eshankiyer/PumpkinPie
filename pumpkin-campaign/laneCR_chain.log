   526	        let store = MemoryStore::new();
   527	        assert!(!store.check(MemoryKeyId::WalkTarget, MemoryStatus::Registered));
   528	        assert!(!store.check(MemoryKeyId::WalkTarget, MemoryStatus::ValueAbsent));
   529	        assert!(!store.check(MemoryKeyId::WalkTarget, MemoryStatus::ValuePresent));

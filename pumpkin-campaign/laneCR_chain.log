     1	//! Macro support for datapack functions.
     2	//!
     3	//! Port of vanilla `net.minecraft.commands.functions.MacroFunction` (26.2)
     4	//! together with its helpers `StringTemplate` and the `$`-line compilation of
     5	//! `CommandFunction.fromLines`/`FunctionBuilder`. A `.mcfunction` file
     6	//! containing at least one `$`-prefixed line compiles into a [`LoadedFunction`]
     7	//! carrying macro templates plus the ordered parameter-name list; executing it
     8	//! requires an NBT compound of arguments whose stringified values are
     9	//! substituted into every macro line before dispatch.
    10	//!
    11	//! Difference to vanilla worth noting: vanilla parses each substituted command
    12	//! through the dispatcher during instantiation and caches the compiled actions
    13	//! (`MacroFunction.substituteAndParse`, `MacroFunction.java:101-111`). Pumpkin
    14	//! parses commands lazily inside `CommandDispatcher::handle_command`, so
    15	//! instantiation here yields the substituted command strings and the cache
    16	//! stores those instead of parsed actions.
    17	
    18	use pumpkin_nbt::compound::NbtCompound;
    19	use pumpkin_nbt::tag::NbtTag;
    20	
    21	/// Maximum number of cached instantiations per function, mirroring vanilla's
    22	/// `MAX_CACHE_ENTRIES = 8` (`MacroFunction.java:34`).
    23	const MAX_CACHE_ENTRIES: usize = 8;
    24	
    25	/// Maximum characters allowed for a single (substituted) command line, port of
    26	/// `CommandFunction.checkCommandLineLength` (`CommandFunction.java:89-94`).
    27	const MAX_COMMAND_LINE_LENGTH: usize = 2_000_000;
    28	
    29	/// One parsed function body line.
    30	///
    31	/// Direct analogue of the two `MacroFunction.Entry` implementations: a
    32	/// pre-resolved command ([`FunctionLine::Plain`], vanilla
    33	/// `PlainTextEntry`, `MacroFunction.java:149-165`) or a `$` macro template
    34	/// ([`FunctionLine::Macro`], vanilla `MacroEntry`,
    35	/// `MacroFunction.java:119-147`).
    36	#[derive(Clone, Debug)]
    37	pub enum FunctionLine {
    38	    Plain(String),
    39	    Macro(MacroTemplate),
    40	}
    41	
    42	/// A loaded datapack function: either purely plain lines (vanilla
    43	/// `PlainTextFunction`) or mixed plain/macro entries with a parameter list
    44	/// (vanilla `MacroFunction`, `MacroFunction.java:30-44`).
    45	#[derive(Clone, Debug, Default)]
    46	pub struct LoadedFunction {
    47	    pub lines: Vec<FunctionLine>,
    48	    /// Every macro variable used by this function, ordered by first appearance
    49	    /// across all macro lines — port of the deduplicated insertion order built
    50	    /// by `FunctionBuilder.getArgumentIndex` (`FunctionBuilder.java:25-33`)
    51	    /// stored in `MacroFunction.parameters` (`MacroFunction.java:35`).
    52	    pub parameters: Vec<String>,
    53	}
    54	
    55	/// Why instantiating a macro function failed. Each variant maps onto the
    56	/// `FunctionInstantiationException` raised by vanilla's
    57	/// `MacroFunction.instantiate` (`MacroFunction.java:52-68`).
    58	#[derive(Debug, PartialEq, Eq)]
    59	pub enum InstantiationError {
    60	    /// No arguments were supplied to a macro function
    61	    /// (`MacroFunction.java:53-55`).
    62	    MissingArguments,
    63	    /// The supplied argument compound lacks a required parameter
    64	    /// (`MacroFunction.java:61-65`).
    65	    MissingArgument(String),
    66	}
    67	
    68	impl LoadedFunction {
    69	    /// Compiles raw `.mcfunction` lines into [`FunctionLine`]s.
    70	    ///
    71	    /// Lines starting with `$` become macro templates parsed by
    72	    /// [`MacroTemplate::from_string`]; everything else stays plain. Port of the
    73	    /// `$` branch of `CommandFunction.fromLines` (`CommandFunction.java:74-75`)
    74	    /// feeding `FunctionBuilder.addMacro` (`FunctionBuilder.java:45-64`); the
    75	    /// returned error text mirrors the
    76	    /// "Can't parse function line {line}: '{command}'"
    77	    /// wrapper of `FunctionBuilder.java:50`.
    78	    pub fn from_lines(lines: &[String]) -> Result<Self, String> {
    79	        let mut function_lines = Vec::with_capacity(lines.len());
    80	        let mut parameters: Vec<String> = Vec::new();
    81	
    82	        for (i, line) in lines.iter().enumerate() {
    83	            if let Some(rest) = line.strip_prefix('$') {
    84	                let template = MacroTemplate::from_string(rest)
    85	                    .map_err(|e| format!("Can't parse function line {}: '{line}' ({e})", i + 1))?;
    86	                // `FunctionBuilder.getArgumentIndex` (`FunctionBuilder.java:25-33`):
    87	                // register variables in order of first appearance, deduplicated.
    88	                for variable in &template.variables {
    89	                    if !parameters.contains(variable) {
    90	                        parameters.push(variable.clone());
    91	                    }
    92	                }
    93	                function_lines.push(FunctionLine::Macro(template));
    94	            } else {
    95	                function_lines.push(FunctionLine::Plain(line.clone()));
    96	            }
    97	        }
    98	
    99	        Ok(Self {
   100	            lines: function_lines,
   101	            parameters,
   102	        })

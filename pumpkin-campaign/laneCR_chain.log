    68	                let mut filled_map = ItemStack::new(1, &Item::FILLED_MAP);
    69	                filled_map.patch.push((
    70	                    DataComponent::MapId,
    71	                    Some(MapIdImpl { id: map_id }.to_dyn()),
    72	                ));
    73	
    74	                let gamemode = player.gamemode.load();
    75	                if hand_stack.item_count == 1 && gamemode != GameMode::Creative {
    76	                    inventory.set_stack_in_hand(hand, filled_map).await;
    77	                } else {
    78	                    hand_stack.decrement_unless_creative(gamemode, 1);
    79	                    inventory.set_stack_in_hand(hand, hand_stack).await;
    80	                    inventory.offer_or_drop_stack(filled_map, player).await;
    81	                }
    82	            }
    83	        })
    84	    }

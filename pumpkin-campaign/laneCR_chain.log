   114	    /// Extracts and stringifies every parameter value from the argument
   115	    /// compound, in parameter order. Port of the argument-collection loop of
   116	    /// `MacroFunction.instantiate` (`MacroFunction.java:57-68`).
   117	    pub fn extract_parameter_values(
   118	        &self,
   119	        arguments: &NbtCompound,
   120	    ) -> Result<Vec<String>, InstantiationError> {
   121	        self.parameters
   122	            .iter()
   123	            .map(|parameter| {
   124	                arguments
   125	                    .get(parameter)
   126	                    .map(stringify)
   127	                    .ok_or_else(|| InstantiationError::MissingArgument(parameter.clone()))
   128	            })
   129	            .collect()
   130	    }
   131	
   132	    /// Substitutes the already-stringified parameter values into every macro
   133	    /// line, producing the concrete command lines to dispatch. Port of
   134	    /// `MacroFunction.lookupValues` + `substituteAndParse`
   135	    /// (`MacroFunction.java:96-111`), minus the dispatcher parse (see module
   136	    /// docs).
   137	    ///
   138	    /// # Errors
   139	    /// Propagates [`MacroTemplate::substitute`] failures (excessively long
   140	    /// command lines).
   141	    pub fn substitute_all(&self, values: &[String]) -> Result<Vec<String>, String> {
   142	        self.lines
   143	            .iter()
   144	            .map(|line| match line {
   145	                FunctionLine::Plain(command) => Ok(command.clone()),
   146	                FunctionLine::Macro(template) => {
   147	                    // Vanilla's FunctionBuilder stores each macro entry's indexes into the
   148	                    // function-wide parameter list (`MacroFunction.java:96-107`). A template
   149	                    // may therefore mention parameters in an order different from their first
   150	                    // appearance in the function; translate that global value list into the
   151	                    // template's local order before substitution.
   152	                    let local_values: Result<Vec<String>, String> = template
   153	                        .variables
   154	                        .iter()
   155	                        .map(|variable| {
   156	                            let index = self
   157	                                .parameters
   158	                                .iter()
   159	                                .position(|parameter| parameter == variable)
   160	                                .ok_or_else(|| {
   161	                                    format!("Missing macro parameter '{variable}' in function")
   162	                                })?;
   163	                            values.get(index).cloned().ok_or_else(|| {
   164	                                format!("Missing macro argument '{variable}' for template")
   165	                            })
   166	                        })
   167	                        .collect();
   168	                    template.substitute(&local_values?)
   169	                }
   170	            })
   171	            .collect()
   172	    }
   173	}

    51	/// Vanilla `LeadItem.bindPlayerMobs` (`LeadItem.java:37-65`) is also called by
    52	/// `FenceBlock.useWithoutItem` (`FenceBlock.java:70-75`), so both interaction paths
    53	/// share the same leash transfer and block-attach event.
    54	pub(crate) async fn bind_player_mobs(player: &Player, location: BlockPos) -> bool {
    55	    let world = player.world();
    56	    let center = Vector3::new(
    57	        f64::from(location.0.x) + 0.5,
    58	        f64::from(location.0.y) + 0.5,
    59	        f64::from(location.0.z) + 0.5,
    60	    );
    61	
    62	    let search_dim = EntityDimensions {
    63	        width: 32.0,
    64	        height: 32.0,
    65	        eye_height: 16.0,
    66	        fixed: false,
    67	    };
    68	    let search_box = BoundingBox::new_from_pos(center.x, center.y, center.z, &search_dim);
    69	    let player_id = player.entity_id();
    70	    let entities = world.get_entities_at_box(&search_box);
    71	
    72	    let mut any_leashed = false;
    73	    let mut knot: Option<Arc<LeashKnotEntity>> = None;
    74	    for entity_base in entities {
    75	        let ent = entity_base.get_entity();
    76	        let is_leashed_to_player = ent
    77	            .leashed_to
    78	            .try_lock()
    79	            .ok()
    80	            .and_then(|guard| {
    81	                guard
    82	                    .as_ref()
    83	                    .map(|holder| holder.get_entity().entity_id == player_id)
    84	            })
    85	            .unwrap_or(false);
    86	
    87	        if is_leashed_to_player {
    88	            if knot.is_none() {
    89	                knot = Some(LeashKnotEntity::get_or_create(&world, location).await);
    90	            }
    91	            if let Some(k) = &knot {
    92	                ent.leash_to(k.clone() as Arc<dyn EntityBase>).await;
    93	                any_leashed = true;
    94	            }
    95	        }
    96	    }
    97	
    98	    if any_leashed {
    99	        world.play_sound(Sound::ItemLeadTied, SoundCategory::Neutral, &center);
   100	        if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id) {
   101	            crate::world::game_event::emit_game_event(
   102	                &world,
   103	                pumpkin_data::game_event::GameEvent::BlockAttach,
   104	                center,
   105	                crate::world::game_event::GameEventContext::of_entity(player_arc),
   106	            )
   107	            .await;
   108	        }
   109	    }
   110	    any_leashed
   111	}


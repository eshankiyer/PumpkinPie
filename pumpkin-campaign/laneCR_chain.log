   132	async fn send_success(
   133	    context: &CommandContext<'_>,
   134	    java_key: &'static str,
   135	    bedrock_key: &'static str,
   136	    name: String,
   137	    target: &BlockPos,
   138	    absolute_y: bool,
   139	    distance: i32,
   140	) {
   141	    context
   142	        .source
   143	        .send_feedback(
   144	            TextComponent::translate_cross(
   145	                java_key,
   146	                bedrock_key,
   147	                [
   148	                    TextComponent::text(name),
   149	                    coordinates_text(target, absolute_y),
   150	                    TextComponent::text(distance.to_string()),
   151	                ],
   152	            ),
   153	            false,
   154	        )
   155	        .await;
   156	}

    23	/// `GateBehavior.RunningPolicy` (`GateBehavior.java:119-140`).
    24	#[derive(Clone, Copy)]
    25	pub enum RunningPolicy {
    26	    /// Starts children in order until the first one that succeeds.
    27	    RunOne,
    28	    /// Attempts to start every stopped child.
    29	    TryAll,
    30	}
    31	
    32	pub struct GateBehavior {
    33	    entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
    34	    /// Union of `entry_condition` and every child's required memories
    35	    /// (`GateBehavior.getRequiredMemories`, `:44-53`). Precomputed so `required_memories` can
    36	    /// return a slice.
    37	    required_memories: Vec<(MemoryKeyId, MemoryStatus)>,

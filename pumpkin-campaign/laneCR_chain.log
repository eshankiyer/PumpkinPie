    18	pub enum BlockStateProvider {
    19	    Simple(SimpleStateProvider),
    20	    Weighted(WeightedBlockStateProvider),
    21	    NoiseThreshold(NoiseThresholdBlockStateProvider),
    22	    NoiseProvider(NoiseBlockStateProvider),
    23	    DualNoise(DualNoiseBlockStateProvider),

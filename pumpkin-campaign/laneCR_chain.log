    85	/// `RandomPos.generateRandomPosTowardDirection` (`RandomPos.java:114-133`): turns a relative
    86	/// direction into an absolute block position, biased back towards the home position when the
    87	/// mob is restricted.
    88	fn generate_random_pos_toward_direction(
    89	    mob: &dyn Mob,
    90	    xz_dist: f64,
    91	    rng: &mut ThreadRng,
    92	    direction: Vector3<i32>,
    93	) -> BlockPos {
    94	    let mob_entity = mob.get_mob_entity();
    95	    let pos = mob_entity.living_entity.entity.pos.load();
    96	    let mut xt = f64::from(direction.x);
    97	    let mut zt = f64::from(direction.z);
    98	    let has_home = mob_entity.position_target_range.load(Ordering::Relaxed) != -1;
    99	    if has_home && xz_dist > 1.0 {
   100	        let home = mob_entity.position_target.load();
   101	        let x_bias = rng.random::<f64>() * xz_dist / 2.0;
   102	        let z_bias = rng.random::<f64>() * xz_dist / 2.0;
   103	        if pos.x > f64::from(home.0.x) {
   104	            xt -= x_bias;
   105	        } else {
   106	            xt += x_bias;
   107	        }
   108	        if pos.z > f64::from(home.0.z) {
   109	            zt -= z_bias;
   110	        } else {
   111	            zt += z_bias;
   112	        }
   113	    }
   114	    BlockPos::new(
   115	        (xt + pos.x).floor() as i32,
   116	        (f64::from(direction.y) + pos.y).floor() as i32,
   117	        (zt + pos.z).floor() as i32,
   118	    )
   119	}

   323	/// Mirrors vanilla's shared `DECIMAL_FORMAT` (`MacroFunction.java:31-33`): a
   324	/// root-locale `#` pattern with at most 15 fractional digits, which strips
   325	/// trailing zeros (so `1.0f` substitutes as `"1"` and `0.5f` as `"0.5"`).
   326	/// Rounding matches Java's half-to-even default; NaN/infinity spellings follow
   327	/// `DecimalFormat`.
   328	fn format_decimal(value: f64) -> String {
   329	    if value.is_nan() {
   330	        return "NaN".to_string();
   331	    }
   332	    if value.is_infinite() {
   333	        return if value.is_sign_negative() {
   334	            "-∞"
   335	        } else {
   336	            "∞"
   337	        }
   338	        .to_string();
   339	    }
   340	
   341	    let mut formatted = format!("{value:.15}");
   342	    if formatted.contains('.') {
   343	        while formatted.ends_with('0') {
   344	            formatted.pop();
   345	        }
   346	        if formatted.ends_with('.') {
   347	            formatted.pop();
   348	        }
   349	    }
   350	    formatted
   351	}

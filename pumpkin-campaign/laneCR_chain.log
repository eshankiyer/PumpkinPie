   425	    #[test]
   426	    fn pillar_provider_randomizes_axis() {
   427	        let mut random = RandomGenerator::Legacy(LegacyRand::from_seed(1));
   428	        let provider = PillarBlockStateProvider {
   429	            state: Block::BASALT.default_state,
   430	        };
   431	
   432	        let mut saw_axis = std::collections::HashSet::new();
   433	        for _ in 0..64 {
   434	            let state = provider.get(&mut random);
   435	            let block = Block::from_state_id(state.id);
   436	            let props = block.properties(state.id).unwrap().to_props();
   437	            let axis = props
   438	                .iter()
   439	                .find(|(key, _)| *key == "axis")
   440	                .map(|(_, value)| (*value).to_string());
   441	            if let Some(axis) = axis {
   442	                saw_axis.insert(axis);
   443	            }
   444	        }
   445	
   446	        assert!(
   447	            saw_axis.len() > 1,
   448	            "expected multiple distinct axes to be sampled, got {saw_axis:?}"
   449	        );
   450	    }

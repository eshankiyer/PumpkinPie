   245	                        pending.push((keep_alive_id, Instant::now()));
   246	                        if pending.len() > 16 {
   247	                            pending.remove(0);
   248	                        }
   249	                    }
   250	                    let packet = pumpkin_protocol::java::client::play::CKeepAlive::new(keep_alive_id);

   536	        assert!(store.check(MemoryKeyId::WalkTarget, MemoryStatus::Registered));
   537	        assert!(store.check(MemoryKeyId::WalkTarget, MemoryStatus::ValueAbsent));
   538	        assert!(!store.check(MemoryKeyId::WalkTarget, MemoryStatus::ValuePresent));

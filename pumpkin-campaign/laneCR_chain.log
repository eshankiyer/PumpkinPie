   382	    /// Calculates orientation for wall signs.
   383	    fn calculate_wall_orientation(args: &OnPlaceArgs) -> (Option<String>, Option<u8>, bool) {
   384	        let facing = args.direction.opposite().to_cardinal_direction().to_value();
   385	        (Some(facing.to_string()), None, false)
   386	    }

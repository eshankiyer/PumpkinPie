     5	    pub async fn handle_move_vehicle(&self, player: &Arc<Player>, packet: SMoveVehicle) {
     6	        let entity = player.get_entity();
     7	        let pos = Vector3::new(packet.x, packet.y, packet.z);
     8	        let vehicle = entity.vehicle.lock().await;
     9	        if let Some(vehicle) = vehicle.as_ref() {
    10	            let vehicle_entity = vehicle.get_entity();
    11	            let old_pos = vehicle_entity.pos.load();
    12	            vehicle_entity.set_pos(pos);

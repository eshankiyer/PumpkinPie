   115	               level.setBlock(supportPos, defaultSculk, 3);
   116	               Block.pushEntitiesUp(supportState, defaultSculk, level, supportPos);
   117	               level.playSound(null, supportPos, SoundEvents.SCULK_BLOCK_SPREAD, SoundSource.BLOCKS, 1.0F, 1.0F);

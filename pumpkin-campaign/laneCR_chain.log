   127	/// `PositionTracker` (`behavior/PositionTracker.java`) with its two concrete implementations,
   128	/// `BlockPosTracker` and `EntityTracker`, collapsed into one enum.
   129	///
   130	/// The accessors return `Option` where vanilla returns a bare value: an `Entity` variant holds
   131	/// a `Weak`, and a dead weak means the tracked entity left the world. Vanilla cannot hit that
   132	/// case because a `Behavior` holding a Java reference keeps the entity reachable.
   133	#[derive(Clone)]
   134	pub enum PositionTracker {
   135	    /// `BlockPosTracker(BlockPos)` (`behavior/BlockPosTracker.java:11-14`): the tracked point
   136	    /// is the block *center*.
   137	    Block { block_pos: BlockPos },
   138	    /// `EntityTracker(entity, trackEyeHeight)` (`behavior/EntityTracker.java:16-24`).
   139	    Entity {
   140	        entity: Weak<dyn EntityBase>,
   141	        track_eye_height: bool,
   142	    },
   143	}
   144	
   145	impl PositionTracker {
   146	    #[must_use]
   147	    pub const fn of_block(block_pos: BlockPos) -> Self {
   148	        Self::Block { block_pos }
   149	    }
   150	
   151	    /// `BlockPosTracker(Vec3)` (`behavior/BlockPosTracker.java:16-19`) keeps the exact vector
   152	    /// as the tracked position rather than re-centering. Pumpkin's `Navigator` only ever
   153	    /// consumes a destination vector, so the distinction is preserved by storing the containing
   154	    /// block and accepting the re-centering; flagged because `RandomStroll` picks a non-centered
   155	    /// point in vanilla.
   156	    #[must_use]
   157	    pub const fn of_position(pos: Vector3<f64>) -> Self {
   158	        Self::Block {
   159	            block_pos: BlockPos::new(
   160	                pos.x.floor() as i32,
   161	                pos.y.floor() as i32,
   162	                pos.z.floor() as i32,
   163	            ),
   164	        }
   165	    }
   166	
   167	    #[must_use]
   168	    pub fn of_entity(entity: &std::sync::Arc<dyn EntityBase>, track_eye_height: bool) -> Self {
   169	        Self::Entity {
   170	            entity: std::sync::Arc::downgrade(entity),
   171	            track_eye_height,
   172	        }
   173	    }
   174	
   175	    /// `PositionTracker.currentPosition()`.
   176	    #[must_use]
   177	    pub fn current_position(&self) -> Option<Vector3<f64>> {
   178	        match self {
   179	            Self::Block { block_pos } => Some(Vector3::new(
   180	                f64::from(block_pos.0.x) + 0.5,
   181	                f64::from(block_pos.0.y) + 0.5,
   182	                f64::from(block_pos.0.z) + 0.5,
   183	            )),
   184	            Self::Entity {
   185	                entity,
   186	                track_eye_height,
   187	            } => {
   188	                let entity = entity.upgrade()?;
   189	                let entity = entity.get_entity();
   190	                let pos = entity.pos.load();
   191	                Some(if *track_eye_height {
   192	                    Vector3::new(pos.x, entity.get_eye_y(), pos.z)
   193	                } else {
   194	                    pos
   195	                })
   196	            }
   197	        }
   198	    }
   199	
   200	    /// `PositionTracker.currentBlockPosition()`.
   201	    #[must_use]
   202	    pub fn current_block_position(&self) -> Option<BlockPos> {
   203	        match self {
   204	            Self::Block { block_pos } => Some(*block_pos),
   205	            Self::Entity { entity, .. } => {
   206	                let entity = entity.upgrade()?;
   207	                Some(entity.get_entity().block_pos.load())
   208	            }
   209	        }
   210	    }

   215	    if profile.is_some() || note_block_sound.is_some() || custom_name.is_some() {
   216	        // `SkullBlockEntity.applyImplicitComponents` copies these three components
   217	        // (`SkullBlockEntity.java:82-87`); `BlockItem.updateBlockEntityComponents` invokes it
   218	        // for the freshly placed entity (`BlockItem.java:101-106`).
   219	        let position = entity.get_position();
   220	        let block_entity_data = stack.get_data_component::<BlockEntityDataImpl>();
   221	        let mut nbt = block_entity_data.map_or_else(NbtCompound::new, |data| data.nbt.clone());

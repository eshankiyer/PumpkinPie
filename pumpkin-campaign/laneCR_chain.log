   298	/// `MultifaceSpreader.spreadAll`.
   299	///
   300	/// Each candidate is read and (if valid) placed before the next candidate is
   301	/// evaluated, so later checks see earlier writes — see the `SpreadTarget` doc comment
   302	/// for why this can't be reduced to a pre-collected list.
   303	pub async fn spread_all(
   304	    config: &dyn SpreadConfig,
   305	    target: &dyn SpreadTarget,
   306	    faces: FaceSet,
   307	    pos: BlockPos,
   308	) -> u64 {
   309	    let mut total = 0;
   310	    for starting_face in BlockDirection::all() {
   311	        if config.can_spread_from(faces, starting_face) {
   312	            total +=
   313	                spread_from_face_toward_all_directions(config, target, faces, pos, starting_face)
   314	                    .await;
   315	        }
   316	    }
   317	    total
   318	}

    94	   private static int locateStructure(final CommandSourceStack source, final ResourceOrTagKeyArgument.Result<Structure> resourceOrTag) throws CommandSyntaxException {
    95	      Registry<Structure> registry = source.getLevel().registryAccess().lookupOrThrow(Registries.STRUCTURE);
    96	      HolderSet<Structure> target = (HolderSet<Structure>)getHolders(resourceOrTag, registry)
    97	         .orElseThrow(() -> ERROR_STRUCTURE_INVALID.create(resourceOrTag.asPrintable()));
    98	      BlockPos sourcePos = BlockPos.containing(source.getPosition());
    99	      ServerLevel serverLevel = source.getLevel();
   100	      Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
   101	      Pair<BlockPos, Holder<Structure>> nearest = serverLevel.getChunkSource()
   102	         .getGenerator()
   103	         .findNearestMapStructure(serverLevel, target, sourcePos, 100, false);
   104	      stopwatch.stop();
   105	      if (nearest == null) {
   106	         throw ERROR_STRUCTURE_NOT_FOUND.create(resourceOrTag.asPrintable());
   107	      } else {
   108	         return showLocateResult(source, resourceOrTag, sourcePos, nearest, "commands.locate.structure.success", false, stopwatch.elapsed());
   109	      }
   110	   }
   111	
   112	   private static int locateBiome(final CommandSourceStack source, final ResourceOrTagArgument.Result<Biome> elementOrTag) throws CommandSyntaxException {
   113	      BlockPos sourcePos = BlockPos.containing(source.getPosition());
   114	      Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
   115	      Pair<BlockPos, Holder<Biome>> nearest = source.getLevel().findClosestBiome3d(elementOrTag, sourcePos, 6400, 32, 64);
   116	      stopwatch.stop();
   117	      if (nearest == null) {
   118	         throw ERROR_BIOME_NOT_FOUND.create(elementOrTag.asPrintable());
   119	      } else {
   120	         return showLocateResult(source, elementOrTag, sourcePos, nearest, "commands.locate.biome.success", true, stopwatch.elapsed());
   121	      }
   122	   }
   123	
   124	   private static int locatePoi(final CommandSourceStack source, final ResourceOrTagArgument.Result<PoiType> resourceOrTag) throws CommandSyntaxException {
   125	      BlockPos sourcePos = BlockPos.containing(source.getPosition());
   126	      ServerLevel serverLevel = source.getLevel();
   127	      Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
   128	      Optional<Pair<Holder<PoiType>, BlockPos>> closestWithType = serverLevel.getPoiManager()
   129	         .findClosestWithType(resourceOrTag, sourcePos, 256, PoiManager.Occupancy.ANY);
   130	      stopwatch.stop();
   131	      if (closestWithType.isEmpty()) {
   132	         throw ERROR_POI_NOT_FOUND.create(resourceOrTag.asPrintable());
   133	      } else {
   134	         return showLocateResult(source, resourceOrTag, sourcePos, closestWithType.get().swap(), "commands.locate.poi.success", false, stopwatch.elapsed());
   135	      }
   136	   }
   137	
   138	   public static int showLocateResult(
   139	      final CommandSourceStack source,
   140	      final ResourceOrTagArgument.Result<?> name,
   141	      final BlockPos sourcePos,
   142	      final Pair<BlockPos, ? extends Holder<?>> found,
   143	      final String successMessageKey,
   144	      final boolean includeY,
   145	      final Duration taskDuration
   146	   ) {
   147	      String foundName = name.unwrap().map(element -> name.asPrintable(), tag -> name.asPrintable() + " (" + found.getSecond().getRegisteredName() + ")");
   148	      return showLocateResult(source, sourcePos, found, successMessageKey, includeY, foundName, taskDuration);
   149	   }
   150	
   151	   public static int showLocateResult(
   152	      final CommandSourceStack source,
   153	      final ResourceOrTagKeyArgument.Result<?> name,
   154	      final BlockPos sourcePos,
   155	      final Pair<BlockPos, ? extends Holder<?>> found,
   156	      final String successMessageKey,
   157	      final boolean includeY,
   158	      final Duration taskDuration
   159	   ) {
   160	      String foundName = name.unwrap()
   161	         .map(element -> element.identifier().toString(), tag -> "#" + tag.location() + " (" + found.getSecond().getRegisteredName() + ")");
   162	      return showLocateResult(source, sourcePos, found, successMessageKey, includeY, foundName, taskDuration);
   163	   }
   164	
   165	   private static int showLocateResult(
   166	      final CommandSourceStack source,
   167	      final BlockPos sourcePos,
   168	      final Pair<BlockPos, ? extends Holder<?>> found,
   169	      final String successMessageKey,
   170	      final boolean includeY,
   171	      final String foundName,
   172	      final Duration taskDuration
   173	   ) {
   174	      BlockPos foundPos = found.getFirst();
   175	      int distance = includeY
   176	         ? Mth.floor(Mth.sqrt((float)sourcePos.distSqr(foundPos)))
   177	         : Mth.floor(dist(sourcePos.getX(), sourcePos.getZ(), foundPos.getX(), foundPos.getZ()));
   178	      String displayedY = includeY ? String.valueOf(foundPos.getY()) : "~";
   179	      Component coordinates = ComponentUtils.wrapInSquareBrackets(Component.translatable("chat.coordinates", foundPos.getX(), displayedY, foundPos.getZ()))
   180	         .withStyle(
   181	            s -> s.withColor(ChatFormatting.GREEN)
   182	               .withClickEvent(new ClickEvent.SuggestCommand("/tp @s " + foundPos.getX() + " " + displayedY + " " + foundPos.getZ()))
   183	               .withHoverEvent(new HoverEvent.ShowText(Component.translatable("chat.coordinates.tooltip")))
   184	         );
   185	      source.sendSuccess(() -> Component.translatable(successMessageKey, foundName, coordinates, distance), false);
   186	      LOGGER.info("Locating element {} took {} ms", foundName, taskDuration.toMillis());
   187	      return distance;
   188	   }
   189	
   190	   private static float dist(final int x1, final int z1, final int x2, final int z2) {
   191	      int dx = x2 - x1;
   192	      int dz = z2 - z1;
   193	      return Mth.sqrt(dx * dx + dz * dz);
   194	   }
   195	}

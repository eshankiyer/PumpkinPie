   692	        // overrides `shouldBeSaved()` to false.
   693	        if !entity.should_be_saved() {
   694	            return;
   695	        }
   696	        if base_entity.is_removed() {
   697	            return;
   698	        }
   699	        let current_chunk = base_entity.block_pos.load().chunk_position();
   700	        let mut nbt = NbtCompound::new();
   701	        // Vanilla always writes the base `Entity`/`LivingEntity` data (`saveWithoutId`)
   702	        // before the type specific `addAdditionalSaveData`. Most Pumpkin entity types
   703	        // have an empty `NBTStorage` impl, which would otherwise persist an empty
   704	        // compound with no `id` and drop the entity on the next load.
   705	        if let Some(living) = entity.get_living_entity() {
   706	            living.write_nbt(&mut nbt).await;
   707	        } else {
   708	            entity.get_entity().write_nbt(&mut nbt).await;
   709	        }
   710	        entity.write_nbt(&mut nbt).await;
   711	        let chunk = self.level.get_entity_chunk(current_chunk).await;
   712	        chunk.data.lock().await.push(nbt);
   713	        chunk.mark_dirty(true);
   714	    }

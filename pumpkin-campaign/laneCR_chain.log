   558	        let mut store = MemoryStore::new();
   559	        store.register(MemoryKeyId::LikedPlayer);
   560	        store.set::<LikedPlayerMemory>(Uuid::nil());
   561	        for _ in 0..100 {
   562	            store.tick_expiry();
   563	        }

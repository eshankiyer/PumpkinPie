   187	    // net.minecraft.world.level.levelgen.feature.stateproviders.RotatedBlockProvider#getState:
   188	    // picks a uniformly random Direction.Axis (X, Y, Z in declaration order) via
   189	    // Util.getRandom, then sets it on the block's `axis` property.
   190	    pub fn get(&self, random: &mut RandomGenerator) -> &'static BlockState {
   191	        let block = Block::from_state_id(self.state.id);
   192	        let Some(props_source) = block.properties(self.state.id) else {
   193	            return self.state;
   194	        };
   195	        let mut props = props_source.to_props();
   196	        let Some(idx) = props.iter().position(|(key, _)| *key == "axis") else {
   197	            return self.state;
   198	        };
   199	
   200	        let axis_str = match random.next_bounded_i32(3) {
   201	            0 => "x",
   202	            1 => "y",
   203	            _ => "z",
   204	        };
   205	        props[idx] = ("axis", axis_str);
   206	
   207	        let new_state_id = block.from_properties(&props).to_state_id(block);
   208	        BlockState::from_id(new_state_id)
   209	    }
   210	}

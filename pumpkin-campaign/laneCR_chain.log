   167	            close_token: pending.close_token,
   168	            tasks: TaskTracker::new(),
   169	            outgoing_packet_queue_send: send,
   170	            outgoing_packet_queue_recv: Some(recv),
   171	            outgoing_packet_priority_send: priority_send,
   172	            outgoing_packet_priority_recv: Some(priority_recv),
   173	            version: pending.version,
   174	            network_writer: std::sync::Mutex::new(Some(pending.network_writer)),
   175	            network_reader: std::sync::Mutex::new(Some(pending.network_reader)),
   176	            brand: ArcSwap::from_pointee(pending.brand),
   177	            player: ArcSwap::from_pointee(None),
   178	            wait_for_keep_alive: AtomicBool::new(false),
   179	            keep_alive_id: AtomicCell::new(0),
   180	            last_keep_alive_time: AtomicCell::new(Instant::now()),
   181	            last_packet_time: AtomicCell::new(Instant::now()),
   182	            pending_keep_alives: std::sync::Mutex::new(Vec::new()),
   183	            packet_sequence: AtomicI32::new(-1),
   184	            packet_limiter: pending.packet_limiter,
   185	        }
   186	    }

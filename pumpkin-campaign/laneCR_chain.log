    81	        match &self.blocks {
    82	            MatchingBlocksWrapper::Single(single_block) => {
    83	                single_block
    84	                    .strip_prefix("minecraft:")
    85	                    .unwrap_or(single_block)
    86	                    == block.name
    87	            }
    88	            MatchingBlocksWrapper::Multiple(blocks) => blocks
    89	                .iter()
    90	                .map(|s| s.strip_prefix("minecraft:").unwrap_or(s))
    91	                .contains(block.name),
    92	        }
    93	    }
    94	}

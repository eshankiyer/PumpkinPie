    29	impl BlockPredicate {
    30	    pub fn test<T: GenerationCache>(
    31	        &self,
    32	        block_registry: &dyn WorldPortalExt,
    33	        chunk: &T,
    34	        pos: &BlockPos,
    35	    ) -> bool {
    36	        match self {
    37	            Self::MatchingBlocks(predicate) => predicate.test(chunk, pos),
    38	            Self::MatchingBiomes(predicate) => predicate.test(chunk, pos),
    39	            Self::MatchingBlockTag(predicate) => predicate.test(chunk, pos),
    40	            Self::MatchingFluids(predicate) => predicate.test(chunk, pos),
    41	            Self::HasSturdyFace(predicate) => predicate.test(chunk, pos),
    42	            Self::Solid(predicate) => predicate.test(chunk, pos),
    43	            Self::Replaceable(predicate) => predicate.test(chunk, pos),
    44	            Self::WouldSurvive(predicate) => predicate.test(block_registry, chunk, pos),
    45	            Self::InsideWorldBounds(predicate) => predicate.test(chunk, pos),
    46	            Self::AnyOf(predicate) => predicate.test(block_registry, chunk, pos),
    47	            Self::AllOf(predicate) => predicate.test(block_registry, chunk, pos),
    48	            Self::Not(predicate) => predicate.test(block_registry, chunk, pos),
    49	            Self::AlwaysTrue => true,
    50	        }
    51	    }

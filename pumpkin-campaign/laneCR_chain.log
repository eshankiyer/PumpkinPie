   144	                }
   145	            }
   146	            RunningPolicy::TryAll => {
   147	                for (behavior, _) in &mut self.behaviors {
   148	                    if behavior.status() == BehaviorStatus::Stopped {
   149	                        behavior.try_start(mob, brain, game_time);
   150	                    }
   151	                }
   152	            }
   153	        }
   154	        true
   155	    }

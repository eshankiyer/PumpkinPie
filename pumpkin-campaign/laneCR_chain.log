   200	    /// Checks if a block can provide support for a sign.
   201	    fn is_valid_support(world: &World, pos: &BlockPos, direction: BlockDirection) -> bool {
   202	        let (block, state) = world.get_block_and_state(pos);
   203	        let is_permissive = block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_LEAVES)
   204	            || block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_SIGNS);
   205	
   206	        match direction {
   207	            BlockDirection::Up => state.is_side_solid(BlockDirection::Down) || is_permissive,
   208	            BlockDirection::Down => state.is_center_solid(BlockDirection::Up) || is_permissive,
   209	            _ => state.is_side_solid(direction.opposite()) || is_permissive,
   210	        }
   211	    }
   212	
   213	    /// Detects available support points around a position.
   214	    fn detect_support(world: &World, position: &BlockPos) -> SupportInfo {
   215	        let (block_above, state_above) = world.get_block_and_state(&position.up());
   216	        let above_is_valid = state_above.is_side_solid(BlockDirection::Down)
   217	            || block_above.has_tag(&pumpkin_data::tag::Block::MINECRAFT_SIGNS)
   218	            || block_above.has_tag(&pumpkin_data::tag::Block::MINECRAFT_LEAVES);
   219	
   220	        let mut side_direction = None;
   221	        for direction in BlockDirection::horizontal() {
   222	            let pos = position.offset(direction.to_offset());
   223	            if Self::is_valid_support(world, &pos, direction.opposite().to_block_direction()) {
   224	                side_direction = Some(direction);
   225	                break;
   226	            }
   227	        }
   228	
   229	        SupportInfo {
   230	            above_is_valid,
   231	            side_direction: side_direction.map(|d| d.to_block_direction()),
   232	        }
   233	    }

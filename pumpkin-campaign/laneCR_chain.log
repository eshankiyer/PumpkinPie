   406	
   407	    #[test]
   408	    fn parse_simple_template() {
   409	        let t = template("say hello $(name)");
   410	        assert_eq!(t.segments, vec!["say hello ".to_string()]);
   411	        assert_eq!(t.variables, vec!["name".to_string()]);
   412	    }
   413	
   414	    #[test]

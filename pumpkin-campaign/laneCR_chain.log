   229	                    }
   230	
   231	                    // Generate a unique ID (current timestamp in ms)
   232	                    let keep_alive_id = SystemTime::now()
   233	                        .duration_since(UNIX_EPOCH)
   234	                        .unwrap_or_default()
   235	                        .as_millis() as i64;
   236	
   237	                    self.keep_alive_id.store(keep_alive_id);
   238	                    self.wait_for_keep_alive.store(true, Ordering::Relaxed);
   239	                    self.last_keep_alive_time.store(Instant::now());

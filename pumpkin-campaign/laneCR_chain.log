    14	/// An iterator that yields all `BlockPos` positions within a cuboid region.
    15	pub struct BlockPosIterator {
    16	    /// The minimum X coordinate (inclusive).
    17	    start_x: i32,
    18	    /// The minimum Y coordinate (inclusive).
    19	    start_y: i32,
    20	    /// The minimum Z coordinate (inclusive).
    21	    start_z: i32,
    22	    /// The maximum X coordinate (inclusive).
    23	    end_x: i32,
    24	    /// The maximum Y coordinate (inclusive).
    25	    end_y: i32,
    26	    /// The current iteration index.
    27	    index: usize,
    28	    /// The total number of positions to iterate.
    29	    count: usize,
    30	}
    31	
    32	impl BlockPosIterator {
    33	    /// Creates a new `BlockPosIterator` over the specified inclusive cuboid region.
    34	    ///
    35	    /// # Arguments
    36	    /// - `start_x` – The minimum X coordinate (inclusive).
    37	    /// - `start_y` – The minimum Y coordinate (inclusive).
    38	    /// - `start_z` – The minimum Z coordinate (inclusive).
    39	    /// - `end_x` – The maximum X coordinate (inclusive).
    40	    /// - `end_y` – The maximum Y coordinate (inclusive).
    41	    /// - `end_z` – The maximum Z coordinate (inclusive).
    42	    ///
    43	    /// # Returns
    44	    /// A new `BlockPosIterator` instance.
    45	    #[must_use]
    46	    pub const fn new(
    47	        start_x: i32,
    48	        start_y: i32,
    49	        start_z: i32,
    50	        end_x: i32,
    51	        end_y: i32,
    52	        end_z: i32,
    53	    ) -> Self {
    54	        let count_x = end_x - start_x + 1;
    55	        let count_y = end_y - start_y + 1;
    56	        let count_z = end_z - start_z + 1;
    57	        let count = (count_x * count_y * count_z) as usize;
    58	        Self {
    59	            start_x,
    60	            start_y,
    61	            start_z,
    62	            end_x,
    63	            end_y,
    64	            index: 0,
    65	            count,
    66	        }
    67	    }
    68	}
    69	
    70	impl Iterator for BlockPosIterator {
    71	    type Item = BlockPos;
    72	
    73	    fn next(&mut self) -> Option<Self::Item> {
    74	        if self.index >= self.count {
    75	            return None;
    76	        }
    77	
    78	        let size_x = (self.end_x - self.start_x + 1) as usize;
    79	        let size_y = (self.end_y - self.start_y + 1) as usize;
    80	
    81	        let x_offset = self.index % size_x;
    82	        let y_offset = (self.index / size_x) % size_y;
    83	        let z_offset = (self.index / size_x) / size_y;
    84	
    85	        let x = self.start_x + x_offset as i32;
    86	        let y = self.start_y + y_offset as i32;
    87	        let z = self.start_z + z_offset as i32;
    88	
    89	        self.index += 1;
    90	        Some(BlockPos::new(x, y, z))
    91	    }
    92	}

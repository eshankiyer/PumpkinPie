    15	            // (`ServerGamePacketListenerImpl.java:507-508`).
    16	            vehicle_entity
    17	                .do_check_fall_damage(
    18	                    vehicle.clone(),
    19	                    pos.x - old_pos.x,
    20	                    pos.y - old_pos.y,
    21	                    pos.z - old_pos.z,
    22	                    packet.on_ground,
    23	                )
    24	                .await;
    25	        }
    26	        drop(vehicle);
    27	        entity.set_pos(pos);

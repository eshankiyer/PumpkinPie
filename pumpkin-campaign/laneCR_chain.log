    74	    /// `new RunOne(weightedBehaviors)` (`RunOne.java:13-19`): no entry condition, nothing erased
    75	    /// on exit, `SHUFFLED` order, `RUN_ONE` policy.
    76	    #[must_use]
    77	    pub fn run_one(behaviors: Vec<(Box<dyn Behavior>, i32)>) -> Box<dyn Behavior> {
    78	        Box::new(Self::new(
    79	            Vec::new(),
    80	            Vec::new(),
    81	            OrderPolicy::Shuffled,
    82	            RunningPolicy::RunOne,
    83	            behaviors,
    84	        ))
    85	    }

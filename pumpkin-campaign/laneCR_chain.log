    41	    /// `ShufflingList<BehaviorControl>` (`GateBehavior.java:22`): `(behavior, weight)`.
    42	    behaviors: Vec<(Box<dyn Behavior>, i32)>,
    43	    status: BehaviorStatus,
    44	}
    45	
    46	impl GateBehavior {
    47	    #[must_use]
    48	    pub fn new(
    49	        entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
    50	        exit_erased_memories: Vec<MemoryKeyId>,
    51	        order_policy: OrderPolicy,
    52	        running_policy: RunningPolicy,
    53	        behaviors: Vec<(Box<dyn Behavior>, i32)>,
    54	    ) -> Self {
    55	        let mut required_memories = entry_condition.clone();
    56	        for (behavior, _) in &behaviors {
    57	            for condition in behavior.required_memories() {
    58	                if !required_memories.contains(condition) {
    59	                    required_memories.push(*condition);
    60	                }
    61	            }
    62	        }
    63	        Self {
    64	            entry_condition,
    65	            required_memories,
    66	            exit_erased_memories,
    67	            order_policy,
    68	            running_policy,
    69	            behaviors,
    70	            status: BehaviorStatus::Stopped,
    71	        }
    72	    }

   573	        store.set::<ItemPickupCooldownTicksMemory>(2);
   574	        assert_eq!(store.get::<LikedNoteblockCooldownTicksMemory>(), Some(&1));
   575	        assert_eq!(store.get::<ItemPickupCooldownTicksMemory>(), Some(&2));
   576	        store.erase::<LikedNoteblockCooldownTicksMemory>();
   577	        assert_eq!(store.get::<ItemPickupCooldownTicksMemory>(), Some(&2));

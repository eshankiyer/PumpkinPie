   158	/// Reads the vanilla `STAGE` property generically, so blocks in the saplings tag that do not
   159	/// carry one (the azaleas) simply report `None` and grow straight away.
   160	fn stage_of(block: &Block, state_id: BlockStateId) -> Option<u8> {
   161	    block.properties(state_id).and_then(|props| {
   162	        props
   163	            .to_props()
   164	            .iter()
   165	            .find(|(key, _)| *key == "stage")
   166	            .and_then(|(_, value)| value.parse::<u8>().ok())
   167	    })
   168	}
   169	
   170	fn with_stage(block: &Block, state_id: BlockStateId, stage: &str) -> Option<BlockStateId> {
   171	    let props = block.properties(state_id)?;
   172	    let updated: Vec<(&str, &str)> = props
   173	        .to_props()
   174	        .iter()
   175	        .map(|(key, value)| {
   176	            if *key == "stage" {
   177	                (*key, stage)
   178	            } else {
   179	                (*key, *value)
   180	            }
   181	        })
   182	        .collect();
   183	    Some(block.from_properties(&updated).to_state_id(block))
   184	}

   104	    /// `ScaffoldingBlock.getStateForPlacement`.
   105	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   106	        Box::pin(async move {
   107	            let mut props = ScaffoldingLikeProperties::default(args.block);
   108	            props.r#waterlogged = args.replacing.water_source();
   109	            props.r#distance = Self::get_distance(args.world, args.position);
   110	            props.r#bottom = Self::is_bottom(args.world, args.position, props.r#distance);
   111	            props.to_state_id(args.block)
   112	        })
   113	    }

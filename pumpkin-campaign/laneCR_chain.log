    87	         case DoubleTag(double value) -> DECIMAL_FORMAT.format(value);
    88	         case ByteTag(byte value) -> String.valueOf(value);
    89	         case ShortTag(short value) -> String.valueOf(value);
    90	         case LongTag(long value) -> String.valueOf(value);
    91	         case StringTag(String value) -> value;

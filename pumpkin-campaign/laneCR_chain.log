   466	fn execute_summon_modifier<'a>(
   467	    context: &'a CommandContext,
   468	) -> crate::command::node::RedirectModifierResult<'a> {
   469	    Box::pin(async move {
   470	        let entity_type = ResourceArgument::get_summonable_entity_type(context, "entity_type")?;
   471	        let entity = from_type(
   472	            entity_type,
   473	            context.source.position,
   474	            context.source.world(),
   475	            Uuid::new_v4(),
   476	        );
   477	        context.source.world().spawn_entity(entity.clone()).await;
   478	        let mut source = context.source.as_ref().clone();
   479	        source.entity = Some(entity);
   480	        Ok(vec![Arc::new(source)])
   481	    })
   482	}

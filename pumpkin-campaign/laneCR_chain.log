   266	   private static final class Placer {
   267	      private final Registry<StructureTemplatePool> pools;
   268	      private final int maxDepth;
   269	      private final ChunkGenerator chunkGenerator;
   270	      private final StructureTemplateManager structureTemplateManager;
   271	      private final List<? super PoolElementStructurePiece> pieces;
   272	      private final RandomSource random;
   273	      private final SequencedPriorityIterator<JigsawPlacement.PieceState> placing = new SequencedPriorityIterator<>();
   274	
   275	      private Placer(
   276	         final Registry<StructureTemplatePool> pools,
   277	         final int maxDepth,
   278	         final ChunkGenerator chunkGenerator,
   279	         final StructureTemplateManager structureTemplateManager,
   280	         final List<? super PoolElementStructurePiece> pieces,
   281	         final RandomSource random
   282	      ) {
   283	         this.pools = pools;
   284	         this.maxDepth = maxDepth;
   285	         this.chunkGenerator = chunkGenerator;
   286	         this.structureTemplateManager = structureTemplateManager;
   287	         this.pieces = pieces;
   288	         this.random = random;
   289	      }
   290	
   291	      private void tryPlacingChildren(
   292	         final PoolElementStructurePiece sourcePiece,
   293	         final MutableObject<VoxelShape> contextFree,
   294	         final int depth,
   295	         final boolean doExpansionHack,
   296	         final LevelHeightAccessor heightAccessor,
   297	         final RandomState randomState,
   298	         final PoolAliasLookup poolAliasLookup,
   299	         final LiquidSettings liquidSettings
   300	      ) {
   301	         StructurePoolElement sourceElement = sourcePiece.getElement();
   302	         BlockPos sourceBoxPosition = sourcePiece.getPosition();
   303	         Rotation sourceRotation = sourcePiece.getRotation();
   304	         StructureTemplatePool.Projection sourceProjection = sourceElement.getProjection();
   305	         boolean sourceRigid = sourceProjection == StructureTemplatePool.Projection.RIGID;
   306	         MutableObject<VoxelShape> sourceFree = new MutableObject<>();
   307	         BoundingBox sourceBB = sourcePiece.getBoundingBox();
   308	         int sourceBoxY = sourceBB.minY();
   309	
   310	         label129:
   311	         for (StructureTemplate.JigsawBlockInfo sourceJigsaw : sourceElement.getShuffledJigsawBlocks(
   312	            this.structureTemplateManager, sourceBoxPosition, sourceRotation, this.random
   313	         )) {
   314	            StructureTemplate.StructureBlockInfo sourceJigsawInfo = sourceJigsaw.info();
   315	            Direction sourceDirection = JigsawBlock.getFrontFacing(sourceJigsawInfo.state());
   316	            BlockPos sourceJigsawPos = sourceJigsawInfo.pos();
   317	            BlockPos targetJigsawPos = sourceJigsawPos.relative(sourceDirection);
   318	            int sourceJigsawLocalY = sourceJigsawPos.getY() - sourceBoxY;
   319	            int sourceJigsawBaseHeight = Integer.MIN_VALUE;
   320	            ResourceKey<StructureTemplatePool> poolName = poolAliasLookup.lookup(sourceJigsaw.pool());
   321	            Optional<? extends Holder<StructureTemplatePool>> maybeTargetPool = this.pools.get(poolName);
   322	            if (maybeTargetPool.isEmpty()) {
   323	               JigsawPlacement.LOGGER.warn("Empty or non-existent pool: {}", poolName.identifier());
   324	            } else {
   325	               Holder<StructureTemplatePool> targetPool = (Holder<StructureTemplatePool>)maybeTargetPool.get();
   326	               if (targetPool.value().size() == 0 && !targetPool.is(Pools.EMPTY)) {
   327	                  JigsawPlacement.LOGGER.warn("Empty or non-existent pool: {}", poolName.identifier());
   328	               } else {
   329	                  Holder<StructureTemplatePool> fallback = targetPool.value().getFallback();
   330	                  if (fallback.value().size() == 0 && !fallback.is(Pools.EMPTY)) {
   331	                     JigsawPlacement.LOGGER
   332	                        .warn("Empty or non-existent fallback pool: {}", fallback.unwrapKey().map(e -> e.identifier().toString()).orElse("<unregistered>"));
   333	                  } else {
   334	                     boolean attachInsideSource = sourceBB.isInside(targetJigsawPos);
   335	                     MutableObject<VoxelShape> childrenFree;
   336	                     if (attachInsideSource) {
   337	                        childrenFree = sourceFree;
   338	                        if (sourceFree.get() == null) {
   339	                           sourceFree.setValue(Shapes.create(AABB.of(sourceBB)));
   340	                        }
   341	                     } else {
   342	                        childrenFree = contextFree;
   343	                     }
   344	
   345	                     List<StructurePoolElement> targetPieces = Lists.newArrayList();
   346	                     if (depth != this.maxDepth) {
   347	                        targetPieces.addAll(targetPool.value().getShuffledTemplates(this.random));
   348	                     }
   349	
   350	                     targetPieces.addAll(fallback.value().getShuffledTemplates(this.random));
   351	                     int placementPriority = sourceJigsaw.placementPriority();
   352	
   353	                     for (StructurePoolElement targetElement : targetPieces) {
   354	                        if (targetElement == EmptyPoolElement.INSTANCE) {
   355	                           break;
   356	                        }
   357	
   358	                        for (Rotation targetRotation : Rotation.getShuffled(this.random)) {
   359	                           List<StructureTemplate.JigsawBlockInfo> targetJigsaws = targetElement.getShuffledJigsawBlocks(
   360	                              this.structureTemplateManager, BlockPos.ZERO, targetRotation, this.random
   361	                           );
   362	                           BoundingBox hackBox = targetElement.getBoundingBox(this.structureTemplateManager, BlockPos.ZERO, targetRotation);
   363	                           int expandTo;
   364	                           if (doExpansionHack && hackBox.getYSpan() <= 16) {
   365	                              expandTo = targetJigsaws.stream().mapToInt(targetJigsawx -> {
   366	                                 StructureTemplate.StructureBlockInfo targetJigsawInfo = targetJigsawx.info();
   367	                                 if (!hackBox.isInside(targetJigsawInfo.pos().relative(JigsawBlock.getFrontFacing(targetJigsawInfo.state())))) {
   368	                                    return 0;
   369	                                 }
   370	
   371	                                 ResourceKey<StructureTemplatePool> childPoolName = poolAliasLookup.lookup(targetJigsawx.pool());
   372	                                 Optional<? extends Holder<StructureTemplatePool>> childPool = this.pools.get(childPoolName);
   373	                                 Optional<Holder<StructureTemplatePool>> childFallbackPool = childPool.map(p -> p.value().getFallback());
   374	                                 int childPoolSize = childPool.<Integer>map(p -> p.value().getMaxSize(this.structureTemplateManager)).orElse(0);
   375	                                 int childFallbackSize = childFallbackPool.<Integer>map(p -> p.value().getMaxSize(this.structureTemplateManager)).orElse(0);
   376	                                 return Math.max(childPoolSize, childFallbackSize);
   377	                              }).max().orElse(0);
   378	                           } else {
   379	                              expandTo = 0;
   380	                           }
   381	
   382	                           for (StructureTemplate.JigsawBlockInfo targetJigsaw : targetJigsaws) {
   383	                              if (JigsawBlock.canAttach(sourceJigsaw, targetJigsaw)) {
   384	                                 BlockPos targetJigsawLocalPos = targetJigsaw.info().pos();
   385	                                 BlockPos rawTargetBoxPos = targetJigsawPos.subtract(targetJigsawLocalPos);
   386	                                 BoundingBox rawTargetBB = targetElement.getBoundingBox(this.structureTemplateManager, rawTargetBoxPos, targetRotation);
   387	                                 int rawTargetY = rawTargetBB.minY();
   388	                                 StructureTemplatePool.Projection targetProjection = targetElement.getProjection();
   389	                                 boolean targetRigid = targetProjection == StructureTemplatePool.Projection.RIGID;
   390	                                 int targetJigsawLocalY = targetJigsawLocalPos.getY();
   391	                                 int deltaY = sourceJigsawLocalY - targetJigsawLocalY + JigsawBlock.getFrontFacing(sourceJigsawInfo.state()).getStepY();
   392	                                 int targetBoxY;
   393	                                 if (sourceRigid && targetRigid) {
   394	                                    targetBoxY = sourceBoxY + deltaY;
   395	                                 } else {
   396	                                    if (sourceJigsawBaseHeight == Integer.MIN_VALUE) {
   397	                                       sourceJigsawBaseHeight = this.chunkGenerator
   398	                                          .getFirstFreeHeight(
   399	                                             sourceJigsawPos.getX(), sourceJigsawPos.getZ(), Heightmap.Types.WORLD_SURFACE_WG, heightAccessor, randomState
   400	                                          );
   401	                                    }
   402	
   403	                                    targetBoxY = sourceJigsawBaseHeight - targetJigsawLocalY;
   404	                                 }
   405	
   406	                                 int yOffset = targetBoxY - rawTargetY;
   407	                                 BoundingBox targetBB = rawTargetBB.moved(0, yOffset, 0);
   408	                                 BlockPos targetBoxPosition = rawTargetBoxPos.offset(0, yOffset, 0);
   409	                                 if (expandTo > 0) {
   410	                                    int newSize = Math.max(expandTo + 1, targetBB.maxY() - targetBB.minY());
   411	                                    targetBB.encapsulate(new BlockPos(targetBB.minX(), targetBB.minY() + newSize, targetBB.minZ()));
   412	                                 }
   413	
   414	                                 if (!Shapes.joinIsNotEmpty(childrenFree.get(), Shapes.create(AABB.of(targetBB).deflate(0.25)), BooleanOp.ONLY_SECOND)) {
   415	                                    childrenFree.setValue(Shapes.joinUnoptimized(childrenFree.get(), Shapes.create(AABB.of(targetBB)), BooleanOp.ONLY_FIRST));
   416	                                    int sourceGroundLevelDelta = sourcePiece.getGroundLevelDelta();
   417	                                    int targetGroundLevelDelta;
   418	                                    if (targetRigid) {
   419	                                       targetGroundLevelDelta = sourceGroundLevelDelta - deltaY;
   420	                                    } else {
   421	                                       targetGroundLevelDelta = targetElement.getGroundLevelDelta();
   422	                                    }
   423	
   424	                                    PoolElementStructurePiece targetPiece = new PoolElementStructurePiece(
   425	                                       this.structureTemplateManager,
   426	                                       targetElement,
   427	                                       targetBoxPosition,
   428	                                       targetGroundLevelDelta,
   429	                                       targetRotation,
   430	                                       targetBB,
   431	                                       liquidSettings
   432	                                    );
   433	                                    int junctionY;
   434	                                    if (sourceRigid) {
   435	                                       junctionY = sourceBoxY + sourceJigsawLocalY;
   436	                                    } else if (targetRigid) {
   437	                                       junctionY = targetBoxY + targetJigsawLocalY;
   438	                                    } else {
   439	                                       if (sourceJigsawBaseHeight == Integer.MIN_VALUE) {
   440	                                          sourceJigsawBaseHeight = this.chunkGenerator
   441	                                             .getFirstFreeHeight(
   442	                                                sourceJigsawPos.getX(), sourceJigsawPos.getZ(), Heightmap.Types.WORLD_SURFACE_WG, heightAccessor, randomState
   443	                                             );
   444	                                       }
   445	
   446	                                       junctionY = sourceJigsawBaseHeight + deltaY / 2;
   447	                                    }
   448	
   449	                                    sourcePiece.addJunction(
   450	                                       new JigsawJunction(
   451	                                          targetJigsawPos.getX(),
   452	                                          junctionY - sourceJigsawLocalY + sourceGroundLevelDelta,
   453	                                          targetJigsawPos.getZ(),
   454	                                          deltaY,
   455	                                          targetProjection
   456	                                       )
   457	                                    );
   458	                                    targetPiece.addJunction(
   459	                                       new JigsawJunction(
   460	                                          sourceJigsawPos.getX(),
   461	                                          junctionY - targetJigsawLocalY + targetGroundLevelDelta,
   462	                                          sourceJigsawPos.getZ(),
   463	                                          -deltaY,
   464	                                          sourceProjection
   465	                                       )
   466	                                    );
   467	                                    this.pieces.add(targetPiece);
   468	                                    if (depth + 1 <= this.maxDepth) {
   469	                                       JigsawPlacement.PieceState state = new JigsawPlacement.PieceState(targetPiece, childrenFree, depth + 1);
   470	                                       this.placing.add(state, placementPriority);
   471	                                    }
   472	                                    continue label129;
   473	                                 }
   474	                              }
   475	                           }
   476	                        }
   477	                     }
   478	                  }
   479	               }
   480	            }
   481	         }
   482	      }
   483	   }
   484	}

    61	impl Goal for InteractWithDoorGoal {
    62	    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
    63	        Box::pin(async move {
    64	            let mob_entity = mob.get_mob_entity();
    65	            let entity = &mob_entity.living_entity.entity;
    66	
    67	            if self.only_during_raid && !mob_entity.living_entity.has_active_raid() {
    68	                return false;
    69	            }
    70	
    71	            // Must have horizontal collision to be trying to open a door
    72	            if !entity
    73	                .horizontal_collision
    74	                .load(std::sync::atomic::Ordering::Relaxed)
    75	            {
    76	                return false;
    77	            }
    78	
    79	            // Check if there's an active path
    80	            let navigator = mob_entity.navigator.lock().unwrap();
    81	            let Some(path) = navigator.get_current_path() else {
    82	                return false;
    83	            };
    84	
    85	            // Path must not be done
    86	            if path.is_done() {
    87	                return false;
    88	            }
    89	
    90	            // Scan through upcoming path nodes looking for doors
    91	            let next_index = path.get_next_node_index();
    92	            let node_count = path.get_node_count();
    93	            let scan_end = std::cmp::min(next_index + 2, node_count);
    94	
    95	            let world = entity.world.load_full();
    96	            for i in next_index..scan_end {
    97	                if let Some(node) = path.get_node(i) {
    98	                    // Check at y + 1 as per vanilla (doors are two blocks tall)
    99	                    let check_pos = BlockPos::new(node.pos.0.x, node.pos.0.y + 1, node.pos.0.z);
   100	
   101	                    // Door must be within 1.5 blocks (2.25 squared distance)
   102	                    let dx = check_pos.0.x as f64 + 0.5 - entity.pos.load().x;
   103	                    let dz = check_pos.0.z as f64 + 0.5 - entity.pos.load().z;
   104	                    let dist_sq = dx * dx + dz * dz;
   105	
   106	                    if dist_sq <= 2.25 && Self::is_mob_interactable_door(&world, &check_pos) {
   107	                        self.door_pos = Some(check_pos);
   108	                        drop(navigator); // Release the lock before returning
   109	                        return true;
   110	                    }
   111	                }
   112	            }
   113	
   114	            // Also check the block above the mob itself
   115	            let mob_pos = entity.block_pos.load();
   116	            let check_pos = BlockPos::new(mob_pos.0.x, mob_pos.0.y + 1, mob_pos.0.z);
   117	            if Self::is_mob_interactable_door(&world, &check_pos) {
   118	                self.door_pos = Some(check_pos);
   119	                drop(navigator); // Release the lock before returning
   120	                return true;
   121	            }
   122	
   123	            false
   124	        })
   125	    }
   126	
   127	    fn should_continue<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   128	        Box::pin(async move {
   129	            // Stop once we've passed through the door
   130	            !self.passed_door
   131	        })
   132	    }
   133	
   134	    fn start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   135	        Box::pin(async move {
   136	            self.passed_door = false;
   137	            if let Some(door_pos) = self.door_pos {
   138	                // Calculate direction vector from mob to door
   139	                // This will be used to detect when the mob has passed through
   140	                let entity_pos = mob.get_entity().pos.load();
   141	                self.door_open_dir_x = (door_pos.0.x as f32 + 0.5) - entity_pos.x as f32;
   142	                self.door_open_dir_z = (door_pos.0.z as f32 + 0.5) - entity_pos.z as f32;
   143	            }
   144	        })
   145	    }
   146	
   147	    fn tick<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   148	        Box::pin(async move {
   149	            if let Some(door_pos) = self.door_pos {
   150	                let world = mob.get_entity().world.load_full();
   151	                let entity = &mob.get_mob_entity().living_entity.entity;
   152	                let entity_pos = entity.pos.load();
   153	
   154	                // Calculate new direction vector
   155	                let new_door_dir_x = (door_pos.0.x as f32 + 0.5) - entity_pos.x as f32;
   156	                let new_door_dir_z = (door_pos.0.z as f32 + 0.5) - entity_pos.z as f32;
   157	
   158	                // Dot product to check if we've passed through the door
   159	                let dot =
   160	                    self.door_open_dir_x * new_door_dir_x + self.door_open_dir_z * new_door_dir_z;
   161	                if dot < 0.0 {
   162	                    self.passed_door = true;
   163	                    // Close the door if requested and it's open
   164	                    if self.close_door_after && Self::is_door_open(&world, &door_pos) {
   165	                        crate::block::blocks::doors::set_door_open(&world, &door_pos, false).await;
   166	                    }
   167	                    return;
   168	                }
   169	
   170	                // Open the door if it's not already open
   171	                if !Self::is_door_open(&world, &door_pos) {
   172	                    crate::block::blocks::doors::set_door_open(&world, &door_pos, true).await;
   173	                }
   174	            }
   175	        })
   176	    }
   177	
   178	    fn should_run_every_tick(&self) -> bool {
   179	        true
   180	    }
   181	
   182	    fn controls(&self) -> Controls {
   183	        Controls::empty()
   184	    }
   185	}

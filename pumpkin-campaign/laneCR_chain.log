   271	impl SaplingBlock {
   272	    async fn generate(&self, world: &Arc<World>, pos: &BlockPos) {
   273	        use crate::plugin::api::events::world::structure_grow::{StructureGrowEvent, TreeType};
   274	        let mut event = StructureGrowEvent::new(*pos, TreeType::Oak, false);
   275	        if let Some(server) = world.server.upgrade() {
   276	            server.plugin_manager.fire(&server, &mut event).await;
   277	        }
   278	        if event.cancelled {
   279	            return;
   280	        }
   281	
   282	        let (block, state_id) = world.get_block_and_state_id(pos);
   283	        advance_tree(world, pos, block, state_id).await;
   284	    }
   285	}

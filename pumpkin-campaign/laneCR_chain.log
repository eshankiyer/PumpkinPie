    32	   public ShovelItem(final ToolMaterial material, final float attackDamageBaseline, final float attackSpeedBaseline, final Item.Properties properties) {
    33	      super(properties.shovel(material, attackDamageBaseline, attackSpeedBaseline));
    34	   }
    35	
    36	   @Override
    37	   public InteractionResult useOn(final UseOnContext context) {
    38	      Level level = context.getLevel();
    39	      BlockPos pos = context.getClickedPos();
    40	      BlockState blockState = level.getBlockState(pos);
    41	      if (context.getClickedFace() == Direction.DOWN) {
    42	         return InteractionResult.PASS;
    43	      }
    44	
    45	      Player player = context.getPlayer();
    46	      BlockState newState = FLATTENABLES.get(blockState.getBlock());
    47	      BlockState updatedState = null;
    48	      if (newState != null && level.getBlockState(pos.above()).isAir()) {
    49	         level.playSound(player, pos, SoundEvents.SHOVEL_FLATTEN, SoundSource.BLOCKS, 1.0F, 1.0F);
    50	         updatedState = newState;
    51	      } else if (blockState.getBlock() instanceof CampfireBlock && blockState.getValue(CampfireBlock.LIT)) {
    52	         if (!level.isClientSide()) {
    53	            level.levelEvent(null, 1009, pos, 0);
    54	         }
    55	
    56	         CampfireBlock.dowse(context.getPlayer(), level, pos, blockState);
    57	         updatedState = blockState.setValue(CampfireBlock.LIT, false);
    58	      }
    59	
    60	      if (updatedState != null) {
    61	         if (!level.isClientSide()) {
    62	            level.setBlock(pos, updatedState, 11);
    63	            level.gameEvent(GameEvent.BLOCK_CHANGE, pos, GameEvent.Context.of(player, updatedState));
    64	            if (player != null) {
    65	               context.getItemInHand().hurtAndBreak(1, player, context.getHand().asEquipmentSlot());
    66	            }
    67	         }
    68	
    69	         return InteractionResult.SUCCESS;
    70	      } else {
    71	         return InteractionResult.PASS;
    72	      }
    73	   }
    74	}

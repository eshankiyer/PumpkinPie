    19	pub struct ShovelItem;
    20	
    21	impl ItemMetadata for ShovelItem {
    22	    fn ids() -> Box<[u16]> {
    23	        tag::Item::MINECRAFT_SHOVELS.1.into()
    24	    }
    25	}
    26	
    27	impl ItemBehaviour for ShovelItem {
    28	    fn use_on_block<'a>(
    29	        &'a self,
    30	        _item: &'a mut ItemStack,
    31	        player: &'a Player,
    32	        location: BlockPos,
    33	        face: BlockDirection,
    34	        _cursor_pos: Vector3<f32>,
    35	        block: &'a Block,
    36	        _server: &'a Server,
    37	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    38	        Box::pin(async move {
    39	            // Vanilla ShovelItem#useOn: `if (context.getClickedFace() == Direction.DOWN) return
    40	            // InteractionResult.PASS;` guards the entire method, both flattening and campfire
    41	            // dowsing -- shoveling the bottom face of a block never does anything.
    42	            if face == BlockDirection::Down {
    43	                return;
    44	            }
    45	
    46	            let world = player.world();
    47	            // Yes, Minecraft does hardcode these
    48	            let mut changed = if (block == &Block::GRASS_BLOCK
    49	                || block == &Block::DIRT
    50	                || block == &Block::COARSE_DIRT
    51	                || block == &Block::ROOTED_DIRT
    52	                || block == &Block::PODZOL
    53	                || block == &Block::MYCELIUM)
    54	                && world.get_block_state(&location.up()).is_air()
    55	            {
    56	                world
    57	                    .set_block_state(
    58	                        &location,
    59	                        Block::DIRT_PATH.default_state.id,
    60	                        BlockFlags::NOTIFY_ALL,
    61	                    )
    62	                    .await;
    63	                // Vanilla `ShovelItem#useOn` uses `level.playSound(player, pos, ...)`, which plays
    64	                // the sound at the block centre for every nearby player except the one acting.
    65	                world.play_block_sound_expect(
    66	                    player,
    67	                    Sound::ItemShovelFlatten,
    68	                    SoundCategory::Blocks,
    69	                    location,
    70	                );
    71	                true
    72	            } else {
    73	                false
    74	            };
    75	            if block == &Block::CAMPFIRE || block == &Block::SOUL_CAMPFIRE {
    76	                let mut campfire_props = CampfireLikeProperties::from_state_id(
    77	                    world.get_block_state(&location).id,
    78	                    block,
    79	                );
    80	                if campfire_props.lit {
    81	                    world.sync_world_event(WorldEvent::SoundExtinguishFire, location, 0);
    82	
    83	                    // CampfireBlock.dowse emits BLOCK_CHANGE before ShovelItem emits its
    84	                    // contextual block-change event (CampfireBlock.java:193-201).
    85	                    if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id)
    86	                    {
    87	                        emit_game_event(
    88	                            &world,
    89	                            GameEvent::BlockChange,
    90	                            location.to_centered_f64(),
    91	                            GameEventContext::of_entity(player_arc),
    92	                        )
    93	                        .await;
    94	                    }
    95	
    96	                    campfire_props.lit = false;
    97	                    world
    98	                        .set_block_state(
    99	                            &location,
   100	                            campfire_props.to_state_id(block),
   101	                            BlockFlags::NOTIFY_ALL,
   102	                        )
   103	                        .await;
   104	                    changed = true;
   105	                }
   106	            }
   107	
   108	            if changed {
   109	                // ShovelItem.useOn: level.gameEvent(BLOCK_CHANGE, pos, Context.of(player,
   110	                // updatedState)) (ShovelItem.java:60-67).
   111	                if let Some(player_arc) = world.get_player_by_id(player.get_entity().entity_id) {
   112	                    let state_id = world.get_block_state_id(&location);
   113	                    emit_game_event(
   114	                        &world,
   115	                        GameEvent::BlockChange,
   116	                        location.to_centered_f64(),
   117	                        GameEventContext::of_entity_with_block_state(player_arc, state_id),
   118	                    )
   119	                    .await;
   120	                }
   121	
   122	                if player.gamemode.load() != GameMode::Creative {
   123	                    player.damage_held_item(1).await;
   124	                }
   125	            }
   126	        })
   127	    }

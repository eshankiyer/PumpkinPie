   357	#[derive(Clone)]
   358	pub struct ParentHandle<P> {
   359	    ptr: *const P,
   360	}
   361	
   362	impl<P> ParentHandle<P> {
   363	    /// This wrapper allows a child struct to hold a reference to its parent
   364	    /// without making the code overly verbose.
   365	    ///
   366	    /// # Safety
   367	    /// - The parent must outlive this handle.
   368	    /// - The parent must be inside a smart pointer; otherwise it
   369	    ///   will move in memory and cause undefined behavior!
   370	    ///
   371	    /// # Example
   372	    /// ```
   373	    /// use pumpkin::entity::ai::goal::ParentHandle;
   374	    ///
   375	    /// struct Parent {
   376	    ///     child: Child,
   377	    ///     value: i32
   378	    /// }
   379	    ///
   380	    /// struct Child {
   381	    ///     parent: ParentHandle<Parent>,
   382	    /// }
   383	    ///
   384	    /// impl Child {
   385	    ///    fn value(&self) -> i32 {
   386	    ///        self.parent.get().unwrap().value
   387	    ///    }
   388	    /// }
   389	    ///
   390	    /// let mut parent = Box::new(Parent {
   391	    ///     child: Child {parent: ParentHandle::none()},
   392	    ///     value: 7,
   393	    /// });
   394	    /// parent.child.parent = unsafe { ParentHandle::new(&parent) };
   395	    ///
   396	    /// assert_eq!(parent.child.value(), 7);
   397	    /// ```
   398	    pub const unsafe fn new(parent: &P) -> Self {
   399	        Self {
   400	            ptr: ptr::from_ref(parent),
   401	        }
   402	    }
   403	
   404	    #[must_use]
   405	    /// Creates an empty handle (equivalent to `Option::None`).
   406	    // We can use null as None because we handle it in get.
   407	    pub const fn none() -> Self {
   408	        Self { ptr: ptr::null() }
   409	    }
   410	
   411	    #[must_use]
   412	    /// Returns a reference to the parent if available.
   413	    /// This will cause undefined behavior if #Safety rules in new aren't followed
   414	    pub const fn get(&self) -> Option<&P> {
   415	        if self.ptr.is_null() {
   416	            None
   417	        } else {
   418	            // SAFETY: `self.ptr` was initialized from a valid reference in `ParentHandle::new` and outlives `ParentHandle`.
   419	            unsafe { Some(&*self.ptr) }
   420	        }
   421	    }
   422	}
   423	
   424	impl<P> Default for ParentHandle<P> {
   425	    fn default() -> Self {
   426	        Self::none()
   427	    }
   428	}
   429	
   430	// SAFETY: ParentHandle stores a raw pointer `*const P` to parent goal structures managed within the same AI engine instance.
   431	unsafe impl<P> Sync for ParentHandle<P> {}
   432	// SAFETY: ParentHandle stores a raw pointer `*const P` to parent goal structures managed within the same AI engine instance.
   433	unsafe impl<P> Send for ParentHandle<P> {}

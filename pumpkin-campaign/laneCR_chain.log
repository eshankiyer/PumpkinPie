    22	
    23	   @Override
    24	   public boolean canUse() {
    25	      if (this.mob.hasFollowers()) {
    26	         return false;
    27	      } else if (this.mob.isFollower()) {
    28	         return true;
    29	      } else if (this.nextStartTick > 0) {
    30	         this.nextStartTick--;
    31	         return false;
    32	      } else {
    33	         this.nextStartTick = this.nextStartTick(this.mob);
    34	         Predicate<AbstractSchoolingFish> predicate = fish -> fish.canBeFollowed() || !fish.isFollower();
    35	         List<? extends AbstractSchoolingFish> leadersWithSpaceOrNotFollowers = this.mob
    36	            .level()
    37	            .getEntitiesOfClass((Class<? extends AbstractSchoolingFish>)this.mob.getClass(), this.mob.getBoundingBox().inflate(8.0, 8.0, 8.0), predicate);
    38	         AbstractSchoolingFish leader = DataFixUtils.orElse(
    39	            leadersWithSpaceOrNotFollowers.stream().filter(AbstractSchoolingFish::canBeFollowed).findAny(), this.mob
    40	         );
    41	         leader.addFollowers(leadersWithSpaceOrNotFollowers.stream().filter(fish -> !fish.isFollower()));
    42	         return this.mob.isFollower();
    43	      }
    44	   }
    45	
    46	   @Override
    47	   public boolean canContinueToUse() {

    48	                    (true, held_stack, pumpkin_util::Hand::Right)
    49	                } else {
    50	                    let off_hand = inventory.off_hand_item().await;
    51	                    if !off_hand.is_empty() && off_hand.item.id == Item::MAP.id {
    52	                        (true, off_hand, pumpkin_util::Hand::Left)
    53	                    } else {
    54	                        (false, held_stack, pumpkin_util::Hand::Right)
    55	                    }
    56	                };
    57	
    58	            if found {
    59	                let map_id = server.next_map_id();
    60	                let _ = server.map_manager.create_map(
    61	                    map_id,
    62	                    player.world().dimension.clone(),
    63	                    player.position().x as i32,
    64	                    player.position().z as i32,
    65	                    0, // Default scale
    66	                );

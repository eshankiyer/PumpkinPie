    76	/// Builds the clickable green `[x, ~, z]` (or `[x, y, z]` when `absolute_y`)
    77	/// coordinates component used by vanilla's locate feedback.
    78	fn coordinates_text(pos: &BlockPos, absolute_y: bool) -> TextComponent {
    79	    let x = pos.0.x;
    80	    let z = pos.0.z;
    81	    let y = if absolute_y {
    82	        pos.0.y.to_string()
    83	    } else {
    84	        "~".to_string()
    85	    };
    86	
    87	    TextComponent::translate_cross(
    88	        translation::java::CHAT_COORDINATES,
    89	        translation::java::CHAT_COORDINATES,
    90	        [
    91	            TextComponent::text(x.to_string()),
    92	            TextComponent::text(y.clone()),
    93	            TextComponent::text(z.to_string()),
    94	        ],
    95	    )
    96	    .color_named(NamedColor::Green)
    97	    .click_event(ClickEvent::SuggestCommand {
    98	        command: Cow::from(format!("/tp @s {x} {y} {z}")),
    99	    })
   100	    .hover_event(HoverEvent::show_text(TextComponent::translate_cross(
   101	        translation::java::CHAT_COORDINATES_TOOLTIP,
   102	        translation::java::CHAT_COORDINATES_TOOLTIP,
   103	        [],
   104	    )))
   105	}
   106	
   107	/// The first argument of the success messages: the searched id, with the
   108	/// concretely found entry appended for tag searches, like vanilla's
   109	/// `LocateCommand.showLocateResult`.
   110	fn result_name(searched: &ResourceOrTag, found: &str) -> String {
   111	    match searched {
   112	        ResourceOrTag::Resource(_) => searched.printable(),
   113	        ResourceOrTag::Tag(_) => format!("{} ({found})", searched.printable()),
   114	    }
   115	}
   116	
   117	/// Vanilla reports the horizontal block distance for structures and POIs.
   118	fn horizontal_distance(origin: &BlockPos, target: &BlockPos) -> i32 {
   119	    let dx = f64::from(target.0.x - origin.0.x);
   120	    let dz = f64::from(target.0.z - origin.0.z);
   121	    dx.hypot(dz).floor().max(0.0) as i32
   122	}
   123	
   124	/// ... and the full 3D block distance for biomes.
   125	fn absolute_distance(origin: &BlockPos, target: &BlockPos) -> i32 {
   126	    let dx = f64::from(target.0.x - origin.0.x);
   127	    let dy = f64::from(target.0.y - origin.0.y);
   128	    let dz = f64::from(target.0.z - origin.0.z);
   129	    (dx * dx + dy * dy + dz * dz).sqrt().floor().max(0.0) as i32
   130	}

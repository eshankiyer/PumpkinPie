   217	/// `MultifaceSpreader.spreadFromFaceTowardRandomDirection`.
   218	pub async fn spread_from_face_toward_random_direction(
   219	    config: &dyn SpreadConfig,
   220	    target: &dyn SpreadTarget,
   221	    faces: FaceSet,
   222	    pos: BlockPos,
   223	    starting_face: BlockDirection,
   224	    random: &mut RandomGenerator,
   225	) -> Option<SpreadPos> {
   226	    for spread_direction in shuffled_directions(random) {
   227	        if let Some(candidate) = spread_from_face_toward_direction(
   228	            config,
   229	            target,
   230	            faces,
   231	            pos,
   232	            starting_face,
   233	            spread_direction,
   234	        )
   235	        .await
   236	        {
   237	            return Some(candidate);
   238	        }
   239	    }
   240	    None
   241	}
   242	
   243	/// `MultifaceSpreader.spreadFromRandomFaceTowardRandomDirection`.
   244	pub async fn spread_from_random_face_toward_random_direction(
   245	    config: &dyn SpreadConfig,
   246	    target: &dyn SpreadTarget,
   247	    faces: FaceSet,
   248	    pos: BlockPos,
   249	    random: &mut RandomGenerator,
   250	) -> Option<SpreadPos> {
   251	    for starting_face in shuffled_directions(random) {
   252	        if !config.can_spread_from(faces, starting_face) {
   253	            continue;
   254	        }
   255	        if let Some(candidate) = spread_from_face_toward_random_direction(
   256	            config,
   257	            target,
   258	            faces,
   259	            pos,
   260	            starting_face,
   261	            random,
   262	        )
   263	        .await
   264	        {
   265	            return Some(candidate);
   266	        }
   267	    }
   268	    None
   269	}

    26	/// `Mth.SQRT_OF_TWO`, a `float` constant in vanilla - widened here so the `dist` product in
    27	/// [`generate_random_direction_within_radians`] rounds the way `RandomPos.java:37` does.
    28	const SQRT_OF_TWO: f64 = std::f32::consts::SQRT_2 as f64;
    29	
    30	/// `GoalUtils.mobRestricted` (`GoalUtils.java:16-18`): the mob has a home *and* is currently
    31	/// close enough to it that the home radius can actually constrain a candidate.
    32	fn mob_restricted(mob: &dyn Mob, horizontal_dist: f64) -> bool {
    33	    let mob_entity = mob.get_mob_entity();
    34	    let radius = mob_entity.position_target_range.load(Ordering::Relaxed);
    35	    if radius == -1 {
    36	        return false;
    37	    }
    38	    let home = mob_entity.position_target.load();
    39	    let pos = mob_entity.living_entity.entity.pos.load();
    40	    let dx = f64::from(home.0.x) + 0.5 - pos.x;
    41	    let dy = f64::from(home.0.y) + 0.5 - pos.y;
    42	    let dz = f64::from(home.0.z) + 0.5 - pos.z;
    43	    let limit = f64::from(radius) + horizontal_dist + 1.0;
    44	    dx.mul_add(dx, dy.mul_add(dy, dz * dz)) < limit * limit
    45	}

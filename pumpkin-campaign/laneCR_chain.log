   212	   public static boolean generateJigsaw(
   213	      final ServerLevel level,
   214	      final Holder<StructureTemplatePool> pool,
   215	      final Identifier target,
   216	      final int maxDepth,
   217	      final BlockPos position,
   218	      final boolean keepJigsaws
   219	   ) {
   220	      ChunkGenerator generator = level.getChunkSource().getGenerator();
   221	      StructureTemplateManager structureTemplateManager = level.getStructureManager();
   222	      StructureManager structureManager = level.structureManager();
   223	      RandomSource random = level.getRandom();
   224	      Structure.GenerationContext generationContext = new Structure.GenerationContext(
   225	         level.registryAccess(),
   226	         generator,
   227	         generator.getBiomeSource(),
   228	         level.getChunkSource().randomState(),
   229	         structureTemplateManager,
   230	         level.getSeed(),
   231	         ChunkPos.containing(position),
   232	         level,
   233	         b -> true
   234	      );
   235	      Optional<Structure.GenerationStub> stub = addPieces(
   236	         generationContext,
   237	         pool,
   238	         Optional.of(target),
   239	         maxDepth,
   240	         position,
   241	         false,
   242	         Optional.empty(),
   243	         new JigsawStructure.MaxDistance(128),
   244	         PoolAliasLookup.EMPTY,
   245	         JigsawStructure.DEFAULT_DIMENSION_PADDING,
   246	         JigsawStructure.DEFAULT_LIQUID_SETTINGS
   247	      );
   248	      if (stub.isPresent()) {
   249	         StructurePiecesBuilder builder = stub.get().getPiecesBuilder();
   250	
   251	         for (StructurePiece piece : builder.build().pieces()) {
   252	            if (piece instanceof PoolElementStructurePiece poolPiece) {
   253	               poolPiece.place(level, structureManager, generator, random, BoundingBox.infinite(), position, keepJigsaws);
   254	            }
   255	         }
   256	
   257	         return true;
   258	      } else {
   259	         return false;
   260	      }
   261	   }

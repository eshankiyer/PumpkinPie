   136	pub struct RandomizedIntBlockStateProvider {
   137	    pub source: Box<BlockStateProvider>,
   138	    pub property: String,
   139	    pub values: IntProvider,
   140	}
   141	
   142	impl RandomizedIntBlockStateProvider {
   143	    // net.minecraft.world.level.levelgen.feature.stateproviders.RandomizedIntStateProvider#getState:
   144	    // samples `values` and writes it into the named integer property of the state returned by
   145	    // `source`, falling back to the unmodified state if the property doesn't exist on it.
   146	    pub fn get<T: GenerationCache>(
   147	        &self,
   148	        random: &mut RandomGenerator,
   149	        pos: BlockPos,
   150	        chunk: &T,
   151	        block_registry: &dyn WorldPortalExt,
   152	    ) -> &'static BlockState {
   153	        let source_state = self.source.get(random, pos, chunk, block_registry);
   154	        let value = self.values.get(random);
   155	
   156	        let block = Block::from_state_id(source_state.id);
   157	        let Some(props_source) = block.properties(source_state.id) else {
   158	            return source_state;
   159	        };
   160	        let props = props_source.to_props();
   161	        if !props.iter().any(|(key, _)| *key == self.property) {
   162	            return source_state;
   163	        }
   164	
   165	        let value_str = value.to_string();
   166	        let new_props: Vec<(&str, &str)> = props
   167	            .iter()
   168	            .map(|(key, value)| {
   169	                if *key == self.property {
   170	                    (*key, value_str.as_str())
   171	                } else {
   172	                    (*key, *value)
   173	                }
   174	            })
   175	            .collect();
   176	
   177	        let new_state_id = block.from_properties(&new_props).to_state_id(block);
   178	        BlockState::from_id(new_state_id)
   179	    }
   180	}

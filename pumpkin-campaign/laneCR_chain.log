     6	#[derive(Copy, Clone, Debug, PartialEq, Eq)]
     7	pub enum Sign {
     8	    Plus = 0,
     9	    Minus = 1,
    10	}
    11	
    12	impl Sign {
    13	    /// Returns the minimum number of characters required to express this sign to be parsed.
    14	    ///
    15	    /// For example, between `5.0` and `+5.0`, the former takes no space for the `+` symbol,
    16	    /// while for `-5.0`, there must be a `-` symbol, so the minimum size there is `1` instead of `0`.
    17	    #[must_use]
    18	    #[inline]
    19	    pub const fn minimum_size_parsable(self) -> usize {
    20	        self as usize
    21	    }
    22	
    23	    /// Appends the slice containing the minimum characters required to express this sign to be parsed to a String
    24	    /// referred by the given mutable reference.
    25	    ///
    26	    /// This is a no-op for [`Sign::Plus`], while for [`Sign::Minus`], a `-` is appended.
    27	    #[inline]
    28	    pub fn append_minimum_str_parsable(self, buffer: &mut String) {
    29	        if self == Self::Minus {
    30	            buffer.push('-');
    31	        }
    32	    }
    33	}

    58	/// Dynamic lookup for Pool Aliases introduced in 1.20+ (e.g. Trial Chambers spawner/contents aliases).
    59	#[derive(Debug, Clone, Default)]
    60	pub struct PoolAliasLookup {
    61	    aliases: HashMap<String, String>,
    62	}
    63	
    64	impl PoolAliasLookup {
    65	    #[must_use]
    66	    pub fn new() -> Self {
    67	        Self {
    68	            aliases: HashMap::new(),
    69	        }
    70	    }
    71	
    72	    #[must_use]
    73	    pub fn from_bindings(
    74	        bindings: &[pumpkin_data::structures::PoolAliasBinding],
    75	        random: &mut RandomGenerator,
    76	    ) -> Self {
    77	        let mut lookup = Self::new();
    78	        for binding in bindings {
    79	            lookup.add_binding(binding, random);
    80	        }
    81	        lookup
    82	    }
    83	
    84	    fn add_binding(
    85	        &mut self,
    86	        binding: &pumpkin_data::structures::PoolAliasBinding,
    87	        random: &mut RandomGenerator,
    88	    ) {
    89	        use pumpkin_data::structures::PoolAliasBinding;
    90	        match binding {
    91	            PoolAliasBinding::Direct { alias, target } => {
    92	                self.add_direct((*alias).to_string(), (*target).to_string());
    93	            }
    94	            PoolAliasBinding::Random { alias, targets } => {
    95	                if let Some(target) = Self::pick_weighted(targets, random, |t| t.weight) {
    96	                    self.add_direct((*alias).to_string(), target.target.to_string());
    97	                }
    98	            }
    99	            PoolAliasBinding::RandomGroup { groups } => {
   100	                if let Some(group) = Self::pick_weighted(groups, random, |g| g.weight) {
   101	                    for b in group.bindings {
   102	                        self.add_binding(b, random);
   103	                    }
   104	                }
   105	            }
   106	        }
   107	    }
   108	
   109	    fn pick_weighted<'a, T>(
   110	        items: &'a [T],
   111	        random: &mut RandomGenerator,
   112	        get_weight: impl Fn(&T) -> u32,
   113	    ) -> Option<&'a T> {
   114	        if items.is_empty() {
   115	            return None;
   116	        }
   117	        let total_weight: u32 = items.iter().map(&get_weight).sum();
   118	        if total_weight == 0 {
   119	            return items.first();
   120	        }
   121	        let mut r = random.next_bounded_i32(total_weight as i32) as u32;
   122	        for item in items {
   123	            let w = get_weight(item);
   124	            if r < w {
   125	                return Some(item);
   126	            }
   127	            r -= w;
   128	        }
   129	        items.first()
   130	    }
   131	
   132	    pub fn add_direct(&mut self, alias: String, target: String) {
   133	        if let Some(stripped) = alias.strip_prefix("minecraft:") {
   134	            self.aliases.insert(stripped.to_string(), target.clone());
   135	        } else {
   136	            self.aliases
   137	                .insert(format!("minecraft:{alias}"), target.clone());
   138	        }
   139	        self.aliases.insert(alias, target);
   140	    }
   141	
   142	    pub fn add_random(
   143	        &mut self,
   144	        alias: String,
   145	        targets: &[(String, u32)],
   146	        random: &mut RandomGenerator,
   147	    ) {
   148	        if targets.is_empty() {
   149	            return;
   150	        }
   151	        let total_weight: u32 = targets.iter().map(|(_, w)| *w).sum();
   152	        if total_weight == 0 {
   153	            if let Some((target, _)) = targets.first() {
   154	                self.add_direct(alias, target.clone());
   155	            }
   156	            return;
   157	        }
   158	        let mut r = random.next_bounded_i32(total_weight as i32) as u32;
   159	        for (target, weight) in targets {
   160	            if r < *weight {
   161	                self.add_direct(alias, target.clone());
   162	                return;
   163	            }
   164	            r -= *weight;
   165	        }
   166	        if let Some((target, _)) = targets.first() {
   167	            self.add_direct(alias, target.clone());
   168	        }
   169	    }
   170	
   171	    #[must_use]
   172	    pub fn lookup<'a>(&'a self, mut id: &'a str, _random: &mut RandomGenerator) -> &'a str {
   173	        while let Some(target) = self.aliases.get(id) {
   174	            id = target.as_str();
   175	        }
   176	        id
   177	    }
   178	}

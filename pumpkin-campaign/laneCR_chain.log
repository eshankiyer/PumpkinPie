   597	    fn has_blocking_entity_in_box(world: &World, placed_box: &BoundingBox) -> bool {
   598	        let players = world.players.load();
   599	        if players.iter().any(|player| {
   600	            Self::entity_blocks_block_placement(player.as_ref())
   601	                && player
   602	                    .get_entity()
   603	                    .bounding_box
   604	                    .load()
   605	                    .intersects(placed_box)
   606	        }) {
   607	            return true;
   608	        }
   609	
   610	        world.entities.load().iter().any(|entity| {
   611	            Self::entity_blocks_block_placement(entity.as_ref())
   612	                && entity
   613	                    .get_entity()
   614	                    .bounding_box
   615	                    .load()
   616	                    .intersects(placed_box)
   617	        })
   618	    }

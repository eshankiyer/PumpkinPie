    63	impl MatchingBiomesBlockPredicate {
    64	    /// Tests the biome at the origin against the configured holder set.
    65	    ///
    66	    /// This ports `MatchingBiomesPredicate.test` from
    67	    /// `net/minecraft/world/level/levelgen/blockpredicates/MatchingBiomesPredicate.java:22-24`.
    68	    pub fn test<T: GenerationCache>(&self, chunk: &T, pos: &BlockPos) -> bool {
    69	        let biome = chunk.get_biome_for_terrain_gen(pos.0.x, pos.0.y, pos.0.z);
    70	        match &self.biomes {
    71	            MatchingBiomesWrapper::Single(expected) => biome == *expected,
    72	            MatchingBiomesWrapper::Multiple(expected) => expected.contains(&biome),
    73	            MatchingBiomesWrapper::Tag(expected) => expected.contains(&(biome.id as u16)),
    74	        }
    75	    }
    76	}

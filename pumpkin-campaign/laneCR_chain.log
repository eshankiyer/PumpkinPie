   280	/// Finds `needle` in `bytes` at or after `from`; unlike `str::find` this never
   281	/// panics on non-char-boundary offsets because both inputs are ASCII-boundary
   282	/// aware (`needle` is an ASCII byte and matches only at char boundaries).
   283	fn find_ascii_byte(bytes: &[u8], from: usize, needle: u8) -> Option<usize> {
   284	    assert!(needle.is_ascii(), "only ASCII needles are supported");
   285	    bytes[from.min(bytes.len())..]
   286	        .iter()
   287	        .position(|&b| b == needle)
   288	        .map(|pos| from.min(bytes.len()) + pos)

   132	    /// `ScaffoldingBlock.updateShape`: schedules the same tick-delay-1 on every neighbor update,
   133	    /// plus a water tick if waterlogged. Does not itself recompute distance/bottom - that only
   134	    /// happens in the scheduled tick.
   135	    fn get_state_for_neighbor_update<'a>(
   136	        &'a self,
   137	        args: GetStateForNeighborUpdateArgs<'a>,
   138	    ) -> BlockFuture<'a, BlockStateId> {
   139	        Box::pin(async move {
   140	            let props = ScaffoldingLikeProperties::from_state_id(args.state_id, args.block);
   141	            if props.r#waterlogged {
   142	                args.world.schedule_fluid_tick(
   143	                    &Fluid::WATER,
   144	                    *args.position,
   145	                    Fluid::WATER.flow_speed as u8,
   146	                    TickPriority::Normal,
   147	                );
   148	            }
   149	            args.world
   150	                .schedule_block_tick(args.block, *args.position, 1, TickPriority::Normal);
   151	            args.state_id
   152	        })
   153	    }

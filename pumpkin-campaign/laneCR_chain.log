   235	    /// Determines the appropriate facing direction for a wall-hanging sign.
   236	    fn calculate_wall_hanging_facing(wall_dir: BlockDirection, player_yaw: f32) -> &'static str {
   237	        match wall_dir {
   238	            BlockDirection::North | BlockDirection::South => {
   239	                // Wall runs North-South, sign faces East or West
   240	                if (player_yaw + 360.0) % 360.0 < 180.0 {
   241	                    "east"
   242	                } else {
   243	                    "west"
   244	                }
   245	            }
   246	            BlockDirection::East | BlockDirection::West => {
   247	                // Wall runs East-West, sign faces North or South
   248	                if (-270.0..=270.0).contains(&player_yaw) {
   249	                    "south"
   250	                } else {
   251	                    "north"
   252	                }
   253	            }
   254	            _ => wall_dir.opposite().to_cardinal_direction().to_value(),
   255	        }
   256	    }
   257	
   258	    /// Calculates rotation for wall-hanging signs.
   259	    fn calculate_wall_hanging_rotation(
   260	        wall_dir: BlockDirection,
   261	        player_rot: u8,
   262	        is_sneaking: bool,
   263	    ) -> u8 {
   264	        if is_sneaking {
   265	            return player_rot;
   266	        }
   267	
   268	        match wall_dir {
   269	            BlockDirection::North | BlockDirection::South => {
   270	                // Snap to North-South axis (0 or 8)
   271	                if (4..12).contains(&player_rot) { 8 } else { 0 }
   272	            }
   273	            BlockDirection::East | BlockDirection::West => {
   274	                // Snap to East-West axis (4 or 12)
   275	                if (2..10).contains(&player_rot) { 4 } else { 12 }
   276	            }
   277	            _ => player_rot,
   278	        }
   279	    }

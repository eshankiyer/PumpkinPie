   572	    fn entity_blocks_block_placement(entity: &dyn EntityBase) -> bool {
   573	        let base_entity = entity.get_entity();
   574	        if base_entity.is_removed()
   575	            || base_entity
   576	                .no_clip
   577	                .load(std::sync::atomic::Ordering::Relaxed)
   578	            || entity.is_spectator()
   579	        {
   580	            return false;
   581	        }
   582	
   583	        if entity.get_living_entity().is_some() {
   584	            return true;
   585	        }
   586	
   587	        let entity_type = base_entity.entity_type;
   588	        let resource_name = entity_type.resource_name;
   589	        entity_type == &pumpkin_data::entity::EntityType::END_CRYSTAL
   590	            || entity_type == &pumpkin_data::entity::EntityType::FALLING_BLOCK
   591	            || entity_type == &pumpkin_data::entity::EntityType::TNT
   592	            || resource_name.ends_with("_minecart")
   593	            || resource_name.ends_with("_boat")
   594	            || resource_name.ends_with("_raft")
   595	    }

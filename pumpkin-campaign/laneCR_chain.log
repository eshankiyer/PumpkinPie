   201	    faces: FaceSet,
   202	    pos: BlockPos,
   203	    starting_face: BlockDirection,
   204	    spread_direction: BlockDirection,
   205	) -> Option<SpreadPos> {
   206	    let candidate = get_spread_from_face_toward_direction(
   207	        config,
   208	        target.accessor(),
   209	        faces,
   210	        pos,
   211	        starting_face,
   212	        spread_direction,
   213	    )?;
   214	    target.place(candidate).await.then_some(candidate)
   215	}

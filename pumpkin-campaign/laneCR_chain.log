diff --git a/crates/pumpkin/src/block/blocks/test_instance_block.rs b/crates/pumpkin/src/block/blocks/test_instance_block.rs
new file mode 100644
index 0000000000000000000000000000000000000000..98c89307a98bdab4e6643d26b2a3f1fb1f16ea55
--- /dev/null
+++ b/crates/pumpkin/src/block/blocks/test_instance_block.rs
@@ -0,0 +1,36 @@
+use crate::block::{BlockActionResult, BlockBehaviour, BlockFuture, BlockMetadata, NormalUseArgs};
+use crate::block::entities::test_instance_block::TestInstanceBlockBlockEntity;
+use pumpkin_data::BlockId;
+use pumpkin_macros::pumpkin_block;
+
+#[pumpkin_block("minecraft:test_instance_block")]
+pub struct TestInstanceBlock;
+
+impl BlockMetadata for TestInstanceBlock {
+    fn ids() -> Box<[BlockId]> {
+        [BlockId::TEST_INSTANCE_BLOCK].into()
+    }
+}
+
+impl BlockBehaviour for TestInstanceBlock {
+    /// Vanilla `TestInstanceBlock.useWithoutItem` (`TestInstanceBlock.java:28-45`) only
+    /// succeeds for its block entity and a player allowed to use game-master blocks.
+    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
+        Box::pin(async move {
+            let Some(block_entity) = args.world.get_block_entity(args.position) else {
+                return BlockActionResult::Pass;
+            };
+            if block_entity
+                .as_any()
+                .downcast_ref::<TestInstanceBlockBlockEntity>()
+                .is_none()
+            {
+                return BlockActionResult::Pass;
+            }
+            if !args.player.can_use_game_master_blocks() {
+                return BlockActionResult::Pass;
+            }
+            BlockActionResult::SuccessServer
+        })
+    }
+}

    44	                        remainingCooldown.setValue(20);
    45	                     } else if (remainingCooldown.decrementAndGet() > 0) {
    46	                        return false;
    47	                     }
    48	
    49	                     lastCheckedNode.setValue(path.getNextNode());
    50	                     Node fromNode = path.getPreviousNode();
    51	                     Node toNode = path.getNextNode();
    52	                     BlockPos fromPos = fromNode.asBlockPos();
    53	                     BlockState fromState = level.getBlockState(fromPos);
    54	                     if (fromState.is(BlockTags.MOB_INTERACTABLE_DOORS, s -> s.getBlock() instanceof DoorBlock)) {
    55	                        DoorBlock fromBlock = (DoorBlock)fromState.getBlock();

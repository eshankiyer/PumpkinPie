    23	#[pumpkin_block("minecraft:sponge")]
    24	pub struct SpongeBlock;
    25	
    26	impl SpongeBlock {
    27	    pub async fn absorb_water(world: &Arc<crate::world::World>, position: &BlockPos) -> bool {
    28	        let mut water_blocks = Vec::new();
    29	        let mut visited = HashSet::new();
    30	        let mut queue = VecDeque::new();
    31	
    32	        // Start from the sponge position
    33	        queue.push_back(*position);
    34	        visited.insert(*position);
    35	
    36	        while let Some(current_pos) = queue.pop_front() {
    37	            for direction in &[
    38	                (1, 0, 0),
    39	                (-1, 0, 0),
    40	                (0, 1, 0),
    41	                (0, -1, 0),
    42	                (0, 0, 1),
    43	                (0, 0, -1),
    44	            ] {
    45	                let next_pos = BlockPos::new(
    46	                    current_pos.0.x + direction.0,
    47	                    current_pos.0.y + direction.1,
    48	                    current_pos.0.z + direction.2,
    49	                );
    50	
    51	                if visited.contains(&next_pos) {
    52	                    continue;
    53	                }
    54	
    55	                let taxicab_dist = (next_pos.0.x - position.0.x).abs()
    56	                    + (next_pos.0.y - position.0.y).abs()
    57	                    + (next_pos.0.z - position.0.z).abs();
    58	
    59	                if taxicab_dist > MAX_DEPTH || water_blocks.len() >= MAX_COUNT - 1 {
    60	                    continue;
    61	                }
    62	
    63	                visited.insert(next_pos);
    64	
    65	                // Only add to queue if its fluid state is water. This also catches
    66	                // waterlogged blocks, unlike a direct block-id comparison.
    67	                if world
    68	                    .get_fluid(&next_pos)
    69	                    .has_tag(&tag::Fluid::MINECRAFT_WATER)
    70	                {
    71	                    water_blocks.push(next_pos);
    72	                    queue.push_back(next_pos);
    73	                }
    74	            }
    75	        }
    76	
    77	        if water_blocks.is_empty() {
    78	            false
    79	        } else {
    80	            let mut event =
    81	                crate::plugin::api::events::block::sponge_absorb::SpongeAbsorbEvent::new(*position);
    82	            if let Some(server) = world.server.upgrade() {
    83	                server.plugin_manager.fire(&server, &mut event).await;
    84	            }
    85	            if event.cancelled {
    86	                return false;
    87	            }
    88	
    89	            for water_pos in &water_blocks {
    90	                let (block, state) = world.get_block_and_state_id(water_pos);
    91	                let new_state = if is_waterlogged(block, state) {
    92	                    set_waterlogged(block, state, false)
    93	                } else {
    94	                    BlockStateId::AIR
    95	                };
    96	                world
    97	                    .set_block_state(water_pos, new_state, BlockFlags::NOTIFY_ALL)
    98	                    .await;
    99	            }
   100	            world
   101	                .set_block_state(
   102	                    position,
   103	                    Block::WET_SPONGE.default_state.id,
   104	                    BlockFlags::NOTIFY_ALL,
   105	                )
   106	                .await;
   107	
   108	            world.play_block_sound(Sound::BlockSpongeAbsorb, SoundCategory::Blocks, *position);
   109	
   110	            true
   111	        }
   112	    }
   113	}

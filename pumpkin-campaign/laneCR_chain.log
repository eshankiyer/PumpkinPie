   175	pub type GoalFuture<'a, T> = Pin<Box<dyn Future<Output = T> + Send + 'a>>;
   176	
   177	pub trait Goal: Send + Sync {
   178	    /// How should the `Goal` initially start?
   179	    fn can_start<'a>(&'a mut self, _mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   180	        Box::pin(async { false })
   181	    }
   182	
   183	    /// When it's started, how should it continue to run?
   184	    /// Defaults to whether the goal could still start fresh (vanilla: `Goal.canContinueToUse` defaults to `this.canUse()`).
   185	    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   186	        self.can_start(mob)
   187	    }
   188	
   189	    /// Call when goal start
   190	    fn start<'a>(&'a mut self, _: &'a dyn Mob) -> GoalFuture<'a, ()> {
   191	        Box::pin(async {})
   192	    }
   193	
   194	    /// Call when goal stop
   195	    fn stop<'a>(&'a mut self, _: &'a dyn Mob) -> GoalFuture<'a, ()> {
   196	        Box::pin(async {})
   197	    }
   198	
   199	    /// If the `Goal` is running, this gets called every tick.
   200	    fn tick<'a>(&'a mut self, _: &'a dyn Mob) -> GoalFuture<'a, ()> {
   201	        Box::pin(async {})
   202	    }
   203	
   204	    fn should_run_every_tick(&self) -> bool {
   205	        false
   206	    }
   207	
   208	    fn can_stop(&self) -> bool {
   209	        true
   210	    }
   211	
   212	    /// Whether this goal is the vanilla `PanicGoal` equivalent.
   213	    ///
   214	    /// `PathfinderMob.isPanicking` includes any currently-running panic goal in addition to
   215	    /// the Brain `IS_PANICKING` memory. Most goals are not panic goals, so the default is false.
   216	    fn is_panic_goal(&self) -> bool {
   217	        false
   218	    }
   219	
   220	    fn get_tick_count(&self, ticks: i32) -> i32 {
   221	        if self.should_run_every_tick() {
   222	            ticks
   223	        } else {
   224	            to_goal_ticks(ticks)
   225	        }
   226	    }
   227	
   228	    fn controls(&self) -> Controls {
   229	        Controls::empty()
   230	    }
   231	}

    16	/// `GateBehavior.OrderPolicy` (`GateBehavior.java:104-117`).
    17	#[derive(Clone, Copy)]
    18	pub enum OrderPolicy {
    19	    Ordered,
    20	    Shuffled,
    21	}
    22	
    23	/// `GateBehavior.RunningPolicy` (`GateBehavior.java:119-140`).
    24	#[derive(Clone, Copy)]
    25	pub enum RunningPolicy {
    26	    /// Starts children in order until the first one that succeeds.
    27	    RunOne,
    28	    /// Attempts to start every stopped child.
    29	    TryAll,
    30	}
    31	
    32	pub struct GateBehavior {
    33	    entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
    34	    /// Union of `entry_condition` and every child's required memories
    35	    /// (`GateBehavior.getRequiredMemories`, `:44-53`). Precomputed so `required_memories` can
    36	    /// return a slice.
    37	    required_memories: Vec<(MemoryKeyId, MemoryStatus)>,
    38	    exit_erased_memories: Vec<MemoryKeyId>,
    39	    order_policy: OrderPolicy,
    40	    running_policy: RunningPolicy,
    41	    /// `ShufflingList<BehaviorControl>` (`GateBehavior.java:22`): `(behavior, weight)`.
    42	    behaviors: Vec<(Box<dyn Behavior>, i32)>,
    43	    status: BehaviorStatus,
    44	}
    45	
    46	impl GateBehavior {
    47	    #[must_use]
    48	    pub fn new(
    49	        entry_condition: Vec<(MemoryKeyId, MemoryStatus)>,
    50	        exit_erased_memories: Vec<MemoryKeyId>,
    51	        order_policy: OrderPolicy,
    52	        running_policy: RunningPolicy,
    53	        behaviors: Vec<(Box<dyn Behavior>, i32)>,
    54	    ) -> Self {
    55	        let mut required_memories = entry_condition.clone();
    56	        for (behavior, _) in &behaviors {
    57	            for condition in behavior.required_memories() {
    58	                if !required_memories.contains(condition) {
    59	                    required_memories.push(*condition);
    60	                }
    61	            }
    62	        }
    63	        Self {
    64	            entry_condition,
    65	            required_memories,
    66	            exit_erased_memories,
    67	            order_policy,
    68	            running_policy,
    69	            behaviors,
    70	            status: BehaviorStatus::Stopped,
    71	        }
    72	    }
    73	
    74	    /// `new RunOne(weightedBehaviors)` (`RunOne.java:13-19`): no entry condition, nothing erased
    75	    /// on exit, `SHUFFLED` order, `RUN_ONE` policy.
    76	    #[must_use]
    77	    pub fn run_one(behaviors: Vec<(Box<dyn Behavior>, i32)>) -> Box<dyn Behavior> {
    78	        Box::new(Self::new(
    79	            Vec::new(),
    80	            Vec::new(),
    81	            OrderPolicy::Shuffled,
    82	            RunningPolicy::RunOne,
    83	            behaviors,
    84	        ))
    85	    }
    86	
    87	    /// `ShufflingList.shuffle` (`ShufflingList.java:76-80`): each entry gets a sort key of
    88	    /// `-nextFloat().powf(1.0 / weight)` and the list is sorted ascending by it. That is the
    89	    /// standard weighted-reservoir ordering -- higher weight means a key closer to -1, so it
    90	    /// sorts earlier and is tried first.
    91	    fn shuffle(&mut self) {
    92	        let mut rng = rand::rng();
    93	        let mut keyed: Vec<(f32, usize)> = (0..self.behaviors.len())
    94	            .map(|index| {
    95	                let weight = self.behaviors[index].1;
    96	                let roll: f32 = rng.random::<f32>();
    97	                #[allow(clippy::cast_precision_loss)]
    98	                let key = -roll.powf(1.0 / weight as f32);
    99	                (key, index)
   100	            })
   101	            .collect();
   102	        keyed.sort_by(|a, b| a.0.total_cmp(&b.0));
   103	
   104	        let mut reordered: Vec<Option<(Box<dyn Behavior>, i32)>> =
   105	            self.behaviors.drain(..).map(Some).collect();
   106	        self.behaviors = keyed
   107	            .into_iter()
   108	            .filter_map(|(_, index)| reordered[index].take())
   109	            .collect();
   110	    }
   111	}
   112	
   113	impl Behavior for GateBehavior {
   114	    fn required_memories(&self) -> &[(MemoryKeyId, MemoryStatus)] {
   115	        &self.required_memories
   116	    }
   117	
   118	    fn status(&self) -> BehaviorStatus {
   119	        self.status
   120	    }
   121	
   122	    /// `tryStart` (`GateBehavior.java:67-77`).
   123	    ///
   124	    /// Note it gates on `entry_condition` only, NOT on `required_memories` -- vanilla's
   125	    /// `hasRequiredMemories` here reads `this.entryCondition` (`:55-65`) even though
   126	    /// `getRequiredMemories` returns the wider union. The union exists purely so the brain
   127	    /// registers every memory the children touch.
   128	    fn try_start(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) -> bool {
   129	        if !brain.check_memories(&self.entry_condition) {
   130	            return false;
   131	        }
   132	        self.status = BehaviorStatus::Running;
   133	        if matches!(self.order_policy, OrderPolicy::Shuffled) {
   134	            self.shuffle();
   135	        }
   136	        match self.running_policy {
   137	            RunningPolicy::RunOne => {
   138	                for (behavior, _) in &mut self.behaviors {
   139	                    if behavior.status() == BehaviorStatus::Stopped
   140	                        && behavior.try_start(mob, brain, game_time)
   141	                    {
   142	                        break;
   143	                    }
   144	                }
   145	            }
   146	            RunningPolicy::TryAll => {
   147	                for (behavior, _) in &mut self.behaviors {
   148	                    if behavior.status() == BehaviorStatus::Stopped {
   149	                        behavior.try_start(mob, brain, game_time);
   150	                    }
   151	                }
   152	            }
   153	        }
   154	        true
   155	    }
   156	
   157	    /// `tickOrStop` (`GateBehavior.java:79-85`): the gate stops itself once no child is running.
   158	    fn tick_or_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   159	        for (behavior, _) in &mut self.behaviors {
   160	            if behavior.status() == BehaviorStatus::Running {
   161	                behavior.tick_or_stop(mob, brain, game_time);
   162	            }
   163	        }
   164	        if self
   165	            .behaviors
   166	            .iter()
   167	            .all(|(behavior, _)| behavior.status() != BehaviorStatus::Running)
   168	        {
   169	            self.do_stop(mob, brain, game_time);
   170	        }
   171	    }
   172	
   173	    /// `doStop` (`GateBehavior.java:87-92`).
   174	    fn do_stop(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   175	        self.status = BehaviorStatus::Stopped;
   176	        for (behavior, _) in &mut self.behaviors {
   177	            if behavior.status() == BehaviorStatus::Running {
   178	                behavior.do_stop(mob, brain, game_time);
   179	            }
   180	        }
   181	        if !self.exit_erased_memories.is_empty() {
   182	            let mut store = brain.memory.lock().unwrap();
   183	            for id in &self.exit_erased_memories {
   184	                store.erase_by_id(*id);
   185	            }
   186	        }
   187	    }
   188	
   189	    fn debug_name(&self) -> &'static str {
   190	        "GateBehavior"
   191	    }
   192	}

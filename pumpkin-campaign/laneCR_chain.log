     1	//! Shulker box screen handler.
     2	//!
     3	//! Port of `ShulkerBoxMenu.java`. A shulker box looks like a single chest but is
     4	//! not one: it uses `MenuType.SHULKER_BOX` (`ShulkerBoxMenu.java:18`) and its 27
     5	//! slots are `ShulkerBoxSlot`s, which refuse any item that cannot be nested
     6	//! inside a container item (`ShulkerBoxSlot.java:11-14`). That is what stops a
     7	//! shulker box from being placed inside another shulker box.
     8	
     9	use std::{
    10	    any::Any,
    11	    sync::{
    12	        Arc,
    13	        atomic::{AtomicU8, Ordering},
    14	    },
    15	};
    16	
    17	use pumpkin_data::{
    18	    Block,
    19	    item_stack::ItemStack,
    20	    screen::WindowType,
    21	    tag::{self, Taggable},
    22	};
    23	use pumpkin_world::inventory::Inventory;
    24	
    25	use crate::{
    26	    player::player_inventory::PlayerInventory,
    27	    screen_handler::{
    28	        InventoryPlayer, ItemStackFuture, ScreenHandler, ScreenHandlerBehaviour,
    29	        ScreenHandlerFuture,
    30	    },
    31	    slot::{BoxFuture, Slot},
    32	};
    33	
    34	/// Number of slots inside a shulker box (`ShulkerBoxMenu.java:10`).
    35	pub const SHULKER_BOX_SIZE: usize = 27;
    36	
    37	/// Vanilla `Item.canFitInsideContainerItems` (`Item.java:364`, overridden by
    38	/// `BlockItem.java:193-196` as `!(this.getBlock() instanceof ShulkerBoxBlock)`).
    39	///
    40	/// Items with no corresponding block always fit; block items only fail for the
    41	/// shulker box blocks, which are exactly the `minecraft:shulker_boxes` tag.
    42	#[must_use]
    43	pub fn can_fit_inside_container_items(stack: &ItemStack) -> bool {
    44	    Block::from_item_id(stack.get_item().id)
    45	        .is_none_or(|block| !block.has_tag(&tag::Block::MINECRAFT_SHULKER_BOXES))
    46	}
    47	
    48	/// A slot inside a shulker box (`ShulkerBoxSlot.java`).
    49	pub struct ShulkerBoxSlot {
    50	    inventory: Arc<dyn Inventory>,
    51	    index: usize,
    52	    id: AtomicU8,
    53	}
    54	
    55	impl ShulkerBoxSlot {
    56	    #[must_use]
    57	    pub fn new(inventory: Arc<dyn Inventory>, index: usize) -> Self {
    58	        Self {
    59	            inventory,
    60	            index,
    61	            id: AtomicU8::new(0),
    62	        }
    63	    }
    64	}
    65	
    66	impl Slot for ShulkerBoxSlot {
    67	    fn get_inventory(&self) -> Arc<dyn Inventory> {
    68	        self.inventory.clone()
    69	    }
    70	
    71	    fn get_index(&self) -> usize {
    72	        self.index
    73	    }
    74	
    75	    fn set_id(&self, id: usize) {
    76	        self.id.store(id as u8, Ordering::Relaxed);
    77	    }
    78	
    79	    fn mark_dirty(&self) -> BoxFuture<'_, ()> {
    80	        Box::pin(async move {
    81	            self.inventory.mark_dirty();
    82	        })
    83	    }
    84	
    85	    /// `ShulkerBoxSlot.java:11-14`: only items that fit inside container items.
    86	    fn can_insert<'a>(&'a self, stack: &'a ItemStack) -> BoxFuture<'a, bool> {
    87	        Box::pin(async move { can_fit_inside_container_items(stack) })
    88	    }
    89	}
    90	
    91	/// Screen handler for a shulker box block (`ShulkerBoxMenu.java`).
    92	pub struct ShulkerBoxScreenHandler {
    93	    /// The shulker box's inventory.
    94	    pub inventory: Arc<dyn Inventory>,
    95	    behaviour: ScreenHandlerBehaviour,
    96	}
    97	
    98	impl ShulkerBoxScreenHandler {
    99	    /// Creates a shulker box screen handler.
   100	    ///
   101	    /// `ShulkerBoxMenu.java:17-32`: 27 shulker slots in a 3x9 grid, then the
   102	    /// standard player inventory slots.
   103	    pub async fn new(
   104	        sync_id: u8,
   105	        player_inventory: &Arc<PlayerInventory>,
   106	        inventory: Arc<dyn Inventory>,
   107	    ) -> Self {
   108	        let mut handler = Self {
   109	            inventory: inventory.clone(),
   110	            behaviour: ScreenHandlerBehaviour::new(sync_id, Some(WindowType::ShulkerBox)),
   111	        };
   112	
   113	        inventory.on_open().await;
   114	
   115	        for index in 0..SHULKER_BOX_SIZE {
   116	            handler.add_slot(Arc::new(ShulkerBoxSlot::new(inventory.clone(), index)));
   117	        }
   118	
   119	        let player_inventory: Arc<dyn Inventory> = player_inventory.clone();
   120	        handler.add_player_slots(&player_inventory);
   121	
   122	        handler
   123	    }
   124	}

   312	    }
   313	
   314	    fn get_state_by_value(states: &[&'static BlockState], value: f64) -> &'static BlockState {
   315	        let val = f64::midpoint(1.0, value).clamp(0.0, 0.9999);
   316	        states[(val * states.len() as f64) as usize]
   317	    }
   318	}

   541	    #[test]
   542	    fn expiry_clears_after_exactly_ttl_ticks() {
   543	        let mut store = MemoryStore::new();
   544	        store.register(MemoryKeyId::ItemPickupCooldownTicks);
   545	        store.set_with_expiry::<ItemPickupCooldownTicksMemory>(7, 3);
   546	        // MemorySlot.tick decrements while ttl > 0 and clears on the tick where it is <= 0,
   547	        // so a ttl of 3 survives 3 ticks and is gone on the 4th.
   548	        for _ in 0..3 {
   549	            store.tick_expiry();
   550	            assert!(store.has_value::<ItemPickupCooldownTicksMemory>());
   551	        }
   552	        store.tick_expiry();
   553	        assert!(!store.has_value::<ItemPickupCooldownTicksMemory>());
   554	    }

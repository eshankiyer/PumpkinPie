     5	    pub async fn handle_use_item(
     6	        &self,
     7	        player: &Arc<Player>,
     8	        use_item: &SUseItem,
     9	        server: &Arc<Server>,
    10	    ) {
    11	        if !player.has_client_loaded() {
    12	            return;
    13	        }
    14	        player.update_last_action_time();
    15	
    16	        self.update_sequence(player, use_item.sequence.0);
    17	        let inventory = player.inventory();
    18	        let Ok(hand) = Hand::from_packet_id(use_item.hand.0) else {
    19	            self.kick(TextComponent::text("InvalidHand")).await;
    20	            return;
    21	        };
    22	
    23	        let mut item_in_hand = inventory.get_stack_in_hand(hand).await;
    24	        if item_in_hand.is_empty() {
    25	            return;
    26	        }
    27	
    28	        let entity = player.get_entity();
    29	        let target_yaw = wrap_degrees(use_item.yaw) % 360.0;
    30	        let target_pitch = wrap_degrees(use_item.pitch);
    31	        if target_yaw != entity.yaw.load() || target_pitch != entity.pitch.load() {
    32	            entity.set_rotation(target_yaw, target_pitch);
    33	        }
    34	
    35	        // Vanilla ServerPlayerGameMode.useItem returns PASS for spectators after
    36	        // packet bookkeeping, but before touching the held item or firing events.
    37	        if player.gamemode.load() == GameMode::Spectator {
    38	            return;
    39	        }
    40	
    41	        // ServerPlayerGameMode.useItem returns PASS when the stack's cooldown group is
    42	        // active, before the item is read, consumed or dispatched. ItemCooldowns keys
    43	        // the cooldown by the use_cooldown component's group, falling back to the item
    44	        // id, so the lookup happens for every stack and not only for stacks carrying
    45	        // the component.
    46	        let cooldown_group = item_in_hand

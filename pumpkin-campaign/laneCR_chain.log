   153	fn move_pos_up_out_of_solid(mob: &dyn Mob, pos: BlockPos) -> Option<BlockPos> {
   154	    let world = mob.get_mob_entity().living_entity.entity.world.load();
   155	    let max_y = world.get_top_y();
   156	    let mut landing = pos;
   157	    if world.get_block_state(&landing).is_solid() {
   158	        landing = landing.up();
   159	        while landing.0.y <= max_y && world.get_block_state(&landing).is_solid() {

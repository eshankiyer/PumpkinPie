    30	/// `net.minecraft.world.level.block.FrostedIceBlock`.
    31	///
    32	/// Extends `IceBlock` in vanilla, so it inherits `IceBlock#randomTick`/`melt` unchanged and adds
    33	/// its own scheduled-tick aging mechanic on top; it does *not* add any player-proximity spreading
    34	/// of its own — that visual (water freezing into frosted ice in a radius around the player) is
    35	/// Frost Walker, a separate enchantment that places this block, not a behaviour of the block
    36	/// itself.
    37	#[pumpkin_block("minecraft:frosted_ice")]
    38	pub struct FrostedIceBlock;
    39	
    40	impl BlockBehaviour for FrostedIceBlock {
    41	    // Note: `FrostedIceBlock` inherits `IceBlock#randomTick`, but frosted ice's `Blocks.java`
    42	    // registration (`Blocks.FROSTED_ICE`) has no `.randomTicks()` call, unlike plain ice and
    43	    // unlike crimson/warped nylium (both call `.randomTicks()`). A block without that flag never
    44	    // receives random ticks from the server tick loop, so the inherited method is unreachable in
    45	    // vanilla and is deliberately not implemented here. Only the scheduled-tick aging mechanic
    46	    // below is real.
    47	
    48	    /// `FrostedIceBlock#onPlace`: schedule the first aging tick 60-120 ticks after placement.
    49	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    50	        Box::pin(async move {
    51	            args.world.schedule_block_tick(
    52	                args.block,
    53	                *args.position,
    54	                rand::rng().random_range(60..=120),
    55	                TickPriority::Normal,
    56	            );
    57	        })
    58	    }
    59	
    60	    /// `FrostedIceBlock#tick`: the scheduled-tick aging/melting mechanic.
    61	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
    62	        Box::pin(async move {
    63	            if rand::rng().random_range(0..3) == 0
    64	                || fewer_neighbors_than(args.world, args.position, NEIGHBORS_TO_AGE)
    65	            {
    66	                let brightness = if args.world.dimension == Dimension::THE_END {
    67	                    args.world.get_block_light_level(args.position).unwrap_or(0)
    68	                } else {
    69	                    args.world.get_max_local_raw_brightness(args.position)
    70	                };
    71	
    72	                let (block, state) = args.world.get_block_and_state(args.position);
    73	                let age = i32::from(FrostedIceProperties::from_state_id(state.id, block).age);
    74	                let threshold = (11 - age - i32::from(state.opacity)).max(0) as u8;
    75	
    76	                if brightness > threshold
    77	                    && slightly_melt(args.world, args.position, block, state.id).await
    78	                {
    79	                    for direction in BlockDirection::all() {
    80	                        let neighbor_pos = args.position.offset(direction.to_offset());
    81	                        let (neighbor_block, neighbor_state) =
    82	                            args.world.get_block_and_state(&neighbor_pos);
    83	                        if neighbor_block == &Block::FROSTED_ICE
    84	                            && !slightly_melt(
    85	                                args.world,
    86	                                &neighbor_pos,
    87	                                neighbor_block,
    88	                                neighbor_state.id,
    89	                            )
    90	                            .await
    91	                        {
    92	                            args.world.schedule_block_tick(
    93	                                neighbor_block,
    94	                                neighbor_pos,
    95	                                rand::rng().random_range(20..=40),
    96	                                TickPriority::Normal,
    97	                            );
    98	                        }
    99	                    }
   100	                    return;
   101	                }
   102	            }
   103	
   104	            args.world.schedule_block_tick(
   105	                args.block,
   106	                *args.position,
   107	                rand::rng().random_range(20..=40),
   108	                TickPriority::Normal,
   109	            );
   110	        })
   111	    }
   112	
   113	    /// `FrostedIceBlock#neighborChanged`: fewer than two frosted-ice neighbors melts instantly.
   114	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
   115	        Box::pin(async move {
   116	            if args.source_block == &Block::FROSTED_ICE
   117	                && fewer_neighbors_than(args.world, args.position, NEIGHBORS_TO_MELT)
   118	            {
   119	                melt(args.world, args.position).await;
   120	            }
   121	        })
   122	    }
   123	}
   124	
   125	/// `FrostedIceBlock#slightlyMelt`: bump `AGE` by one, or fully melt once already at `MAX_AGE`.
   126	/// Returns whether the block finished melting (i.e. `AGE` was already maxed out).
   127	async fn slightly_melt(
   128	    world: &Arc<World>,
   129	    position: &BlockPos,
   130	    block: &'static Block,
   131	    state_id: BlockStateId,
   132	) -> bool {
   133	    let mut props = FrostedIceProperties::from_state_id(state_id, block);
   134	    if props.age < MAX_AGE {
   135	        props.age += 1;
   136	        // `level.setBlock(pos, state, 2)`: listener notification only, no neighbor update -
   137	        // the aging loop below drives neighbor scheduling explicitly instead.
   138	        world
   139	            .set_block_state(
   140	                position,
   141	                props.to_state_id(block),
   142	                BlockFlags::NOTIFY_LISTENERS,
   143	            )
   144	            .await;
   145	        false
   146	    } else {
   147	        melt(world, position).await;
   148	        true
   149	    }
   150	}
   151	
   152	/// `FrostedIceBlock`'s neighbor-counting method (vanilla misspells the method name): counts
   153	/// orthogonal frosted-ice neighbors, short circuiting as soon as `limit` is reached.
   154	fn fewer_neighbors_than(world: &World, position: &BlockPos, limit: usize) -> bool {
   155	    let mut count = 0;
   156	    for direction in BlockDirection::all() {
   157	        let neighbor_pos = position.offset(direction.to_offset());
   158	        if world.get_block(&neighbor_pos) == &Block::FROSTED_ICE {
   159	            count += 1;
   160	            if count >= limit {
   161	                return false;
   162	            }
   163	        }
   164	    }
   165	    true
   166	}

    92	pub struct RuleBasedBlockStateProvider {
    93	    pub fallback: Option<Box<BlockStateProvider>>,
    94	    pub rules: Vec<BlockStateRule>,
    95	}
    96	
    97	impl RuleBasedBlockStateProvider {
    98	    pub fn get<T: GenerationCache>(
    99	        &self,
   100	        block_registry: &dyn WorldPortalExt,
   101	        chunk: &T,
   102	        random: &mut RandomGenerator,
   103	        pos: BlockPos,
   104	    ) -> &'static BlockState {
   105	        if let Some(optional) = self.get_optional(block_registry, chunk, random, pos) {
   106	            return optional;
   107	        }
   108	        GenerationCache::get_block_state(chunk, &pos.0).to_state()
   109	    }
   110	    pub fn get_optional<T: GenerationCache>(
   111	        &self,
   112	        block_registry: &dyn WorldPortalExt,
   113	        chunk: &T,
   114	        random: &mut RandomGenerator,
   115	        pos: BlockPos,
   116	    ) -> Option<&'static BlockState> {
   117	        for rule in &self.rules {
   118	            if rule.if_true.test(block_registry, chunk, &pos) {
   119	                return Some(
   120	                    rule.then
   121	                        .get_with_context(block_registry, chunk, random, pos),
   122	                );
   123	            }
   124	        }
   125	        self.fallback
   126	            .as_ref()
   127	            .map(|f| f.get(random, pos, chunk, block_registry))
   128	    }
   129	}
   130	
   131	pub struct BlockStateRule {
   132	    pub if_true: BlockPredicate,
   133	    pub then: BlockStateProvider,
   134	}
   135	
   136	pub struct RandomizedIntBlockStateProvider {
   137	    pub source: Box<BlockStateProvider>,
   138	    pub property: String,
   139	    pub values: IntProvider,
   140	}
   141	
   142	impl RandomizedIntBlockStateProvider {
   143	    // net.minecraft.world.level.levelgen.feature.stateproviders.RandomizedIntStateProvider#getState:
   144	    // samples `values` and writes it into the named integer property of the state returned by
   145	    // `source`, falling back to the unmodified state if the property doesn't exist on it.
   146	    pub fn get<T: GenerationCache>(
   147	        &self,
   148	        random: &mut RandomGenerator,
   149	        pos: BlockPos,
   150	        chunk: &T,
   151	        block_registry: &dyn WorldPortalExt,
   152	    ) -> &'static BlockState {
   153	        let source_state = self.source.get(random, pos, chunk, block_registry);
   154	        let value = self.values.get(random);
   155	
   156	        let block = Block::from_state_id(source_state.id);
   157	        let Some(props_source) = block.properties(source_state.id) else {
   158	            return source_state;
   159	        };
   160	        let props = props_source.to_props();
   161	        if !props.iter().any(|(key, _)| *key == self.property) {
   162	            return source_state;
   163	        }
   164	
   165	        let value_str = value.to_string();
   166	        let new_props: Vec<(&str, &str)> = props
   167	            .iter()
   168	            .map(|(key, value)| {
   169	                if *key == self.property {
   170	                    (*key, value_str.as_str())
   171	                } else {
   172	                    (*key, *value)
   173	                }
   174	            })
   175	            .collect();
   176	
   177	        let new_state_id = block.from_properties(&new_props).to_state_id(block);
   178	        BlockState::from_id(new_state_id)
   179	    }
   180	}
   181	
   182	pub struct PillarBlockStateProvider {
   183	    pub state: &'static BlockState,
   184	}
   185	
   186	impl PillarBlockStateProvider {
   187	    // net.minecraft.world.level.levelgen.feature.stateproviders.RotatedBlockProvider#getState:
   188	    // picks a uniformly random Direction.Axis (X, Y, Z in declaration order) via
   189	    // Util.getRandom, then sets it on the block's `axis` property.
   190	    pub fn get(&self, random: &mut RandomGenerator) -> &'static BlockState {
   191	        let block = Block::from_state_id(self.state.id);
   192	        let Some(props_source) = block.properties(self.state.id) else {
   193	            return self.state;
   194	        };
   195	        let mut props = props_source.to_props();
   196	        let Some(idx) = props.iter().position(|(key, _)| *key == "axis") else {
   197	            return self.state;
   198	        };
   199	
   200	        let axis_str = match random.next_bounded_i32(3) {
   201	            0 => "x",
   202	            1 => "y",
   203	            _ => "z",
   204	        };
   205	        props[idx] = ("axis", axis_str);
   206	
   207	        let new_state_id = block.from_properties(&props).to_state_id(block);
   208	        BlockState::from_id(new_state_id)
   209	    }
   210	}
   211	
   212	pub struct DualNoiseBlockStateProvider {
   213	    pub base: NoiseBlockStateProvider,
   214	    pub variety: [u32; 2],
   215	    pub slow_noise: DoublePerlinNoiseParametersCodec,
   216	    pub slow_scale: f64,
   217	}
   218	
   219	impl DualNoiseBlockStateProvider {
   220	    pub fn get(&self, pos: BlockPos) -> &'static BlockState {
   221	        let sampler = DoublePerlinNoiseSampler::new(
   222	            &mut RandomGenerator::Legacy(LegacyRand::from_seed(self.base.base.seed as u64)),
   223	            self.slow_noise.first_octave,
   224	            &self.slow_noise.amplitudes,
   225	            self.slow_noise.amplitude,
   226	            false,
   227	        );
   228	        let slow_noise =
   229	            self.get_slow_noise(pos.0.x as f64, pos.0.y as f64, pos.0.z as f64, &sampler);
   230	        let mapped = clamped_map(
   231	            slow_noise,
   232	            -1.0,
   233	            1.0,
   234	            self.variety[0] as f64,
   235	            self.variety[1] as f64 + 1.0,
   236	        ) as i32;
   237	        let mut list = Vec::with_capacity(mapped as usize);
   238	        for i in 0..mapped {
   239	            let value = self.get_slow_noise(i as f64 * 54545.0, 0.0, i as f64 * 34234.0, &sampler);
   240	            list.push(NoiseBlockStateProvider::get_state_by_value(
   241	                &self.base.states,
   242	                value,
   243	            ));
   244	        }
   245	        let value = self.base.base.get_noise(pos);
   246	        NoiseBlockStateProvider::get_state_by_value(&list, value)
   247	    }
   248	
   249	    fn get_slow_noise(&self, x: f64, y: f64, z: f64, sampler: &DoublePerlinNoiseSampler) -> f64 {
   250	        sampler.sample(
   251	            x * self.slow_scale,
   252	            y * self.slow_scale,
   253	            z * self.slow_scale,
   254	        )
   255	    }
   256	}

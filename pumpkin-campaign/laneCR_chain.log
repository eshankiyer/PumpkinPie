    17	            let Some(living_entity) = args.entity.get_living_entity() else {
    18	                return;
    19	            };
    20	
    21	            let ent = args.entity.get_entity();
    22	
    23	            // Don't damage if sneaking
    24	            if ent.is_sneaking() {
    25	                return;
    26	            }
    27	
    28	            // Fire immune entities don't take damage
    29	            if ent.entity_type.fire_immune || ent.fire_immune.load(Ordering::Relaxed) {
    30	                return;
    31	            }
    32	
    33	            let has_frost_walker = {
    34	                let equipment = living_entity.entity_equipment.lock().await;
    35	                equipment
    36	                    .equipment
    37	                    .get(&EquipmentSlot::FEET)
    38	                    .is_some_and(|boots| {
    39	                        boots.get_enchantment_level(&Enchantment::FROST_WALKER) != 0
    40	                    })
    41	            };
    42	            if has_frost_walker {
    43	                return;
    44	            }
    45	
    46	            if living_entity
    47	                .get_effect(&StatusEffect::FIRE_RESISTANCE)
    48	                .await
    49	                .is_some()
    50	            {
    51	                return;
    52	            }
    53	
    54	            // Apply damage
    55	            args.entity
    56	                .damage(args.entity, 1.0, DamageType::HOT_FLOOR)
    57	                .await;
    58	        })
    59	    }
    60	}


   155	    /// `ScaffoldingBlock.tick` (`ScaffoldingBlock.java:116-129`). See the doc's gap review for
   156	    /// why this three-way branch must be transcribed literally rather than re-derived: the
   157	    /// destroy-no-entity and fall-as-entity paths have different drop semantics.
   158	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
   159	        Box::pin(async move {
   160	            let old_state_id = args.world.get_block_state_id(args.position);
   161	            let old_props = ScaffoldingLikeProperties::from_state_id(old_state_id, args.block);
   162	
   163	            let new_distance = Self::get_distance(args.world.as_ref(), args.position);
   164	            let mut new_props = old_props;
   165	            new_props.r#distance = new_distance;
   166	            new_props.r#bottom = Self::is_bottom(args.world.as_ref(), args.position, new_distance);
   167	            let new_state_id = new_props.to_state_id(args.block);
   168	
   169	            if new_distance == MAX_DISTANCE {
   170	                if old_props.r#distance == MAX_DISTANCE {
   171	                    FallingEntity::replace_spawn(args.world, *args.position, new_state_id).await;
   172	                } else {
   173	                    args.world
   174	                        .break_block(args.position, None, BlockFlags::empty())
   175	                        .await;
   176	                }
   177	            } else if new_state_id != old_state_id {
   178	                args.world
   179	                    .set_block_state(args.position, new_state_id, BlockFlags::NOTIFY_ALL)
   180	                    .await;
   181	            }
   182	        })
   183	    }

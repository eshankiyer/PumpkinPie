   250	/// `NearestVisibleLivingEntities` (`memory/NearestVisibleLivingEntities.java:14-71`).
   251	///
   252	/// The living entities a mob saw on its last scan, nearest first
   253	/// (`NearestLivingEntitySensor.java:21`), each flagged with whether line of sight existed at
   254	/// scan time.
   255	///
   256	/// DEVIATION: vanilla computes visibility lazily per query through a per-scan cached
   257	/// predicate (`NearestVisibleLivingEntities.java:26-28`) that re-tests
   258	/// `Sensor.isEntityTargetable`; this port evaluates the flag once during the sensor scan and
   259	/// stores it, because the flag's inputs (positions, blocks between) are exactly what the scan
   260	/// already read. Both forms are allowed up to one 20-tick scan interval of staleness by
   261	/// vanilla's own design (`sensing/Sensor.java:14`). A despawned entity's `Weak` fails to
   262	/// upgrade and is skipped at query time, matching the module-wide weak-reference rule.
   263	#[derive(Clone, Default)]
   264	pub struct NearestVisibleLivingEntities {
   265	    entities: Vec<(Weak<dyn EntityBase>, bool)>,
   266	}
   267	
   268	impl NearestVisibleLivingEntities {
   269	    /// `NearestVisibleLivingEntities.empty()` (`NearestVisibleLivingEntities.java:31-33`).
   270	    #[must_use]
   271	    pub fn empty() -> Self {
   272	        Self {
   273	            entities: Vec::new(),
   274	        }
   275	    }
   276	
   277	    /// Built once per scan by [`crate::entity::ai::brain::sensor::nearest_living_entities`],
   278	    /// with entries already sorted nearest-first.
   279	    #[must_use]
   280	    pub fn new(entities: Vec<(Weak<dyn EntityBase>, bool)>) -> Self {
   281	        Self { entities }
   282	    }
   283	
   284	    /// `findClosest(filter)` (`NearestVisibleLivingEntities.java:40-48`): the nearest entity
   285	    /// passing `filter` whose stored visibility flag held.
   286	    #[must_use]
   287	    pub fn find_closest(
   288	        &self,
   289	        filter: impl Fn(&dyn EntityBase) -> bool,
   290	    ) -> Option<Arc<dyn EntityBase>> {
   291	        self.entities.iter().find_map(|(weak, visible)| {
   292	            if !*visible {
   293	                return None;
   294	            }
   295	            let entity = weak.upgrade()?;
   296	            filter(entity.as_ref()).then_some(entity)
   297	        })
   298	    }
   299	
   300	    /// `findAll(filter)` (`NearestVisibleLivingEntities.java:50-52`), preserving the
   301	    /// nearest-first order.
   302	    #[must_use]
   303	    pub fn find_all(&self, filter: impl Fn(&dyn EntityBase) -> bool) -> Vec<Arc<dyn EntityBase>> {
   304	        self.entities
   305	            .iter()
   306	            .filter_map(|(weak, visible)| {
   307	                if !*visible {
   308	                    return None;
   309	                }
   310	                let entity = weak.upgrade()?;
   311	                filter(entity.as_ref()).then_some(entity)
   312	            })
   313	            .collect()
   314	    }
   315	
   316	    /// `contains(targetEntity)` (`NearestVisibleLivingEntities.java:58-60`), compared by
   317	    /// entity id.
   318	    #[must_use]
   319	    pub fn contains(&self, other: &Arc<dyn EntityBase>) -> bool {
   320	        let other_id = other.get_entity().entity_id;
   321	        self.entities.iter().any(|(weak, visible)| {
   322	            *visible
   323	                && weak
   324	                    .upgrade()
   325	                    .is_some_and(|entity| entity.get_entity().entity_id == other_id)
   326	        })
   327	    }
   328	}

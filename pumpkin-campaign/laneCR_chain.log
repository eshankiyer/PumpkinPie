   199	/// `SkullBlockEntity.applyImplicitComponents` restores the profile, note block sound and
   200	/// custom name from the placed item (`SkullBlockEntity.java:97-103`).
   201	fn apply_skull_components(
   202	    entity: &dyn BlockEntity,
   203	    stack: &ItemStack,
   204	) -> Option<Arc<dyn BlockEntity>> {
   205	    let profile = stack
   206	        .get_data_component::<ProfileImpl>()
   207	        .map(pumpkin_data::data_component_impl::DataComponentImpl::write_data);
   208	    let note_block_sound = stack
   209	        .get_data_component::<NoteBlockSoundImpl>()
   210	        .map(pumpkin_data::data_component_impl::DataComponentImpl::write_data);
   211	    let custom_name = stack
   212	        .get_data_component::<CustomNameImpl>()
   213	        .map(pumpkin_data::data_component_impl::DataComponentImpl::write_data);

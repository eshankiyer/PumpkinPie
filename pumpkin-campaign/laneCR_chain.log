   272	            // Decrement the used stack (clear)
   273	            if used_main {
   274	                let mut s = player.inventory.held_item().await;
   275	                s.decrement_unless_creative(player.gamemode.load(), 1);
   276	                player.inventory.set_held_item(s).await;
   277	            } else {
   278	                let mut s = player.inventory.off_hand_item().await;
   279	                s.decrement_unless_creative(player.gamemode.load(), 1);

   157	        })
   158	    }
   159	
   160	    /// `ShulkerBoxMenu.java:39-62`. Note it has no `onTake`/count-equality tail,
   161	    /// unlike `DispenserMenu.quickMoveStack`.
   162	    fn quick_move<'a>(
   163	        &'a mut self,
   164	        _player: &'a dyn InventoryPlayer,
   165	        slot_index: i32,
   166	    ) -> ItemStackFuture<'a> {
   167	        Box::pin(async move {
   168	            let mut stack_left = ItemStack::EMPTY.clone();
   169	            let slot = self.get_behaviour().slots[slot_index as usize].clone();
   170	            let container_size = SHULKER_BOX_SIZE as i32;
   171	
   172	            if slot.has_stack().await {
   173	                let mut slot_stack = slot.get_stack().await;
   174	                stack_left = slot_stack.clone();
   175	
   176	                if slot_index < container_size {
   177	                    if !self
   178	                        .insert_item(
   179	                            &mut slot_stack,
   180	                            container_size,
   181	                            self.get_behaviour().slots.len() as i32,
   182	                            true,
   183	                        )
   184	                        .await
   185	                    {
   186	                        return ItemStack::EMPTY.clone();
   187	                    }
   188	                } else if !self
   189	                    .insert_item(&mut slot_stack, 0, container_size, false)
   190	                    .await
   191	                {
   192	                    return ItemStack::EMPTY.clone();
   193	                }
   194	
   195	                if slot_stack.is_empty() {
   196	                    slot.set_stack(ItemStack::EMPTY.clone()).await;
   197	                } else {
   198	                    slot.set_stack(slot_stack).await;
   199	                }
   200	            }
   201	
   202	            stack_left
   203	        })
   204	    }
   205	}

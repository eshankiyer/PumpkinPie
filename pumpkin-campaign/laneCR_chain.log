    16	const REACH: f64 = 500.0;
    17	
    18	/// Vanilla: `NearestHealableRaiderTargetGoal<Raider>` as wired by `Witch.registerGoals`.
    19	///
    20	/// (`target = Raider.class`, `mustSee = true`, subselector `hasActiveRaid() &&
    21	/// !target.is(EntityTypes.WITCH)`). Finds the nearest hurt raid-mate (excluding other witches)
    22	/// while an active raid is running; `Witch::mob_tick` drives the 200-tick cooldown externally.
    23	pub struct NearestHealableRaiderTargetGoal {
    24	    track_target_goal: TrackTargetGoal,
    25	    target: Option<Arc<dyn EntityBase>>,
    26	}
    27	
    28	impl NearestHealableRaiderTargetGoal {
    29	    #[must_use]
    30	    pub fn new() -> Self {
    31	        Self {
    32	            track_target_goal: TrackTargetGoal::with_default(true),
    33	            target: None,
    34	        }
    35	    }
    36	
    37	    fn find_target(mob_entity: &MobEntity) -> Option<Arc<dyn EntityBase>> {
    38	        let world = mob_entity.living_entity.entity.world.load();
    39	        let mut search_pos = mob_entity.living_entity.entity.pos.load();
    40	        search_pos.y += mob_entity
    41	            .living_entity
    42	            .entity
    43	            .entity_dimension
    44	            .load()
    45	            .eye_height as f64;
    46	        let self_id = mob_entity.living_entity.entity.entity_id;
    47	
    48	        let mut candidates: Vec<(Arc<dyn EntityBase>, f64)> = world
    49	            .get_nearby_entities(search_pos, REACH)
    50	            .into_values()
    51	            .filter_map(|entity| {
    52	                if entity.get_entity().entity_id == self_id {
    53	                    return None;
    54	                }
    55	                if entity.get_entity().entity_type == &pumpkin_data::entity::EntityType::WITCH {
    56	                    return None;
    57	                }
    58	                if !entity
    59	                    .get_entity()
    60	                    .entity_type
    61	                    .has_tag(&tag::EntityType::MINECRAFT_RAIDERS)
    62	                {
    63	                    return None;
    64	                }
    65	                let living = entity.get_living_entity()?;
    66	                if !living.entity.is_alive() {
    67	                    return None;
    68	                }
    69	                if living.health.load()
    70	                    >= living.get_attribute_value(&Attributes::MAX_HEALTH) as f32
    71	                {
    72	                    return None;
    73	                }
    74	                let dist = entity
    75	                    .get_entity()
    76	                    .pos
    77	                    .load()
    78	                    .squared_distance_to_vec(&search_pos);
    79	                Some((entity, dist))
    80	            })
    81	            .collect();
    82	
    83	        candidates.sort_by(|a, b| a.1.partial_cmp(&b.1).unwrap());
    84	        candidates.into_iter().map(|(e, _)| e).next()
    85	    }
    86	}

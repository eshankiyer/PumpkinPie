    63	         serverLevel.gameEvent(GameEvent.ENTITY_PLACE, pos, GameEvent.Context.of(context.getPlayer(), serverLevel.getBlockState(pos.below())));
    64	      }
    65	
    66	      itemStack.shrink(1);
    67	      return InteractionResult.SUCCESS;
    68	   }
    69	}

   296	
   297	        // Contiguous memory for our function components
   298	        let mut stack = Vec::<ProtoNoiseFunctionComponent>::with_capacity(base_stack.len());
   299	
   300	        for component in base_stack {
   301	            let converted = match component {
   302	                BaseNoiseFunctionComponent::Spline { spline } => {
   303	                    let spline = match build_spline_recursive(spline) {
   304	                        SplineValue::Spline(spline) => spline,
   305	                        // Top level splines always take in a density function
   306	                        SplineValue::Fixed(_) => unreachable!(),
   307	                    };
   308	
   309	                    ProtoNoiseFunctionComponent::Dependent(
   310	                        DependentProtoNoiseFunctionComponent::Spline(SplineFunction::new(
   311	                            spline, &stack,
   312	                        )),
   313	                    )
   314	                }
   315	                BaseNoiseFunctionComponent::FindTopSurface {
   316	                    density_index,
   317	                    upper_bound_index,
   318	                    data,
   319	                } => {
   320	                    let min_value = data.lower_bound as f64;
   321	                    let max_value = stack[*upper_bound_index].max().max(min_value);
   322	
   323	                    ProtoNoiseFunctionComponent::Dependent(
   324	                        DependentProtoNoiseFunctionComponent::FindTopSurface(FindTopSurface::new(
   325	                            *density_index,
   326	                            *upper_bound_index,
   327	                            min_value,
   328	                            max_value,
   329	                            data,

     1	//! Port of `net.minecraft.world.entity.ai.memory` (26.2 decompile at
     2	//! `/home/eshanki/pumpkin-vanilla-26.2/decompiled`).
     3	//!
     4	//! Stage 0 of the Brain/Memory/Activity port. This module is the *always-live* half of a
     5	//! `Brain`: it is guarded by a short-lived `std::sync::Mutex` and is never taken out of its
     6	//! mutex for the duration of a tick, because memories are legitimately written from outside
     7	//! the owning mob's AI tick (damage handlers, game-event listeners, item pickup). See
     8	//! `super::Brain` for the split and `BRAIN_DESIGN.md` section 4.2 for the derivation.
     9	//!
    10	//! Deviations from vanilla, all deliberate:
    11	//! - `GlobalPos` (dimension + `BlockPos`) is stored as a bare `BlockPos`. Pumpkin has no
    12	//!   `GlobalPos`; the only consumer in this stage is Allay's liked note block, which vanilla
    13	//!   also range-checks per dimension (`AllayAi.java:131`). Cross-dimension correctness is
    14	//!   therefore NOT covered.
    15	//! - `MemoryModuleType.PATH` is not represented at all. Vanilla's `MoveToTargetSink` stores a
    16	//!   live `Path` in it (`MoveToTargetSink.java:92,101`); Pumpkin's `Navigator` owns its path
    17	//!   internally and exposes no equivalent handle, so the slot would be unreadable.
    18	//! - Entity-valued memories hold `Weak<dyn EntityBase>` rather than a strong `Arc`, so a
    19	//!   stale memory cannot keep a despawned entity alive. A failed `upgrade()` is treated the
    20	//!   same as vanilla's "the sensor stopped re-populating this memory".
    21	
    22	use std::any::Any;
    23	use std::sync::{Arc, Weak};
    24	
    25	use pumpkin_data::damage::DamageType;
    26	use pumpkin_util::math::position::BlockPos;
    27	use pumpkin_util::math::vector3::Vector3;
    28	use uuid::Uuid;
    29	
    30	use crate::entity::EntityBase;
    31	
    32	/// `MemoryStatus` (`memory/MemoryStatus.java`), the full enum.
    33	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    34	pub enum MemoryStatus {
    35	    ValuePresent,
    36	    ValueAbsent,
    37	    /// The slot exists on this brain at all. `Brain.checkMemory` returns `false` for an
    38	    /// unregistered type regardless of the requested status (`Brain.java:242-249`), which is
    39	    /// why `MemoryStore` tracks registration separately from "has a value".
    40	    Registered,
    41	}
    42	
    43	/// Dense, compiler-checked index for every memory type this port covers.
    44	///
    45	/// Vanilla declares ~120 `MemoryModuleType` constants (`memory/MemoryModuleType.java:33-152`)
    46	/// in a registry that assigns each a stable identity. Only the subset reachable from Allay's
    47	/// brain is declared here; adding a mob means adding variants, and `COUNT`/`ALL` must be kept
    48	/// in sync (there is a `debug_assert` covering that in `MemoryStore::new`).
    49	#[derive(Clone, Copy, PartialEq, Eq, Debug)]
    50	pub enum MemoryKeyId {
    51	    WalkTarget,
    52	    LookTarget,
    53	    CantReachWalkTargetSince,
    54	    IsPanicking,
    55	    HurtBy,
    56	    LikedPlayer,
    57	    LikedNoteblockPosition,
    58	    LikedNoteblockCooldownTicks,
    59	    ItemPickupCooldownTicks,
    60	    NearestVisibleWantedItem,
    61	    NearestLivingEntities,
    62	    NearestVisibleLivingEntities,
    63	}
    64	
    65	impl MemoryKeyId {
    66	    pub const ALL: [Self; 12] = [
    67	        Self::WalkTarget,
    68	        Self::LookTarget,
    69	        Self::CantReachWalkTargetSince,
    70	        Self::IsPanicking,
    71	        Self::HurtBy,
    72	        Self::LikedPlayer,
    73	        Self::LikedNoteblockPosition,
    74	        Self::LikedNoteblockCooldownTicks,
    75	        Self::ItemPickupCooldownTicks,
    76	        Self::NearestVisibleWantedItem,
    77	        Self::NearestLivingEntities,
    78	        Self::NearestVisibleLivingEntities,
    79	    ];
    80	    pub const COUNT: usize = Self::ALL.len();
    81	
    82	    #[must_use]
    83	    pub const fn index(self) -> usize {
    84	        self as usize
    85	    }
    86	}

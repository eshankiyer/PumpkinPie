    30	            val if val == Item::TNT_MINECART.id => &EntityType::TNT_MINECART,
    31	            val if val == Item::CHEST_MINECART.id => &EntityType::CHEST_MINECART,
    32	            val if val == Item::HOPPER_MINECART.id => &EntityType::HOPPER_MINECART,
    33	            val if val == Item::FURNACE_MINECART.id => &EntityType::FURNACE_MINECART,
    34	            val if val == Item::COMMAND_BLOCK_MINECART.id => &EntityType::COMMAND_BLOCK_MINECART,
    35	            _ => {
    36	                tracing::error!("Unknown minecart item ID: {}", item.id);

   103	#[must_use]
   104	pub const fn horizontal_facing_from_offset(offset: Vector3<i32>) -> Option<BlockDirection> {
   105	    match (offset.x, offset.y, offset.z) {
   106	        (0, 0, -1) => Some(BlockDirection::North),
   107	        (0, 0, 1) => Some(BlockDirection::South),
   108	        (-1, 0, 0) => Some(BlockDirection::West),
   109	        (1, 0, 0) => Some(BlockDirection::East),
   110	        _ => None,
   111	    }
   112	}
   113	fn can_place_ladder_at(world: &World, block_pos: &BlockPos, facing: BlockDirection) -> bool {
   114	    world
   115	        .get_block_state(&block_pos.offset(facing.to_offset()))
   116	        .is_side_solid(facing.opposite())
   117	}

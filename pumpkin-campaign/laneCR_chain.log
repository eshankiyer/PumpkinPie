    28	   public static void dumpVersion(final Consumer<Component> output) {
    29	      WorldVersion version = SharedConstants.getCurrentVersion();
    30	      output.accept(Component.translatable("commands.version.id", version.id()));
    31	      output.accept(Component.translatable("commands.version.name", version.name()));

    32	   public static BehaviorControl<LivingEntity> create() {
    33	      MutableObject<Node> lastCheckedNode = new MutableObject<>();
    34	      MutableInt remainingCooldown = new MutableInt(0);
    35	      return BehaviorBuilder.create(
    36	         i -> i.group(i.present(MemoryModuleType.PATH), i.registered(MemoryModuleType.DOORS_TO_CLOSE), i.registered(MemoryModuleType.NEAREST_LIVING_ENTITIES))

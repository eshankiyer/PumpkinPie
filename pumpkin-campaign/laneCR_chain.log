   353	/// Per-function cache of instantiated (substituted) command-line lists, keyed
   354	/// by the stringified parameter values.
   355	///
   356	/// Port of the `Object2ObjectLinkedOpenHashMap` used as an LRU by
   357	/// `MacroFunction` (`MacroFunction.java:36`): a hit moves the entry to the
   358	/// most-recently-used position (`getAndMoveToLast`, `:70-73`) and inserting
   359	/// beyond capacity evicts the least-recently-used entry first (`:75-77`).
   360	#[derive(Default)]
   361	pub struct InstantiationCache {
   362	    /// `(parameter values, instantiated command lines)` pairs ordered from
   363	    /// least- to most-recently-used.
   364	    entries: Vec<(Vec<String>, Vec<String>)>,
   365	}
   366	
   367	impl InstantiationCache {
   368	    /// Returns the cached instantiation for `key`, refreshing its recency, or
   369	    /// computes and caches it on a miss. Port of the cache block of
   370	    /// `MacroFunction.instantiate` (`MacroFunction.java:70-81`).
   371	    ///
   372	    /// # Errors
   373	    /// Propagates the `compute` failure; nothing is cached in that case
   374	    /// (matching vanilla, which only puts successfully parsed functions,
   375	    /// `MacroFunction.java:79-81`).
   376	    pub fn get_or_insert_with(
   377	        &mut self,
   378	        key: &[String],
   379	        compute: impl FnOnce() -> Result<Vec<String>, String>,
   380	    ) -> Result<Vec<String>, String> {
   381	        if let Some(position) = self.entries.iter().position(|(k, _)| k == key) {
   382	            let entry = self.entries.remove(position);
   383	            self.entries.push(entry);
   384	            return Ok(self
   385	                .entries
   386	                .last()
   387	                .map_or_else(Vec::new, |(_, lines)| lines.clone()));
   388	        }
   389	
   390	        let instantiated = compute()?;
   391	        if self.entries.len() >= MAX_CACHE_ENTRIES {
   392	            self.entries.remove(0);
   393	        }
   394	        self.entries.push((key.to_vec(), instantiated.clone()));
   395	        Ok(instantiated)
   396	    }
   397	}

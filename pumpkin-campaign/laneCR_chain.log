    12	#[java_packet(PLAYER_ABILITIES)]
    13	pub struct SPlayerAbilities {
    14	    pub flags: i8,
    15	    pub fly_speed: Option<f32>,
    16	    pub walk_speed: Option<f32>,
    17	}
    18	
    19	impl SPlayerAbilities {
    20	    #[must_use]
    21	    pub const fn new(flags: i8, fly_speed: Option<f32>, walk_speed: Option<f32>) -> Self {
    22	        Self {
    23	            flags,
    24	            fly_speed,
    25	            walk_speed,
    26	        }
    27	    }
    28	
    29	    #[must_use]
    30	    pub const fn is_invulnerable(&self) -> bool {
    31	        (self.flags & 0x01) != 0
    32	    }
    33	
    34	    #[must_use]
    35	    pub const fn is_flying(&self) -> bool {
    36	        (self.flags & 0x02) != 0
    37	    }
    38	
    39	    #[must_use]
    40	    pub const fn is_flight_allowed(&self) -> bool {
    41	        (self.flags & 0x04) != 0
    42	    }
    43	
    44	    #[must_use]
    45	    pub const fn is_creative_mode(&self) -> bool {
    46	        (self.flags & 0x08) != 0
    47	    }
    48	}
    49	
    50	impl<'a> ServerPacket<'a> for SPlayerAbilities {
    51	    fn read(bytebuf: &mut &'a [u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
    52	        let flags = bytebuf.get_i8()?;
    53	        let (fly_speed, walk_speed) = if *version < JavaMinecraftVersion::V_1_16 {
    54	            (Some(bytebuf.get_f32_be()?), Some(bytebuf.get_f32_be()?))
    55	        } else {
    56	            (None, None)
    57	        };
    58	        Ok(Self {
    59	            flags,
    60	            fly_speed,
    61	            walk_speed,
    62	        })
    63	    }
    64	}
    65	
    66	impl crate::ClientPacket for SPlayerAbilities {
    67	    fn write_packet_data(
    68	        &self,
    69	        mut write: impl std::io::Write,
    70	        version: &JavaMinecraftVersion,
    71	    ) -> Result<(), crate::ser::WritingError> {
    72	        use crate::ser::NetworkWriteExt;
    73	        write.write_i8(self.flags)?;
    74	        if *version < JavaMinecraftVersion::V_1_16 {
    75	            write.write_f32_be(self.fly_speed.unwrap_or(0.05))?;
    76	            write.write_f32_be(self.walk_speed.unwrap_or(0.1))?;
    77	        }
    78	        Ok(())
    79	    }
    80	}


   260	                    .map(|biome| biome.id)
   261	                    .into_iter()
   262	                    .collect(),
   263	                ResourceOrTag::Tag(id) => {
   264	                    tag::get_tag_values(RegistryKey::WorldgenBiome, &id.to_string())
   265	                        .into_iter()
   266	                        .flatten()
   267	                        .filter_map(|name| Biome::from_name(name))
   268	                        .map(|biome| biome.id)
   269	                        .collect()
   270	                }
   271	            };
   272	
   273	            let not_found = || {
   274	                BIOME_NOT_FOUND_ERROR_TYPE
   275	                    .create_without_context(TextComponent::text(searched.printable()))
   276	            };
   277	            if targets.is_empty() {
   278	                return Err(not_found());
   279	            }
   280	
   281	            let origin = BlockPos::floored_v(context.source.position);
   282	            let world = context.source.world().clone();
   283	            let world_gen = world.level.world_gen.load_full();
   284	
   285	            // The spiral scan can probe hundreds of thousands of noise
   286	            // points when the biome is rare, so keep it off the async
   287	            // workers.
   288	            let found = tokio::task::spawn_blocking(move || {
   289	                find_closest_biome_3d(
   290	                    &world_gen,
   291	                    origin,
   292	                    &targets,
   293	                    BIOME_SEARCH_RADIUS,
   294	                    BIOME_SEARCH_HORIZONTAL_STEP,
   295	                    BIOME_SEARCH_VERTICAL_STEP,
   296	                )
   297	            })
   298	            .await
   299	            .map_err(|_| SEARCH_FAILED_ERROR_TYPE.create_without_context())?;
   300	
   301	            let Some((target, biome)) = found else {
   302	                return Err(not_found());
   303	            };
   304	
   305	            let distance = absolute_distance(&origin, &target);
   306	            send_success(
   307	                context,
   308	                translation::java::COMMANDS_LOCATE_BIOME_SUCCESS,
   309	                translation::bedrock::COMMANDS_LOCATE_BIOME_SUCCESS,
   310	                result_name(&searched, &format!("minecraft:{}", biome.registry_id)),
   311	                &target,
   312	                true,
   313	                distance,
   314	            )
   315	            .await;

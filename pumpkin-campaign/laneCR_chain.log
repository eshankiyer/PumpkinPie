    57	    /// `ScaffoldingBlock.getDistance` (`ScaffoldingBlock.java:158-179`).
    58	    ///
    59	    /// Faithful to a vanilla mutable-cursor quirk: the vertical check reads `pos.below()`, but
    60	    /// the horizontal scan afterward is centered on `pos` itself (the cursor is reused via
    61	    /// `setWithOffset(pos, direction)`, not advanced from `pos.below()`).
    62	    fn get_distance(accessor: &dyn BlockAccessor, pos: &BlockPos) -> u8 {
    63	        let below_pos = pos.down();
    64	        let (below_block, below_state) = accessor.get_block_and_state(&below_pos);
    65	
    66	        let mut distance = MAX_DISTANCE;
    67	        if below_block == &Block::SCAFFOLDING {
    68	            distance =
    69	                ScaffoldingLikeProperties::from_state_id(below_state.id, below_block).r#distance;
    70	        } else if below_state.is_side_solid(BlockDirection::Up) {
    71	            return 0;
    72	        }
    73	
    74	        for direction in [
    75	            BlockDirection::North,
    76	            BlockDirection::South,
    77	            BlockDirection::West,
    78	            BlockDirection::East,
    79	        ] {
    80	            let neighbor_pos = pos.offset(direction.to_offset());
    81	            let (neighbor_block, neighbor_state) = accessor.get_block_and_state(&neighbor_pos);
    82	            if neighbor_block == &Block::SCAFFOLDING {
    83	                let neighbor_distance =
    84	                    ScaffoldingLikeProperties::from_state_id(neighbor_state.id, neighbor_block)
    85	                        .r#distance;
    86	                distance = distance.min(neighbor_distance.saturating_add(1));
    87	                if distance == 1 {
    88	                    break;
    89	                }
    90	            }
    91	        }
    92	
    93	        distance
    94	    }

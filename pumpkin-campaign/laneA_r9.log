   103	      final Direction directionToNeighbour,
   104	      final BlockPos neighbourPos,
   105	      final BlockState neighbourState,
   106	      final RandomSource random
   107	   ) {
   108	      BlockState blockState = super.updateShape(state, level, ticks, pos, directionToNeighbour, neighbourPos, neighbourState, random);
   109	      if (this.chestCanConnectTo(neighbourState)) {
   110	         ChestType chestType = blockState.getValue(ChestBlock.TYPE);
   111	         if (!chestType.equals(ChestType.SINGLE) && getConnectedDirection(blockState) == directionToNeighbour) {
   112	            return neighbourState.getBlock().withPropertiesOf(blockState);
   113	         }
   114	      }
   115	
   116	      return blockState;
   117	   }

                    && Self::try_place_extension(
                        foliage_positions,
                        chunk,
                        random,
                        hanging_leaves_chance,
                        log_pos,
                        pos,
                        foliage_provider,
                    )
                {
                    Self::try_place_extension(
                        foliage_positions,
                        chunk,
                        random,
                        hanging_leaves_extension_chance,
                        log_pos,
                        pos.down(),
                        foliage_provider,
                    );
                }
                pos = pos.offset_dir(along_edge.to_offset(), 1);
            }
        }
    }
}


    65	/// `ConduitBlockEntity.updateShape`, split from world access so the offset geometry can
    66	/// be tested without a live `World`. `is_water` mirrors `Level.isWaterAt` for the inner
    67	/// 3x3x3 cube, `frame_block` mirrors `Level.getBlockState(pos).getBlock()` for the outer
    68	/// shell.
    69	fn scan_shape(
    70	    origin: BlockPos,
    71	    mut is_water: impl FnMut(BlockPos) -> bool,
    72	    mut frame_block: impl FnMut(BlockPos) -> &'static Block,
    73	) -> Vec<BlockPos> {
    74	    for ox in -1..=1 {
    75	        for oy in -1..=1 {
    76	            for oz in -1..=1 {
    77	                if !is_water(origin.offset(Vector3::new(ox, oy, oz))) {
    78	                    return Vec::new();

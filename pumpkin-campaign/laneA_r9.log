   391	mod test {
   392	    use super::{Block, frame_offsets, is_valid_frame_block, scan_shape};
   393	    use pumpkin_util::math::position::BlockPos;
   394	    use pumpkin_util::math::vector3::Vector3;
   395	    use std::collections::HashSet;
   396	
   397	    #[test]
   398	    fn frame_offsets_match_vanilla_scan_count() {
   399	        // `MIN_KILL_SIZE` (42) is exactly the number of positions vanilla's
   400	        // `updateShape` loop can ever add to `effectBlocks`.
   401	        let offsets = frame_offsets();
   402	        assert_eq!(offsets.len(), 42);
   403	
   404	        let unique: HashSet<_> = offsets.iter().copied().collect();
   405	        assert_eq!(unique.len(), offsets.len(), "offsets must not repeat");
   406	    }
   407	
   408	    #[test]
   409	    fn frame_offsets_stay_outside_inner_cube_and_within_shell() {
   410	        for &(x, y, z) in &frame_offsets() {
   411	            assert!(x.abs() > 1 || y.abs() > 1 || z.abs() > 1);
   412	            assert!(x.abs() <= 2 && y.abs() <= 2 && z.abs() <= 2);
   413	        }
   414	    }
   415	
   416	    #[test]
   417	    fn frame_offsets_include_known_arm_positions() {
   418	        let offsets: HashSet<_> = frame_offsets().into_iter().collect();
   419	        // One of the six axis-aligned "plus" arms.
   420	        assert!(offsets.contains(&(2, 0, 0)));
   421	        assert!(offsets.contains(&(-2, 0, 0)));
   422	        assert!(offsets.contains(&(0, 2, 0)));
   423	        assert!(offsets.contains(&(0, 0, 2)));
   424	        // Off-axis shell positions such as (2, 1, 0) do qualify too (ax=2, oz==0).
   425	        assert!(offsets.contains(&(2, 1, 0)));
   426	        // But a true corner like (2, 2, 2) never satisfies the "one axis is zero" arm test.
   427	        assert!(!offsets.contains(&(2, 2, 2)));
   428	    }
   429	
   430	    #[test]
   431	    fn is_valid_frame_block_matches_vanilla_list() {
   432	        assert!(is_valid_frame_block(&Block::PRISMARINE));
   433	        assert!(is_valid_frame_block(&Block::PRISMARINE_BRICKS));
   434	        assert!(is_valid_frame_block(&Block::SEA_LANTERN));
   435	        assert!(is_valid_frame_block(&Block::DARK_PRISMARINE));
   436	        assert!(!is_valid_frame_block(&Block::STONE));
   437	        assert!(!is_valid_frame_block(&Block::WATER));
   438	    }
   439	
   440	    #[test]
   441	    fn scan_shape_requires_full_water_core() {
   442	        let origin = BlockPos(Vector3::new(0, 64, 0));
   443	        // All frame blocks present, but the inner 3x3x3 core is not fully water.
   444	        let shape = scan_shape(
   445	            origin,
   446	            |pos| pos != origin.offset(Vector3::new(1, 0, 0)),
   447	            |_| &Block::PRISMARINE,
   448	        );
   449	        assert!(shape.is_empty());
   450	    }
   451	
   452	    #[test]
   453	    fn scan_shape_counts_only_valid_frame_blocks() {
   454	        let origin = BlockPos(Vector3::new(0, 64, 0));
   455	        let shape = scan_shape(origin, |_| true, |_| &Block::PRISMARINE);
   456	        assert_eq!(shape.len(), 42);
   457	
   458	        let shape = scan_shape(origin, |_| true, |_| &Block::STONE);
   459	        assert!(shape.is_empty());
   460	    }
   461	
   462	    #[test]
   463	    fn scan_shape_positions_are_relative_to_origin() {
   464	        let origin = BlockPos(Vector3::new(10, 64, -20));
   465	        let shape = scan_shape(origin, |_| true, |_| &Block::SEA_LANTERN);
   466	        assert!(shape.contains(&origin.offset(Vector3::new(2, 0, 0))));
   467	        assert!(!shape.contains(&origin));
   468	    }
   469	}


   283	    /// `ConduitBlockEntity.updateAndAttackTarget`
   284	    async fn update_and_attack_target(&self, world: &Arc<World>, hunting: bool) {
   285	        let new_target = self.update_destroy_target(world, hunting).await;
   286	
   287	        if let Some(uuid) = new_target
   288	            && let Some(target) = world.get_entity_by_uuid(uuid)
   289	            && target.get_entity().is_alive()
   290	            && target
   291	                .get_living_entity()
   292	                .is_some_and(|living| living.health.load() > 0.0)
   293	        {
   294	            let pos = target.get_entity().pos.load();
   295	            world.play_sound(Sound::BlockConduitAttackTarget, SoundCategory::Blocks, &pos);
   296	            target.damage(&*target, 4.0, DamageType::MAGIC).await;
   297	        }
   298	
   299	        *self.destroy_target.lock().await = new_target;
   300	    }
   301	
   302	    /// `ConduitBlockEntity.updateDestroyTarget`
   303	    async fn update_destroy_target(&self, world: &Arc<World>, hunting: bool) -> Option<Uuid> {
   304	        if !hunting {
   305	            return None;
   306	        }
   307	
   308	        let current = *self.destroy_target.lock().await;
   309	        let Some(uuid) = current else {
   310	            return self.select_new_target(world).await;
   311	        };
   312	
   313	        let still_valid = world.get_entity_by_uuid(uuid).is_some_and(|target| {
   314	            target.get_entity().is_alive()
   315	                && target
   316	                    .get_living_entity()
   317	                    .is_some_and(|living| living.health.load() > 0.0)
   318	                && self
   319	                    .position
   320	                    .squared_distance(&target.get_entity().block_pos.load())
   321	                    < (KILL_RANGE * KILL_RANGE) as i32
   322	        });
   323	
   324	        still_valid.then_some(uuid)
   325	    }
   326	
   327	    /// `ConduitBlockEntity.selectNewTarget`. Vanilla filters candidates by the `Enemy`
   328	    /// marker interface; Pumpkin has no equivalent trait, so `MobCategory::MONSTER` is
   329	    /// used as the closest available proxy (it covers effectively all `Enemy`
   330	    /// implementors that can appear at all, at the cost of not matching a couple of
   331	    /// edge-case mobs whose category differs from their `Enemy` status upstream).
   332	    async fn select_new_target(&self, world: &Arc<World>) -> Option<Uuid> {
   333	        let bb = BoundingBox::from_block(&self.position).expand(KILL_RANGE, KILL_RANGE, KILL_RANGE);
   334	
   335	        let mut candidates = Vec::new();
   336	        for entity in world.get_entities_at_box(&bb) {
   337	            let Some(living) = entity.get_living_entity() else {
   338	                continue;
   339	            };
   340	            if entity.get_entity().entity_type.category.id != MobCategory::MONSTER.id {
   341	                continue;
   342	            }
   343	            if is_wet(living, world).await {
   344	                candidates.push(entity.get_entity().entity_uuid);
   345	            }
   346	        }
   347	
   348	        if candidates.is_empty() {
   349	            return None;
   350	        }
   351	        let idx = rand::rng().random_range(0..candidates.len());
   352	        Some(candidates[idx])
   353	    }
   354	}

   267	        // height < 2 short-circuits before the random draw.
   268	        assert!(pillar_allows_growth(1, 0));
   269	    }
   270	
   271	    #[test]
   272	    fn tall_pillars_grow_only_when_the_roll_reaches_their_height() {
   273	        // With bound 4 the draws are 0..=3, so a height-4 pillar never grows on
   274	        // stone but can on end stone, where the bound is 5. Matches
   275	        // ChorusFlowerBlock.java:89.
   276	        assert!(!pillar_allows_growth(4, 3));

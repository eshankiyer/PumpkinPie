    84	    fn handle_game_event<'a>(
    85	        &'a self,
    86	        world: &'a Arc<World>,
    87	        event: &'a GameEvent,
    88	        context: &'a GameEventContext,
    89	        source_position: Vector3<f64>,
    90	    ) -> GameEventFuture<'a> {
    91	        Box::pin(async move {
    92	            let (block, _) = world.get_block_and_state(&self.pos);
    93	            if block.id != BlockId::SCULK_SENSOR && block.id != BlockId::CALIBRATED_SCULK_SENSOR {
    94	                return false;
    95	            }
    96	
    97	            // SculkSensorBlockEntity.VibrationUser.canReceiveVibration: a block_destroy
    98	            // or block_place at the sensor's own position is ignored (the sensor's own
    99	            // placement/removal must not self-trigger it).
   100	            let event_pos = BlockPos::new(
   101	                source_position.x.floor() as i32,
   102	                source_position.y.floor() as i32,
   103	                source_position.z.floor() as i32,
   104	            );
   105	            if event_pos == self.pos
   106	                && matches!(event, GameEvent::BlockDestroy | GameEvent::BlockPlace)
   107	            {
   108	                return false;
   109	            }
   110	
   111	            let listener_pos = PositionSource::Block(self.pos)
   112	                .get_position(world)
   113	                .expect("block position source always resolves");
   114	            let distance = (listener_pos - source_position).length() as f32;
   115	            let power = redstone_strength_for_distance(distance, self.radius);
   116	            let frequency = crate::world::game_event::vibration_frequency(event);
   117	            // Vanilla `SculkSensorBlockEntity.VibrationUser.canReceiveVibration`
   118	            // (`SculkSensorBlockEntity.java:102-107`) rejects events with no vibration
   119	            // frequency before delegating to the sensor activation check.
   120	            if frequency == 0 {
   121	                return false;
   122	            }
   123	
   124	            let _ = context;
   125	            SculkSensorBlock::trigger(world, &self.pos, block, power, frequency).await;
   126	            true
   127	        })
   128	    }
   129	}

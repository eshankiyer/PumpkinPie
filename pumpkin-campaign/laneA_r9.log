    54	                        pos,
    55	                        pumpkin_data::Block::AIR.default_state.id,
    56	                        pumpkin_world::world::BlockFlags::NOTIFY_ALL,
    57	                    )
    58	                    .await;
    59	                return;
    60	            }
    61	        }
    62	    }
    63	}

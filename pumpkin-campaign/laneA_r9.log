   111	            if ds[k as usize * 4 + 3] <= 0.0 {
   112	                continue;
   113	            }
   114	            for m in (k + 1)..j {
   115	                if ds[m as usize * 4 + 3] <= 0.0 {
   116	                    continue;
   117	                }
   118	                let h_val = ds[k as usize * 4 + 3] - ds[m as usize * 4 + 3];
   119	                let d_val = ds[k as usize * 4] - ds[m as usize * 4];
   120	                let e_val = ds[k as usize * 4 + 1] - ds[m as usize * 4 + 1];
   121	                let g_val = ds[k as usize * 4 + 2] - ds[m as usize * 4 + 2];
   122	
   123	                if h_val * h_val > d_val * d_val + e_val * e_val + g_val * g_val {
   124	                    if h_val > 0.0 {
   125	                        ds[m as usize * 4 + 3] = -1.0;
   126	                        continue;
   127	                    }
   128	                    ds[k as usize * 4 + 3] = -1.0;
   129	                }
   130	            }
   131	        }
   132	
   133	        for m_idx in 0..j {
   134	            let d_val = ds[m_idx as usize * 4 + 3];
   135	            if d_val < 0.0 {
   136	                continue;
   137	            }
   138	            let e_val = ds[m_idx as usize * 4];
   139	            let g_val = ds[m_idx as usize * 4 + 1];
   140	            let h_val = ds[m_idx as usize * 4 + 2];
   141	
   142	            let n_bound = ((e_val - d_val).floor() as i32).max(x_bound);
   143	            let o_bound = ((g_val - d_val).floor() as i32).max(y_bound);
   144	            let p_bound = ((h_val - d_val).floor() as i32).max(z_bound);
   145	            let q_bound = ((e_val + d_val).floor() as i32).max(n_bound);
   146	            let r_bound = ((g_val + d_val).floor() as i32).max(o_bound);
   147	            let s_bound = ((h_val + d_val).floor() as i32).max(p_bound);
   148	
   149	            for t_val in n_bound..=q_bound {
   150	                let u_val = (t_val as f64 + 0.5 - e_val) / d_val;
   151	                if u_val * u_val >= 1.0 {
   152	                    continue;
   153	                }
   154	                for v_val in o_bound..=r_bound {
   155	                    let w_val = (v_val as f64 + 0.5 - g_val) / d_val;
   156	                    if u_val * u_val + w_val * w_val >= 1.0 {
   157	                        continue;
   158	                    }
   159	                    let base_idx = (t_val - x_bound) + (v_val - y_bound) * horizontal_size;
   160	
   161	                    for aa_val in p_bound..=s_bound {
   162	                        let ab_val = (aa_val as f64 + 0.5 - h_val) / d_val;
   163	                        if u_val * u_val + w_val * w_val + ab_val * ab_val >= 1.0 {
   164	                            continue;
   165	                        }
   166	                        if chunk.out_of_height(v_val as i16) {
   167	                            continue;
   168	                        }
   169	
   170	                        let ac = (base_idx + (aa_val - z_bound) * horizontal_size * vertical_size)
   171	                            as usize;
   172	
   173	                        if bit_set[ac] {
   174	                            continue;
   175	                        }
   176	                        bit_set[ac] = true;
   177	
   178	                        mutable_pos.0.x = t_val;
   179	                        mutable_pos.0.y = v_val;
   180	                        mutable_pos.0.z = aa_val;
   181	
   182	                        // if !world.is_valid_for_set_block(&mutable_pos) {
   183	                        //     continue;
   184	                        // }
   185	
   186	                        // let ad = t_val;
   187	                        // let ae = v_val;
   188	                        // let af = aa_val;
   189	                        // TODO: using a section would be faster
   190	
   191	                        let pos_vec = Vector3::new(t_val, v_val, aa_val);
   192	                        let block_state = GenerationCache::get_block_state(chunk, &pos_vec);
   193	
   194	                        for target in &self.targets {
   195	                            if Self::should_place(
   196	                                self.discard_chance_on_air_exposure,
   197	                                chunk,
   198	                                block_state,
   199	                                random,
   200	                                target,
   201	                                &mutable_pos,
   202	                            ) {
   203	                                chunk.set_block_state(&pos_vec, target.state);
   204	                                placed_blocks_count += 1;
   205	                                break; // Equivalent to 'continue block11;'
   206	                            }
   207	                        }
   208	                    }
   209	                }
   210	            }
   211	        }
   212	        placed_blocks_count > 0
   213	    }
   214	
   215	    pub fn should_place<T: GenerationCache>(
   216	        discard_chance: f32,
   217	        chunk: &T,
   218	        state: BlockStateId,
   219	        random: &mut RandomGenerator,
   220	        target: &OreTarget,
   221	        pos: &BlockPos,
   222	    ) -> bool {
   223	        if !target.target.test(state, random) {
   224	            return false;
   225	        }
   226	        if Self::should_not_discard(random, discard_chance) {
   227	            return true;
   228	        }
   229	        !Self::is_exposed_to_air(chunk, pos)
   230	    }

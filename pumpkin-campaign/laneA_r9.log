    43	/// The 42 offsets `updateShape` scans in the outer shell of the 5x5x5 cube around the
    44	/// conduit. Pure geometry, independent of any world state, so it is unit-testable in
    45	/// isolation.
    46	fn frame_offsets() -> Vec<(i32, i32, i32)> {
    47	    let mut offsets = Vec::with_capacity(MIN_KILL_SIZE);
    48	    for ox in -2i32..=2 {
    49	        for oy in -2i32..=2 {
    50	            for oz in -2i32..=2 {
    51	                let (ax, ay, az) = (ox.abs(), oy.abs(), oz.abs());
    52	                let outside_inner_cube = ax > 1 || ay > 1 || az > 1;
    53	                let on_an_axis_arm = (ox == 0 && (ay == 2 || az == 2))
    54	                    || (oy == 0 && (ax == 2 || az == 2))
    55	                    || (oz == 0 && (ax == 2 || ay == 2));
    56	                if outside_inner_cube && on_an_axis_arm {
    57	                    offsets.push((ox, oy, oz));
    58	                }
    59	            }
    60	        }
    61	    }
    62	    offsets
    63	}

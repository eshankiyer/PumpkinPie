   124	            } else if props.moisture > 0 {
   125	                let mut event = crate::plugin::block::moisture_change::MoistureChangeEvent {
   126	                    block_pos: *args.position,
   127	                    world: args.world.clone(),
   128	                    new_moisture: i32::from(props.moisture) - 1,
   129	                    cancelled: false,
   130	                };

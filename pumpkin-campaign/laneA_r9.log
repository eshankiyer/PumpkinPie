   108	fn wall_fan_with_facing(block: &'static Block, facing: BlockDirection) -> BlockStateId {
   109	    let mut props = CoralWallFanLikeProperties::default(block);
   110	    if let Some(horizontal) = facing.to_horizontal_facing() {
   111	        props.facing = horizontal;
   112	    }
   113	    props.waterlogged = true;
   114	    props.to_state_id(block)

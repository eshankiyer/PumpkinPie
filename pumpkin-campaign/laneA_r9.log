     1	package net.minecraft.world.entity.ai.gossip;
     2	
     3	import com.google.common.collect.Maps;
     4	import com.google.common.collect.Sets;
     5	import com.mojang.serialization.Codec;
     6	import com.mojang.serialization.codecs.RecordCodecBuilder;
     7	import it.unimi.dsi.fastutil.objects.Object2IntMap;
     8	import it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap;
     9	import it.unimi.dsi.fastutil.objects.ObjectIterator;
    10	import it.unimi.dsi.fastutil.objects.Object2IntMap.Entry;
    11	import java.util.Arrays;
    12	import java.util.Collection;
    13	import java.util.Collections;
    14	import java.util.HashMap;
    15	import java.util.Iterator;
    16	import java.util.List;
    17	import java.util.Map;
    18	import java.util.Set;
    19	import java.util.UUID;
    20	import java.util.function.DoublePredicate;
    21	import java.util.function.Predicate;
    22	import java.util.stream.Stream;
    23	import net.minecraft.core.UUIDUtil;
    24	import net.minecraft.util.ExtraCodecs;
    25	import net.minecraft.util.RandomSource;
    26	import net.minecraft.util.VisibleForDebug;
    27	
    28	public class GossipContainer {
    29	   public static final Codec<GossipContainer> CODEC = GossipContainer.GossipEntry.CODEC
    30	      .listOf()
    31	      .xmap(GossipContainer::new, container -> container.unpack().toList());
    32	   public static final int DISCARD_THRESHOLD = 2;
    33	   private final Map<UUID, GossipContainer.EntityGossips> gossips = new HashMap<>();
    34	
    35	   public GossipContainer() {
    36	   }
    37	
    38	   private GossipContainer(final List<GossipContainer.GossipEntry> entries) {
    39	      entries.forEach(e -> this.getOrCreate(e.target).entries.put(e.type, e.value));
    40	   }
    41	
    42	   @VisibleForDebug
    43	   public Map<UUID, Object2IntMap<GossipType>> getGossipEntries() {
    44	      Map<UUID, Object2IntMap<GossipType>> result = Maps.newHashMap();
    45	      this.gossips.keySet().forEach(uuid -> {
    46	         GossipContainer.EntityGossips entityGossips = this.gossips.get(uuid);
    47	         result.put(uuid, entityGossips.entries);
    48	      });
    49	      return result;
    50	   }
    51	
    52	   public void decay() {
    53	      Iterator<GossipContainer.EntityGossips> iterator = this.gossips.values().iterator();
    54	
    55	      while (iterator.hasNext()) {
    56	         GossipContainer.EntityGossips entityGossips = iterator.next();
    57	         entityGossips.decay();
    58	         if (entityGossips.isEmpty()) {
    59	            iterator.remove();
    60	         }
    61	      }
    62	   }
    63	
    64	   private Stream<GossipContainer.GossipEntry> unpack() {
    65	      return this.gossips.entrySet().stream().flatMap(e -> e.getValue().unpack(e.getKey()));
    66	   }
    67	
    68	   private Collection<GossipContainer.GossipEntry> selectGossipsForTransfer(final RandomSource random, final int maxCount) {
    69	      List<GossipContainer.GossipEntry> entries = this.unpack().toList();
    70	      if (entries.isEmpty()) {
    71	         return Collections.emptyList();
    72	      }
    73	
    74	      int[] ranges = new int[entries.size()];
    75	      int rangesEnd = 0;
    76	
    77	      for (int i = 0; i < entries.size(); i++) {
    78	         GossipContainer.GossipEntry gossip = entries.get(i);
    79	         rangesEnd += Math.abs(gossip.weightedValue());
    80	         ranges[i] = rangesEnd - 1;
    81	      }
    82	
    83	      Set<GossipContainer.GossipEntry> results = Sets.newIdentityHashSet();
    84	
    85	      for (int i = 0; i < maxCount; i++) {
    86	         int choice = random.nextInt(rangesEnd);
    87	         int selectedIndex = Arrays.binarySearch(ranges, choice);
    88	         results.add(entries.get(selectedIndex < 0 ? -selectedIndex - 1 : selectedIndex));
    89	      }
    90	
    91	      return results;
    92	   }
    93	
    94	   private GossipContainer.EntityGossips getOrCreate(final UUID target) {
    95	      return this.gossips.computeIfAbsent(target, uuid -> new GossipContainer.EntityGossips());
    96	   }
    97	
    98	   public void transferFrom(final GossipContainer source, final RandomSource random, final int maxCount) {
    99	      Collection<GossipContainer.GossipEntry> newGossips = source.selectGossipsForTransfer(random, maxCount);
   100	      newGossips.forEach(newGossip -> {
   101	         int decayedValue = newGossip.value - newGossip.type.decayPerTransfer;
   102	         if (decayedValue >= 2) {
   103	            this.getOrCreate(newGossip.target).entries.mergeInt(newGossip.type, decayedValue, GossipContainer::mergeValuesForTransfer);
   104	         }
   105	      });
   106	   }
   107	
   108	   public int getReputation(final UUID entity, final Predicate<GossipType> types) {
   109	      GossipContainer.EntityGossips entry = this.gossips.get(entity);
   110	      return entry != null ? entry.weightedValue(types) : 0;
   111	   }
   112	
   113	   public long getCountForType(final GossipType type, final DoublePredicate valueTest) {
   114	      return this.gossips.values().stream().filter(e -> valueTest.test(e.entries.getOrDefault(type, 0) * type.weight)).count();
   115	   }
   116	
   117	   public void add(final UUID target, final GossipType type, final int amountToAdd) {
   118	      GossipContainer.EntityGossips entityGossips = this.getOrCreate(target);
   119	      entityGossips.entries.mergeInt(type, amountToAdd, (o, n) -> this.mergeValuesForAddition(type, o, n));
   120	      entityGossips.makeSureValueIsntTooLowOrTooHigh(type);
   121	      if (entityGossips.isEmpty()) {
   122	         this.gossips.remove(target);
   123	      }
   124	   }
   125	
   126	   public void remove(final UUID target, final GossipType type, final int amountToRemove) {
   127	      this.add(target, type, -amountToRemove);

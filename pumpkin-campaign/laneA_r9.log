    46	/// Returns `true` if all four horizontal neighbors of `pos` are air,
    47	/// optionally ignoring one direction (`ignore`).
    48	fn all_neighbors_empty<T: GenerationCache>(
    49	    chunk: &T,
    50	    pos: &BlockPos,
    51	    ignore: Option<HorizontalFacing>,
    52	) -> bool {
    53	    for dir in BlockDirection::horizontal() {
    54	        if Some(dir) == ignore {
    55	            continue;
    56	        }
    57	        if !chunk.is_air(&pos.offset(dir.to_offset()).0) {
    58	            return false;
    59	        }
    60	    }
    61	    true
    62	}
    63	
    64	/// Computes chorus-plant connection state at `pos` and writes it to the chunk.
    65	fn set_chorus_plant<T: GenerationCache>(chunk: &mut T, pos: &BlockPos) {
    66	    let down_id = GenerationCache::get_block_state(chunk, &pos.down().0).to_block_id();
    67	    let up_id = GenerationCache::get_block_state(chunk, &pos.up().0).to_block_id();
    68	    let north_id =
    69	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::North.to_offset()).0)
    70	            .to_block_id();
    71	    let east_id =
    72	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::East.to_offset()).0)
    73	            .to_block_id();
    74	    let south_id =
    75	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::South.to_offset()).0)
    76	            .to_block_id();
    77	    let west_id =
    78	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::West.to_offset()).0)
    79	            .to_block_id();
    80	
    81	    let plant_id = Block::CHORUS_PLANT.id;
    82	    let flower_id = Block::CHORUS_FLOWER.id;
    83	    let supports = tag::Block::MINECRAFT_SUPPORTS_CHORUS_PLANT;
    84	
    85	    let props = BrownMushroomBlockLikeProperties {
    86	        down: down_id == plant_id || down_id == flower_id || down_id.has_tag(supports),
    87	        up: up_id == plant_id || up_id == flower_id,
    88	        north: north_id == plant_id || north_id == flower_id,
    89	        east: east_id == plant_id || east_id == flower_id,
    90	        south: south_id == plant_id || south_id == flower_id,
    91	        west: west_id == plant_id || west_id == flower_id,
    92	    };
    93	
    94	    let state_id = props.to_state_id(&Block::CHORUS_PLANT);
    95	    chunk.set_block_state(&pos.0, pumpkin_data::BlockState::from_id(state_id));
    96	}

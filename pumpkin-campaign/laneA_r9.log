   205	                    pumpkin_data::tracked_data::fireball::ITEM_STACK,
   206	                    &ItemStackSerializer::from(stack.clone()),
   207	                )],
   208	                None,
   209	            );
   210	        })
   211	    }
   212	
   213	    fn tick<'a>(
   214	        &'a self,
   215	        caller: &'a Arc<dyn EntityBase>,
   216	        server: &'a Server,
   217	    ) -> EntityBaseFuture<'a, ()> {
   218	        Box::pin(async move {
   219	            let entity = self.get_entity();
   220	            let mut velocity = entity.velocity.load();
   221	
   222	            let inertia = if entity.touching_water.load(Ordering::Relaxed) {
   223	                WATER_INERTIA
   224	            } else {
   225	                AIR_INERTIA
   226	            };
   227	
   228	            let accel = self.get_acceleration_power();
   229	            let speed = velocity.length();
   230	            if speed > 1e-6 {
   231	                let norm = velocity.normalize();
   232	                velocity = norm
   233	                    .multiply(accel, accel, accel)
   234	                    .add(&velocity)
   235	                    .multiply(inertia, inertia, inertia);
   236	                entity.velocity.store(velocity);
   237	            }
   238	
   239	            self.thrown.process_tick(caller, server).await;
   240	        })
   241	    }
   242	
   243	    fn get_entity(&self) -> &Entity {
   244	        self.thrown.get_entity()
   245	    }
   246	
   247	    fn get_living_entity(&self) -> Option<&crate::entity::living::LivingEntity> {
   248	        None
   249	    }
   250	
   251	    fn as_nbt_storage(&self) -> &dyn NBTStorage {
   252	        self
   253	    }
   254	
   255	    fn cast_any(&self) -> &dyn std::any::Any {
   256	        self
   257	    }
   258	
   259	    fn on_hit(&self, hit: ProjectileHit) -> EntityBaseFuture<'_, ()> {
   260	        Box::pin(async move {
   261	            let world = self.get_entity().world.load();
   262	
   263	            if let ProjectileHit::Entity { ref entity, .. } = hit {
   264	                // `LargeFireball.onHitEntity` (`LargeFireball.java:42-51`) only deals 6.0
   265	                // fireball damage; the 5-second ignite belongs to `SmallFireball`
   266	                // (`SmallFireball.java:40`), not to the ghast fireball.
   267	                let _ = entity
   268	                    .damage(self, 6.0, pumpkin_data::damage::DamageType::FIREBALL)
   269	                    .await;
   270	            }
   271	
   272	            let hit_pos = hit.hit_pos();
   273	            // `Fireball.onHit`: fire is placed only when mob griefing is on, which
   274	            // `ExplosionInteraction::Mob` already resolves to a block-preserving blast.
   275	            world
   276	                .explode_with_fire(
   277	                    hit_pos,
   278	                    self.get_explosion_power(),
   279	                    crate::world::ExplosionInteraction::Mob,
   280	                )
   281	                .await;
   282	        })
   283	    }
   284	}

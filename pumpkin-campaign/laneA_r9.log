    16	pub struct FallenTreeFeature {
    17	    pub trunk_provider: BlockStateProvider,
    18	    pub log_length: IntProvider,
    19	    pub stump_decorators: Vec<TreeDecorator>,
    20	    pub log_decorators: Vec<TreeDecorator>,
    21	}
    22	
    23	impl FallenTreeFeature {
    24	    #[expect(clippy::too_many_arguments)]
    25	    pub fn generate<T: GenerationCache>(
    26	        &self,
    27	        chunk: &mut T,
    28	        block_registry: &dyn WorldPortalExt,
    29	        min_y: i8,
    30	        height: u16,
    31	        feature: pumpkin_data::placed_feature::PlacedFeature,
    32	        random: &mut RandomGenerator,
    33	        origin: BlockPos,
    34	    ) -> bool {
    35	        let stump = self.place_log_block(chunk, block_registry, random, origin, None);
    36	        Self::decorate(
    37	            chunk,
    38	            block_registry,
    39	            min_y,
    40	            height,
    41	            feature,
    42	            random,
    43	            &[stump],
    44	            &self.stump_decorators,
    45	        );
    46	
    47	        let direction = match random.next_bounded_i32(4) {
    48	            0 => BlockDirection::North,
    49	            1 => BlockDirection::East,
    50	            2 => BlockDirection::South,
    51	            _ => BlockDirection::West,
    52	        };
    53	        let log_length = self.log_length.get(random) - 2;
    54	        let mut log_start =
    55	            origin.offset_dir(direction.to_offset(), 2 + random.next_bounded_i32(2));
    56	        Self::set_ground_height_for_log_start(chunk, &mut log_start);
    57	
    58	        if Self::can_place_entire_log(chunk, log_length, &mut log_start, direction) {
    59	            let mut logs = Vec::with_capacity(log_length.max(0) as usize);
    60	            for _ in 0..log_length {
    61	                logs.push(self.place_log_block(
    62	                    chunk,
    63	                    block_registry,
    64	                    random,
    65	                    log_start,
    66	                    Some(direction),
    67	                ));
    68	                log_start = log_start.offset(direction.to_offset());
    69	            }
    70	            Self::decorate(
    71	                chunk,
    72	                block_registry,
    73	                min_y,
    74	                height,
    75	                feature,
    76	                random,
    77	                &logs,
    78	                &self.log_decorators,
    79	            );
    80	        }
    81	
    82	        true
    83	    }
    84	
    85	    fn set_ground_height_for_log_start<T: GenerationCache>(chunk: &T, log_start: &mut BlockPos) {
    86	        *log_start = log_start.up();
    87	        for _ in 0..6 {
    88	            if Self::may_place_on(chunk, *log_start) {
    89	                return;
    90	            }
    91	            *log_start = log_start.down();
    92	        }
    93	    }
    94	
    95	    fn can_place_entire_log<T: GenerationCache>(
    96	        chunk: &T,
    97	        log_length: i32,
    98	        log_start: &mut BlockPos,
    99	        direction: BlockDirection,
   100	    ) -> bool {
   101	        let mut gap_in_ground = 0;
   102	        for _ in 0..log_length {
   103	            if !Self::valid_tree_pos(chunk, *log_start) {
   104	                return false;
   105	            }
   106	            if Self::is_over_solid_ground(chunk, *log_start) {
   107	                gap_in_ground = 0;
   108	            } else {
   109	                gap_in_ground += 1;
   110	                if gap_in_ground > 2 {
   111	                    return false;
   112	                }
   113	            }
   114	            *log_start = log_start.offset(direction.to_offset());
   115	        }
   116	        *log_start = log_start.offset_dir(direction.to_offset(), -log_length);
   117	        true
   118	    }
   119	
   120	    fn may_place_on<T: GenerationCache>(chunk: &T, pos: BlockPos) -> bool {
   121	        Self::valid_tree_pos(chunk, pos) && Self::is_over_solid_ground(chunk, pos)
   122	    }
   123	
   124	    fn is_over_solid_ground<T: GenerationCache>(chunk: &T, pos: BlockPos) -> bool {
   125	        GenerationCache::get_block_state(chunk, &pos.down().0)
   126	            .to_state()
   127	            .is_side_solid(BlockDirection::Up)
   128	    }
   129	
   130	    fn valid_tree_pos<T: GenerationCache>(chunk: &T, pos: BlockPos) -> bool {
   131	        let state = GenerationCache::get_block_state(chunk, &pos.0);
   132	        TreeFeature::can_replace(state.to_state(), state.to_block_id())
   133	    }
   134	
   135	    fn place_log_block<T: GenerationCache>(
   136	        &self,
   137	        chunk: &mut T,
   138	        block_registry: &dyn WorldPortalExt,
   139	        random: &mut RandomGenerator,
   140	        pos: BlockPos,
   141	        direction: Option<BlockDirection>,
   142	    ) -> BlockPos {
   143	        let state = self.trunk_provider.get(random, pos, chunk, block_registry);
   144	        let state = direction.map_or(state, |direction| Self::sideways_state(state, direction));
   145	        chunk.set_block_state(&pos.0, state);
   146	        pos
   147	    }
   148	
   149	    fn sideways_state(
   150	        state: &'static BlockState,
   151	        direction: BlockDirection,
   152	    ) -> &'static BlockState {
   153	        let block = Block::from_state_id(state.id);
   154	        let Some(original) = block.properties(state.id) else {
   155	            return state;
   156	        };
   157	        let axis = match direction.to_axis() {
   158	            Axis::X => "x",
   159	            Axis::Y => "y",
   160	            Axis::Z => "z",
   161	        };
   162	        let mut properties = original.to_props();
   163	        if let Some(index) = properties.iter().position(|(name, _)| *name == "axis") {
   164	            properties[index] = ("axis", axis);
   165	        }
   166	        BlockState::from_id(block.from_properties(&properties).to_state_id(block))
   167	    }
   168	
   169	    #[expect(clippy::too_many_arguments)]
   170	    fn decorate<T: GenerationCache>(
   171	        chunk: &mut T,
   172	        block_registry: &dyn WorldPortalExt,
   173	        min_y: i8,
   174	        height: u16,
   175	        feature: pumpkin_data::placed_feature::PlacedFeature,
   176	        random: &mut RandomGenerator,
   177	        logs: &[BlockPos],
   178	        decorators: &[TreeDecorator],
   179	    ) {
   180	        for decorator in decorators {
   181	            decorator.generate(
   182	                chunk,
   183	                block_registry,
   184	                min_y,
   185	                height,
   186	                feature,
   187	                random,

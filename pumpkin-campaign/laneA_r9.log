    36	/// `minecraft:ominous_item_spawner`.
    37	///
    38	/// The invisible entity an ominous trial spawner uses to hand out its reward: it
    39	/// hovers holding the pending stack, plays
    40	/// `TRIAL_SPAWNER_ABOUT_TO_SPAWN_ITEM` 36 ticks before the drop, then drops the
    41	/// item and removes itself (`OminousItemSpawner.java:53-63`).
    42	///
    43	/// It extends plain `Entity`, not a mob, and sets `noPhysics = true`
    44	/// (`OminousItemSpawner.java:32-35`).
    45	pub struct OminousItemSpawnerEntity {
    46	    pub entity: Entity,
    47	    /// `DATA_ITEM` (`OminousItemSpawner.java:28`), NBT `item`.
    48	    item: Mutex<ItemStack>,
    49	    /// Vanilla `Entity.tickCount`, incremented by `super.tick()` before
    50	    /// `tickServer` reads it. Transient: vanilla never saves it either.
    51	    tick_count: AtomicI64,
    52	    /// `OminousItemSpawner.spawnItemAfterTicks` (`:30`), NBT
    53	    /// `spawn_item_after_ticks`.
    54	    spawn_item_after_ticks: AtomicI64,
    55	}
    56	
    57	impl OminousItemSpawnerEntity {
    58	    /// The plain constructor (`OminousItemSpawner.java:32-35`): no item, delay 0.
    59	    /// A restored entity gets both from NBT.
    60	    pub fn new(entity: Entity) -> Arc<Self> {
    61	        Self::new_with(entity, ItemStack::EMPTY.clone(), 0)
    62	    }
    63	
    64	    /// `OminousItemSpawner.create` (`OminousItemSpawner.java:37-42`): rolls the
    65	    /// delay and stores the stack to be handed out.
    66	    pub fn create(entity: Entity, item: ItemStack) -> Arc<Self> {
    67	        Self::new_with(entity, item, Self::random_spawn_delay())
    68	    }
    69	
    70	    fn new_with(entity: Entity, item: ItemStack, spawn_item_after_ticks: i64) -> Arc<Self> {
    71	        // `this.noPhysics = true` (`OminousItemSpawner.java:34`).
    72	        entity.no_clip.store(true, Relaxed);
    73	        Arc::new(Self {
    74	            entity,
    75	            item: Mutex::new(item),
    76	            tick_count: AtomicI64::new(0),
    77	            spawn_item_after_ticks: AtomicI64::new(spawn_item_after_ticks),
    78	        })
    79	    }
    80	
    81	    /// `level.getRandom().nextIntBetweenInclusive(60, 120)`
    82	    /// (`OminousItemSpawner.java:39`) -- inclusive at BOTH ends, 61 possible
    83	    /// values.
    84	    fn random_spawn_delay() -> i64 {
    85	        rng().random_range(SPAWN_ITEM_DELAY_MIN..=SPAWN_ITEM_DELAY_MAX)
    86	    }
    87	
    88	    /// The tick on which `TRIAL_SPAWNER_ABOUT_TO_SPAWN_ITEM` plays:
    89	    /// `this.tickCount == this.spawnItemAfterTicks - 36L`
    90	    /// (`OminousItemSpawner.java:54`).
    91	    const fn about_to_spawn_sound_tick(spawn_item_after_ticks: i64) -> i64 {
    92	        spawn_item_after_ticks - TICKS_BEFORE_ABOUT_TO_SPAWN_SOUND
    93	    }

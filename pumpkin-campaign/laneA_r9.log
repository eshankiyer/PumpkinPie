   110	    /// `OminousItemSpawner.readAdditionalSaveData` (`:114-118`). A missing delay
   111	    /// reads back as 0 (`getLongOr(..., 0L)`), which makes the spawner fire on
   112	    /// its very first tick -- that is vanilla's behaviour, not an oversight.
   113	    fn read_spawner_nbt(nbt: &NbtCompound) -> (ItemStack, i64) {
   114	        let item = nbt
   115	            .get_compound(TAG_ITEM)

   168	/// Vanilla `SculkSensorBlock.RESONANCE_PITCH_BEND` (`SculkSensorBlock.java:53-59`).
   169	///
   170	/// `NoteBlock.getPitchFromNote(toneMap[frequency])`, where
   171	/// `getPitchFromNote(note) = 2^((note - 12) / 12)` (`NoteBlock.java:143-145`).
   172	#[must_use]
   173	pub fn resonance_pitch_bend(frequency: i32) -> f32 {
   174	    const TONE_MAP: [i32; 16] = [0, 0, 2, 4, 6, 7, 9, 10, 12, 14, 15, 18, 19, 21, 22, 24];
   175	    let index = frequency.clamp(0, 15) as usize;
   176	    f32::powf(2.0, (TONE_MAP[index] - 12) as f32 / 12.0)
   177	}

    91	impl DaylightDetectorBlock {
    92	    async fn update_inverted(
    93	        &self,
    94	        props: DaylightDetectorProperties,
    95	        world: &Arc<World>,
    96	        block_pos: &BlockPos,
    97	        block: &Block,
    98	    ) -> BlockStateId {
    99	        let mut props = props;
   100	        props.inverted = !props.inverted;
   101	
   102	        let state = props.to_state_id(block);
   103	
   104	        world
   105	            .set_block_state(block_pos, state, BlockFlags::NOTIFY_LISTENERS)
   106	            .await;

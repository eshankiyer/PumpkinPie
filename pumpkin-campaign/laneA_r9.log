   102	      return new DaylightDetectorBlockEntity(worldPosition, blockState);
   103	   }
   104	
   105	   @Override
   106	   public <T extends BlockEntity> @Nullable BlockEntityTicker<T> getTicker(final Level level, final BlockState blockState, final BlockEntityType<T> type) {
   107	      return !level.isClientSide() && level.dimensionType().hasSkyLight()
   108	         ? createTickerHelper(type, BlockEntityTypes.DAYLIGHT_DETECTOR, DaylightDetectorBlock::tickEntity)
   109	         : null;

   109	    current: &BlockPos,
   110	    start_pos: &BlockPos,
   111	    max_horizontal_spread: i32,
   112	    depth: i32,
   113	) {
   114	    let mut height = random.next_bounded_i32(4) + 1;
   115	    if depth == 0 {
   116	        height += 1;
   117	    }
   118	
   119	    // Grow vertically: place chorus plant for `height` blocks above current
   120	    for i in 0..height {
   121	        let target = current.up_height(i + 1);
   122	        if !all_neighbors_empty(chunk, &target, None) {
   123	            return;
   124	        }
   125	        set_chorus_plant(chunk, &target);
   126	        // Re-bake the block below so it gains the UP connection
   127	        set_chorus_plant(chunk, &target.down());
   128	    }
   129	
   130	    let top = current.up_height(height);
   131	    let mut placed_stem = false;
   132	
   133	    if depth < 4 {
   134	        let mut stems = random.next_bounded_i32(4);
   135	        if depth == 0 {
   136	            stems += 1;
   137	        }
   138	
   139	        for _ in 0..stems {
   140	            // Pick a random horizontal direction
   141	            let dir = BlockDirection::random_horizontal(random);
   142	            let target = top.offset(dir.to_offset());
   143	            let target_below = target.down();
   144	
   145	            let dx = (target.0.x - start_pos.0.x).abs();
   146	            let dz = (target.0.z - start_pos.0.z).abs();
   147	
   148	            if dx < max_horizontal_spread
   149	                && dz < max_horizontal_spread
   150	                && chunk.is_air(&target.0)
   151	                && chunk.is_air(&target_below.0)
   152	                && all_neighbors_empty(chunk, &target, Some(dir.opposite()))
   153	            {
   154	                placed_stem = true;
   155	                set_chorus_plant(chunk, &target);
   156	                // Re-bake the stem apex so it gains the connection face toward the new branch.
   157	                set_chorus_plant(chunk, &top);
   158	                grow_tree_recursive(
   159	                    chunk,
   160	                    random,
   161	                    &target,
   162	                    start_pos,
   163	                    max_horizontal_spread,
   164	                    depth + 1,
   165	                );
   166	            }
   167	        }
   168	    }
   169	
   170	    if !placed_stem {
   171	        // Cap the stem with a dead chorus flower
   172	        place_dead_flower(chunk, &top);
   173	    }
   174	}


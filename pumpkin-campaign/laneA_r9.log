   493	    ) {
   494	        neighbor_props.r#type = ChestType::Single;
   495	        let neighbor_pos = args.position.offset(connected_towards.to_offset());
   496	        let neighbor_block = args.world.get_block(&neighbor_pos);
   497	
   498	        args.world
   499	            .set_block_state(
   500	                &neighbor_pos,
   501	                neighbor_props.to_state_id(neighbor_block),
   502	                BlockFlags::NOTIFY_LISTENERS,
   503	            )
   504	            .await;
   505	    }
   506	}

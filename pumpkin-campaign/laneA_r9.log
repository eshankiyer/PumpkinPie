   234	            float dx = -0.5F + random.nextFloat() + delta.getX();
   235	            float dy = -2.0F + random.nextFloat() + delta.getY();
   236	            float dz = -0.5F + random.nextFloat() + delta.getZ();
   237	            level.addParticle(ParticleTypes.NAUTILUS, particleEnd.x, particleEnd.y, particleEnd.z, dx, dy, dz);
   238	         }
   239	      }
   240	
   241	      if (destroyTarget != null) {
   242	         Vec3 targetPosition = new Vec3(destroyTarget.getX(), destroyTarget.getEyeY(), destroyTarget.getZ());
   243	         float randx = (-0.5F + random.nextFloat()) * (3.0F + destroyTarget.getBbWidth());
   244	         float randy = -1.0F + random.nextFloat() * destroyTarget.getBbHeight();

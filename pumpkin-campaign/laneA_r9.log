    79	   @Override
    80	   protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
    81	      builder.add(FACING, HAS_EYE);
    82	   }
    83	
    84	   public static BlockPattern getOrCreatePortalShape() {
    85	      if (portalShape == null) {
    86	         portalShape = BlockPatternBuilder.start()
    87	            .aisle("?vvv?", ">???<", ">???<", ">???<", "?^^^?")
    88	            .where('?', BlockInWorld.hasState(BlockStatePredicate.ANY))
    89	            .where(
    90	               '^',
    91	               BlockInWorld.hasState(
    92	                  BlockStatePredicate.forBlock(Blocks.END_PORTAL_FRAME)
    93	                     .where(HAS_EYE, Predicates.equalTo(true))
    94	                     .where(FACING, Predicates.equalTo(Direction.SOUTH))
    95	               )
    96	            )
    97	            .where(
    98	               '>',
    99	               BlockInWorld.hasState(
   100	                  BlockStatePredicate.forBlock(Blocks.END_PORTAL_FRAME)
   101	                     .where(HAS_EYE, Predicates.equalTo(true))
   102	                     .where(FACING, Predicates.equalTo(Direction.WEST))
   103	               )
   104	            )
   105	            .where(
   106	               'v',
   107	               BlockInWorld.hasState(
   108	                  BlockStatePredicate.forBlock(Blocks.END_PORTAL_FRAME)
   109	                     .where(HAS_EYE, Predicates.equalTo(true))
   110	                     .where(FACING, Predicates.equalTo(Direction.NORTH))
   111	               )
   112	            )
   113	            .where(
   114	               '<',
   115	               BlockInWorld.hasState(
   116	                  BlockStatePredicate.forBlock(Blocks.END_PORTAL_FRAME)
   117	                     .where(HAS_EYE, Predicates.equalTo(true))
   118	                     .where(FACING, Predicates.equalTo(Direction.EAST))
   119	               )
   120	            )
   121	            .build();
   122	      }
   123	
   124	      return portalShape;
   125	   }
   126	
   127	   @Override
   128	   protected boolean isPathfindable(final BlockState state, final PathComputationType type) {
   129	      return false;
   130	   }
   131	}

   102	fn is_water_source(world: &Arc<World>, pos: &BlockPos) -> bool {
   103	    let state_id = world.get_block_state_id(pos);
   104	    Block::from_state_id(state_id).id == Block::WATER.id
   105	        && state_id == Block::WATER.default_state.id
   106	}

    10	pub struct LakeFeature {
    11	    pub fluid: BlockStateProvider,
    12	    pub barrier: BlockStateProvider,
    13	}
    14	
    15	impl LakeFeature {
    16	    #[expect(clippy::too_many_lines)]
    17	    pub fn generate<T: GenerationCache>(
    18	        &self,
    19	        block_registry: &dyn WorldPortalExt,
    20	        chunk: &mut T,
    21	        random: &mut RandomGenerator,
    22	        pos: BlockPos,
    23	    ) -> bool {
    24	        if pos.0.y <= chunk.bottom_y() as i32 + 4 {
    25	            return false;
    26	        }
    27	
    28	        let origin = pos.add(-8, -4, -8);
    29	        let mut grid = [false; 2048];
    30	        let spots = random.next_bounded_i32(4) + 4;
    31	
    32	        for _ in 0..spots {
    33	            let xr = random.next_f64() * 6.0 + 3.0;
    34	            let yr = random.next_f64() * 4.0 + 2.0;
    35	            let zr = random.next_f64() * 6.0 + 3.0;
    36	            let xp = random.next_f64() * (16.0 - xr - 2.0) + 1.0 + xr / 2.0;
    37	            let yp = random.next_f64() * (8.0 - yr - 4.0) + 2.0 + yr / 2.0;
    38	            let zp = random.next_f64() * (16.0 - zr - 2.0) + 1.0 + zr / 2.0;
    39	
    40	            for xx in 1..15 {
    41	                for zz in 1..15 {
    42	                    for yy in 1..7 {
    43	                        let xd = (xx as f64 - xp) / (xr / 2.0);
    44	                        let yd = (yy as f64 - yp) / (yr / 2.0);
    45	                        let zd = (zz as f64 - zp) / (zr / 2.0);
    46	                        let d = xd * xd + yd * yd + zd * zd;
    47	                        if d < 1.0 {
    48	                            grid[(xx * 16 + zz) * 8 + yy] = true;
    49	                        }
    50	                    }
    51	                }
    52	            }
    53	        }
    54	
    55	        let fluid_state = self
    56	            .fluid
    57	            .get_with_context(block_registry, chunk, random, origin);
    58	
    59	        for xx in 0..16 {
    60	            for zz in 0..16 {
    61	                for yyx in 0..8 {
    62	                    let check = !grid[(xx * 16 + zz) * 8 + yyx]
    63	                        && (xx < 15 && grid[((xx + 1) * 16 + zz) * 8 + yyx]
    64	                            || xx > 0 && grid[((xx - 1) * 16 + zz) * 8 + yyx]
    65	                            || zz < 15 && grid[(xx * 16 + zz + 1) * 8 + yyx]
    66	                            || zz > 0 && grid[(xx * 16 + (zz - 1)) * 8 + yyx]
    67	                            || yyx < 7 && grid[(xx * 16 + zz) * 8 + yyx + 1]
    68	                            || yyx > 0 && grid[(xx * 16 + zz) * 8 + (yyx - 1)]);
    69	
    70	                    if check {
    71	                        let check_pos = origin.add(xx as i32, yyx as i32, zz as i32);
    72	                        let block_state =
    73	                            GenerationCache::get_block_state(chunk, &check_pos.0).to_state();
    74	
    75	                        if yyx >= 4 && block_state.is_liquid() {
    76	                            return false;
    77	                        }
    78	
    79	                        if yyx < 4 && !block_state.is_solid() && block_state != fluid_state {
    80	                            return false;
    81	                        }
    82	                    }
    83	                }
    84	            }
    85	        }
    86	
    87	        let air_state = Block::CAVE_AIR.default_state;
    88	
    89	        for xx in 0..16 {
    90	            for zz in 0..16 {
    91	                for yyx in 0..8 {
    92	                    if grid[(xx * 16 + zz) * 8 + yyx] {
    93	                        let place_pos = origin.add(xx as i32, yyx as i32, zz as i32);
    94	                        let current_state =
    95	                            GenerationCache::get_block_state(chunk, &place_pos.0).to_state();
    96	                        if Self::can_replace_block(current_state) {
    97	                            let place_air = yyx >= 4;
    98	                            chunk.set_block_state(
    99	                                &place_pos.0,
   100	                                if place_air { air_state } else { fluid_state },
   101	                            );
   102	                        }
   103	                    }
   104	                }
   105	            }
   106	        }
   107	
   108	        let barrier_state = self
   109	            .barrier
   110	            .get_with_context(block_registry, chunk, random, origin);
   111	        if !barrier_state.is_air() {
   112	            for xx in 0..16 {
   113	                for zz in 0..16 {
   114	                    for yyx in 0..8 {
   115	                        let check = !grid[(xx * 16 + zz) * 8 + yyx]
   116	                            && (xx < 15 && grid[((xx + 1) * 16 + zz) * 8 + yyx]
   117	                                || xx > 0 && grid[((xx - 1) * 16 + zz) * 8 + yyx]
   118	                                || zz < 15 && grid[(xx * 16 + zz + 1) * 8 + yyx]
   119	                                || zz > 0 && grid[(xx * 16 + (zz - 1)) * 8 + yyx]
   120	                                || yyx < 7 && grid[(xx * 16 + zz) * 8 + yyx + 1]
   121	                                || yyx > 0 && grid[(xx * 16 + zz) * 8 + (yyx - 1)]);
   122	
   123	                        if check && (yyx < 4 || random.next_bounded_i32(2) != 0) {
   124	                            let barrier_pos = origin.add(xx as i32, yyx as i32, zz as i32);
   125	                            let block_state =
   126	                                GenerationCache::get_block_state(chunk, &barrier_pos.0).to_state();
   127	                            if block_state.is_solid()
   128	                                && !block_state
   129	                                    .id
   130	                                    .to_block_id()
   131	                                    .has_tag(tag::Block::MINECRAFT_LAVA_POOL_STONE_CANNOT_REPLACE)
   132	                            {
   133	                                chunk.set_block_state(&barrier_pos.0, barrier_state);
   134	                            }
   135	                        }
   136	                    }
   137	                }
   138	            }
   139	        }
   140	
   141	        // Freeze top layer
   142	        if Block::from_state_id(fluid_state.id).id == Block::WATER.id {
   143	            for xx in 0..16 {
   144	                for zz in 0..16 {
   145	                    let freeze_pos = origin.add(xx, 4, zz);
   146	                    let biome = chunk.get_biome_for_terrain_gen(
   147	                        freeze_pos.0.x,
   148	                        freeze_pos.0.y,
   149	                        freeze_pos.0.z,
   150	                    );
   151	                    if biome.weather.compute_temperature(
   152	                        freeze_pos.0.x as f64,
   153	                        freeze_pos.0.y,
   154	                        freeze_pos.0.z as f64,
   155	                        63,
   156	                    ) < 0.15
   157	                    {
   158	                        let current_state =
   159	                            GenerationCache::get_block_state(chunk, &freeze_pos.0).to_state();
   160	                        if Self::can_replace_block(current_state) {
   161	                            chunk.set_block_state(&freeze_pos.0, Block::ICE.default_state);
   162	                        }
   163	                    }
   164	                }
   165	            }
   166	        }
   167	
   168	        true
   169	    }
   170	
   171	    fn can_replace_block(state: &BlockState) -> bool {
   172	        !state
   173	            .id
   174	            .to_block_id()
   175	            .has_tag(tag::Block::MINECRAFT_FEATURES_CANNOT_REPLACE)
   176	    }
   177	}

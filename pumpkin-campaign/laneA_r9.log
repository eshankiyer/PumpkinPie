#[derive(Clone, Debug)]
pub enum CustomScoreboard {
    Java(Scoreboard),
    Bedrock(BedrockScoreboard),
}

impl From<Scoreboard> for CustomScoreboard {
    fn from(sb: Scoreboard) -> Self {
        Self::Java(sb)
    }
}

impl From<BedrockScoreboard> for CustomScoreboard {
    fn from(sb: BedrockScoreboard) -> Self {
        Self::Bedrock(sb)
    }
}


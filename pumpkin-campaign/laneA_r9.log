    49	
    50	impl Pile {
    51	    fn distance(&self, other: &Self) -> f64 {
    52	        let dx = self.x - other.x;
    53	        let dz = self.z - other.z;
    54	        dx.hypot(dz)
    55	    }
    56	
    57	    fn randomize(&mut self, min_x: f64, min_z: f64, max_x: f64, max_z: f64) {
    58	        self.x = rand::random_range(min_x..=max_x);
    59	        self.z = rand::random_range(min_z..=max_z);
    60	    }
    61	
    62	    /// Clamps this pile into the spread area. Returns whether it moved.
    63	    fn clamp(&mut self, min_x: f64, min_z: f64, max_x: f64, max_z: f64) -> bool {
    64	        let mut moved = false;
    65	        if self.x < min_x {
    66	            self.x = min_x;
    67	            moved = true;
    68	        } else if self.x > max_x {
    69	            self.x = max_x;
    70	            moved = true;
    71	        }
    72	        if self.z < min_z {
    73	            self.z = min_z;
    74	            moved = true;
    75	        } else if self.z > max_z {
    76	            self.z = max_z;
    77	            moved = true;
    78	        }
    79	        moved
    80	    }

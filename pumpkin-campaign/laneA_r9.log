   192	    /// `ConduitBlockEntity.serverTick`
   193	    async fn server_tick(&self, world: &Arc<World>) {
   194	        self.tick_count.fetch_add(1, Ordering::Relaxed);
   195	        let game_time = world.get_world_age().await;
   196	
   197	        if game_time % 40 == 0 {
   198	            let shape = scan_shape(
   199	                self.position,
   200	                |pos| world.get_fluid(&pos) == &Fluid::FLOWING_WATER,
   201	                |pos| world.get_block(&pos),
   202	            );
   203	            let active = shape.len() >= MIN_ACTIVE_SIZE;
   204	            let hunting = shape.len() >= MIN_KILL_SIZE;
   205	
   206	            if active != self.is_active.load(Ordering::Relaxed) {
   207	                let sound = if active {
   208	                    Sound::BlockConduitActivate
   209	                } else {
   210	                    Sound::BlockConduitDeactivate
   211	                };
   212	                world.play_block_sound(sound, SoundCategory::Blocks, self.position);
   213	            }
   214	            self.is_active.store(active, Ordering::Relaxed);
   215	            self.is_hunting.store(hunting, Ordering::Relaxed);
   216	            *self.effect_blocks.lock().await = shape;
   217	
   218	            if active {
   219	                self.apply_effects(world).await;
   220	                self.update_and_attack_target(world, hunting).await;
   221	            }
   222	        }
   223	
   224	        if self.is_active() {
   225	            if game_time % 80 == 0 {
   226	                world.play_block_sound(
   227	                    Sound::BlockConduitAmbient,
   228	                    SoundCategory::Blocks,
   229	                    self.position,
   230	                );
   231	            }
   232	
   233	            if game_time > self.next_ambient_sound_activation.load(Ordering::Relaxed) {
   234	                let delay = 60 + rand::rng().random_range(0..40);
   235	                self.next_ambient_sound_activation
   236	                    .store(game_time + delay, Ordering::Relaxed);
   237	                world.play_block_sound(
   238	                    Sound::BlockConduitAmbientShort,
   239	                    SoundCategory::Blocks,
   240	                    self.position,
   241	                );
   242	            }
   243	        }
   244	
   245	        if self.is_active() {
   246	            self.active_rotation
   247	                .store(self.active_rotation.load() + 1.0);
   248	        }
   249	    }

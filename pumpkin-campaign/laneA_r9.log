   587	    /// Vanilla `WindChargeItem`. `asProjectile` spreads the launch direction per-axis via
   588	    /// `random.triangle(direction.component, 0.11485)` and sets it as the wind charge's
   589	    /// delta movement directly (no normalization, no power scaling). `WindChargeItem.shoot`
   590	    /// is overridden to a no-op, so `createDispenseConfig`'s `uncertainty = 6.6666665F` /
   591	    /// `power = 1.0F` are declared but never actually applied by the generic dispenser
   592	    /// machinery for this item - `asProjectile`'s own spread is the only randomization that
   593	    /// happens. Do NOT route this through `ThrownItemEntity::set_velocity`'s uncertainty/power
   594	    /// pipeline (`0.0172275`-scaled normalize-then-scale): that is vanilla's *generic*
   595	    /// `Projectile.spawnProjectileUsingShoot` formula, a different one from this item's own,
   596	    /// and using it here would both double the spread and incorrectly renormalize direction.
   597	    async fn dispense_wind_charge(ctx: &DispenseContext<'_>, item: &mut ItemStack) {
   598	        let _ = item.split(1);
   599	        let facing = to_normal(ctx.facing);
   600	        // Vanilla: `DispenserBlock.getDispensePosition(source, 1.0, Vec3.ZERO)` - a full
   601	        // block offset along facing, no extra vector.
   602	        let spawn_pos = ctx.position.to_centered_f64().add(&(facing * 1.0));
   603	
   604	        let dir = {
   605	            let mut random = rng();
   606	            Vector3::new(
   607	                triangle(&mut random, facing.x, 0.11485),
   608	                triangle(&mut random, facing.y, 0.11485),
   609	                triangle(&mut random, facing.z, 0.11485),
   610	            )
   611	        };
   612	
   613	        let entity = Entity::new(ctx.world.clone(), spawn_pos, &EntityType::WIND_CHARGE);
   614	        entity.velocity.store(dir);
   615	        let len = dir.horizontal_length();
   616	        entity.set_rotation(
   617	            dir.x.atan2(dir.z) as f32 * 57.295_776,
   618	            dir.y.atan2(len) as f32 * 57.295_776,
   619	        );
   620	
   621	        let thrown = crate::entity::projectile::ThrownItemEntity {
   622	            entity,
   623	            owner_id: None,
   624	            collides_with_projectiles: false,
   625	            has_hit: std::sync::atomic::AtomicBool::new(false),
   626	            gravity: crate::entity::projectile::wind_charge::WIND_CHARGE_GRAVITY,
   627	        };
   628	        let wind_charge =
   629	            Arc::new(crate::entity::projectile::wind_charge::WindChargeEntity::new_normal(thrown));
   630	        ctx.world.spawn_entity(wind_charge).await;
   631	
   632	        // Vanilla `overrideDispenseEvent = 1051`, a level-event id distinct from the generic
   633	        // dispense sound/smoke fired by the other branches above.
   634	        ctx.world
   635	            .sync_world_event(WorldEvent::SoundWindChargeShoot, *ctx.position, 0);
   636	    }

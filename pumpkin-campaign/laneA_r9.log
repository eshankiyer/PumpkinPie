   114	    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self
   115	    where
   116	        Self: Sized,
   117	    {
   118	        let destroy_target = nbt.get_int_array("Target").and_then(uuid_from_int_array);
   119	        Self {
   120	            position,
   121	            tick_count: AtomicI32::new(0),
   122	            active_rotation: AtomicCell::new(0.0),
   123	            is_active: AtomicBool::new(false),
   124	            is_hunting: AtomicBool::new(false),
   125	            effect_blocks: Mutex::new(Vec::new()),
   126	            destroy_target: Mutex::new(destroy_target),
   127	            next_ambient_sound_activation: AtomicI64::new(0),
   128	        }
   129	    }
   130	
   131	    fn write_nbt<'a>(
   132	        &'a self,
   133	        nbt: &'a mut NbtCompound,
   134	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   135	        Box::pin(async move {
   136	            let target = *self.destroy_target.lock().await;
   137	            if let Some(uuid) = target {
   138	                nbt.put("Target", uuid_to_int_array(uuid));
   139	            }
   140	        })
   141	    }
   142	
   143	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   144	        Box::pin(async move { self.server_tick(world).await })
   145	    }
   146	
   147	    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
   148	        let mut nbt = NbtCompound::new();
   149	        if let Ok(target) = self.destroy_target.try_lock()
   150	            && let Some(uuid) = *target
   151	        {
   152	            nbt.put("Target", uuid_to_int_array(uuid));
   153	        }
   154	        Some(nbt)
   155	    }
   156	
   157	    fn as_any(&self) -> &dyn std::any::Any {
   158	        self
   159	    }
   160	}

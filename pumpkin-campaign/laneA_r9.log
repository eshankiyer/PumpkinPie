    26	public class ChorusFlowerBlock extends Block {
    27	   public static final MapCodec<ChorusFlowerBlock> CODEC = RecordCodecBuilder.mapCodec(
    28	      i -> i.group(BuiltInRegistries.BLOCK.byNameCodec().fieldOf("plant").forGetter(b -> b.plant), propertiesCodec()).apply(i, ChorusFlowerBlock::new)
    29	   );
    30	   public static final int DEAD_AGE = 5;
    31	   public static final IntegerProperty AGE = BlockStateProperties.AGE_5;
    32	   private static final VoxelShape SHAPE_BLOCK_SUPPORT = Block.column(14.0, 0.0, 15.0);
    33	   private final Block plant;
    34	
    35	   @Override
    36	   public MapCodec<ChorusFlowerBlock> codec() {
    37	      return CODEC;
    38	   }
    39	
    40	   protected ChorusFlowerBlock(final Block plant, final BlockBehaviour.Properties properties) {
    41	      super(properties);
    42	      this.plant = plant;
    43	      this.registerDefaultState(this.stateDefinition.any().setValue(AGE, 0));
    44	   }
    45	
    46	   @Override
    47	   protected void tick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
    48	      if (!state.canSurvive(level, pos)) {
    49	         level.destroyBlock(pos, true);
    50	      }
    51	   }
    52	
    53	   @Override
    54	   protected boolean isRandomlyTicking(final BlockState state) {
    55	      return state.getValue(AGE) < 5;
    56	   }
    57	
    58	   @Override
    59	   public VoxelShape getBlockSupportShape(final BlockState state, final BlockGetter level, final BlockPos pos) {
    60	      return SHAPE_BLOCK_SUPPORT;
    61	   }
    62	
    63	   @Override
    64	   protected void randomTick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
    65	      BlockPos above = pos.above();
    66	      if (level.isEmptyBlock(above) && above.getY() <= level.getMaxY()) {
    67	         int currentAge = state.getValue(AGE);
    68	         if (currentAge < 5) {
    69	            boolean growUpwards = false;
    70	            boolean pillarOnSupportBlock = false;
    71	            BlockState belowState = level.getBlockState(pos.below());
    72	            if (belowState.is(BlockTags.SUPPORTS_CHORUS_FLOWER)) {
    73	               growUpwards = true;
    74	            } else if (belowState.is(this.plant)) {
    75	               int height = 1;
    76	
    77	               for (int i = 0; i < 4; i++) {
    78	                  BlockState testState = level.getBlockState(pos.below(height + 1));
    79	                  if (!testState.is(this.plant)) {
    80	                     if (testState.is(BlockTags.SUPPORTS_CHORUS_FLOWER)) {
    81	                        pillarOnSupportBlock = true;
    82	                     }
    83	                     break;
    84	                  }
    85	
    86	                  height++;
    87	               }
    88	
    89	               if (height < 2 || height <= random.nextInt(pillarOnSupportBlock ? 5 : 4)) {
    90	                  growUpwards = true;
    91	               }
    92	            } else if (belowState.isAir()) {
    93	               growUpwards = true;
    94	            }
    95	
    96	            if (growUpwards && allNeighborsEmpty(level, above, null) && level.isEmptyBlock(pos.above(2))) {
    97	               level.setBlock(pos, ChorusPlantBlock.getStateWithConnections(level, pos, this.plant.defaultBlockState()), 2);
    98	               this.placeGrownFlower(level, above, currentAge);
    99	            } else if (currentAge < 4) {
   100	               int numBranchAttempts = random.nextInt(4);
   101	               if (pillarOnSupportBlock) {
   102	                  numBranchAttempts++;
   103	               }
   104	
   105	               boolean createdBranch = false;
   106	
   107	               for (int i = 0; i < numBranchAttempts; i++) {
   108	                  Direction direction = Direction.Plane.HORIZONTAL.getRandomDirection(random);
   109	                  BlockPos target = pos.relative(direction);
   110	                  if (level.isEmptyBlock(target) && level.isEmptyBlock(target.below()) && allNeighborsEmpty(level, target, direction.getOpposite())) {
   111	                     this.placeGrownFlower(level, target, currentAge + 1);
   112	                     createdBranch = true;
   113	                  }
   114	               }
   115	
   116	               if (createdBranch) {
   117	                  level.setBlock(pos, ChorusPlantBlock.getStateWithConnections(level, pos, this.plant.defaultBlockState()), 2);
   118	               } else {
   119	                  this.placeDeadFlower(level, pos);
   120	               }
   121	            } else {
   122	               this.placeDeadFlower(level, pos);
   123	            }
   124	         }
   125	      }
   126	   }
   127	
   128	   private void placeGrownFlower(final Level level, final BlockPos pos, final int age) {
   129	      level.setBlock(pos, this.defaultBlockState().setValue(AGE, age), 2);
   130	      level.levelEvent(1033, pos, 0);
   131	   }
   132	
   133	   private void placeDeadFlower(final Level level, final BlockPos pos) {
   134	      level.setBlock(pos, this.defaultBlockState().setValue(AGE, 5), 2);
   135	      level.levelEvent(1034, pos, 0);
   136	   }
   137	
   138	   private static boolean allNeighborsEmpty(final LevelReader level, final BlockPos pos, final @Nullable Direction ignore) {
   139	      for (Direction direction : Direction.Plane.HORIZONTAL) {
   140	         if (direction != ignore && !level.isEmptyBlock(pos.relative(direction))) {
   141	            return false;
   142	         }
   143	      }
   144	
   145	      return true;
   146	   }
   147	
   148	   @Override
   149	   protected BlockState updateShape(
   150	      final BlockState state,
   151	      final LevelReader level,
   152	      final ScheduledTickAccess ticks,
   153	      final BlockPos pos,
   154	      final Direction directionToNeighbour,
   155	      final BlockPos neighbourPos,
   156	      final BlockState neighbourState,
   157	      final RandomSource random
   158	   ) {
   159	      if (directionToNeighbour != Direction.UP && !state.canSurvive(level, pos)) {
   160	         ticks.scheduleTick(pos, this, 1);
   161	      }
   162	
   163	      return super.updateShape(state, level, ticks, pos, directionToNeighbour, neighbourPos, neighbourState, random);
   164	   }
   165	
   166	   @Override
   167	   protected boolean canSurvive(final BlockState state, final LevelReader level, final BlockPos pos) {
   168	      BlockState belowState = level.getBlockState(pos.below());
   169	      if (!belowState.is(this.plant) && !belowState.is(BlockTags.SUPPORTS_CHORUS_FLOWER)) {
   170	         if (!belowState.isAir()) {
   171	            return false;
   172	         }
   173	
   174	         boolean oneNeighbor = false;
   175	
   176	         for (Direction direction : Direction.Plane.HORIZONTAL) {
   177	            BlockState neighbor = level.getBlockState(pos.relative(direction));
   178	            if (neighbor.is(this.plant)) {
   179	               if (oneNeighbor) {
   180	                  return false;
   181	               }
   182	
   183	               oneNeighbor = true;
   184	            } else if (!neighbor.isAir()) {
   185	               return false;
   186	            }
   187	         }
   188	
   189	         return oneNeighbor;
   190	      } else {
   191	         return true;
   192	      }
   193	   }
   194	
   195	   @Override
   196	   protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
   197	      builder.add(AGE);
   198	   }
   199	
   200	   public static void generatePlant(final LevelAccessor level, final BlockPos target, final RandomSource random, final int maxHorizontalSpread) {
   201	      level.setBlock(target, ChorusPlantBlock.getStateWithConnections(level, target, Blocks.CHORUS_PLANT.defaultBlockState()), 2);
   202	      growTreeRecursive(level, target, random, target, maxHorizontalSpread, 0);
   203	   }
   204	
   205	   private static void growTreeRecursive(
   206	      final LevelAccessor level, final BlockPos current, final RandomSource random, final BlockPos startPos, final int maxHorizontalSpread, final int depth
   207	   ) {
   208	      Block chorus = Blocks.CHORUS_PLANT;
   209	      int height = random.nextInt(4) + 1;
   210	      if (depth == 0) {
   211	         height++;
   212	      }
   213	
   214	      for (int i = 0; i < height; i++) {
   215	         BlockPos target = current.above(i + 1);
   216	         if (!allNeighborsEmpty(level, target, null)) {
   217	            return;
   218	         }
   219	
   220	         level.setBlock(target, ChorusPlantBlock.getStateWithConnections(level, target, chorus.defaultBlockState()), 2);
   221	         level.setBlock(target.below(), ChorusPlantBlock.getStateWithConnections(level, target.below(), chorus.defaultBlockState()), 2);
   222	      }
   223	
   224	      boolean placedStem = false;
   225	      if (depth < 4) {
   226	         int stems = random.nextInt(4);
   227	         if (depth == 0) {
   228	            stems++;
   229	         }
   230	
   231	         for (int i = 0; i < stems; i++) {
   232	            Direction direction = Direction.Plane.HORIZONTAL.getRandomDirection(random);
   233	            BlockPos target = current.above(height).relative(direction);
   234	            if (Math.abs(target.getX() - startPos.getX()) < maxHorizontalSpread
   235	               && Math.abs(target.getZ() - startPos.getZ()) < maxHorizontalSpread
   236	               && level.isEmptyBlock(target)
   237	               && level.isEmptyBlock(target.below())
   238	               && allNeighborsEmpty(level, target, direction.getOpposite())) {
   239	               placedStem = true;
   240	               level.setBlock(target, ChorusPlantBlock.getStateWithConnections(level, target, chorus.defaultBlockState()), 2);
   241	               level.setBlock(
   242	                  target.relative(direction.getOpposite()),
   243	                  ChorusPlantBlock.getStateWithConnections(level, target.relative(direction.getOpposite()), chorus.defaultBlockState()),
   244	                  2
   245	               );
   246	               growTreeRecursive(level, target, random, startPos, maxHorizontalSpread, depth + 1);
   247	            }
   248	         }
   249	      }
   250	
   251	      if (!placedStem) {
   252	         level.setBlock(current.above(height), Blocks.CHORUS_FLOWER.defaultBlockState().setValue(AGE, 5), 2);
   253	      }
   254	   }
   255	
   256	   @Override
   257	   protected void onProjectileHit(final Level level, final BlockState state, final BlockHitResult blockHit, final Projectile projectile) {
   258	      BlockPos pos = blockHit.getBlockPos();
   259	      if (level instanceof ServerLevel serverLevel && projectile.mayInteract(serverLevel, pos) && projectile.mayBreak(serverLevel)) {
   260	         level.destroyBlock(pos, true, projectile);
   261	      }
   262	   }
   263	}


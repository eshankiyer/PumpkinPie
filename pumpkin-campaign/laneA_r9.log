   127	   private static boolean updateShape(final Level level, final BlockPos worldPosition, final List<BlockPos> effectBlocks) {
   128	      effectBlocks.clear();
   129	
   130	      for (int ox = -1; ox <= 1; ox++) {
   131	         for (int oy = -1; oy <= 1; oy++) {
   132	            for (int oz = -1; oz <= 1; oz++) {
   133	               BlockPos testPos = worldPosition.offset(ox, oy, oz);
   134	               if (!level.isWaterAt(testPos)) {
   135	                  return false;
   136	               }
   137	            }
   138	         }
   139	      }
   140	
   141	      for (int ox = -2; ox <= 2; ox++) {
   142	         for (int oy = -2; oy <= 2; oy++) {
   143	            for (int oz = -2; oz <= 2; oz++) {
   144	               int ax = Math.abs(ox);
   145	               int ay = Math.abs(oy);
   146	               int az = Math.abs(oz);
   147	               if ((ax > 1 || ay > 1 || az > 1) && (ox == 0 && (ay == 2 || az == 2) || oy == 0 && (ax == 2 || az == 2) || oz == 0 && (ax == 2 || ay == 2))) {
   148	                  BlockPos testPos = worldPosition.offset(ox, oy, oz);
   149	                  BlockState testBlock = level.getBlockState(testPos);
   150	
   151	                  for (Block type : VALID_BLOCKS) {
   152	                     if (testBlock.is(type)) {
   153	                        effectBlocks.add(testPos);
   154	                     }
   155	                  }
   156	               }
   157	            }
   158	         }
   159	      }
   160	
   161	      return effectBlocks.size() >= 16;
   162	   }

    46	    fn tick<'a>(&'a self, world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    47	        Box::pin(async {
    48	            if world.get_world_age().await % 20 == 0 && world.dimension.has_skylight {

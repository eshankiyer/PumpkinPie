     9	use pumpkin_data::dimension::Dimension;
    10	use pumpkin_macros::pumpkin_block;
    11	use pumpkin_util::math::boundingbox::BoundingBox;
    12	
    13	#[pumpkin_block("minecraft:end_portal")]
    14	pub struct EndPortalBlock;
    15	
    16	impl BlockBehaviour for EndPortalBlock {
    17	    fn on_entity_collision<'a>(&'a self, args: OnEntityCollisionArgs<'a>) -> BlockFuture<'a, ()> {
    18	        Box::pin(async move {
    19	            let target_world =
    20	                if args.world.dimension.minecraft_name == Dimension::THE_END.minecraft_name {
    21	                    args.server.get_world_from_dimension(&Dimension::OVERWORLD)
    22	                } else {
    23	                    args.server.get_world_from_dimension(&Dimension::THE_END)
    24	                };
    25	            if Arc::ptr_eq(&target_world, args.world) {
    26	                return;
    27	            }
    28	            tracing::info!(
    29	                "End portal collision at {:?}, targeting world {:?}",
    30	                args.position,
    31	                target_world.dimension.minecraft_name
    32	            );
    33	            args.entity
    34	                .get_entity()
    35	                .try_use_portal(0, target_world, *args.position)
    36	                .await;
    37	        })
    38	    }
    39	
    40	    /// `EndPortalBlock.getEntityInsideCollisionShape` (EndPortalBlock.java:56-58) uses the
    41	    /// portal's outline shape (the six-pixel-high slab), rather than the full block cube used by
    42	    /// the generic block-behaviour default.
    43	    fn get_inside_collision_shape<'a>(
    44	        &'a self,
    45	        args: GetInsideCollisionShapeArgs<'a>,
    46	    ) -> BlockFuture<'a, BoundingBox> {
    47	        Box::pin(async move {
    48	            args.state
    49	                .get_block_outline_shapes()
    50	                .next()
    51	                .unwrap_or_else(BoundingBox::full_block)
    52	        })
    53	    }
    54	
    55	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    56	        Box::pin(async move {
    57	            let nbt = EndPortalBlockEntity::create_nbt(*args.position);
    58	            args.world.add_block_entity_nbt(*args.position, &nbt);
    59	
    60	            args.world
    61	                .add_block_entity(Arc::new(EndPortalBlockEntity::new(*args.position)));
    62	        })
    63	    }
    64	}

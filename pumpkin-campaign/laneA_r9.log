   153	            biome_id,
   154	            id if id == Biome::BAMBOO_JUNGLE.id
   155	                || id == Biome::MUSHROOM_FIELDS.id
   156	                || id == Biome::MANGROVE_SWAMP.id
   157	                || id == Biome::SNOWY_SLOPES.id
   158	                || id == Biome::FROZEN_PEAKS.id
   159	                || id == Biome::JAGGED_PEAKS.id
   160	                || id == Biome::SWAMP.id
   161	                || id == Biome::JUNGLE.id
   162	        )
   163	    }

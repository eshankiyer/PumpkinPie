    54	   private static void updateSignalStrength(final BlockState state, final Level level, final BlockPos pos) {
    55	      int target = level.getEffectiveSkyBrightness(pos);
    56	      float sunAngle = level.environmentAttributes().getValue(EnvironmentAttributes.SUN_ANGLE, pos) * (float) (Math.PI / 180.0);
    57	      boolean isInverted = state.getValue(INVERTED);
    58	      if (isInverted) {
    59	         target = 15 - target;
    60	      } else if (target > 0) {
    61	         float offset = sunAngle < (float) Math.PI ? 0.0F : (float) (Math.PI * 2);
    62	         sunAngle += (offset - sunAngle) * 0.2F;
    63	         target = Math.round(target * Mth.cos(sunAngle));
    64	      }
    65	
    66	      target = Mth.clamp(target, 0, 15);
    67	      if (state.getValue(POWER) != target) {
    68	         level.setBlock(pos, state.setValue(POWER, target), 3);
    69	      }
    70	   }

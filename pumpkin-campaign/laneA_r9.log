    94	    fn get_start_and_end_pos(&self, player: &Player) -> (Vector3<f64>, Vector3<f64>) {
    95	        let start_pos = player.eye_position();
    96	        let (yaw, pitch) = player.rotation();
    97	        let (yaw_rad, pitch_rad) = (f64::from(yaw.to_radians()), f64::from(pitch.to_radians()));
    98	        let block_interaction_range = 4.5; // This is not the same as the block_interaction_range in the
    99	        // player entity.
   100	        let direction = Vector3::new(
   101	            -yaw_rad.sin() * pitch_rad.cos() * block_interaction_range,
   102	            -pitch_rad.sin() * block_interaction_range,
   103	            pitch_rad.cos() * yaw_rad.cos() * block_interaction_range,
   104	        );
   105	
   106	        let end_pos = start_pos.add(&direction);
   107	        (start_pos, end_pos)
   108	    }

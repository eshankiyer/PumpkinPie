    54	
    55	impl DaylightDetectorBlockEntity {
    56	    pub const ID: &'static str = "minecraft:daylight_detector";
    57	
    58	    #[must_use]
    59	    pub const fn new(position: BlockPos) -> Self {
    60	        Self { position }
    61	    }
    62	
    63	    pub async fn update_power(world: &Arc<World>, block_pos: &BlockPos) {
    64	        use std::f32::consts::PI;
    65	
    66	        let (block, state) = world.get_block_and_state(block_pos);
    67	        let mut props = DaylightDetectorProperties::from_state_id(state.id, block);
    68	
    69	        let inverted = props.inverted;
    70	        let time_of_day = world.get_time_of_day().await;
    71	        let sun_angle = ((time_of_day as f32 / 24_000.0) - 0.25) * (PI * 2.0);
    72	        let power = daylight_detector_power(
    73	            world.get_sky_light_level(block_pos),
    74	            world.sky_darken.load(Ordering::Relaxed),
    75	            sun_angle,
    76	            inverted,
    77	        );
    78	        if power != props.power {
    79	            props.power = power;
    80	            let state = props.to_state_id(block);
    81	            world
    82	                .clone()
    83	                .set_block_state(block_pos, state, BlockFlags::NOTIFY_ALL)
    84	                .await;
    85	        }
    86	    }
    87	}
    88	
    89	fn daylight_detector_power(
    90	    sky_light: u8,
    91	    sky_darken: u8,
    92	    mut sun_angle: f32,
    93	    inverted: bool,
    94	) -> u8 {
    95	    let mut target = sky_light.saturating_sub(sky_darken);
    96	    if inverted {
    97	        target = 15 - target;
    98	    } else if target > 0 {
    99	        let offset = if sun_angle < std::f32::consts::PI {
   100	            0.0
   101	        } else {
   102	            std::f32::consts::PI * 2.0
   103	        };
   104	        sun_angle += (offset - sun_angle) * 0.2;
   105	        target = (target as f32 * sun_angle.cos()).round().clamp(0.0, 15.0) as u8;
   106	    }
   107	    target
   108	}

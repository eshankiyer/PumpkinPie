   101	/// Spreads `piles` apart until every pair is at least `spread_distance` apart
   102	/// and all piles are inside the spread area, mirroring Vanilla's algorithm.
   103	/// Returns whether the piles converged within [`MAX_ITERATIONS`].
   104	fn spread_piles(
   105	    piles: &mut [Pile],
   106	    spread_distance: f64,
   107	    min_x: f64,
   108	    min_z: f64,
   109	    max_x: f64,
   110	    max_z: f64,
   111	) -> bool {
   112	    for _ in 0..MAX_ITERATIONS {
   113	        let mut moved = false;
   114	        for i in 0..piles.len() {
   115	            let mut push = Pile::default();
   116	            let mut collisions = 0;
   117	
   118	            for j in 0..piles.len() {
   119	                if i == j {
   120	                    continue;
   121	                }
   122	                let distance = piles[i].distance(&piles[j]);
   123	                if distance < spread_distance {
   124	                    collisions += 1;
   125	                    push.x += piles[j].x - piles[i].x;
   126	                    push.z += piles[j].z - piles[i].z;
   127	                }
   128	            }
   129	
   130	            if collisions > 0 {
   131	                push.x /= f64::from(collisions);
   132	                push.z /= f64::from(collisions);
   133	                let length = push.x.hypot(push.z);
   134	                if length > 0.0 {
   135	                    piles[i].x -= push.x / length;
   136	                    piles[i].z -= push.z / length;
   137	                } else {
   138	                    piles[i].randomize(min_x, min_z, max_x, max_z);
   139	                }
   140	                moved = true;
   141	            }
   142	
   143	            if piles[i].clamp(min_x, min_z, max_x, max_z) {
   144	                moved = true;
   145	            }
   146	        }
   147	        if !moved {
   148	            return true;
   149	        }
   150	    }
   151	    false
   152	}

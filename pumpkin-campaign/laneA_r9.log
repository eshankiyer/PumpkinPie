    26	    fn get_mid_pos(world: &World, pos: BlockPos) -> Option<BlockPos> {
    27	        let (block, state) = world.get_block_and_state_id(&pos);
    28	        if block != &Self::FRAME_BLOCK {
    29	            return None;
    30	        }
    31	
    32	        let properties = EndPortalFrameProperties::from_state_id(state, block);
    33	        let facing_dir = properties.facing;
    34	        let left_pos = pos.offset_dir(facing_dir.rotate_clockwise().to_offset(), 1);
    35	        let right_pos = pos.offset_dir(facing_dir.rotate_counter_clockwise().to_offset(), 1);
    36	
    37	        let left_block = world.get_block(&left_pos);
    38	        let right_block = world.get_block(&right_pos);
    39	
    40	        let offset = match (left_block.id, right_block.id) {
    41	            (Self::FRAME_BLOCK_ID, Self::FRAME_BLOCK_ID) => 0, // Middle block
    42	            (Self::FRAME_BLOCK_ID, _) => -1,                   // Right block (offset left)
    43	            (_, Self::FRAME_BLOCK_ID) => 1,                    // Left block (offset right)

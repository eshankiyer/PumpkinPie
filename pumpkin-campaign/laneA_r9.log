   108	/// Maps a `..._concrete_powder` block to its solid `..._concrete` counterpart by name, mirroring
   109	/// the `concrete` field vanilla's `ConcretePowderBlock` is constructed with per color.
   110	#[must_use]
   111	pub fn concrete_for_powder(block: &Block) -> Option<&'static Block> {
   112	    block
   113	        .name
   114	        .strip_suffix("_powder")
   115	        .and_then(Block::from_name)
   116	}

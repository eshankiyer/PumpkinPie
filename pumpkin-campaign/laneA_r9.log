   205	#[must_use]
   206	pub fn reputation_price_discount(reputation: i32, price_multiplier: f32) -> i32 {
   207	    #[allow(clippy::cast_possible_truncation)]
   208	    -((reputation as f32 * price_multiplier).floor() as i32)
   209	}

=== line-sign helper
   830	fn other_player_is_editing_sign(
   831	    currently_editing: Option<Uuid>,
   832	    uuid: &Uuid,
   833	    world: &World,
   834	    position: &BlockPos,
   835	) -> bool {
   836	    if let Some(editing_player_id) = currently_editing
   837	        && editing_player_id != *uuid
   838	        && let Some(editing_player) = world.get_player_by_uuid(editing_player_id)
   839	        && editing_player
   840	            .as_ref()
   841	            .can_interact_with_block_at(position, 4.0f64)
   842	    {
   843	        return true;
   844	    }
   845	
   846	    false
   847	}
   848	
   849	fn has_editable_text(text: &crate::block::entities::sign::Text) -> bool {
   850	    text.messages
   851	        .lock()
   852	        .unwrap_or_else(std::sync::PoisonError::into_inner)
   853	        .iter()
   854	        .all(|line| {
   855	            line.is_empty()
   856	                || serde_json::from_str::<TextComponent>(line).is_ok_and(|component| {
   857	                    matches!(&*component.0.content, TextContent::Text { .. })
   858	                })
   859	        })
   860	}

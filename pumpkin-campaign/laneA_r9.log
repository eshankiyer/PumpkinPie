    21	impl BlockBehaviour for DaylightDetectorBlock {
    22	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    23	        Box::pin(async move {
    24	            args.world
    25	                .add_block_entity(Arc::new(DaylightDetectorBlockEntity::new(*args.position)));
    26	        })
    27	    }
    28	
    29	    fn broken<'a>(&'a self, args: BrokenArgs<'a>) -> BlockFuture<'a, ()> {
    30	        Box::pin(async move {
    31	            args.world.remove_block_entity(args.position);
    32	        })
    33	    }
    34	
    35	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
    36	        Box::pin(async {
    37	            let player_abilities = args.player.abilities.lock();
    38	            if !player_abilities.await.allow_modify_world {
    39	                return BlockActionResult::Pass;
    40	            }
    41	
    42	            let state = args.world.get_block_state(args.position);
    43	            let props = DaylightDetectorProperties::from_state_id(state.id, args.block);
    44	
    45	            let new_state = self
    46	                .update_inverted(props, args.world, args.position, args.block)
    47	                .await;
    48	
    49	            // DaylightDetectorBlock.useWithoutItem, lines 80-84: notify vibration/game-event
    50	            // listeners about the inverted state before recalculating its power.
    51	            emit_game_event(
    52	                args.world,
    53	                GameEvent::BlockChange,
    54	                pumpkin_util::math::vector3::Vector3::new(
    55	                    f64::from(args.position.0.x) + 0.5,
    56	                    f64::from(args.position.0.y) + 0.5,
    57	                    f64::from(args.position.0.z) + 0.5,
    58	                ),
    59	                GameEventContext::of_entity_with_block_state(
    60	                    args.player.clone() as Arc<dyn crate::entity::EntityBase>,
    61	                    new_state,
    62	                ),
    63	            )
    64	            .await;
    65	
    66	            DaylightDetectorBlockEntity::update_power(args.world, args.position).await;
    67	
    68	            BlockActionResult::Success
    69	        })
    70	    }

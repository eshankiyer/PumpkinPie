   166	/// `FarmlandBlock#turnToDirt`.
   167	async fn turn_to_dirt(world: &Arc<World>, block_pos: &BlockPos) {
   168	    push_up_entities(world, block_pos);
   169	    world
   170	        .set_block_state(
   171	            block_pos,
   172	            Block::DIRT.default_state.id,
   173	            BlockFlags::NOTIFY_ALL,
   174	        )
   175	        .await;
   176	    emit_game_event(
   177	        world,
   178	        GameEvent::BlockChange,
   179	        block_pos.to_centered_f64(),
   180	        GameEventContext::none(),
   181	    )
   182	    .await;
   183	}
   184	
   185	fn can_place_at(world: &dyn BlockAccessor, block_pos: &BlockPos) -> bool {
   186	    let (block, state) = world.get_block_and_state(&block_pos.up());
   187	    !state.is_solid() || block.has_tag(&tag::Block::MINECRAFT_MAINTAINS_FARMLAND)
   188	}
   189	
   190	/// Simplified port of vanilla's `Block.pushEntitiesUp`: teleports any entity
   191	/// overlapping the 1x1x1 column at `block_pos` up by one block, rather than
   192	/// vanilla's exact old-shape/new-shape collision diff.
   193	fn push_up_entities(world: &Arc<World>, block_pos: &BlockPos) {
   194	    let min = Vector3::new(
   195	        f64::from(block_pos.0.x),
   196	        f64::from(block_pos.0.y),
   197	        f64::from(block_pos.0.z),
   198	    );
   199	    let max = Vector3::new(min.x + 1.0, min.y + 1.0, min.z + 1.0);
   200	    let aabb = BoundingBox::new(min, max);
   201	    for entity in world.get_entities_at_box(&aabb) {
   202	        let entity = entity.get_entity();
   203	        let pos = entity.pos.load();
   204	        entity.pos.store(Vector3::new(pos.x, pos.y + 1.0, pos.z));
   205	    }
   206	}
   207	
   208	/// Mirrors vanilla `FarmBlock#isNearWater`, which tests the *fluid* state of every
   209	/// position in the box so that waterlogged blocks count as a water source too.
   210	fn is_water_nearby(world: &Arc<World>, block_pos: &BlockPos) -> bool {
   211	    for dx in -4..=4 {
   212	        for dy in 0..=1 {
   213	            for dz in -4..=4 {
   214	                let check_pos = block_pos.offset(Vector3 {
   215	                    x: dx,
   216	                    y: dy,
   217	                    z: dz,
   218	                });
   219	                if world
   220	                    .get_fluid(&check_pos)
   221	                    .has_tag(&tag::Fluid::MINECRAFT_WATER)
   222	                {
   223	                    return true;
   224	                }
   225	            }
   226	        }
   227	    }
   228	    false
   229	}

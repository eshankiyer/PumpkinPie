   240	   @Override
   241	   protected FluidState getFluidState(final BlockState state) {
   242	      return state.getValue(WATERLOGGED) ? Fluids.WATER.getSource(false) : super.getFluidState(state);
   243	   }
   244	
   245	   private @Nullable Direction candidatePartnerFacing(final Level level, final BlockPos pos, final Direction neighbourDirection) {
   246	      BlockState state = level.getBlockState(pos.relative(neighbourDirection));
   247	      return this.chestCanConnectTo(state) && state.getValue(TYPE) == ChestType.SINGLE ? state.getValue(FACING) : null;
   248	   }

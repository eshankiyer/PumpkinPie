   158	   @Override
   159	   protected BlockState updateShape(
   160	      final BlockState state,
   161	      final LevelReader level,
   162	      final ScheduledTickAccess ticks,
   163	      final BlockPos pos,
   164	      final Direction directionToNeighbour,
   165	      final BlockPos neighbourPos,
   166	      final BlockState neighbourState,
   167	      final RandomSource random
   168	   ) {
   169	      if (state.getValue(WATERLOGGED)) {
   170	         ticks.scheduleTick(pos, Fluids.WATER, Fluids.WATER.getTickDelay(level));
   171	      }
   172	
   173	      if (this.chestCanConnectTo(neighbourState) && directionToNeighbour.getAxis().isHorizontal()) {
   174	         ChestType neighbourType = neighbourState.getValue(TYPE);
   175	         if (state.getValue(TYPE) == ChestType.SINGLE
   176	            && neighbourType != ChestType.SINGLE
   177	            && state.getValue(FACING) == neighbourState.getValue(FACING)
   178	            && getConnectedDirection(neighbourState) == directionToNeighbour.getOpposite()) {
   179	            return state.setValue(TYPE, neighbourType.getOpposite());
   180	         }
   181	      } else if (getConnectedDirection(state) == directionToNeighbour) {
   182	         return state.setValue(TYPE, ChestType.SINGLE);
   183	      }
   184	
   185	      return super.updateShape(state, level, ticks, pos, directionToNeighbour, neighbourPos, neighbourState, random);
   186	   }

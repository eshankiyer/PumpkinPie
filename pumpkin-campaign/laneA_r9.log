    36	
    37	    fn is_flammable(block_state: &BlockState) -> bool {
    38	        if Block::from_state_id(block_state.id)
    39	            .properties(block_state.id)
    40	            .and_then(|props| {
    41	                props
    42	                    .to_props()
    43	                    .into_iter()
    44	                    .find(|p| p.0 == "waterlogged")
    45	                    .map(|(_, v)| v == "true")
    46	            })
    47	            .unwrap_or(false)
    48	        {
    49	            return false;
    50	        }
    51	        Block::from_state_id(block_state.id)
    52	            .flammable
    53	            .as_ref()
    54	            .is_some_and(|f| f.burn_chance > 0)
    55	    }
    56	
    57	    fn are_blocks_around_flammable(block_accessor: &dyn BlockAccessor, pos: &BlockPos) -> bool {
    58	        for direction in BlockDirection::all() {
    59	            let neighbor_pos = pos.offset(direction.to_offset());
    60	            let block_state = block_accessor.get_block_state(&neighbor_pos);
    61	            if Self::is_flammable(block_state) {
    62	                return true;
    63	            }
    64	        }
    65	        false
    66	    }
    67	
    68	    pub fn get_state_for_position(
    69	        &self,
    70	        world: &World,
    71	        block: &Block,
    72	        pos: &BlockPos,
    73	    ) -> BlockStateId {
    74	        let down_pos = pos.down();
    75	        let down_state = world.get_block_state(&down_pos);
    76	        if Self::is_flammable(down_state) || down_state.is_side_solid(BlockDirection::Up) {
    77	            return block.default_state.id;
    78	        }
    79	        let mut fire_props = FireProperties::from_state_id(block.default_state.id, block);
    80	        for direction in BlockDirection::all() {
    81	            let neighbor_pos = pos.offset(direction.to_offset());
    82	            let neighbor_state = world.get_block_state(&neighbor_pos);
    83	            if Self::is_flammable(neighbor_state) {
    84	                match direction {
    85	                    BlockDirection::North => fire_props.north = true,
    86	                    BlockDirection::South => fire_props.south = true,
    87	                    BlockDirection::East => fire_props.east = true,
    88	                    BlockDirection::West => fire_props.west = true,
    89	                    BlockDirection::Up => fire_props.up = true,
    90	                    BlockDirection::Down => {}
    91	                }
    92	            }
    93	        }
    94	        fire_props.to_state_id(block)
    95	    }
    96	
    97	    // Used for spreading fire
    98	    pub fn get_burn_chance(&self, world: &Arc<World>, pos: &BlockPos) -> i32 {
    99	        let block_state = world.get_block_state(pos);
   100	        if !block_state.is_air() {
   101	            return 0;
   102	        }
   103	        let mut total_burn_chance = 0;
   104	
   105	        for dir in BlockDirection::all() {
   106	            let neighbor_block = world.get_block(&pos.offset(dir.to_offset()));
   107	            if world.get_fluid(&pos.offset(dir.to_offset())).name != Fluid::EMPTY.name {
   108	                continue; // Skip if there is a fluid
   109	            }
   110	            if let Some(flammable) = &neighbor_block.flammable {
   111	                total_burn_chance = total_burn_chance.max(i32::from(flammable.spread_chance));
   112	            }
   113	        }
   114	
   115	        total_burn_chance
   116	    }
   117	
   118	    /// Whether it is raining on this position or on any of its four horizontal
   119	    /// neighbours, matching vanilla `FireBlock#isNearRain`.
   120	    async fn is_near_rain(world: &World, pos: &BlockPos) -> bool {
   121	        // Check the weather once here rather than once per position, since
   122	        // this runs for every burning block and every spread candidate.
   123	        if !world.is_raining().await {
   124	            return false;
   125	        }
   126	        world.is_raining_at_unchecked(pos)
   127	            || world.is_raining_at_unchecked(&pos.west())
   128	            || world.is_raining_at_unchecked(&pos.east())
   129	            || world.is_raining_at_unchecked(&pos.north())
   130	            || world.is_raining_at_unchecked(&pos.south())
   131	    }
   132	
   133	    // Get burn odds for a block, used in try_spreading_fire
   134	    fn get_burn_odds(block: &Block) -> i32 {
   135	        block.flammable.as_ref().map_or(0, |f| f.burn_chance.into())
   136	    }
   137	
   138	    fn is_increased_burnout_biome(world: &World, pos: &BlockPos) -> bool {
   139	        // Fire burnout increases in the Nether
   140	        if world.dimension == Dimension::THE_NETHER {
   141	            return true;
   142	        }
   143	
   144	        // Fire burnout increases in specific biomes
   145	        // TODO: Use proper tag or bool for this when available
   146	        // This is a membership test against a fixed list of biomes. With no resolvable
   147	        // biome the position is not in that list, so `false` is the honest answer and
   148	        // fire keeps its ordinary burnout rate; it is not a substituted biome.
   149	        let Some(biome_id) = world.level.get_rough_biome(pos).map(|b| b.id) else {
   150	            return false;
   151	        };
   152	        matches!(
   153	            biome_id,
   154	            id if id == Biome::BAMBOO_JUNGLE.id
   155	                || id == Biome::MUSHROOM_FIELDS.id
   156	                || id == Biome::MANGROVE_SWAMP.id
   157	                || id == Biome::SNOWY_SLOPES.id
   158	                || id == Biome::FROZEN_PEAKS.id
   159	                || id == Biome::JAGGED_PEAKS.id
   160	                || id == Biome::SWAMP.id
   161	                || id == Biome::JUNGLE.id
   162	        )
   163	    }

    57	            // Saplings still have no registered bone-meal behaviour; vanilla
    58	            // SaplingBlock.performBonemeal advances stage 0 -> 1 before growing the tree.
    59	            let sapling_action = block.properties(state_id).and_then(|props| {
    60	                let prop_map = props.to_props();
    61	                prop_map
    62	                    .iter()
    63	                    .find(|(k, _)| *k == "stage")
    64	                    .and_then(|(_, stage_val)| stage_val.parse::<u8>().ok())
    65	                    .filter(|&stage| stage < 1)
    66	                    .map(|_| {
    67	                        let new_props: Vec<(&str, &str)> = prop_map
    68	                            .iter()
    69	                            .map(|(k, v)| if *k == "stage" { (*k, "1") } else { (*k, *v) })
    70	                            .collect();
    71	                        block.from_properties(&new_props).to_state_id(block)
    72	                    })
    73	            });
    74	
    75	            if let Some(new_state_id) = sapling_action {
    76	                world
    77	                    .set_block_state(&location, new_state_id, BlockFlags::NOTIFY_ALL)
    78	                    .await;

   311	async fn normal_use_chest_impl(
   312	    args: NormalUseArgs<'_>,
   313	    open_stat: pumpkin_data::statistic::CustomStatistic,
   314	) -> BlockActionResult {
   315	    let state = args.world.get_block_state_id(args.position);
   316	    let first_chest = args.world.get_block_entity(args.position);
   317	
   318	    // Spectators cannot open chests with a pending loot table.
   319	    // The loot is only generated on first open by a non-spectator.
   320	    let player_is_spectator = args.player.gamemode.load() == GameMode::Spectator;
   321	    if player_is_spectator
   322	        && let Some(ref entity) = first_chest
   323	        && entity.has_loot_table()
   324	    {
   325	        return BlockActionResult::Success;
   326	    }
   327	
   328	    let chest_props = ChestLikeProperties::from_state_id(state, args.block);
   329	    let connected_towards = match chest_props.r#type {
   330	        ChestType::Single => None,
   331	        ChestType::Left => Some(chest_props.facing.rotate_clockwise()),
   332	        ChestType::Right => Some(chest_props.facing.rotate_counter_clockwise()),
   333	    };
   334	
   335	    // Vanilla's menu provider combines both halves before opening a double
   336	    // chest. A spectator cannot open it if either half still has a deferred
   337	    // loot table.
   338	    if player_is_spectator
   339	        && let Some(direction) = connected_towards
   340	        && let Some(second_entity) = args
   341	            .world
   342	            .get_block_entity(&args.position.offset(direction.to_offset()))
   343	        && second_entity.has_loot_table()
   344	    {
   345	        return BlockActionResult::Success;
   346	    }
   347	
   348	    if is_chest_blocked(args.world, args.position) {
   349	        return BlockActionResult::Success;
   350	    }
   351	
   352	    if let Some(direction) = connected_towards {
   353	        let neighbor_pos = args.position.offset(direction.to_offset());
   354	        if is_chest_blocked(args.world, &neighbor_pos) {
   355	            return BlockActionResult::Success;
   356	        }
   357	    }
   358	
   359	    let Some(first_chest) = first_chest else {
   360	        return BlockActionResult::Fail;
   361	    };
   362	
   363	    // Vanilla's double-chest menu provider unpacks both halves only after both
   364	    // halves are allowed to open (ChestBlock.java:98-102).
   365	    unpack_chest_loot(&first_chest).await;
   366	    let Some(first_inventory) = first_chest.clone().get_inventory() else {
   367	        return BlockActionResult::Fail;
   368	    };
   369	
   370	    let second_entity = connected_towards.and_then(|direction| {
   371	        args.world
   372	            .get_block_entity(&args.position.offset(direction.to_offset()))
   373	    });
   374	    if let Some(entity) = &second_entity {
   375	        unpack_chest_loot(entity).await;
   376	    }
   377	
   378	    let inventory = if let Some(_direction) = connected_towards
   379	        && let Some(second_inventory) = second_entity.and_then(BlockEntity::get_inventory)
   380	    {
   381	        // Vanilla: chestType == ChestType.RIGHT ? DoubleBlockProperties.Type.FIRST : DoubleBlockProperties.Type.SECOND;
   382	        if matches!(chest_props.r#type, ChestType::Right) {
   383	            DoubleInventory::new(first_inventory, second_inventory)
   384	        } else {
   385	            DoubleInventory::new(second_inventory, first_inventory)
   386	        }
   387	    } else {
   388	        first_inventory
   389	    };
   390	
   391	    args.player
   392	        .open_handled_screen(&ChestScreenFactory(inventory), Some(*args.position))
   393	        .await;
   394	
   395	    // Vanilla ChestBlock.useWithoutItem (ChestBlock.java:255-268) awards the
   396	    // open statistic and angers nearby piglins after a menu is opened.
   397	    if !player_is_spectator {
   398	        args.player
   399	            .increment_stat(
   400	                pumpkin_data::statistic::StatisticCategory::Custom,
   401	                open_stat as i32,
   402	                1,
   403	            )
   404	            .await;
   405	    }
   406	    piglin_shared::anger_nearby_piglins(args.world, args.player).await;
   407	
   408	    BlockActionResult::Success
   409	}

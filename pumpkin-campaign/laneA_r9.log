   192	            world.update_neighbors(pos, None).await;
   193	            world.update_neighbors(&pos.down(), None).await;
   194	        }
   195	
   196	        if should_be_pressed {
   197	            world.schedule_block_tick(block, *pos, PRESSED_CHECK_PERIOD, TickPriority::Normal);

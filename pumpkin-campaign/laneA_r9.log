   230	                    .set_block_state(pos, props.to_state_id(block), BlockFlags::NOTIFY_ALL)
   231	                    .await;
   232	                world.update_neighbors(pos, None).await;
   233	                world.schedule_block_tick(block, *pos, 30, TickPriority::Normal);
   234	                if let Some(block_entity) = world.get_block_entity(pos)
   235	                    && let Some(sculk_sensor) = block_entity
   236	                        .as_any()
   237	                        .downcast_ref::<crate::block::entities::sculk_sensor::SculkSensorBlockEntity>()
   238	                {
   239	                    sculk_sensor.set_last_vibration_frequency(frequency).await;
   240	                }
   241	                Self::try_resonate_vibration(world, pos, frequency).await;
   242	            }
   243	        } else if block.id == BlockId::CALIBRATED_SCULK_SENSOR {
   244	            let state = world.get_block_state(pos);
   245	            let mut props = CalibratedSculkSensorLikeProperties::from_state_id(state.id, block);

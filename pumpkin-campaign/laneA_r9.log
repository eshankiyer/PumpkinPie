   904	// `isInSittingPose()` inside the 1x1x1 box directly above the chest.
   905	// Pumpkin doesn't track the cat's settled sitting-pose flag separately, so
   906	// `is_ordered_to_sit()` (the sit command state) is used as the closest available proxy.
   907	fn is_cat_sitting_on_chest(world: &World, block_pos: &BlockPos) -> bool {
   908	    let x = f64::from(block_pos.0.x);
   909	    let y = f64::from(block_pos.0.y);
   910	    let z = f64::from(block_pos.0.z);
   920	            && entity
   921	                .get_mob()
   922	                .is_some_and(|cat| cat.get_mob_entity().is_ordered_to_sit())
   923	    })
   924	}

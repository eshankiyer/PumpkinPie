   676	                || pumpkin_item.as_any().downcast_ref::<DyeItem>().is_some();
   677	            let may_build = args.player.abilities.lock().await.allow_modify_world;
   678	            if !is_sign_applicator || !may_build {
   679	                return BlockActionResult::PassToDefaultBlockAction;
   680	            }
   681	
   682	            let currently_editing = sign_entity.editing_player().lock().await;
   683	            if other_player_is_editing_sign(
   684	                *currently_editing,
   685	                &args.player.gameprofile.id,
   686	                args.world,
   687	                args.position,
   688	            ) {
   689	                return BlockActionResult::PassToDefaultBlockAction;
   690	            }
   691	            drop(currently_editing);
   692	
   693	            let text = if is_facing_front_text(args.world, args.position, args.block, args.player) {
   694	                sign_entity.front_text()
   695	            } else {
   696	                sign_entity.back_text()
   697	            };
   698	
   699	            let result = pumpkin_item
   700	                .as_any()

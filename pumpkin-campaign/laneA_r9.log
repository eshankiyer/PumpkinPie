   892	// Vanilla ChestBlock.isChestBlockedAt (ChestBlock.java:332-334): blocked by a
   893	// redstone-conducting block above, or a cat sitting on top.
   894	fn is_chest_blocked(world: &World, block_pos: &BlockPos) -> bool {
   895	    has_block_on_top(world, block_pos) || is_cat_sitting_on_chest(world, block_pos)
   896	}
   897	fn has_block_on_top(world: &World, block_pos: &BlockPos) -> bool {
   898	    let above_pos = block_pos.up();
   899	    let above_state = world.get_block_state(&above_pos);
   900	    above_state.is_solid_block()
   901	}

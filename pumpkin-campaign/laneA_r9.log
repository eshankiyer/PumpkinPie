   136	    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   137	        Box::pin(async move {
   138	            !mob.get_mob_entity()
   139	                .living_entity
   140	                .entity
   141	                .on_ground
   142	                .load(std::sync::atomic::Ordering::Relaxed)
   143	        })
   144	    }
   145	
   146	    fn start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   147	        Box::pin(async move {
   148	            let entity = &mob.get_mob_entity().living_entity.entity;
   149	            let Some(target) = mob.get_mob_entity().target.lock().await.clone() else {
   150	                return;
   151	            };
   152	            let target_pos = target.get_entity().pos.load();
   153	            let pos = entity.pos.load();
   154	            let delta = Vector3::new(target_pos.x - pos.x, 0.0, target_pos.z - pos.z);
   155	            if delta.length_squared() <= 1.0e-7 {
   156	                return;
   157	            }
   158	            let movement = delta.normalize() * 0.4 + entity.velocity.load() * 0.2;
   159	            entity.set_velocity(Vector3::new(movement.x, 0.4, movement.z));
   160	        })
   161	    }

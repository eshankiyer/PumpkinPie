   118	/// `ConcretePowderBlock.canSolidify`: `state.getFluidState().is(FluidTags.WATER)`.
   119	fn can_solidify(state: &BlockState) -> bool {
   120	    state.is_waterlogged() || Block::from_state_id(state.id) == &Block::WATER
   121	}
   122	
   123	/// `ConcretePowderBlock.touchesLiquid`. Note the quirk faithfully ported from vanilla: due to how
   124	/// the Java loop reuses a single mutable cursor starting at `pos`, the UP/NORTH/SOUTH/WEST/EAST
   125	/// neighbors are always examined, but the DOWN neighbor is only examined when `pos` itself
   126	/// (the block being replaced) currently contains water.
   127	fn touches_liquid(accessor: &dyn BlockAccessor, pos: &BlockPos) -> bool {
   128	    for direction in [
   129	        BlockDirection::Up,
   130	        BlockDirection::North,
   131	        BlockDirection::South,
   132	        BlockDirection::West,
   133	        BlockDirection::East,
   134	    ] {
   135	        let neighbor_pos = pos.offset(direction.to_offset());
   136	        let neighbor_state = accessor.get_block_state(&neighbor_pos);
   137	        if can_solidify(neighbor_state) && !neighbor_state.is_side_solid(direction.opposite()) {
   138	            return true;
   139	        }
   140	    }
   141	
   142	    if can_solidify(accessor.get_block_state(pos)) {
   143	        let down_pos = pos.offset(BlockDirection::Down.to_offset());
   144	        let down_state = accessor.get_block_state(&down_pos);
   145	        if can_solidify(down_state) && !down_state.is_side_solid(BlockDirection::Up) {
   146	            return true;
   147	        }
   148	    }
   149	
   150	    false
   151	}

   664	
   665	pub async fn calculate_comparator_output(
   666	    inventory: &dyn pumpkin_world::inventory::Inventory,
   667	) -> u8 {
   668	    let size = inventory.size();
   669	    if size == 0 {
   670	        return 0;
   671	    }
   672	    let mut fill_sum = 0.0;
   673	    let mut non_empty_count = 0;
   674	    for i in 0..size {
   675	        let stack = inventory.get_stack(i).await;
   676	        if !stack.is_empty() {
   677	            let max_stack = stack.get_max_stack_size() as f32;
   678	            let count = stack.item_count as f32;
   679	            fill_sum += count / max_stack;
   680	            non_empty_count += 1;
   681	        }
   682	    }
   683	    if non_empty_count == 0 {
   684	        return 0;
   685	    }
   686	    let percentage = fill_sum / (size as f32);
   687	    let output = 1.0 + percentage * 14.0;
   688	    output.floor() as u8
   689	}

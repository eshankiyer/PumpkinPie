   201	/// `ChorusFlowerBlock.allNeighborsEmpty` (`ChorusFlowerBlock.java:138-146`).
   202	fn all_neighbors_empty(
   203	    block_accessor: &dyn BlockAccessor,
   204	    pos: &BlockPos,
   205	    ignore: Option<HorizontalFacing>,
   206	) -> bool {
   207	    for direction in BlockDirection::horizontal_worldgen() {
   208	        if Some(direction) != ignore
   209	            && !block_accessor
   210	                .get_block_state(&pos.offset(direction.to_offset()))
   211	                .is_air()
   212	        {
   213	            return false;
   214	        }
   215	    }
   216	    true
   217	}
   218	
   219	fn can_survive(block_accessor: &dyn BlockAccessor, pos: &BlockPos) -> bool {
   220	    let block_below = block_accessor.get_block(&pos.down());
   221	
   222	    if block_below == &Block::CHORUS_PLANT
   223	        || block_below.has_tag(&tag::Block::MINECRAFT_SUPPORTS_CHORUS_FLOWER)
   224	    {
   225	        return true;
   226	    }
   227	
   228	    if !block_below.is_air() {
   229	        return false;
   230	    }
   231	
   232	    // Below is air: the flower is the tip of a horizontal branch.
   233	    // Exactly one horizontal neighbor must be a chorus plant stem.
   234	    let mut plant_count = 0u32;
   235	    for dir in BlockDirection::horizontal() {
   236	        let neighbor = block_accessor.get_block(&pos.offset(dir.to_offset()));
   237	        if neighbor == &Block::CHORUS_PLANT {
   238	            plant_count += 1;
   239	            if plant_count > 1 {
   240	                return false;
   241	            }
   242	        } else if !neighbor.is_air() {
   243	            return false;
   244	        }
   245	    }
   246	
   247	    plant_count == 1
   248	}

    35	/// `ConduitBlockEntity.VALID_BLOCKS`
    36	fn is_valid_frame_block(block: &Block) -> bool {
    37	    block.id == Block::PRISMARINE.id
    38	        || block.id == Block::PRISMARINE_BRICKS.id
    39	        || block.id == Block::SEA_LANTERN.id
    40	        || block.id == Block::DARK_PRISMARINE.id
    41	}
    42	
    43	/// The 42 offsets `updateShape` scans in the outer shell of the 5x5x5 cube around the
    44	/// conduit. Pure geometry, independent of any world state, so it is unit-testable in
    45	/// isolation.
    46	fn frame_offsets() -> Vec<(i32, i32, i32)> {
    47	    let mut offsets = Vec::with_capacity(MIN_KILL_SIZE);
    48	    for ox in -2i32..=2 {
    49	        for oy in -2i32..=2 {
    50	            for oz in -2i32..=2 {
    51	                let (ax, ay, az) = (ox.abs(), oy.abs(), oz.abs());
    52	                let outside_inner_cube = ax > 1 || ay > 1 || az > 1;
    53	                let on_an_axis_arm = (ox == 0 && (ay == 2 || az == 2))
    54	                    || (oy == 0 && (ax == 2 || az == 2))
    55	                    || (oz == 0 && (ax == 2 || ay == 2));
    56	                if outside_inner_cube && on_an_axis_arm {
    57	                    offsets.push((ox, oy, oz));
    58	                }
    59	            }
    60	        }
    61	    }
    62	    offsets
    63	}
    64	
    65	/// `ConduitBlockEntity.updateShape`, split from world access so the offset geometry can
    66	/// be tested without a live `World`. `is_water` mirrors `Level.isWaterAt` for the inner
    67	/// 3x3x3 cube, `frame_block` mirrors `Level.getBlockState(pos).getBlock()` for the outer
    68	/// shell.
    69	fn scan_shape(
    70	    origin: BlockPos,
    71	    mut is_water: impl FnMut(BlockPos) -> bool,
    72	    mut frame_block: impl FnMut(BlockPos) -> &'static Block,
    73	) -> Vec<BlockPos> {
    74	    for ox in -1..=1 {
    75	        for oy in -1..=1 {
    76	            for oz in -1..=1 {
    77	                if !is_water(origin.offset(Vector3::new(ox, oy, oz))) {
    78	                    return Vec::new();
    79	                }
    80	            }
    81	        }
    82	    }
    83	
    84	    frame_offsets()
    85	        .into_iter()
    86	        .filter_map(|(ox, oy, oz)| {
    87	            let pos = origin.offset(Vector3::new(ox, oy, oz));
    88	            is_valid_frame_block(frame_block(pos)).then_some(pos)
    89	        })
    90	        .collect()
    91	}

   213	      BlockPos.MutableBlockPos pos = placePos.mutable();
   214	
   215	      for (int i = 0; i < 2; i++) {
   216	         pos.move(Direction.UP);
   217	         if (level.getBlockState(pos).isAir()) {
   218	            return;
   219	         }
   220	
   221	         level.getChunk(pos).markPosForPostProcessing(pos);
   222	      }

   105	   protected List<BlockPos> potentialRootPositions(final BlockPos pos, final Direction prevDir, final RandomSource random, final BlockPos rootOrigin) {
   106	      BlockPos below = pos.below();
   107	      BlockPos nextTo = pos.relative(prevDir);
   108	      int width = pos.distManhattan(rootOrigin);
   109	      int maxRootWidth = this.mangroveRootPlacement.maxRootWidth();
   110	      float randomSkewChance = this.mangroveRootPlacement.randomSkewChance();
   111	      if (width > maxRootWidth - 3 && width <= maxRootWidth) {
   112	         return random.nextFloat() < randomSkewChance ? List.of(below, nextTo.below()) : List.of(below);
   113	      } else if (width > maxRootWidth) {
   114	         return List.of(below);
   115	      } else if (random.nextFloat() < randomSkewChance) {
   116	         return List.of(below);
   117	      } else {
   118	         return random.nextBoolean() ? List.of(nextTo) : List.of(below);
   119	      }
   120	   }

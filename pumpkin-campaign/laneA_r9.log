   207	    #[expect(clippy::too_many_arguments)]
   208	    pub fn generate_square_with_hanging_leaves<T: LeaveValidator, T2: GenerationCache>(
   209	        foliage_positions: &mut Vec<BlockPos>,
   210	        validator: &T,
   211	        chunk: &mut T2,
   212	        random: &mut RandomGenerator,
   213	        center_pos: BlockPos,
   214	        radius: i32,
   215	        y: i32,
   216	        giant_trunk: bool,
   217	        foliage_provider: &BlockState,
   218	        hanging_leaves_chance: f32,
   219	        hanging_leaves_extension_chance: f32,
   220	    ) {
   221	        Self::generate_square(
   222	            foliage_positions,
   223	            validator,
   224	            chunk,
   225	            random,
   226	            center_pos,
   227	            radius,
   228	            y,
   229	            giant_trunk,
   230	            foliage_provider,
   231	        );
   232	
   233	        let i = i32::from(giant_trunk);
   234	        let log_pos = center_pos.down();
   235	
   236	        let directions = [
   237	            BlockDirection::North,
   238	            BlockDirection::South,
   239	            BlockDirection::East,
   240	            BlockDirection::West,
   241	        ];
   242	
   243	        for along_edge in directions {
   244	            let to_edge = along_edge.rotate_clockwise();
   245	
   246	            let offset_to_edge = if to_edge.positive() {
   247	                radius + i
   248	            } else {
   249	                radius
   250	            };
   251	
   252	            let mut pos = center_pos
   253	                .add(0, y - 1, 0)
   254	                .offset_dir(to_edge.to_offset(), offset_to_edge)
   255	                .offset_dir(along_edge.to_offset(), -radius);
   256	
   257	            for _ in -radius..(radius + i) {
   258	                let leaves_above = Self::is_set(chunk, pos.up(), foliage_provider);
   259	                if leaves_above
   260	                    && Self::try_place_extension(
   261	                        foliage_positions,
   262	                        chunk,
   263	                        random,
   264	                        hanging_leaves_chance,
   265	                        log_pos,
   266	                        pos,
   267	                        foliage_provider,
   268	                    )
   269	                {
   270	                    Self::try_place_extension(
   271	                        foliage_positions,
   272	                        chunk,
   273	                        random,
   274	                        hanging_leaves_extension_chance,
   275	                        log_pos,
   276	                        pos.down(),
   277	                        foliage_provider,
   278	                    );
   279	                }
   280	                pos = pos.offset_dir(along_edge.to_offset(), 1);
   281	            }
   282	        }
   283	    }
   284	}

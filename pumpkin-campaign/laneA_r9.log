    18	impl ChorusPlantFeature {
    19	    pub fn generate<T: GenerationCache>(
    20	        chunk: &mut T,
    21	        _min_y: i8,
    22	        _height: u16,
    23	        _feature: pumpkin_data::placed_feature::PlacedFeature,
    24	        random: &mut RandomGenerator,
    25	        pos: BlockPos,
    26	    ) -> bool {
    27	        let origin = pos.0;
    28	
    29	        // Must be an empty block placed on a supports_chorus_plant block (end_stone)
    30	        if !chunk.is_air(&origin) {
    31	            return false;
    32	        }
    33	        let below = pos.down().0;
    34	        let below_id = GenerationCache::get_block_state(chunk, &below).to_block_id();
    35	        if !below_id.has_tag(tag::Block::MINECRAFT_SUPPORTS_CHORUS_PLANT) {
    36	            return false;
    37	        }
    38	
    39	        // Place the base chorus plant with connections, then grow the tree
    40	        set_chorus_plant(chunk, &pos);
    41	        grow_tree_recursive(chunk, random, &pos, &pos, 8, 0);
    42	        true
    43	    }
    44	}

   667	            let is_sign_applicator = pumpkin_item
   668	                .as_any()
   669	                .downcast_ref::<HoneyCombItem>()
   670	                .is_some()
   671	                || pumpkin_item
   672	                    .as_any()
   673	                    .downcast_ref::<GlowingInkSacItem>()
   674	                    .is_some()

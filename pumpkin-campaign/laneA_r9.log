   648	            let Some(block_entity) = args.world.get_block_entity(args.position) else {
   649	                return BlockActionResult::Pass;
   650	            };
   651	            let Some(sign_entity) = as_sign_text_access(block_entity.as_any()) else {
   652	                return BlockActionResult::Pass;
   653	            };
   654	
   655	            if sign_entity.sign_is_waxed() {
   656	                return BlockActionResult::PassToDefaultBlockAction;
   657	            }
   658	
   659	            let Some(pumpkin_item) = args
   660	                .server
   661	                .item_registry
   662	                .get_pumpkin_item(args.item_stack.item.id)
   663	            else {
   664	                return BlockActionResult::PassToDefaultBlockAction;
   665	            };

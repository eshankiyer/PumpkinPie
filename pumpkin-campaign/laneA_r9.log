   165	    async fn try_spreading_fire(&self, world: &Arc<World>, pos: &BlockPos, chance: i32, age: u8) {
   166	        let block = world.get_block(pos);
   167	        let odds = Self::get_burn_odds(block);
   168	        if rand::rng().random_range(0..chance) < odds {
   169	            let old_block = block;
   170	            // Bound the `Rng` temporary to a statement so it is not held across the
   171	            // `is_near_rain` await point.
   172	            let can_persist = rand::rng().random_range(0..(age + 10) as i32) < 5;
   173	            // Vanilla `FireBlock#checkBurnOut` tests this position only; the
   174	            // five position `isNearRain` form is used for spreading.
   175	            if can_persist && !world.is_raining_at(pos).await {
   176	                let new_age = (age + (rand::rng().random_range(0..5) / 4)).min(15) as u8;
   177	                let state_id = self.get_state_for_position(world.as_ref(), &Block::FIRE, pos);
   178	                let mut fire_props = FireProperties::from_state_id(state_id, &Block::FIRE);
   179	                fire_props.age = new_age;
   180	                let new_state_id = fire_props.to_state_id(&Block::FIRE);
   181	                world
   182	                    .set_block_state(pos, new_state_id, BlockFlags::NOTIFY_NEIGHBORS)
   183	                    .await;
   184	            } else {
   185	                let mut burn_event = crate::plugin::block::block_burn::BlockBurnEvent {
   186	                    igniting_block: &Block::FIRE,
   187	                    block: old_block,
   188	                    cancelled: false,
   189	                };
   190	                if let Some(server) = world.server.upgrade() {
   191	                    server.plugin_manager.fire(&server, &mut burn_event).await;
   192	                }
   193	                if burn_event.cancelled {
   194	                    return;
   195	                }
   196	                world
   197	                    .set_block_state(
   198	                        pos,
   199	                        Block::AIR.default_state.id,
   200	                        BlockFlags::NOTIFY_NEIGHBORS,
   201	                    )
   202	                    .await;
   203	            }
   204	
   205	            if old_block == &Block::TNT {
   206	                TNTBlock::prime(world, pos).await;
   207	            }
   208	        }
   209	    }
   210	}

    10	pub struct DiskFeature {
    11	    pub state_provider: BlockStateProvider,
    12	    pub target: BlockPredicate,
    13	    pub radius: IntProvider,
    14	    pub half_height: i32,
    15	}
    16	
    17	impl DiskFeature {
    18	    #[expect(clippy::too_many_arguments)]
    19	    pub fn generate<T: GenerationCache>(
    20	        &self,
    21	        chunk: &mut T,
    22	        block_registry: &dyn WorldPortalExt,
    23	        _min_y: i8,
    24	        _height: u16,
    25	        _feature: pumpkin_data::placed_feature::PlacedFeature,
    26	        random: &mut RandomGenerator,
    27	        pos: BlockPos,
    28	    ) -> bool {
    29	        let mut placed_any = false;
    30	        let origin_y = pos.0.y;
    31	        let top = origin_y + self.half_height;
    32	        let bottom = origin_y - self.half_height - 1;
    33	        let r = self.radius.get(random);
    34	
    35	        for column_pos in BlockPos::iterate(pos.add(-r, 0, -r), pos.add(r, 0, r)) {
    36	            let xd = column_pos.0.x - pos.0.x;
    37	            let zd = column_pos.0.z - pos.0.z;
    38	            if xd * xd + zd * zd <= r * r {
    39	                placed_any |= self.place_column(
    40	                    chunk,
    41	                    block_registry,
    42	                    random,
    43	                    top,
    44	                    bottom,
    45	                    column_pos.0.x,
    46	                    column_pos.0.z,
    47	                );
    48	            }
    49	        }
    50	
    51	        placed_any
    52	    }
    53	
    54	    #[expect(clippy::too_many_arguments)]
    55	    fn place_column<T: GenerationCache>(
    56	        &self,
    57	        chunk: &mut T,
    58	        block_registry: &dyn WorldPortalExt,
    59	        random: &mut RandomGenerator,
    60	        top: i32,
    61	        bottom: i32,
    62	        column_x: i32,
    63	        column_z: i32,
    64	    ) -> bool {
    65	        let mut placed_any = false;
    66	
    67	        let mut y = top;
    68	        while y > bottom {
    69	            let cur_pos = BlockPos::new(column_x, y, column_z);
    70	            if self.target.test(block_registry, chunk, &cur_pos) {
    71	                let state =
    72	                    self.state_provider
    73	                        .get_with_context(block_registry, chunk, random, cur_pos);
    74	                chunk.set_block_state(&cur_pos.0, state);
    75	                placed_any = true;
    76	            }
    77	            y -= 1;
    78	        }
    79	
    80	        placed_any
    81	    }
    82	}

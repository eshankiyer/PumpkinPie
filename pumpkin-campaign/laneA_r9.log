    10	mod size;
    11	
    12	/// Proof that [`GenerationCache`] is implementable without a [`ProtoChunk`].
    13	///
    14	/// The runtime-placement blocker recorded for this repo was that `Feature::generate` needs a
    15	/// cache whose contract includes `get_center_chunk_mut() -> &mut ProtoChunk`, which a live
    16	/// `World` cannot supply. That method now lives on `ProtoChunkCache`, and no feature calls it -
    17	/// vanilla features take a `WorldGenLevel`, which `ServerLevel` implements too. `FlatWorld` is
    18	/// exactly the shape a live-world adapter would take: a flat block store, no chunks.
    19	#[cfg(test)]
    20	mod runtime_placement {
    21	    use pumpkin_data::Block;
    22	    use pumpkin_util::math::position::BlockPos;
    23	    use pumpkin_util::math::vector3::Vector3;
    24	    use pumpkin_util::random::{RandomGenerator, xoroshiro128::Xoroshiro};
    25	
    26	    use super::features::void_start_platform::VoidStartPlatformFeature;
    27	    use crate::generation::proto_chunk::GenerationCache;
    28	    use crate::generation::proto_chunk::test_cache::FlatWorld;
    29	
    30	    #[test]
    31	    fn a_feature_places_through_a_chunkless_cache() {
    32	        let mut world = FlatWorld::default();
    33	        let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(1));
    34	        let origin = BlockPos::new(100, 70, -33);
    35	
    36	        let placed = VoidStartPlatformFeature.generate(
    37	            &mut world,
    38	            -64,
    39	            384,
    40	            pumpkin_data::placed_feature::PlacedFeature::Acacia,
    41	            &mut random,
    42	            origin,
    43	        );
    44	
    45	        assert!(placed);
    46	        assert_eq!(world.blocks.len(), 9);
    47	        for dx in -1..=1 {
    48	            for dz in -1..=1 {
    49	                let pos = Vector3::new(origin.0.x + dx, origin.0.y, origin.0.z + dz);
    50	                assert_eq!(
    51	                    GenerationCache::get_block_state(&world, &pos),
    52	                    Block::OBSIDIAN.default_state.id,
    53	                    "expected obsidian at {pos:?}"
    54	                );
    55	            }
    56	        }
    57	    }
    58	}


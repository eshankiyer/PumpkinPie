   787	            facing.z,
   788	            Self::FIREBALL_PROJECTILE_POWER,
   789	            Self::FIREBALL_PROJECTILE_UNCERTAINTY,
   790	        );
   791	        Self::finish_projectile_launch(ctx, Arc::new(fireball), WorldEvent::SoundBlazeFireball)
   792	            .await;
   793	    }

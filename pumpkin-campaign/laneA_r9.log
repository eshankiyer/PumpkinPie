    16	    async fn teleport(&self, world: &Arc<World>, pos: &BlockPos, state_id: BlockStateId) {
    17	        let min_y = world.dimension.min_y;
    18	        let max_y = min_y + world.dimension.height;
    19	        for _ in 0..1000 {
    20	            let (x, y, z) = {
    21	                let mut rng = rng();
    22	                (
    23	                    pos.0.x + rng.random_range(0..16) - rng.random_range(0..16),
    24	                    pos.0.y + rng.random_range(0..8) - rng.random_range(0..8),
    25	                    pos.0.z + rng.random_range(0..16) - rng.random_range(0..16),
    26	                )
    27	            };
    28	            if y < min_y || y >= max_y {
    29	                continue;
    30	            }
    31	            let test_pos = BlockPos::new(x, y, z);
    32	
    33	            let state = world.get_block_state(&test_pos);
    34	            let below_state = world.get_block_state(&test_pos.down());
    35	
    36	            if state.is_air()
    37	                && !below_state.is_air()
    38	                && world.worldborder.lock().await.contains_block(x, z)
    39	            {
    40	                world
    41	                    .set_block_state(
    42	                        &test_pos,
    43	                        state_id,
    44	                        pumpkin_world::world::BlockFlags::NOTIFY_LISTENERS,
    45	                    )
    46	                    .await;

   751	        let projectile = item.split(1);
   752	        let entity = Entity::new(
   753	            ctx.world.clone(),
   754	            Self::projectile_spawn_position(ctx),
   755	            &EntityType::LINGERING_POTION,
   756	        );
   757	        let potion = LingeringPotionEntity::new(entity);
   758	        potion.set_item_stack(projectile).await;
   759	        Self::launch_thrown(
   760	            ctx,
   761	            &potion.thrown,
   762	            Self::POTION_PROJECTILE_POWER,
   763	            Self::POTION_PROJECTILE_UNCERTAINTY,
   764	        );
   765	        Self::finish_projectile_launch(
   766	            ctx,
   767	            Arc::new(potion),
   768	            WorldEvent::SoundDispenserProjectileLaunch,
   769	        )
   770	        .await;
   771	    }
   772	
   773	    async fn dispense_fire_charge(ctx: &DispenseContext<'_>, item: &mut ItemStack) {
   774	        let _ = item.split(1);
   775	        let entity = Entity::new(
   776	            ctx.world.clone(),
   777	            Self::projectile_spawn_position(ctx),
   778	            &EntityType::SMALL_FIREBALL,
   779	        );
   780	        let fireball = SmallFireballEntity::new(entity);
   781	        // Vanilla aims fire charges straight along the facing axis, without the +0.1 Y bias
   782	        // other projectiles get.
   783	        let facing = to_normal(ctx.facing);
   784	        fireball.thrown.set_velocity(
   785	            facing.x,

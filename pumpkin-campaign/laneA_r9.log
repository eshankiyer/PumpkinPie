   802	fn compute_chest_props(
   803	    world: &World,
   804	    player: &Player,
   805	    block: &Block,
   806	    block_pos: &BlockPos,
   807	    face: BlockDirection,
   808	    copper: bool,
   809	) -> (ChestType, HorizontalFacing) {
   810	    let player_facing = player.get_entity().get_horizontal_facing();
   811	    let chest_facing = player_facing.opposite();
   812	
   813	    if player.get_entity().pose.load() == EntityPose::Crouching {
   814	        let Some(face) = face.to_horizontal_facing() else {
   815	            return (ChestType::Single, chest_facing);
   816	        };
   817	
   818	        let (clicked_block, clicked_block_state) =
   819	            world.get_block_and_state_id(&block_pos.offset(face.to_offset()));
   820	
   821	        if can_connect_chests(block, clicked_block, copper) {
   822	            let clicked_props =
   823	                ChestLikeProperties::from_state_id(clicked_block_state, clicked_block);
   824	
   825	            if clicked_props.r#type != ChestType::Single {
   826	                return (ChestType::Single, chest_facing);
   827	            }
   828	
   829	            if clicked_props.facing.rotate_clockwise() == face {
   830	                return (ChestType::Left, clicked_props.facing);
   831	            } else if clicked_props.facing.rotate_counter_clockwise() == face {
   832	                return (ChestType::Right, clicked_props.facing);
   833	            }
   834	        }
   835	
   836	        return (ChestType::Single, chest_facing);
   837	    }
   838	
   839	    if get_chest_properties_if_can_connect(
   840	        world,
   841	        block,
   842	        block_pos,
   843	        chest_facing,
   844	        chest_facing.rotate_clockwise(),
   845	        ChestType::Single,
   846	        copper,
   847	    )
   848	    .is_some()
   849	    {
   850	        (ChestType::Left, chest_facing)
   851	    } else if get_chest_properties_if_can_connect(
   852	        world,
   853	        block,
   854	        block_pos,
   855	        chest_facing,
   856	        chest_facing.rotate_counter_clockwise(),
   857	        ChestType::Single,
   858	        copper,
   859	    )
   860	    .is_some()
   861	    {
   862	        (ChestType::Right, chest_facing)
   863	    } else {
   864	        (ChestType::Single, chest_facing)
   865	    }
   866	}
   867	
   868	fn get_chest_properties_if_can_connect(
   869	    world: &World,
   870	    block: &Block,
   871	    block_pos: &BlockPos,
   872	    facing: HorizontalFacing,
   873	    direction: HorizontalFacing,
   874	    wanted_type: ChestType,
   875	    copper: bool,
   876	) -> Option<ChestLikeProperties> {
   877	    let (neighbor_block, neighbor_block_state) =
   878	        world.get_block_and_state_id(&block_pos.offset(direction.to_offset()));
   879	
   880	    if !can_connect_chests(block, neighbor_block, copper) {
   881	        return None;
   882	    }
   883	
   884	    let neighbor_props = ChestLikeProperties::from_state_id(neighbor_block_state, neighbor_block);
   885	    if neighbor_props.facing == facing && neighbor_props.r#type == wanted_type {
   886	        return Some(neighbor_props);
   887	    }
   888	
   889	    None
   890	}

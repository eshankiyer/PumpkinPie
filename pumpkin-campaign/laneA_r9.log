   251	    /// `ConduitBlockEntity.applyEffects`
   252	    async fn apply_effects(&self, world: &Arc<World>) {
   253	        let active_size = self.effect_blocks.lock().await.len() as i32;
   254	        let effect_range = f64::from(active_size / 7 * 16);
   255	        if effect_range <= 0.0 {
   256	            return;
   257	        }
   258	
   259	        let bb = BoundingBox::from_block(&self.position)
   260	            .expand(effect_range, effect_range, effect_range)
   261	            .expand_towards(0.0, f64::from(world.dimension.height), 0.0);
   262	
   263	        for player in world.get_players_at_box(&bb) {
   264	            let player_pos = player.living_entity.entity.block_pos.load();
   265	            let close_enough =
   266	                self.position.squared_distance(&player_pos) < (effect_range * effect_range) as i32;
   267	            if close_enough && is_wet(&player.living_entity, world).await {
   268	                player
   269	                    .add_effect(Effect {
   270	                        effect_type: &StatusEffect::CONDUIT_POWER,
   271	                        duration: CONDUIT_POWER_DURATION,
   272	                        amplifier: 0,
   273	                        ambient: true,
   274	                        show_particles: true,
   275	                        show_icon: true,
   276	                        blend: false,
   277	                    })
   278	                    .await;
   279	            }
   280	        }
   281	    }

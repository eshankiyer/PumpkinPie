   196	            self.internal_on_slot_click(slot_index, button, action_type, player)
   197	                .await;
   198	            if (0..4).contains(&slot_index) {
   199	                self.update_output().await;
   200	            }
   201	        })
   202	    }
   203	
   204	    fn quick_move<'a>(
   205	        &'a mut self,
   206	        player: &'a dyn InventoryPlayer,
   207	        slot_index: i32,
   208	    ) -> ScreenHandlerFuture<'a, ItemStack> {
   209	        Box::pin(async move {
   210	            let mut stack = ItemStack::EMPTY.clone();
   211	            let slot = self.get_behaviour().slots.get(slot_index as usize).cloned();
   212	
   213	            if let Some(slot) = slot {
   214	                let mut slot_stack = slot.get_cloned_stack().await;
   215	                if !slot_stack.is_empty() {
   216	                    stack = slot_stack.clone();
   217	                    if slot_index < 4 {
   218	                        if !self.insert_item(&mut slot_stack, 4, 40, true).await {
   219	                            return ItemStack::EMPTY.clone();
   220	                        }
   221	                        slot.on_quick_move_crafted(slot_stack.clone(), stack.clone())
   222	                            .await;
   223	                    } else if self.can_move_into_input_slots(&slot_stack).await
   224	                        && (4..40).contains(&slot_index)
   225	                    {
   226	                        if !self.insert_item(&mut slot_stack, 0, 3, false).await {
   227	                            return ItemStack::EMPTY.clone();
   228	                        }
   229	                    } else if (4..31).contains(&slot_index) {
   230	                        // Main inventory -> hotbar (`ItemCombinerMenu.java:137-140`).
   231	                        if !self.insert_item(&mut slot_stack, 31, 40, false).await {
   232	                            return ItemStack::EMPTY.clone();
   233	                        }
   234	                    } else if (31..40).contains(&slot_index)
   235	                        && !self.insert_item(&mut slot_stack, 4, 31, false).await
   236	                    {
   237	                        // Hotbar -> main inventory (`ItemCombinerMenu.java:141-144`).
   238	                        return ItemStack::EMPTY.clone();
   239	                    }
   240	
   241	                    let moved_count = stack.item_count - slot_stack.item_count;
   242	                    if slot_stack.is_empty() {
   243	                        slot.set_stack(ItemStack::EMPTY.clone()).await;
   244	                    } else {
   245	                        slot.set_stack(slot_stack).await;
   246	                    }
   247	
   248	                    if slot_index == 3 {
   249	                        let mut taken_stack = stack.clone();
   250	                        taken_stack.set_count(moved_count);
   251	                        slot.on_take_item(player, &taken_stack).await;
   252	                    }
   253	
   254	                    self.update_output().await;
   255	                }
   256	            }
   257	            stack
   258	        })
   259	    }
   260	}

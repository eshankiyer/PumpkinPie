   116	
   117	fn random_tag_block(ids: &[u16], random: &mut RandomGenerator) -> Option<&'static Block> {
   118	    if ids.is_empty() {
   119	        return None;
   120	    }
   121	    let index = random.next_bounded_i32(i32::try_from(ids.len()).ok()?) as usize;
   122	    Some(Block::from_id(BlockId::new_or_air(ids[index])))
   123	}
   124	
   125	fn can_survive(
   126	    world: &Arc<World>,
   127	    server: &Server,
   128	    block: &'static Block,
   129	    state_id: BlockStateId,
   130	    pos: &BlockPos,
   131	) -> bool {
   132	    server.block_registry.can_place_at(
   133	        Some(server),
   134	        Some(world),
   135	        world.as_ref(),
   136	        None,
   137	        block,
   138	        BlockState::from_id(state_id),
   139	        pos,
   140	        None,
   141	        None,
   142	    )
   143	}
   144	
   145	/// Vanilla `BoneMealItem.growWaterPlant` (BoneMealItem.java:81-142): 128 attempts spreading out
   146	/// from the clicked water block, placing seagrass, or coral in biomes tagged
   147	/// `produces_corals_from_bonemeal`, and bone-mealing existing seagrass one time in ten.
   148	async fn grow_water_plant(
   149	    world: &Arc<World>,
   150	    server: &Server,
   151	    pos: BlockPos,
   152	    clicked_face: BlockDirection,
   153	) -> bool {
   154	    if !is_water_source(world, &pos) {
   155	        return false;
   156	    }
   157	
   158	    let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(get_seed()));
   159	
   160	    'attempt: for j in 0..128 {
   161	        let mut test_pos = pos;
   162	        let mut grow_block: &'static Block = &Block::SEAGRASS;
   163	        let mut grow_state = Block::SEAGRASS.default_state.id;
   164	
   165	        for _ in 0..(j / 16) {
   166	            test_pos = BlockPos(test_pos.0.add_raw(
   167	                random.next_bounded_i32(3) - 1,
   168	                (random.next_bounded_i32(3) - 1) * random.next_bounded_i32(3) / 2,
   169	                random.next_bounded_i32(3) - 1,
   170	            ));
   171	            if world.get_block_state(&test_pos).is_full_cube() {
   172	                continue 'attempt;
   173	            }
   174	        }
   175	
   176	        let produces_corals = world.get_biome(&test_pos).is_some_and(|biome| {
   177	            biome.has_tag(&tag::WorldgenBiome::MINECRAFT_PRODUCES_CORALS_FROM_BONEMEAL)
   178	        });
   179	        if produces_corals {
   180	            if j == 0 && clicked_face.is_horizontal() {
   181	                if let Some(coral) =
   182	                    random_tag_block(tag::Block::MINECRAFT_WALL_CORALS.1, &mut random)
   183	                {
   184	                    grow_block = coral;
   185	                    grow_state = wall_fan_with_facing(coral, clicked_face);
   186	                }
   187	            } else if random.next_bounded_i32(4) == 0
   188	                && let Some(plant) =
   189	                    random_tag_block(tag::Block::MINECRAFT_UNDERWATER_BONEMEALS.1, &mut random)
   190	            {
   191	                grow_block = plant;
   192	                // Corals and coral fans are placed into a water source, so they must be
   193	                // waterlogged or the water is destroyed (vanilla's default states carry
   194	                // WATERLOGGED = true).
   195	                grow_state = set_waterlogged(plant, plant.default_state.id, true);
   196	            }
   197	        }
   198	
   199	        // BoneMealItem.java:118-122: a wall fan is turned until it finds a wall to attach to,
   200	        // giving up after four tries.
   201	        if grow_block.has_tag(&tag::Block::MINECRAFT_WALL_CORALS) {
   202	            let mut tries = 0;
   203	            while tries < 4 && !can_survive(world, server, grow_block, grow_state, &test_pos) {
   204	                let facing =
   205	                    BlockDirection::horizontal_worldgen()[random.next_bounded_i32(4) as usize];
   206	                grow_state = wall_fan_with_facing(grow_block, facing.to_block_direction());
   207	                tries += 1;
   208	            }
   209	        }
   210	
   211	        if !can_survive(world, server, grow_block, grow_state, &test_pos) {
   212	            continue;
   213	        }
   214	
   215	        if is_water_source(world, &test_pos) {
   216	            world
   217	                .set_block_state(&test_pos, grow_state, BlockFlags::NOTIFY_ALL)
   218	                .await;
   219	        } else {
   220	            let test_state_id = world.get_block_state_id(&test_pos);
   221	            if Block::from_state_id(test_state_id).id == Block::SEAGRASS.id
   222	                && random.next_bounded_i32(10) == 0
   223	            {
   224	                server
   225	                    .block_registry
   226	                    .bone_meal(&Block::SEAGRASS, world, &test_pos, test_state_id)
   227	                    .await;
   228	            }
   229	        }
   230	    }
   231	
   232	    true
   233	}


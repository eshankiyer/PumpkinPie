   168	pub struct SpiderEntity {
   169	    pub mob_entity: MobEntity,
   170	}
   171	
   172	impl SpiderEntity {
   173	    pub fn new(entity: Entity) -> Arc<Self> {
   174	        let mob_entity = MobEntity::new(entity);
   175	        mob_entity.navigator.lock().unwrap().set_wall_climber(true);
   176	        let spider = Self { mob_entity };
   177	        let mob_arc = Arc::new(spider);
   178	        let mob_weak: Weak<dyn Mob> = {
   179	            let mob_arc: Arc<dyn Mob> = mob_arc.clone();
   180	            Arc::downgrade(&mob_arc)
   181	        };
   182	
   183	        {
   184	            let mut goal_selector = mob_arc
   185	                .mob_entity
   186	                .goals_selector
   187	                .lock()
   188	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   189	            let mut target_selector = mob_arc
   190	                .mob_entity
   191	                .target_selector
   192	                .lock()
   193	                .unwrap_or_else(std::sync::PoisonError::into_inner);
   194	
   195	            goal_selector.add_goal(1, Box::new(SwimGoal::default()));
   196	            // Spider.java:59: `AvoidEntityGoal<>(this, Armadillo.class, 6.0F, 1.0, 1.2,
   197	            // entity -> !((Armadillo)entity).isScared())`. Also covers CaveSpider, which
   198	            // shares this goal selector via `SpiderEntity::new`. The `!isScared()` predicate
   199	            // is not ported: Pumpkin's ArmadilloEntity does not expose curl/scare state
   200	            // outside `ArmadilloCurlUpGoal`'s own private field, so it is deferred.
   201	            // Priorities 3/4 below (leap/attack) are bumped by one from their prior 2/3 to
   202	            // keep vanilla's exact ordering (Float=1, Avoid=2, Leap=3, Attack=4) now that
   203	            // priority 2 is taken by this goal.
   204	            goal_selector.add_goal(
   205	                2,
   206	                Box::new(AvoidEntityGoal::new(&EntityType::ARMADILLO, 6.0, 1.0, 1.2)),
   207	            );
   208	            goal_selector.add_goal(3, Box::new(SpiderLeapGoal));
   209	            goal_selector.add_goal(4, Box::new(SpiderAttackGoal::new()));
   210	            // Spider.java:62: `WaterAvoidingRandomStrollGoal(this, 0.8)`.
   211	            goal_selector.add_goal(5, Box::new(WanderAroundGoal::new_water_avoiding(0.8)));
   212	            goal_selector.add_goal(
   213	                6,
   214	                LookAtEntityGoal::with_default(mob_weak, &EntityType::PLAYER, 8.0),
   215	            );
   216	            goal_selector.add_goal(6, Box::new(RandomLookAroundGoal::default()));
   217	
   218	            target_selector.add_goal(1, Box::new(RevengeGoal::new(true)));
   219	            target_selector.add_goal(
   220	                2,
   221	                Box::new(SpiderTargetGoal::new(
   222	                    &mob_arc.mob_entity,
   223	                    &EntityType::PLAYER,
   224	                )),
   225	            );
   226	            target_selector.add_goal(
   227	                3,
   228	                Box::new(SpiderTargetGoal::new(
   229	                    &mob_arc.mob_entity,
   230	                    &EntityType::IRON_GOLEM,
   231	                )),
   232	            );
   233	        };
   234	
   235	        mob_arc
   236	    }
   237	}

    54	/// `GossipContainer.DISCARD_THRESHOLD` (`GossipContainer.java:32`).
    55	pub const DISCARD_THRESHOLD: i32 = 2;
    56	
    57	/// Rust port of vanilla's `GossipContainer` (`GossipContainer.java`): per-target-UUID,
    58	/// per-type reputation entries with decay and a weighted-random transfer mechanic.
    59	#[derive(Default)]
    60	pub struct GossipContainer {
    61	    entries: HashMap<Uuid, HashMap<GossipType, i32>>,
    62	}
    63	
    64	impl GossipContainer {
    65	    #[must_use]
    66	    pub fn new() -> Self {
    67	        Self::default()
    68	    }
    69	
    70	    #[must_use]
    71	    pub const fn from_raw(entries: HashMap<Uuid, HashMap<GossipType, i32>>) -> Self {
    72	        Self { entries }
    73	    }
    74	
    75	    #[must_use]
    76	    pub const fn raw(&self) -> &HashMap<Uuid, HashMap<GossipType, i32>> {
    77	        &self.entries
    78	    }
    79	
    80	    /// `GossipContainer::add` (`GossipContainer.java:117-124`), inlining
    81	    /// `mergeValuesForAddition` and `makeSureValueIsntTooLowOrTooHigh`.
    82	    pub fn add(&mut self, target: Uuid, gossip_type: GossipType, amount_to_add: i32) {
    83	        let max = gossip_type.data().max;
    84	        let entity_entries = self.entries.entry(target).or_default();
    85	        let old_value = entity_entries.get(&gossip_type).copied().unwrap_or(0);
    86	        let sum = old_value + amount_to_add;
    87	        let merged = if sum > max { max.max(old_value) } else { sum };
    88	
    89	        if merged > max {
    90	            entity_entries.insert(gossip_type, max);
    91	        } else if merged < DISCARD_THRESHOLD {
    92	            entity_entries.remove(&gossip_type);
    93	        } else {
    94	            entity_entries.insert(gossip_type, merged);
    95	        }
    96	
    97	        if entity_entries.is_empty() {
    98	            self.entries.remove(&target);
    99	        }
   100	    }
   101	
   102	    /// `GossipContainer::getReputation` (`GossipContainer.java:108-111`), weighted sum
   103	    /// over the entries matching `include`.
   104	    #[must_use]
   105	    pub fn get_reputation(&self, target: Uuid, mut include: impl FnMut(GossipType) -> bool) -> i32 {
   106	        self.entries.get(&target).map_or(0, |types| {
   107	            types
   108	                .iter()
   109	                .filter(|(t, _)| include(**t))
   110	                .map(|(t, v)| v * t.data().weight)
   111	                .sum()
   112	        })
   113	    }
   114	
   115	    /// `GossipContainer.getCountForType` (`GossipContainer.java:113-115`).
   116	    #[must_use]
   117	    pub fn get_count_for_type(
   118	        &self,
   119	        gossip_type: GossipType,
   120	        mut value_test: impl FnMut(i32) -> bool,
   121	    ) -> usize {
   122	        self.entries
   123	            .values()
   124	            .filter(|types| {
   125	                value_test(
   126	                    types.get(&gossip_type).copied().unwrap_or(0) * gossip_type.data().weight,
   127	                )
   128	            })
   129	            .count()
   130	    }
   131	
   132	    /// `GossipContainer.putAll` (`GossipContainer.java:156-158`).
   133	    pub fn put_all(&mut self, container: &Self) {
   134	        for (target, gossips) in &container.entries {
   135	            self.entries
   136	                .entry(*target)
   137	                .or_default()
   138	                .extend(gossips.iter().map(|(kind, value)| (*kind, *value)));
   139	        }
   140	    }
   141	
   142	    /// `EntityGossips::decay` (`GossipContainer.java:191-203`).
   143	    pub fn decay(&mut self) {
   144	        self.entries.retain(|_, types| {
   145	            types.retain(|t, v| {
   146	                *v -= t.data().decay_per_day;
   147	                *v >= DISCARD_THRESHOLD
   148	            });
   149	            !types.is_empty()
   150	        });
   151	    }
   152	
   153	    /// `GossipContainer::transferFrom` (`GossipContainer.java:98-106`) plus
   154	    /// `selectGossipsForTransfer` (`GossipContainer.java:68-92`): picks `max_count`
   155	    /// weighted-random entries from `source` (weight = `|value * type.weight|`) and merges
   156	    /// their decayed value into `self` via `max(old, new)`. Invoked from
   157	    /// `VillagerEntity::gossip_with` (`entity/passive/villager/mod.rs`).
   158	    pub fn transfer_from(&mut self, source: &Self, rng: &mut impl Rng, max_count: usize) {
   159	        let flat: Vec<(Uuid, GossipType, i32)> = source
   160	            .entries
   161	            .iter()
   162	            .flat_map(|(uuid, types)| types.iter().map(|(t, v)| (*uuid, *t, *v)))
   163	            .collect();
   164	        if flat.is_empty() {
   165	            return;
   166	        }
   167	
   168	        let mut cumulative: i64 = 0;
   169	        let mut ranges = Vec::with_capacity(flat.len());
   170	        for (_, t, v) in &flat {
   171	            cumulative += i64::from((v * t.data().weight).abs());
   172	            ranges.push(cumulative);
   173	        }
   174	        if cumulative == 0 {
   175	            return;
   176	        }
   177	
   178	        let mut chosen = HashSet::new();
   179	        for _ in 0..max_count {
   180	            let pick = rng.random_range(0..cumulative);
   181	            let idx = ranges.partition_point(|&r| r <= pick);
   182	            chosen.insert(idx.min(flat.len() - 1));
   183	        }
   184	
   185	        for idx in chosen {
   186	            let (uuid, gossip_type, value) = flat[idx];
   187	            let decayed = value - gossip_type.data().decay_per_transfer;
   188	            if decayed >= DISCARD_THRESHOLD {
   189	                let existing = self.entries.entry(uuid).or_default();
   190	                let merged = existing
   191	                    .get(&gossip_type)
   192	                    .copied()
   193	                    .unwrap_or(0)
   194	                    .max(decayed);
   195	                existing.insert(gossip_type, merged);
   196	            }
   197	        }
   198	    }
   199	}
   200	
   201	/// `Villager::updateSpecialPrices` (`Villager.java:442-448`), i.e.
   202	/// `addToSpecialPriceDiff(-Mth.floor(reputation * offer.getPriceMultiplier()))`.

   603	    fn random_tick<'a>(&'a self, args: RandomTickArgs<'a>) -> BlockFuture<'a, ()> {
   604	        Box::pin(async move {
   605	            let current_state_id = args.world.get_block_state_id(args.position);
   606	            let chest_props = ChestLikeProperties::from_state_id(current_state_id, args.block);
   607	
   608	            // Only oxidize LEFT or SINGLE chests (not RIGHT) to prevent double oxidation
   609	            if chest_props.r#type == ChestType::Right {
   610	                return;
   611	            }
   612	
   613	            // Only oxidize if no players are viewing the chest
   614	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   615	                && let Some(chest_entity) = block_entity.as_any().downcast_ref::<ChestBlockEntity>()
   616	                && chest_entity.get_viewer_count() > 0
   617	            {
   618	                return;
   619	            }
   620	
   621	            // Try to oxidize the copper chest
   622	            try_oxidize_copper_chest(args.world, args.position, args.block, chest_props).await;
   623	        })
   624	    }

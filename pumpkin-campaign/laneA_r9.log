   161	/// Randomizes, relaxes, and grounds `pile_count` piles inside `area`.
   162	/// Returns the piles and their standing y coordinates, or `None` if no safe
   163	/// arrangement was found.
   164	async fn find_spread_positions(
   165	    world: &World,
   166	    pile_count: usize,
   167	    spread_distance: f64,
   168	    area: &SpreadArea,
   169	) -> Option<(Vec<Pile>, Vec<i32>)> {
   170	    let mut piles = vec![Pile::default(); pile_count];
   171	    for pile in &mut piles {
   172	        pile.randomize(area.min_x, area.min_z, area.max_x, area.max_z);
   173	    }
   174	
   175	    let mut surface_ys = vec![0; pile_count];
   176	    // A handful of surface retries is plenty; each retry re-runs the
   177	    // full relaxation, so this loop must stay small.
   178	    for _ in 0..16 {
   179	        if !spread_piles(
   180	            &mut piles,
   181	            spread_distance,
   182	            area.min_x,
   183	            area.min_z,
   184	            area.max_x,
   185	            area.max_z,
   186	        ) {
   187	            return None;
   188	        }
   189	
   190	        let mut all_safe = true;
   191	        for (pile, y) in piles.iter_mut().zip(&mut surface_ys) {
   192	            if let Some(surface) = pile.surface_y(world).await {
   193	                *y = surface;
   194	            } else {
   195	                pile.randomize(area.min_x, area.min_z, area.max_x, area.max_z);
   196	                all_safe = false;
   197	            }
   198	        }
   199	        if all_safe {
   200	            return Some((piles, surface_ys));
   201	        }
   202	    }
   203	    None
   204	}

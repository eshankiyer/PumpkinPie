   153	/// `ConcretePowderBlock.shouldSolidify`.
   154	fn should_solidify(accessor: &dyn BlockAccessor, pos: &BlockPos, replaced_is_water: bool) -> bool {
   155	    replaced_is_water || touches_liquid(accessor, pos)
   156	}

   228	impl CommandExecutor for SpreadPlayersExecutor {
   229	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   230	        Box::pin(async move {
   231	            let center = ColumnPosArgumentType::get_column_pos(context, ARG_CENTER)?;
   232	            let spread_distance = f64::from(FloatArgumentType::get(context, ARG_SPREAD_DISTANCE)?);
   233	            let max_range = f64::from(FloatArgumentType::get(context, ARG_MAX_RANGE)?);
   234	            let respect_teams = BoolArgumentType::get(context, ARG_RESPECT_TEAMS)?;
   235	            let targets = EntityArgumentType::get_entities(context, ARG_TARGETS).await?;
   236	
   237	            // Vanilla center-corrects the vec2 argument to the middle of the block.
   238	            let center_x = f64::from(center.0.x) + 0.5;
   239	            let center_z = f64::from(center.0.y) + 0.5;
   240	            let area = SpreadArea {
   241	                min_x: center_x - max_range,
   242	                min_z: center_z - max_range,
   243	                max_x: center_x + max_range,
   244	                max_z: center_z + max_range,
   245	            };
   246	
   247	            // Teams are not implemented yet, so every target is teamless. With
   248	            // respectTeams=true that matches Vanilla's behavior of gathering all
   249	            // teamless entities onto a single position.
   250	            let pile_count = if respect_teams { 1 } else { targets.len() };
   251	
   252	            let world = context.source.world().clone();
   253	
   254	            let Some((piles, surface_ys)) =
   255	                find_spread_positions(&world, pile_count, spread_distance, &area).await
   256	            else {
   257	                let error_type = if respect_teams {
   258	                    &FAILED_TEAMS_ERROR_TYPE
   259	                } else {
   260	                    &FAILED_ENTITIES_ERROR_TYPE
   261	                };
   262	                #[expect(clippy::cast_precision_loss)]
   263	                let suggested = max_range / (pile_count as f64).sqrt();
   264	                return Err(error_type.create_without_context(
   265	                    TextComponent::text(pile_count.to_string()),
   266	                    TextComponent::text(format!("{center_x:.2}")),
   267	                    TextComponent::text(format!("{center_z:.2}")),
   268	                    TextComponent::text(format!("{suggested:.2}")),
   269	                ));
   270	            };
   271	
   272	            for (index, target) in targets.iter().enumerate() {
   273	                let pile = piles[index % pile_count];
   274	                let y = surface_ys[index % pile_count];
   275	                target
   276	                    .clone()
   277	                    .teleport(
   278	                        Vector3::new(pile.x.floor() + 0.5, f64::from(y), pile.z.floor() + 0.5),
   279	                        None,
   280	                        None,
   281	                        world.clone(),
   282	                    )
   283	                    .await;
   284	            }
   285	
   286	            let average_distance = average_min_distance(&piles);
   287	
   288	            let success_key = if respect_teams {
   289	                (
   290	                    translation::java::COMMANDS_SPREADPLAYERS_SUCCESS_TEAMS,
   291	                    translation::java::COMMANDS_SPREADPLAYERS_SUCCESS_TEAMS,
   292	                )
   293	            } else {
   294	                (
   295	                    translation::java::COMMANDS_SPREADPLAYERS_SUCCESS_ENTITIES,
   296	                    translation::java::COMMANDS_SPREADPLAYERS_SUCCESS_ENTITIES,
   297	                )
   298	            };
   299	
   300	            context
   301	                .source
   302	                .send_feedback(
   303	                    TextComponent::translate_cross(
   304	                        success_key.0,
   305	                        success_key.1,
   306	                        [
   307	                            TextComponent::text(pile_count.to_string()),
   308	                            TextComponent::text(format!("{center_x:.2}")),
   309	                            TextComponent::text(format!("{center_z:.2}")),
   310	                            TextComponent::text(format!("{average_distance:.2}")),
   311	                        ],
   312	                    ),
   313	                    true,
   314	                )
   315	                .await;
   316	
   317	            #[expect(clippy::cast_possible_truncation, clippy::cast_possible_wrap)]

    92	    async fn pick_up_item(&self, entity: &Entity, search_box: &BoundingBox) -> bool {
    93	        let world = entity.world.load();
    94	        for entity in world.get_entities_at_box(search_box) {
    95	            let Some(item) = entity.get_item_entity() else {
    96	                continue;
    97	            };
    98	            let mut stack = item.get_item_stack().lock().await;
    99	            if stack.is_empty() {
   100	                continue;
   101	            }
   102	            let backup = stack.clone();
   103	            let one = stack.split(1);
   104	            if HopperBlockEntity::add_one_item(
   105	                self.inventory.as_ref(),
   106	                self.inventory.as_ref(),
   107	                one,
   108	                &HOPPER_MINECART_SLOTS,
   109	            )
   110	            .await
   111	            {
   112	                if stack.is_empty() {
   113	                    item.get_entity().remove().await;
   114	                }
   115	                return true;
   116	            }
   117	            *stack = backup;
   118	        }
   119	        false
   120	    }

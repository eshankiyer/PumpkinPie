   634	/// Copper oxidation levels with their ordinal values
   635	const COPPER_CHEST_OXIDATION: &[(&Block, &Block, u8)] = &[
   636	    (&Block::COPPER_CHEST, &Block::EXPOSED_COPPER_CHEST, 0),
   637	    (
   638	        &Block::EXPOSED_COPPER_CHEST,
   639	        &Block::WEATHERED_COPPER_CHEST,
   640	        1,
   641	    ),
   642	    (
   643	        &Block::WEATHERED_COPPER_CHEST,
   644	        &Block::OXIDIZED_COPPER_CHEST,
   645	        2,
   646	    ),
   647	];
   648	
   649	/// Try to oxidize a copper chest to its next oxidation level.
   650	/// Uses vanilla's degradation algorithm with neighbor checking.
   651	async fn try_oxidize_copper_chest(
   652	    world: &Arc<World>,
   653	    position: &BlockPos,
   654	    current_block: &Block,
   655	    chest_props: ChestLikeProperties,
   656	) {
   657	    use rand::RngExt;
   658	
   659	    // Base chance per random tick: ~5.69%
   660	    const BASE_DEGRADATION_CHANCE: f32 = 0.056_888_89;
   661	
   662	    // First roll: only ~5.69% chance to even attempt oxidation
   663	    if rand::rng().random::<f32>() >= BASE_DEGRADATION_CHANCE {
   664	        return;
   665	    }
   666	
   667	    // Find the next oxidation level
   668	    let (next_block, current_level) = match COPPER_CHEST_OXIDATION
   669	        .iter()
   670	        .find(|(from, _, _)| *from == current_block)
   671	    {
   672	        Some((_, to, level)) => (*to, *level),
   673	        None => return, // Already fully oxidized or waxed
   674	    };
   675	
   676	    // Scan neighbors in 4-block Manhattan distance to calculate oxidation chance
   677	    // `None` means a lower-level copper neighbour was found, which blocks oxidation.
   678	    let Some((same_level_count, higher_level_count)) =
   679	        copper_weathering::count_neighbor_oxidation_levels(world, position, current_level)
   680	    else {
   681	        return;
   682	    };
   683	
   684	    // Calculate weighted probability: ((higher + 1) / (higher + same + 1))^2 * multiplier
   685	    let ratio =
   686	        (higher_level_count + 1) as f32 / (higher_level_count + same_level_count + 1) as f32;
   687	    // Multiplier is 0.75 for UNAFFECTED (level 0), 1.0 for others
   688	    let multiplier = if current_level == 0 { 0.75 } else { 1.0 };
   689	    let final_chance = ratio * ratio * multiplier;
   690	
   691	    if rand::rng().random::<f32>() >= final_chance {
   692	        return;
   693	    }
   694	
   695	    // Apply oxidation with same properties
   696	    let new_state_id = chest_props.to_state_id(next_block);
   697	    world
   698	        .set_block_state(position, new_state_id, BlockFlags::NOTIFY_LISTENERS)
   699	        .await;
   700	}

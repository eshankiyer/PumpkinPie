   411	// Vanilla ChestBlock.updateShape (ChestBlock.java:169-171): a waterlogged chest keeps
   412	// rescheduling its own water fluid tick whenever a neighbor changes.
   413	//
   414	// Synchronous: callers wrap the result in `std::future::ready` to satisfy the trait's
   415	// boxed-future return type.
   416	fn get_state_for_neighbor_update_chest_impl(
   417	    args: &GetStateForNeighborUpdateArgs<'_>,
   418	    copper: bool,
   419	) -> BlockStateId {
   420	    let props = ChestLikeProperties::from_state_id(args.state_id, args.block);
   421	    if props.waterlogged {
   422	        args.world.schedule_fluid_tick(
   423	            &Fluid::WATER,
   424	            *args.position,
   425	            Fluid::WATER.flow_speed as u8,
   426	            TickPriority::Normal,
   427	        );
   428	    }
   429	
   430	    // ChestBlock.updateShape (ChestBlock.java:169-185) combines matching single chests on a
   431	    // horizontal neighbor update and splits a half when its partner is no longer compatible.
   432	    let neighbor_block = args.world.get_block(args.neighbor_position);
   433	    if args.direction.to_horizontal_facing().is_some()
   434	        && can_connect_chests(args.block, neighbor_block, copper)
   435	    {
   436	        let neighbor_props =
   437	            ChestLikeProperties::from_state_id(args.neighbor_state_id, neighbor_block);
   438	        if let Some(r#type) = combined_chest_type(props, neighbor_props, args.direction) {
   439	            let mut combined_props = props;
   440	            combined_props.r#type = r#type;
   441	            return combined_props.to_state_id(args.block);
   442	        }
   443	    } else if connected_direction(props) == args.direction {
   444	        let mut split_props = props;
   445	        split_props.r#type = ChestType::Single;
   446	        return split_props.to_state_id(args.block);
   447	    }
   448	
   449	    args.state_id
   450	}
   451	
   452	// ChestBlock.getConnectedDirection (ChestBlock.java:200-203) maps LEFT clockwise and all other
   453	// chest types counter-clockwise from the facing direction.
   454	fn connected_direction(props: ChestLikeProperties) -> BlockDirection {
   455	    match props.r#type {
   456	        ChestType::Left => props.facing.rotate_clockwise().to_block_direction(),
   457	        ChestType::Right | ChestType::Single => {
   458	            props.facing.rotate_counter_clockwise().to_block_direction()
   459	        }
   460	    }
   461	}
   462	
   463	// ChestBlock.updateShape (ChestBlock.java:173-180): the new half takes the opposite type of the
   464	// existing partner only when both chests face the same way and point at one another.
   465	fn combined_chest_type(
   466	    props: ChestLikeProperties,
   467	    neighbor_props: ChestLikeProperties,
   468	    direction: BlockDirection,
   469	) -> Option<ChestType> {
   470	    (props.r#type == ChestType::Single
   471	        && neighbor_props.r#type != ChestType::Single
   472	        && props.facing == neighbor_props.facing
   473	        && connected_direction(neighbor_props) == direction.opposite())
   474	    .then_some(neighbor_props.r#type.opposite())
   475	}

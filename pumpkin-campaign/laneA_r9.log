    16	pub struct ChorusPlantFeature;
    17	
    18	impl ChorusPlantFeature {
    19	    pub fn generate<T: GenerationCache>(
    20	        chunk: &mut T,
    21	        _min_y: i8,
    22	        _height: u16,
    23	        _feature: pumpkin_data::placed_feature::PlacedFeature,
    24	        random: &mut RandomGenerator,
    25	        pos: BlockPos,
    26	    ) -> bool {
    27	        let origin = pos.0;
    28	
    29	        // Must be an empty block placed on a supports_chorus_plant block (end_stone)
    30	        if !chunk.is_air(&origin) {
    31	            return false;
    32	        }
    33	        let below = pos.down().0;
    34	        let below_id = GenerationCache::get_block_state(chunk, &below).to_block_id();
    35	        if !below_id.has_tag(tag::Block::MINECRAFT_SUPPORTS_CHORUS_PLANT) {
    36	            return false;
    37	        }
    38	
    39	        // Place the base chorus plant with connections, then grow the tree
    40	        set_chorus_plant(chunk, &pos);
    41	        grow_tree_recursive(chunk, random, &pos, &pos, 8, 0);
    42	        true
    43	    }
    44	}
    45	
    46	/// Returns `true` if all four horizontal neighbors of `pos` are air,
    47	/// optionally ignoring one direction (`ignore`).
    48	fn all_neighbors_empty<T: GenerationCache>(
    49	    chunk: &T,
    50	    pos: &BlockPos,
    51	    ignore: Option<HorizontalFacing>,
    52	) -> bool {
    53	    for dir in BlockDirection::horizontal() {
    54	        if Some(dir) == ignore {
    55	            continue;
    56	        }
    57	        if !chunk.is_air(&pos.offset(dir.to_offset()).0) {
    58	            return false;
    59	        }
    60	    }
    61	    true
    62	}
    63	
    64	/// Computes chorus-plant connection state at `pos` and writes it to the chunk.
    65	fn set_chorus_plant<T: GenerationCache>(chunk: &mut T, pos: &BlockPos) {
    66	    let down_id = GenerationCache::get_block_state(chunk, &pos.down().0).to_block_id();
    67	    let up_id = GenerationCache::get_block_state(chunk, &pos.up().0).to_block_id();
    68	    let north_id =
    69	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::North.to_offset()).0)
    70	            .to_block_id();
    71	    let east_id =
    72	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::East.to_offset()).0)
    73	            .to_block_id();
    74	    let south_id =
    75	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::South.to_offset()).0)
    76	            .to_block_id();
    77	    let west_id =
    78	        GenerationCache::get_block_state(chunk, &pos.offset(BlockDirection::West.to_offset()).0)
    79	            .to_block_id();
    80	
    81	    let plant_id = Block::CHORUS_PLANT.id;
    82	    let flower_id = Block::CHORUS_FLOWER.id;
    83	    let supports = tag::Block::MINECRAFT_SUPPORTS_CHORUS_PLANT;
    84	
    85	    let props = BrownMushroomBlockLikeProperties {
    86	        down: down_id == plant_id || down_id == flower_id || down_id.has_tag(supports),
    87	        up: up_id == plant_id || up_id == flower_id,
    88	        north: north_id == plant_id || north_id == flower_id,
    89	        east: east_id == plant_id || east_id == flower_id,
    90	        south: south_id == plant_id || south_id == flower_id,
    91	        west: west_id == plant_id || west_id == flower_id,
    92	    };
    93	
    94	    let state_id = props.to_state_id(&Block::CHORUS_PLANT);
    95	    chunk.set_block_state(&pos.0, pumpkin_data::BlockState::from_id(state_id));
    96	}
    97	
    98	/// Places a dead chorus flower (age 5) at `pos`.
    99	fn place_dead_flower<T: GenerationCache>(chunk: &mut T, pos: &BlockPos) {
   100	    let props = ChorusFlowerLikeProperties { age: 5 };
   101	    let state_id = props.to_state_id(&Block::CHORUS_FLOWER);
   102	    chunk.set_block_state(&pos.0, pumpkin_data::BlockState::from_id(state_id));
   103	}
   104	
   105	/// Recursively grows the chorus plant tree upward and laterally.
   106	fn grow_tree_recursive<T: GenerationCache>(
   107	    chunk: &mut T,
   108	    random: &mut RandomGenerator,
   109	    current: &BlockPos,
   110	    start_pos: &BlockPos,
   111	    max_horizontal_spread: i32,
   112	    depth: i32,
   113	) {
   114	    let mut height = random.next_bounded_i32(4) + 1;
   115	    if depth == 0 {
   116	        height += 1;
   117	    }
   118	
   119	    // Grow vertically: place chorus plant for `height` blocks above current
   120	    for i in 0..height {
   121	        let target = current.up_height(i + 1);
   122	        if !all_neighbors_empty(chunk, &target, None) {
   123	            return;
   124	        }
   125	        set_chorus_plant(chunk, &target);
   126	        // Re-bake the block below so it gains the UP connection
   127	        set_chorus_plant(chunk, &target.down());
   128	    }
   129	
   130	    let top = current.up_height(height);
   131	    let mut placed_stem = false;
   132	
   133	    if depth < 4 {
   134	        let mut stems = random.next_bounded_i32(4);
   135	        if depth == 0 {
   136	            stems += 1;
   137	        }
   138	
   139	        for _ in 0..stems {
   140	            // Pick a random horizontal direction
   141	            let dir = BlockDirection::random_horizontal(random);
   142	            let target = top.offset(dir.to_offset());
   143	            let target_below = target.down();
   144	
   145	            let dx = (target.0.x - start_pos.0.x).abs();
   146	            let dz = (target.0.z - start_pos.0.z).abs();
   147	
   148	            if dx < max_horizontal_spread
   149	                && dz < max_horizontal_spread
   150	                && chunk.is_air(&target.0)
   151	                && chunk.is_air(&target_below.0)
   152	                && all_neighbors_empty(chunk, &target, Some(dir.opposite()))
   153	            {
   154	                placed_stem = true;
   155	                set_chorus_plant(chunk, &target);
   156	                // Re-bake the stem apex so it gains the connection face toward the new branch.
   157	                set_chorus_plant(chunk, &top);
   158	                grow_tree_recursive(
   159	                    chunk,
   160	                    random,
   161	                    &target,
   162	                    start_pos,
   163	                    max_horizontal_spread,
   164	                    depth + 1,
   165	                );
   166	            }
   167	        }
   168	    }
   169	
   170	    if !placed_stem {
   171	        // Cap the stem with a dead chorus flower
   172	        place_dead_flower(chunk, &top);
   173	    }
   174	}

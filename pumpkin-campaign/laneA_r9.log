    40	      super(properties);
    41	      this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH).setValue(HAS_EYE, false));
    42	   }
    43	
    44	   @Override
    45	   protected boolean useShapeForLightOcclusion(final BlockState state) {
    46	      return true;
    47	   }

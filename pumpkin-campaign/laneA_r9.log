   196	      BlockPos.MutableBlockPos neighborPos = new BlockPos.MutableBlockPos();
   197	
   198	      for (Direction direction : Direction.values()) {
   199	         neighborPos.setWithOffset(pos, direction);
   200	         if (predicate.test(blockGetter.apply(neighborPos))) {
   201	            return true;
   202	         }
   203	      }
   204	
   205	      return false;
   206	   }

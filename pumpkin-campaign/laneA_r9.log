   179	impl SculkSensorBlock {
   180	    /// Vanilla `SculkSensorBlock.tryResonateVibration` (`SculkSensorBlock.java:233-243`):
   181	    /// every adjacent `minecraft:vibration_resonators` block (amethyst) re-emits the
   182	    /// `RESONATE_<frequency>` game event and plays the resonating sound at the frequency's
   183	    /// pitch bend (`RESONANCE_PITCH_BEND`, `SculkSensorBlock.java:53-59`, pitch via
   184	    /// `NoteBlock.getPitchFromNote`, `NoteBlock.java:143-145`).
   185	    pub async fn try_resonate_vibration(world: &Arc<World>, pos: &BlockPos, frequency: i32) {
   186	        for direction in BlockDirection::all() {
   187	            let relative_pos = pos.offset(direction.to_offset());
   188	            let neighbor_state = world.get_block_state(&relative_pos);
   189	            let neighbor_block = Block::from_state_id(neighbor_state.id);
   190	            if !neighbor_block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_VIBRATION_RESONATORS) {
   191	                continue;
   192	            }
   193	            crate::world::game_event::emit_game_event(
   194	                world,
   195	                resonance_event_by_frequency(frequency),
   196	                relative_pos.to_centered_f64(),
   197	                GameEventContext::none(),
   198	            )
   199	            .await;
   200	            world.play_sound_fine(
   201	                Sound::BlockAmethystBlockResonate,
   202	                SoundCategory::Blocks,
   203	                &relative_pos.to_centered_f64(),
   204	                1.0,
   205	                resonance_pitch_bend(frequency),
   206	            );
   207	        }
   208	    }

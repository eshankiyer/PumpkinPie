    74	   }
    75	
    76	   private static BlockState getLeastOxidizedChestOfConnectedBlocks(final BlockState state, final Level level, final BlockPos pos) {
    77	      BlockState connectedState = level.getBlockState(pos.relative(getConnectedDirection(state)));
    78	      if (!state.getValue(ChestBlock.TYPE).equals(ChestType.SINGLE)
    79	         && state.getBlock() instanceof CopperChestBlock copperChestBlock
    80	         && connectedState.getBlock() instanceof CopperChestBlock connectedCopperChestBlock) {
    81	         BlockState updatedBlockState = state;
    82	         BlockState connectedPredictedBlockState = connectedState;
    83	         if (copperChestBlock.isWaxed() != connectedCopperChestBlock.isWaxed()) {
    84	            updatedBlockState = unwaxBlock(copperChestBlock, state).orElse(updatedBlockState);
    85	            connectedPredictedBlockState = unwaxBlock(connectedCopperChestBlock, connectedState).orElse(connectedPredictedBlockState);
    86	         }
    87	
    88	         Block leastOxidizedBlock = copperChestBlock.weatherState.ordinal() <= connectedCopperChestBlock.weatherState.ordinal()
    89	            ? updatedBlockState.getBlock()
    90	            : connectedPredictedBlockState.getBlock();
    91	         return leastOxidizedBlock.withPropertiesOf(updatedBlockState);
    92	      } else {
    93	         return state;
    94	      }
    95	   }

   164	   private static void applyEffects(final Level level, final BlockPos worldPosition, final List<BlockPos> effectBlocks) {
   165	      int activeSize = effectBlocks.size();
   166	      int effectRange = activeSize / 7 * 16;
   167	      int x = worldPosition.getX();
   168	      int y = worldPosition.getY();
   169	      int z = worldPosition.getZ();
   170	      AABB bb = new AABB(x, y, z, x + 1, y + 1, z + 1).inflate(effectRange).expandTowards(0.0, level.getHeight(), 0.0);
   171	      List<Player> players = level.getEntitiesOfClass(Player.class, bb);
   172	      if (!players.isEmpty()) {
   173	         for (Player player : players) {
   174	            if (worldPosition.closerThan(player.blockPosition(), effectRange) && player.isInWaterOrRain()) {
   175	               player.addEffect(new MobEffectInstance(MobEffects.CONDUIT_POWER, 260, 0, true, true));
   176	            }
   177	         }
   178	      }
   179	   }

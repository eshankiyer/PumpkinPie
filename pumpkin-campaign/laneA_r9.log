   356	/// `LivingEntity.isInWaterOrRain`, approximated with the primitives this codebase
   357	/// already exposes: `LivingEntity::is_in_water` (block-at-feet check) plus the
   358	/// server's rain-at-position check.
   359	async fn is_wet(living: &LivingEntity, world: &World) -> bool {
   360	    if living.is_in_water() {
   361	        return true;
   362	    }
   363	    if !world.is_raining().await {
   364	        return false;
   365	    }
   366	    world.is_raining_at_unchecked(&living.entity.block_pos.load())
   367	}

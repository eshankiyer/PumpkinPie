   189	impl NBTStorage for OminousItemSpawnerEntity {
   190	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   191	        Box::pin(async move {
   192	            self.entity.write_nbt(nbt).await;
   193	            let item = self.item.lock().await;
   194	            Self::write_spawner_nbt(nbt, &item, self.spawn_item_after_ticks.load(Relaxed));
   195	        })
   196	    }
   197	
   198	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   199	        Box::pin(async move {
   200	            self.entity.read_nbt_non_mut(nbt).await;
   201	            let (item, ticks) = Self::read_spawner_nbt(nbt);
   202	            *self.item.lock().await = item;
   203	            self.spawn_item_after_ticks.store(ticks, Relaxed);
   204	        })
   205	    }
   206	}

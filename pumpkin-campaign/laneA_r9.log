    77	         return super.useWithoutItem(state, level, pos, player, hitResult);
    78	      }
    79	
    80	      if (!level.isClientSide()) {
    81	         BlockState newState = state.cycle(INVERTED);
    82	         level.setBlock(pos, newState, 2);
    83	         level.gameEvent(GameEvent.BLOCK_CHANGE, pos, GameEvent.Context.of(player, newState));
    84	         updateSignalStrength(newState, level, pos);
    85	      }
    86	
    87	      return InteractionResult.SUCCESS;
    88	   }

   311	impl TrapezoidHeightProvider {
   312	    #[must_use]
   313	    pub fn get(&self, random: &mut RandomGenerator, min_y: i8, height: u16) -> i32 {
   314	        let plateau = self.plateau.unwrap_or(0);
   315	        let i = self.min_inclusive.get_y(min_y as i16, height);
   316	        let j = self.max_inclusive.get_y(min_y as i16, height);
   317	        if i >= j {
   318	            return i;
   319	        }
   320	        let k = j - i;
   321	        if plateau >= k {
   322	            return random.next_inbetween_i32(i, j);
   323	        }
   324	        let l = (k - plateau) / 2;
   325	        let m = k - l;
   326	        i + random.next_inbetween_i32(0, m) + random.next_inbetween_i32(0, l)
   327	    }
   328	}

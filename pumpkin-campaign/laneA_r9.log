   206	/// Returns the average distance from each pile to its closest neighbor.
   207	fn average_min_distance(piles: &[Pile]) -> f64 {
   208	    if piles.len() < 2 {
   209	        return 0.0;
   210	    }
   211	    let mut total = 0.0;
   212	    for pile in piles {
   213	        let mut closest = f64::MAX;
   214	        for other in piles {
   215	            if !std::ptr::eq(pile, other) {
   216	                closest = closest.min(pile.distance(other));
   217	            }
   218	        }
   219	        total += closest;
   220	    }
   221	    #[expect(clippy::cast_precision_loss)]
   222	    let count = piles.len() as f64;
   223	    total / count
   224	}

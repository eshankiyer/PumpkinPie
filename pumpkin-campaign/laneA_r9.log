   146	/// Vanilla `VibrationSystem.getResonanceEventByFrequency`: frequency N maps to
   147	/// `RESONATE_N` (1-15).
   148	const fn resonance_event_by_frequency(frequency: i32) -> GameEvent {
   149	    match frequency {
   150	        1 => GameEvent::Resonate1,
   151	        2 => GameEvent::Resonate2,
   152	        3 => GameEvent::Resonate3,
   153	        4 => GameEvent::Resonate4,
   154	        5 => GameEvent::Resonate5,
   155	        6 => GameEvent::Resonate6,
   156	        7 => GameEvent::Resonate7,
   157	        8 => GameEvent::Resonate8,
   158	        9 => GameEvent::Resonate9,
   159	        10 => GameEvent::Resonate10,
   160	        11 => GameEvent::Resonate11,
   161	        12 => GameEvent::Resonate12,
   162	        13 => GameEvent::Resonate13,
   163	        14 => GameEvent::Resonate14,
   164	        _ => GameEvent::Resonate15,
   165	    }
   166	}

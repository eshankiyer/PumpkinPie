    /// `tick` (`behavior/Behavior.java:68-69`).
    fn tick(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {}

    /// `stop` (`behavior/Behavior.java:77-78`).
    fn stop(&mut self, _mob: &dyn Mob, _brain: &Brain, _game_time: i64) {}


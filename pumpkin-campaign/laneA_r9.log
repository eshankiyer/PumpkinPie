    84	    frame_offsets()
    85	        .into_iter()
    86	        .filter_map(|(ox, oy, oz)| {
    87	            let pos = origin.offset(Vector3::new(ox, oy, oz));
    88	            is_valid_frame_block(frame_block(pos)).then_some(pos)
    89	        })
    90	        .collect()

     7	
     8	pub trait SegmentProperties {
     9	    fn get_segment_amount(&self) -> u8;
    10	    fn set_segment_amount(&mut self, amount: u8);
    11	    fn get_facing(&self) -> HorizontalFacing;
    12	    fn set_facing(&mut self, facing: HorizontalFacing);
    13	}
    14	
    15	macro_rules! impl_segment_properties {
    16	    ($type:ty, $amount_field:ident) => {
    17	        impl SegmentProperties for $type {
    18	            fn get_segment_amount(&self) -> u8 {
    19	                self.$amount_field
    20	            }
    21	
    22	            fn set_segment_amount(&mut self, amount: u8) {
    23	                self.$amount_field = amount;
    24	            }
    25	
    26	            fn get_facing(&self) -> HorizontalFacing {
    27	                self.facing
    28	            }
    29	
    30	            fn set_facing(&mut self, facing: HorizontalFacing) {
    31	                self.facing = facing;
    32	            }
    33	        }
    34	    };
    35	}
    36	
    37	impl_segment_properties!(
    38	    pumpkin_data::block_properties::PinkPetalsLikeProperties,
    39	    flower_amount
    40	);
    41	impl_segment_properties!(
    42	    pumpkin_data::block_properties::LeafLitterLikeProperties,
    43	    segment_amount
    44	);
    45	
    46	pub trait Segmented: BlockBehaviour {
    47	    type Properties: BlockProperties + SegmentProperties;
    48	
    49	    fn can_add_segment(&self, props: &Self::Properties) -> bool {
    50	        props.get_segment_amount() < 4
    51	    }
    52	
    53	    fn get_next_segment_amount(&self, current: u8) -> u8 {
    54	        (current + 1).min(4)
    55	    }
    56	
    57	    fn get_facing_for_segment(
    58	        &self,
    59	        player_facing: HorizontalFacing,
    60	        segment_amount: u8,
    61	    ) -> HorizontalFacing {
    62	        let base_facing = match segment_amount {
    63	            1 => HorizontalFacing::South,
    64	            2 => HorizontalFacing::East,
    65	            3 => HorizontalFacing::North,
    66	            _ => HorizontalFacing::West,
    67	        };
    68	
    69	        match player_facing {
    70	            HorizontalFacing::North => base_facing,
    71	            HorizontalFacing::East => base_facing.rotate_clockwise(),
    72	            HorizontalFacing::South => base_facing.rotate_clockwise().rotate_clockwise(),
    73	            HorizontalFacing::West => base_facing.rotate_counter_clockwise(),
    74	        }
    75	    }
    76	
    77	    fn can_update_at(&self, ctx: CanUpdateAtArgs<'_>) -> bool {
    78	        let current_props = Self::Properties::from_state_id(ctx.state_id, ctx.block);
    79	        self.can_add_segment(&current_props)
    80	    }
    81	
    82	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
    83	        Box::pin(async move {
    84	            if let BlockIsReplacing::Itself(existing_state_id) = args.replacing {
    85	                let mut props = Self::Properties::from_state_id(existing_state_id, args.block);
    86	
    87	                if self.can_add_segment(&props) {
    88	                    let current_amount = props.get_segment_amount();
    89	                    let next_amount = self.get_next_segment_amount(current_amount);
    90	                    props.set_segment_amount(next_amount);
    91	                    props.to_state_id(args.block)
    92	                } else {
    93	                    existing_state_id
    94	                }
    95	            } else {
    96	                // Set first segment orientation based on player direction
    97	                let player_facing = args.player.get_entity().get_horizontal_facing();
    98	                let mut props = Self::Properties::default(args.block);
    99	                props.set_segment_amount(1);
   100	                props.set_facing(self.get_facing_for_segment(player_facing, 1));
   101	                props.to_state_id(args.block)
   102	            }
   103	        })
   104	    }
   105	}


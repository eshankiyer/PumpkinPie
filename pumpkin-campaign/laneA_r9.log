    44	/// Re-registers a sensor loaded from disk in the world's flat game-event registry.
    45	///
    46	/// Vanilla constructs the vibration user/data/listener together in the block entity
    47	/// constructor (`SculkSensorBlockEntity.java:25-30`), and its listener exposes the block
    48	/// position and radius (`SculkSensorBlockEntity.java:72-94`).
    49	pub async fn ensure_listener_registered(world: &Arc<World>, pos: &BlockPos) {
    50	    let (block, _) = world.get_block_and_state(pos);
    51	    let radius = match block.id {
    52	        BlockId::SCULK_SENSOR => LISTENER_RANGE,
    53	        BlockId::CALIBRATED_SCULK_SENSOR => CalibratedSculkSensorBlockEntity::LISTENER_RADIUS,
    54	        _ => return,
    55	    };
    56	
    57	    let already_registered = world
    58	        .game_event_listeners
    59	        .lock()
    60	        .await
    61	        .iter()
    62	        .any(|listener| {
    63	            matches!(
    64	                listener.listener_source(),
    65	                PositionSource::Block(listener_pos) if listener_pos == *pos
    66	            )
    67	        });
    68	    if !already_registered {
    69	        world
    70	            .register_game_event_listener(Arc::new(SculkSensorListener { pos: *pos, radius }))
    71	            .await;
    72	    }
    73	}

   369	/// `UUIDUtil.CODEC`: four big-endian ints, most-significant first.
   370	const fn uuid_from_int_array(values: &[i32]) -> Option<Uuid> {
   371	    let &[a, b, c, d] = values else { return None };
   372	    Some(Uuid::from_u128(
   373	        ((a as u32 as u128) << 96)
   374	            | ((b as u32 as u128) << 64)
   375	            | ((c as u32 as u128) << 32)
   376	            | (d as u32 as u128),
   377	    ))
   378	}
   379	
   380	fn uuid_to_int_array(u: Uuid) -> NbtTag {
   381	    let v = u.as_u128();
   382	    NbtTag::IntArray(vec![
   383	        (v >> 96) as i32,
   384	        ((v >> 64) & 0xFFFF_FFFF) as i32,
   385	        ((v >> 32) & 0xFFFF_FFFF) as i32,
   386	        (v & 0xFFFF_FFFF) as i32,
   387	    ])
   388	}

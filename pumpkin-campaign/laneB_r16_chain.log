  1173	macro_rules! make_operation_executor {
  1174	    ($name:ident, $op:expr) => {
  1175	        struct $name;
  1176	        impl CommandExecutor for $name {
  1177	            fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {

   292	    /// Reads a string until the given character.
   293	    pub fn read_string_until(&mut self, terminator: char) -> Result<String, CommandSyntaxError> {
   294	        let mut result: String = String::new();
   295	        let mut escaped: bool = false;
   296	        while let Some(c) = self.peek() {
   297	            if escaped {
   298	                if c == terminator || c == SYNTAX_ESCAPE {
   299	                    result.push(c);
   300	                    self.skip();
   301	                    escaped = false;
   302	                } else {
   303	                    return Err(error_types::READER_INVALID_ESCAPE
   304	                        .create(self, TextComponent::text(c.to_string())));
   305	                }
   306	            } else {
   307	                self.skip();
   308	                if c == SYNTAX_ESCAPE {
   309	                    escaped = true;
   310	                } else if c == terminator {
   311	                    return Ok(result);
   312	                } else {
   313	                    result.push(c);
   314	                }
   315	            }
   316	        }
   317	        Err(error_types::READER_EXPECTED_END_QUOTE.create(self))
   318	    }

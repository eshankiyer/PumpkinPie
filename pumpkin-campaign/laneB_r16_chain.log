   156	
   157	            let objective_display_name = objective.display_name.clone();
   158	
   159	            let mut enabled_count = 0;
   160	            for player in &targets {
   161	                let player_name = &player.gameprofile.name;
   162	                let current_score = scoreboard
   163	                    .get_scores()
   164	                    .get(objective_name)
   165	                    .and_then(|m| m.get(player_name));
   166	
   167	                let is_already_enabled = current_score.is_some_and(|s| !s.locked);
   168	
   169	                if !is_already_enabled {
   170	                    let value = current_score.map_or(0, |s| s.value.0);
   171	                    let display_name = current_score.and_then(|s| s.display_name.clone());
   172	                    let number_format = current_score.and_then(|s| s.number_format.clone());
   173	
   174	                    let updated_score = ScoreboardScore {
   175	                        entity_name: player_name.clone(),
   176	                        objective_name: objective_name.to_string(),
   177	                        value: VarInt(value),
   178	                        display_name,
   179	                        number_format,
   180	                        locked: false,
   181	                    };
   182	
   183	                    scoreboard.update_score(world, updated_score).await;
   184	                    enabled_count += 1;
   185	                }
   186	            }
   187	
   188	            if enabled_count == 0 {
   189	                return Err(FAILED_ENABLE_ERROR.create_without_context());
   190	            }
   191	
   192	            let msg = if targets.len() == 1 {
   193	                TextComponent::translate_cross(
   194	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_SINGLE,
   195	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_SINGLE,
   196	                    [
   197	                        objective_display_name,
   198	                        TextComponent::text(targets[0].gameprofile.name.clone()),
   199	                    ],
   200	                )
   201	            } else {
   202	                TextComponent::translate_cross(
   203	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_MULTIPLE,
   204	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_MULTIPLE,
   205	                    [
   206	                        objective_display_name,
   207	                        TextComponent::text(targets.len().to_string()),
   208	                    ],
   209	                )
   210	            };
   211	
   212	            context.source.send_feedback(msg, true).await;
   213	
   214	            Ok(enabled_count)
   215	        })
   216	    }
   217	}

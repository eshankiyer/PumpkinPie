   127	    /// Serializes the tag payload without writing its type ID.
   128	    pub fn serialize_data<W: NbtWriteHelper>(self, w: &mut W) -> serializer::Result<()> {
   129	        match self {
   130	            Self::End => {}
   131	            Self::Byte(byte) => w.write_i8(byte)?,
   132	            Self::Short(short) => w.write_i16(short)?,
   133	            Self::Int(int) => w.write_i32(int)?,
   134	            Self::Long(long) => w.write_i64(long)?,
   135	            Self::Float(float) => w.write_f32(float)?,
   136	            Self::Double(double) => w.write_f64(double)?,
   137	            Self::ByteArray(byte_array) => {
   138	                let len = byte_array.len();
   139	                if len > i32::MAX as usize {
   140	                    return Err(Error::LargeLength(len));
   141	                }
   142	
   143	                w.write_i32(len as i32)?;
   144	                for int in byte_array {
   145	                    w.write_i8(int)?;
   146	                }
   147	            }
   148	            Self::String(string) => {
   149	                w.write_string(&string)?;
   150	            }
   151	            Self::List(list) => {
   152	                let len = list.len();
   153	                if len > i32::MAX as usize {
   154	                    return Err(Error::LargeLength(len));
   155	                }
   156	
   157	                let list_element_id = Self::get_list_element_type_id(&list);
   158	
   159	                w.write_u8(list_element_id)?;
   160	                w.write_i32(len as i32)?;
   161	                for nbt_tag in list {
   162	                    // Since tags in the same list tag must have the same type,
   163	                    // we need to handle those of different tag types by
   164	                    // wrapping them in `NbtCompound`s if needed.
   165	                    Self::wrap_tag_if_needed(list_element_id, nbt_tag).serialize_data(w)?;
   166	                }
   167	            }
   168	            Self::Compound(compound) => {
   169	                compound.serialize_content(w)?;
   170	            }
   171	            Self::IntArray(int_array) => {
   172	                let len = int_array.len();
   173	                if len > i32::MAX as usize {
   174	                    return Err(Error::LargeLength(len));
   175	                }
   176	
   177	                w.write_i32(len as i32)?;
   178	                for int in int_array {
   179	                    w.write_i32(int)?;
   180	                }
   181	            }
   182	            Self::LongArray(long_array) => {
   183	                let len = long_array.len();
   184	                if len > i32::MAX as usize {
   185	                    return Err(Error::LargeLength(len));
   186	                }
   187	
   188	                w.write_i32(len as i32)?;
   189	                for long in long_array {
   190	                    w.write_i64(long)?;
   191	                }
   192	            }
   193	        }
   194	        Ok(())
   195	    }

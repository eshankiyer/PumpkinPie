    12	/// A value represented by one of the tag types defined by the NBT format.
    13	#[derive(Clone, Debug, PartialEq)]
    14	#[repr(u8)]
    15	pub enum NbtTag {
    16	    /// Marks the end of a compound.
    17	    End = END_ID,
    18	    /// An 8-bit signed integer.
    19	    Byte(i8) = BYTE_ID,
    20	    /// A 16-bit signed integer.
    21	    Short(i16) = SHORT_ID,
    22	    /// A 32-bit signed integer.
    23	    Int(i32) = INT_ID,
    24	    /// A 64-bit signed integer.
    25	    Long(i64) = LONG_ID,
    26	    /// A 32-bit floating-point number.
    27	    Float(f32) = FLOAT_ID,
    28	    /// A 64-bit floating-point number.
    29	    Double(f64) = DOUBLE_ID,
    30	    /// An array of 8-bit signed integers.
    31	    ByteArray(Box<[i8]>) = BYTE_ARRAY_ID,
    32	    /// A string.
    33	    String(Box<str>) = STRING_ID,
    34	    /// A sequence of tags.
    35	    List(Vec<Self>) = LIST_ID,
    36	    /// A map of named tags.
    37	    Compound(NbtCompound) = COMPOUND_ID,
    38	    /// An array of 32-bit signed integers.

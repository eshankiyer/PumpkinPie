    85	impl CommandExecutor for ObjectivesAddExecutor {
    86	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    87	        Box::pin(async move {
    88	            let objective_name = StringArgumentType::get(context, ARG_OBJECTIVE)?;
    89	            let criterion = StringArgumentType::get(context, ARG_CRITERION)?;
    90	
    91	            let display_name = if self.has_display_name {
    92	                TextComponent::text(StringArgumentType::get(context, ARG_DISPLAY_NAME)?.to_string())
    93	            } else {
    94	                TextComponent::text(objective_name.to_string())
    95	            };
    96	
    97	            if !crate::world::scoreboard::is_valid_criterion(criterion) {
    98	                return Err(INVALID_CRITERION_ERROR.create_without_context());
    99	            }
   100	
   101	            let world = context.world();
   102	            let mut scoreboard = world.scoreboard.lock().await;
   103	
   104	            if scoreboard.get_objectives().contains_key(objective_name) {
   105	                return Err(DUPLICATE_OBJECTIVE_ERROR.create_without_context());
   106	            }
   107	
   108	            let render_type =
   109	                crate::world::scoreboard::default_render_type_for_criterion(criterion);
   110	            let new_objective = ScoreboardObjective::new(
   111	                objective_name,
   112	                display_name.clone(),
   113	                render_type,
   114	                None,
   115	                criterion,
   116	            );
   117	
   118	            scoreboard.add_objective(new_objective);
   119	
   120	            context
   121	                .source
   122	                .send_feedback(
   123	                    TextComponent::translate_cross(
   124	                        translation::java::COMMANDS_SCOREBOARD_OBJECTIVES_ADD_SUCCESS,
   125	                        translation::java::COMMANDS_SCOREBOARD_OBJECTIVES_ADD_SUCCESS,
   126	                        [display_name],
   127	                    ),
   128	                    true,
   129	                )
   130	                .await;
   131	
   132	            Ok(1)
   133	        })
   134	    }
   135	}

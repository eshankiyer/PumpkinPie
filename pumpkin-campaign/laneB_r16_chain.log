   266	    /// Reads any string, whether it be quoted or unquoted.
   267	    pub fn read_string(&mut self) -> Result<String, CommandSyntaxError> {
   268	        let Some(next) = self.peek() else {
   269	            return Ok(String::new());
   270	        };
   271	        if Self::is_allowed_as_quoted_string_start_end(next) {
   272	            self.skip();
   273	            self.read_string_until(next)
   274	        } else {
   275	            Ok(self.read_unquoted_string())
   276	        }
   277	    }

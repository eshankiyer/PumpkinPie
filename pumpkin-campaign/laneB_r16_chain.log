    44	impl NbtTag {
    45	    /// Returns the numeric id associated with the data type.
    46	    #[must_use]
    47	    pub const fn get_type_id(&self) -> u8 {
    48	        // SAFETY: Since Self is repr(u8), it is guaranteed to hold the discriminant in the first byte
    49	        // See https://doc.rust-lang.org/reference/items/enumerations.html#pointer-casting
    50	        unsafe { *std::ptr::from_ref::<Self>(self).cast::<u8>() }
    51	    }
    52	
    53	    /// Serializes the tag's type ID followed by its payload.
    54	    pub fn serialize<W: NbtWriteHelper>(self, w: &mut W) -> serializer::Result<()> {
    55	        w.write_u8(self.get_type_id())?;
    56	        self.serialize_data(w)?;
    57	        Ok(())
    58	    }
    59	
    60	    /// Gets the element type of [`NbtTag::List`] the provided `Vec`
    61	    /// represents. If any elements in the `Vec` are found to be of
    62	    /// different types, this returns [`COMPOUND_ID`].
    63	    #[must_use]
    64	    fn get_list_element_type_id(list: &[Self]) -> u8 {
    65	        let mut element_id = END_ID;
    66	
    67	        for tag in list {
    68	            let id = tag.get_type_id();
    69	            if element_id == END_ID {
    70	                element_id = id;
    71	            } else if element_id != id {
    72	                return COMPOUND_ID;
    73	            }
    74	        }
    75	
    76	        element_id
    77	    }
    78	
    79	    /// Tries to unwrap (flatten) a wrapped `NbtTag`. If there is a wrapped tag, it is returned.
    80	    /// If no unwrap is possible, this returns the given tag.
    81	    fn flatten(tag: Self) -> Self {
    82	        if let Self::Compound(mut compound) = tag {
    83	            // Try to get the wrapped tag, stored by "".
    84	            if Self::is_wrapper_compound(&compound) {
    85	                compound
    86	                    .child_tags
    87	                    .remove("")
    88	                    .unwrap_or(Self::Compound(compound))
    89	            } else {
    90	                Self::Compound(compound)
    91	            }
    92	        } else {
    93	            tag
    94	        }
    95	    }
    96	
    97	    /// Returns whether an [`NbtCompound`] is a wrapper compound.
    98	    ///
    99	    /// A *wrapper compound* is a compound that stores exactly one
   100	    /// key-value pair, an empty string key (`""`) and an `NbtTag`.
   101	    fn is_wrapper_compound(compound: &NbtCompound) -> bool {
   102	        compound.child_tags.len() == 1 && compound.child_tags.contains_key("")
   103	    }
   104	
   105	    /// Wraps the provided tag if needed with the provided element type of list
   106	    /// the wrapped tag, if any, would be added to.
   107	    fn wrap_tag_if_needed(element_type: u8, tag: Self) -> Self {
   108	        if element_type == COMPOUND_ID {
   109	            if let Self::Compound(compound) = &tag
   110	                && !Self::is_wrapper_compound(compound)
   111	            {
   112	                tag
   113	            } else {
   114	                Self::wrap_tag(tag)
   115	            }
   116	        } else {
   117	            tag
   118	        }
   119	    }
   120	
   121	    fn wrap_tag(tag: Self) -> Self {
   122	        let mut compound = NbtCompound::new();
   123	        compound.put("", tag);
   124	        Self::Compound(compound)
   125	    }

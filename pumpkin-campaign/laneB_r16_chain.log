   197	    /// Deserializes a type ID and its following payload.
   198	    pub fn deserialize<'a, R: NbtReadHelper<'a>>(reader: &mut R) -> Result<Self, Error> {
   199	        let tag_id = reader.get_u8()?;
   200	        Self::deserialize_data(reader, tag_id)
   201	    }

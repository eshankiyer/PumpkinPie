   253	                for _ in 0..len {
   254	                    Self::skip_data_depth(reader, tag_type_id, depth + 1)?;
   255	                }
   256	
   257	                Ok(())
   258	            }
   259	            COMPOUND_ID => NbtCompound::skip_content_depth(reader, depth + 1),
   260	            INT_ARRAY_ID => {
   360	            STRING_ID => Ok(Self::String(reader.get_string()?.into_owned().into())),
   361	            LIST_ID => {
   362	                let tag_type_id = reader.get_u8()?;
   363	                let len = reader.get_i32()?;
   364	                if len < 0 {
   365	                    return Err(Error::NegativeLength(len));
   366	                }
   367	                if tag_type_id == END_ID && len > 0 {

   389	                depth + 1,
   390	            )?)),
   391	            INT_ARRAY_ID => {
   392	                let len = reader.get_i32()?;
   393	                if len < 0 {
   394	                    return Err(Error::NegativeLength(len));
   395	                }
   396	
   397	                let len = len as usize;
   398	                if len > crate::MAX_ARRAY_LENGTH {

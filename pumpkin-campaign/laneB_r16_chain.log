  1098	/// Applies an operation to all targets. `op` is `|a, b| -> i32`.
  1099	async fn apply_operation(
  1100	    context: &CommandContext<'_>,
  1101	    op: impl Fn(i32, i32) -> i32 + Send + Sync,
  1102	) -> Result<i32, crate::command::errors::command_syntax_error::CommandSyntaxError> {
  1103	    let targets = EntityArgumentType::get_players(context, ARG_TARGETS).await?;
  1104	    let objective_name = obj_name(context)?;
  1105	    let sources = EntityArgumentType::get_players(context, ARG_SOURCE).await?;
  1106	    let source_objective = obj_name(context)?;

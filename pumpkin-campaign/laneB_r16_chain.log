  1097	
  1098	/// Applies an operation to all targets. `op` is `|a, b| -> i32`.
  1099	async fn apply_operation(
  1100	    context: &CommandContext<'_>,
  1101	    op: impl Fn(i32, i32) -> i32 + Send + Sync,
  1102	) -> Result<i32, crate::command::errors::command_syntax_error::CommandSyntaxError> {
  1103	    let targets = EntityArgumentType::get_players(context, ARG_TARGETS).await?;
  1104	    let objective_name = obj_name(context)?;
  1105	    let sources = EntityArgumentType::get_players(context, ARG_SOURCE).await?;
  1106	    let source_objective = obj_name(context)?;
  1107	
  1108	    let world = context.world();
  1109	    let mut scoreboard = world.scoreboard.lock().await;
  1110	
  1111	    let mut last_new_value = 0;
  1112	    for target in &targets {
  1113	        let target_name = &target.gameprofile.name;
  1114	        for source in &sources {
  1115	            let source_name = &source.gameprofile.name;
  1116	            let source_value = scoreboard
  1117	                .get_player_score_info(source_name, source_objective)
  1118	                .map_or(0, |s| s.value.0);
  1119	            let current = scoreboard
  1120	                .get_player_score_info(target_name, objective_name)
  1121	                .map_or(0, |s| s.value.0);
  1122	            let new_value = op(current, source_value);
  1123	            last_new_value = new_value;
  1124	
  1125	            let score = ScoreboardScore {
  1126	                entity_name: target_name.clone(),
  1127	                objective_name: objective_name.to_string(),
  1128	                value: VarInt(new_value),
  1129	                display_name: None,
  1130	                number_format: None,
  1131	                locked: false,
  1132	            };
  1133	            scoreboard.update_score(world, score).await;
  1134	        }
  1135	    }
  1136	
  1137	    if targets.len() == 1 {
  1138	        context
  1139	            .source
  1140	            .send_feedback(
  1141	                TextComponent::translate_cross(
  1142	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_OPERATION_SUCCESS_SINGLE,
  1143	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_OPERATION_SUCCESS_SINGLE,
  1144	                    [
  1145	                        TextComponent::text(objective_name.to_string()),
  1146	                        TextComponent::text(targets[0].gameprofile.name.clone()),
  1147	                        TextComponent::text(last_new_value.to_string()),
  1148	                    ],
  1149	                ),
  1150	                true,
  1151	            )
  1152	            .await;
  1153	    } else {
  1154	        context
  1155	            .source
  1156	            .send_feedback(
  1157	                TextComponent::translate_cross(
  1158	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_OPERATION_SUCCESS_MULTIPLE,
  1159	                    translation::java::COMMANDS_SCOREBOARD_PLAYERS_OPERATION_SUCCESS_MULTIPLE,
  1160	                    [
  1161	                        TextComponent::text(objective_name.to_string()),
  1162	                        TextComponent::text(targets.len().to_string()),
  1163	                    ],
  1164	                ),
  1165	                true,
  1166	            )
  1167	            .await;
  1168	    }
  1169	
  1170	    Ok(targets.len() as i32)
  1171	}
  1172	
  1173	macro_rules! make_operation_executor {
  1174	    ($name:ident, $op:expr) => {
  1175	        struct $name;
  1176	        impl CommandExecutor for $name {
  1177	            fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
  1178	                Box::pin(apply_operation(context, $op))
  1179	            }
  1180	        }


   387	      @Override
   388	      public Stream<T> stream() {
   389	         return Streams.<Tag, T>mapWithIndex(this.list.stream(), (value, index) -> {
   390	            return (T)(switch (this.codec.parse(this.context.ops(), value)) {
   391	               case Success<T> success -> success.value();
   392	               case Error<T> error -> {
   393	                  this.reportIndexUnwrapProblem((int)index, value, error);
   394	                  yield error.partialValue().orElse(null);
   395	               }
   396	               default -> throw new MatchException(null, null);
   397	            });

   203	    /// Advances a reader past the payload belonging to `tag_id`.
   204	    pub fn skip_data<'a, R: NbtReadHelper<'a>>(reader: &mut R, tag_id: u8) -> Result<(), Error> {
   205	        Self::skip_data_depth(reader, tag_id, 0)
   206	    }

   121	        // (`Mob.java:601-603`, `DropChances.java:28-29`).
   122	        .insert(EquipmentSlot::SADDLE, 2.0);
   123	    mob_entity
   124	        .living_entity
   125	        .send_equipment_changes(&[(EquipmentSlot::SADDLE, new_stack)]);
   126	
   127	    let entity = &mob_entity.living_entity.entity;
   128	    let world = entity.world.load();
   129	    world.play_sound_event(&equip_sound, SoundCategory::Neutral, &entity.pos.load());

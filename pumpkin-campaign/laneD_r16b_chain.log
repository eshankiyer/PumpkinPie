  8191	/// Vanilla `LivingEntity.canGlideUsing` (`LivingEntity.java:4001-4008`): the stack must
  8192	/// carry the `minecraft:glider` component, its `equippable` component must target `slot`,
  8193	/// and its next durability point must not break it.
  8194	fn can_glide_using(stack: &ItemStack, slot: &EquipmentSlot) -> bool {
  8195	    stack.get_data_component::<GliderImpl>().is_some()
  8196	        && stack
  8197	            .get_data_component::<EquippableImpl>()
  8198	            .is_some_and(|equippable| equippable.slot == slot && !next_damage_will_break(stack))
  8199	}
  8200	
  8201	/// Vanilla `ItemStack.nextDamageWillBreak`: one more durability point breaks the item.
  8202	fn next_damage_will_break(stack: &ItemStack) -> bool {
  8203	    !stack.is_empty()
  8204	        && stack
  8205	            .get_max_damage()
  8206	            .is_some_and(|max_damage| stack.get_damage() >= max_damage - 1)
  8207	}
  8208	
  8209	fn damage_causes_panic(damage_type: DamageType) -> bool {
  8210	    damage_type.has_tag(&tag::DamageType::MINECRAFT_PANIC_CAUSES)
  8211	}

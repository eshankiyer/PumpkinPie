   945	    /// `PatrolSpawner.tick` (PatrolSpawner.java:20-65). `spawn_enemies` mirrors
   946	    /// `ServerChunkCache.spawnEnemies`, which `MinecraftServer` sets from
   947	    /// `ServerLevel.isSpawningMonsters` (ServerLevel.java:1776-1778).
   948	    async fn tick(&mut self, world: &Arc<World>) {
   949	        let level_info = world.level_info.load();
   950	        let game_rules = &level_info.game_rules;
   951	        let spawn_enemies = game_rules.spawn_mobs
   952	            && game_rules.spawn_monsters
   953	            && level_info.difficulty != Difficulty::Peaceful;
   954	        if !spawn_enemies || !game_rules.spawn_patrols {
   955	            return;
   956	        }
   957	
   958	        self.next_tick -= 1;
   959	        if self.next_tick > 0 {
   960	            return;
   961	        }
   962	        // PatrolSpawner.java:26 accumulates onto the (already non-positive) counter rather than
   963	        // assigning, so an overshoot is carried into the next interval.
   964	        self.next_tick +=
   965	            PATROL_SPAWN_INTERVAL + rand::random_range(0..PATROL_SPAWN_INTERVAL_JITTER);
   966	
   967	        if !Self::is_bright_outside(world) {
   968	            return;
   969	        }
   970	        if rand::random_range(0..5) != 0 {
   971	            return;
   972	        }
   973	
   974	        let players = world.players.load();
   975	        if players.is_empty() {
   976	            return;
   977	        }
   978	        let player = players[rand::random_range(0..players.len())].clone();
   979	        drop(players);
   980	        if player.gamemode.load() == pumpkin_util::GameMode::Spectator {
   981	            return;
   982	        }
   983	
   984	        let player_pos = player.get_entity().block_pos.load();
   985	        if world.is_close_to_village(player_pos, 2).await {
   986	            return;
   987	        }
   988	
   989	        let offset_x =
   990	            (24 + rand::random_range(0..24)) * if rand::random_range(0..2) == 0 { -1 } else { 1 };
   991	        let offset_z =
   992	            (24 + rand::random_range(0..24)) * if rand::random_range(0..2) == 0 { -1 } else { 1 };
   993	        let mut spawn_pos = player_pos.add(offset_x, 0, offset_z);
   994	
   995	        if !Self::has_chunks_at(world, spawn_pos) {
   996	            return;
   997	        }
   998	
   999	        let difficulty = RegionalDifficulty::at(world, spawn_pos.to_centered_f64());
  1000	        let group_size = difficulty.effective_difficulty.ceil() as i32 + 1;
  1001	
  1002	        for i in 0..group_size {
  1003	            spawn_pos = BlockPos::new(
  1004	                spawn_pos.0.x,
  1005	                world.get_top_block(Vector2::new(spawn_pos.0.x, spawn_pos.0.z)) + 1,
  1006	                spawn_pos.0.z,
  1007	            );
  1008	            if i == 0 {
  1009	                if !Self::spawn_patrol_member(world, spawn_pos, true).await {
  1010	                    break;
  1011	                }
  1012	            } else {
  1013	                Self::spawn_patrol_member(world, spawn_pos, false).await;
  1014	            }
  1015	            spawn_pos = spawn_pos.add(
  1016	                rand::random_range(0..5) - rand::random_range(0..5),
  1017	                0,
  1018	                rand::random_range(0..5) - rand::random_range(0..5),
  1019	            );
  1020	        }
  1021	    }
  1022	}

   128	   public InteractionResult swapWithEquipmentSlot(final ItemStack inHand, final Player player) {
   129	      if (player.canUseSlot(this.slot) && this.canBeEquippedBy(player.typeHolder())) {
   130	         ItemStack inEquipmentSlot = player.getItemBySlot(this.slot);
   131	         if ((!EnchantmentHelper.has(inEquipmentSlot, EnchantmentEffectComponents.PREVENT_ARMOR_CHANGE) || player.isCreative())
   132	            && !ItemStack.isSameItemSameComponents(inHand, inEquipmentSlot)) {
   133	            if (!player.level().isClientSide()) {
   134	               player.awardStat(Stats.ITEM_USED.get(inHand.getItem()));
   135	            }
   136	
   137	            if (inHand.getCount() <= 1) {
   138	               ItemStack swappedToHand = inEquipmentSlot.isEmpty() ? inHand : inEquipmentSlot.copyAndClear();
   139	               ItemStack swappedToEquipment = player.isCreative() ? inHand.copy() : inHand.copyAndClear();
   140	               player.setItemSlot(this.slot, swappedToEquipment);
   141	               return InteractionResult.SUCCESS.heldItemTransformedTo(swappedToHand);
   142	            }
   143	
   144	            ItemStack swappedToInventory = inEquipmentSlot.copyAndClear();
   145	            ItemStack swappedToEquipment = inHand.consumeAndReturn(1, player);
   146	            player.setItemSlot(this.slot, swappedToEquipment);
   147	            if (!player.getInventory().add(swappedToInventory)) {
   148	               player.drop(swappedToInventory, false);
   149	            }
   150	
   151	            return InteractionResult.SUCCESS.heldItemTransformedTo(inHand);
   152	         } else {
   153	            return InteractionResult.FAIL;
   154	         }
   155	      } else {
   156	         return InteractionResult.PASS;
   157	      }
   158	   }

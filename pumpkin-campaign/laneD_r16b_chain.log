    29	public class MinecartTNT extends AbstractMinecart {
    30	   private static final String TAG_EXPLOSION_POWER = "explosion_power";
    31	   private static final String TAG_EXPLOSION_SPEED_FACTOR = "explosion_speed_factor";
    32	   private static final float DEFAULT_EXPLOSION_POWER_BASE = 4.0F;
    33	   private static final float DEFAULT_EXPLOSION_SPEED_FACTOR = 1.0F;
    34	   private @Nullable DamageSource ignitionSource;
    35	   private int fuse = -1;
    36	   private float explosionPowerBase = 4.0F;
    37	   private float explosionSpeedFactor = 1.0F;
    38	
    39	   public MinecartTNT(final EntityType<? extends MinecartTNT> type, final Level level) {
    40	      super(type, level);
    41	   }
    42	
    43	   @Override
    44	   public BlockState getDefaultDisplayBlockState() {
    45	      return Blocks.TNT.defaultBlockState();
    46	   }
    47	
    48	   @Override
    49	   public void tick() {
    50	      super.tick();
    51	      if (this.fuse > 0) {
    52	         this.fuse--;
    53	         this.level().addParticle(ParticleTypes.SMOKE, this.getX(), this.getY() + 0.5, this.getZ(), 0.0, 0.0, 0.0);
    54	      } else if (this.fuse == 0) {
    55	         this.explode(this.ignitionSource, this.getDeltaMovement().horizontalDistanceSqr());
    56	      }
    57	
    58	      if (this.horizontalCollision) {
    59	         double speedSqr = this.getDeltaMovement().horizontalDistanceSqr();
    60	         if (speedSqr >= 0.01F) {
    61	            this.explode(this.ignitionSource, speedSqr);
    62	         }
    63	      }
    64	   }
    65	
    66	   @Override
    67	   public boolean hurtServer(final ServerLevel level, final DamageSource source, final float damage) {
    68	      if (source.getDirectEntity() instanceof AbstractArrow projectile && projectile.isOnFire()) {
    69	         DamageSource damageSource = this.damageSources().explosion(this, source.getEntity());
    70	         this.explode(damageSource, projectile.getDeltaMovement().lengthSqr());
    71	      }
    72	
    73	      return super.hurtServer(level, source, damage);
    74	   }
    75	
    76	   @Override
    77	   public void destroy(final ServerLevel level, final DamageSource source) {
    78	      double speedSqr = this.getDeltaMovement().horizontalDistanceSqr();
    79	      if (!damageSourceIgnitesTnt(source) && !(speedSqr >= 0.01F)) {
    80	         this.destroy(level, this.getDropItem());
    81	      } else {
    82	         if (this.fuse < 0) {
    83	            this.primeFuse(source);
    84	            this.fuse = this.random.nextInt(20) + this.random.nextInt(20);
    85	         }
    86	      }
    87	   }
    88	

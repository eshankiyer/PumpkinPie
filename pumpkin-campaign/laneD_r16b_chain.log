   877	// ══════════════════════════════════════════════════════════════════
   878	// Equipment population
   879	//
   880	// Mirrors mob-specific `finalizeSpawn` / `populateDefaultEquipmentSlots`
   881	// from Vanilla's Zombie, AbstractSkeleton, WitherSkeleton, Piglin,
   882	// Pillager, Vindicator, Drowned, and ZombifiedPiglin.
   883	// ══════════════════════════════════════════════════════════════════
   884	
   885	/// Weighted random selection from a table of weapon entries.
   886	#[must_use]
   887	fn weighted_select_item(items: &[WeaponEntry]) -> &'static Item {
   888	    let total: f32 = items.iter().map(|e| e.weight).sum();
   889	    let mut rng = rand::rng();
   890	    let mut roll: f32 = rng.random_range(0.0..total);
   891	    for entry in items {
   892	        roll -= entry.weight;
   893	        if roll <= 0.0 {
   894	            return entry.item;
   895	        }
   896	    }
   897	    items.last().map_or(&Item::AIR, |e| e.item)
   898	}
   899	
   900	/// Selects armor using the vanilla algorithm.
   901	///
   902	/// 1. Random base tier (0-2) with up to 3 upgrade attempts at 10.87% each.
   903	/// 2. Iterates HEAD→CHEST→LEGS→FEET, with a chance to stop early (10% Hard,
   904	///    25% otherwise) — higher difficulty produces fewer pieces.
   905	/// 3. Each piece gets the default equipment drop chance.
   906	#[must_use]
   907	fn select_vanilla_armor(difficulty: &RegionalDifficulty) -> Vec<(EquipmentSlot, ItemStack, f32)> {
   908	    let mut rng = rand::rng();
   909	
   910	    let mut armor_type = rng.random_range(0..3);
   911	    let mut i = 1;
   912	    while (i as f32) <= ARMOR_UPGRADE_MATERIAL_ATTEMPTS {
   913	        if rng.random::<f32>() < ARMOR_UPGRADE_MATERIAL_CHANCE {
   914	            armor_type += 1;
   915	        }
   916	        i += 1;
   917	    }
   918	    armor_type = armor_type.min(5);
   919	
   920	    let tier = &ARMOR_TIERS[armor_type];
   921	
   922	    let partial_chance = if difficulty.base_difficulty == Difficulty::Hard {
   923	        0.1f32
   924	    } else {
   925	        0.25f32
   926	    };
   927	
   928	    let mut pieces = Vec::new();
   929	    let mut first = true;
   930	    for (i, slot) in ARMOR_POPULATION_ORDER.iter().enumerate() {
   931	        if !first && rng.random::<f32>() < partial_chance {
   932	            break;
   933	        }
   934	        first = false;
   935	        pieces.push((
   936	            slot.clone(),
   937	            create_equipment_item(tier[i], difficulty),
   938	            DEFAULT_EQUIPMENT_DROP_CHANCE,
   939	        ));
   940	    }
   941	    pieces
   942	}
   943	
   944	/// Creates a fresh, full-durability `ItemStack` for mob equipment.
   945	/// Vanilla mobs always spawn with equipment at full durability.
   946	#[must_use]
   947	fn create_equipment_item(item: &'static Item, _difficulty: &RegionalDifficulty) -> ItemStack {
   948	    ItemStack::new(1, item)
   949	}
   950	
   951	/// Generates the equipment items, slots, and drop chances for a mob definition.
   952	///
   953	/// Handles the full weapon + armor selection logic. When `def.enchanted` is set
   954	/// (mirroring the mobs that call `populateDefaultEquipmentEnchantments`, versus
   955	/// those like `WitherSkeleton.java:79-80` and `PiglinBrute` that skip it), each
   956	/// equipped piece goes through the vanilla enchant rolls —
   957	/// [`enchant_spawned_weapon`] for the main hand, [`enchant_spawned_armor`] for
   958	/// every armor slot — exactly as in `Mob.populateDefaultEquipmentEnchantments`
   959	/// (`Mob.java:1055-1063`). All enchant rolls draw from a single RNG, like the
   960	/// per-spawn `RandomSource` vanilla draws from `level.getRandom()`.
   961	#[must_use]
   962	fn equip_mob_from_def(
   963	    def: &MobEquipmentDef,
   964	    difficulty: &RegionalDifficulty,
   965	) -> Vec<(EquipmentSlot, ItemStack, f32)> {
   966	    let mut rng = rand::rng();
   967	    let mut changes: Vec<(EquipmentSlot, ItemStack, f32)> = Vec::new();
   968	
   969	    // ── Weapon ──
   970	    match def.weapon {
   971	        WeaponConfig::Always(item) => {
   972	            let mut stack = create_equipment_item(item, difficulty);
   973	            if def.enchanted {
   974	                enchant_spawned_weapon(&mut rng, &mut stack, difficulty);
   975	            }
   976	            changes.push((
   977	                EquipmentSlot::MAIN_HAND,
   978	                stack,
   979	                DEFAULT_EQUIPMENT_DROP_CHANCE,
   980	            ));
   981	        }
   982	        WeaponConfig::AlwaysWeighted(items) => {
   983	            let item = weighted_select_item(items);
   984	            let mut stack = create_equipment_item(item, difficulty);
   985	            if def.enchanted {
   986	                enchant_spawned_weapon(&mut rng, &mut stack, difficulty);
   987	            }
   988	            changes.push((
   989	                EquipmentSlot::MAIN_HAND,
   990	                stack,
   991	                DEFAULT_EQUIPMENT_DROP_CHANCE,
   992	            ));
   993	        }
   994	        WeaponConfig::Chance {
   995	            on_hard,
   996	            otherwise,
   997	            items,
   998	        } => {
   999	            let chance = if difficulty.base_difficulty == Difficulty::Hard {
  1000	                on_hard
  1001	            } else {
  1002	                otherwise
  1003	            };
  1004	            if rng.random::<f32>() < chance {
  1005	                let item = weighted_select_item(items);
  1006	                let mut stack = create_equipment_item(item, difficulty);
  1007	                if def.enchanted {
  1008	                    enchant_spawned_weapon(&mut rng, &mut stack, difficulty);
  1009	                }
  1010	                changes.push((
  1011	                    EquipmentSlot::MAIN_HAND,
  1012	                    stack,
  1013	                    DEFAULT_EQUIPMENT_DROP_CHANCE,
  1014	                ));
  1015	            }
  1016	        }
  1017	        WeaponConfig::None => {}
  1018	    }
  1019	
  1020	    // ── Armor ──
  1021	    match def.armor {
  1022	        ArmorConfig::Vanilla => {
  1023	            if difficulty.should_happen(WEARING_ARMOR_CHANCE) {
  1024	                let armor_pieces = select_vanilla_armor(difficulty);
  1025	                for (slot, mut stack, drop_chance) in armor_pieces {
  1026	                    if def.enchanted {
  1027	                        enchant_spawned_armor(&mut rng, &mut stack, difficulty);
  1028	                    }
  1029	                    changes.push((slot, stack, drop_chance));
  1030	                }
  1031	            }
  1032	        }
  1033	        ArmorConfig::CustomPerSlot(entries) => {
  1034	            for entry in entries {
  1035	                if rng.random::<f32>() < entry.chance {
  1036	                    let mut stack = create_equipment_item(entry.item, difficulty);
  1037	                    if def.enchanted {
  1038	                        enchant_spawned_armor(&mut rng, &mut stack, difficulty);
  1039	                    }
  1040	                    changes.push((entry.slot.clone(), stack, DEFAULT_EQUIPMENT_DROP_CHANCE));
  1041	                }
  1042	            }
  1043	        }
  1044	        ArmorConfig::None => {}
  1045	    }
  1046	
  1047	    changes
  1048	}

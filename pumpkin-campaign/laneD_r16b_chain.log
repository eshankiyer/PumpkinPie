  4608	    /// Vanilla `LivingEntity.canEquipWithDispenser` (`LivingEntity.java:3860-3874`) accepts a
  4609	    /// dispensable equippable item only when its slot is empty and its entity restriction allows
  4610	    /// this entity.
  4611	    pub async fn can_equip_with_dispenser(&self, item_stack: &ItemStack) -> bool {
  4612	        if !self.entity.is_alive() || self.is_spectator() {
  4613	            return false;
  4614	        }
  4615	
  4616	        let Some(equippable) = item_stack.get_data_component::<EquippableImpl>() else {
  4617	            return false;
  4618	        };
  4619	        if !equippable.dispensable {
  4620	            return false;
  4621	        }
  4622	
  4623	        let allowed = equippable
  4624	            .allowed_entities
  4625	            .as_ref()
  4626	            .is_none_or(|allowed| match allowed {
  4627	                pumpkin_data::data_component_impl::IDSet::IDs(ids) => ids
  4628	                    .iter()
  4629	                    .any(|entity_type| entity_type.id == self.entity.entity_type.id),
  4630	                pumpkin_data::data_component_impl::IDSet::Tag(tag) => {
  4631	                    self.entity.entity_type.is_tagged_with(tag).unwrap_or(false)
  4632	                }
  4633	            });
  4634	        if !allowed {
  4635	            return false;
  4636	        }
  4637	
  4638	        let equipment = self.entity_equipment.lock().await;
  4639	        equipment.get(equippable.slot).is_empty()
  4640	    }

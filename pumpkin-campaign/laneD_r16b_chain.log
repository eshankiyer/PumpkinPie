  4672	    pub async fn reset_state(&self) {
  4673	        self.entity.reset_state().await;
  4674	
  4675	        // Restore to maximum health for this entity type
  4676	        let max_health = self.get_max_health();
  4677	        self.set_health(max_health);
  4678	        // Clear any absorption
  4679	        self.absorption.store(0.0);
  4680	        // Send health metadata
  8140	    look: Vector3<f64>,
  8141	    pitch: f64,
  8142	    gravity: f64,
  8143	) -> Vector3<f64> {
  8144	    let look_horizontal = look.x.hypot(look.z);
  8145	    let horizontal_speed = velocity.x.hypot(velocity.z);
  8146	    let lift = pitch.cos().powi(2);
  8147	
  8148	    velocity.y += gravity * (-1.0 + lift * 0.75);
  8149	    if velocity.y < 0.0 && look_horizontal > 0.0 {
  8150	        let convert = velocity.y * -0.1 * lift;
  8151	        velocity.x += look.x * convert / look_horizontal;
  8152	        velocity.y += convert;
  8153	        velocity.z += look.z * convert / look_horizontal;
  8154	    }
  8155	    if pitch < 0.0 && look_horizontal > 0.0 {
  8156	        let convert = horizontal_speed * -pitch.sin() * 0.04;
  8157	        velocity.x -= look.x * convert / look_horizontal;
  8158	        velocity.y += convert * 3.2;
  8159	        velocity.z -= look.z * convert / look_horizontal;
  8160	    }
  8161	    if look_horizontal > 0.0 {
  8162	        velocity.x += (look.x / look_horizontal * horizontal_speed - velocity.x) * 0.1;
  8163	        velocity.z += (look.z / look_horizontal * horizontal_speed - velocity.z) * 0.1;
  8164	    }
  8165	
  8166	    velocity.multiply(0.99, 0.98, 0.99)
  8167	}

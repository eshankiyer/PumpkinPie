   483	                armor: ArmorConfig::None,
   484	                // `Pillager.finalizeSpawn` calls
   485	                // `populateDefaultEquipmentEnchantments` unconditionally
   486	                // (`Pillager.java:161`), so the crossbow takes the generic
   487	                // `MOB_SPAWN_EQUIPMENT` roll; the mob-specific 1-in-300 Piercing roll
   488	                // chains on top via `Mob::enchant_spawned_weapon`.
   489	                enchanted: true,
   490	                can_pick_up_loot: false,
   491	            },
   492	        );
   493	
   494	        // ─── Vindicator ───
   495	        m.insert(
   496	            "vindicator",
   497	            MobEquipmentDef {
   498	                entity_type: "vindicator",
   499	                weapon: WeaponConfig::Always(&Item::IRON_AXE),
   500	                armor: ArmorConfig::None,
   501	                enchanted: true,
   502	                can_pick_up_loot: false,
   503	            },
   504	        );
   505	
   506	        m
   507	    });

   198	    /// Vanilla: `Vindicator.applyRaidBuffs` (`Vindicator.java:168-180`). Builds a fresh
   199	    /// iron axe, rolls `random.nextFloat() <= raid.getEnchantOdds()` on the raider's own
   200	    /// raid, and on success enchants the axe through the exact `SingleEnchantment`
   201	    /// provider for the wave: `raid/vindicator` (Sharpness I) at waves
   202	    /// `<= getNumGroups(Normal)` and `raid/vindicator_post_wave_5` (Sharpness II) after.
   203	    /// The `DifficultyInstance` argument is threaded through by vanilla but unused by
   204	    /// `SingleEnchantment`, so no regional difficulty is consulted here.
   205	    fn apply_raid_buffs(&self, wave: i32, _is_captain: bool) -> EntityBaseFuture<'_, ()> {
   206	        Box::pin(async move {
   207	            let living = &self.mob_entity.living_entity;
   208	            let mut axe = ItemStack::new(1, &Item::IRON_AXE);
   209	
   210	            // Vindicator.java:170-171: `shouldEnchant =
   211	            // this.random.nextFloat() <= raid.getEnchantOdds()` against
   212	            // `getCurrentRaid()`. Pumpkin keeps only the raid membership cached on the
   213	            // entity, so a missing membership/raid skips the roll entirely (vanilla can
   214	            // never reach this method without an active raid).
   215	            let should_enchant = {
   216	                let world = living.entity.world.load();
   217	                let raids = world.raids.lock().await;
   218	                living
   219	                    .raid_membership
   220	                    .load()
   221	                    .and_then(|membership| raids.raid(membership.raid_id))
   222	                    .is_some_and(|raid| self.get_random().random::<f32>() <= raid.enchant_odds())
   223	            };
   224	
   225	            // Vindicator.java:173-176: provider selection is
   226	            // `wave > raid.getNumGroups(Difficulty.NORMAL)`.
   227	            if should_enchant {
   228	                enchant_item_from_single_enchantment(
   229	                    &mut axe,
   230	                    &Enchantment::SHARPNESS,
   231	                    raid_vindicator_sharpness_level(wave),
   232	                );
   233	            }
   234	
   235	            // Vindicator.java:179: `setItemSlot(EquipmentSlot.MAINHAND, axe)` --
   236	            // unconditional, enchanted or not.
   237	            living
   238	                .entity_equipment
   239	                .lock()
   240	                .await
   241	                .put(&EquipmentSlot::MAIN_HAND, axe);
   242	        })
   243	    }
   244	}

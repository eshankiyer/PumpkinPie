   238	        );
   239	        source.put_long("LootTableSeed", 1234);
   240	        inventory.read_nbt(&source).await;
   241	
   242	        let mut deferred = NbtCompound::new();
   243	        inventory.write_nbt(&mut deferred).await;
   244	        assert_eq!(
   245	            deferred.get_string("LootTable"),
   246	            Some("minecraft:chests/abandoned_mineshaft")
   247	        );
   248	        assert_eq!(deferred.get_long("LootTableSeed"), Some(1234));
   249	        assert!(deferred.get_list("Items").is_none());
   250	
   251	        inventory.unpack_loot().await;
   252	        assert!(!inventory.is_empty().await);
   253	
   254	        let mut unpacked = NbtCompound::new();
   255	        inventory.write_nbt(&mut unpacked).await;
   256	        assert!(unpacked.get_string("LootTable").is_none());
   257	        assert!(unpacked.get_list("Items").is_some());
   258	    }

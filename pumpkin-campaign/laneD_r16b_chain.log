   144	fn potential_bonus_spawns(
   145	    raider_type: RaiderType,
   146	    wave: i32,
   147	    difficulty: Difficulty,
   148	    is_bonus_wave: bool,
   149	) -> i32 {
   150	    let is_easy = difficulty == Difficulty::Easy;
   151	    let is_normal = difficulty == Difficulty::Normal;
   152	    let mut rng = rand::rng();
   153	
   154	    let bonus_spawns = match raider_type {
   155	        RaiderType::Vindicator | RaiderType::Pillager => {
   156	            if is_easy {
   157	                rng.random_range(0..2)
   158	            } else if is_normal {
   159	                1
   160	            } else {
   161	                2
   162	            }
   163	        }
   164	        RaiderType::Evoker => return 0,
   165	        RaiderType::Witch => {
   166	            if is_easy || wave <= 2 || wave == 4 {
   167	                return 0;
   168	            }
   169	            1
   170	        }
   171	        RaiderType::Ravager => i32::from(!is_easy && is_bonus_wave),
   172	    };
   173	
   174	    if bonus_spawns > 0 {
   175	        rng.random_range(0..bonus_spawns + 1)
   176	    } else {
   177	        0
   178	    }

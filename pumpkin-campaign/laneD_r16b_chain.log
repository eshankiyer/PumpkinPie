   888	    /// `ServerLevel.hasChunksAt` over the `+/-10` block square of PatrolSpawner.java:38.
   889	    fn has_chunks_at(world: &Arc<World>, pos: BlockPos) -> bool {
   890	        let min_chunk_x = (pos.0.x - PATROL_REQUIRED_LOADED_DELTA) >> 4;
   891	        let max_chunk_x = (pos.0.x + PATROL_REQUIRED_LOADED_DELTA) >> 4;
   892	        let min_chunk_z = (pos.0.z - PATROL_REQUIRED_LOADED_DELTA) >> 4;
   893	        let max_chunk_z = (pos.0.z + PATROL_REQUIRED_LOADED_DELTA) >> 4;
   894	        for chunk_x in min_chunk_x..=max_chunk_x {
   895	            for chunk_z in min_chunk_z..=max_chunk_z {
   896	                if world
   897	                    .level
   898	                    .loaded_chunks
   899	                    .get(&Vector2::new(chunk_x, chunk_z))
   900	                    .is_none()
   901	                {
   902	                    return false;
   903	                }
   904	            }
   905	        }
   906	        true
   907	    }

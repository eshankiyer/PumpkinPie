   509	// ══════════════════════════════════════════════════════════════════
   510	// Regional Difficulty — exact vanilla DifficultyInstance.java
   511	// Vanilla approximation: identical formula to vanilla Minecraft 26.2's
   512	// DifficultyInstance, including clamped regional difficulty, special
   513	// multiplier (0-1 linear), and effective difficulty (2-4 range).
   514	// ══════════════════════════════════════════════════════════════════
   515	
   516	/// Computed difficulty values for a specific world chunk.
   517	///
   518	/// Mirrors Vanilla's `DifficultyInstance`. Used to scale equipment spawn rates,
   519	/// enchantment costs, and loot-pickup flags.
   520	#[derive(Clone, Copy)]
   521	pub struct RegionalDifficulty {
   522	    /// The world's base difficulty level (`Easy`, `Normal`, `Hard`).
   523	    pub base_difficulty: Difficulty,
   524	    /// Effective difficulty computed from game time, inhabited time, and moon phase.
   525	    /// Clamped to the range `[2.0, 4.0]` (or `0.0` for Peaceful).
   526	    pub effective_difficulty: f32,
   527	    /// Linear multiplier in `[0.0, 1.0]` derived from `effective_difficulty`.
   528	    /// When `0.0` (fresh chunk + early game), no equipment, enchantments, or
   529	    /// loot-pickup flags are applied.
   530	    pub special_multiplier: f32,
   531	}
   532	
   533	impl RegionalDifficulty {
   534	    /// Computes difficulty at the given world position.
   535	    ///
   536	    /// Looks up the chunk's inhabited time and combines it with the world's
   537	    /// difficulty, game time, and moon phase.
   538	    pub fn at(world: &Arc<crate::world::World>, pos: Vector3<f64>) -> Self {
   539	        let level_info = world.level_info.load();
   540	        let difficulty = level_info.difficulty;
   541	        let time_of_day = world.level_time.try_lock().map_or(0, |t| t.time_of_day);
   542	        let inhabited_time = {
   543	            let chunk_x = (pos.x / 16.0).floor() as i32;
   544	            let chunk_z = (pos.z / 16.0).floor() as i32;
   545	            world
   546	                .level
   547	                .loaded_chunks
   548	                .get(&pumpkin_util::math::vector2::Vector2::new(chunk_x, chunk_z))
   549	                .map_or(0, |c| {
   550	                    c.inhabited_time.load(std::sync::atomic::Ordering::Relaxed)
   551	                })
   552	        };
   553	        let moon_brightness = moon_brightness(time_of_day);
   554	
   555	        Self::calculate(difficulty, time_of_day, inhabited_time, moon_brightness)
   556	    }
   557	
   558	    /// Direct calculation from raw inputs. Used by `at()` and for testing.
   559	    #[must_use]
   560	    pub fn calculate(
   561	        difficulty: Difficulty,
   562	        total_game_time: i64,
   563	        chunk_inhabited_time: u64,
   564	        moon_brightness: f32,
   565	    ) -> Self {
   566	        if difficulty == Difficulty::Peaceful {
   567	            return Self {
   568	                base_difficulty: difficulty,
   569	                effective_difficulty: 0.0,
   570	                special_multiplier: 0.0,
   571	            };
   572	        }
   573	
   574	        let is_hard = difficulty == Difficulty::Hard;
   575	
   576	        let mut scale = 0.75f32;
   577	        let global_scale = ((total_game_time as f32 - 72000.0) / 1440000.0).clamp(0.0, 1.0) * 0.25;
   578	        scale += global_scale;
   579	
   580	        let mut local_scale = 0.0f32;
   581	        local_scale += (chunk_inhabited_time as f32 / 3600000.0).clamp(0.0, 1.0)
   582	            * if is_hard { 1.0 } else { 0.75 };
   583	        local_scale += (moon_brightness * 0.25).clamp(0.0, global_scale);
   584	
   585	        if difficulty == Difficulty::Easy {
   586	            local_scale *= 0.5;
   587	        }
   588	
   589	        let difficulty_id = match difficulty {
   590	            Difficulty::Peaceful => 0,
   591	            Difficulty::Easy => 1,
   592	            Difficulty::Normal => 2,
   593	            Difficulty::Hard => 3,
   594	        };
   595	
   596	        let effective = difficulty_id as f32 * (scale + local_scale);
   597	
   598	        let special_multiplier = if effective < 2.0 {
   599	            0.0
   600	        } else if effective > 4.0 {
   601	            1.0
   602	        } else {
   603	            (effective - 2.0) / 2.0
   604	        };
   605	
   606	        Self {
   607	            base_difficulty: difficulty,
   608	            effective_difficulty: effective,
   609	            special_multiplier,
   610	        }
   611	    }
   612	
   613	    /// Random check scaled by `special_multiplier`.
   614	    ///
   615	    /// Returns `true` with probability `base_chance * special_multiplier`. When
   616	    /// `special_multiplier` is `0.0` this always returns `false` (matching vanilla
   617	    /// behaviour on fresh Normal/Easy worlds).
   618	    #[must_use]
   619	    pub fn should_happen(&self, base_chance: f32) -> bool {
   620	        rand::random::<f32>() < base_chance * self.special_multiplier
   621	    }
   622	}
   623	
   624	/// Moon brightness factor for the given time of day (0.0 to 1.0).
   625	/// Full moon at phase 0, new moon at phase 4.
   626	#[must_use]
   627	fn moon_brightness(time_of_day: i64) -> f32 {
   628	    let phase = (time_of_day / 24000 % 8) as i32;
   629	    if phase == 0 {
   630	        1.0
   631	    } else {
   632	        1.0 - (phase - 4).abs() as f32 / 4.0
   633	    }
   634	}
   635	
   636	// ══════════════════════════════════════════════════════════════════
   637	// Mob.enchantSpawnedArmor / enchantSpawnedWeapon — vanilla port
   638	// Sources: Mob.java:1055-1081, EnchantmentsByCostWithDifficulty.java:31-38,
   639	// EnchantmentHelper.java:547-578,597-612, WeightedRandom, ItemEnchantments.Mutable
   640	// ══════════════════════════════════════════════════════════════════
   641	
   642	/// Base provider cost before the enchantability bonus.
   643	///
   644	/// Vanilla `EnchantmentsByCostWithDifficulty.enchant`
   645	/// (`EnchantmentsByCostWithDifficulty.java:33-34`):
   646	///
   647	/// ```java
   648	/// int cost = Mth.randomBetweenInclusive(random, this.minCost,
   649	///     this.minCost + (int) (difficultyModifier * this.maxCostSpan));
   650	/// ```
   651	///
   652	/// The Java `(int)` cast truncates toward zero, so e.g. `0.999 * 17 = 16.983`
   653	/// yields a span of 16 (not 17).
   654	#[must_use]
   655	fn mob_spawn_equipment_base_cost<R: Rng + ?Sized>(rng: &mut R, special_multiplier: f32) -> i32 {
   656	    let span = (special_multiplier * MOB_SPAWN_ENCHANT_COST_SPAN as f32) as i32;
   657	    MOB_SPAWN_ENCHANT_MIN_COST + rng.random_range(0..=span)
   658	}
   659	
   660	/// Vanilla `WeightedRandom.getRandomItem(random, entries, EnchantmentInstance::weight)`
   661	/// (`EnchantmentInstance.weight` delegates to `Enchantment.getWeight`,
   662	/// `EnchantmentInstance.java:8-10`). Integer weights and an exclusive upper hit test,
   663	/// unlike a floating-point roll.
   664	#[must_use]
   665	fn weighted_random_enchantment<R: Rng + ?Sized>(
   666	    rng: &mut R,
   667	    entries: &[(&'static Enchantment, i32)],
   668	) -> Option<(&'static Enchantment, i32)> {
   669	    let total_weight: i32 = entries.iter().map(|(entry, _)| entry.weight).sum();
   670	    if total_weight <= 0 {
   671	        return None;
   672	    }
   673	    let mut roll = rng.random_range(0..total_weight);
   674	    for entry in entries {
   675	        roll -= entry.0.weight;
   676	        if roll < 0 {
   677	            return Some(*entry);
   678	        }
   679	    }
   680	    None
   681	}
   682	
   683	/// Vanilla `EnchantmentHelper.getAvailableEnchantmentResults`
   684	/// (`EnchantmentHelper.java:597-612`) restricted to the mob-spawn pool.
   685	///
   686	/// An enchantment is available at the highest level whose cost window
   687	/// `[min_cost(level), max_cost(level)]` contains `cost`, and only when the item is
   688	/// one of its primary items (`Enchantment.isPrimaryItem`, `Enchantment.java:130-131`).
   689	/// The vanilla book branch (`itemStack.is(Items.BOOK)`) is unreachable here:
   690	/// books carry no `minecraft:enchantable` component, so
   691	/// [`select_spawn_enchantments`] bails out before reaching this scan.
   692	#[must_use]
   693	fn available_spawn_enchantment_results(
   694	    cost: i32,
   695	    item: &'static Item,
   696	) -> Vec<(&'static Enchantment, i32)> {
   697	    MOB_SPAWN_EQUIPMENT_POOL
   698	        .iter()
   699	        .filter_map(|enchantment| {
   700	            if !enchantment.is_primary_item(item) {
   701	                return None;
   702	            }
   703	            (1..=enchantment.max_level)
   704	                .rev()
   705	                .find(|level| {
   706	                    cost >= enchantment.min_cost.calculate(*level)
   707	                        && cost <= enchantment.max_cost.calculate(*level)
   708	                })
   709	                .map(|level| (*enchantment, level))
   710	        })
   711	        .collect()
   712	}
   713	
   714	/// Vanilla `EnchantmentHelper.selectEnchantment` (`EnchantmentHelper.java:547-578`)
   715	/// for the mob-spawn equipment pool.
   716	///
   717	/// Raises `cost` by an enchantability bonus plus a ±15% random span, then repeatedly
   718	/// picks weighted candidates while ``nextInt(50) <= cost``, halving the cost between
   719	/// picks. Compatibility filtering mirrors `filterCompatibleEnchantments`
   720	/// (`EnchantmentHelper.java:581-583`): everything incompatible with the most recent
   721	/// pick — including itself — leaves the candidate list.
   722	#[must_use]
   723	fn select_spawn_enchantments<R: Rng + ?Sized>(
   724	    rng: &mut R,
   725	    stack: &ItemStack,
   726	    mut cost: i32,
   727	) -> Vec<(&'static Enchantment, i32)> {
   728	    let Some(enchantable) = stack.get_data_component::<EnchantableImpl>() else {
   729	        return Vec::new();
   730	    };
   731	
   732	    // `enchantmentCost += 1 + random.nextInt(value / 4 + 1) + random.nextInt(value / 4 + 1);`
   733	    let quarter = enchantable.value / 4;
   734	    cost += 1 + rng.random_range(0..=quarter) + rng.random_range(0..=quarter);
   735	
   736	    // `randomSpan = (nextFloat() + nextFloat() - 1.0F) * 0.15F;` then
   737	    // `Mth.clamp(Math.round(cost + cost * randomSpan), 1, Integer.MAX_VALUE)`.
   738	    let random_span = (rng.random::<f32>() + rng.random::<f32>() - 1.0) * 0.15;
   739	    let scaled = cost as f32 + cost as f32 * random_span;
   740	    cost = ((scaled + 0.5).floor() as i64).clamp(1, i64::from(i32::MAX)) as i32;
   741	
   742	    let mut available = available_spawn_enchantment_results(cost, stack.item);
   743	    let mut results: Vec<(&'static Enchantment, i32)> = Vec::new();
   744	
   745	    // First pick happens before any cost halving or repeat gate.
   746	    let Some(first) = weighted_random_enchantment(rng, &available) else {
   747	        return results;
   748	    };
   749	    results.push(first);
   750	
   751	    while rng.random_range(0..50) <= cost {
   752	        if let Some((last, _)) = results.last() {
   753	            available.retain(|(candidate, _)| last.are_compatible(candidate));
   754	        }
   755	
   756	        if available.is_empty() {
   757	            break;
   758	        }
   759	
   760	        if let Some(next) = weighted_random_enchantment(rng, &available) {
   761	            results.push(next);
   762	        } else {
   763	            break;
   764	        }
   765	        cost /= 2;
   766	    }
   767	
   768	    results
   769	}
   770	
   771	/// Vanilla `EnchantmentsByCostWithDifficulty.enchant`
   772	/// (`EnchantmentsByCostWithDifficulty.java:31-38`): draw a difficulty-scaled base
   773	/// cost, run [`select_spawn_enchantments`], and upgrade the stack with every result.
   774	///
   775	/// `ItemStack::enchant` keeps `max(existing, new)` per enchantment, matching
   776	/// `ItemEnchantments.Mutable.upgrade` (`ItemEnchantments.java:139-143`), so any
   777	/// enchantments already on the equipped stack are preserved, never downgraded.
   778	fn mob_spawn_equipment_provider_enchant<R: Rng + ?Sized>(
   779	    rng: &mut R,
   780	    stack: &mut ItemStack,
   781	    special_multiplier: f32,
   782	) {
   783	    let cost = mob_spawn_equipment_base_cost(rng, special_multiplier);
   784	    for (enchantment, level) in select_spawn_enchantments(rng, stack, cost) {
   785	        stack.enchant(enchantment, level);
   786	    }
   787	}
   788	
   789	/// Vanilla `EnchantmentHelper.enchantItemFromProvider` with the
   790	/// `minecraft:mob_spawn_equipment` provider key
   791	/// (`VanillaEnchantmentProviders.java:24`, `EnchantmentHelper.java:613-624`):
   792	/// delegates to [`mob_spawn_equipment_provider_enchant`] with the difficulty's own
   793	/// special multiplier. Exposed for callers outside the spawn pipeline that vanilla
   794	/// routes through the same provider (`SkeletonTrapGoal.enchant`,
   795	/// `SkeletonTrapGoal.java:95-102`).
   796	pub(crate) fn enchant_item_from_mob_spawn_equipment<R: Rng + ?Sized>(
   797	    rng: &mut R,
   798	    stack: &mut ItemStack,
   799	    difficulty: &RegionalDifficulty,
   800	) {
   801	    mob_spawn_equipment_provider_enchant(rng, stack, difficulty.special_multiplier);
   802	}
   803	
   804	/// Vanilla `ItemStack.set(DataComponents.ENCHANTMENTS, ItemEnchantments.EMPTY)` as
   805	/// performed by `SkeletonTrapGoal.enchant` (`SkeletonTrapGoal.java:97`): drops every
   806	/// enchantment already on the stack so a provider re-roll starts from scratch.
   807	pub(crate) fn clear_enchantments(stack: &mut ItemStack) {
   808	    stack
   809	        .patch
   810	        .retain(|(id, _)| *id != DataComponent::Enchantments);
   811	    stack.patch.push((
   812	        DataComponent::Enchantments,
   813	        Some(
   814	            EnchantmentsImpl {
   815	                enchantment: Cow::Owned(Vec::new()),
   816	            }
   817	            .to_dyn(),
   818	        ),
   819	    ));
   820	}
   821	
   822	/// Vanilla `SingleEnchantment.enchant` (`SingleEnchantment.java:24-29`) for the
   823	/// providers registered with a `ConstantInt` level
   824	/// (`VanillaEnchantmentProviders.java:25-30`, e.g. `raid/vindicator`): upgrade the
   825	/// stack with `Mth.clamp(level.sample(random), getMinLevel(), getMaxLevel())`.
   826	/// Sampling a `ConstantInt` consumes no entropy and vanilla enchantment minimums are
   827	/// always 1 (only `max_level` is stored on [`Enchantment`]), so the clamped level is
   828	/// exact without threading an RNG through.
   829	pub(crate) fn enchant_item_from_single_enchantment(
   830	    stack: &mut ItemStack,
   831	    enchantment: &'static Enchantment,
   832	    level: i32,
   833	) {
   834	    stack.enchant(enchantment, level.clamp(1, enchantment.max_level));
   835	}
   836	
   837	/// Vanilla `Mob.enchantSpawnedEquipment` (`Mob.java:1073-1081`).
   838	///
   839	/// Rolls `nextFloat() < chance * difficulty.getSpecialMultiplier()` for a non-empty
   840	/// stack, then applies the `MOB_SPAWN_EQUIPMENT` provider in place. Returns whether
   841	/// the roll succeeded and enchanting was attempted.
   842	fn enchant_spawned_equipment<R: Rng + ?Sized>(
   843	    rng: &mut R,
   844	    stack: &mut ItemStack,
   845	    chance: f32,
   846	    difficulty: &RegionalDifficulty,
   847	) -> bool {
   848	    if stack.is_empty() || rng.random::<f32>() >= chance * difficulty.special_multiplier {
   849	        return false;
   850	    }
   851	    mob_spawn_equipment_provider_enchant(rng, stack, difficulty.special_multiplier);
   852	    true
   853	}
   854	
   855	/// Vanilla `Mob.enchantSpawnedWeapon` (`Mob.java:1065-1067`): same shared helper as
   856	/// armor with a `0.25F` base chance on the main-hand item.
   857	fn enchant_spawned_weapon<R: Rng + ?Sized>(
   858	    rng: &mut R,
   859	    stack: &mut ItemStack,
   860	    difficulty: &RegionalDifficulty,
   861	) -> bool {
   862	    enchant_spawned_equipment(rng, stack, WEAPON_ENCHANT_CHANCE, difficulty)
   863	}
   864	
   865	/// Vanilla `Mob.enchantSpawnedArmor` (`Mob.java:1069-1071`): enchants whatever item
   866	/// currently occupies a humanoid-armor slot via the shared helper with a `0.5F` base
   867	/// chance. The slot itself takes no further part — like vanilla, candidate filtering
   868	/// is driven by the equipped stack's own items/primary-item tags.
   869	fn enchant_spawned_armor<R: Rng + ?Sized>(
   870	    rng: &mut R,
   871	    stack: &mut ItemStack,
   872	    difficulty: &RegionalDifficulty,
   873	) -> bool {
   874	    enchant_spawned_equipment(rng, stack, ARMOR_ENCHANT_CHANCE, difficulty)
   875	}

   200	impl EntityBase for MinecartEntity {
   201	    #[allow(clippy::too_many_lines)]
   202	    fn tick<'a>(
   203	        &'a self,
   204	        caller: &'a Arc<dyn EntityBase>,
   205	        server: &'a Server,
   206	    ) -> EntityBaseFuture<'a, ()> {
   207	        Box::pin(async move {
   208	            self.vehicle.tick();
   209	
   210	            // Vanilla runs `entityInside` for every entity moving through a block, vehicles
   211	            // included, which is how a cart trips a detector rail or a pressure plate. This
   212	            // hook was wired for falling blocks, items, orbs, TNT and living entities but
   213	            // never for vehicles, so those blocks could never fire from a cart at all.
   214	            self.vehicle
   215	                .entity
   216	                .tick_block_collisions(caller, server)
   217	                .await;
   218	            if let MinecartKind::Furnace(minecart) = &self.kind {
   219	                minecart.tick(&self.vehicle.entity);
   220	            }
   221	
   222	            let world = self.vehicle.entity.world.load();
   223	            let pos = self.vehicle.entity.pos.load();
   224	            let mut block_pos = BlockPos(Vector3::new(
   225	                pos.x.floor() as i32,
   226	                pos.y.floor() as i32,
   227	                pos.z.floor() as i32,
   228	            ));
   229	
   230	            // `MinecartSpawner.tick` (MinecartSpawner.java:68-72) runs the carried
   231	            // spawner's ticker every entity tick (MinecartSpawner.java:40-44), from the
   232	            // cart's current position rather than a fixed one.
   233	            if let MinecartKind::Spawner(minecart) = &self.kind {
   234	                minecart.tick(&world, block_pos, &self.vehicle.entity).await;
   235	            }
   236	
   237	            if let MinecartKind::CommandBlock(minecart) = &self.kind {
   238	                minecart.tick();
   239	            }
   240	
   241	            let mut block = world.get_block(&block_pos);
   242	            let mut state_id = world.get_block_state_id(&block_pos);
   243	
   244	            let mut is_powered_rail = block.id == Block::POWERED_RAIL.id;
   245	            let mut is_activator_rail = block.id == Block::ACTIVATOR_RAIL.id;
   246	            let mut is_on_rails = is_powered_rail
   247	                || is_activator_rail
   248	                || block.id == Block::RAIL.id
   249	                || block.id == Block::DETECTOR_RAIL.id;
   250	
   251	            // If not on rails at current Y level, check the block directly below
   252	            if !is_on_rails {
   253	                let below_block_pos = BlockPos(Vector3::new(
   254	                    block_pos.0.x,
   255	                    block_pos.0.y - 1,
   256	                    block_pos.0.z,

   173	    /// Vanilla: `Vindicator.setCustomName`'s one-way "Johnny" latch. Pumpkin has no per-mob
   174	    /// custom-name-changed hook, so this lazily checks-and-latches every tick instead (up to one
   175	    /// tick of latency versus vanilla's setter-time latch, unobservable to a player).
   176	    /// Also `customServerAiStep`: `getNavigation().setCanOpenDoors(level.isRaided(pos))`,
   177	    /// approximated with `has_active_raid()` (this mob's own raid membership) rather than
   178	    /// re-querying the level for any raid covering this position -- same approximation
   179	    /// `InteractWithDoorGoal::raid_gated`/`BreakDoorGoal` already use.
   180	    fn mob_tick<'a>(&'a self, _caller: &'a Arc<dyn EntityBase>) -> EntityBaseFuture<'a, ()> {
   181	        Box::pin(async move {
   182	            if !self.is_johnny.load(Relaxed)
   183	                && let Some(name) = &**self.mob_entity.living_entity.entity.custom_name.load()
   184	                && name.clone().get_text() == "Johnny"
   185	            {
   186	                self.is_johnny.store(true, Relaxed);
   187	            }
   188	
   189	            let can_open_doors = self.mob_entity.living_entity.has_active_raid();
   190	            self.mob_entity
   191	                .navigator
   192	                .lock()
   193	                .unwrap()
   194	                .set_can_open_doors(can_open_doors);
   195	        })
   196	    }

   246	/// Vindicator.java:173-175: waves past `Raid.getNumGroups(Difficulty.NORMAL)`
   247	/// (`Raid.java:786-793`, 5 on Normal) use `RAID_VINDICATOR_POST_WAVE_5`
   248	/// (Sharpness II); all others use `RAID_VINDICATOR` (Sharpness I).
   249	const fn raid_vindicator_sharpness_level(wave: i32) -> i32 {
   250	    if wave > num_groups_for_difficulty(Difficulty::Normal) {
   251	        2
   252	    } else {
   253	        1
   254	    }
   255	}

   264	
   265	    #[test]
   266	    fn vindicator_provider_level_follows_vanilla_wave_threshold() {
   267	        // Vindicator.java:173-175 with Raid.getNumGroups(NORMAL) == 5.
   268	        assert_eq!(
   269	            raid_vindicator_sharpness_level(num_groups_for_difficulty(Difficulty::Normal)),
   270	            1
   271	        );
   272	        assert_eq!(
   273	            raid_vindicator_sharpness_level(num_groups_for_difficulty(Difficulty::Normal) + 1),
   274	            2
   275	        );
   276	        for wave in 1..=5 {
   277	            assert_eq!(raid_vindicator_sharpness_level(wave), 1, "wave {wave}");
   278	        }
   279	        for wave in 6..=9 {
   280	            assert_eq!(raid_vindicator_sharpness_level(wave), 2, "wave {wave}");
   281	        }
   282	    }
   283	
   284	    #[test]
   285	    fn raid_buffs_enchant_is_exact_single_sharpness() {
   286	        // The providers are `SingleEnchantment(SHARPNESS, ConstantInt(1|2))`
   287	        // (`VanillaEnchantmentProviders.java:28-29`), so a buffed axe carries exactly
   288	        // Sharpness I or II -- never extra enchantments or other levels.
   289	        let sharpness_id = u16::from(Enchantment::SHARPNESS.id);

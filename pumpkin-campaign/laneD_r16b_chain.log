   602	        } else {
   603	            None
   604	        };
   605	        Some(Self {
   606	            slot,
   607	            equip_sound,
   608	            asset_id,
   609	            camera_overlay,
   610	            allowed_entities,
   611	            dispensable,
   612	            swappable,
   613	            damage_on_hurt,

  8169	/// Vanilla `LivingEntity.handleFallFlyingCollisions` damage threshold.
  8170	fn fall_flying_collision_damage(previous_speed: f64, new_speed: f64) -> Option<f32> {
  8171	    let damage = ((previous_speed - new_speed) * 10.0 - 3.0) as f32;
  8172	    (damage > 0.0).then_some(damage)
  8173	}

   175	impl Mob for PillagerEntity {
   176	    fn get_mob_entity(&self) -> &MobEntity {
   177	        &self.mob_entity
   178	    }
   179	
   180	    /// Vanilla `Pillager.canUseNonMeleeWeapon` (`Pillager.java:97-101`) permits its crossbow
   181	    /// attack behavior to select a crossbow as a non-melee weapon.
   182	    fn can_use_non_melee_weapon(&self, item: &ItemStack) -> bool {
   183	        item.item.id == Item::CROSSBOW.id
   184	    }
   185	
   186	    /// Vanilla: `Pillager.enchantSpawnedWeapon` (`Pillager.java:172-181`). After the generic
   187	    /// `MOB_SPAWN_EQUIPMENT` weapon roll has run on the freshly equipped crossbow,
   188	    /// `this.random.nextInt(300) == 0` enchants it through the `pillager_spawn_crossbow`
   189	    /// provider (`VanillaEnchantmentProviders.java:25`) — a `SingleEnchantment(Piercing,
   190	    /// ConstantInt.of(1))` (`VanillaEnchantmentProviders.java:28`, `piercing` at level 1), so
   191	    /// the crossbow carries exactly Piercing I.
   192	    fn enchant_spawned_weapon(&self, main_hand: &mut ItemStack) {
   193	        if self.get_random().random_range(0..300) == 0 {
   194	            enchant_item_from_single_enchantment(main_hand, &Enchantment::PIERCING, 1);
   195	        }
   196	    }
   197	
   198	    /// Vanilla: `Pillager.applyRaidBuffs` (`Pillager.java:234-256`). Rolls
   199	    /// `random.nextFloat() <= raid.getEnchantOdds()` against the raider's own raid, and only
   200	    /// on success builds a fresh crossbow enchanted through the wave-selected provider
   201	    /// (`VanillaEnchantmentProviders.java:26-27`): waves past `getNumGroups(NORMAL)` use
   202	    /// `raid/pillager_post_wave_5` (Quick Charge II), waves past `getNumGroups(EASY)` use
   203	    /// `raid/pillager_post_wave_3` (Quick Charge I); below those thresholds no provider
   204	    /// applies and the pillager keeps its current crossbow. Unlike a vindicator's axe, an
   205	    /// unenchanted roll leaves the slot untouched (`Pillager.java:248-253`).
   206	    fn apply_raid_buffs(&self, wave: i32, _is_captain: bool) -> EntityBaseFuture<'_, ()> {
   207	        Box::pin(async move {
   208	            // `this.getCurrentRaid()` / `raid.getEnchantOdds()` (`Pillager.java:238-239`).
   209	            // Pumpkin keeps only the raid membership cached on the entity, so a missing
   210	            // membership/raid skips the roll entirely (vanilla can never reach this method
   211	            // without an active raid).
   212	            let living = &self.mob_entity.living_entity;
   213	            let should_enchant = {
   214	                let world = living.entity.world.load();
   215	                let raids = world.raids.lock().await;
   216	                living
   217	                    .raid_membership
   218	                    .load()
   219	                    .and_then(|membership| raids.raid(membership.raid_id))
   220	                    .is_some_and(|raid| self.get_random().random::<f32>() <= raid.enchant_odds())
   221	            };
   222	            if !should_enchant {
   223	                return;
   224	            }
   225	
   226	            // `Pillager.java:240-245`: provider selection by wave threshold; `null` keeps
   227	            // the existing crossbow.
   228	            let quick_charge_level = if wave > num_groups_for_difficulty(Difficulty::Normal) {
   229	                2
   230	            } else if wave > num_groups_for_difficulty(Difficulty::Easy) {
   231	                1
   232	            } else {
   233	                return;
   234	            };
   235	
   236	            let mut crossbow = ItemStack::new(1, &Item::CROSSBOW);
   237	            enchant_item_from_single_enchantment(
   238	                &mut crossbow,
   239	                &Enchantment::QUICK_CHARGE,
   240	                quick_charge_level,
   241	            );
   242	            // `this.setItemSlot(EquipmentSlot.MAINHAND, crossbow)` (`Pillager.java:252`),
   243	            // synced to observers the same way other direct equipment writes broadcast.
   244	            living
   245	                .entity_equipment
   246	                .lock()
   247	                .await
   248	                .put(&EquipmentSlot::MAIN_HAND, crossbow.clone());
   249	            living.send_equipment_changes(&[(EquipmentSlot::MAIN_HAND, crossbow)]);
   250	        })
   251	    }
   252	
   253	    /// Vanilla: `Pillager.setChargingCrossbow`. Drives `getArmPose()`'s `CROSSBOW_CHARGE` state
   254	    /// client-side (not ported -- see the illager-family "no client rendering" scope cut), but is
   255	    /// still a real synced-data write other clients observe (visible crossbow draw animation).
   256	    fn set_charging_crossbow(&self, charging: bool) {
   257	        if self.is_charging_crossbow.swap(charging, Relaxed) != charging {
   258	            self.mob_entity.living_entity.entity.send_meta_data(
   259	                &[Metadata::new(
   260	                    tracked_data::pillager::IS_CHARGING_CROSSBOW,
   261	                    charging,
   262	                )],
   263	                None,
   264	            );
   265	        }
   266	    }
   267	}

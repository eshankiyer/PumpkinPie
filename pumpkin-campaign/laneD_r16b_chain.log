  1221	    #[test]
  1222	    fn candidates_follow_primary_items_per_slot() {
  1223	        // Respiration/Aqua Affinity list helmets as primary items; Depth Strider is
  1224	        // boots-only. No cost may leak them across slots, and slot-appropriate
  1225	        // enchantments must appear somewhere in the reachable cost range.
  1226	        let helmet = &Item::DIAMOND_HELMET;
  1227	        let chestplate = &Item::DIAMOND_CHESTPLATE;
  1228	        let boots = &Item::DIAMOND_BOOTS;
  1229	
  1230	        let mut respiration_seen = false;
  1231	        let mut depth_strider_seen = false;
  1232	        for cost in 0..=80i32 {
  1233	            let head: Vec<_> = available_spawn_enchantment_results(cost, helmet)
  1234	                .into_iter()
  1235	                .map(|(enchantment, _)| enchantment)
  1236	                .collect();
  1237	            if head.contains(&&Enchantment::RESPIRATION) {
  1238	                respiration_seen = true;
  1239	            }
  1240	            assert!(!head.contains(&&Enchantment::DEPTH_STRIDER));
  1241	            assert!(!head.contains(&&Enchantment::FEATHER_FALLING));
  1242	
  1243	            let chest: Vec<_> = available_spawn_enchantment_results(cost, chestplate)
  1244	                .into_iter()
  1245	                .map(|(enchantment, _)| enchantment)
  1246	                .collect();
  1247	            assert!(!chest.contains(&&Enchantment::RESPIRATION));
  1248	            assert!(!chest.contains(&&Enchantment::AQUA_AFFINITY));
  1249	
  1250	            let feet: Vec<_> = available_spawn_enchantment_results(cost, boots)
  1251	                .into_iter()
  1252	                .map(|(enchantment, _)| enchantment)
  1253	                .collect();
  1254	            assert!(!feet.contains(&&Enchantment::RESPIRATION));
  1255	            if feet.contains(&&Enchantment::DEPTH_STRIDER) {
  1256	                depth_strider_seen = true;
  1257	            }
  1258	        }
  1259	        assert!(respiration_seen, "helmets must be able to roll Respiration");
  1260	        assert!(
  1261	            depth_strider_seen,
  1262	            "boots must be able to roll Depth Strider"
  1263	        );
  1264	    }

    96	    fn is_empty(&self) -> InventoryFuture<'_, bool> {
    97	        Box::pin(async move {
    98	            let items = self.items.read().await;
    99	            items.iter().all(ItemStack::is_empty)
   100	        })
   101	    }
   102	
   103	    fn get_stack(&self, slot: usize) -> InventoryFuture<'_, ItemStack> {
   104	        Box::pin(async move { self.items.read().await[slot].clone() })
   105	    }
   106	
   107	    fn remove_stack(&self, slot: usize) -> InventoryFuture<'_, ItemStack> {
   108	        Box::pin(async move {
   109	            let mut items = self.items.write().await;
   110	            std::mem::replace(&mut items[slot], ItemStack::EMPTY.clone())
   111	        })
   112	    }
   113	
   114	    fn remove_stack_specific(&self, slot: usize, amount: u8) -> InventoryFuture<'_, ItemStack> {
   115	        Box::pin(async move {
   116	            let mut items = self.items.write().await;
   117	            if !items[slot].is_empty() && amount > 0 {
   118	                items[slot].split(amount)
   119	            } else {
   120	                ItemStack::EMPTY.clone()
   121	            }
   122	        })
   123	    }
   124	
   125	    fn set_stack(&self, slot: usize, stack: ItemStack) -> InventoryFuture<'_, ()> {
   126	        Box::pin(async move {
   127	            self.items.write().await[slot] = stack;
   128	        })
   129	    }

  4434	    async fn damage_armor_items(
  4435	        &self,
  4436	        caller: &dyn EntityBase,
  4437	        damage_amount: f32,
  4438	        damage_type: &DamageType,
  4439	        helmet_only: bool,
  4440	    ) {
  4441	        // Vanilla's base `hurtArmor` and `hurtHelmet` are empty
  4442	        // (`LivingEntity.java:1881-1885`). The live overrides are Player's humanoid armor
  4443	        // hooks (`Player.java:738-745`), Wolf's body armor hook (`Wolf.java:443-444`), and
  4444	        // Horse's body armor hook (`Horse.java:233-234`). Keep durability on those same
  4445	        // concrete entities; generic living mobs must not lose armor merely because they have
  4446	        // armor attributes or equipment.
  4447	        let entity_type = self.entity.entity_type;
  4448	        let supported = entity_type == &EntityType::PLAYER
  4449	            || entity_type == &EntityType::WOLF
  4450	            || entity_type == &EntityType::HORSE;
  4451	        if !supported {
  4452	            return;
  4453	        }
  4454	
  4455	        // Formula: armor loses floor(incoming_damage / 4) durability, minimum 1.
  4456	        let armor_damage = (damage_amount / 4.0).floor().max(1.0) as i32;
  4457	        let mut equipment_updates = Vec::new();
  4458	
  4459	        // TODO: Implement DAMAGE_RESISTANT component checks (e.g. netherite vs fire).
  4460	
  4461	        let armor_slots: Vec<(usize, ItemStack, EquipmentSlot)> = {
  4462	            let equipment_lock = self.entity_equipment.lock().await;
  4463	            self.equipment_slots
  4464	                .iter()
  4465	                .filter(|(_, slot)| hurt_armor_slot(entity_type, slot, helmet_only))
  4466	                .filter_map(|(index, slot)| {
  4467	                    equipment_lock
  4468	                        .equipment
  4469	                        .get(slot)
  4470	                        .cloned()
  4471	                        .map(|stack| (*index, stack, slot.clone()))
  4472	                })
  4473	                .collect()
  4474	        };
  4475	
  4476	        for (slot_index, mut stack, slot) in armor_slots {
  4477	            if stack.is_empty() || armor_resists_damage(&stack, damage_type) {
  4478	                continue;
  4479	            }
  4480	
  4481	            let takes_damage = stack
  4482	                .get_data_component::<EquippableImpl>()
  4483	                .is_none_or(|equippable| equippable.damage_on_hurt);
  4484	
  4485	            if takes_damage {
  4486	                let broken_item = stack.clone();
  4487	                let slot_result = stack.damage_item(armor_damage);
  4488	                if slot_result != pumpkin_data::item_stack::DamageResult::Untouched {
  4489	                    if slot_result == pumpkin_data::item_stack::DamageResult::Broken {
  4490	                        // Vanilla armor damage calls `onEquippedItemBroken` while the broken item
  4491	                        // is still available (`LivingEntity.java:3845-3848`), which broadcasts
  4492	                        // the break status and removes attribute modifiers; the client then plays
  4493	                        // `breakItem`'s particles (`LivingEntity.java:1439-1448`) in response.
  4494	                        self.on_equipped_item_broken(&broken_item, &slot).await;
  4495	                        self.spawn_item_particles(&broken_item, 5);
  4496	                    }
  4497	                    equipment_updates.push((slot.clone(), stack.clone()));
  4498	                    if let Some(player) = caller.get_player() {
  4499	                        player
  4500	                            .enqueue_slot_set_packet(&CSetPlayerInventory::new(
  4501	                                (slot_index as i32).into(),
  4502	                                &ItemStackSerializer::from(stack),
  4503	                            ))
  4504	                            .await;
  4505	                    }
  4506	                }
  4507	            }
  4508	        }
  4509	
  4510	        if !equipment_updates.is_empty() {
  4511	            self.send_equipment_changes(&equipment_updates);
  4512	        }
  4513	    }

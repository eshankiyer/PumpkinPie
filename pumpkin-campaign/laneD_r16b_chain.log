  4527	    /// Vanilla `Monster.getProjectile` checks the opposite hand before the weapon hand and
  4528	    /// falls back to a plain arrow (`Monster.java:138-148`; `ProjectileWeaponItem.java:33-40`).
  4529	    /// The live caller is the shared skeleton bow goal.
  4530	    pub async fn get_projectile(&self, held_weapon: &ItemStack) -> ItemStack {
  4531	        if held_weapon.item.id != Item::BOW.id {
  4532	            return ItemStack::EMPTY.clone();
  4533	        }
  4534	
  4535	        let equipment = self.entity_equipment.lock().await;
  4536	        for slot in [EquipmentSlot::OFF_HAND, EquipmentSlot::MAIN_HAND] {
  4537	            let stack = equipment.get(&slot);
  4538	            if !stack.is_empty() && is_bow_projectile(stack.item) {
  4539	                return stack;
  4540	            }
  4541	        }
  4542	
  4543	        ItemStack::new(1, &Item::ARROW)
  4544	    }

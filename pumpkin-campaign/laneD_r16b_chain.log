  1266	    #[test]
  1267	    fn candidate_levels_sit_at_the_highest_affordable_cost_window() {
  1268	        // For every cost, each result must satisfy both window bounds
  1269	        // (`value >= getMinCost(level) && value <= getMaxCost(level)`,
  1270	        // `EnchantmentHelper.java:603-609`) and be the highest fitting level — the
  1271	        // scan runs from max level downwards and stops at the first match.
  1272	        for item in [
  1273	            &Item::LEATHER_HELMET,
  1274	            &Item::IRON_CHESTPLATE,
  1275	            &Item::DIAMOND_BOOTS,
  1276	        ] {
  1277	            for cost in 0..=80i32 {
  1278	                for (enchantment, level) in available_spawn_enchantment_results(cost, item) {
  1279	                    assert!((1..=enchantment.max_level).contains(&level));
  1280	                    assert!(cost >= enchantment.min_cost.calculate(level));
  1281	                    assert!(cost <= enchantment.max_cost.calculate(level));
  1282	                    let higher = level + 1;
  1283	                    assert!(
  1284	                        higher > enchantment.max_level
  1285	                            || cost < enchantment.min_cost.calculate(higher)
  1286	                            || cost > enchantment.max_cost.calculate(higher),
  1287	                        "{} L{level} is not the highest window fit for cost {cost}",
  1288	                        enchantment.registry_key
  1289	                    );
  1290	                }
  1291	            }
  1292	        }
  1293	    }

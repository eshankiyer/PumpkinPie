   145	            let inventory = self.banner_inventory.lock().await;
   146	            let mut items = Vec::with_capacity(BANNER_INVENTORY_SIZE);
   147	            for slot in inventory.iter() {
   148	                let mut item_nbt = NbtCompound::new();
   149	                if let Some(stack) = slot {
   150	                    stack.write_item_stack(&mut item_nbt);
   151	                }
   152	                items.push(NbtTag::Compound(item_nbt));
   153	            }
   154	            nbt.put("Inventory", NbtTag::List(items));
   155	        })
   156	    }
   157	
   158	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   159	        Box::pin(async {
   160	            self.mob_entity.living_entity.read_nbt_non_mut(nbt).await;
   161	
   162	            if let Some(NbtTag::List(items)) = nbt.get("Inventory") {
   163	                let mut inventory = self.banner_inventory.lock().await;
   164	                for (slot, tag) in inventory.iter_mut().zip(items.iter()) {
   165	                    *slot = tag
   166	                        .extract_compound()
   167	                        .and_then(ItemStack::read_item_stack)
   168	                        .filter(|stack| !stack.is_empty());
   169	                }
   170	            }
   171	        })
   172	    }
   173	}

  4345	    /// Tries to use a totem of undying from the entity's hands. If successful, applies the totem effects and returns true.
  4346	    async fn try_use_death_protector(&self, caller: &dyn EntityBase) -> bool {
  4347	        for hand in Hand::all() {
  4348	            let mut stack = self.get_stack_in_hand(caller, hand).await;
  4349	
  4350	            // Clear the stack and use the totem of undying
  4351	            if stack.get_data_component::<DeathProtectionImpl>().is_some() {
  4352	                let mut resurrect_event =
  4353	                    crate::plugin::api::events::entity::entity_resurrect::EntityResurrectEvent::new(
  4354	                        self.entity.entity_id,
  4355	                    );
  4356	                if let Some(server) = self.entity.world.load().server.upgrade() {
  4357	                    server
  4358	                        .plugin_manager
  4359	                        .fire(&server, &mut resurrect_event)
  4360	                        .await;
  4361	                }
  4362	                if resurrect_event.cancelled {
  4363	                    return false;
  4364	                }
  4365	
  4366	                stack.clear();
  4367	                let slot = match hand {
  4368	                    Hand::Right => EquipmentSlot::MAIN_HAND,
  4369	                    Hand::Left => EquipmentSlot::OFF_HAND,
  4370	                };
  4371	                if let Some(player) = caller.get_player() {
  4372	                    player
  4373	                        .inventory()
  4374	                        .entity_equipment
  4375	                        .lock()
  4376	                        .await
  4377	                        .equipment
  4378	                        .insert(slot, stack);
  4379	                } else {
  4380	                    self.entity_equipment
  4381	                        .lock()
  4382	                        .await
  4383	                        .equipment
  4384	                        .insert(slot, stack);
  4385	                }
  4386	                self.set_health(1.0);
  4387	                self.entity.world.load().send_entity_status(
  4388	                    &self.entity,
  4389	                    EntityStatus::ProtectedFromDeath,
  4390	                    Some(ActorEventType::TalismanActivate),
  4391	                );
  4392	
  4393	                self.remove_all_effects().await;
  4394	
  4395	                // Set Absorption, Regeneration, and Fire Resistance effects
  4396	                self.add_effect(Effect {
  4397	                    effect_type: &StatusEffect::ABSORPTION,
  4398	                    duration: 100,
  4399	                    amplifier: 1,
  4400	                    ambient: false,
  4401	                    show_particles: true,
  4402	                    show_icon: true,
  4403	                    blend: false,
  4404	                })
  4405	                .await;
  4406	                self.add_effect(Effect {
  4407	                    effect_type: &StatusEffect::REGENERATION,
  4408	                    duration: 900,
  4409	                    amplifier: 1,
  4410	                    ambient: false,
  4411	                    show_particles: true,
  4412	                    show_icon: true,
  4413	                    blend: false,
  4414	                })
  4415	                .await;
  4416	                self.add_effect(Effect {
  4417	                    effect_type: &StatusEffect::FIRE_RESISTANCE,
  4418	                    duration: 800,
  4419	                    amplifier: 0,
  4420	                    ambient: false,
  4421	                    show_particles: true,
  4422	                    show_icon: true,
  4423	                    blend: false,
  4424	                })
  4425	                .await;
  4426	
  4427	                return true;
  4428	            }

  1295	    #[test]
  1296	    fn weighted_pick_matches_vanilla_weight_ratios() {
  1297	        const DRAWS: u32 = 20_000;
  1298	
  1299	        // Generated weights: protection 10 vs thorns 1 (`Enchantment.getWeight`).
  1300	        let entries: [(&Enchantment, i32); 2] =
  1301	            [(&Enchantment::PROTECTION, 1), (&Enchantment::THORNS, 1)];
  1302	        let mut rng = StdRng::seed_from_u64(7);
  1303	        let mut protection = 0u32;
  1304	        for _ in 0..DRAWS {
  1305	            let (picked, _) = weighted_random_enchantment(&mut rng, &entries).unwrap();
  1306	            if picked == &Enchantment::PROTECTION {
  1307	                protection += 1;
  1308	            }
  1309	        }
  1310	        let thorns = DRAWS - protection;
  1311	        // Expected ratio 10:1 with generous bounds so the seeded draw stays stable.
  1312	        assert!(thorns > 0);
  1313	        assert!(
  1314	            protection > thorns * 6 && protection < thorns * 15,
  1315	            "protection {protection} vs thorns {thorns}"
  1316	        );
  1317	    }

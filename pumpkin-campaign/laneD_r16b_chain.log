  8542	    /// Terminal horizontal speed, in blocks per second, of `velocity += input * factor`
  8543	    /// followed by `velocity *= slipperiness * 0.91` as `travel_in_air` applies it on a
  8544	    /// normal block (slipperiness 0.6). `tick_movement` decays the stored input by 0.98
  8545	    /// each tick before travelling, so a continuously re-applied input settles at 0.98.
  8546	    fn terminal_blocks_per_second(input: f64, speed: f64) -> f64 {
  8547	        let per_tick = 0.98 * input * friction_influenced_speed(speed, 0.6);
  8548	        per_tick / (1.0 - 0.6 * 0.91) * 20.0
  8549	    }

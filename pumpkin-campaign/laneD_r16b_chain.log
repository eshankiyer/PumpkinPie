    57	            // pushed us while we were awaiting above
    58	            let velo = entity.velocity.load();
    59	            if entity.on_ground.load(Ordering::Relaxed) {
    60	                entity.velocity.store(velo.multiply(0.7, -0.5, 0.7));
    61	            } else {
    62	                // `PrimedTnt.tick` uses the inherited `Entity.getAirDrag` (`Entity.java:1529-1531`).
    63	                let air_drag = entity.get_air_drag();
    64	                entity
    65	                    .velocity
    66	                    .store(velo.multiply(air_drag, air_drag, air_drag));
    67	            }
    68	
    69	            if entity.velocity_dirty.swap(false, Ordering::SeqCst) {
    70	                entity.send_pos_rot();
    71	                entity.send_velocity();
    72	            }
    73	
    74	            // FIX: Prevent fuse underflow (vanilla parity)
    75	            let fuse = self.fuse.load(Relaxed);
    76	
    77	            if fuse <= 1 {
    78	                // TNT explodes now
    79	                self.entity.remove().await;
    80	                let world = self.entity.world.load();
    81	                if world.level_info.load().game_rules.tnt_explodes {
    82	                    world
    83	                        .explode(
    84	                            self.entity.pos.load(),
    85	                            self.power,
    86	                            crate::world::ExplosionInteraction::Tnt,
    87	                        )
    88	                        .await;
    89	                }
    90	            } else {
    91	                // Safe decrement
    92	                self.fuse.store(fuse - 1, Relaxed);
    93	                entity.update_fluid_state(caller).await;
    94	            }
    95	        })
    96	    }
    97	

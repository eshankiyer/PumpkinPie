   153	impl ScreenHandlerFactory for MinecartScreenFactory {
   154	    fn create_screen_handler<'a>(
   155	        &'a self,
   156	        sync_id: u8,
   157	        player_inventory: &'a Arc<PlayerInventory>,
   158	        _player: &'a dyn InventoryPlayer,
   159	    ) -> BoxFuture<'a, Option<SharedScreenHandler>> {
   160	        Box::pin(async move {
   161	            let inventory: Arc<dyn Inventory> = self.inventory.clone();
   162	            let handler = if self.hopper {
   163	                create_hopper(sync_id, player_inventory, inventory).await
   164	            } else {
   165	                create_generic_9x3(sync_id, player_inventory, inventory).await
   166	            };
   167	            Some(Arc::new(Mutex::new(handler)) as SharedScreenHandler)
   168	        })
   169	    }
   170	
   171	    fn get_display_name(&self) -> TextComponent {
   172	        self.title.clone()
   173	    }
   174	}

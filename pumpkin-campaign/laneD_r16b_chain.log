  8181	/// Vanilla `LivingEntity.updateFallFlying` tick schedule (`LivingEntity.java:3190-3202`).
  8182	/// Takes the consecutive glide tick count plus one; returns whether this tick broadcasts
  8183	/// the `ELYTRA_GLIDE` game event and whether it additionally damages an equipped glider
  8184	/// (every second one-second interval of free fall).
  8185	const fn fall_flying_schedule(check_fall_fly_ticks: u32) -> (bool, bool) {
  8186	    let glide_event_tick = check_fall_fly_ticks.is_multiple_of(10);
  8187	    let damage_glider_tick = glide_event_tick && (check_fall_fly_ticks / 10).is_multiple_of(2);
  8188	    (glide_event_tick, damage_glider_tick)
  8189	}

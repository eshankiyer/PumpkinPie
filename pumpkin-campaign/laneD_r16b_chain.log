    25	impl HopperMinecart {
    26	    pub(super) fn new() -> Self {
    27	        Self {
    28	            enabled: AtomicBool::new(true),
    29	            inventory: Arc::new(MinecartInventory::new(5)),
    30	        }
    31	    }
    32	
    33	    pub(super) const fn inventory(&self) -> &Arc<MinecartInventory> {
    34	        &self.inventory
    35	    }
    36	
    37	    pub(super) fn set_enabled(&self, enabled: bool) {
    38	        self.enabled.store(enabled, Ordering::Relaxed);
    39	    }
    40	
    41	    pub(super) async fn tick(&self, entity: &Entity) {
    42	        if !self.enabled.load(Ordering::Relaxed) {
    43	            return;
    44	        }
    45	
    46	        let world = entity.world.load();
    47	        let pos = entity.pos.load();
    48	        let source_pos = BlockPos::floored(pos.x, pos.y + 1.5, pos.z);
    49	        if let Some(block_entity) = world.get_block_entity(&source_pos)
    50	            && let Some(source) = block_entity.get_inventory()
    51	        {
    52	            for slot in 0..source.size() {
    53	                let stack = source.get_stack(slot).await;
    54	                if stack.is_empty()
    55	                    || !source.can_transfer_to(self.inventory.as_ref(), slot, &stack)
    56	                    // Vanilla `Container.canTakeItem` is a source-to-destination gate
    57	                    // (`JukeboxBlockEntity.java:147-150`).
    58	                    || !source
    59	                        .can_take_item(self.inventory.as_ref(), slot, &stack)
    60	                        .await
    61	                {
    62	                    continue;
    63	                }
    64	                let backup = stack.clone();
    65	                let one = source.remove_stack_specific(slot, 1).await;
    66	                if HopperBlockEntity::add_one_item(
    67	                    source.as_ref(),
    68	                    self.inventory.as_ref(),
    69	                    one,
    70	                    &HOPPER_MINECART_SLOTS,
    71	                )
    72	                .await
    73	                {
    74	                    return;
    75	                }
    76	                source.set_stack(slot, backup).await;
    77	            }
    78	            return;
    79	        }
    80	
    81	        let suction_box = BoundingBox::new(
    82	            Vector3::new(pos.x - 0.5, pos.y + 0.6875, pos.z - 0.5),
    83	            Vector3::new(pos.x + 0.5, pos.y + 2.0, pos.z + 0.5),
    84	        );
    85	        if self.pick_up_item(entity, &suction_box).await {
    86	            return;
    87	        }
    88	        let cart_box = entity.bounding_box.load().expand(0.25, 0.0, 0.25);
    89	        self.pick_up_item(entity, &cart_box).await;
    90	    }

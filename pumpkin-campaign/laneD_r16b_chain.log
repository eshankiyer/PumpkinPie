   597	        let can_be_sheared = compound.get_bool("can_be_sheared").unwrap_or(false);
   598	        let equip_sound = get_idor(compound, "equip_sound", Sound::ItemArmorEquipGeneric);
   599	        let shearing_sound = get_idor(compound, "shearing_sound_sound", Sound::ItemShearsSnip);
   600	        let allowed_entities = if let Some(nbt) = compound.get("allowed_entities") {

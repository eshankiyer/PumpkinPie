  8175	/// Vanilla's shield `BlocksAttacks.ItemDamageFunction(3, 1, 1)`: shields take no
  8176	/// durability loss below three blocked damage, then lose `floor(1 + damage)` points.
  8177	fn shield_block_durability_damage(blocked_damage: f32) -> Option<i32> {
  8178	    (blocked_damage >= 3.0).then_some((1.0 + blocked_damage).floor() as i32)
  8179	}

  1051	// Public entry point
  1052	// ══════════════════════════════════════════════════════════════════
  1053	
  1054	/// Equips a mob with weapons/armor/enchantments when it spawns.
  1055	///
  1056	/// Called from the blanket `EntityBase::init_data_tracker` implementation for
  1057	/// all mob types. Looks up the mob's equipment definition in
  1058	/// [`EQUIPMENT_REGISTRY`], computes [`RegionalDifficulty`] at the mob's
  1059	/// position, generates equipment, stores it in the entity's equipment slots,
  1060	/// and broadcasts the changes to nearby players.
  1061	///
  1062	/// Mobs not listed in the registry silently receive no equipment.
  1063	pub async fn equip_mob_on_spawn(mob: &dyn EntityBase, world: &Arc<crate::world::World>) {
  1064	    let entity_type = mob.get_entity().entity_type;
  1065	    let pos = mob.get_entity().pos.load();
  1066	    let difficulty = RegionalDifficulty::at(world, pos);
  1067	
  1068	    let Some(living) = mob.get_living_entity() else {
  1069	        return;
  1070	    };
  1071	
  1072	    let entity_name = entity_type.resource_name;
  1073	
  1074	    let Some(def) = EQUIPMENT_REGISTRY.get(entity_name) else {
  1075	        return;
  1076	    };
  1077	
  1078	    let mut equipment = living.entity_equipment.lock().await;
  1079	    let mut changes_with_drops = equip_mob_from_def(def, &difficulty);
  1080	
  1081	    // Vanilla dispatches subclass weapon-enchant overrides through the virtual
  1082	    // `Mob.enchantSpawnedWeapon` (`Mob.java:1065-1067`), which Pillager extends with its own
  1083	    // provider roll (`Pillager.java:172-181`). Run the override on the freshly rolled
  1084	    // main-hand stack, after [`enchant_spawned_weapon`]'s generic pass and before the stack
  1085	    // is stored or broadcast — vanilla's `finalizeSpawn` -> `applyRaidBuffs` order.
  1086	    if let Some((_, stack, _)) = changes_with_drops
  1087	        .iter_mut()
  1088	        .find(|(slot, _, _)| *slot == EquipmentSlot::MAIN_HAND)
  1089	        && let Some(mob) = mob.get_mob()
  1090	    {
  1091	        mob.enchant_spawned_weapon(stack);
  1092	    }
  1093	
  1094	    let mut equipment_changes: Vec<(EquipmentSlot, ItemStack)> = Vec::new();
  1095	
  1096	    // `Mob.createEquipmentSlotContainer`/`setDropChance` (`Mob.java:864-877,1102-1105`) stores
  1097	    // each generated stack with its per-slot death-drop chance.
  1098	    for (slot, stack, _) in &changes_with_drops {
  1099	        equipment.put(slot, stack.clone());
  1100	        equipment_changes.push((slot.clone(), stack.clone()));
  1101	    }
  1102	
  1103	    drop(equipment);
  1104	
  1105	    if let Some(mob) = mob.get_mob() {
  1106	        for (slot, _, drop_chance) in changes_with_drops {
  1107	            mob.set_drop_chance(slot, drop_chance).await;
  1108	        }
  1109	    }
  1110	
  1111	    living.send_equipment_changes(&equipment_changes);
  1112	}

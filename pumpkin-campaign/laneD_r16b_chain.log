  1411	    #[test]
  1412	    fn provider_power_is_bounded_by_the_difficulty_scaled_cost() {
  1413	        // At multiplier 0 every base cost is exactly 5; after the enchantability
  1414	        // bonus (`+1 + nextInt(q+1) + nextInt(q+1)`) and the ±15% span the adjusted
  1415	        // cost can never exceed this ceiling derived from the item's own component.
  1416	        let mut rng = StdRng::seed_from_u64(99);
  1417	        let stack_item = &Item::LEATHER_HELMET;
  1418	        let enchantable = {
  1419	            let probe = stack_of(stack_item);
  1420	            probe
  1421	                .get_data_component::<EnchantableImpl>()
  1422	                .map_or(0, |e| e.value)
  1423	        };
  1424	        let quarter = enchantable / 4;
  1425	        let pre_span_max = MOB_SPAWN_ENCHANT_MIN_COST + 1 + quarter + quarter;
  1426	        let adjusted_ceiling = ((pre_span_max as f32 * 1.15 + 0.5).floor()) as i32;
  1427	
  1428	        for _ in 0..256 {
  1429	            let mut stack = stack_of(stack_item);
  1430	            mob_spawn_equipment_provider_enchant(&mut rng, &mut stack, 0.0);
  1431	            let applied = applied_enchantments(&stack);
  1432	            assert!(
  1433	                !applied.is_empty(),
  1434	                "leather helmets always have an affordable candidate"
  1435	            );
  1436	            for (enchantment, level) in applied {
  1437	                let reachable = enchantment.min_cost.calculate(level) <= adjusted_ceiling
  1438	                    && enchantment.max_cost.calculate(level) >= 1;
  1439	                assert!(
  1440	                    reachable,
  1441	                    "{} L{level} unreachable within adjusted cost {adjusted_ceiling}",
  1442	                    enchantment.registry_key
  1443	                );
  1444	            }
  1445	        }
  1446	    }

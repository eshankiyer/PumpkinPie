  8213	// Vanilla `SkeletonHorse.playSwimSound` (`SkeletonHorse.java:103-109`) uses a fixed ground
  8214	// volume and caps airborne volume after scaling the water speed.
  8215	fn skeleton_swim_sound_volume(on_ground: bool, water_volume: f32) -> f32 {
  8216	    if on_ground {
  8217	        0.3
  8218	    } else {
  8219	        (water_volume * 25.0).min(0.1)
  8220	    }
  8221	}

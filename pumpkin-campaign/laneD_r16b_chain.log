    90	   protected Item getDropItem() {
    91	      return Items.TNT_MINECART;
    92	   }
    93	
    94	   @Override
    95	   public ItemStack getPickResult() {
    96	      return new ItemStack(Items.TNT_MINECART);
    97	   }
    98	
    99	   protected void explode(final @Nullable DamageSource damageSource, final double speedSqr) {
   100	      if (this.level() instanceof ServerLevel level) {
   101	         if (level.getGameRules().get(GameRules.TNT_EXPLODES)) {
   102	            double speed = Math.min(Math.sqrt(speedSqr), 5.0);
   103	            level.explode(
   104	               this,
   105	               damageSource,
   106	               null,
   107	               this.getX(),
   108	               this.getY(),
   109	               this.getZ(),
   110	               (float)(this.explosionPowerBase + this.explosionSpeedFactor * this.random.nextDouble() * 1.5 * speed),
   111	               false,
   112	               Level.ExplosionInteraction.TNT
   113	            );
   114	            this.discard();
   115	         } else if (this.isPrimed()) {
   116	            this.discard();
   117	         }
   118	      }
   119	   }
   120	
   121	   @Override
   122	   public boolean causeFallDamage(final double fallDistance, final float damageModifier, final DamageSource damageSource) {
   123	      if (fallDistance >= 3.0) {
   124	         double power = fallDistance / 10.0;
   125	         this.explode(this.ignitionSource, power * power);
   126	      }
   127	
   128	      return super.causeFallDamage(fallDistance, damageModifier, damageSource);
   129	   }
   130	
   131	   @Override
   132	   public void activateMinecart(final ServerLevel level, final int xt, final int yt, final int zt, final boolean state) {
   133	      if (state && this.fuse < 0) {
   134	         this.primeFuse(null);
   135	      }
   136	   }
   137	
   138	   @Override
   139	   public void handleEntityEvent(final byte id) {
   140	      if (id == 70) {
   141	         this.primeFuse(null);
   142	      } else {
   143	         super.handleEntityEvent(id);
   144	      }
   145	   }
   146	
   147	   public void primeFuse(final @Nullable DamageSource source) {
   148	      if (!(this.level() instanceof ServerLevel serverLevel && !serverLevel.getGameRules().get(GameRules.TNT_EXPLODES))) {
   149	         this.fuse = 80;
   150	         if (!this.level().isClientSide()) {
   151	            if (source != null && this.ignitionSource == null) {
   152	               this.ignitionSource = this.damageSources().explosion(this, source.getEntity());
   153	            }
   154	
   155	            this.level().broadcastEntityEvent(this, (byte)70);
   156	            if (!this.isSilent()) {
   157	               this.level().playSound(null, this.getX(), this.getY(), this.getZ(), SoundEvents.TNT_PRIMED, SoundSource.BLOCKS, 1.0F, 1.0F);
   158	            }
   159	         }
   160	      }
   161	   }
   162	
   163	   public int getFuse() {
   164	      return this.fuse;
   165	   }
   166	
   167	   public boolean isPrimed() {
   168	      return this.fuse > -1;
   169	   }
   170	
   171	   @Override
   172	   public float getBlockExplosionResistance(
   173	      final Explosion explosion, final BlockGetter level, final BlockPos pos, final BlockState block, final FluidState fluid, final float resistance
   174	   ) {
   175	      return !this.isPrimed() || !block.is(BlockTags.RAILS) && !level.getBlockState(pos.above()).is(BlockTags.RAILS)
   176	         ? super.getBlockExplosionResistance(explosion, level, pos, block, fluid, resistance)
   177	         : 0.0F;
   178	   }
   179	
   180	   @Override
   181	   public boolean shouldBlockExplode(final Explosion explosion, final BlockGetter level, final BlockPos pos, final BlockState state, final float power) {
   182	      return !this.isPrimed() || !state.is(BlockTags.RAILS) && !level.getBlockState(pos.above()).is(BlockTags.RAILS)
   183	         ? super.shouldBlockExplode(explosion, level, pos, state, power)
   184	         : false;
   185	   }
   186	
   187	   @Override
   188	   protected void readAdditionalSaveData(final ValueInput input) {
   189	      super.readAdditionalSaveData(input);
   190	      this.fuse = input.getIntOr("fuse", -1);
   191	      this.explosionPowerBase = Mth.clamp(input.getFloatOr("explosion_power", 4.0F), 0.0F, 128.0F);
   192	      this.explosionSpeedFactor = Mth.clamp(input.getFloatOr("explosion_speed_factor", 1.0F), 0.0F, 128.0F);
   193	   }
   194	
   195	   @Override
   196	   protected void addAdditionalSaveData(final ValueOutput output) {
   197	      super.addAdditionalSaveData(output);
   198	      output.putInt("fuse", this.fuse);
   199	      if (this.explosionPowerBase != 4.0F) {
   200	         output.putFloat("explosion_power", this.explosionPowerBase);
   201	      }
   202	
   203	      if (this.explosionSpeedFactor != 1.0F) {
   204	         output.putFloat("explosion_speed_factor", this.explosionSpeedFactor);
   205	      }
   206	   }
   207	
   208	   @Override
   209	   protected boolean shouldSourceDestroy(final DamageSource source) {
   210	      return damageSourceIgnitesTnt(source);
   211	   }
   212	
   213	   private static boolean damageSourceIgnitesTnt(final DamageSource source) {
   214	      return source.getDirectEntity() instanceof Projectile projectile
   215	         ? projectile.isOnFire()
   216	         : source.is(DamageTypeTags.IS_FIRE) || source.is(DamageTypeTags.IS_EXPLOSION);
   217	   }
   218	}


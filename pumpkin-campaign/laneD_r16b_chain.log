    99	        Box::pin(async {
   100	            let pos: f64 = rand::random::<f64>() * TAU;
   101	
   102	            self.entity
   103	                .set_velocity(Vector3::new(-pos.sin() * 0.02, 0.2, -pos.cos() * 0.02));
   104	
   105	            self.entity.send_meta_data(
   106	                &[
   107	                    Metadata::new(
   108	                        pumpkin_data::tracked_data::tnt::FUSE_ID,
   109	                        VarInt(self.fuse.load(Relaxed) as i32),
   110	                    ),
   111	                    Metadata::new(
   112	                        pumpkin_data::tracked_data::tnt::BLOCK_STATE_ID,
   113	                        VarInt(i32::from(Block::TNT.default_state.id.as_u16())),
   114	                    ),
   115	                ],
   116	                None,
   117	            );
   118	        })
   119	    }

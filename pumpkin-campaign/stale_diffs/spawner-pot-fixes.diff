+/// Vanilla item name used for an unset sherd slot (`PotDecorations#getItem`,
+/// `DecoratedPotBlockEntity.java`). Every corner defaults to a plain brick.
+const DEFAULT_SHERD: &str = "minecraft:brick";
+
+/// Resolves the raw `sherds` NBT list (order: back, left, right, front, matching
+/// `PotDecorations`) into 4 item registry names, defaulting missing/invalid
+/// entries to brick.
+fn sherd_names(sherds: Option<&[NbtTag]>) -> [Cow<'static, str>; 4] {
+    let mut names = [
+        Cow::Borrowed(DEFAULT_SHERD),
+        Cow::Borrowed(DEFAULT_SHERD),
+        Cow::Borrowed(DEFAULT_SHERD),
+        Cow::Borrowed(DEFAULT_SHERD),
+    ];
+    if let Some(list) = sherds {
+        for (slot, tag) in names.iter_mut().zip(list.iter()) {
+            if let Some(name) = tag.extract_string() {
+                *slot = Cow::Owned(name.to_string());
+            }
+        }
+    }
+    names
+}
+
+/// Builds the item(s) dropped when a decorated pot is destroyed, matching the
+/// `minecraft:alternatives` entry in `data/minecraft/loot_table/blocks/decorated_pot.json`:
+/// cracked pots drop their 4 individual sherds, intact pots drop a single
+/// `decorated_pot` item that carries the pattern via the `pot_decorations` component.
+fn break_drops(sherds: Option<&[NbtTag]>, cracked: bool) -> Vec<ItemStack> {
+    let names = sherd_names(sherds);
+    if cracked {
+        names
+            .iter()
+            .map(|name| {
+                let item = Item::from_registry_key(name).unwrap_or(&Item::BRICK);
+                ItemStack::new(1, item)
+            })
+            .collect()
+    } else if names.iter().all(|name| name == DEFAULT_SHERD) {
+        vec![ItemStack::new(1, &Item::DECORATED_POT)]
+    } else {
+        vec![ItemStack::new_with_component(
+            1,
+            &Item::DECORATED_POT,
+            vec![(
+                DataComponent::PotDecorations,
+                Some(Box::new(PotDecorationsImpl { decorations: names })),
+            )],
+        )]
+    }
+}

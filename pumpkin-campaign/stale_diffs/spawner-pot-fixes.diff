+    #[test]
+    fn uncracked_plain_pot_drops_single_decorated_pot() {
+        let drops = break_drops(None, false);
+        assert_eq!(drops.len(), 1);
+        assert_eq!(drops[0].item.id, Item::DECORATED_POT.id);
+        assert!(drops[0].patch.is_empty());
+    }
+
+    #[test]
+    fn uncracked_decorated_pot_drops_single_item_with_pattern_component() {
+        let list = sherd_list(&["minecraft:angler_pottery_sherd"]);
+        let drops = break_drops(Some(&list), false);
+        assert_eq!(drops.len(), 1);
+        assert_eq!(drops[0].item.id, Item::DECORATED_POT.id);
+        assert!(!drops[0].patch.is_empty());
+    }
+
+    #[test]
+    fn cracked_pot_drops_four_individual_sherds() {
+        let list = sherd_list(&[

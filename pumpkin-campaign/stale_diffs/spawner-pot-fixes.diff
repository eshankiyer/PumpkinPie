+            .iter()
+            .map(|name| NbtTag::String((*name).into()))
+            .collect()
+    }
+
+    #[test]
+    fn no_sherds_defaults_to_all_brick() {
+        let names = sherd_names(None);
+        assert!(names.iter().all(|name| name == "minecraft:brick"));
+    }
+
+    #[test]
+    fn partial_sherds_keep_stored_entries_and_default_the_rest() {
+        let list = sherd_list(&[
+            "minecraft:angler_pottery_sherd",
+            "minecraft:archer_pottery_sherd",
+        ]);
+        let names = sherd_names(Some(&list));
+        assert_eq!(names[0], "minecraft:angler_pottery_sherd");
+        assert_eq!(names[1], "minecraft:archer_pottery_sherd");
+        assert_eq!(names[2], "minecraft:brick");
+        assert_eq!(names[3], "minecraft:brick");
+    }

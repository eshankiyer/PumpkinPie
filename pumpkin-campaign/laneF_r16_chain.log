   358	   private static void createExperience(final ServerLevel level, final Vec3 position, final int amount, final float value) {
   359	      int xpReward = Mth.floor(amount * value);
   360	      float xpFraction = Mth.frac(amount * value);
   361	      if (xpFraction != 0.0F && level.getRandom().nextFloat() < xpFraction) {
   362	         xpReward++;
   363	      }
   364	
   365	      ExperienceOrb.award(level, position, xpReward);
   366	   }

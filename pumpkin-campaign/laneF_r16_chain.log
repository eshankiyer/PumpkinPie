    48	pub(crate) fn stop_vertical_movement_after_fall(entity: &dyn EntityBase) {
    49	    let entity = entity.get_entity();
    50	    let mut velocity = entity.velocity.load();
    51	    velocity.y = 0.0;
    52	    entity.velocity.store(velocity);

    73	pub(crate) fn block_bounce_restitution(block: &Block) -> f64 {
    74	    // `Block.getBounceRestitution` (`Block.java:494-499`) returns the property set by
    75	    // `Blocks.java:675-685` for beds and `Blocks.java:2922-2926` for slime blocks.
    76	    if block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_BEDS) {
    77	        0.75
    78	    } else if block == &Block::SLIME_BLOCK {
    79	        1.0
    80	    } else {
    81	        0.0
    82	    }
    83	}

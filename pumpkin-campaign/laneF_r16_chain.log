    41	                // CONTAINER_CLOSE only on the 0<->nonzero transition, not on every viewer-count
    42	                // change. Vanilla passes the opening/closing entity as context when known and
    43	                // `null` otherwise (ContainerOpenersCounter.java:81,84); this tracker only has
    44	                // the count, not which entity changed it, so `GameEventContext::none()` is used
    45	                // -- the same fallback vanilla itself uses when no entity is known.
    46	                let event_pos = Vector3::new(

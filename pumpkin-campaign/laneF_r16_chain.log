   345	   public List<RecipeHolder<?>> getRecipesToAwardAndPopExperience(final ServerLevel level, final Vec3 position) {
   346	      List<RecipeHolder<?>> recipesToAward = Lists.newArrayList();
   347	
   348	      for (Entry<ResourceKey<Recipe<?>>> entry : this.recipesUsed.reference2IntEntrySet()) {
   349	         level.recipeAccess().byKey(entry.getKey()).ifPresent(recipe -> {
   350	            recipesToAward.add((RecipeHolder<?>)recipe);
   351	            createExperience(level, position, entry.getIntValue(), ((AbstractCookingRecipe)recipe.value()).experience());
   352	         });
   353	      }
   354	
   355	      return recipesToAward;
   356	   }

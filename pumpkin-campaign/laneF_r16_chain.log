    43	/// Vanilla `AbstractFurnaceMenu.canSmelt` (`AbstractFurnaceMenu.java:134-136`): tests the
    44	/// item against the station's accepted-input `RecipePropertySet`. Those sets are built by
    45	/// `RecipeManager.RECIPE_PROPERTY_SETS` (`RecipeManager.java:41-56`) as "every input
    46	/// ingredient of at least one recipe of this station's cooking type" and collected in
    47	/// `finalizeRecipeLoading` (`RecipeManager.java:88-120`); here that membership test is
    48	/// computed directly from the static cooking recipe table. Each station filters its own
    49	/// type: a blast furnace only accepts blastable ores, a smoker only smokeable food, a
    50	/// furnace anything smeltable (`FurnaceMenu`/`BlastFurnaceMenu`/`SmokerMenu` pass their
    51	/// respective `RecipePropertySet` key, `AbstractFurnaceMenu.java:40-53`).
    52	fn can_smelt(item: &pumpkin_data::item::Item, window_type: Option<WindowType>) -> bool {
    53	    let kind = match window_type {
    54	        Some(WindowType::BlastFurnace) => CookingRecipeKind::Blasting,
    55	        Some(WindowType::Smoker) => CookingRecipeKind::Smoking,
    56	        _ => CookingRecipeKind::Smelting,
    57	    };
    58	    get_cooking_recipe_with_ingredient(item, kind).is_some()
    59	}

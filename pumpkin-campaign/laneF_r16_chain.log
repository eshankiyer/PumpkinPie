    55	pub(crate) fn bounce_entity_after_fall(entity: &dyn EntityBase, bounce_multiplier: f64) {
    56	    let base_entity = entity.get_entity();
    57	    let mut velocity = base_entity.velocity.load();
    58	
    59	    if base_entity.is_sneaking() {
    60	        velocity.y = 0.0;
    61	    } else if velocity.y < 0.0 {
    62	        let entity_factor = if entity.get_living_entity().is_some() {
    63	            1.0
    64	        } else {
    65	            0.8
    66	        };
    67	        velocity.y = -velocity.y * bounce_multiplier * entity_factor;
    68	    }
    69	
    70	    base_entity.velocity.store(velocity);
    71	}

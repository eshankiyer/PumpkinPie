  1241	      public BlockBehaviour.Properties offsetType(final BlockBehaviour.OffsetType offsetType) {
  1242	         this.offsetFunction = switch (offsetType) {
  1243	            case NONE -> null;
  1244	            case XZ -> (state, pos) -> {
  1245	               Block block = state.getBlock();
  1246	               long seed = Mth.getSeed(pos.getX(), 0, pos.getZ());
  1247	               float maxHorizontalOffset = block.getMaxHorizontalOffset();
  1248	               double x = Mth.clamp(((float)(seed & 15L) / 15.0F - 0.5) * 0.5, -maxHorizontalOffset, maxHorizontalOffset);
  1249	               double z = Mth.clamp(((float)(seed >> 8 & 15L) / 15.0F - 0.5) * 0.5, -maxHorizontalOffset, maxHorizontalOffset);
  1250	               return new Vec3(x, 0.0, z);
  1251	            };
  1252	            case XYZ -> (state, pos) -> {
  1253	               Block block = state.getBlock();
  1254	               long seed = Mth.getSeed(pos.getX(), 0, pos.getZ());
  1255	               double y = ((float)(seed >> 4 & 15L) / 15.0F - 1.0) * block.getMaxVerticalOffset();
  1256	               float maxHorizontalOffset = block.getMaxHorizontalOffset();
  1257	               double x = Mth.clamp(((float)(seed & 15L) / 15.0F - 0.5) * 0.5, -maxHorizontalOffset, maxHorizontalOffset);
  1258	               double z = Mth.clamp(((float)(seed >> 8 & 15L) / 15.0F - 0.5) * 0.5, -maxHorizontalOffset, maxHorizontalOffset);
  1259	               return new Vec3(x, y, z);
  1260	            };
  1261	         };
  1262	         return this;
  1263	      }

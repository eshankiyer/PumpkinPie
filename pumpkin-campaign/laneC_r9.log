   549	/// `ShelfBlock.swapSingleItem` (`ShelfBlock.java:206-219`): swaps the held stack with the stack
   550	/// in `hit_slot`, writing the removed stack back to the player's selected hotbar slot and syncing
   551	/// it to their client.
   552	///
   553	/// The vanilla vibration opt-out for items carrying a `minecraft:use_effects` component with
   554	/// `interact_vibrations=false` is not modelled (the flag defaults to `true`, `UseEffects.java:9`),
   555	/// so the `ITEM_INTERACT_FINISH` vibration always fires.
   556	async fn swap_single_item(
   557	    world: &Arc<World>,
   558	    shelf: &ShelfBlockEntity,
   559	    hit_slot: usize,
   560	    placed_stack: ItemStack,
   561	    player: &Arc<Player>,
   562	) -> bool {
   563	    let removed_item = shelf
   564	        .swap_item_no_update(hit_slot, placed_stack.clone())
   565	        .await;
   566	
   567	    // A creative player placing onto an empty slot keeps a copy of what they placed
   568	    // (`ShelfBlock.java:210`).
   569	    let new_inventory_item = if player.has_infinite_materials() && removed_item.is_empty() {
   570	        placed_stack.clone()
   571	    } else {
   572	        removed_item.clone()
   573	    };
   574	
   575	    let inventory = player.inventory();
   576	    let selected_slot = usize::from(inventory.get_selected_slot());
   577	    inventory
   578	        .set_stack(selected_slot, new_inventory_item.clone())
   579	        .await;
   580	    player
   581	        .sync_hand_slot(selected_slot, new_inventory_item)
   582	        .await;
   583	
   584	    // `shelfBlockEntity.setChanged(...)` (`ShelfBlock.java:213-217`).
   585	    shelf
   586	        .set_changed_with_game_event(world, Some(GameEvent::ItemInteractFinish))
   587	        .await;
   588	
   589	    !removed_item.is_empty()
   590	}

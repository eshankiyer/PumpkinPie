      ItemAttributeModifiers modifiers = this.getOrDefault(DataComponents.ATTRIBUTE_MODIFIERS, ItemAttributeModifiers.EMPTY);
      modifiers.forEach(slot, consumer);
      EnchantmentHelper.forEachModifier(this, slot, consumer);

        // `false` (e.g. `EyeOfEnder`), the attack is a complete no-op -- no sound, no cooldown
        // reset, no swing side effects -- not merely no damage.
        if !victim.is_attackable() {
            return;
        }
        if victim.skip_attack_interaction(self).await {
            return;

   646	        if self.patch.len() != other.patch.len() {
   647	            return false;
   648	        }
   649	
   650	        for (id, data) in &self.patch {
   651	            let Some((_, other_data)) = other.patch.iter().find(|(other_id, _)| id == other_id)
   652	            else {
   653	                return false;

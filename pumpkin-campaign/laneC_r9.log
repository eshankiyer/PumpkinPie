+fn attack_charge_ready(
+    attack_ticks: u32,
+    tolerance: u32,
+    attack_speed: f64,
+    required_strength: f64,
+) -> bool {
+    required_strength <= 0.0
+        || (f64::from(attack_ticks) + f64::from(tolerance)) / (20.0 / attack_speed)
+            >= required_strength
+}

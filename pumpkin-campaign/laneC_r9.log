  2948	   protected @Nullable Map<EquipmentSlot, ItemStack> collectEquipmentChanges(final Map<EquipmentSlot, ItemStack> lastEquipmentItems) {
  2949	      Map<EquipmentSlot, ItemStack> changedItems = null;
  2950	
  2951	      for (EquipmentSlot slot : EquipmentSlot.VALUES) {
  2952	         ItemStack previous = lastEquipmentItems.get(slot);
  2953	         ItemStack current = this.getItemBySlot(slot);
  2954	         if (this.equipmentHasChanged(previous, current)) {
  2955	            if (changedItems == null) {
  2956	               changedItems = Maps.newEnumMap(EquipmentSlot.class);
  2957	            }
  2958	
  2959	            changedItems.put(slot, current);
  2960	            AttributeMap attributes = this.getAttributes();
  2961	            if (!previous.isEmpty()) {
  2962	               this.stopLocationBasedEffects(previous, slot, attributes);
  2963	            }
  2964	         }
  2965	      }
  2966	
  2967	      if (changedItems != null) {
  2968	         for (Entry<EquipmentSlot, ItemStack> entry : changedItems.entrySet()) {
  2969	            EquipmentSlot slot = entry.getKey();
  2970	            ItemStack current = entry.getValue();
  2971	            if (!current.isEmpty() && !current.isBroken()) {
  2972	               current.forEachModifier(slot, (attribute, modifier) -> {
  2973	                  AttributeInstance instance = this.attributes.getInstance(attribute);
  2974	                  if (instance != null) {
  2975	                     instance.removeModifier(modifier.id());
  2976	                     instance.addTransientModifier(modifier);
  2977	                  }
  2978	               });
  2979	               if (this.level() instanceof ServerLevel serverLevel) {
  2980	                  EnchantmentHelper.runLocationChangedEffects(serverLevel, current, this, slot);
  2981	               }
  2982	            }
  2983	         }
  2984	      }
  2985	
  2986	      return changedItems;
  2987	   }

    pub delayed_mining: AtomicBool,
    /// Vanilla `ServerPlayerGameMode.delayedDestroyPos`.
    pub delayed_mining_pos: Mutex<BlockPos>,
    /// Vanilla `ServerPlayerGameMode.delayedTickStart`.

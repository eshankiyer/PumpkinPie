                            entity.send_pairing_data_to(player.as_ref()).await;
                            player.try_restore_vehicle(entity).await;
                        }
                    }
                }
            }

            #[cfg(debug_assertions)]
            debug!("Chunks queued after {}ms", inst.elapsed().as_millis());
        });

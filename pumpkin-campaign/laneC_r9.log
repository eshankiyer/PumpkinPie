            && this.server.playerIdleTimeout() > 0
            && Util.getMillis() - this.player.getLastActionTime() > TimeUnit.MINUTES.toMillis(this.server.playerIdleTimeout())
            && !this.player.wonGame) {
            this.disconnect(Component.translatable("multiplayer.disconnect.idling"));
         }
      }
   }


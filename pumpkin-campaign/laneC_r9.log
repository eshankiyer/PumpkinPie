   @Override
   public void baseTick() {
      super.baseTick();
      ProfilerFiller profiler = Profiler.get();
      profiler.push("mobBaseTick");
      if (this.isAlive() && this.random.nextInt(1000) < this.ambientSoundTime++) {
         this.resetAmbientSoundTime();
         this.playAmbientSound();
      }

      profiler.pop();
   }


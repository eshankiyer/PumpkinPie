                if self.hurt_cooldown.load(Relaxed) > 10 && !bypasses_cooldown_protection {
                    if amount <= last_damage {
                        return false;
                    }
                    (amount - last_damage, false)
                } else {
                    self.hurt_cooldown.store(20, Relaxed);
                    (amount, true)

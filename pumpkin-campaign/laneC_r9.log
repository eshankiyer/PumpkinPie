    /// override, so a pig that fell through to it recursed until the tokio worker's stack died.
    fn default_has_controlling_passenger(&self) -> EntityBaseFuture<'_, bool> {
        Box::pin(async move {
            if self.get_mob_entity().is_no_ai() {
                return false;

   503	    async fn process_age_and_merge(&self) -> bool {
   504	        let entity = &self.entity;
   505	        let merge_tick = self.merge_tick.fetch_add(1, Ordering::Relaxed) + 1;
   506	
   507	        // Vanilla: `if (this.age != -32768) { this.age++; }` -- every other age,
   508	        // including negative extended-lifetime starts, increments normally.
   509	        // A single fetch_update (rather than load-then-branch-then-fetch_add)
   510	        // is required here: `try_merge_with` can store INFINITE_LIFETIME_AGE
   511	        // into this same counter from another entity's tick concurrently, and
   512	        // a load/store split could race past it and increment it away.
   513	        let age = self
   514	            .item_age
   515	            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |age| {
   516	                (age != INFINITE_LIFETIME_AGE).then_some(age + 1)
   517	            })
   518	            .map_or(INFINITE_LIFETIME_AGE, |prev| prev + 1);
   519	
   520	        if age >= 6000 {
   680	            let original_velo = entity.velocity.load();
   681	            entity
   682	                .velocity
   683	                .store(self.apply_fluid_drag_or_gravity(original_velo));
   684	
   685	            self.update_no_clip_and_push_out();
   686	
   687	            let move_velo = entity.velocity.load(); // In case push_out_of_blocks modifies it
   688	
   689	            if self.should_tick_move(move_velo) {
   690	                self.move_and_apply_friction(caller, server, move_velo)
   691	                    .await;
   692	            }
   693	
   694	            if self.process_age_and_merge().await {
   695	                self.sync_motion_if_dirty(caller, original_velo).await;
   696	            }
   697	        })
   698	    }

   472	    async fn move_and_apply_friction<'a>(
   473	        &'a self,
   474	        caller: &'a Arc<dyn EntityBase>,
   475	        server: &'a Server,
   476	        move_velo: Vector3<f64>,
   477	    ) {
   478	        let entity = &self.entity;
   479	
   480	        entity.move_entity(caller, move_velo).await;
   481	        entity.tick_block_collisions(caller, server).await;
   482	
   483	        let mut friction = 0.98;
   484	        let on_ground = entity.on_ground.load(Ordering::SeqCst);
   485	
   486	        let mut velo = entity.velocity.load();
   487	        if on_ground {
   488	            let block_affecting_velo = entity.get_block_with_y_offset(0.999_999).1;
   489	            friction *= f64::from(block_affecting_velo.slipperiness);
   490	        }
   491	
   492	        velo = velo.multiply(friction, 0.98, friction);
   493	
   494	        // `ItemEntity.tick`: a landing item bounces at half its downward speed rather than
   495	        // stopping dead.
   496	        if on_ground && velo.y < 0.0 {
   497	            velo.y *= -0.5;
   498	        }
   499	
   500	        entity.velocity.store(velo);
   501	    }

   458	    fn should_tick_move(&self, move_velo: Vector3<f64>) -> bool {
   459	        let entity = &self.entity;
   460	
   461	        let mut tick_move = !entity.on_ground.load(Ordering::SeqCst)
   462	            || move_velo.horizontal_length_squared() > 1.0e-5;
   463	
   464	        if !tick_move {
   465	            let item_age = self.item_age.load(Ordering::Relaxed);
   466	            tick_move = (item_age + entity.entity_id) % 4 == 0;
   467	        }
   468	
   469	        tick_move
   470	    }

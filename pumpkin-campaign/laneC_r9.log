    /// rotation.
    async fn dispense_wither_skull(ctx: &DispenseContext<'_>, item: &mut ItemStack) {
        let target = Self::target_position(ctx);
        if ctx.world.get_block_state(&target).is_air() && can_spawn_wither(ctx.world, &target, item)
        {
            item.decrement(1);
            ctx.world
                .set_block_state(

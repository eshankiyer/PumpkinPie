                && !damage_type.has_tag(&tag::DamageType::MINECRAFT_BYPASSES_RESISTANCE)
            {
                self.get_effect(&StatusEffect::RESISTANCE)
                    .await
                    .map_or(0.0, |e| (0.2 * (e.amplifier + 1) as f32).min(1.0))

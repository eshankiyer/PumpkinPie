                    tester_ent.entity.get_eye_pos(),
                    target.entity.get_eye_pos(),
                    async |block_pos, world| world.get_block_state(block_pos).is_solid(),
                )
                .await
                .is_some()
        {
            return false;
        }

        true
    }

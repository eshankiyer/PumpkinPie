   646	/// Mirrors vanilla's explicit `useShapeForLightOcclusion` overrides. The generated
   647	/// state data already carries the vanilla light opacity, which distinguishes the
   648	/// state-dependent slab and piston-base overrides without allocating property
   649	/// objects during lighting.
   650	fn uses_shape_for_light_occlusion(block_name: &str, state: &BlockState) -> bool {
   651	    if block_name.ends_with("_stairs")
   652	        || matches!(
   653	            block_name,
   654	            "daylight_detector"
   655	                | "dirt_path"
   656	                | "enchanting_table"
   657	                | "end_portal_frame"
   658	                | "farmland"
   659	                | "lectern"
   660	                | "sculk_sensor"
   661	                | "sculk_shrieker"
   662	                | "snow"
   663	                | "stonecutter"
   664	                | "piston_head"
   665	        )
   666	        || block_name.ends_with("_shelf")
   667	    {
   668	        return true;
   669	    }
   670	
   671	    if block_name.ends_with("_slab") {
   672	        return state.opacity != Some(15);
   673	    }
   674	
   675	    matches!(block_name, "piston" | "sticky_piston") && state.opacity == Some(15)
   676	}

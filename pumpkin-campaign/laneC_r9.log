   702	    /// Determines if a tool is valid for block drops based on tool rules.
   703	    /// Direct matches return immediately, while tagged blocks are checked separately.
   704	    #[must_use]
   705	    pub fn is_correct_for_drops(&self, block: &'static Block) -> bool {
   706	        if let Some(tool) = self.get_data_component::<ToolImpl>() {
   707	            for rule in tool.rules.iter() {
   708	                // Skip if speed is not set
   709	                let Some(correct) = rule.correct_for_drops else {
   710	                    continue;
   711	                };
   712	                match &rule.blocks {
   713	                    IDSet::Tag(tag) => {
   714	                        if block.is_tagged_with(tag).unwrap_or(false) {
   715	                            return correct;
   716	                        }
   717	                    }
   718	                    IDSet::IDs(blocks) => {
   719	                        if blocks.contains(&block) {
   720	                            return correct;
   721	                        }
   722	                    }
   723	                }
   724	            }
   725	        }
   726	        false
   727	    }

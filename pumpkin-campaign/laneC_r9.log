    // This method takes ownership of Arc<Self>, so the lifetime bounds are different.
    fn teleport(
        self: Arc<Self>,
        position: Vector3<f64>,
        yaw: Option<f32>,
        pitch: Option<f32>,
        world: Arc<World>,
    ) -> TeleportFuture
    where
        Self: 'static,
    {
        Box::pin(async move {
            self.get_entity().teleport(position, yaw, pitch, world);
            self.get_entity().sync_passenger_positions().await;
        })
    }


         this.setLastHurtByPlayer(playerSource, 100);
      } else if (sourceEntity instanceof Wolf wolf && wolf.isTame()) {
         if (wolf.getOwnerReference() != null) {
            this.setLastHurtByPlayer(wolf.getOwnerReference().getUUID(), 100);

                        entity
                            .world
                            .load()
                            .broadcast_to_chunk_except(
                                chunk_pos,
                                &[self.living_entity.entity.entity_uuid],
                                &[self.living_entity.entity.entity_uuid],
                                &CEntityPositionSync::new(
                                    self.living_entity.entity.entity_id.into(),

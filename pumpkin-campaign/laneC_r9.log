    23	   @Override
    24	   public void apply(final ServerLevel serverLevel, final int enchantmentLevel, final EnchantedItemInUse item, final Entity entity, final Vec3 position) {
    25	      Vec3 look = entity.getLookAngle();
    26	      Vec3 direction = look.addLocalCoordinates(this.direction).multiply(this.coordinateScale).scale(this.magnitude.calculate(enchantmentLevel));
    27	      entity.addDeltaMovement(direction);
    28	      entity.hurtMarked = true;
    29	      entity.needsSync = true;
    30	      if (entity instanceof LivingEntity livingEntity) {
    31	         livingEntity.applyPostImpulseGraceTime(10);
    32	      }
    33	   }
    34	
    35	   @Override
    36	   public MapCodec<ApplyEntityImpulse> codec() {
    37	      return CODEC;

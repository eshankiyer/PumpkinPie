    List(IntoIter<NbtTag>),
    CompoundList(Map<IntoIter<NbtTag>, fn(NbtTag) -> NbtTag>),
    ByteArray(Map<IntoIter<i8>, fn(i8) -> NbtTag>),
    IntArray(Map<IntoIter<i32>, fn(i32) -> NbtTag>),
    LongArray(Map<IntoIter<i64>, fn(i64) -> NbtTag>),
}


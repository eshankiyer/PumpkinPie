   103	   public boolean isFireNearby() {
   104	      if (this.level == null) {
   105	         return false;
   106	      }
   107	
   108	      for (BlockPos pos : BlockPos.betweenClosed(this.worldPosition.offset(-1, -1, -1), this.worldPosition.offset(1, 1, 1))) {
   109	         if (this.level.getBlockState(pos).getBlock() instanceof FireBlock) {
   110	            return true;
   111	         }
   112	      }
   113	
   114	      return false;
   115	   }

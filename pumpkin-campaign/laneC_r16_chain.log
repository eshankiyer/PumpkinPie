   125	   public void emptyAllLivingFromHive(final @Nullable Player player, final BlockState state, final BeehiveBlockEntity.BeeReleaseStatus releaseReason) {
   126	      List<Entity> releasedFromHive = this.releaseAllOccupants(state, releaseReason);
   127	      if (player != null) {
   128	         for (Entity released : releasedFromHive) {
   129	            if (released instanceof Bee bee && player.position().distanceToSqr(released.position()) <= 16.0) {
   130	               if (!this.isSedated()) {
   131	                  bee.setTarget(player);
   132	               } else {
   133	                  bee.setStayOutOfHiveCountdown(400);
   134	               }
   135	            }
   136	         }
   137	      }
   138	   }
   139	
   140	   private List<Entity> releaseAllOccupants(final BlockState state, final BeehiveBlockEntity.BeeReleaseStatus releaseStatus) {
   141	      List<Entity> spawned = Lists.newArrayList();
   142	      this.stored
   143	         .removeIf(
   144	            occupantEntry -> releaseOccupant(this.level, this.worldPosition, state, occupantEntry.toOccupant(), spawned, releaseStatus, this.savedFlowerPos)
   145	         );
   146	      if (!spawned.isEmpty()) {
   147	         super.setChanged();
   148	      }
   149	
   150	      return spawned;
   151	   }

    97	    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
    98	        Box::pin(async move {
    99	            let Some(target) = Self::scheduled_target(mob).await else {
   100	                return false;
   101	            };
   102	            if Self::has_arrived(target, mob) {
   103	                return false;
   104	            }
   105	            self.target = Some(target);
   106	            true
   107	        })
   108	    }
   109	
   110	    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
   111	        Box::pin(async move {
   112	            let Some(target) = self.target else {
   113	                return false;
   114	            };
   115	            if Self::has_arrived(target, mob) {
   116	                return false;

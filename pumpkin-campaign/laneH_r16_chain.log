   322	struct LocatePoiExecutor;
   323	
   324	impl CommandExecutor for LocatePoiExecutor {
   325	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   326	        Box::pin(async move {
   327	            // Vanilla obtains this through `ResourceOrTagArgument.getResourceOrTag`
   328	            // (`ResourceOrTagArgument.java:52-64`) before resolving the POI type.
   329	            let searched =
   330	                ResourceOrTagArgument::get_resource_or_tag(context, ARG_POI, &POI_REGISTRY)?;
   331	
   332	            // POI entries store namespaced type ids, tag data uses bare
   333	            // vanilla names; normalize everything to `namespace:path`.
   334	            let targets: FxHashSet<String> = match searched {
   335	                ResourceOrTag::Resource(id) => std::iter::once(id.to_string()).collect(),
   336	                ResourceOrTag::Tag(id) => {
   337	                    tag::get_tag_values(RegistryKey::PointOfInterestType, &id.to_string())
   338	                        .into_iter()
   339	                        .flatten()
   340	                        .map(|name| {
   341	                            if name.contains(':') {
   342	                                (*name).to_string()
   343	                            } else {
   344	                                format!("minecraft:{name}")
   345	                            }
   346	                        })
   347	                        .collect()
   348	                }
   349	            };
   350	
   351	            let origin = BlockPos::floored_v(context.source.position);
   352	            let world = context.source.world().clone();
   353	
   354	            let found = {
   355	                let mut poi_storage = world.portal_poi.lock().await;
   356	                poi_storage.find_closest_matching(origin, POI_SEARCH_RADIUS, |poi_type| {
   357	                    targets.contains(poi_type)
   358	                })
   359	            };
   360	
   361	            let Some((target, poi_type)) = found else {
   362	                return Err(POI_NOT_FOUND_ERROR_TYPE
   363	                    .create_without_context(TextComponent::text(searched.printable())));
   364	            };
   365	
   366	            let distance = horizontal_distance(&origin, &target);
   367	            send_success(
   368	                context,
   369	                translation::java::COMMANDS_LOCATE_POI_SUCCESS,
   370	                translation::java::COMMANDS_LOCATE_POI_SUCCESS,
   371	                result_name(searched, &poi_type),
   372	                &target,
   373	                false,
   374	                distance,
   375	            )
   376	            .await;
   377	
   378	            Ok(distance)
   379	        })
   380	    }
   381	}

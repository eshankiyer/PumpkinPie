    88	fn enchanted_book_offer_items(
    89	    rng: &mut impl rand::Rng,
    90	) -> Option<(ItemStack, ItemStack, Option<ItemStack>)> {
    91	    use pumpkin_data::data_component::DataComponent;
    92	    use pumpkin_data::data_component_impl::StoredEnchantmentsImpl;
    93	    use rand::{RngExt, seq::IndexedRandom};
    94	    use std::borrow::Cow;
    95	
    96	    let enchantment_id = *EnchantmentTag::MINECRAFT_TRADEABLE.1.choose(rng)? as u8;
    97	    let enchantment = Enchantment::from_id(enchantment_id)?;
    98	    let level = rng.random_range(1..=enchantment.max_level);
    99	    let mut emeralds = 2 + rng.random_range(0..5 + level * 10) + 3 * level;
   100	    if enchantment.has_tag(&EnchantmentTag::MINECRAFT_DOUBLE_TRADE_PRICE) {
   101	        emeralds *= 2;
   102	    }
   103	
   104	    let output = ItemStack::new_with_component(
   105	        1,
   106	        &Item::ENCHANTED_BOOK,
   107	        vec![(
   108	            DataComponent::StoredEnchantments,
   109	            Some(Box::new(StoredEnchantmentsImpl {
   110	                enchantment: Cow::Owned(vec![(enchantment, level)]),
   111	            })),
   112	        )],
   113	    );
   114	
   115	    Some((
   116	        ItemStack::new(emeralds.min(64) as u8, &Item::EMERALD),
   117	        output,
   118	        Some(ItemStack::new(1, &Item::BOOK)),
   119	    ))
   120	}

   840	            .await
   841	            .map(|effect| i32::from(effect.amplifier));
   842	
   843	        let mut offers = self.offers.lock().await;
   844	        for offer in offers.iter_mut() {
   845	            // Vanilla `MerchantOffer::setSpecialPriceDiff`/`addToSpecialPriceDiff`
   846	            // (`MerchantOffer.java:173-187`) apply reputation and hero discounts cumulatively.
   847	            offer.set_special_price_diff(
   848	                -((reputation as f32 * offer.price_multiplier).floor() as i32),
   849	            );
   850	            if let Some(amplifier) = hero_amplifier {
   851	                let discount = ((0.3 + 0.0625 * f64::from(amplifier))
   852	                    * f64::from(offer.base_cost_a.0.item_count))
   853	                .floor() as i32;
   854	                offer.add_to_special_price_diff(-discount.max(1));
   855	            }
   856	        }
   857	    }

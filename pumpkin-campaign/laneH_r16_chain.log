   122	    fn start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   123	        Box::pin(async move {
   124	            self.ticks_since_path = 0;
   125	            if let Some(target) = self.target {
   126	                let pos = mob.get_entity().pos.load();
   127	                let mut navigator = mob.get_mob_entity().navigator.lock().unwrap();
   128	                navigator.set_progress(NavigatorGoal::new(pos, target, self.speed));
   129	            }
   130	        })
   131	    }
   132	
   133	    fn tick<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
   134	        Box::pin(async move {
   135	            self.ticks_since_path += 1;
   136	            if self.ticks_since_path % REPATH_INTERVAL != 0 {
   137	                return;
   138	            }
   139	            let Some(target) = self.target else {

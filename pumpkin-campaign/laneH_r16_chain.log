    12	impl CoralMushroomFeature {
    13	    #[allow(clippy::too_many_arguments)]
    14	    pub fn generate<T: GenerationCache>(
    15	        chunk: &mut T,
    16	        block_registry: &dyn WorldPortalExt,
    17	        _min_y: i8,
    18	        _height: u16,
    19	        _feature: pumpkin_data::placed_feature::PlacedFeature, // This placed feature
    20	        random: &mut RandomGenerator,
    21	        pos: BlockPos,
    22	    ) -> bool {
    23	        // First lets get a random coral
    24	        let block = CoralFeature::get_random_tag_entry(tag::Block::MINECRAFT_CORAL_BLOCKS, random);
    25	
    26	        let i = random.next_bounded_i32(3) + 3;
    27	        let j = random.next_bounded_i32(3) + 3;
    28	        let k = random.next_bounded_i32(3) + 3;
    29	        let l = random.next_bounded_i32(3) + 1;
    30	
    31	        for m in 0..=j {
    32	            for n in 0..=i {
    33	                for o in 0..=k {
    34	                    let mut pos = pos;
    35	                    pos = pos.offset(Vector3::new(m, n, o));
    36	                    pos = pos.down_height(l);
    37	
    38	                    let condition_a = (m != 0 && m != j) || (n != 0 && n != i);
    39	                    let condition_b = (o != 0 && o != k) || (n != 0 && n != i);
    40	                    let condition_c = (m != 0 && m != j) || (o != 0 && o != k);
    41	                    let condition_d = m == 0 || m == j || n == 0 || n == i || o == 0 || o == k;
    42	                    let random_check = random.next_f32() < 0.1f32;
    43	
    44	                    if !((condition_a && condition_b && condition_c && condition_d)
    45	                        && !random_check
    46	                        && CoralFeature::generate_coral_piece(
    47	                            chunk,
    48	                            block_registry,
    49	                            random,
    50	                            block,
    51	                            pos,
    52	                        ))
    53	                    {}
    54	                }
    55	            }
    56	        }
    57	        true
    58	    }
    59	}

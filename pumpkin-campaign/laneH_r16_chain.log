    22	   public static BehaviorControl<LivingEntity> create(final Predicate<Holder<PoiType>> poiType, final MemoryModuleType<GlobalPos> memoryType) {
    23	      return BehaviorBuilder.create(i -> i.group(i.present(memoryType)).apply(i, memory -> (level, body, timestamp) -> {
    24	         GlobalPos globalPos = i.get(memory);
    25	         BlockPos pos = globalPos.pos();

-+static ERROR_NOT_FOUND: CommandErrorType<1> = CommandErrorType::new(
-+    translation::java::COMMANDS_LOCATE_STRUCTURE_NOT_FOUND,
-+    translation::java::COMMANDS_LOCATE_STRUCTURE_NOT_FOUND,

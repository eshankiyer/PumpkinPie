   117	/// Vanilla reports the horizontal block distance for structures and POIs.
   118	fn horizontal_distance(origin: &BlockPos, target: &BlockPos) -> i32 {
   119	    let dx = f64::from(target.0.x - origin.0.x);
   120	    let dz = f64::from(target.0.z - origin.0.z);
   121	    dx.hypot(dz).floor().max(0.0) as i32
   122	}
   123	
   124	/// ... and the full 3D block distance for biomes.
   125	fn absolute_distance(origin: &BlockPos, target: &BlockPos) -> i32 {
   126	    let dx = f64::from(target.0.x - origin.0.x);
   127	    let dy = f64::from(target.0.y - origin.0.y);
   128	    let dz = f64::from(target.0.z - origin.0.z);
   129	    (dx * dx + dy * dy + dz * dz).sqrt().floor().max(0.0) as i32
   130	}

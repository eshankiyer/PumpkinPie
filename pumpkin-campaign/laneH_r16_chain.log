    22	   public static BehaviorControl<LivingEntity> create(final Predicate<Holder<PoiType>> poiType, final MemoryModuleType<GlobalPos> memoryType) {
    23	      return BehaviorBuilder.create(i -> i.group(i.present(memoryType)).apply(i, memory -> (level, body, timestamp) -> {
    24	         GlobalPos globalPos = i.get(memory);
    25	         BlockPos pos = globalPos.pos();
    26	         if (level.dimension() == globalPos.dimension() && pos.closerToCenterThan(body.position(), 16.0)) {
    27	            ServerLevel poiLevel = level.getServer().getLevel(globalPos.dimension());
    28	            if (poiLevel == null || !poiLevel.getPoiManager().exists(pos, poiType)) {
    29	               memory.erase();
    30	            } else if (bedIsOccupied(poiLevel, pos, body)) {
    31	               memory.erase();
    32	               if (!bedIsOccupiedByVillager(poiLevel, pos)) {
    33	                  level.getPoiManager().release(pos);
    34	                  level.debugSynchronizers().updatePoi(pos);
    35	               }
    36	            }
    37	
    38	            return true;
    39	         } else {
    40	            return false;
    41	         }
    42	      }));
    43	   }

    14	
    15	/// `data/minecraft/timeline/villager_schedule.json`, track
    16	/// `minecraft:gameplay/villager_activity` (period 24000 ticks):
    17	/// idle@10, work@2000, meet@9000, idle@11000, rest@12000.
    18	///
    19	/// The baby schedule (`minecraft:gameplay/baby_villager_activity`, which
    20	/// swaps work/meet for play@3000/10000) is not modeled: Pumpkin villagers
    21	/// don't hold job sites as babies, so there is nothing for a baby-specific
    22	/// schedule to gate here.
    23	#[must_use]
    24	pub const fn villager_activity_for_time(time_of_day: i64) -> VillagerActivity {
    25	    let t = time_of_day.rem_euclid(24000);
    26	    if t < 2000 {
    27	        VillagerActivity::Idle
    28	    } else if t < 9000 {
    29	        VillagerActivity::Work
    30	    } else if t < 11000 {
    31	        VillagerActivity::Meet
    32	    } else if t < 12000 {
    33	        VillagerActivity::Idle
    34	    } else {
    35	        VillagerActivity::Rest
    36	    }
    37	}

    97	    let enchantment = Enchantment::from_id(enchantment_id)?;
    98	    let level = rng.random_range(1..=enchantment.max_level);
    99	    let mut emeralds = 2 + rng.random_range(0..5 + level * 10) + 3 * level;
   100	    if enchantment.has_tag(&EnchantmentTag::MINECRAFT_DOUBLE_TRADE_PRICE) {

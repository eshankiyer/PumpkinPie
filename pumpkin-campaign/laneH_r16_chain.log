   736	    pub async fn add_trades(&self, profession: VillagerProfession, level: i32) {
   737	        use pumpkin_data::villager::VillagerTradeModifier;
   738	        use pumpkin_protocol::codec::item_stack_seralizer::ItemStackSerializer;
   739	        use rand::seq::IndexedRandom;
   740	        use rand::{RngExt, SeedableRng, rngs::StdRng};
   741	        use std::borrow::Cow;
   742	
   743	        let villager_type = self.villager_data.lock().await.type_enum();
   744	        let mut offers = self.offers.lock().await;
   745	
   746	        if let Some(trade_set) = profession.trade_set(level) {
   747	            let mut rng = StdRng::from_rng(&mut rand::rng());
   748	            let mut remaining_trades = trade_set.trades.iter().collect::<Vec<_>>();
   749	            let mut added = 0;
   750	            while added < trade_set.amount && !remaining_trades.is_empty() {
   751	                let index = rng.random_range(0..remaining_trades.len());
   752	                let trade = remaining_trades.remove(index);
   753	                if !trade.allowed_types.is_empty() && !trade.allowed_types.contains(&villager_type)
   754	                {
   755	                    continue;
   756	                }
   757	                let mut base_cost_a = ItemStack::new(trade.wants.count as u8, trade.wants.item);
   758	                let mut output = ItemStack::new(trade.gives.count as u8, trade.gives.item);
   759	                let mut cost_b = trade
   760	                    .wants_b
   761	                    .as_ref()
   762	                    .map(|b| ItemStack::new(b.count as u8, b.item));
   763	
   764	                match trade.modifier {
   765	                    VillagerTradeModifier::None => {}
   766	                    VillagerTradeModifier::EnchantRandomly => {
   767	                        let Some(items) = enchanted_book_offer_items(&mut rng) else {
   768	                            continue;
   769	                        };
   770	                        (base_cost_a, output, cost_b) = items;
   771	                    }
   772	                    VillagerTradeModifier::EnchantWithLevels { min, max } => {
   773	                        let Some((enchanted, additional_cost)) =
   774	                            enchant_trade_item(&mut rng, trade.gives.item, min, max)
   775	                        else {
   776	                            continue;
   777	                        };
   778	                        output = enchanted;
   779	                        let count = i32::from(base_cost_a.item_count)
   780	                            .saturating_add(additional_cost)
   781	                            .clamp(0, i32::from(base_cost_a.get_max_stack_size()));
   782	                        if count == 0 {
   783	                            continue;
   784	                        }
   785	                        base_cost_a.set_count(count as u8);
   786	                    }
   787	                    VillagerTradeModifier::ExplorationMap { destination } => {
   788	                        let Some(map) = self.create_explorer_map(destination).await else {
   789	                            continue;
   790	                        };
   791	                        output = map;
   792	                    }
   793	                    VillagerTradeModifier::RandomDyes => apply_random_dye(&mut rng, &mut output),
   794	                    VillagerTradeModifier::RandomPotion => {
   795	                        let Some(potion_name) = pumpkin_data::tag::Potion::MINECRAFT_TRADEABLE
   796	                            .0
   797	                            .choose(&mut rng)
   798	                        else {
   799	                            continue;
   800	                        };
   801	                        apply_potion(&mut output, potion_name);
   802	                    }
   803	                    VillagerTradeModifier::SuspiciousStew => {
   804	                        apply_random_stew_effect(&mut rng, &mut output);
   805	                    }
   806	                    VillagerTradeModifier::Potion(potion) => apply_potion(&mut output, potion),
   807	                }
   808	                offers.push(pumpkin_protocol::java::client::play::MerchantOffer {
   809	                    base_cost_a: ItemStackSerializer(Cow::Owned(base_cost_a)),
   810	                    output: ItemStackSerializer(Cow::Owned(output)),
   811	                    cost_b: cost_b.map(|stack| ItemStackSerializer(Cow::Owned(stack))),
   812	                    reward_exp: true,

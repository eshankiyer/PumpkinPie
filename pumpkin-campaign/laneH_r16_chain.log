   107	/// The first argument of the success messages: the searched id, with the
   108	/// concretely found entry appended for tag searches, like vanilla's
   109	/// `LocateCommand.showLocateResult`.
   110	fn result_name(searched: &ResourceOrTag, found: &str) -> String {
   111	    match searched {
   112	        ResourceOrTag::Resource(_) => searched.printable(),
   113	        ResourceOrTag::Tag(_) => format!("{} ({found})", searched.printable()),
   114	    }
   115	}

    40	const REPATH_INTERVAL: i32 = 40;
    41	
    42	/// Simplified stand-in for vanilla's `UpdateActivityFromSchedule` +
    43	/// `getWorkPackage`/`getRestPackage` (`VillagerGoalPackages.java`).
    44	///
    45	/// Vanilla drives this through the Brain/Activity/Memory framework (`WorkAtPoi`,
    46	/// `StrollAroundPoi`, `SetWalkTargetFromBlockMemory`, `SleepInBed`, ...), which Pumpkin has
    47	/// no equivalent of. This goal instead just walks the villager to its already-claimed job
    48	/// site during WORK hours, to its already-claimed meeting-point (bell) during MEET hours, and
    49	/// to its already-claimed bed during REST hours, reusing the job-site/meeting-point/home
    50	/// tracking `VillagerEntity` already does in `mob_tick`. During IDLE hours it does nothing,
    51	/// which is a control-conflict no-op: with `Controls::MOVE` and a lower (more urgent)
    52	/// priority number than `WanderAroundGoal`, this goal preempts wandering whenever it is
    53	/// active and yields `MOVE` back to `WanderAroundGoal` otherwise -- so the villager wanders
    54	/// during IDLE (or MEET with no claimed bell) and walks to work/meet/bed on schedule the
    55	/// rest of the day, without needing to touch `WanderAroundGoal` itself (shared by dozens of
    56	/// unrelated mobs).
    57	pub struct VillagerScheduleGoal {
    58	    speed: f64,
    59	    target: Option<Vector3<f64>>,
    60	    ticks_since_path: i32,
    61	}
    62	
    63	impl VillagerScheduleGoal {
    64	    #[must_use]
    65	    pub const fn new(speed: f64) -> Self {
    66	        Self {
    67	            speed,
    68	            target: None,
    69	            ticks_since_path: 0,
    70	        }
    71	    }
    72	
    73	    async fn scheduled_target(mob: &dyn Mob) -> Option<Vector3<f64>> {
    74	        let world = mob.get_entity().world.load();
    75	        let time = world.get_time_of_day().await;
    76	        let pos = match villager_activity_for_time(time) {
    77	            VillagerActivity::Work => mob.get_job_site(),
    78	            VillagerActivity::Rest => mob.get_home(),
    79	            // `SetWalkTargetFromBlockMemory.create(MemoryModuleType.MEETING_POINT, ...)`
    80	            // (`VillagerGoalPackages.getMeetPackage`, priority 2).
    81	            VillagerActivity::Meet => mob.get_meeting_point(),
    82	            VillagerActivity::Idle => None,
    83	        }?;
    84	        Some(Vector3::new(
    85	            pos.0.x as f64 + 0.5,
    86	            pos.0.y as f64,
    87	            pos.0.z as f64 + 0.5,
    88	        ))
    89	    }
    90	
    91	    fn has_arrived(target: Vector3<f64>, mob: &dyn Mob) -> bool {
    92	        target.squared_distance_to_vec(&mob.get_entity().pos.load()) <= ARRIVAL_DIST_SQR
    93	    }
    94	}

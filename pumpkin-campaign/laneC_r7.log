    64	            Some(NbtTag::Compound(nbt)) => Self::from_compound(nbt),
    65	            _ => Self::default(),
    66	        }
    67	    }
    68	
    69	    fn from_compound(nbt: &NbtCompound) -> Self {
    70	        let mut config = Self::default();
    71	        if let Some(v) = nbt.get_int("spawn_range") {
    72	            config.spawn_range = v;
    73	        }
    74	        if let Some(v) = nbt.get_float("total_mobs") {
    75	            config.total_mobs = v;
    76	        }
    77	        if let Some(v) = nbt.get_float("simultaneous_mobs") {
    78	            config.simultaneous_mobs = v;
    79	        }
    80	        if let Some(v) = nbt.get_float("total_mobs_added_per_player") {
    81	            config.total_mobs_added_per_player = v;
    82	        }
    83	        if let Some(v) = nbt.get_float("simultaneous_mobs_added_per_player") {
    84	            config.simultaneous_mobs_added_per_player = v;
    85	        }
    86	        if let Some(v) = nbt.get_int("ticks_between_spawn") {
    87	            config.ticks_between_spawn = i64::from(v);
    88	        }
    89	        if let Some(list) = nbt.get_list("spawn_potentials") {
    90	            for entry in list {
    91	                let NbtTag::Compound(entry) = entry else {
    92	                    continue;
    93	                };
    94	                let weight = entry.get_int("weight").unwrap_or(1);
    95	                let Some(data) = entry.get_compound("data") else {
    96	                    continue;
    97	                };
    98	                let Some(entity) = data.get_compound("entity") else {
    99	                    continue;
   100	                };
   101	                let Some(id) = entity.get_string("id") else {
   102	                    continue;
   103	                };
   104	                let name = id.strip_prefix("minecraft:").unwrap_or(id);
   105	                if let Some(entity_type) = EntityType::from_name(name) {
   106	                    config
   107	                        .spawn_potentials
   108	                        .push((entity_type, weight, data.clone()));
   109	                }
   110	            }
   111	        }
   112	        config
   113	    }

   319	/// One entry of the server's static recipe table.
   320	#[derive(Debug)]
   321	pub struct RecipeEntry {
   322	    /// Namespaced id, standing in for `ResourceKey<Recipe<?>>`.
   323	    pub id: String,
   324	    /// Index the client knows this recipe by, matching the order
   325	    /// `CRecipeBookAdd` writes entries in (all crafting recipes except the special
   326	    /// ones, then all cooking recipes).
   327	    pub display_id: i32,
   328	    /// Item id of the recipe result.
   329	    pub result: u16,
   330	}
   331	
   332	/// Index over the generated recipe tables: id lookup, display-id lookup, and the
   333	/// two "you obtained an item" reverse indices the unlock triggers need.
   334	#[derive(Debug, Default)]
   335	pub struct RecipeRegistry {
   336	    entries: Vec<RecipeEntry>,
   337	    by_id: HashMap<String, usize>,
   338	    by_display_id: HashMap<i32, usize>,
   339	    by_result: HashMap<u16, Vec<usize>>,
   340	    by_ingredient: HashMap<u16, Vec<usize>>,
   341	}
   342	
   343	impl RecipeRegistry {
   344	    #[must_use]
   345	    pub fn contains(&self, id: &str) -> bool {
   346	        self.by_id.contains_key(id)
   347	    }
   348	
   349	    #[must_use]
   350	    pub fn by_display_id(&self, display_id: i32) -> Option<&RecipeEntry> {
   351	        self.by_display_id
   352	            .get(&display_id)
   353	            .map(|index| &self.entries[*index])
   354	    }
   355	
   356	    #[must_use]
   357	    pub fn by_id(&self, id: &str) -> Option<&RecipeEntry> {
   358	        self.by_id.get(id).map(|index| &self.entries[*index])
   359	    }
   360	
   361	    /// Recipes whose result is this item.
   362	    #[must_use]
   363	    pub fn producing(&self, item_id: u16) -> &[usize] {
   364	        self.by_result.get(&item_id).map_or(&[], Vec::as_slice)
   365	    }
   366	
   367	    /// Recipes that take this item as an ingredient.
   368	    #[must_use]
   369	    pub fn consuming(&self, item_id: u16) -> &[usize] {
   370	        self.by_ingredient.get(&item_id).map_or(&[], Vec::as_slice)
   371	    }
   372	
   373	    #[must_use]
   374	    pub fn id_of(&self, index: usize) -> &str {
   375	        &self.entries[index].id
   376	    }
   377	
   378	    #[must_use]
   379	    pub const fn len(&self) -> usize {
   380	        self.entries.len()
   381	    }
   382	
   383	    #[must_use]
   384	    pub const fn is_empty(&self) -> bool {
   385	        self.entries.is_empty()
   386	    }
   387	}
   388	
   389	static REGISTRY: OnceLock<RecipeRegistry> = OnceLock::new();
   390	
   391	/// The lazily built static recipe index.
   392	pub fn registry() -> &'static RecipeRegistry {
   393	    REGISTRY.get_or_init(build_registry)
   394	}

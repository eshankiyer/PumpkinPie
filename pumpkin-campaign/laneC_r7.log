    80	/// A trait to try getting a value from a [`StringReader`].
    81	pub trait FromStringReader: Sized {
    82	    /// Tries to parse a value of this type from a [`StringReader`].
    83	    ///
    84	    /// If this fails, a [`CommandSyntaxError`] is returned with the erroring details.
    85	    fn from_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError>;
    86	}
    87	
    88	fn bounds_from_reader<T: Copy + FromStr + PartialOrd>(
    89	    reader: &mut StringReader,
    90	    error_type: &'static CommandErrorType<1>,
    91	) -> Result<Bounds<T>, CommandSyntaxError> {
    92	    if reader.can_read_char() {
    93	        let i = reader.cursor();
    94	        try_bounds_from_reader(reader, error_type).map_err(|e| {
    95	            // On catching any error, set the reader's cursor position to be at where the range starts.
    96	            if let Some(mut context) = e.context {
    97	                context.cursor = i;
    98	                CommandSyntaxError::create(e.error_type, e.message, &context)
    99	            } else {
   100	                CommandSyntaxError::create_without_context(e.error_type, e.message)
   101	            }
   102	        })
   103	    } else {
   104	        Err(EMPTY_BOUNDS_ERROR_TYPE.create(reader))
   105	    }
   106	}
   107	
   108	fn try_bounds_from_reader<T: Copy + FromStr + PartialOrd>(
   109	    reader: &mut StringReader,
   110	    error_type: &'static CommandErrorType<1>,
   111	) -> Result<Bounds<T>, CommandSyntaxError> {
   112	    let min = read_number_from_reader(reader, error_type)?;
   113	    let max = if reader.peek() == Some('.') && reader.peek_with_offset(1) == Some('.') {
   114	        reader.skip();
   115	        reader.skip();
   116	        read_number_from_reader(reader, error_type)?
   117	    } else {
   118	        min
   119	    };
   120	    if min.is_none() && max.is_none() {
   121	        Err(EMPTY_BOUNDS_ERROR_TYPE.create(reader))
   122	    } else {
   123	        Ok(Bounds::<T>::new(min, max))
   124	    }
   125	}
   126	
   127	/// Tries to read a number of a type from a reader.
   128	fn read_number_from_reader<T: FromStr>(
   129	    reader: &mut StringReader,
   130	    error_type: &'static CommandErrorType<1>,
   131	) -> Result<Option<T>, CommandSyntaxError> {
   132	    let i = reader.cursor();
   133	    while has_allowed_peaked_character(reader) {
   134	        reader.skip();
   135	    }
   136	    let string = &reader.string()[i..reader.cursor()].to_string();
   137	    if string.is_empty() {
   138	        Ok(None)
   139	    } else {
   140	        string.parse::<T>().map_or_else(
   141	            |_| Err(error_type.create(reader, TextComponent::text(string.clone()))),
   142	            |t| Ok(Some(t)),
   143	        )
   144	    }
   145	}
   146	
   147	fn has_allowed_peaked_character(reader: &StringReader) -> bool {
   148	    let c = reader.peek();
   149	    if matches!(c, Some('0'..='9' | '-')) {
   150	        true
   151	    } else {
   152	        c.is_some_and(|c| {
   153	            c == '.' && (!reader.can_read_chars(2) || reader.peek_with_offset(1) != Some('.'))
   154	        })
   155	    }
   156	}

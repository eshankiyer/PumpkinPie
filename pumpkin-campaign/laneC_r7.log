    71	/// Vanilla-style chunk-seed derivation used by structure pieces and feature generators.
    72	const fn chunk_population_seed(cx: i32, cz: i32, world_seed: u64) -> u64 {
    73	    (cx as i64)
    74	        .wrapping_mul(341873128712)
    75	        .wrapping_add((cz as i64).wrapping_mul(132897987541))
    76	        .wrapping_add(world_seed as i64) as u64
    77	}

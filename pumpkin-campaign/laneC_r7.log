    25	fn get_recipe_id(recipe: &DynamicRecipe) -> String {
    26	    match recipe {
    27	        DynamicRecipe::Crafting(crafting) => match crafting {
    28	            pumpkin_protocol::codec::recipe::OwnedCraftingRecipe::Shaped {
    29	                recipe_id,
    30	                result,
    31	                ..
    32	            }
    33	            | pumpkin_protocol::codec::recipe::OwnedCraftingRecipe::Shapeless {
    34	                recipe_id,
    35	                result,
    36	                ..
    37	            }
    38	            | pumpkin_protocol::codec::recipe::OwnedCraftingRecipe::Dye {
    39	                recipe_id, result, ..
    40	            }
    41	            | pumpkin_protocol::codec::recipe::OwnedCraftingRecipe::Imbue {
    42	                recipe_id,
    43	                result,
    44	                ..
    45	            } => recipe_id.clone().unwrap_or_else(|| result.item_id.clone()),
    46	        },
    47	        DynamicRecipe::Cooking(cooking) => match cooking {
    48	            pumpkin_protocol::codec::recipe::OwnedCookingRecipeType::Smelting(r)
    49	            | pumpkin_protocol::codec::recipe::OwnedCookingRecipeType::Blasting(r)
    50	            | pumpkin_protocol::codec::recipe::OwnedCookingRecipeType::Smoking(r)
    51	            | pumpkin_protocol::codec::recipe::OwnedCookingRecipeType::CampfireCooking(r) => {
    52	                r.recipe_id.clone()
    53	            }
    54	        },
    55	    }
    56	}

   121	struct PlaceTemplateExecutor;
   122	
   123	impl CommandExecutor for PlaceTemplateExecutor {
   124	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
   125	        Box::pin(async move {
   126	            let template_name = context.get_argument::<String>("template")?.clone();
   127	
   128	            let block_pos =
   129	                BlockPosArgumentType::get_block_pos(context, "pos").unwrap_or_else(|_| {
   130	                    let p = context.source.position;
   131	                    BlockPos::new(p.x as i32, p.y as i32, p.z as i32)
   132	                });
   133	
   134	            let template_name = template_name
   135	                .strip_prefix("minecraft:")
   136	                .unwrap_or(&template_name)
   137	                .to_string();
   138	            let Some(template) =
   139	                pumpkin_world::generation::structure::template::get_template(&template_name)
   140	            else {
   141	                return Err(TEMPLATE_NOT_FOUND
   142	                    .create_without_context(TextComponent::text(template_name.clone())));
   143	            };
   144	
   145	            let mut placer = WorldBlockPlacer::new(context.world());
   146	            pumpkin_world::generation::structure::template::place_template(
   147	                &mut placer,
   148	                &template,
   149	                block_pos.0,
   150	                (0, 0),
   151	                Rotation::None,
   152	                false,
   153	                false,
   154	                &[],
   155	                None,
   156	            );
   157	
   158	            placer.finalize();
   159	            context
   160	                .world()
   161	                .queue_block_updates(&placer.changed_positions)
   162	                .await;
   163	            context.world().flush_block_updates().await;
   164	
   165	            context
   166	                .source
   167	                .send_feedback(
   168	                    pumpkin_macros::translate_cross!(
   169	                        translation::java::COMMANDS_PLACE_TEMPLATE_SUCCESS,
   170	                        translation::bedrock::COMMANDS_PLACE_SUCCESS,
   171	                        TextComponent::text(template_name.clone()),
   172	                        TextComponent::text(block_pos.0.x.to_string()),
   173	                        TextComponent::text(block_pos.0.y.to_string()),
   174	                        TextComponent::text(block_pos.0.z.to_string())
   175	                    ),
   176	                    true,
   177	                )
   178	                .await;
   179	
   180	            Ok(1)
   300	    let registry = registry();
   301	    nbt.get_list(key)
   302	        .unwrap_or(&[])
   303	        .iter()
   304	        .filter_map(|tag| match tag {
   305	            NbtTag::String(id) => Some(id.to_string()),
   306	            _ => None,
   307	        })
   308	        .filter(|id| {
   309	            if registry.contains(id) {
   310	                true
   311	            } else {
   312	                tracing::warn!("Tried to load unrecognized recipe: {id} removed now.");
   313	                false
   314	            }
   315	        })
   316	        .collect()
   317	}

   221	   private boolean swapHotbar(final Level level, final BlockPos pos, final Inventory inventory) {
   222	      List<BlockPos> connectedBlocks = this.getAllBlocksConnectedTo(level, pos);
   223	      if (connectedBlocks.isEmpty()) {
   224	         return false;
   225	      }
   226	
   227	      boolean anySwapped = false;
   228	
   229	      for (int shelfPartIndex = 0; shelfPartIndex < connectedBlocks.size(); shelfPartIndex++) {
   230	         ShelfBlockEntity shelfPart = (ShelfBlockEntity)level.getBlockEntity(connectedBlocks.get(shelfPartIndex));
   231	         if (shelfPart != null) {
   232	            for (int slot = 0; slot < shelfPart.getContainerSize(); slot++) {
   233	               int inventorySlot = 9 - (connectedBlocks.size() - shelfPartIndex) * shelfPart.getContainerSize() + slot;
   234	               if (inventorySlot >= 0 && inventorySlot <= inventory.getContainerSize()) {
   235	                  ItemStack placedInventoryItem = inventory.removeItemNoUpdate(inventorySlot);
   236	                  ItemStack removedShelfItem = shelfPart.swapItemNoUpdate(slot, placedInventoryItem);
   237	                  if (!placedInventoryItem.isEmpty() || !removedShelfItem.isEmpty()) {
   238	                     inventory.setItem(inventorySlot, removedShelfItem);
   239	                     anySwapped = true;
   240	                  }
   241	               }
   242	            }
   243	
   244	            inventory.setChanged();
   245	            shelfPart.setChanged(GameEvent.ENTITY_INTERACT);
   246	         }
   247	      }
   248	
   249	      return anySwapped;
   250	   }

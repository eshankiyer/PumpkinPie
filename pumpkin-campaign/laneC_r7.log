   107	pub(crate) fn set_waterlogged(
   108	    block: &Block,
   109	    state: BlockStateId,
   110	    waterlogged: bool,
   111	) -> BlockStateId {
   112	    let Some(props) = block.properties(state) else {
   113	        return state;
   114	    };
   115	    let original_props = &props.to_props();
   116	    let waterlogged = waterlogged.to_string();
   117	    let props: Vec<(&str, &str)> = original_props
   118	        .iter()
   119	        .map(|(key, value)| {
   120	            if *key == "waterlogged" {
   121	                ("waterlogged", waterlogged.as_str())
   122	            } else {
   123	                (*key, *value)
   124	            }
   125	        })
   126	        .collect();
   127	    block.from_properties(&props).to_state_id(block)
   128	}

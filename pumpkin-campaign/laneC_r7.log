   190	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   191	        Box::pin(async move {
   192	            self.entity.write_nbt(nbt).await;
   193	            let item = self.item.lock().await;

   199	        Box::pin(async move {
   200	            self.entity.read_nbt_non_mut(nbt).await;
   201	            let (item, ticks) = Self::read_spawner_nbt(nbt);
   202	            *self.item.lock().await = item;
   203	            self.spawn_item_after_ticks.store(ticks, Relaxed);
   204	        })

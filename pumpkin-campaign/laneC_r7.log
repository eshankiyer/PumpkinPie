    82	struct RecipeGiveExecutor;
    83	
    84	impl CommandExecutor for RecipeGiveExecutor {
    85	    fn execute<'a>(&'a self, context: &'a CommandContext) -> CommandExecutorResult<'a> {
    86	        Box::pin(async move {
    87	            let targets = EntityArgumentType::get_players(context, "targets").await?;
    88	            let recipe_str = StringArgumentType::get(context, "recipe")?;
    89	
    90	            let server = context.source.server.as_ref().ok_or_else(|| {
    91	                ERROR_RECIPE_NOT_FOUND
    92	                    .create_without_context(TextComponent::text(recipe_str.to_string()))
    93	            })?;
    94	
    95	            let all_recipes = server.recipe_manager.get_dynamic_recipes_internal().await;
    96	
    97	            let is_all = recipe_str == "*";
    98	            let matching_recipes = if is_all {
    99	                all_recipes.clone()
   100	            } else {
   101	                all_recipes
   102	                    .iter()
   103	                    .filter(|r| {
   104	                        let id = get_recipe_id(r);
   105	                        id == recipe_str
   106	                            || id.strip_prefix("minecraft:").unwrap_or(&id) == recipe_str
   107	                    })
   108	                    .cloned()
   109	                    .collect::<Vec<_>>()
   110	            };
   111	
   112	            if !is_all && matching_recipes.is_empty() {
   113	                return Err(ERROR_RECIPE_NOT_FOUND
   114	                    .create_without_context(TextComponent::text(recipe_str.to_string())));
   115	            }
   116	
   117	            let recipe_count = matching_recipes.len();
   118	
   119	            for player in &targets {
   120	                // `/recipe give` is `ServerPlayer.awardRecipes`: the unlock has to enter the
   121	                // player's book, or it is forgotten on reconnect. `award_recipes` also sends
   122	                // the subset add packet, so sending a full-table add here as well would
   123	                // overwrite the per-player set that was just established.
   124	                let ids: Vec<String> = matching_recipes.iter().map(get_recipe_id).collect();
   125	                player.award_recipes(ids.iter().map(String::as_str)).await;
   126	            }
   127	
   128	            let recipe_count_str = recipe_count.to_string();
   129	            if targets.len() == 1 {
   130	                let msg = TextComponent::translate_cross(
   131	                    translation::java::COMMANDS_RECIPE_GIVE_SUCCESS_SINGLE,
   132	                    translation::java::COMMANDS_RECIPE_GIVE_SUCCESS_SINGLE,
   133	                    [
   134	                        TextComponent::text(recipe_count_str),
   135	                        targets[0].get_display_name().await,
   136	                    ],
   137	                );
   138	                context.source.send_feedback(msg, true).await;
   139	            } else {
   140	                let msg = TextComponent::translate_cross(
   141	                    translation::java::COMMANDS_RECIPE_GIVE_SUCCESS_MULTIPLE,
   142	                    translation::java::COMMANDS_RECIPE_GIVE_SUCCESS_MULTIPLE,
   143	                    [
   144	                        TextComponent::text(recipe_count_str),
   145	                        TextComponent::text(targets.len().to_string()),
   146	                    ],
   147	                );
   148	                context.source.send_feedback(msg, true).await;
   149	            }
   150	
   151	            Ok((targets.len() * recipe_count) as i32)
   152	        })
   153	    }
   154	}

   593	    // TrialSpawnerState.java:63-155
   594	    async fn tick_state_machine(
   595	        &self,
   596	        world: &Arc<World>,
   597	        current: TrialSpawnerState,
   598	        is_ominous: bool,
   599	        config: &TrialSpawnerConfig,
   600	        game_time: i64,
   601	    ) -> TrialSpawnerState {
   602	        match current {
   603	            TrialSpawnerState::Inactive => TrialSpawnerState::WaitingForPlayers,
   604	            TrialSpawnerState::WaitingForPlayers => {
   605	                if !Self::can_spawn_in_level(world) {
   606	                    self.reset_statistics().await;
   607	                    return TrialSpawnerState::WaitingForPlayers;
   608	                }
   609	                if !self.has_mob_to_spawn(config).await {
   610	                    return TrialSpawnerState::Inactive;
   611	                }
   612	                self.try_detect_players(world, is_ominous).await;
   613	                if self.detected_players.lock().await.is_empty() {
   614	                    TrialSpawnerState::WaitingForPlayers
   615	                } else {
   616	                    TrialSpawnerState::Active
   617	                }
   618	            }
   619	            TrialSpawnerState::Active => {
   620	                self.tick_active_state(world, is_ominous, config, game_time)
   621	                    .await
   622	            }
   623	            TrialSpawnerState::WaitingForRewardEjection => {
   624	                // StateData.java:213-216
   625	                let cooldown_started_at =
   626	                    self.cooldown_ends_at.load(Ordering::Relaxed) - self.target_cooldown_length;
   627	                if game_time >= cooldown_started_at + DELAY_BEFORE_EJECT_AFTER_KILLING_LAST_MOB {
   628	                    // TrialSpawnerConfig.java:99-102: lootTablesToEject is a
   629	                    // 1:1-weighted choice between the consumables and key tables,
   630	                    // picked once per reward cycle.
   631	                    let table = if is_ominous {
   632	                        if rand::random_range(0..10) < 3 {
   633	                            "minecraft:spawners/ominous/trial_chamber/key"
   634	                        } else {
   635	                            "minecraft:spawners/ominous/trial_chamber/consumables"
   636	                        }
   637	                    } else if rand::random_range(0..2) == 0 {
   638	                        "minecraft:spawners/trial_chamber/consumables"
   639	                    } else {
   640	                        "minecraft:spawners/trial_chamber/key"
   641	                    };
   642	                    *self.ejecting_loot_table.lock().unwrap() = Some(table.to_string());
   643	                    world.play_block_sound(
   644	                        Sound::BlockTrialSpawnerOpenShutter,
   645	                        SoundCategory::Blocks,
   646	                        self.position,
   647	                    );
   648	                    TrialSpawnerState::EjectingReward
   649	                } else {
   650	                    TrialSpawnerState::WaitingForRewardEjection
   651	                }
   652	            }
   653	            TrialSpawnerState::EjectingReward => {
   654	                let cooldown_started_at =
   655	                    self.cooldown_ends_at.load(Ordering::Relaxed) - self.target_cooldown_length;
   656	                if (game_time - cooldown_started_at) % TIME_BETWEEN_EACH_EJECTION != 0 {
   657	                    return TrialSpawnerState::EjectingReward;
   658	                }
   659	                if self.detected_players.lock().await.is_empty() {
   660	                    *self.ejecting_loot_table.lock().unwrap() = None;
   661	                    world.play_block_sound(
   662	                        Sound::BlockTrialSpawnerCloseShutter,
   663	                        SoundCategory::Blocks,
   664	                        self.position,
   665	                    );
   666	                    TrialSpawnerState::Cooldown
   667	                } else {
   668	                    let table = self.ejecting_loot_table.lock().unwrap().clone();
   669	                    if let Some(table) = table.as_deref() {
   670	                        self.eject_reward(world, table).await;
   671	                    }
   672	                    let mut detected = self.detected_players.lock().await;
   673	                    if let Some(&first) = detected.iter().next() {
   674	                        detected.remove(&first);
   675	                    }
   676	                    TrialSpawnerState::EjectingReward
   677	                }
   678	            }
   679	            TrialSpawnerState::Cooldown => {
   680	                self.try_detect_players(world, is_ominous).await;
   681	                if !self.detected_players.lock().await.is_empty() {
   682	                    self.total_mobs_spawned.store(0, Ordering::Relaxed);
   683	                    self.next_mob_spawns_at.store(0, Ordering::Relaxed);
   684	                    TrialSpawnerState::Active
   685	                } else if game_time >= self.cooldown_ends_at.load(Ordering::Relaxed) {
   686	                    self.reset().await;
   687	                    TrialSpawnerState::WaitingForPlayers
   688	                } else {
   689	                    TrialSpawnerState::Cooldown
   690	                }
   691	            }
   692	        }
   693	    }
   694	
   695	    /// `TrialSpawnerState.ACTIVE.tick` (`TrialSpawnerState.java`, `ACTIVE` case): counts nearby
   696	    /// players, spawns mobs up to the simultaneous/total caps, and transitions to
   697	    /// `WaitingForRewardEjection` once the total cap is hit and all spawned mobs are dead.
   698	    async fn tick_active_state(
   699	        &self,
   700	        world: &Arc<World>,
   701	        is_ominous: bool,
   702	        config: &TrialSpawnerConfig,
   703	        game_time: i64,
   704	    ) -> TrialSpawnerState {
   705	        if !Self::can_spawn_in_level(world) {
   706	            self.reset_statistics().await;
   707	            return TrialSpawnerState::WaitingForPlayers;
   708	        }
   709	        if !self.has_mob_to_spawn(config).await {
   710	            return TrialSpawnerState::Inactive;
   711	        }
   712	        let additional_players = self.count_additional_players().await;
   713	        self.try_detect_players(world, is_ominous).await;
   714	
   715	        let total_spawned = self.total_mobs_spawned.load(Ordering::Relaxed);
   716	        if total_spawned >= config.calculate_target_total_mobs(additional_players) {
   717	            if self.current_mobs.lock().await.is_empty() {
   718	                self.cooldown_ends_at
   719	                    .store(game_time + self.target_cooldown_length, Ordering::Relaxed);
   720	                self.total_mobs_spawned.store(0, Ordering::Relaxed);
   721	                self.next_mob_spawns_at.store(0, Ordering::Relaxed);
   722	                return TrialSpawnerState::WaitingForRewardEjection;
   723	            }
   724	        } else if game_time >= self.next_mob_spawns_at.load(Ordering::Relaxed)
   725	            && self.current_mobs.lock().await.len()
   726	                < config.calculate_target_simultaneous_mobs(additional_players) as usize
   727	            && let Some(uuid) = self.spawn_mob(world, config).await
   728	        {
   729	            self.current_mobs.lock().await.insert(uuid);
   730	            self.total_mobs_spawned.fetch_add(1, Ordering::Relaxed);
   731	            self.next_mob_spawns_at
   732	                .store(game_time + config.ticks_between_spawn, Ordering::Relaxed);
   733	        }
   734	        TrialSpawnerState::Active
   735	    }
   736	}

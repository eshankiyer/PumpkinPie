   197	impl FromStringReader for Identifier {
   198	    fn from_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
   199	        let start = reader.cursor();
   200	        while let Some(c) = reader.peek()
   201	            && Self::is_valid_char(c)
   202	        {
   203	            reader.skip();
   204	        }
   205	
   206	        let raw_identifier = &reader.string()[start..reader.cursor()];
   207	        let identifier_result = Self::parse(raw_identifier);
   208	
   209	        identifier_result.map_or_else(
   210	            |_| {
   211	                reader.set_cursor(start);
   212	                Err(INVALID_IDENTIFIER_ERROR_TYPE.create(reader))
   213	            },
   214	            Ok,
   215	        )
   216	    }
   217	}

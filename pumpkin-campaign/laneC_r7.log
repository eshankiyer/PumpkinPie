   126	/// The 6x6 block of biome cells covering one chunk plus a one-cell border, flattened out of the
   127	/// surrounding chunks' biome maps.
   128	///
   129	/// Vanilla resolves a biome-cell lookup to the chunk that owns it
   130	/// (`LevelReader.getNoiseBiome` -> `QuartPos.toSection`), so lookups that spill past a chunk edge
   131	/// -- which `BiomeManager.getBiome`'s -2 block offset makes routine for the first two columns of
   132	/// every chunk -- read the neighbour, not a wrapped-around cell of the same chunk.
   133	pub struct BiomeNeighborhood {
   134	    /// Biome-cell X of the border cell west of the chunk.
   135	    min_biome_x: i32,
   136	    /// Biome-cell Z of the border cell north of the chunk.
   137	    min_biome_z: i32,
   138	    /// Biome-cell Y of the bottom layer.
   139	    min_biome_y: i32,
   140	    y_cells: i32,
   141	    /// `[(dx * 6 + dz) * y_cells + dy]`, `u8::MAX` where no chunk was available.
   142	    data: Box<[u8]>,
   143	}

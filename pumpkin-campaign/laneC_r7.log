   261	    fn build_level_heightmaps(proto_chunk: &ProtoChunk, min_y: i32) -> ChunkHeightmaps {
   262	        let mut heightmaps = ChunkHeightmaps::default();
   263	        for x in 0..16 {
   264	            for z in 0..16 {
   265	                let source_index = x * 16 + z;
   266	                for (heightmap_type, height) in [
   267	                    (
   268	                        ChunkHeightmapType::WorldSurface,
   269	                        proto_chunk.flat_surface_height_map[source_index],
   270	                    ),
   271	                    (
   272	                        ChunkHeightmapType::MotionBlocking,
   273	                        proto_chunk.flat_motion_blocking_height_map[source_index],
   274	                    ),
   275	                    (
   276	                        ChunkHeightmapType::MotionBlockingNoLeaves,
   277	                        proto_chunk.flat_motion_blocking_no_leaves_height_map[source_index],
   278	                    ),
   279	                    (
   280	                        ChunkHeightmapType::OceanFloor,
   281	                        proto_chunk.flat_ocean_floor_height_map[source_index],
   282	                    ),
   283	                ] {
   284	                    heightmaps.set(heightmap_type, x as i32, z as i32, i32::from(height), min_y);
   285	                }
   286	            }
   287	        }
   288	        heightmaps
   289	    }

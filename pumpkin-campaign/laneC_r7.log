   253	   private void teleportToAroundBlockPos(final BlockPos targetPos) {
   254	      for (int attempt = 0; attempt < 10; attempt++) {
   255	         int xd = this.random.nextIntBetweenInclusive(-3, 3);
   256	         int zd = this.random.nextIntBetweenInclusive(-3, 3);
   257	         if (Math.abs(xd) >= 2 || Math.abs(zd) >= 2) {
   258	            int yd = this.random.nextIntBetweenInclusive(-1, 1);
   259	            if (this.maybeTeleportTo(targetPos.getX() + xd, targetPos.getY() + yd, targetPos.getZ() + zd)) {
   260	               return;
   261	            }
   262	         }
   263	      }
   264	   }
   265	
   266	   private boolean maybeTeleportTo(final int x, final int y, final int z) {
   267	      if (!this.canTeleportTo(new BlockPos(x, y, z))) {
   268	         return false;
   269	      }
   270	
   271	      this.snapTo(x + 0.5, y, z + 0.5, this.getYRot(), this.getXRot());
   272	      this.navigation.stop();
   273	      return true;
   274	   }
   275	
   276	   private boolean canTeleportTo(final BlockPos pos) {
   277	      PathType pathType = WalkNodeEvaluator.getPathTypeStatic(this, pos);
   278	      if (pathType != PathType.WALKABLE) {
   279	         return false;
   280	      }
   281	
   282	      BlockState blockStateBelow = this.level().getBlockState(pos.below());
   283	      if (!this.canFlyToOwner() && blockStateBelow.getBlock() instanceof LeavesBlock) {
   284	         return false;
   285	      }
   286	
   287	      BlockPos delta = pos.subtract(this.blockPosition());
   288	      return this.level().noCollision(this, this.getBoundingBox().move(delta));
   289	   }

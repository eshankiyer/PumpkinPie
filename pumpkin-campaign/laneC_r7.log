    59	    // trial_spawner_config registry (TrialSpawnerConfigs.java), not an inline compound.
    60	    // An inline compound is still accepted for hand-authored / test NBT.
    61	    fn from_nbt(nbt: Option<&NbtTag>) -> Self {

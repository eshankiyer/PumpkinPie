   149	            Self::get_registry_key(context, name, BIOME_REGISTRY, &ERROR_INVALID_BIOME)?;
   150	        let path = resource_key.identifier.path();
   151	        pumpkin_data::biome::Biome::from_name(path).ok_or_else(|| {
   152	            ERROR_INVALID_BIOME
   153	                .create_without_context(TextComponent::text(resource_key.identifier.to_string()))
   154	        })
   155	    }
   156	
   157	    /// Returns a [`CommandContext`]'s parsed resource key argument in the form of a [`ResourceKey`].
   158	    ///
   159	    /// # Arguments
   160	    /// * `context` - The [`CommandContext`] that has the parsed [`ResourceKey`] with the provided argument name.
   161	    /// * `name` - The name of the argument that was parsed.
   162	    ///
   163	    /// # Returns
   164	    /// The `ResourceKey` containing the key get from the argument, wrapped in an `Ok`,
   165	    /// or an `Err` with the appropriate [`CommandSyntaxError`] if it could not be resolved
   166	    pub fn get_registry_key<'a>(
   167	        context: &'a CommandContext,
   168	        name: &str,
   169	        registry: &Identifier,
   170	        error: &'static CommandErrorType<1>,
   171	    ) -> Result<&'a ResourceKey, CommandSyntaxError> {
   172	        let argument = context.get_argument::<ResourceKey>(name)?;
   173	        argument.cast(registry).ok_or_else(|| {
   174	            error
   175	                .create_without_context(TextComponent::text(argument.identifier.path().to_string()))
   176	        })
   177	    }
   178	}

    20	
    21	public class JigsawBlock extends Block implements EntityBlock, GameMasterBlock {
    22	   public static final MapCodec<JigsawBlock> CODEC = simpleCodec(JigsawBlock::new);
    23	   public static final EnumProperty<FrontAndTop> ORIENTATION = BlockStateProperties.ORIENTATION;
    24	
    25	   @Override
    26	   public MapCodec<JigsawBlock> codec() {
    27	      return CODEC;
    28	   }
    29	
    30	   protected JigsawBlock(final BlockBehaviour.Properties properties) {
    31	      super(properties);
    32	      this.registerDefaultState(this.stateDefinition.any().setValue(ORIENTATION, FrontAndTop.NORTH_UP));
    33	   }
    34	
    35	   @Override
    36	   protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
    37	      builder.add(ORIENTATION);
    38	   }
    39	
    40	   @Override
    41	   protected BlockState rotate(final BlockState state, final Rotation rotation) {
    42	      return state.setValue(ORIENTATION, rotation.rotation().rotate(state.getValue(ORIENTATION)));
    43	   }
    44	
    45	   @Override
    46	   protected BlockState mirror(final BlockState state, final Mirror mirror) {
    47	      return state.setValue(ORIENTATION, mirror.rotation().rotate(state.getValue(ORIENTATION)));
    48	   }
    49	
    50	   @Override
    51	   public BlockState getStateForPlacement(final BlockPlaceContext context) {
    52	      Direction front = context.getClickedFace();
    53	      Direction top;
    54	      if (front.getAxis() == Direction.Axis.Y) {
    55	         top = context.getHorizontalDirection().getOpposite();
    56	      } else {
    57	         top = Direction.UP;
    58	      }
    59	
    60	      return this.defaultBlockState().setValue(ORIENTATION, FrontAndTop.fromFrontAndTop(front, top));
    61	   }
    62	
    63	   @Override
    64	   public BlockEntity newBlockEntity(final BlockPos worldPosition, final BlockState blockState) {
    65	      return new JigsawBlockEntity(worldPosition, blockState);
    66	   }
    67	
    68	   @Override
    69	   protected InteractionResult useWithoutItem(
    70	      final BlockState state, final Level level, final BlockPos pos, final Player player, final BlockHitResult hitResult
    71	   ) {
    72	      if (level.getBlockEntity(pos) instanceof JigsawBlockEntity jigsawBlockEntity && player.canUseGameMasterBlocks()) {
    73	         player.openJigsawBlock(jigsawBlockEntity);
    74	         return InteractionResult.SUCCESS;
    75	      } else {
    76	         return InteractionResult.PASS;
    77	      }
    78	   }
    79	
    80	   public static boolean canAttach(final StructureTemplate.JigsawBlockInfo source, final StructureTemplate.JigsawBlockInfo target) {
    81	      Direction sourceFront = getFrontFacing(source.info().state());
    82	      Direction targetFront = getFrontFacing(target.info().state());
    83	      Direction sourceTop = getTopFacing(source.info().state());
    84	      Direction targetTop = getTopFacing(target.info().state());
    85	      JigsawBlockEntity.JointType jointType = source.jointType();
    86	      boolean rollable = jointType == JigsawBlockEntity.JointType.ROLLABLE;
    87	      return sourceFront == targetFront.getOpposite() && (rollable || sourceTop == targetTop) && source.target().equals(target.name());
    88	   }
    89	
    90	   public static Direction getFrontFacing(final BlockState state) {
    91	      return state.getValue(ORIENTATION).front();
    92	   }
    93	
    94	   public static Direction getTopFacing(final BlockState state) {
    95	      return state.getValue(ORIENTATION).top();
    96	   }
    97	}


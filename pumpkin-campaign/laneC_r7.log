   446	    #[allow(clippy::unused_async)]
   447	    async fn get_or_create_next_spawn_data(
   448	        &self,
   449	        config: &TrialSpawnerConfig,
   450	    ) -> Option<(&'static EntityType, NbtCompound)> {
   451	        let mut next = self.next_spawn_entity.lock().unwrap();
   452	        let mut data = self.next_spawn_data.lock().unwrap();
   453	        if next.is_none() {
   454	            let (entity, spawn_data) = config.pick_random_spawn_data()?;
   455	            *next = Some(entity);
   456	            *data = Some(spawn_data);
   457	        }
   458	        let entity = (*next)?;
   459	        let spawn_data = data.clone().unwrap_or_else(|| {
   460	            let mut entity_data = NbtCompound::new();
   461	            entity_data.put_string("id", format!("minecraft:{}", entity.resource_name));
   462	            let mut spawn_data = NbtCompound::new();
   463	            spawn_data.put_compound("entity", entity_data);
   464	            spawn_data
   465	        });
   466	        Some((entity, spawn_data))
   467	    }

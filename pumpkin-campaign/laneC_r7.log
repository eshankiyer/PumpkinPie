  8042	
  8043	impl Default for MessageCache {
  8044	    fn default() -> Self {
  8045	        Self {
  8046	            full_cache: VecDeque::with_capacity(MAX_CACHED_SIGNATURES as usize),
  8047	            last_seen: LastSeen::default(),
  8048	            last_seen_validator: LastSeenMessagesValidator::default(),
  8049	        }
  8050	    }
  8051	}
  8052	
  8053	impl MessageCache {
  8054	    /// Not used for caching seen messages. Only for non-indexed signatures from senders.
  8055	    pub fn cache_signatures(&mut self, signatures: &[Box<[u8]>]) {
  8056	        for sig in signatures.iter().rev() {
  8057	            if self.full_cache.contains(sig) {
  8058	                continue;
  8059	            }
  8060	            // If the cache is maxed, and someone sends a signature older than the oldest in cache, ignore it
  8061	            if self.full_cache.len() < MAX_CACHED_SIGNATURES as usize {
  8062	                self.full_cache.push_back(sig.clone()); // Recipient never saw this message so it must be older than the oldest in cache
  8063	            }
  8064	        }
  8065	    }
  8066	
  8067	    /// Adds a seen signature to `last_seen` and `full_cache`.
  8068	    pub fn add_seen_signature(&mut self, signature: &[u8]) {
  8069	        if self.last_seen.0.len() >= MAX_PREVIOUS_MESSAGES as usize {
  8070	            self.last_seen.0.remove(0);
  8071	        }
  8072	        self.last_seen.0.push(signature.into());
  8073	        // This probably doesn't need to be a loop, but better safe than sorry
  8074	        while self.full_cache.len() >= MAX_CACHED_SIGNATURES as usize {
  8075	            self.full_cache.pop_back();
  8076	        }
  8077	        self.full_cache.push_front(signature.into()); // Since recipient saw this message it will be most recent in cache
  8078	    }
  8079	}

    88	pub(crate) fn waterlogged_check(block: &Block, state: BlockStateId) -> Option<bool> {
    89	    if block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_SLABS)
    90	        && !crate::block::blocks::slabs::can_place_liquid(block, state)
    91	    {
    92	        return None;
    93	    }
    94	    block.properties(state).and_then(|properties| {
    95	        properties
    96	            .to_props()
    97	            .into_iter()
    98	            .find(|p| p.0 == "waterlogged")
    99	            .map(|(_, value)| value == "true")
   100	    })
   101	}
   102	
   103	pub(crate) fn is_waterlogged(block: &Block, state: BlockStateId) -> bool {
   104	    waterlogged_check(block, state).unwrap_or(false)
   105	}

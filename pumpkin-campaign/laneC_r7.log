    60	    async fn update_output(&self) {
    61	        let input_lock = self.input_inventory.get_stack(0).await;
    62	
    63	        // `StonecutterMenu.slotsChanged` resets the selected recipe when the input
    64	        // item changes (StonecutterMenu.java:127-134), but retains it when only the
    65	        // count changes. Track the item id so every input mutation path, including
    66	        // quick-move from the player inventory, gets the same reset.
    67	        let input_item = if input_lock.is_empty() {
    68	            Item::AIR.id
    69	        } else {
    70	            input_lock.item.id
    71	        };
    72	        if self.last_input_item.swap(input_item, Ordering::Relaxed) != input_item
    73	            && self.selected_recipe.load(Ordering::Relaxed) != u8::MAX
    74	        {
    75	            self.selected_recipe.store(u8::MAX, Ordering::Relaxed);
    76	        }
    77	
    78	        if input_lock.is_empty() {
    79	            self.output_inventory
    80	                .set_stack(0, ItemStack::EMPTY.clone())
    81	                .await;
    82	            self.selected_recipe.store(u8::MAX, Ordering::Relaxed);
    83	            return;
    84	        }
    85	
    86	        let available_recipes = Self::get_available_recipes(&input_lock);
    87	        let recipe_index = self.selected_recipe.load(Ordering::Relaxed);
    88	
    89	        if recipe_index != u8::MAX && (recipe_index as usize) < available_recipes.len() {
    90	            let recipe = available_recipes[recipe_index as usize];
    91	            let item = Item::from_registry_key(recipe.result.id).unwrap_or(&Item::AIR);
    92	            let result = ItemStack::new(recipe.result.count, item);
    93	            self.output_inventory.set_stack(0, result).await;
    94	        } else {
    95	            self.output_inventory
    96	                .set_stack(0, ItemStack::EMPTY.clone())
    97	                .await;
    98	        }
    99	    }
   100	
   101	    async fn select_recipe(&self, id: i32) -> bool {
   102	        if i32::from(self.selected_recipe.load(Ordering::Relaxed)) == id {
   103	            return false;
   104	        }
   105	
   106	        let input_stack = self.input_inventory.get_stack(0).await;
   107	        let recipe_count = Self::get_available_recipes(&input_stack).len();
   108	
   109	        if !(0..recipe_count).contains(&(id as usize)) {
   110	            return false;
   111	        }
   112	
   113	        self.last_input_item
   114	            .store(input_stack.item.id, Ordering::Relaxed);
   115	        self.selected_recipe.store(id as u8, Ordering::Relaxed);
   116	        self.update_output().await;
   117	        true
   118	    }
   119	
   120	    fn get_available_recipes(input: &ItemStack) -> Vec<&'static StonecutterRecipe> {
   121	        let item = input.item;
   122	        RECIPES_STONECUTTING
   123	            .iter()
   124	            .filter(|r| r.ingredient.match_item(item))
   125	            .collect()
   126	    }
   127	}

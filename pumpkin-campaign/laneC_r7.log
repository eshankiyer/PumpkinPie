   297	    #[expect(clippy::too_many_arguments)]
   298	    pub fn update<F>(
   299	        &mut self,
   300	        heightmap_type: ChunkHeightmapType,
   301	        local_x: i32,
   302	        local_y: i32,
   303	        local_z: i32,
   304	        block_state: &BlockState,
   305	        min_y: i32,
   306	        get_block: F,
   307	    ) -> bool
   308	    where
   309	        F: Fn(i32) -> &'static BlockState,
   310	    {
   311	        let first_available = self.get(heightmap_type, local_x, local_z, min_y) + 1;
   312	        if local_y <= first_available - 2 {
   313	            return false;
   314	        }
   315	
   316	        if heightmap_type.is_opaque(block_state) {
   317	            if local_y >= first_available {
   318	                self.set(heightmap_type, local_x, local_z, local_y, min_y);
   319	                return true;
   320	            }
   321	        } else if first_available - 1 == local_y {
   322	            for y in (min_y..local_y).rev() {
   323	                let state = get_block(y);
   324	                if heightmap_type.is_opaque(state) {
   325	                    self.set(heightmap_type, local_x, local_z, y, min_y);
   326	                    return true;
   327	                }
   328	            }
   329	            self.set(heightmap_type, local_x, local_z, min_y - 1, min_y);
   330	            return true;
   331	        }
   332	
   333	        false
   334	    }
   335	}

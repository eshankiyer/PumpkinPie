  1129	    fn heightmap_is_opaque() {
  1130	        use crate::chunk::ChunkHeightmapType;
  1131	
  1132	        let air = Block::AIR.default_state;
  1133	        let stone = Block::STONE.default_state;
  1134	        let leaves = Block::OAK_LEAVES.default_state;
  1135	        let water = Block::WATER.default_state;
  1136	
  1137	        // WORLD_SURFACE: Everything except air
  1138	        assert!(!ChunkHeightmapType::WorldSurface.is_opaque(air));
  1139	        assert!(ChunkHeightmapType::WorldSurface.is_opaque(stone));
  1140	        assert!(ChunkHeightmapType::WorldSurface.is_opaque(leaves));
  1141	        assert!(ChunkHeightmapType::WorldSurface.is_opaque(water));
  1142	
  1143	        // MOTION_BLOCKING: Blocks movement OR is liquid
  1144	        assert!(!ChunkHeightmapType::MotionBlocking.is_opaque(air));
  1145	        assert!(ChunkHeightmapType::MotionBlocking.is_opaque(stone));
  1146	        assert!(ChunkHeightmapType::MotionBlocking.is_opaque(leaves)); // Leaves block movement
  1147	        assert!(ChunkHeightmapType::MotionBlocking.is_opaque(water)); // Water is liquid
  1148	
  1149	        // MOTION_BLOCKING_NO_LEAVES: Blocks movement OR is liquid, but NOT leaves
  1150	        assert!(!ChunkHeightmapType::MotionBlockingNoLeaves.is_opaque(air));
  1151	        assert!(ChunkHeightmapType::MotionBlockingNoLeaves.is_opaque(stone));
  1152	        assert!(!ChunkHeightmapType::MotionBlockingNoLeaves.is_opaque(leaves)); // Excludes leaves
  1153	        assert!(ChunkHeightmapType::MotionBlockingNoLeaves.is_opaque(water)); // Water is liquid
  1154	
  1155	        // OCEAN_FLOOR: blocksMotion only, unlike MOTION_BLOCKING water is NOT counted
  1156	        assert!(!ChunkHeightmapType::OceanFloor.is_opaque(air));
  1157	        assert!(ChunkHeightmapType::OceanFloor.is_opaque(stone));
  1158	        assert!(ChunkHeightmapType::OceanFloor.is_opaque(leaves)); // Leaves block movement
  1159	        assert!(!ChunkHeightmapType::OceanFloor.is_opaque(water)); // Water does not
  1160	    }

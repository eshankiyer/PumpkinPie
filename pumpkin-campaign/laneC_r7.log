   555	    #[allow(clippy::too_many_lines)]
   556	    async fn tick_server(&self, world: &Arc<World>) {
   557	        let state_id = world.get_block_state_id(&self.position);
   558	        let block = Block::from_state_id(state_id);
   559	        if !TrialSpawnerLikeProperties::handles_block_id(block.id) {
   560	            return;
   561	        }
   562	        let mut props = TrialSpawnerLikeProperties::from_state_id(state_id, block);
   563	        let is_ominous = props.ominous;
   564	        let game_time = world.get_world_age().await;
   565	
   566	        if self.untrack_dead_mobs(world).await {
   567	            self.next_mob_spawns_at.store(
   568	                game_time + self.active_config(is_ominous).ticks_between_spawn,
   569	                Ordering::Relaxed,
   570	            );
   571	        }
   572	
   573	        let config = self.active_config(is_ominous).clone();
   574	        let next_state = self
   575	            .tick_state_machine(
   576	                world,
   577	                props.trial_spawner_state,
   578	                is_ominous,
   579	                &config,
   580	                game_time,
   581	            )
   582	            .await;
   583	
   584	        if next_state != props.trial_spawner_state {
   585	            props.trial_spawner_state = next_state;
   586	            let new_state_id = props.to_state_id(block);
   587	            world
   588	                .set_block_state(&self.position, new_state_id, BlockFlags::NOTIFY_ALL)
   589	                .await;
   590	        }
   591	    }

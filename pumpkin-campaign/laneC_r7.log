   671	    /// Determines the mining speed for a block based on tool rules.
   672	    /// Direct matches return immediately, tagged blocks are checked separately.
   673	    /// If no match is found, returns the tool's default mining speed or `1.0`.
   674	    #[must_use]
   675	    pub fn get_speed(&self, block: &'static Block) -> f32 {
   676	        // No tool? Use default speed
   677	        if let Some(tool) = self.get_data_component::<ToolImpl>() {
   678	            for rule in tool.rules.iter() {
   679	                // Skip if speed is not set
   680	                let Some(speed) = rule.speed else {
   681	                    continue;
   682	                };
   683	                match &rule.blocks {
   684	                    IDSet::Tag(tag) => {
   685	                        if block.is_tagged_with(tag).unwrap_or(false) {
   686	                            return speed;
   687	                        }
   688	                    }
   689	                    IDSet::IDs(blocks) => {
   690	                        if blocks.contains(&block) {
   691	                            return speed;
   692	                        }
   693	                    }
   694	                }
   695	            }
   696	            tool.default_mining_speed
   697	        } else {
   698	            1.0
   699	        }
   700	    }

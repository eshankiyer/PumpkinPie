   729	    pub fn write_item_stack(&self, compound: &mut NbtCompound) {
   730	        // Minecraft 1.21.4 uses "id" as string with namespaced ID (minecraft:diamond_sword)
   731	        compound.put_string("id", format!("minecraft:{}", self.item.registry_key));
   732	        compound.put_int("count", self.item_count as i32);
   733	
   734	        // Create a tag compound for additional data
   735	        let mut tag = NbtCompound::new();
   736	
   737	        for (id, data) in &self.patch {
   738	            if let Some(data) = data {
   739	                tag.put(id.to_name(), data.write_data());
   740	            } else {
   741	                let name = '!'.to_string() + id.to_name();
   742	                tag.put(name.as_str(), NbtCompound::new());
   743	            }
   744	        }
   745	
   746	        // Store custom data like enchantments, display name, etc. would go here
   747	        compound.put_compound("components", tag);
   748	    }

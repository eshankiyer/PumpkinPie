  8034	    /// max 128 cached message signatures. Most recent FIRST.
  8035	    /// Server should (when possible) reference indexes in this (recipient's) cache instead of sending full signatures in last seen.
  8036	    /// Must be 1:1 with client's signature cache.
  8037	    full_cache: VecDeque<Box<[u8]>>,
  8038	    /// max 20 last seen messages by the sender. Most Recent LAST
  8039	    pub last_seen: LastSeen,
  8040	    pub last_seen_validator: LastSeenMessagesValidator,

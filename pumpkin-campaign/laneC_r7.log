   180	/// A mutable slice split into three parts: the element at the split index, the start, and the end.
   181	///
   182	/// This allows modifying the selected element while still having access to the surrounding slices.
   183	pub struct MutableSplitSlice<'a, T> {
   184	    /// Elements before the split index.
   185	    start: &'a mut [T],
   186	    /// Elements after the split index.
   187	    end: &'a mut [T],
   188	}
   189	
   190	impl<'a, T> MutableSplitSlice<'a, T> {
   191	    /// Extracts the `index`-th element as a mutable reference along with a `MutableSplitSlice` representing the remaining elements.
   192	    ///
   193	    /// # Panics
   194	    /// * if `index` is out of bounds of the base slice.
   195	    #[allow(clippy::expect_used, clippy::panic)]
   196	    pub const fn extract_ith(base: &'a mut [T], index: usize) -> (&'a mut T, Self) {
   197	        let (start, end_inclusive) = base.split_at_mut(index);
   198	        let Some((value, end)) = end_inclusive.split_first_mut() else {
   199	            panic!("Index is not in base slice");
   200	        };
   201	
   202	        (value, Self { start, end })
   203	    }
   204	
   205	    /// Returns the total number of elements in the split slice (start + removed element + end).
   206	    #[must_use]
   207	    pub const fn len(&self) -> usize {
   208	        self.start.len() + self.end.len() + 1
   209	    }
   210	
   211	    /// Returns `false` since the split slice always contains at least the removed element.
   212	    #[must_use]
   213	    pub const fn is_empty(&self) -> bool {
   214	        false
   215	    }
   216	}

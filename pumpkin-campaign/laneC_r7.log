   469	    // TrialSpawner.java:161-234, simplified: no custom spawn rules / equipment /
   470	    // line-of-sight clip check (only collision + spawn placement rules kept)
   471	    async fn spawn_mob(&self, world: &Arc<World>, config: &TrialSpawnerConfig) -> Option<Uuid> {
   472	        let (entity_type, spawn_data) = self.get_or_create_next_spawn_data(config).await?;
   473	        let pos = self.position.0;
   474	        let spawn_range = f64::from(config.spawn_range);
   475	        let spawn_pos = pumpkin_util::math::vector3::Vector3::new(
   476	            pos.x as f64 + (rand::random::<f64>() - rand::random::<f64>()) * spawn_range + 0.5,
   477	            (pos.y + rand::random_range(0..3) - 1) as f64,
   478	            pos.z as f64 + (rand::random::<f64>() - rand::random::<f64>()) * spawn_range + 0.5,
   479	        );
   480	        if !world.is_space_empty(BoundingBox::new_from_pos(
   481	            spawn_pos.x,
   482	            spawn_pos.y,
   483	            spawn_pos.z,
   484	            &EntityDimensions {
   485	                width: entity_type.dimension[0],
   486	                height: entity_type.dimension[1],
   487	                eye_height: entity_type.eye_height,
   488	                fixed: false,
   489	            },
   490	        )) {
   491	            return None;
   492	        }
   493	        if !custom_spawn_rules_allow(
   494	            world,
   495	            &BlockPos::floored(spawn_pos.x, spawn_pos.y, spawn_pos.z),
   496	            &spawn_data,
   497	        ) {
   498	            return None;
   499	        }
   500	        let uuid = uuid::Uuid::new_v4();
   501	        let entity = crate::entity::r#type::from_type(entity_type, spawn_pos, world, uuid);
   502	        if let Some(entity_nbt) = spawn_data.get_compound("entity") {
   503	            if let Some(living) = entity.get_living_entity() {
   504	                living.read_nbt_non_mut(entity_nbt).await;
   505	            } else {
   506	                entity.get_entity().read_nbt_non_mut(entity_nbt).await;
   507	            }
   508	            entity.read_nbt_non_mut(entity_nbt).await;
   509	        }
   510	        world.spawn_entity(entity).await;
   511	        world.sync_world_event(
   512	            WorldEvent::ParticlesTrialSpawnerSpawnMobAt,
   513	            BlockPos::floored(spawn_pos.x, spawn_pos.y, spawn_pos.z),
   514	            0,
   515	        );
   516	        let mut next = self.next_spawn_entity.lock().unwrap();
   517	        let mut next_data = self.next_spawn_data.lock().unwrap();
   518	        if let Some((next_entity, spawn_data)) = config.pick_random_spawn_data() {
   519	            *next = Some(next_entity);
   520	            *next_data = Some(spawn_data);
   521	        } else {
   522	            *next = None;
   523	            *next_data = None;
   524	        }
   525	        Some(uuid)
   526	    }

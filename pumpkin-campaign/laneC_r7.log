   208	impl EntityBase for OminousItemSpawnerEntity {
   209	    /// `OminousItemSpawner.tick` / `tickServer` (`OminousItemSpawner.java:44-63`).
   210	    /// The client half (`tickClient` `:65-69` and `addParticles` `:153-172`) is
   211	    /// client-side only and has no server counterpart.
   212	    fn tick<'a>(
   213	        &'a self,
   214	        caller: &'a Arc<dyn EntityBase>,
   215	        server: &'a Server,
   216	    ) -> EntityBaseFuture<'a, ()> {
   217	        Box::pin(async move {
   218	            // `super.tick()` first: vanilla increments `tickCount` inside it,
   219	            // before `tickServer` compares against it.
   220	            self.entity.tick(caller, server).await;
   221	            let tick_count = self.tick_count.fetch_add(1, Relaxed) + 1;
   222	            let spawn_item_after_ticks = self.spawn_item_after_ticks.load(Relaxed);
   223	
   224	            if tick_count == Self::about_to_spawn_sound_tick(spawn_item_after_ticks) {
   225	                // `level.playSound(null, blockPosition(), ..)` centers on the block.
   226	                self.entity.world.load().play_sound(
   227	                    Sound::BlockTrialSpawnerAboutToSpawnItem,
   228	                    SoundCategory::Neutral,
   229	                    &self.entity.block_pos.load().to_centered_f64(),
   230	                );
   231	            }
   232	
   233	            if tick_count >= spawn_item_after_ticks {
   234	                self.spawn_item().await;
   235	                // `kill(level)` (`OminousItemSpawner.java:61`) is
   236	                // `Entity.kill` (`Entity.java:405-408`): remove, then fire
   237	                // `GameEvent.ENTITY_DIE` with this entity as the source. The
   238	                // default `EntityBase::kill` for non-living entities only
   239	                // removes, so the event is emitted here.
   240	                let world = self.entity.world.load();
   241	                let pos = self.entity.pos.load();
   242	                self.entity.remove().await;
   243	                emit_game_event(
   244	                    &world,
   245	                    GameEvent::EntityDie,
   246	                    pos,
   247	                    GameEventContext::of_entity(caller.clone()),
   248	                )
   249	                .await;
   250	            }
   251	        })
   252	    }
   253	
   254	    fn init_data_tracker(&self) -> EntityBaseFuture<'_, ()> {
   255	        Box::pin(async {
   256	            self.entity.send_meta_data(
   257	                &[Metadata::new(
   258	                    pumpkin_data::tracked_data::ominous_item_spawner::ITEM,
   259	                    &ItemStackSerializer::from(self.item.lock().await.clone()),
   260	                )],
   261	                None,
   262	            );
   263	        })
   264	    }
   265	
   266	    /// `Entity.kill` (`Entity.java:405-408`): remove, then fire
   267	    /// `GameEvent.ENTITY_DIE`. The non-living default in `EntityBase::kill`
   268	    /// only removes, so an outside kill would otherwise skip the event.
   269	    fn kill<'a>(&'a self, _caller: &'a dyn EntityBase) -> EntityBaseFuture<'a, ()> {
   270	        Box::pin(async move {
   271	            let world = self.entity.world.load();
   272	            let pos = self.entity.pos.load();
   273	            self.entity.remove().await;
   274	            // No `Arc<dyn EntityBase>` available here, as in `ArmorStandEntity::kill`.
   275	            emit_game_event(&world, GameEvent::EntityDie, pos, GameEventContext::none()).await;
   276	        })
   277	    }

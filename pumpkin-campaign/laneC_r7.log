    14	pub struct MapItem;
    15	
    16	impl ItemMetadata for MapItem {
    17	    fn ids() -> Box<[u16]> {
    18	        [Item::MAP.id].into()
    19	    }
    20	}
    21	
    22	impl ItemBehaviour for MapItem {
    23	    fn normal_use<'a>(
    24	        &'a self,
    25	        _item: &'a Item,
    26	        player: &'a Player,
    27	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    28	        Box::pin(async move {
    29	            let Some(server) = player.world().server.upgrade() else {
    30	                return;
    31	            };
    32	
    33	            let inventory = player.inventory();
    34	            let held_stack = inventory.held_item().await;
    35	            let (found, mut hand_stack, hand) =
    36	                if !held_stack.is_empty() && held_stack.item.id == Item::MAP.id {
    37	                    (true, held_stack, pumpkin_util::Hand::Right)
    38	                } else {
    39	                    let off_hand = inventory.off_hand_item().await;
    40	                    if !off_hand.is_empty() && off_hand.item.id == Item::MAP.id {
    41	                        (true, off_hand, pumpkin_util::Hand::Left)
    42	                    } else {
    43	                        (false, held_stack, pumpkin_util::Hand::Right)
    44	                    }
    45	                };
    46	
    47	            if found {
    48	                let map_id = server.next_map_id();
    49	                let _ = server.map_manager.create_map(
    50	                    map_id,
    51	                    player.world().dimension.clone(),
    52	                    player.position().x as i32,
    53	                    player.position().z as i32,
    54	                    0, // Default scale
    55	                );
    56	
    57	                let mut filled_map = ItemStack::new(1, &Item::FILLED_MAP);
    58	                filled_map.patch.push((
    59	                    DataComponent::MapId,
    60	                    Some(MapIdImpl { id: map_id }.to_dyn()),
    61	                ));
    62	
    63	                let gamemode = player.gamemode.load();
    64	                if hand_stack.item_count == 1 && gamemode != GameMode::Creative {
    65	                    inventory.set_stack_in_hand(hand, filled_map).await;
    66	                } else {
    67	                    hand_stack.decrement_unless_creative(gamemode, 1);
    68	                    inventory.set_stack_in_hand(hand, hand_stack).await;
    69	                    inventory.offer_or_drop_stack(filled_map, player).await;
    70	                }
    71	            }
    72	        })
    73	    }
    74	
    75	    fn as_any(&self) -> &dyn Any {
    76	        self
    77	    }
    78	}

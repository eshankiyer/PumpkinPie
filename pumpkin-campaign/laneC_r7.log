    19	
    20	pub static STRUCTURE_REGISTRY: Identifier = Identifier::vanilla_static("worldgen/structure");
    21	pub static POI_REGISTRY: Identifier = Identifier::vanilla_static("point_of_interest_type");
    22	
    23	pub static ERROR_UNKNOWN_RESOURCE: CommandErrorType<2> = CommandErrorType::new(
    24	    translation::java::ARGUMENT_RESOURCE_NOT_FOUND,
    25	    translation::java::ARGUMENT_RESOURCE_NOT_FOUND,
    26	);
    27	
    28	pub static ERROR_UNKNOWN_TAG: CommandErrorType<2> = CommandErrorType::new(
    29	    translation::java::ARGUMENT_RESOURCE_TAG_NOT_FOUND,
    30	    translation::java::ARGUMENT_RESOURCE_TAG_NOT_FOUND,
    31	);
    32	
    33	/// A parsed reference to either a single registry entry or a `#`-prefixed tag
    34	/// of entries, as produced by [`ResourceOrTagKeyArgument`] and
    35	/// [`ResourceOrTagArgument`].
    36	#[derive(Debug, Clone)]
    37	pub enum ResourceOrTag {
    38	    Resource(Identifier),
    39	    Tag(Identifier),
    40	}
    41	
    42	impl ResourceOrTag {
    43	    /// The user-facing form of this reference (vanilla's `asPrintable`):
    44	    /// `namespace:path` for entries, `#namespace:path` for tags.
    45	    #[must_use]
    46	    pub fn printable(&self) -> String {
    47	        match self {
    48	            Self::Resource(id) => id.to_string(),
    49	            Self::Tag(id) => format!("#{id}"),
    50	        }
    51	    }
    52	
    53	    fn from_string_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
    54	        if reader.peek() == Some('#') {
    55	            reader.skip();
    56	            Ok(Self::Tag(Identifier::from_reader(reader)?))
    57	        } else {
    58	            Ok(Self::Resource(Identifier::from_reader(reader)?))
    59	        }
    60	    }
    61	}
    62	
    63	/// Registry-aware suggestions shared by both argument types: the known entry
    64	/// ids plus, when tag data exists for the registry, its `#`-prefixed tags.
    65	fn suggest_for_registry(registry: &Identifier, builder: SuggestionsBuilder) -> Suggestions {
    66	    let tag_names = |key: RegistryKey| {
    67	        tag::get_latest_map(key)
    68	            .into_iter()
    69	            .flat_map(|map| map.keys().map(|tag| format!("#{tag}")))
    70	    };
    71	
    72	    if *registry == STRUCTURE_REGISTRY {
    73	        // The generator models vanilla's structure sets, so those are the
    74	        // locatable names. There is no structure tag data to offer.
    75	        builder
    76	            .filter_and_suggest_iter(
    77	                StructureSet::NAMES
    78	                    .iter()
    79	                    .map(|name| format!("minecraft:{name}")),
    80	            )
    81	            .build()
    82	    } else if *registry == *BIOME_REGISTRY {
    83	        let biomes = pumpkin_data::biome::Biome::ALL
    84	            .iter()
    85	            .map(|biome| format!("minecraft:{}", biome.registry_id));
    86	        builder
    87	            .filter_and_suggest_iter(biomes.chain(tag_names(RegistryKey::WorldgenBiome)))
    88	            .build()
    89	    } else if *registry == POI_REGISTRY {
    90	        // There is no generated POI type registry (yet), so offer the types
    91	        // known from tag data plus the ones the server actually creates.
    92	        let mut names: BTreeSet<String> = tag::get_latest_map(RegistryKey::PointOfInterestType)
    93	            .into_iter()
    94	            .flat_map(|map| map.values().flat_map(|tag| tag.0.iter()))
    95	            .map(|name| format!("minecraft:{name}"))
    96	            .collect();
    97	        names.insert(POI_TYPE_NETHER_PORTAL.to_string());
    98	        builder
    99	            .filter_and_suggest_iter(
   100	                names
   101	                    .into_iter()
   102	                    .chain(tag_names(RegistryKey::PointOfInterestType)),
   103	            )
   104	            .build()
   105	    } else {
   106	        Suggestions::empty()
   107	    }
   108	}
   109	
   110	/// An argument type that parses an entry id or `#`-tag of a registry.
   111	///
   112	/// The value is not validated against the registry, like vanilla's
   113	/// `ResourceOrTagKeyArgument`; resolution (and the matching error) is left to
   114	/// the command.
   115	pub struct ResourceOrTagKeyArgument(pub Identifier);
   116	
   117	impl ArgumentType for ResourceOrTagKeyArgument {
   118	    type Item = ResourceOrTag;
   119	
   120	    fn parse(&self, reader: &mut StringReader) -> Result<Self::Item, CommandSyntaxError> {
   121	        ResourceOrTag::from_string_reader(reader)
   122	    }
   123	
   124	    fn list_suggestions<'a>(
   125	        &'a self,
   126	        _context: &'a CommandContext,
   127	        builder: SuggestionsBuilder,
   128	    ) -> Pin<Box<dyn Future<Output = Suggestions> + Send + 'a>> {
   129	        Box::pin(async move { suggest_for_registry(&self.0, builder) })
   130	    }
   131	
   132	    fn client_side_parser(&'_ self) -> JavaClientArgumentType {
   133	        JavaClientArgumentType::ResourceOrTagKey {
   134	            identifier: self.0.clone(),
   135	        }
   136	    }
   137	
   138	    fn examples(&self) -> Vec<String> {
   139	        examples!("foo", "foo:bar", "#foo")
   140	    }
   141	}
   142	
   143	/// An argument type that parses and validates an entry id or `#`-tag of a
   144	/// registry.
   145	///
   146	/// Validation happens at parse time where registry data is available, like
   147	/// vanilla's `ResourceOrTagArgument`: it currently covers biome ids and the
   148	/// tags of every registry with generated tag data; ids of registries without
   149	/// generated entry data (such as POI types) are accepted as-is.
   150	pub struct ResourceOrTagArgument(pub Identifier);
   151	
   152	impl ArgumentType for ResourceOrTagArgument {
   153	    type Item = ResourceOrTag;
   154	
   155	    fn parse(&self, reader: &mut StringReader) -> Result<Self::Item, CommandSyntaxError> {
   156	        let value = ResourceOrTag::from_string_reader(reader)?;
   157	
   158	        match &value {
   159	            ResourceOrTag::Resource(id) => {
   160	                if self.0 == *BIOME_REGISTRY
   161	                    && !(id.is_vanilla()
   162	                        && pumpkin_data::biome::Biome::from_name(id.path()).is_some())
   163	                {
   164	                    return Err(ERROR_UNKNOWN_RESOURCE.create_without_context(
   165	                        TextComponent::text(id.to_string()),
   166	                        TextComponent::text(self.0.to_string()),
   167	                    ));
   168	                }
   169	            }
   170	            ResourceOrTag::Tag(id) => {
   171	                let registry_key = if self.0 == *BIOME_REGISTRY {
   172	                    Some(RegistryKey::WorldgenBiome)
   173	                } else if self.0 == POI_REGISTRY {
   174	                    Some(RegistryKey::PointOfInterestType)
   175	                } else {
   176	                    None
   177	                };
   178	
   179	                if let Some(key) = registry_key
   180	                    && tag::get_tag_values(key, &id.to_string()).is_none()
   181	                {
   182	                    return Err(ERROR_UNKNOWN_TAG.create_without_context(
   183	                        TextComponent::text(id.to_string()),
   184	                        TextComponent::text(self.0.to_string()),
   185	                    ));
   186	                }
   187	            }
   188	        }
   189	
   190	        Ok(value)
   191	    }
   192	
   193	    fn list_suggestions<'a>(
   194	        &'a self,
   195	        _context: &'a CommandContext,
   196	        builder: SuggestionsBuilder,
   197	    ) -> Pin<Box<dyn Future<Output = Suggestions> + Send + 'a>> {
   198	        Box::pin(async move { suggest_for_registry(&self.0, builder) })
   199	    }
   200	
   201	    fn client_side_parser(&'_ self) -> JavaClientArgumentType {
   202	        JavaClientArgumentType::ResourceOrTag {
   203	            identifier: self.0.clone(),
   204	        }
   205	    }
   206	
   207	    fn examples(&self) -> Vec<String> {
   208	        examples!("foo", "foo:bar", "#foo")
   209	    }
   210	}

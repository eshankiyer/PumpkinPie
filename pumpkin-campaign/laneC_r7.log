    33	/// A parsed reference to either a single registry entry or a `#`-prefixed tag
    34	/// of entries, as produced by [`ResourceOrTagKeyArgument`] and
    35	/// [`ResourceOrTagArgument`].
    36	#[derive(Debug, Clone)]
    37	pub enum ResourceOrTag {
    38	    Resource(Identifier),
    39	    Tag(Identifier),
    40	}
    41	
    42	impl ResourceOrTag {
    43	    /// The user-facing form of this reference (vanilla's `asPrintable`):
    44	    /// `namespace:path` for entries, `#namespace:path` for tags.
    45	    #[must_use]
    46	    pub fn printable(&self) -> String {
    47	        match self {
    48	            Self::Resource(id) => id.to_string(),
    49	            Self::Tag(id) => format!("#{id}"),
    50	        }
    51	    }
    52	
    53	    fn from_string_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
    54	        if reader.peek() == Some('#') {
    55	            reader.skip();
    56	            Ok(Self::Tag(Identifier::from_reader(reader)?))
    57	        } else {
    58	            Ok(Self::Resource(Identifier::from_reader(reader)?))
    59	        }
    60	    }
    61	}
    62	
    63	/// Registry-aware suggestions shared by both argument types: the known entry
    64	/// ids plus, when tag data exists for the registry, its `#`-prefixed tags.
    65	fn suggest_for_registry(registry: &Identifier, builder: SuggestionsBuilder) -> Suggestions {
    66	    let tag_names = |key: RegistryKey| {
    67	        tag::get_latest_map(key)
    68	            .into_iter()
    69	            .flat_map(|map| map.keys().map(|tag| format!("#{tag}")))
    70	    };
    71	
    72	    if *registry == STRUCTURE_REGISTRY {
    73	        // The generator models vanilla's structure sets, so those are the
    74	        // locatable names. There is no structure tag data to offer.
    75	        builder
    76	            .filter_and_suggest_iter(
    77	                StructureSet::NAMES
    78	                    .iter()
    79	                    .map(|name| format!("minecraft:{name}")),
    80	            )
    81	            .build()
    82	    } else if *registry == *BIOME_REGISTRY {
    83	        let biomes = pumpkin_data::biome::Biome::ALL
    84	            .iter()
    85	            .map(|biome| format!("minecraft:{}", biome.registry_id));
    86	        builder
    87	            .filter_and_suggest_iter(biomes.chain(tag_names(RegistryKey::WorldgenBiome)))
    88	            .build()
    89	    } else if *registry == POI_REGISTRY {
    90	        // There is no generated POI type registry (yet), so offer the types
    91	        // known from tag data plus the ones the server actually creates.
    92	        let mut names: BTreeSet<String> = tag::get_latest_map(RegistryKey::PointOfInterestType)
    93	            .into_iter()
    94	            .flat_map(|map| map.values().flat_map(|tag| tag.0.iter()))
    95	            .map(|name| format!("minecraft:{name}"))
    96	            .collect();
    97	        names.insert(POI_TYPE_NETHER_PORTAL.to_string());
    98	        builder
    99	            .filter_and_suggest_iter(
   100	                names
   101	                    .into_iter()
   102	                    .chain(tag_names(RegistryKey::PointOfInterestType)),
   103	            )
   104	            .build()
   105	    } else {
   106	        Suggestions::empty()
   107	    }
   108	}

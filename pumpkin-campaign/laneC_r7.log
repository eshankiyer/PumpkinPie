   201	    fn quick_move<'a>(
   202	        &'a mut self,
   203	        player: &'a dyn InventoryPlayer,
   204	        slot_index: i32,
   205	    ) -> ScreenHandlerFuture<'a, ItemStack> {
   206	        Box::pin(async move {
   207	            let mut stack = ItemStack::EMPTY.clone();
   208	            let slot = self.get_behaviour().slots.get(slot_index as usize).cloned();
   209	
   210	            if let Some(slot) = slot {
   211	                let mut slot_stack = slot.get_cloned_stack().await;
   212	                if !slot_stack.is_empty() {
   213	                    stack = slot_stack.clone();
   214	                    if slot_index < 2 {
   215	                        // From Stonecutter to Player
   216	                        if !self.insert_item(&mut slot_stack, 2, 38, true).await {
   217	                            return ItemStack::EMPTY.clone();
   218	                        }
   219	                        slot.on_quick_move_crafted(slot_stack.clone(), stack.clone())
   220	                            .await;
   221	                    } else {
   222	                        // From Player to Stonecutter
   223	                        // `StonecutterMenu.quickMoveStack` only routes items accepted
   224	                        // by the stonecutter recipe manager to the input slot
   225	                        // (StonecutterMenu.java:198-201).
   226	                        if Self::get_available_recipes(&slot_stack).is_empty() {
   227	                            return ItemStack::EMPTY.clone();
   228	                        }
   229	                        if !self.insert_item(&mut slot_stack, 0, 1, false).await {
   230	                            return ItemStack::EMPTY.clone();
   231	                        }
   232	                    }
   233	
   234	                    let moved_count = stack.item_count - slot_stack.item_count;
   235	                    if slot_stack.is_empty() {
   236	                        slot.set_stack(ItemStack::EMPTY.clone()).await;
   237	                    } else {
   238	                        slot.set_stack(slot_stack).await;
   239	                    }
   240	
   241	                    if slot_index == 1 {
   242	                        let mut taken_stack = stack.clone();
   243	                        taken_stack.set_count(moved_count);
   244	                        slot.on_take_item(player, &taken_stack).await;
   245	                        self.update_output().await;
   300	                    stack.item.id as i32,
   301	                    stack.item_count as i32,
   302	                )
   303	                .await;
   304	            self.input_inventory.remove_stack_specific(0, 1).await;
   305	            self.mark_dirty().await;
   306	            player.play_sound(Sound::UiStonecutterTakeResult).await;
   307	        })
   308	    }

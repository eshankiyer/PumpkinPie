   169	                            .from_properties(&properties)
   170	                            .to_state_id(Block::from_state_id(block_state.id)),
   171	                    )
   172	                })
   173	        } else {
   174	            block_state
   175	        };
   176	        chunk.set_block_state(&pos.0, foliage_state);
   177	        true
   178	    }

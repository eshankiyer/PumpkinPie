   512	            let behaviour = self.get_behaviour_mut();
   513	
   514	            // Lock and clone are performed inside the async block
   515	            let mut cursor_stack_lock = behaviour.cursor_stack.lock().await;
   516	
   517	            if !cursor_stack_lock.is_empty() {
   518	                offer_or_drop_stack(player, cursor_stack_lock.clone()).await;
   519	                *cursor_stack_lock = ItemStack::EMPTY.clone();
   520	            }
   521	        })

   353	/// The main trait for container screen handlers.
   354	///
   355	/// Screen handlers manage the server-side state of container UIs like chests,
   356	/// furnaces, crafting tables, etc. They handle:
   357	/// - Slot layout and management
   358	/// - Click processing
   359	/// - Item transfer logic (shift-click)
   360	/// - Client synchronization
   361	///
   362	/// # Implementation
   363	///
   364	/// Implementors must provide:
   365	/// - [`get_behaviour`](ScreenHandler::get_behaviour) and [`get_behaviour_mut`](ScreenHandler::get_behaviour_mut)
   366	/// - [`quick_move`](ScreenHandler::quick_move) for shift-click behavior
   367	/// - [`as_any`](ScreenHandler::as_any) for downcasting
   368	// ScreenHandler.java
   369	// TODO: Fully implement this
   370	pub trait ScreenHandler: Send + Sync {
   371	    // --- Synchronous Methods ---
   372	
   373	    /// Gets the window type for this screen handler.
   374	    fn window_type(&self) -> Option<WindowType> {
   375	        self.get_behaviour().window_type
   376	    }
   377	
   378	    /// Returns this screen handler as an Any reference.
   379	    fn as_any(&self) -> &dyn Any;
   380	
   381	    /// Returns this screen handler as a mutable Any reference.
   382	    fn as_any_mut(&mut self) -> &mut dyn Any;
   383	
   384	    /// Gets the sync ID for this screen handler.
   385	    fn sync_id(&self) -> u8 {
   386	        self.get_behaviour().sync_id
   387	    }

   158	impl FromStringReader for IntBounds {
   159	    fn from_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
   160	        let i = reader.cursor();
   161	        let bounds = bounds_from_reader(reader, &READER_INVALID_INT)?;
   162	        if bounds.are_swapped() {
   163	            reader.set_cursor(i);
   164	            Err(SWAPPED_BOUNDS_ERROR_TYPE.create(reader))
   165	        } else {
   166	            Ok(Self::from_bounds(bounds))
   167	        }
   168	    }
   169	}

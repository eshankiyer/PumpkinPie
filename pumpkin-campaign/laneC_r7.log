   259	   private static class Vec3iWaypoint extends TrackedWaypoint {
   260	      private Vec3i vector;
   261	
   262	      public Vec3iWaypoint(final UUID identifier, final Waypoint.Icon icon, final Vec3i vector) {
   263	         super(Either.left(identifier), icon, TrackedWaypoint.Type.VEC3I);
   264	         this.vector = vector;
   265	      }
   266	
   267	      public Vec3iWaypoint(final Either<UUID, String> identifier, final Waypoint.Icon icon, final FriendlyByteBuf byteBuf) {
   268	         super(identifier, icon, TrackedWaypoint.Type.VEC3I);
   269	         this.vector = new Vec3i(byteBuf.readVarInt(), byteBuf.readVarInt(), byteBuf.readVarInt());
   270	      }
   271	
   272	      @Override
   273	      public void update(final TrackedWaypoint other) {
   274	         if (other instanceof TrackedWaypoint.Vec3iWaypoint vec3iWaypoint) {
   275	            this.vector = vec3iWaypoint.vector;
   276	         } else {
   277	            TrackedWaypoint.LOGGER.warn("Unsupported Waypoint update operation: {}", other.getClass());
   278	         }
   279	      }
   280	
   281	      @Override
   282	      public void writeContents(final ByteBuf buf) {
   283	         VarInt.write(buf, this.vector.getX());
   284	         VarInt.write(buf, this.vector.getY());
   285	         VarInt.write(buf, this.vector.getZ());
   286	      }
   287	
   288	      private Vec3 position(final Level level, final PartialTickSupplier partialTick) {
   289	         return this.identifier
   290	            .left()
   291	            .map(level::getEntity)
   292	            .map(e -> e.blockPosition().distManhattan(this.vector) > 3 ? null : e.getEyePosition(partialTick.apply(e)))
   293	            .orElseGet(() -> Vec3.atCenterOf(this.vector));
   294	      }
   295	
   296	      @Override
   297	      public double yawAngleToCamera(final Level level, final TrackedWaypoint.Camera camera, final PartialTickSupplier partialTickSupplier) {
   298	         Vec3 direction = camera.position().subtract(this.position(level, partialTickSupplier)).rotateClockwise90();
   299	         float waypointAngle = (float)Mth.atan2(direction.z(), direction.x()) * (180.0F / (float)Math.PI);
   300	         return Mth.degreesDifference(camera.yaw(), waypointAngle);
   301	      }
   302	
   303	      @Override
   304	      public TrackedWaypoint.PitchDirection pitchDirectionToCamera(
   305	         final Level level, final TrackedWaypoint.Projector projector, final PartialTickSupplier partialTickSupplier
   306	      ) {
   307	         Vec3 pointOnScreen = projector.projectPointToScreen(this.position(level, partialTickSupplier));
   308	         boolean isBehindCamera = pointOnScreen.z > 1.0;
   309	         double yInFrontOfCamera = isBehindCamera ? -pointOnScreen.y : pointOnScreen.y;
   310	         if (yInFrontOfCamera < -1.0) {
   311	            return TrackedWaypoint.PitchDirection.DOWN;
   312	         }
   313	
   314	         if (yInFrontOfCamera > 1.0) {
   315	            return TrackedWaypoint.PitchDirection.UP;
   316	         }
   317	
   318	         if (isBehindCamera) {
   319	            if (pointOnScreen.y > 0.0) {
   320	               return TrackedWaypoint.PitchDirection.UP;
   321	            }
   322	
   323	            if (pointOnScreen.y < 0.0) {
   324	               return TrackedWaypoint.PitchDirection.DOWN;
   325	            }
   326	         }
   327	
   328	         return TrackedWaypoint.PitchDirection.NONE;
   329	      }

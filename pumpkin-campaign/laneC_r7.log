   738	fn custom_spawn_rules_allow(world: &World, pos: &BlockPos, spawn_data: &NbtCompound) -> bool {
   739	    let Some(rules) = spawn_data.get_compound("custom_spawn_rules") else {
   740	        return true;
   741	    };
   742	
   743	    let in_range = |name: &str, value: u8| {
   744	        let Some(range) = rules.get_compound(name) else {
   745	            return true;
   746	        };
   747	        let min = range.get_int("min_inclusive").unwrap_or(0).clamp(0, 15) as u8;
   748	        let max = range.get_int("max_inclusive").unwrap_or(15).clamp(0, 15) as u8;
   749	        (min..=max).contains(&value)
   750	    };
   751	
   752	    in_range(
   753	        "block_light_limit",
   754	        world.get_block_light_level(pos).unwrap_or(0),
   755	    ) && in_range(
   756	        "sky_light_limit",
   757	        world
   758	            .get_sky_light_level(pos)
   759	            .saturating_sub(world.sky_darken.load(Ordering::Relaxed)),
   760	    )
  1000	                return None;
  1001	            };
  1002	            Some(Uuid::from_u128(
  1003	                ((a as u32 as u128) << 96)
  1004	                    | ((b as u32 as u128) << 64)
  1005	                    | ((c as u32 as u128) << 32)
  1006	                    | (d as u32 as u128),
  1007	            ))
  1008	        })
  1009	        .collect()
  1010	}
  1011	
  1012	fn uuid_to_int_array(u: Uuid) -> NbtTag {
  1013	    let v = u.as_u128();
  1014	    NbtTag::IntArray(vec![
  1015	        (v >> 96) as i32,
  1016	        ((v >> 64) & 0xFFFF_FFFF) as i32,
  1017	        ((v >> 32) & 0xFFFF_FFFF) as i32,
  1018	        (v & 0xFFFF_FFFF) as i32,
  1019	    ])
  1020	}

   143	/// An argument type that parses and validates an entry id or `#`-tag of a
   144	/// registry.
   145	///
   146	/// Validation happens at parse time where registry data is available, like
   147	/// vanilla's `ResourceOrTagArgument`: it currently covers biome ids and the
   148	/// tags of every registry with generated tag data; ids of registries without
   149	/// generated entry data (such as POI types) are accepted as-is.
   150	pub struct ResourceOrTagArgument(pub Identifier);
   151	
   152	impl ArgumentType for ResourceOrTagArgument {
   153	    type Item = ResourceOrTag;
   154	
   155	    fn parse(&self, reader: &mut StringReader) -> Result<Self::Item, CommandSyntaxError> {
   156	        let value = ResourceOrTag::from_string_reader(reader)?;
   157	
   158	        match &value {
   159	            ResourceOrTag::Resource(id) => {
   160	                if self.0 == *BIOME_REGISTRY
   161	                    && !(id.is_vanilla()
   162	                        && pumpkin_data::biome::Biome::from_name(id.path()).is_some())
   163	                {
   164	                    return Err(ERROR_UNKNOWN_RESOURCE.create_without_context(
   165	                        TextComponent::text(id.to_string()),
   166	                        TextComponent::text(self.0.to_string()),
   167	                    ));
   168	                }
   169	            }
   170	            ResourceOrTag::Tag(id) => {
   171	                let registry_key = if self.0 == *BIOME_REGISTRY {
   172	                    Some(RegistryKey::WorldgenBiome)
   173	                } else if self.0 == POI_REGISTRY {
   174	                    Some(RegistryKey::PointOfInterestType)
   175	                } else {
   176	                    None
   177	                };
   178	
   179	                if let Some(key) = registry_key
   180	                    && tag::get_tag_values(key, &id.to_string()).is_none()
   181	                {
   182	                    return Err(ERROR_UNKNOWN_TAG.create_without_context(
   183	                        TextComponent::text(id.to_string()),
   184	                        TextComponent::text(self.0.to_string()),
   185	                    ));
   186	                }
   187	            }
   188	        }
   189	
   190	        Ok(value)
   191	    }

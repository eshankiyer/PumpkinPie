    83	    pub async fn generate(&self, world: &Arc<World>, levels: i32, keep_jigsaws: bool) {
    84	        let pool = self.pool.lock().await.clone();
    85	        let target = self.target.lock().await.clone();
    86	
    87	        let block_state = world.get_block_state(&self.position);
    88	        let props =
    89	            JigsawLikeProperties::from_state_id(block_state.id, &pumpkin_data::Block::JIGSAW);
    90	        let front = JigsawBlock::get_front_facing(props.r#orientation);
    91	
    92	        let position = self.position.offset(front.to_offset());
    93	
    94	        let structure = {
    95	            let mut context = StructureGeneratorContext {
    96	                seed: world.level_info.load().world_gen_settings.seed,
    97	                chunk_x: position.chunk_position().x,
    98	                chunk_z: position.chunk_position().y,
    99	                random: RandomGenerator::Xoroshiro(Xoroshiro::from_seed(rand::rng().next_u64())),
   100	                sea_level: 63,
   101	                min_y: -64,
   102	                height_sampler: None,
   103	                structure_key: None,
   104	            };
   105	
   106	            JigsawPlacement::add_pieces(
   107	                &mut context,
   108	                &pool,
   109	                Some(&target),
   110	                levels,
   111	                position,
   112	                false,
   113	                false,
   114	                &MaxDistance::new(128),
   115	                DimensionPadding::ZERO,
   116	                LiquidSettings::ApplyWaterlog,
   117	                &PoolAliasLookup::default(),
   118	            )
   119	        };
   120	
   121	        if let Some(structure) = structure {
   122	            self.place_structure(world, structure, keep_jigsaws).await;
   123	        }
   124	    }
   125	
   126	    async fn place_structure(
   127	        &self,
   128	        world: &Arc<World>,
   129	        structure: StructurePosition,
   130	        keep_jigsaws: bool,
   131	    ) {
   132	        let mut pieces = std::mem::take(
   133	            &mut structure
   134	                .collector
   135	                .lock()
   136	                .unwrap_or_else(std::sync::PoisonError::into_inner)
   137	                .pieces,
   138	        );
   139	        let mut placer = crate::world::block_placer::WorldBlockPlacer::new(world);
   140	        for piece in &mut pieces {
   141	            if let Some(pool_piece) = piece.as_any().downcast_ref::<PoolElementStructurePiece>() {
   142	                pumpkin_world::generation::structure::structures::jigsaw::place_pool_element_templates(
   143	                    pool_piece,
   144	                    &mut placer,
   145	                    None,
   146	                    keep_jigsaws,
   147	                );
   148	            }
   149	        }
   150	        placer.finalize();
   151	        world.queue_block_updates(&placer.changed_positions).await;
   152	        world.flush_block_updates().await;
   153	    }
   154	}

   704	    #[must_use]
   705	    pub fn is_correct_for_drops(&self, block: &'static Block) -> bool {
   706	        if let Some(tool) = self.get_data_component::<ToolImpl>() {
   707	            for rule in tool.rules.iter() {
   708	                // Skip if speed is not set
   709	                let Some(correct) = rule.correct_for_drops else {
   710	                    continue;

    89	        if recipe_index != u8::MAX && (recipe_index as usize) < available_recipes.len() {
    90	            let recipe = available_recipes[recipe_index as usize];
    91	            let item = Item::from_registry_key(recipe.result.id).unwrap_or(&Item::AIR);

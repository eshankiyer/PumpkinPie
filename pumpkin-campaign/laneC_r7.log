   289	                            Self::LID_ANIMATION_EVENT_TYPE,
   290	                            new as u8,
   291	                        )
   292	                        .await;
   293	
   294	                    // Update neighbors for redstone signal when viewer count changes
   295	                    // This is controlled by the EMITS_REDSTONE constant on the struct
   296	                    if Self::EMITS_REDSTONE && old != new {
   297	                        // Update direct neighbors
   298	                        world.clone().update_neighbors(position, None).await;
   299	
   300	                        // Also update neighbors of the block below (strongly powered block)

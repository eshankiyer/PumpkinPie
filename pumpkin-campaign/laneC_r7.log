   150	      ItemStack clicked = ItemStack.EMPTY;
   151	      Slot slot = this.slots.get(slotIndex);
   152	      if (slot != null && slot.hasItem()) {
   153	         ItemStack stack = slot.getItem();
   154	         clicked = stack.copy();
   155	         if (slotIndex == 2) {
   156	            stack.getItem().onCraftedBy(stack, player);
   157	            if (!this.moveItemStackTo(stack, 3, 39, true)) {
   158	               return ItemStack.EMPTY;
   159	            }
   160	
   161	            slot.onQuickCraft(stack, clicked);
   162	         } else if (slotIndex != 1 && slotIndex != 0) {
   163	            if (stack.has(DataComponents.MAP_ID)) {
   164	               if (!this.moveItemStackTo(stack, 0, 1, false)) {
   165	                  return ItemStack.EMPTY;
   166	               }
   167	            } else if (!stack.is(Items.PAPER) && !stack.is(Items.MAP) && !stack.is(Items.GLASS_PANE)) {
   168	               if (slotIndex >= 3 && slotIndex < 30) {
   169	                  if (!this.moveItemStackTo(stack, 30, 39, false)) {
   170	                     return ItemStack.EMPTY;
   171	                  }
   172	               } else if (slotIndex >= 30 && slotIndex < 39 && !this.moveItemStackTo(stack, 3, 30, false)) {
   173	                  return ItemStack.EMPTY;
   174	               }
   175	            } else if (!this.moveItemStackTo(stack, 1, 2, false)) {
   176	               return ItemStack.EMPTY;
   177	            }
   178	         } else if (!this.moveItemStackTo(stack, 3, 39, false)) {
   179	            return ItemStack.EMPTY;
   180	         }
   181	
   182	         if (stack.isEmpty()) {
   183	            slot.setByPlayer(ItemStack.EMPTY);
   184	         }
   185	
   186	         slot.setChanged();
   187	         if (stack.getCount() == clicked.getCount()) {
   188	            return ItemStack.EMPTY;
   189	         }
   190	
   191	         slot.onTake(player, stack);
   192	         this.broadcastChanges();
   193	      }
   194	
   195	      return clicked;
   196	   }

+        world.play_sound(
+            sound,
+            pumpkin_data::sound::SoundCategory::Neutral,
+            &entity.pos.load(),
+        );
+    }
+}
+
+fn feed_healing_amount(nutrition: Option<i32>, healing_factor: f32, default_heal: f32) -> f32 {
+    nutrition.map_or(default_heal, |nutrition| healing_factor * nutrition as f32)
+}

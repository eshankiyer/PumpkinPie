   359	    /// Vanilla `TrialSpawnerBlockEntity#setEntityId` (TrialSpawnerBlockEntity.java:57-65):
   360	    /// delegates to `TrialSpawner#overrideEntityToSpawn` (TrialSpawner.java:340-344),
   361	    /// which resets the state data, swaps the spawn entity in both configs through
   362	    /// `FullConfig#overrideEntity` (TrialSpawner.java:394-401), and forces the block
   363	    /// state back to INACTIVE.
   364	    pub async fn set_entity_id(&self, world: &Arc<World>, entity_type: &'static EntityType) {
   365	        self.reset().await;
   366	        let normal = Self::with_spawning(&self.active_config(false), entity_type);
   367	        *self.normal_config.lock().unwrap() = normal;
   368	        let ominous = Self::with_spawning(&self.active_config(true), entity_type);
   369	        *self.ominous_config.lock().unwrap() = ominous;
   370	
   371	        // TrialSpawner.java:343 (`setState(level, TrialSpawnerState.INACTIVE)`)
   372	        let state_id = world.get_block_state_id(&self.position);
   373	        let block = Block::from_state_id(state_id);
   374	        if TrialSpawnerLikeProperties::handles_block_id(block.id) {
   375	            let mut props = TrialSpawnerLikeProperties::from_state_id(state_id, block);
   376	            props.trial_spawner_state = TrialSpawnerState::Inactive;
   377	            world
   378	                .set_block_state(
   379	                    &self.position,
   380	                    props.to_state_id(block),
   430	                WorldEvent::ParticlesTrialSpawnerDetectPlayerOminous
   431	            } else {
   432	                WorldEvent::ParticlesTrialSpawnerDetectPlayer
   433	            };
   434	            world.sync_world_event(event, self.position, detected.len() as i32);
   435	        }
   436	    }

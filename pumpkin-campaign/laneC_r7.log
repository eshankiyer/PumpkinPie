   278	                &'a self,
   279	                world: &'a Arc<$crate::world::World>,
   280	                position: &'a pumpkin_util::math::position::BlockPos,
   281	                old: u16,
   282	                new: u16,
   283	            ) -> $crate::block::viewer::ViewerFuture<'a, ()> {
   284	                Box::pin(async move {
   285	                    // Trigger block animation
   286	                    world

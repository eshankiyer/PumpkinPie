    39	/// A parsed reference to either a single registry entry or a `#`-prefixed tag
    40	/// of entries, as produced by [`ResourceOrTagKeyArgument`] and
    41	/// [`ResourceOrTagArgument`].
    42	#[derive(Debug, Clone)]
    43	pub enum ResourceOrTag {
    44	    Resource(Identifier),
    45	    Tag(Identifier),
    46	}
    47	
    48	impl ResourceOrTag {
    49	    /// The user-facing form of this reference (vanilla's `asPrintable`):
    50	    /// `namespace:path` for entries, `#namespace:path` for tags.
    51	    #[must_use]
    52	    pub fn printable(&self) -> String {
    53	        match self {
    54	            Self::Resource(id) => id.to_string(),
    55	            Self::Tag(id) => format!("#{id}"),
    56	        }
    57	    }
    58	
    59	    fn from_string_reader(reader: &mut StringReader) -> Result<Self, CommandSyntaxError> {
    60	        if reader.peek() == Some('#') {
    61	            reader.skip();
    62	            Ok(Self::Tag(Identifier::from_reader(reader)?))
    63	        } else {
    64	            Ok(Self::Resource(Identifier::from_reader(reader)?))
    65	        }
    66	    }
    67	}

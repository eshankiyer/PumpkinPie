   103	pub fn get_str_hash(val: &str) -> u32 {
   104	    let mut digest = Digest::new(Crc32Iscsi);
   105	    digest.update(&[12u8]);
   106	    digest.update(&(val.len() as u32).to_le_bytes());
   107	    let byte = val.as_bytes();
   108	    for i in byte {
   109	        digest.update(&[*i, 0u8]);
   110	    }
   111	    digest.finalize() as u32
   112	}
   113	
   114	pub fn get_i32_hash(val: i32) -> u32 {
   115	    let mut digest = Digest::new(Crc32Iscsi);
   116	    digest.update(&[8u8]);
   117	    digest.update(&val.to_le_bytes());
   118	    digest.finalize() as u32
   119	}
   120	
   121	pub fn get_f32_hash(val: f32) -> u32 {
   122	    let mut digest = Digest::new(Crc32Iscsi);
   123	    digest.update(&[7u8]);
   124	    digest.update(&val.to_bits().to_le_bytes());
   125	    digest.finalize() as u32
   126	}
   127	
   128	pub fn get_idor_hash(val: &IdOr<basic::SoundEvent>) -> u32 {
   129	    let mut digest = Digest::new(Crc32Iscsi);
   130	    digest.update(&[6u8]);
   131	    match val {
   132	        IdOr::Id(sound) => {
   133	            digest.update(&[1u8]);
   134	            digest.update(&get_str_hash(sound.to_name()).to_le_bytes());
   135	        }
   136	        IdOr::Value(sound) => {
   137	            digest.update(&[2u8]);
   138	            digest.update(&get_str_hash(sound.sound_name.as_str()).to_le_bytes());
   139	            if let Some(range) = sound.range {
   140	                digest.update(&[1u8]);
   141	                digest.update(&get_f32_hash(range).to_le_bytes());
   142	            } else {
   143	                digest.update(&[0u8]);
   144	            }
   145	        }
   146	    }
   147	    digest.finalize() as u32
   148	}

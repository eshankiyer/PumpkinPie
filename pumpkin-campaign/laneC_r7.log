   262	   public static AABB getProgressDeltaAabb(final float size, final Direction direction, final float progressFrom, final float progressTo, final Vec3 position) {
   263	      AABB boundsAtBottomCenter = new AABB(-size * 0.5, 0.0, -size * 0.5, size * 0.5, size, size * 0.5);
   264	      double maxMovement = Math.max(progressFrom, progressTo);
   265	      double minMovement = Math.min(progressFrom, progressTo);

    30	    pub fn new(sync_id: u8, player_inventory: &Arc<PlayerInventory>) -> Self {
    31	        let behaviour = ScreenHandlerBehaviour::new(sync_id, Some(WindowType::Stonecutter));
    32	        let input_inventory = Arc::new(SimpleInventory::new(1));
    33	        let output_inventory = Arc::new(SimpleInventory::new(1));

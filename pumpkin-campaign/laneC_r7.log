  1024	    pub fn set(&mut self, x: usize, y: usize, z: usize, value: u8) {
  1025	        match self {
  1026	            Self::Full(data) => {
  1027	                let index = Self::index(x, y, z);
  1028	                let mask = 0x0F << (4 * (index & 1));
  1029	                data[index >> 1] &= !mask;
  1030	                data[index >> 1] |= value << (4 * (index & 1));
  1031	            }
  1032	            Self::Empty(default) => {
  1033	                if value != *default {
  1034	                    *self = Self::new_filled(*default);
  1035	                    self.set(x, y, z, value);
  1036	                }
  1037	            }
  1038	        }
  1039	    }
  1040	
  1041	    pub fn fill(&mut self, value: u8) {
  1042	        // Match vanilla DataLayer.fill: a uniform layer stays implicit rather
  1043	        // than materializing a 2048-byte array. This matters for zero-filled
  1044	        // layers, which must remain absent from the client's data mask.
  1045	        *self = Self::new_empty(value);
  1046	    }
  1047	}

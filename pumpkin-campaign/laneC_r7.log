   314	    fn send_java_spawn_packet<'a>(
   315	        &'a self,
   316	        client: &'a crate::net::java::JavaClient,
   317	    ) -> EntityBaseFuture<'a, ()> {
   318	        Box::pin(async move {
   319	            let spawn_packet = self.entity.create_spawn_packet();
   320	            if let Ok(data) = client.serialize_packet(&spawn_packet) {
   321	                client.enqueue_packet(data).await;
   322	            }
   323	
   324	            if client.version.load() >= CURRENT_MC_VERSION {
   325	                let metadata = Metadata::new(
   326	                    pumpkin_data::tracked_data::ominous_item_spawner::ITEM,
   327	                    ItemStackSerializer::from(self.item.lock().await.clone()),
   328	                );
   329	                let mut data = Vec::new();
   330	                if metadata.write(&mut data, &client.version.load()).is_ok() {
   331	                    data.push(255);
   332	                    let meta_packet =
   333	                        CSetEntityMetadata::new(self.entity.entity_id.into(), data.into());
   334	                    if let Ok(meta_data) = client.serialize_packet(&meta_packet) {
   335	                        client.enqueue_packet(meta_data).await;
   336	                    }
   337	                }
   338	            }
   339	        })
   340	    }
   341	}

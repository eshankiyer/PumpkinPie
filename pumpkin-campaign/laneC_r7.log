    72	/// The block-level surface every worldgen feature actually uses.
    73	///
    74	/// Vanilla features run against a `WorldGenLevel` (`Feature.place` takes a
    75	/// `FeaturePlaceContext` whose `level()` is one), an interface a live `ServerLevel`
    76	/// implements just as `WorldGenRegion` does; no feature reaches for a chunk object. This
    77	/// trait mirrors that split deliberately: it mentions no [`ProtoChunk`], so a runtime
    78	/// adapter backed by a live world can implement it and drive feature placement -
    79	/// bone-mealed moss and nylium, sapling growth - without synthesising proto chunks.
    80	///
    81	/// Chunk-graph access, which exists only while a chunk is being generated, lives in
    82	/// [`ProtoChunkCache`].
    83	pub trait GenerationCache: HeightLimitView + BlockAccessor {
    84	    fn get_block_state(&self, pos: &Vector3<i32>) -> BlockStateId;
    85	    fn get_fluid_and_fluid_state(&self, position: &Vector3<i32>) -> (Fluid, FluidState);
    86	    fn set_block_state(&mut self, pos: &Vector3<i32>, block_state: &BlockState);
    87	    fn add_block_entity(&mut self, pos: &Vector3<i32>, nbt: NbtCompound);
    88	    fn top_motion_blocking_block_height_exclusive(&self, x: i32, z: i32) -> i32;
    89	    fn top_motion_blocking_block_no_leaves_height_exclusive(&self, x: i32, z: i32) -> i32;
    90	    fn get_top_y(&self, heightmap: &HeightMap, x: i32, z: i32) -> i32;
    91	    fn top_block_height_exclusive(&self, x: i32, z: i32) -> i32;
    92	    fn ocean_floor_height_exclusive(&self, x: i32, z: i32) -> i32;
    93	    fn is_air(&self, local_pos: &Vector3<i32>) -> bool;
    94	    fn get_biome_for_terrain_gen(&self, x: i32, y: i32, z: i32) -> &'static Biome;
    95	
    96	    /// Runtime feature placement uses this to select vanilla's planted huge-fungus rules.
    97	    fn is_runtime_bonemeal(&self) -> bool {
    98	        false
    99	    }
   100	}
   101	
   102	/// Access to the chunk graph a generation pass is working over.
   103	///
   104	/// Only meaningful mid-generation: the structure, blending and mob-spawn steps read the
   105	/// centre chunk's stage and its neighbours' proto chunks. Runtime callers implement
   106	/// [`GenerationCache`] alone.
   107	pub trait ProtoChunkCache: GenerationCache {
   108	    fn get_center_chunk_mut(&mut self) -> &mut ProtoChunk;
   109	    fn get_center_chunk(&self) -> &ProtoChunk;
   110	
   111	    fn get_chunk_mut(&mut self, chunk_x: i32, chunk_z: i32) -> Option<&mut ProtoChunk>;
   112	    fn get_chunk(&self, chunk_x: i32, chunk_z: i32) -> Option<&ProtoChunk>;
   113	    fn get_chunk_biomes(&self, chunk_x: i32, chunk_z: i32) -> Option<Vec<u8>>;
   114	
   115	    fn try_get_proto_chunk(&self, chunk_x: i32, chunk_z: i32) -> Option<&ProtoChunk>;
   116	
   117	    fn get_blending_data(
   118	        &self,
   119	        chunk_x: i32,
   120	        chunk_z: i32,
   121	    ) -> Option<&crate::generation::blender::blending_data::BlendingData>;
   122	}

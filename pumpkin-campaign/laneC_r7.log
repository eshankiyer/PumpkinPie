   289	    fn encode(packet: &CWaypoint<'_>) -> Vec<u8> {
   290	        let mut buf = Vec::new();
   291	        packet
   292	            .write_packet_data(&mut buf, &JavaMinecraftVersion::V_26_2)
   293	            .unwrap();

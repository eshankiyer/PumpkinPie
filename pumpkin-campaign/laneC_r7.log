   537	    /// Copies tracked slot state from another screen handler.
   538	    ///
   539	    /// Used when reopening a container to restore previous state.
   540	    fn copy_shared_slots(
   541	        &mut self,
   542	        other: Arc<Mutex<dyn ScreenHandler>>,
   543	    ) -> ScreenHandlerFuture<'_, ()> {
   544	        Box::pin(async move {
   545	            let mut table: HashMap<ComparableInventory, HashMap<usize, usize>> = HashMap::new();
   546	            let other_binding = other.lock().await;
   547	            let other_behaviour = other_binding.get_behaviour();
   548	
   549	            for i in 0..other_behaviour.slots.len() {
   550	                let other_slot = other_behaviour.slots[i].clone();
   551	                let mut hash_map = HashMap::new();
   552	                hash_map.insert(other_slot.get_index(), i);
   553	                table.insert(
   554	                    ComparableInventory(other_slot.get_inventory().clone()),
   555	                    hash_map,
   556	                );
   557	            }
   558	
   559	            for i in 0..self.get_behaviour().slots.len() {
   560	                let slot = self.get_behaviour().slots[i].clone();
   780	            let behaviour = self.get_behaviour_mut();
   781	            let mut prop_vec = vec![];
   782	            for (idx, prop) in behaviour.properties.iter_mut().enumerate() {
   783	                let value = prop.get();
   784	                if prop.has_changed() {
   785	                    prop_vec.push((idx, value));
   786	                }
   787	            }
   788	
   789	            for (idx, value) in prop_vec {
   790	                self.update_tracked_properties(idx as i32, value).await;
   791	                self.check_property_updates(idx as i32, value).await;
   792	            }
   793	        })
   794	    }

    73	
    74	    pub fn next_id(&self) -> NonZero<i32> {
    75	        // Wraps on overflow, which is what we want.
    76	        let value = self.counter.fetch_add(1, Ordering::Relaxed);
    77	
    78	        // Negative values are invalid; cycle through the positives
    79	        let masked = value & 0x7FFFFFFF;
    80	
    81	        if let Some(id) = NonZero::new(masked as i32) {
    82	            id
    83	        } else {
    84	            // If we fetched 0 or 0x80000000, that's masked out as 0
    85	            // Zero is invalid, so we just ask for the next ID to keep things simple/correct.
    86	            self.next_id()
    87	        }
    88	    }
    89	}

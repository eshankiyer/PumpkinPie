   128	    fn pick_random_spawn_data(&self) -> Option<(&'static EntityType, NbtCompound)> {
   129	        let total_weight: i32 = self.spawn_potentials.iter().map(|(_, w, _)| *w).sum();
   130	        if total_weight <= 0 {
   131	            return self
   132	                .spawn_potentials
   133	                .first()
   134	                .map(|(entity, _, data)| (*entity, data.clone()));
   135	        }
   136	        let mut roll = rand::random_range(0..total_weight);
   137	        for (entity, weight, data) in &self.spawn_potentials {
   138	            if roll < *weight {
   139	                return Some((*entity, data.clone()));
   140	            }
   141	            roll -= weight;
   142	        }
   143	        None
   144	    }
   145	}

   122	    /// `OminousItemSpawner.spawnItem` (`OminousItemSpawner.java:71-88`).
   123	    ///
   124	    /// TODO: the projectile branch. Vanilla routes any stack whose item is a
   125	    /// `ProjectileItem` through `OminousItemSpawner.spawnProjectile`
   126	    /// (`:90-105`), which dispenses it straight DOWN with the item's own
   127	    /// `ProjectileItem.createDispenseConfig` power/uncertainty/dispense-event
   128	    /// and sets this spawner as the projectile's owner. That is the common case
   129	    /// for ominous trial spawner loot, so this gap is the hot path, not a corner
   130	    /// case. Implementing it needs a reusable `ProjectileItem` abstraction:
   131	    /// today the only dispense logic here is `DispenserBlock::dispense`
   132	    /// (`block/blocks/redstone/dispenser.rs:256`), a private per-item `if`
   133	    /// chain bound to a `DispenseContext` (block position and facing), with the
   134	    /// power/uncertainty constants hardcoded per item. Until an item-side
   135	    /// `create_dispense_config` / `as_projectile` pair exists, every stack takes
   136	    /// the `ItemEntity` branch below.
   137	    async fn spawn_item(&self) {
   138	        let stack = {
   139	            let mut item = self.item.lock().await;
   140	            if item.is_empty() {
   141	                return;
   142	            }
   143	            let stack = item.clone();
   144	            // Vanilla `setItem(ItemStack.EMPTY)` at the end of `spawnItem`.
   145	            *item = ItemStack::EMPTY.clone();
   146	            stack
   147	        };
   148	
   149	        let world = self.entity.world.load();
   150	        let pos = self.entity.pos.load();
   151	
   152	        let item_entity = Entity::new(world.clone(), pos, &EntityType::ITEM);
   153	        // `new ItemEntity(level, x, y, z, stack)` (`ItemEntity.java:61-66`) sets
   154	        // the random drop velocity and leaves `pickupDelay` at its default 0 --
   155	        // it never calls `setDefaultPickUpDelay`, so the 10-tick delay
   156	        // `ItemEntity::new` applies here would be wrong.
   157	        let velocity = Vector3::new(
   158	            rng().random::<f64>().mul_add(0.2, -0.1),
   159	            0.2,
   160	            rng().random::<f64>().mul_add(0.2, -0.1),
   161	        );
   162	        let spawned: Arc<dyn EntityBase> = Arc::new(ItemEntity::new_with_velocity(
   163	            item_entity,
   164	            stack,
   165	            velocity,
   166	            0,
   167	        ));
   168	        world.spawn_entity(spawned.clone()).await;
   169	
   170	        // `level.levelEvent(3021, blockPosition(), 1)` (`OminousItemSpawner.java:84`).
   171	        world.sync_world_event(
   172	            WorldEvent::ParticlesTrialSpawnerSpawnItem,
   173	            self.entity.block_pos.load(),
   174	            1,
   175	        );
   176	        // `level.gameEvent(spawnedEntity, GameEvent.ENTITY_PLACE, position())` (`:85`).
   177	        emit_game_event(
   178	            &world,
   179	            GameEvent::EntityPlace,
   180	            pos,
   180	            pos,
   181	            GameEventContext::of_entity(spawned),
   182	        )
   183	        .await;
   184	
   185	        self.init_data_tracker().await;
   186	    }

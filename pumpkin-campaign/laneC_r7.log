   241	impl ChunkHeightmaps {
   242	    pub fn set(&mut self, heightmap: ChunkHeightmapType, x: i32, z: i32, height: i32, min_y: i32) {
   243	        let data = match heightmap {
   244	            ChunkHeightmapType::WorldSurface => &mut self.world_surface,
   245	            ChunkHeightmapType::MotionBlocking => &mut self.motion_blocking,
   246	            ChunkHeightmapType::MotionBlockingNoLeaves => &mut self.motion_blocking_no_leaves,
   247	            ChunkHeightmapType::OceanFloor => &mut self.ocean_floor,
   248	        };
   249	
   250	        let data = data.get_or_insert_with(|| vec![0; 37].into_boxed_slice());
   251	
   252	        let local_x = (x & 15) as usize;
   253	        let local_z = (z & 15) as usize;
   254	        let column_idx = local_z * 16 + local_x;
   255	
   256	        // In Minecraft 1.16+, height is stored as (y - min_y + 1). 0 means below min_y.
   257	        // It uses 9 bits per value, packed such that they do not cross u64 boundaries.
   258	        // 64 / 9 = 7 values per u64.
   259	        let val = (height - min_y + 1).max(0) as u64;
   260	
   261	        let array_idx = column_idx / 7;
   262	        let shift = (column_idx % 7) * 9;
   263	
   264	        let mask = 0x1FFu64 << shift;
   265	
   266	        let mut current = data[array_idx] as u64;
   267	        current = (current & !mask) | ((val & 0x1FF) << shift);
   268	        data[array_idx] = current as i64;
   269	    }
   270	
   271	    #[must_use]
   272	    pub fn get(&self, heightmap: ChunkHeightmapType, x: i32, z: i32, min_y: i32) -> i32 {
   273	        let data = match heightmap {
   274	            ChunkHeightmapType::WorldSurface => &self.world_surface,
   275	            ChunkHeightmapType::MotionBlocking => &self.motion_blocking,
   276	            ChunkHeightmapType::MotionBlockingNoLeaves => &self.motion_blocking_no_leaves,
   277	            ChunkHeightmapType::OceanFloor => &self.ocean_floor,
   278	        };
   279	
   280	        let Some(data) = data else {
   281	            return min_y - 1;
   282	        };
   283	
   284	        let local_x = (x & 15) as usize;
   285	        let local_z = (z & 15) as usize;
   286	        let column_idx = local_z * 16 + local_x;
   287	
   288	        let array_idx = column_idx / 7;
   289	        let shift = (column_idx % 7) * 9;
   290	
   291	        let current = data[array_idx] as u64;
   292	        let val = (current >> shift) & 0x1FF;
   293	
   294	        (val as i32) + min_y - 1
   295	    }

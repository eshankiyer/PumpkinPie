    54	/// Resolves generic `minecraft:post_attack` mob effects against the landed melee target.
    55	/// Today this is Bane of Arthropods' Slowness payload; the effect list is captured from the
    56	/// attacker's held item before damage is attempted, matching vanilla's weapon snapshot.
    57	async fn apply_post_hit_mob_effects(
    58	    target: &dyn EntityBase,
    59	    post_hit_effects: Vec<(crate::enchantment::EnchantmentEffect, i32)>,
    60	) {
    61	    let Some(living) = target.get_living_entity() else {
    62	        return;
    63	    };
    64	
    65	    for (effect, level) in post_hit_effects {
    66	        let crate::enchantment::EnchantmentEffect::ApplyMobEffectOnHit {
    67	            min_duration_seconds,
    68	            max_duration_seconds,
    69	            min_amplifier,
    70	            max_amplifier,
    71	            ..
    72	        } = effect
    73	        else {
    74	            continue;
    75	        };
    76	        let (duration, amplifier) = crate::enchantment::apply_mob_effect_on_hit(
    77	            min_duration_seconds,
    78	            max_duration_seconds,
    79	            min_amplifier,
    80	            max_amplifier,
    81	            level,
    82	            rand::random::<f32>(),
    83	            rand::random::<f32>(),
    84	        );
    85	        living
    86	            .add_effect(Effect {
    87	                effect_type: &StatusEffect::SLOWNESS,
    88	                duration,
    89	                amplifier,
    90	                ambient: false,
    91	                show_particles: true,
    92	                show_icon: true,
    93	                blend: false,
    94	            })
    95	            .await;
    96	    }
    97	}

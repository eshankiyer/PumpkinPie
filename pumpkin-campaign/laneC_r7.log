   270	            -direction.getStepX() * (1.0 + minMovement) * size,
   271	            -direction.getStepY() * (1.0 + minMovement) * size,
   272	            -direction.getStepZ() * (1.0 + minMovement) * size
   273	         );
   274	      return aabb.move(position.x, position.y, position.z);
   275	   }

   134	// Implement our private trait for all argument types.
   135	impl<U: ArgumentType<Item = T>, T: Send + Sync + 'static> Sealed for U {}
   136	
   137	impl<U: ArgumentType<Item = T> + 'static, T: Send + Sync + 'static> AnyArgumentType for U {
   138	    fn parse(
   139	        &self,
   140	        reader: &mut StringReader,
   141	    ) -> Result<Box<dyn Any + Send + Sync>, CommandSyntaxError> {
   142	        match self.parse(reader) {
   143	            Ok(value) => Ok(Box::new(value)),
   144	            Err(error) => Err(error),
   145	        }
   146	    }
   147	
   148	    fn parse_with_source<'a>(
   149	        &'a self,
   150	        reader: &'a mut StringReader,
   151	        source: &'a CommandSource,
   152	    ) -> ParseWithSourceAnyResult<'a> {
   153	        Box::pin(async move {
   154	            match self.parse_with_source(reader, source).await {
   155	                Ok(value) => {
   156	                    let value: Box<dyn Any + Send + Sync> = Box::new(value);
   157	                    Ok(value)
   158	                }
   159	                Err(error) => Err(error),
   160	            }
   161	        })
   162	    }
   163	
   164	    fn list_suggestions<'a>(
   165	        &'a self,
   166	        context: &'a CommandContext,
   167	        builder: SuggestionsBuilder,
   168	    ) -> Pin<Box<dyn Future<Output = Suggestions> + Send + 'a>> {
   169	        self.list_suggestions(context, builder)
   170	    }
   171	
   172	    fn client_side_parser(&'_ self) -> JavaClientArgumentType {
   173	        self.client_side_parser()
   174	    }
   175	
   176	    fn override_suggestion_providers(&self) -> Option<SuggestionProviders> {
   177	        self.override_suggestion_providers()
   178	    }
   179	
   180	    fn examples(&self) -> Vec<String> {
   181	        self.examples()
   182	    }
   183	
   184	    fn as_any(&self) -> &dyn Any {
   185	        self
   186	    }
   187	}

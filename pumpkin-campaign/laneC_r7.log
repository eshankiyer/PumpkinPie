   152	        chunk_x: i32,
   153	        chunk_z: i32,
   154	        bottom_y: i8,
   155	        height: u16,
   156	        mut biome_at: impl FnMut(i32, i32, i32) -> Option<u8>,
   157	    ) -> Self {
   158	        let min_biome_x = biome_coords::from_chunk(chunk_x) - 1;
   159	        let min_biome_z = biome_coords::from_chunk(chunk_z) - 1;
   160	        let min_biome_y = biome_coords::from_block(bottom_y as i32);
   161	        let y_cells = biome_coords::from_block(height as i32);
   162	
   163	        let mut data = vec![Self::MISSING; (Self::SIDE * Self::SIDE * y_cells) as usize];
   164	        for dx in 0..Self::SIDE {
   165	            for dz in 0..Self::SIDE {
   166	                for dy in 0..y_cells {
   167	                    if let Some(id) = biome_at(min_biome_x + dx, min_biome_y + dy, min_biome_z + dz)
   168	                    {
   169	                        data[((dx * Self::SIDE + dz) * y_cells + dy) as usize] = id;
   170	                    }
   171	                }
   172	            }
   173	        }
   174	
   175	        Self {
   176	            min_biome_x,
   177	            min_biome_z,
   178	            min_biome_y,
   179	            y_cells,
   180	            data: data.into_boxed_slice(),
   181	        }
   182	    }
   183	
   184	    /// Looks up an absolute biome-cell position. Returns `None` when the position is outside the
   185	    /// neighbourhood or the owning chunk was unavailable, so the caller can fall back.
   186	    #[must_use]
   187	    pub fn get(&self, biome_x: i32, biome_y: i32, biome_z: i32) -> Option<u8> {
   188	        let dx = biome_x - self.min_biome_x;
   189	        let dz = biome_z - self.min_biome_z;
   190	        if !(0..Self::SIDE).contains(&dx) || !(0..Self::SIDE).contains(&dz) {
   191	            return None;
   192	        }
   193	        // Matches vanilla `ChunkAccess.getNoiseBiome`, which clamps the quart Y into the chunk.
   194	        let dy = (biome_y - self.min_biome_y).clamp(0, self.y_cells - 1);
   195	        let id = self.data[((dx * Self::SIDE + dz) * self.y_cells + dy) as usize];
   196	        if id == Self::MISSING { None } else { Some(id) }
   197	    }
   198	}

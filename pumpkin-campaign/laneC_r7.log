+    fn handler() -> CartographyTableScreenHandler {
+        let player_inventory = Arc::new(PlayerInventory::new(
+            Arc::new(Mutex::new(EntityEquipment::new())),
+            Arc::new(crate::build_equipment_slots()),
+        ));

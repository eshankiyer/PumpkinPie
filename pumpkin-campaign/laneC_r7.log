   401	fn ingredient_item_ids(ingredient: &RecipeIngredientTypes, out: &mut Vec<u16>) {
   402	    match ingredient {
   403	        RecipeIngredientTypes::Simple(name) => out.extend(item_id_of(name)),
   404	        RecipeIngredientTypes::OneOf(names) => {
   405	            out.extend(names.iter().filter_map(|name| item_id_of(name)));
   406	        }
   407	        RecipeIngredientTypes::Tagged(tag) => {
   408	            let tag = tag.strip_prefix('#').unwrap_or(tag);
   409	            if let Some(ids) = get_tag_ids(RegistryKey::Item, tag) {
   410	                out.extend_from_slice(ids);
   411	            }
   412	        }
   413	    }
   414	}

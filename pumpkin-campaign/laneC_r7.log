    88	      }
    89	
    90	      return this.shouldSkipLocation(random, minDx, y, minDz, currentRadius, doubleTrunk);
    91	   }
    92	
    93	   protected void placeLeavesRow(
    94	      final WorldGenLevel level,
    95	      final FoliagePlacer.FoliageSetter foliageSetter,
    96	      final RandomSource random,
    97	      final TreeConfiguration config,
    98	      final BlockPos origin,
    99	      final int currentRadius,
   100	      final int y,
   101	      final boolean doubleTrunk
   102	   ) {
   103	      int offset = doubleTrunk ? 1 : 0;
   104	      BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
   105	
   106	      for (int dx = -currentRadius; dx <= currentRadius + offset; dx++) {
   107	         for (int dz = -currentRadius; dz <= currentRadius + offset; dz++) {
   108	            if (!this.shouldSkipLocationSigned(random, dx, y, dz, currentRadius, doubleTrunk)) {
   109	               pos.setWithOffset(origin, dx, y, dz);
   110	               tryPlaceLeaf(level, foliageSetter, random, config, pos);
   111	            }
   112	         }
   113	      }
   114	   }
   115	
   116	   protected final void placeLeavesRowWithHangingLeavesBelow(
   117	      final WorldGenLevel level,
   118	      final FoliagePlacer.FoliageSetter foliageSetter,
   119	      final RandomSource random,
   120	      final TreeConfiguration config,
   121	      final BlockPos origin,
   122	      final int currentRadius,
   123	      final int y,
   124	      final boolean doubleTrunk,
   125	      final float hangingLeavesChance,
   126	      final float hangingLeavesExtensionChance
   127	   ) {
   128	      this.placeLeavesRow(level, foliageSetter, random, config, origin, currentRadius, y, doubleTrunk);
   129	      int offset = doubleTrunk ? 1 : 0;
   130	      BlockPos logPos = origin.below();
   131	      BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
   132	
   133	      for (Direction alongEdge : Direction.Plane.HORIZONTAL) {
   134	         Direction toEdge = alongEdge.getClockWise();
   135	         int offsetToEdge = toEdge.getAxisDirection() == Direction.AxisDirection.POSITIVE ? currentRadius + offset : currentRadius;
   136	         pos.setWithOffset(origin, 0, y - 1, 0).move(toEdge, offsetToEdge).move(alongEdge, -currentRadius);
   137	         int offsetAlongEdge = -currentRadius;
   138	
   139	         while (offsetAlongEdge < currentRadius + offset) {
   140	            boolean leavesAbove = foliageSetter.isSet(pos.move(Direction.UP));
   141	            pos.move(Direction.DOWN);
   142	            if (leavesAbove && tryPlaceExtension(level, foliageSetter, random, config, hangingLeavesChance, logPos, pos)) {
   143	               pos.move(Direction.DOWN);
   144	               tryPlaceExtension(level, foliageSetter, random, config, hangingLeavesExtensionChance, logPos, pos);
   145	               pos.move(Direction.UP);
   146	            }
   147	
   148	            offsetAlongEdge++;
   149	            pos.move(alongEdge);
   150	         }
   151	      }
   152	   }
   153	
   154	   private static boolean tryPlaceExtension(
   155	      final WorldGenLevel level,
   156	      final FoliagePlacer.FoliageSetter foliageSetter,
   157	      final RandomSource random,
   158	      final TreeConfiguration config,
   159	      final float chance,
   160	      final BlockPos logPos,
   161	      final BlockPos.MutableBlockPos pos
   162	   ) {
   163	      if (pos.distManhattan(logPos) >= 7) {
   164	         return false;
   165	      } else {
   166	         return random.nextFloat() > chance ? false : tryPlaceLeaf(level, foliageSetter, random, config, pos);
   167	      }
   168	   }
   169	
   170	   protected static boolean tryPlaceLeaf(
   171	      final WorldGenLevel level, final FoliagePlacer.FoliageSetter foliageSetter, final RandomSource random, final TreeConfiguration config, final BlockPos pos
   172	   ) {
   173	      boolean isPersistent = level.isStateAtPosition(pos, state -> state.getValueOrElse(BlockStateProperties.PERSISTENT, false));
   174	      if (!isPersistent && TreeFeature.validTreePos(level, pos)) {
   175	         BlockState foliageState = config.foliageProvider.getState(level, random, pos);
   176	         if (foliageState.hasProperty(BlockStateProperties.WATERLOGGED)) {
   177	            foliageState = foliageState.setValue(
   178	               BlockStateProperties.WATERLOGGED, level.isFluidAtPosition(pos, fluidState -> fluidState.isSourceOfType(Fluids.WATER))
   179	            );
   180	         }
   181	
   182	         foliageSetter.set(pos, foliageState);
   183	         return true;
   184	      } else {
   185	         return false;
   186	      }
   187	   }

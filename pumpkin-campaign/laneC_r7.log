    25	/// Reads the `max_command_forks` gamerule of this source's world.
    26	///
    27	/// Vanilla reads it once when the outermost `ExecutionContext` is created
    28	/// (`Commands.java:399`); registered with a default of 65536 and a minimum of
    29	/// 0 (`GameRules.java:52`). Sources outside any world (console) use that
    30	/// default.
    31	fn command_fork_limit(source: &CommandSource) -> usize {
    32	    let default = GameRuleRegistry::default().max_command_forks;
    33	    source.world.as_ref().map_or(default as usize, |world| {
    34	        match world.get_game_rule(&GameRule::MaxCommandForks) {
    35	            GameRuleValue::Int(v) => v.max(0) as usize,
    36	            GameRuleValue::Bool(_) => default as usize,
    37	        }
    38	    })
    39	}

    89	/// Vanilla turns a non-finite damage value into the largest finite value before it reaches
    90	/// cooldown, armor, or health calculations (`LivingEntity.hurtServer`). This matters at the
    91	/// plugin boundary too: a malformed replacement amount must not poison persistent combat state.
    92	const fn normalize_non_finite_damage(amount: f32) -> f32 {
    93	    if amount.is_finite() { amount } else { f32::MAX }
    94	}

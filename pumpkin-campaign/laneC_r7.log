   297	    const ID: Uuid = Uuid::from_u128(0x0102_0304_0506_0708_090a_0b0c_0d0e_0f10);
   298	
   299	    /// `TrackedWaypoint.write` prefixes the identifier with the `writeEither`
   300	    /// boolean and always writes a full `Waypoint.Icon`.
   301	    #[test]
   302	    fn untrack_writes_either_flag_and_the_null_icon() {
   303	        let bytes = encode(&CWaypoint::remove(ID));
   304	        let mut expected = vec![1u8]; // operation UNTRACK
   305	        expected.push(1); // writeEither -> left
   306	        expected.extend_from_slice(ID.as_bytes());
   307	        expected.push(17); // string length of "minecraft:default"
   308	        expected.extend_from_slice(b"minecraft:default");
   309	        expected.push(0); // Optional<RGB> absent
   310	        expected.push(0); // Type EMPTY
   311	        assert_eq!(bytes, expected);
   312	    }
   313	
   314	    /// `Vec3iWaypoint.writeContents` writes three `VarInt`s, and
   315	    /// `ByteBufCodecs.RGB_COLOR` writes three raw bytes.
   316	    #[test]
   317	    fn position_writes_three_var_ints_and_a_three_byte_color() {
   318	        let packet = CWaypoint::add_position(
   319	            ID,
   320	            Some(WaypointIcon {
   321	                style: Some("bowtie"),
   322	                color: Some(0x00FF_8000),
   323	            }),
   324	            BlockPos::new(1, 2, 3),
   325	        );
   326	        let bytes = encode(&packet);
   327	        let mut expected = vec![0u8]; // operation TRACK
   328	        expected.push(1);
   329	        expected.extend_from_slice(ID.as_bytes());
   330	        expected.push(16);
   331	        expected.extend_from_slice(b"minecraft:bowtie");
   332	        expected.push(1); // Optional<RGB> present
   333	        expected.extend_from_slice(&[0xFF, 0x80, 0x00]);
   334	        expected.push(1); // Type VEC3I
   335	        expected.extend_from_slice(&[1, 2, 3]);
   336	        assert_eq!(bytes, expected);
   337	    }
   338	
   339	    /// `ChunkWaypoint.writeContents` writes two `VarInt`s, and CHUNK is ordinal 2.
   340	    #[test]
   341	    fn chunk_writes_two_var_ints_under_ordinal_two() {
   342	        let packet = CWaypoint::new(
   343	            WaypointOperation::Update,
   344	            TrackedWaypoint {
   345	                identifier: ID,
   346	                icon: None,
   347	                target: WaypointTarget::Chunk { x: 5, z: -1 },
   348	            },
   349	        );
   350	        let bytes = encode(&packet);
   351	        let tail = &bytes[bytes.len() - 7..];
   352	        assert_eq!(tail[0], 2); // Type CHUNK
   353	        assert_eq!(tail[1], 5); // VarInt 5
   354	        assert_eq!(&tail[2..7], &[0xFF, 0xFF, 0xFF, 0xFF, 0x0F]); // VarInt -1
   355	        assert_eq!(bytes[0], 2); // operation UPDATE
   356	    }

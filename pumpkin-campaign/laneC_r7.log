   109	fn armor_resists_damage(stack: &ItemStack, damage_type: &DamageType) -> bool {
   110	    let Some(resistant) = stack.get_data_component::<DamageResistantImpl>() else {
   111	        return false;
   112	    };
   113	
   114	    match resistant.res_type {
   115	        DamageResistantType::Fire => damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_FIRE),
   116	        DamageResistantType::Explosion => {
   117	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_EXPLOSION)
   118	        }
   119	        DamageResistantType::Fall => damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_FALL),
   120	        DamageResistantType::Freezing => {
   121	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_FREEZING)
   122	        }
   123	        DamageResistantType::Lightning => {
   124	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_LIGHTNING)
   125	        }
   126	        DamageResistantType::Drowning => {
   127	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_DROWNING)
   128	        }
   129	        DamageResistantType::Projectile => {
   130	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_PROJECTILE)
   131	        }
   132	        DamageResistantType::PlayerAttack => {
   133	            damage_type.has_tag(&tag::DamageType::MINECRAFT_IS_PLAYER_ATTACK)
   134	        }
   135	        DamageResistantType::MaceSmash => {
   136	            damage_type.has_tag(&tag::DamageType::MINECRAFT_MACE_SMASH)
   137	        }
   138	        _ => false,
   139	    }
   140	}

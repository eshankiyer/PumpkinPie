    37	            input_inventory: input_inventory.clone(),
    38	            output_inventory: output_inventory.clone(),
    39	            selected_recipe: AtomicU8::new(u8::MAX),
    40	            last_input_item: AtomicU16::new(Item::AIR.id),
    41	        };
    42	
    43	        handler.add_slot(Arc::new(NormalSlot::new(
    44	            input_inventory.clone() as Arc<dyn Inventory>,
    45	            0,
    46	        )));
    47	        handler.add_slot(Arc::new(StonecutterOutputSlot::new(
    48	            output_inventory as Arc<dyn Inventory>,
    49	            input_inventory as Arc<dyn Inventory>,
    50	            0,
    51	        )));
    52	
    53	        let player_inventory: Arc<dyn Inventory> = player_inventory.clone();
    54	
    55	        handler.add_player_slots(&player_inventory);
    56	
    57	        handler
    58	    }

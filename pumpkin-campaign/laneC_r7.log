    15	pub trait ViewerCountTrackerExt {
    16	    fn update_viewer_count<'a, T>(
    17	        &'a self,
    18	        entity: &'a T,
    19	        world: &'a Arc<World>,
    20	        position: &'a BlockPos,
    21	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>>
    22	    where
    23	        T: BlockEntity + ViewerCountListener + 'static;
    24	}
    25	
    26	impl ViewerCountTrackerExt for ViewerCountTracker {
    27	    fn update_viewer_count<'a, T>(
    28	        &'a self,
    29	        entity: &'a T,
    30	        world: &'a Arc<World>,
    31	        position: &'a BlockPos,
    32	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>>
    33	    where
    34	        T: BlockEntity + ViewerCountListener + 'static,
    35	    {
    36	        Box::pin(async move {
    37	            let current = self.current.load(Ordering::Relaxed);
    38	            let old = self.old.swap(current, Ordering::Relaxed);
    39	            if old != current {
    40	                // ContainerOpenersCounter.onViewerCountChange: fires GameEvent.CONTAINER_OPEN/
    41	                // CONTAINER_CLOSE only on the 0<->nonzero transition, not on every viewer-count
    42	                // change. Vanilla passes the opening/closing entity as context when known and
    43	                // `null` otherwise (ContainerOpenersCounter.java:81,84); this tracker only has
    44	                // the count, not which entity changed it, so `GameEventContext::none()` is used
    45	                // -- the same fallback vanilla itself uses when no entity is known.
    46	                let event_pos = Vector3::new(
    47	                    f64::from(position.0.x) + 0.5,
    48	                    f64::from(position.0.y) + 0.5,
    49	                    f64::from(position.0.z) + 0.5,
    50	                );
    51	                match (old, current) {
    52	                    (n, 0) if n > 0 => {
    53	                        entity.on_container_close(world, position).await;
    54	                        game_event::emit_game_event(
    55	                            world,
    56	                            pumpkin_data::game_event::GameEvent::ContainerClose,
    57	                            event_pos,
    58	                            game_event::GameEventContext::none(),
    59	                        )
    60	                        .await;
    61	                    }
    62	                    (0, n) if n > 0 => {
    63	                        entity.on_container_open(world, position).await;
    64	                        game_event::emit_game_event(
    65	                            world,
    66	                            pumpkin_data::game_event::GameEvent::ContainerOpen,
    67	                            event_pos,
    68	                            game_event::GameEventContext::none(),
    69	                        )
    70	                        .await;
    71	                    }
    72	                    _ => {} // Ignore
    73	                }
    74	
    75	                entity
    76	                    .on_viewer_count_update(world, position, old, current)
    77	                    .await;
    78	            }
    79	        })
    80	    }
    81	}

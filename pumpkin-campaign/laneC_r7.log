    22	// Helper methods for assertion with a `StringReader`:
    23	
    24	/// Asserts that the result read by `reader` with the argument
    25	/// type `$argument_type` used to parse is equal to `Ok($value)`.
    26	/// Also resets the reader's cursor back to the start.
    27	#[cfg(test)]
    28	macro_rules! assert_parse_ok_reset {
    29	    ($reader: expr, $argument_type: expr, $value: expr) => {{
    30	        assert_eq!($argument_type.parse(&mut $reader), Ok($value));
    31	        $reader.set_cursor(0)
    32	    }};
    33	    ($reader: expr, $argument_type: expr) => {{
    34	        assert!($argument_type.parse(&mut $reader).is_ok());
    35	        $reader.set_cursor(0)
    36	    }};
    37	}
    38	
    39	/// Asserts that the result read by `reader` with the argument
    40	/// type `$argument_type` used to parse is an `Err` containing the type of error as `$error_type`.
    41	/// Also resets the reader's cursor back to the start.
    42	#[cfg(test)]
    43	macro_rules! assert_parse_err_reset {
    44	    ($reader: expr, $argument_type: expr, $error_type: expr) => {
    45	        let error_type_dyn: &'static dyn crate::command::errors::error_types::AnyCommandErrorType =
    46	            $error_type;
    47	        assert_eq!(
    48	            $argument_type.parse(&mut $reader).map_err(|e| e.error_type),
    49	            Err(error_type_dyn)
    50	        );
    51	        $reader.set_cursor(0)
    52	    };
    53	}

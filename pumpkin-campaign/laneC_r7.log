   344	    // TrialSpawnerConfig.java:74-87 (`withSpawning`): replaces the spawn potentials
   345	    // with a single weight-1 entry whose SpawnData carries only the entity id.
   346	    fn with_spawning(
   347	        config: &TrialSpawnerConfig,
   348	        entity_type: &'static EntityType,
   349	    ) -> TrialSpawnerConfig {
   350	        let mut entity = NbtCompound::new();
   351	        entity.put_string("id", format!("minecraft:{}", entity_type.resource_name));
   352	        let mut data = NbtCompound::new();
   353	        data.put_compound("entity", entity);
   354	        let mut overridden = config.clone();
   355	        overridden.spawn_potentials = vec![(entity_type, 1, data)];
   356	        overridden
   357	    }

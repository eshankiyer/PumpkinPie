    69	/// Registry-aware suggestions shared by both argument types: the known entry
    70	/// ids plus, when tag data exists for the registry, its `#`-prefixed tags.
    71	fn suggest_for_registry(registry: &Identifier, builder: SuggestionsBuilder) -> Suggestions {
    72	    let tag_names = |key: RegistryKey| {
    73	        tag::get_latest_map(key)
    74	            .into_iter()
    75	            .flat_map(|map| map.keys().map(|tag| format!("#{tag}")))
    76	    };
    77	
    78	    if *registry == STRUCTURE_REGISTRY {
    79	        // The generator models vanilla's structure sets, so those are the
    80	        // locatable names. There is no structure tag data to offer.
    81	        builder
    82	            .filter_and_suggest_iter(
    83	                StructureSet::NAMES
    84	                    .iter()
    85	                    .map(|name| format!("minecraft:{name}")),
    86	            )
    87	            .build()
    88	    } else if *registry == *BIOME_REGISTRY {
    89	        let biomes = pumpkin_data::biome::Biome::ALL
    90	            .iter()
    91	            .map(|biome| format!("minecraft:{}", biome.registry_id));
    92	        builder
    93	            .filter_and_suggest_iter(biomes.chain(tag_names(RegistryKey::WorldgenBiome)))
    94	            .build()
    95	    } else if *registry == POI_REGISTRY {
    96	        // There is no generated POI type registry (yet), so offer the types
    97	        // known from tag data plus the ones the server actually creates.
    98	        let mut names: BTreeSet<String> = tag::get_latest_map(RegistryKey::PointOfInterestType)
    99	            .into_iter()
   100	            .flat_map(|map| map.values().flat_map(|tag| tag.0.iter()))
   101	            .map(|name| format!("minecraft:{name}"))
   102	            .collect();
   103	        names.insert(POI_TYPE_NETHER_PORTAL.to_string());
   104	        builder
   105	            .filter_and_suggest_iter(
   106	                names
   107	                    .into_iter()
   108	                    .chain(tag_names(RegistryKey::PointOfInterestType)),
   109	            )
   110	            .build()
   111	    } else {
   112	        Suggestions::empty()
   113	    }
   114	}

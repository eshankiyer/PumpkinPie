   528	    // TrialSpawner.java:271-290
   529	    async fn untrack_dead_mobs(&self, world: &Arc<World>) -> bool {
   530	        let mut mobs = self.current_mobs.lock().await;
   531	        let before = mobs.len();
   532	        mobs.retain(|id| {
   533	            world.get_entity_by_uuid(*id).is_some_and(|e| {
   534	                e.get_entity().is_alive()
   535	                    && e.get_entity()
   536	                        .block_pos
   537	                        .load()
   538	                        .0
   539	                        .squared_distance_to_vec(&self.position.0)
   540	                        <= MAX_MOB_TRACKING_DISTANCE_SQR
   541	            })
   542	        });
   543	        mobs.len() != before
   544	    }

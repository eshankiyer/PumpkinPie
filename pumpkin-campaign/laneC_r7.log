@@ -30,6 +31,11 @@
     translation::java::ARGUMENT_RESOURCE_TAG_NOT_FOUND,
 );
 
+static ERROR_INVALID_RESOURCE_TYPE: CommandErrorType<3> = CommandErrorType::new(
+    translation::java::ARGUMENT_RESOURCE_INVALID_TYPE,
+    translation::java::ARGUMENT_RESOURCE_INVALID_TYPE,

   150	pub fn put_idor(nbt: &mut NbtCompound, key: &str, val: &IdOr<basic::SoundEvent>) {
   151	    match val {
   152	        IdOr::Id(id) => nbt.put_string(key, format!("minecraft:{}", id.to_name())),
   153	        IdOr::Value(sound) => {
   154	            let mut sound_compound = NbtCompound::new();
   155	
   156	            sound_compound.put_string("sound_id", sound.sound_name.clone());
   157	            if let Some(range) = sound.range {
   158	                sound_compound.put_float("range", range);
   159	            }
   160	            nbt.put(key, NbtTag::Compound(sound_compound));
   161	        }
   162	    }
   163	}
   164	
   165	pub fn get_idor(nbt: &NbtCompound, key: &str, default: Sound) -> IdOr<basic::SoundEvent> {
   166	    if let Some(sound) = nbt.get_string(key) {
   167	        let sound = sound.strip_prefix("minecraft:").unwrap_or(sound);
   168	        IdOr::Id(Sound::from_name(sound).unwrap_or(default))
   169	    } else if let Some(sound_compound) = nbt.get_compound(key) {
   170	        let Some(sound_name) = sound_compound.get_string("sound_id") else {
   171	            return IdOr::Id(default);
   172	        };
   173	        let range = sound_compound.get_float("range");
   174	        IdOr::Value(basic::SoundEvent {
   175	            sound_name: sound_name.to_string(),
   176	            range,
   177	        })
   178	    } else {
   179	        IdOr::Id(default)
   180	    }

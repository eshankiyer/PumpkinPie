   133	    pub fn place_foliage_block<T: GenerationCache>(
   134	        chunk: &mut T,
   135	        pos: BlockPos,
   136	        block_state: &BlockState,
   137	    ) -> bool {
   138	        let existing = GenerationCache::get_block_state(chunk, &pos.0);
   139	        if existing
   140	            .to_block()
   141	            .properties(existing)
   142	            .is_some_and(|props| {
   143	                props
   144	                    .to_props()
   145	                    .iter()
   146	                    .any(|(key, value)| *key == "persistent" && *value == "true")
   147	            })
   148	            || !TreeFeature::can_replace(existing.to_state(), existing.to_block_id())
   149	        {
   150	            return false;
   151	        }
   152	
   153	        // Vanilla `FoliagePlacer.tryPlaceLeaf` (`FoliagePlacer.java:170-186`) preserves
   154	        // source-water occupancy when the foliage state supports `waterlogged`.
   155	        let (fluid, fluid_state) = GenerationCache::get_fluid_and_fluid_state(chunk, &pos.0);
   156	        let foliage_state = if fluid_state.is_source
   157	            && fluid.matches_type(&Fluid::WATER)
   158	            && let Some(properties) =
   159	                Block::from_state_id(block_state.id).properties(block_state.id)

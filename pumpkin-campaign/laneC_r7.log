   214	         newInventoryItem.has(DataComponents.USE_EFFECTS) && !newInventoryItem.get(DataComponents.USE_EFFECTS).interactVibrations()
   215	            ? null
   216	            : GameEvent.ITEM_INTERACT_FINISH
   217	      );
   218	      return !removedItem.isEmpty();
   219	   }

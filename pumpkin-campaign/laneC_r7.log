   140	            .find_map(|node| {
   141	                if let AttachedNode::Argument(cur) = node
   142	                    && cur.meta.name == name
   143	                {
   144	                    Some(cur)
   145	                } else {
   146	                    None
   147	                }
   148	            })
   149	            .ok_or(missing_argument.clone())?;
   150	        let invalid_argument =
   151	            DISPATCHER_PARSE_EXCEPTION.create_without_context(TextComponent::text(format!(

+    /// is another map (`CartographyTableMenu.java:125-133`).
+    #[tokio::test]
+    async fn map_copy_refreshes_the_result() {
+        let handler = handler();
+        let mut map = ItemStack::new(1, &Item::FILLED_MAP);
+        map.patch.push((
+            DataComponent::MapId,

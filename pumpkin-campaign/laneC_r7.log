    72	fn get_start_and_end_pos(player: &Player) -> (Vector3<f64>, Vector3<f64>) {
    73	    let start_pos = player.eye_position();
    74	    let (yaw, pitch) = player.rotation();
    75	    let (yaw_rad, pitch_rad) = (f64::from(yaw.to_radians()), f64::from(pitch.to_radians()));
    76	    let block_interaction_range = 4.5; // This is not the same as the block_interaction_range in the
    77	    // player entity.
    78	    let direction = Vector3::new(
    79	        -yaw_rad.sin() * pitch_rad.cos() * block_interaction_range,
    80	        -pitch_rad.sin() * block_interaction_range,
    81	        pitch_rad.cos() * yaw_rad.cos() * block_interaction_range,
    82	    );
    83	
    84	    let end_pos = start_pos.add(&direction);
    85	    (start_pos, end_pos)
    86	}

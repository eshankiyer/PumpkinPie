    58	struct RecipeSuggestionProvider;
    59	
    60	impl SuggestionProvider for RecipeSuggestionProvider {
    61	    fn suggest(
    62	        &self,
    63	        context: &CommandContext,
    64	        mut builder: SuggestionsBuilder,
    65	    ) -> Pin<Box<dyn Future<Output = Suggestions> + Send>> {
    66	        let server = context.source.server.clone();
    67	
    68	        Box::pin(async move {
    69	            builder = builder.suggest("*");
    70	            if let Some(server) = server {
    71	                let recipes = server.recipe_manager.get_dynamic_recipes_internal().await;
    72	                for recipe in recipes {
    73	                    let id = get_recipe_id(&recipe);
    74	                    builder = builder.suggest(id);
    75	                }
    76	            }
    77	            builder.build()
    78	        })
    79	    }
    80	}

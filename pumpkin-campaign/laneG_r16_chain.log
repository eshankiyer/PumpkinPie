-+            let mut random = RandomGenerator::Xoroshiro(Xoroshiro::from_seed(seed));
-+            let amount = spawner_break_experience(&mut random);
-+            assert!((15..=43).contains(&amount), "amount {amount} out of range");
-+        }
-+    }

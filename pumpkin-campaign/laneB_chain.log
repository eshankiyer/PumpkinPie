//! insertion while disabled (`CrafterSlot.java:14-17`), and it carries a
//! non-interactive recipe-preview slot after the player slots
//! (`CrafterMenu.java:51`).

use std::{
    any::Any,
    pin::Pin,
    sync::{
        Arc,
        atomic::{AtomicU8, Ordering},
    },
};

use pumpkin_data::{item_stack::ItemStack, screen::WindowType};
use pumpkin_world::inventory::InventoryFuture;
use pumpkin_world::{
    block::entities::PropertyDelegate,
    inventory::{Clearable, Inventory},
};


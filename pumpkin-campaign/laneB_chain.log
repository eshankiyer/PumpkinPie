  1151	/// One `ClientboundRecipeBookAddPacket.Entry`
  1152	/// (`ClientboundRecipeBookAddPacket.java:29-50`) named by the display id the static
  1153	/// recipe tables assign it, plus the two flag bits.
  1154	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
  1155	pub struct RecipeBookEntry {
  1156	    /// `RecipeDisplayEntry.id` (`RecipeDisplayId.java:7`).
  1157	    pub display_id: i32,
  1158	    /// `FLAG_NOTIFICATION` (`ClientboundRecipeBookAddPacket.java:30`).
  1159	    pub notification: bool,
  1160	    /// `FLAG_HIGHLIGHT` (`ClientboundRecipeBookAddPacket.java:31`).
  1161	    pub highlight: bool,
  1162	}
  1163	
  1164	impl RecipeBookEntry {
  1165	    /// A newly unlocked recipe, `ServerRecipeBook.addRecipes`
  1166	    /// (`ServerRecipeBook.java:70-72`): notification from the recipe's own
  1167	    /// `showNotification`, highlight always set.
  1168	    #[must_use]
  1169	    pub fn unlocked(display_id: i32) -> Self {
  1170	        Self {
  1171	            display_id,
  1172	            notification: show_notification(display_id),
  1173	            highlight: true,
  1174	        }
  1175	    }
  1176	
  1177	    /// The `flags` byte, `ClientboundRecipeBookAddPacket.Entry`
  1178	    /// (`ClientboundRecipeBookAddPacket.java:40-42`): bit 0 notification, bit 1
  1179	    /// highlight. Unlike [`entry_flags`], vanilla never clears these for a
  1180	    /// `replace` packet.
  1181	    #[must_use]
  1182	    pub const fn flags(&self) -> u8 {
  1183	        (if self.notification {
  1184	            ENTRY_FLAG_NOTIFICATION
  1185	        } else {
  1186	            0
  1187	        }) | (if self.highlight {
  1188	            ENTRY_FLAG_HIGHLIGHT
  1189	        } else {
  1190	            0
  1191	        })
  1192	    }
  1193	
  1194	    /// An already-known recipe, `ServerRecipeBook.sendInitialRecipeBook`
  1195	    /// (`ServerRecipeBook.java:117`): notification never set, highlight only for a
  1196	    /// recipe the player has not seen displayed yet.
  1197	    #[must_use]
  1198	    pub const fn known(display_id: i32, highlight: bool) -> Self {
  1199	        Self {
  1200	            display_id,
  1201	            notification: false,
  1202	            highlight,
  1203	        }
  1204	    }
  1205	}
  1206	
  1207	/// `Recipe.showNotification()` for the recipe that carries this display id.
  1208	/// Only shaped crafting recipes model the flag; everything else defaults to true,
  1209	/// exactly as [`CRecipeBookAdd`] assumes.
  1210	#[must_use]
  1211	fn show_notification(display_id: i32) -> bool {
  1212	    let mut index = 0;
  1213	    for recipe in RECIPES_CRAFTING {
  1214	        let notification = match recipe {
  1215	            CraftingRecipeTypes::CraftingShaped {
  1216	                show_notification, ..
  1217	            } => *show_notification,
  1218	            CraftingRecipeTypes::CraftingShapeless { .. }
  1219	            | CraftingRecipeTypes::CraftingTransmute { .. }
  1220	            | CraftingRecipeTypes::CraftingDye { .. }
  1221	            | CraftingRecipeTypes::CraftingImbue { .. } => true,
  1222	            CraftingRecipeTypes::CraftingDecoratedPot { .. }
  1223	            | CraftingRecipeTypes::CraftingSpecial => continue,
  1224	        };
  1225	        if index == display_id {
  1226	            return notification;
  1227	        }
  1228	        index += 1;
  1229	    }
  1230	    true
  1231	}

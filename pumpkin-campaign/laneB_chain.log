   239	      ObjectArrayList<Holder<Biome>> biomes = new ObjectArrayList<>(this.quartCountPerColumn());
   240	      biomes.size(this.quartCountPerColumn());
   241	
   242	      for (int quartIndex = 0; quartIndex < biomes.size(); quartIndex++) {
   243	         int quartY = quartIndex + QuartPos.fromBlock(this.areaWithOldGeneration.getMinY());
   244	         biomes.set(quartIndex, chunk.getNoiseBiome(QuartPos.fromBlock(blockX), quartY, QuartPos.fromBlock(blockZ)));
   245	      }
   246	
   247	      return biomes;
   248	   }

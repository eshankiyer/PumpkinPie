   344	async fn lower_fill_level(world: &Arc<World>, position: &BlockPos, block: &Block) {
   345	    let state_id = world.get_block_state_id(position);
   346	    let level = WaterCauldronLikeProperties::from_state_id(state_id, block).level;
   347	
   348	    let new_state_id = if level <= 1 {
   349	        Block::CAULDRON.default_state.id
   350	    } else {
   351	        let mut props = WaterCauldronLikeProperties::default(&Block::WATER_CAULDRON);
   352	        props.level = level - 1;
   353	        props.to_state_id(&Block::WATER_CAULDRON)
   354	    };
   355	
   356	    world
   357	        .set_block_state(position, new_state_id, BlockFlags::NOTIFY_ALL)
   358	        .await;
   359	    emit_game_event(
   360	        world,
   361	        GameEvent::BlockChange,
   362	        position.to_centered_f64(),
   363	        GameEventContext::none(),
   364	    )
   365	    .await;
   366	}

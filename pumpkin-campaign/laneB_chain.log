  1233	/// `ClientboundRecipeBookAddPacket` carrying a per-player subset.
  1234	///
  1235	/// A subset is what vanilla always sends: `ServerRecipeBook.addRecipes`
  1236	/// (`ServerRecipeBook.java:61-80`) sends only the newly unlocked entries with
  1237	/// `replace = false`, and `ServerRecipeBook.sendInitialRecipeBook`
  1238	/// (`ServerRecipeBook.java:112-121`) sends the known set with `replace = true`.
  1239	///
  1240	/// [`CRecipeBookAdd`] emits every entry of `RECIPES_CRAFTING` and `RECIPES_COOKING`
  1241	/// unconditionally and so cannot express either; this type shares its entry writer
  1242	/// and its display-id numbering, so an entry written here is byte-identical to the
  1243	/// same entry written there.
  1244	///
  1245	/// Note that vanilla's per-entry flags are independent of `replace`
  1246	/// (`ClientboundRecipeBookAddPacket.java:40-42`), unlike [`entry_flags`], which
  1247	/// zeroes them whenever `replace` is set.
  1248	#[java_packet(RECIPE_BOOK_ADD)]
  1249	pub struct CRecipeBookAddSubset<'a> {
  1250	    pub replace: bool,
  1251	    pub entries: &'a [RecipeBookEntry],
  1252	}
  1253	
  1254	impl<'a> CRecipeBookAddSubset<'a> {
  1255	    #[must_use]
  1256	    pub const fn new(replace: bool, entries: &'a [RecipeBookEntry]) -> Self {
  1257	        Self { replace, entries }
  1258	    }
  1259	}

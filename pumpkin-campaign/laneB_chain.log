  1286	/// Shared state of one subset write: the display-id cursor and the group-id table,
  1287	/// both advanced for every eligible recipe so that a selected entry lands on exactly
  1288	/// the id and group [`CRecipeBookAdd`] would have given it.
  1289	struct SubsetWriter<'a> {
  1290	    wanted: HashMap<i32, RecipeBookEntry>,
  1291	    stations: Stations,
  1292	    version: JavaMinecraftVersion,
  1293	    body: Vec<u8>,
  1294	    written: i32,
  1295	    display_id: i32,
  1296	    group_ids: HashMap<Cow<'a, str>, i32>,
  1297	    next_group_id: i32,
  1298	}
  1299	
  1300	impl SubsetWriter<'_> {
  1301	    fn write_crafting(&mut self) -> Result<(), WritingError> {
  1302	        for recipe in RECIPES_CRAFTING {
  1303	            let group = match recipe {
  1304	                CraftingRecipeTypes::CraftingShaped { group, .. }
  1305	                | CraftingRecipeTypes::CraftingShapeless { group, .. }
  1306	                | CraftingRecipeTypes::CraftingTransmute { group, .. }
  1307	                | CraftingRecipeTypes::CraftingDye { group, .. }
  1308	                | CraftingRecipeTypes::CraftingImbue { group, .. } => group.map(Cow::Borrowed),
  1309	                // No display, no display id: `CRecipeBookAdd` skips these too.
  1310	                CraftingRecipeTypes::CraftingDecoratedPot { .. }
  1311	                | CraftingRecipeTypes::CraftingSpecial => continue,
  1312	            };
  1313	            let group_id =
  1314	                resolve_group_id_owned(&mut self.group_ids, &mut self.next_group_id, group);
  1315	            if let Some(entry) = self.wanted.get(&self.display_id).copied() {
  1316	                self.emit(entry, group_id, Some(recipe), None)?;
  1317	            }
  1318	            self.display_id += 1;
  1319	        }
  1320	        Ok(())
  1321	    }
  1322	
  1323	    fn write_cooking(&mut self) -> Result<(), WritingError> {
  1324	        for recipe in RECIPES_COOKING {
  1325	            let (book_category, group) = cooking_category_and_group(recipe);
  1326	            let group_id = resolve_group_id_owned(
  1327	                &mut self.group_ids,
  1328	                &mut self.next_group_id,
  1329	                group.map(Cow::Borrowed),
  1330	            );
  1331	            if let Some(entry) = self.wanted.get(&self.display_id).copied() {
  1332	                self.emit(entry, group_id, None, Some((recipe, book_category)))?;
  1333	            }
  1334	            self.display_id += 1;
  1335	        }
  1336	        Ok(())
  1337	    }
  1338	
  1339	    fn emit(
  1340	        &mut self,
  1341	        entry: RecipeBookEntry,
  1342	        group_id: Option<i32>,
  1343	        crafting_recipe: Option<&CraftingRecipeTypes>,
  1344	        cooking_recipe: Option<(&CookingRecipeType, i32)>,
  1345	    ) -> Result<(), WritingError> {
  1346	        if write_entry(
  1347	            &mut self.body,
  1348	            self.display_id,
  1349	            self.version,
  1350	            group_id,
  1351	            entry.flags(),
  1352	            self.stations.crafting_table,
  1353	            self.stations.furnace,
  1354	            self.stations.blast_furnace,
  1355	            self.stations.smoker,
  1356	            self.stations.campfire,
  1357	            crafting_recipe,
  1358	            cooking_recipe,
  1359	        )? {
  1360	            self.written += 1;
  1361	        }
  1362	        Ok(())
  1363	    }
  1364	}
  1365	
  1366	/// The recipe-book category id and group of one cooking recipe, matching what
  1367	/// [`CRecipeBookAdd`] derives for the same entry.
  1368	const fn cooking_category_and_group(recipe: &CookingRecipeType) -> (i32, Option<&'static str>) {
  1369	    match recipe {
  1370	        CookingRecipeType::Smelting(r) => (
  1371	            match r.category {
  1372	                RecipeCategoryTypes::Food => CATEGORY_FURNACE_FOOD,
  1373	                RecipeCategoryTypes::Blocks => CATEGORY_FURNACE_BLOCKS,
  1374	                _ => CATEGORY_FURNACE_MISC,
  1375	            },
  1376	            r.group,
  1377	        ),
  1378	        CookingRecipeType::Blasting(r) => (
  1379	            match r.category {
  1380	                RecipeCategoryTypes::Blocks => CATEGORY_BLAST_FURNACE_BLOCKS,
  1381	                _ => CATEGORY_BLAST_FURNACE_MISC,
  1382	            },
  1383	            r.group,
  1384	        ),
  1385	        CookingRecipeType::Smoking(r) => (CATEGORY_SMOKER_FOOD, r.group),
  1386	        CookingRecipeType::CampfireCooking(r) => (CATEGORY_CAMPFIRE, r.group),
  1387	    }
  1388	}

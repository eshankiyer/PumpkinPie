    91	
    92	   @Override
    93	   public String debugString() {
    94	      return this.getClass().getSimpleName();
    95	   }
    96	
    97	   protected boolean hasRequiredMemories(final E body) {
    98	      for (Entry<MemoryModuleType<?>, MemoryStatus> entry : this.entryCondition.entrySet()) {
    99	         MemoryModuleType<?> memoryType = entry.getKey();
   100	         MemoryStatus requiredStatus = entry.getValue();
   101	         if (!body.getBrain().checkMemory(memoryType, requiredStatus)) {
   102	            return false;
   103	         }
   104	      }
   105	
   106	      return true;
   107	   }

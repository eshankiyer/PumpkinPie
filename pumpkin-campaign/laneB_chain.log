  1424	#[cfg(test)]
  1425	mod tests {
  1426	    use super::*;
  1427	
  1428	    const VERSION: JavaMinecraftVersion = JavaMinecraftVersion::V_26_2;
  1429	
  1430	    fn encode_subset(replace: bool, entries: &[RecipeBookEntry]) -> Vec<u8> {
  1431	        let mut buf = Vec::new();
  1432	        CRecipeBookAddSubset::new(replace, entries)
  1433	            .write_packet_data(&mut buf, &VERSION)
  1434	            .expect("write");
  1435	        buf
  1436	    }
  1437	
  1438	    #[test]
  1439	    fn empty_subset_is_count_zero_then_the_replace_flag() {
  1440	        assert_eq!(encode_subset(false, &[]), vec![0x00, 0x00]);
  1441	        assert_eq!(encode_subset(true, &[]), vec![0x00, 0x01]);
  1442	    }
  1443	
  1444	    #[test]
  1445	    fn entry_count_leads_and_replace_flag_trails() {
  1446	        let bytes = encode_subset(
  1447	            true,
  1448	            &[RecipeBookEntry {
  1449	                display_id: 0,
  1450	                notification: false,
  1451	                highlight: false,
  1452	            }],
  1453	        );
  1454	        assert_eq!(bytes[0], 0x01, "one entry");
  1455	        // The entry's own first byte is its RecipeDisplayId VarInt.
  1456	        assert_eq!(bytes[1], 0x00);
  1457	        assert_eq!(*bytes.last().expect("non-empty"), 0x01, "replace = true");
  1458	    }
  1459	
  1460	    #[test]
  1461	    fn flags_byte_is_the_last_byte_of_an_entry_and_ignores_replace() {
  1462	        for (notification, highlight, expected) in [
  1463	            (false, false, 0x00u8),
  1464	            (true, false, 0x01),
  1465	            (false, true, 0x02),
  1466	            (true, true, 0x03),
  1467	        ] {
  1468	            for replace in [false, true] {
  1469	                let bytes = encode_subset(
  1470	                    replace,
  1471	                    &[RecipeBookEntry {
  1472	                        display_id: 0,
  1473	                        notification,
  1474	                        highlight,
  1475	                    }],
  1476	                );
  1477	                let len = bytes.len();
  1478	                assert_eq!(
  1479	                    bytes[len - 2],
  1480	                    expected,
  1481	                    "flags for ({notification}, {highlight}, replace={replace})"
  1482	                );
  1483	            }
  1484	        }
  1485	    }
  1486	
  1487	    /// An entry written here must be byte-identical to the same entry written by the
  1488	    /// full-table writer, so the client's `RecipeDisplayId`s keep meaning the same
  1489	    /// recipe whichever packet delivered them.
  1490	    #[test]
  1491	    fn subset_entries_match_the_full_packet_byte_for_byte() {
  1492	        let full = {
  1493	            let mut buf = Vec::new();
  1494	            CRecipeBookAdd::new(false, &[])
  1495	                .write_packet_data(&mut buf, &VERSION)
  1496	                .expect("write");
  1497	            buf
  1498	        };
  1499	
  1500	        // The full packet is: VarInt count, entries..., replace bool. Its per-entry
  1501	        // flags are notification|highlight with highlight = !replace, so replace=false
  1502	        // gives highlight = true.
  1503	        let mut cursor = 0usize;
  1504	        let (total, len) = read_var_int(&full[cursor..]);
  1505	        cursor += len;
  1506	        assert!(total > 8, "expected a populated recipe table, got {total}");
  1507	
  1508	        // Walk every entry by re-encoding each one alone and matching the prefix,
  1509	        // which both locates the boundary and proves the bytes are equal. Covering
  1510	        // the whole table is what catches cooking-category and group-id drift.
  1511	        for display_id in 0..total {
  1512	            let one = encode_subset(
  1513	                false,
  1514	                &[RecipeBookEntry {
  1515	                    display_id,
  1516	                    notification: show_notification(display_id),
  1517	                    highlight: true,
  1518	                }],
  1519	            );
  1520	            // Strip the leading count (0x01) and the trailing replace flag.
  1521	            let entry = &one[1..one.len() - 1];
  1522	            assert_eq!(
  1523	                &full[cursor..cursor + entry.len()],
  1524	                entry,
  1525	                "entry {display_id} differs between the full and subset writers"
  1526	            );
  1527	            cursor += entry.len();
  1528	        }
  1529	        assert_eq!(
  1530	            cursor,
  1531	            full.len() - 1,
  1532	            "the full packet must be exactly its entries plus the trailing replace flag"
  1533	        );
  1534	    }
  1535	
  1536	    fn read_var_int(bytes: &[u8]) -> (i32, usize) {
  1537	        let mut value: i32 = 0;
  1538	        let mut position = 0;
  1539	        let mut index = 0;
  1540	        loop {
  1541	            let byte = bytes[index];
  1542	            value |= i32::from(byte & 0x7F) << position;
  1543	            index += 1;
  1544	            if byte & 0x80 == 0 {
  1545	                return (value, index);
  1546	            }
  1547	            position += 7;
  1548	        }
  1549	    }
  1550	}


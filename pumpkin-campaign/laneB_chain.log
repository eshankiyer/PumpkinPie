   542	impl ClientPacket for CLightUpdate {
   543	    fn write_packet_data(
   544	        &self,
   545	        mut write: impl Write,
   546	        version: &JavaMinecraftVersion,
   547	    ) -> Result<(), WritingError> {
   548	        write.write_var_int(&self.chunk_x)?;
   549	        write.write_var_int(&self.chunk_z)?;
   550	        self.light_data.write(&mut write, version)
   551	    }

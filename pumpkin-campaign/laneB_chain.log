     9	/// Calculates the experience for one furnace recipe entry.
    10	///
    11	/// Vanilla rounds each recipe entry independently: it floors `amount * experience`, then awards
    12	/// the remaining fractional point when a single random float is below that fraction. Keeping the
    13	/// random source injectable makes the boundary behaviour testable without probabilistic tests.
    14	pub(crate) fn experience_for_recipe<R>(amount: u32, experience: f32, random: &mut R) -> i32
    15	where
    16	    R: FnMut() -> f32,
    17	{
    18	    let exact_experience = amount as f32 * experience;
    19	    let mut reward = exact_experience.floor() as i32;
    20	    let fraction = exact_experience.fract();
    21	
    22	    if fraction != 0.0 && random() < fraction {
    23	        reward += 1;
    24	    }
    25	
    26	    reward
    27	}

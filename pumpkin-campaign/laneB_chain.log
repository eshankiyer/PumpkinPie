   166	    fn on_state_replaced<'a>(&'a self, args: OnStateReplacedArgs<'a>) -> BlockFuture<'a, ()> {
   167	        Box::pin(async move {
   168	            // `AbstractFurnaceBlock.affectNeighborsAfterRemoval` (`AbstractFurnaceBlock.java:57-60`)
   169	            // refreshes comparator inputs after the blast furnace is removed.

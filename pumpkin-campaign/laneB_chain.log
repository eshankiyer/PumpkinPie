   359	   private static int getOutsideIndex(final int x, final int z) {
   360	      return CELL_COLUMN_INSIDE_COUNT + x + CELL_HORIZONTAL_MAX_INDEX_OUTSIDE - z;
   361	   }
   362	
   363	   private static int getX(final int index) {
   364	      if (index < CELL_COLUMN_INSIDE_COUNT) {
   365	         return zeroIfNegative(CELL_HORIZONTAL_MAX_INDEX_INSIDE - index);
   366	      }
   367	
   368	      int offsetIndex = index - CELL_COLUMN_INSIDE_COUNT;
   369	      return CELL_HORIZONTAL_MAX_INDEX_OUTSIDE - zeroIfNegative(CELL_HORIZONTAL_MAX_INDEX_OUTSIDE - offsetIndex);
   370	   }
   371	
   372	   private static int getZ(final int index) {
   373	      if (index < CELL_COLUMN_INSIDE_COUNT) {
   374	         return zeroIfNegative(index - CELL_HORIZONTAL_MAX_INDEX_INSIDE);
   375	      }
   376	
   377	      int offsetIndex = index - CELL_COLUMN_INSIDE_COUNT;
   378	      return CELL_HORIZONTAL_MAX_INDEX_OUTSIDE - zeroIfNegative(offsetIndex - CELL_HORIZONTAL_MAX_INDEX_OUTSIDE);
   379	   }

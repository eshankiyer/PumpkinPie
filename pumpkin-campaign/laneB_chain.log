    50	/// Java's `DataLayer.isEmpty()` is `data == null && defaultValue == 0`
    51	/// (`DataLayer.java:141-143`), so it is true only for an implicit zero-filled layer.
    52	/// `Empty(15)` is a uniform layer in Pumpkin's storage representation, but it is a real
    53	/// full-data layer in the wire protocol and must be included in the data mask with a
    54	/// serialized 0xFF array.
    55	pub(super) const fn light_container_has_data(container: &LightContainer) -> bool {
    56	    !matches!(container, LightContainer::Empty(0))

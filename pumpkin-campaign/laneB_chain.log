    76	
    77	   protected void stop(final ServerLevel level, final E body, final long timestamp) {
    78	   }
    79	
    80	   protected boolean canStillUse(final ServerLevel level, final E body, final long timestamp) {
    81	      return false;
    82	   }
    83	
    84	   protected boolean timedOut(final long timestamp) {
    85	      return timestamp > this.endTimestamp;

   208	/// Write a single Ingredient as a `HolderSet`<Item> for craftingRequirements.
   209	///
   210	/// Vanilla wire format for `ByteBufCodecs.holderSet(Registries.ITEM)`:
   211	///   VarInt(0)     -> named tag reference (followed by `ResourceLocation`)
   212	///   VarInt(n + 1) -> direct list of n item IDs
   213	fn write_ingredient_holderset(
   214	    write: &mut impl Write,
   215	    ingredient: &RecipeIngredientTypes,
   216	    version: JavaMinecraftVersion,
   217	) -> Result<(), WritingError> {
   218	    match ingredient {
   219	        RecipeIngredientTypes::Simple(id) => {
   220	            let key = id.strip_prefix("minecraft:").unwrap_or(id);
   221	            // 1 item -> VarInt(1 + 1) = VarInt(2)
   222	            write.write_var_int(&VarInt(2))?;
   223	            if let Some(item) = Item::from_registry_key(key) {
   224	                write.write_var_int(&VarInt(item_id_versioned(item, version)))?;
   225	            } else {
   226	                // Non-empty fallback item to prevent client UnsupportedOperationException
   227	                write.write_var_int(&VarInt(0))?;
   228	            }
   229	        }
   230	        RecipeIngredientTypes::Tagged(tag) => {
   231	            if let Some(items) = resolve_item_tag(tag, version) {
   232	                write.write_var_int(&VarInt(items.len() as i32 + 1))?;
   233	                for item in &items {
   234	                    write.write_var_int(&VarInt(item_id_versioned(item, version)))?;
   235	                }
   236	            } else {
   237	                let tag = tag.strip_prefix('#').unwrap_or(tag);
   238	                let full_tag = if tag.contains(':') {
   239	                    tag.to_string()
   240	                } else {
   241	                    format!("minecraft:{tag}")
   242	                };
   243	                write.write_var_int(&VarInt(0))?;
   244	                write.write_string(&full_tag)?;
   245	            }
   246	        }
   247	        RecipeIngredientTypes::OneOf(ids) => {
   248	            let items: Vec<i32> = ids
   249	                .iter()
   250	                .filter_map(|id| {
   251	                    let key = id.strip_prefix("minecraft:").unwrap_or(id);
   252	                    Item::from_registry_key(key).map(|item| item_id_versioned(item, version))
   253	                })
   254	                .collect();
   255	            if items.is_empty() {
   256	                write.write_var_int(&VarInt(2))?;
   257	                write.write_var_int(&VarInt(0))?;
   258	            } else {
   259	                write.write_var_int(&VarInt(items.len() as i32 + 1))?;
   260	                for id in &items {
   261	                    write.write_var_int(&VarInt(*id))?;
   262	                }
   263	            }
   264	        }
   265	    }
   266	    Ok(())
   267	}
   268	
   269	/// Write the `craftingRequirements: Option<List<Ingredient>>` field (present).
   270	fn write_crafting_requirements(
   271	    write: &mut impl Write,
   272	    slots: &[&RecipeIngredientTypes],
   273	    version: JavaMinecraftVersion,
   274	) -> Result<(), WritingError> {
   275	    write.write_bool(true)?; // present
   276	    write.write_var_int(&VarInt(slots.len() as i32))?;
   277	    for slot in slots {
   278	        write_ingredient_holderset(write, slot, version)?;
   279	    }
   280	    Ok(())
   281	}
   282	
   283	fn write_result_slot_display(
   284	    write: &mut impl Write,
   285	    result: &RecipeResultStruct,
   286	    version: JavaMinecraftVersion,
   287	) -> Result<(), WritingError> {
   288	    let key = result.id.strip_prefix("minecraft:").unwrap_or(result.id);
   289	    if let Some(item) = Item::from_registry_key(key) {
   290	        write_item_stack_slot_display(write, item, result.count, version)?;
   291	    } else {
   292	        write_empty_slot_display(write, version)?;
   293	    }
   294	    Ok(())
   295	}
   296	
   297	fn write_optional_var_int(write: &mut impl Write, value: Option<i32>) -> Result<(), WritingError> {
   298	    let encoded = value.map_or(Ok(0), |v| {
   299	        v.checked_add(1)
   300	            .ok_or_else(|| WritingError::Message(format!("group id {v} overflow")))
   301	    })?;
   302	    write.write_var_int(&VarInt(encoded))?;
   303	    Ok(())
   304	}
   305	const fn entry_flags(replace: bool, notification: bool, highlight: bool) -> u8 {
   306	    if replace {
   307	        return 0;
   308	    }
   309	
   310	    (if notification {
   311	        ENTRY_FLAG_NOTIFICATION
   312	    } else {
   313	        0
   314	    }) | (if highlight { ENTRY_FLAG_HIGHLIGHT } else { 0 })
   315	}
   316	
   317	const fn crafting_category(cat: &RecipeCategoryTypes) -> i32 {
   318	    match cat {
   319	        RecipeCategoryTypes::Equipment => CATEGORY_CRAFTING_EQUIPMENT,
   320	        RecipeCategoryTypes::Building | RecipeCategoryTypes::Blocks => CATEGORY_CRAFTING_BUILDING,
   321	        RecipeCategoryTypes::Restone => CATEGORY_CRAFTING_REDSTONE,
   322	        RecipeCategoryTypes::Food | RecipeCategoryTypes::Misc => CATEGORY_CRAFTING_MISC,
   323	    }
   324	}
   325	
   326	/// Writes just the `RecipeDisplay`: the type tag, ingredients/pattern, result, and
   327	/// crafting station.
   328	///
   329	/// This is the part shared between a full `RecipeDisplayEntry` (used by
   330	/// `CRecipeBookAdd`) and a bare `ClientboundPlaceGhostRecipePacket`, which carries a
   331	/// `RecipeDisplay` with no group/category/craftingRequirements/flags attached.
   332	///
   333	/// Returns `Ok(false)` without writing anything when the recipe has no displayable
   334	/// form (special / decorated pot recipes).
   335	#[allow(clippy::too_many_arguments)]
   336	pub fn write_recipe_display(
   337	    write: &mut impl Write,
   338	    version: JavaMinecraftVersion,
   339	    crafting_table: &Item,
   340	    furnace: &Item,
   341	    blast_furnace: &Item,
   342	    smoker: &Item,
   343	    campfire: &Item,
   344	    crafting_recipe: Option<&CraftingRecipeTypes>,
   345	    cooking_recipe: Option<&CookingRecipeType>,
   346	) -> Result<bool, WritingError> {
   347	    if let Some(recipe) = crafting_recipe {
   348	        match recipe {
   349	            CraftingRecipeTypes::CraftingShaped {
   350	                pattern,
   351	                key,
   352	                result,
   353	                ..
   354	            } => {
   355	                // Compute width and height from pattern
   356	                let height = pattern.len() as i32;
   357	                let width = pattern.first().map_or(0, |r| r.len()) as i32;
   358	
   359	                // RecipeDisplay type = shaped (1)
   360	                write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPED))?;
   361	                // width, height
   362	                write.write_var_int(&VarInt(width))?;
   363	                write.write_var_int(&VarInt(height))?;
   364	                // ingredients: flat list, row by row
   365	                write.write_var_int(&VarInt(width * height))?;
   366	                for row in *pattern {
   367	                    for ch in row.chars() {
   368	                        if ch == ' ' {
   369	                            write_empty_slot_display(write, version)?;
   370	                        } else if let Some((_, ingredient)) = key.iter().find(|(k, _)| *k == ch) {
   371	                            write_ingredient_slot_display(write, ingredient, version)?;
   372	                        } else {
   373	                            write_empty_slot_display(write, version)?;
   374	                        }
   375	                    }
   376	                }
   377	                // result
   378	                write_result_slot_display(write, result, version)?;
   379	                // craftingStation
   380	                write_item_slot_display(write, crafting_table, version)?;
   381	            }
   382	            CraftingRecipeTypes::CraftingShapeless {
   383	                ingredients,
   384	                result,
   385	                ..
   386	            } => {
   387	                // RecipeDisplay type = shapeless (0)
   388	                write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPELESS))?;
   389	                // ingredients list
   390	                write.write_var_int(&VarInt(ingredients.len() as i32))?;
   391	                for ing in *ingredients {
   392	                    write_ingredient_slot_display(write, ing, version)?;
   393	                }
   394	                // result
   395	                write_result_slot_display(write, result, version)?;
   396	                // craftingStation
   397	                write_item_slot_display(write, crafting_table, version)?;
   398	            }
   399	            CraftingRecipeTypes::CraftingTransmute {
   400	                input,
   401	                material,
   402	                result,
   403	                ..
   404	            } => {
   405	                // Transmute shown as shapeless with 2 ingredients
   406	                write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPELESS))?;
   407	                write.write_var_int(&VarInt(2))?;
   408	                write_ingredient_slot_display(write, input, version)?;
   409	                write_ingredient_slot_display(write, material, version)?;
   410	                write_result_slot_display(write, result, version)?;
   411	                write_item_slot_display(write, crafting_table, version)?;
   412	            }
   413	            CraftingRecipeTypes::CraftingDye {
   414	                target,
   415	                dye,
   416	                result,
   417	                ..
   418	            }
   419	            | CraftingRecipeTypes::CraftingImbue {
   420	                source: target,
   421	                material: dye,
   422	                result,
   423	                ..
   424	            } => {
   425	                write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPELESS))?;
   426	                write.write_var_int(&VarInt(2))?;
   427	                write_ingredient_slot_display(write, target, version)?;
   428	                write_ingredient_slot_display(write, dye, version)?;
   429	                write_result_slot_display(write, result, version)?;
   430	                write_item_slot_display(write, crafting_table, version)?;
   431	            }
   432	            // Skip special/decorated_pot recipes as they have no useful display
   433	            CraftingRecipeTypes::CraftingDecoratedPot { .. }
   434	            | CraftingRecipeTypes::CraftingSpecial => {
   435	                return Ok(false);
   436	            }
   437	        }
   438	        return Ok(true);
   439	    }
   440	
   441	    if let Some(recipe) = cooking_recipe {
   442	        let (cooking, station) = match recipe {
   443	            CookingRecipeType::Smelting(r) => (r, furnace),
   444	            CookingRecipeType::Blasting(r) => (r, blast_furnace),
   445	            CookingRecipeType::Smoking(r) => (r, smoker),
   446	            CookingRecipeType::CampfireCooking(r) => (r, campfire),
   447	        };
   448	
   449	        // RecipeDisplay type = furnace (2)
   450	        write.write_var_int(&VarInt(RECIPE_DISPLAY_FURNACE))?;
   451	        // ingredient
   452	        write_ingredient_slot_display(write, &cooking.ingredient, version)?;
   453	        // fuel: AnyFuel
   454	        write_any_fuel_slot_display(write, version)?;
   455	        // result
   456	        write_result_slot_display(write, &cooking.result, version)?;
   457	        // craftingStation
   458	        write_item_slot_display(write, station, version)?;
   459	        // duration
   460	        write.write_var_int(&VarInt(cooking.cookingtime))?;
   461	        // experience
   462	        write.write_f32_be(cooking.experience)?;
   463	        return Ok(true);
   464	    }
   465	
   466	    Ok(false)
   467	}
   468	
   469	/// Write a single `RecipeDisplayEntry` + flags byte.
   470	/// Returns `Ok(true)` if written, `Ok(false)` if skipped (special recipe).
   471	#[allow(clippy::too_many_arguments)]
   472	#[allow(clippy::too_many_lines)]
   473	fn write_entry(
   474	    write: &mut impl Write,
   475	    display_id: i32,
   476	    version: JavaMinecraftVersion,
   477	    group_id: Option<i32>,
   478	    flags: u8,
   479	    crafting_table: &Item,
   480	    furnace: &Item,
   481	    blast_furnace: &Item,
   482	    smoker: &Item,
   483	    campfire: &Item,
   484	    crafting_recipe: Option<&CraftingRecipeTypes>,
   485	    cooking_recipe: Option<(&CookingRecipeType, i32)>,
   486	) -> Result<bool, WritingError> {
   487	    if let Some(recipe) = crafting_recipe {
   488	        // Bail out before a single byte is written: these have no RecipeDisplay, and
   489	        // emitting the display id for them would leave a stray VarInt in the stream.
   490	        if matches!(
   491	            recipe,
   492	            CraftingRecipeTypes::CraftingDecoratedPot { .. } | CraftingRecipeTypes::CraftingSpecial
   493	        ) {
   494	            return Ok(false);
   495	        }
   496	
   497	        // RecipeDisplayId
   498	        write.write_var_int(&VarInt(display_id))?;
   499	        write_recipe_display(
   500	            write,
   501	            version,
   502	            crafting_table,
   503	            furnace,
   504	            blast_furnace,
   505	            smoker,
   506	            campfire,
   507	            Some(recipe),
   508	            None,
   509	        )?;
   510	
   511	        match recipe {
   512	            CraftingRecipeTypes::CraftingShaped {
   513	                category,
   514	                pattern,
   515	                key,
   516	                ..
   517	            } => {
   518	                // group: OptionalVarInt
   519	                write_optional_var_int(write, group_id)?;
   520	                // category
   521	                write.write_var_int(&VarInt(crafting_category(category)))?;
   522	                // craftingRequirements: one HolderSet per non-empty grid slot
   523	                // (Ingredient cannot be empty, so empty slots must be excluded)
   524	                let mut slots: Vec<&RecipeIngredientTypes> = Vec::new();
   525	                for row in *pattern {
   526	                    for ch in row.chars() {
   527	                        if ch != ' '
   528	                            && let Some((_, ing)) = key.iter().find(|(k, _)| *k == ch)
   529	                        {
   530	                            slots.push(ing);
   531	                        }
   532	                    }
   533	                }
   534	                write_crafting_requirements(write, &slots, version)?;
   535	            }
   536	            CraftingRecipeTypes::CraftingShapeless {
   537	                category,
   538	                ingredients,
   539	                ..
   540	            } => {
   541	                write_optional_var_int(write, group_id)?;
   542	                write.write_var_int(&VarInt(crafting_category(category)))?;
   543	                // craftingRequirements: one HolderSet per ingredient
   544	                let slots: Vec<&RecipeIngredientTypes> = ingredients.iter().collect();
   545	                write_crafting_requirements(write, &slots, version)?;
   546	            }
   547	            CraftingRecipeTypes::CraftingTransmute {
   548	                category,
   549	                input,
   550	                material,
   551	                ..
   552	            } => {
   553	                write_optional_var_int(write, group_id)?;
   554	                write.write_var_int(&VarInt(crafting_category(category)))?;
   555	                // craftingRequirements: input + material
   556	                write_crafting_requirements(write, &[input, material], version)?;
   557	            }
   558	            CraftingRecipeTypes::CraftingDye {
   559	                category,
   560	                target,
   561	                dye,
   562	                ..
   563	            } => {
   564	                write_optional_var_int(write, group_id)?;
   565	                write.write_var_int(&VarInt(crafting_category(category)))?;
   566	                write_crafting_requirements(write, &[target, dye], version)?;
   567	            }
   568	            CraftingRecipeTypes::CraftingImbue {
   569	                category,
   570	                source,
   571	                material,
   572	                ..
   573	            } => {
   574	                write_optional_var_int(write, group_id)?;
   575	                write.write_var_int(&VarInt(crafting_category(category)))?;
   576	                write_crafting_requirements(write, &[source, material], version)?;
   577	            }
   578	            // Excluded by the guard above.
   579	            CraftingRecipeTypes::CraftingDecoratedPot { .. }
   580	            | CraftingRecipeTypes::CraftingSpecial => return Ok(false),
   581	        }
   582	        write.write_u8(flags)?;
   583	        return Ok(true);
   584	    }
   585	
   586	    if let Some((recipe, book_category)) = cooking_recipe {
   587	        write.write_var_int(&VarInt(display_id))?;
   588	        write_recipe_display(
   589	            write,
   590	            version,
   591	            crafting_table,
   592	            furnace,
   593	            blast_furnace,
   594	            smoker,
   595	            campfire,
   596	            None,
   597	            Some(recipe),
   598	        )?;
   599	
   600	        let cooking = match recipe {
   601	            CookingRecipeType::Smelting(r)
   602	            | CookingRecipeType::Blasting(r)
   603	            | CookingRecipeType::Smoking(r)
   604	            | CookingRecipeType::CampfireCooking(r) => r,
   605	        };
   606	        // group: OptionalVarInt
   607	        write_optional_var_int(write, group_id)?;
   608	        // category
   609	        write.write_var_int(&VarInt(book_category))?;
   610	        // craftingRequirements: the single ingredient
   611	        write_crafting_requirements(write, &[&cooking.ingredient], version)?;
   612	        write.write_u8(flags)?;
   613	        return Ok(true);
   614	    }
   615	
   616	    Ok(false)
   617	}
   618	
   619	#[allow(clippy::too_many_lines)]
   620	impl ClientPacket for CRecipeBookAdd<'_> {
   621	    fn write_packet_data(
   622	        &self,
   623	        write: impl Write,
   624	        version: &JavaMinecraftVersion,
   625	    ) -> Result<(), WritingError> {
   626	        let mut write = write;
   627	
   628	        // Station items (these IDs are stable across all versions we support)
   629	        let crafting_table = Item::from_registry_key("crafting_table")
   630	            .ok_or_else(|| WritingError::Message("crafting_table item must exist".into()))?;
   631	        let furnace = Item::from_registry_key("furnace")
   632	            .ok_or_else(|| WritingError::Message("furnace item must exist".into()))?;
   633	        let blast_furnace = Item::from_registry_key("blast_furnace")
   634	            .ok_or_else(|| WritingError::Message("blast_furnace item must exist".into()))?;
   635	        let smoker = Item::from_registry_key("smoker")
   636	            .ok_or_else(|| WritingError::Message("smoker item must exist".into()))?;
   637	        let campfire = Item::from_registry_key("campfire")
   638	            .ok_or_else(|| WritingError::Message("campfire item must exist".into()))?;
   639	
   640	        // First pass - count and skip CraftingSpecial and CraftingDecoratedPot entries.
   641	        let crafting_count: usize = RECIPES_CRAFTING
   642	            .iter()
   643	            .filter(|r| {
   644	                !matches!(
   645	                    r,
   646	                    CraftingRecipeTypes::CraftingSpecial
   647	                        | CraftingRecipeTypes::CraftingDecoratedPot { .. }
   648	                )
   649	            })
   650	            .count();
   651	        let dynamic_count = self.dynamic_recipes.len();
   652	        let total = crafting_count + RECIPES_COOKING.len() + dynamic_count;
   653	
   654	        // Entry count (VarInt)
   655	        write.write_var_int(&VarInt(total as i32))?;
   656	
   657	        let mut display_id: i32 = 0;
   658	        let mut group_ids: HashMap<Cow<'_, str>, i32> = HashMap::new();
   659	        let mut next_group_id: i32 = 0;
   660	        let highlight = !self.replace;
   661	
   662	        // Write crafting recipes
   663	        for recipe in RECIPES_CRAFTING {
   664	            let (group, notification) = match recipe {
   665	                CraftingRecipeTypes::CraftingShaped {
   666	                    group,
   667	                    show_notification,
   668	                    ..
   669	                } => (group.map(Cow::Borrowed), *show_notification),
   670	                CraftingRecipeTypes::CraftingShapeless { group, .. }
   671	                | CraftingRecipeTypes::CraftingTransmute { group, .. }
   672	                | CraftingRecipeTypes::CraftingDye { group, .. }
   673	                | CraftingRecipeTypes::CraftingImbue { group, .. } => {
   674	                    (group.map(Cow::Borrowed), true)
   675	                }
   676	                CraftingRecipeTypes::CraftingDecoratedPot { .. }
   677	                | CraftingRecipeTypes::CraftingSpecial => (None, true),
   678	            };
   679	            let group_id = resolve_group_id_owned(&mut group_ids, &mut next_group_id, group);
   680	            let flags = entry_flags(self.replace, notification, highlight);
   681	            let written = write_entry(
   682	                &mut write,
   683	                display_id,
   684	                *version,
   685	                group_id,
   686	                flags,
   687	                crafting_table,
   688	                furnace,
   689	                blast_furnace,
   690	                smoker,
   691	                campfire,
   692	                Some(recipe),
   693	                None,
   694	            )?;
   695	            if written {
   696	                display_id += 1;
   697	            }
   698	        }
   699	
   700	        // Write cooking recipes
   701	        for recipe in RECIPES_COOKING {
   702	            let (book_category, group) = match recipe {
   703	                CookingRecipeType::Smelting(r) => (
   704	                    match r.category {
   705	                        RecipeCategoryTypes::Food => CATEGORY_FURNACE_FOOD,
   706	                        RecipeCategoryTypes::Blocks => CATEGORY_FURNACE_BLOCKS,
   707	                        _ => CATEGORY_FURNACE_MISC,
   708	                    },
   709	                    r.group,
   710	                ),
   711	                CookingRecipeType::Blasting(r) => (
   712	                    match r.category {
   713	                        RecipeCategoryTypes::Blocks => CATEGORY_BLAST_FURNACE_BLOCKS,
   714	                        _ => CATEGORY_BLAST_FURNACE_MISC,
   715	                    },
   716	                    r.group,
   717	                ),
   718	                CookingRecipeType::Smoking(r) => (CATEGORY_SMOKER_FOOD, r.group),
   719	                CookingRecipeType::CampfireCooking(r) => (CATEGORY_CAMPFIRE, r.group),
   720	            };
   721	            let group_id = resolve_group_id_owned(
   722	                &mut group_ids,
   723	                &mut next_group_id,
   724	                group.map(Cow::Borrowed),
   725	            );
   726	            let flags = entry_flags(self.replace, true, highlight);
   727	            write_entry(
   728	                &mut write,
   729	                display_id,
   730	                *version,
   731	                group_id,
   732	                flags,
   733	                crafting_table,
   734	                furnace,
   735	                blast_furnace,
   736	                smoker,
   737	                campfire,
   738	                None,
   739	                Some((recipe, book_category)),
   740	            )?;
   741	            display_id += 1;
   742	        }
   743	
   744	        // Write dynamic recipes
   745	        for recipe in self.dynamic_recipes {
   746	            match recipe {
   747	                DynamicRecipe::Crafting(crafting) => {
   748	                    let (group, flags) = match crafting {
   749	                        crate::codec::recipe::OwnedCraftingRecipe::Shaped {
   750	                            group,
   751	                            show_notification,
   752	                            ..
   753	                        } => (
   754	                            group.as_deref().map(Cow::Borrowed),
   755	                            entry_flags(self.replace, *show_notification, highlight),
   756	                        ),
   757	                        crate::codec::recipe::OwnedCraftingRecipe::Shapeless { group, .. }
   758	                        | crate::codec::recipe::OwnedCraftingRecipe::Dye { group, .. }
   759	                        | crate::codec::recipe::OwnedCraftingRecipe::Imbue { group, .. } => (
   760	                            group.as_deref().map(Cow::Borrowed),
   761	                            entry_flags(self.replace, true, highlight),
   762	                        ),
   763	                    };
   764	                    let group_id =
   765	                        resolve_group_id_owned(&mut group_ids, &mut next_group_id, group);
   766	                    write_dynamic_crafting_entry(
   767	                        &mut write,
   768	                        display_id,
   769	                        *version,
   770	                        group_id,
   771	                        flags,
   772	                        crafting_table,
   773	                        crafting,
   774	                    )?;
   775	                }
   776	                DynamicRecipe::Cooking(cooking) => {
   777	                    let (book_category, group, owned_cooking) = match cooking {
   778	                        crate::codec::recipe::OwnedCookingRecipeType::Smelting(r) => (
   779	                            match r.category {
   780	                                RecipeCategoryTypes::Food => CATEGORY_FURNACE_FOOD,
   781	                                RecipeCategoryTypes::Blocks => CATEGORY_FURNACE_BLOCKS,
   782	                                _ => CATEGORY_FURNACE_MISC,
   783	                            },
   784	                            r.group.as_deref().map(Cow::Borrowed),
   785	                            r,
   786	                        ),
   787	                        crate::codec::recipe::OwnedCookingRecipeType::Blasting(r) => (
   788	                            match r.category {
   789	                                RecipeCategoryTypes::Blocks => CATEGORY_BLAST_FURNACE_BLOCKS,
   790	                                _ => CATEGORY_BLAST_FURNACE_MISC,
   791	                            },
   792	                            r.group.as_deref().map(Cow::Borrowed),
   793	                            r,
   794	                        ),
   795	                        crate::codec::recipe::OwnedCookingRecipeType::Smoking(r) => (
   796	                            CATEGORY_SMOKER_FOOD,
   797	                            r.group.as_deref().map(Cow::Borrowed),
   798	                            r,
   799	                        ),
   800	                        crate::codec::recipe::OwnedCookingRecipeType::CampfireCooking(r) => {
   801	                            (CATEGORY_CAMPFIRE, r.group.as_deref().map(Cow::Borrowed), r)
   802	                        }
   803	                    };
   804	                    let station = match cooking {
   805	                        crate::codec::recipe::OwnedCookingRecipeType::Smelting(_) => furnace,
   806	                        crate::codec::recipe::OwnedCookingRecipeType::Blasting(_) => blast_furnace,
   807	                        crate::codec::recipe::OwnedCookingRecipeType::Smoking(_) => smoker,
   808	                        crate::codec::recipe::OwnedCookingRecipeType::CampfireCooking(_) => {
   809	                            campfire
   810	                        }
   811	                    };
   812	
   813	                    let group_id =
   814	                        resolve_group_id_owned(&mut group_ids, &mut next_group_id, group);
   815	                    let flags = entry_flags(self.replace, true, highlight);
   816	                    write_dynamic_cooking_entry(
   817	                        &mut write,
   818	                        display_id,
   819	                        *version,
   820	                        group_id,
   821	                        flags,
   822	                        station,
   823	                        owned_cooking,
   824	                        book_category,
   825	                    )?;
   826	                }
   827	            }
   828	            display_id += 1;
   829	        }
   830	
   831	        // replace flag
   832	        write.write_bool(self.replace)?;
   833	        Ok(())
   834	    }
   835	}

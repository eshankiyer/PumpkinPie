   257	            let alpha = (closest_distance / 3.0).clamp(0.0, 1.0);
   258	            alpha * noise_value + (1.0 - alpha) * average_density
   259	        }
   260	    }
   261	
   262	    fn get_blending_data_value<F>(&self, cell_x: i32, cell_y: i32, cell_z: i32, getter: F) -> f64
   263	    where
   264	        F: Fn(&BlendingData, i32, i32, i32) -> f64,
   265	    {
   266	        let chunk_x = biome_coords::to_chunk(cell_x);
   267	        let chunk_z = biome_coords::to_chunk(cell_z);
   268	        let min_x = cell_x.trailing_zeros() >= 2;
   269	        let min_z = cell_z.trailing_zeros() >= 2;
   270	
   271	        let mut value = self.get_data_value(&getter, chunk_x, chunk_z, cell_x, cell_y, cell_z);
   272	        if value == f64::MAX {
   273	            if min_x && min_z {
   274	                value =
   275	                    self.get_data_value(&getter, chunk_x - 1, chunk_z - 1, cell_x, cell_y, cell_z);
   276	            }
   277	
   278	            if value == f64::MAX {
   279	                if min_x {
   280	                    value =
   281	                        self.get_data_value(&getter, chunk_x - 1, chunk_z, cell_x, cell_y, cell_z);
   282	                }
   283	
   284	                if value == f64::MAX && min_z {
   285	                    value =
   286	                        self.get_data_value(&getter, chunk_x, chunk_z - 1, cell_x, cell_y, cell_z);
   287	                }
   288	            }
   289	        }
   290	
   291	        value
   292	    }
   293	
   294	    fn get_data_value<F>(
   295	        &self,
   296	        getter: &F,
   297	        chunk_x: i32,
   298	        chunk_z: i32,
   299	        cell_x: i32,
   300	        cell_y: i32,
   301	        cell_z: i32,
   302	    ) -> f64
   303	    where
   304	        F: Fn(&BlendingData, i32, i32, i32) -> f64,
   305	    {
   306	        let packed = (chunk_x as u32 as u64) | ((chunk_z as u32 as u64) << 32);
   307	        self.height_and_biome_blending_data
   308	            .get(&packed)
   309	            .map_or(f64::MAX, |data| {
   310	                getter(
   311	                    data,
   312	                    cell_x - biome_coords::from_chunk(chunk_x),
   313	                    cell_y,
   314	                    cell_z - biome_coords::from_chunk(chunk_z),
   315	                )
   316	            })
   317	    }
   318	
   319	    #[must_use]
   320	    pub fn blend_biome(
   321	        &self,
   322	        quart_x: i32,
   323	        quart_y: i32,
   324	        quart_z: i32,
   325	        shift_noise: &DoublePerlinNoiseSampler,
   326	    ) -> Option<&'static Biome> {
   327	        let mut closest_distance = f64::INFINITY;
   328	        let mut closest_biome = None;
   329	
   330	        for (&packed_pos, blending_data) in &self.height_and_biome_blending_data {
   331	            let chunk_x = (packed_pos & 0xFFFFFFFF) as i32;
   332	            let chunk_z = (packed_pos >> 32) as i32;
   333	
   334	            blending_data.iterate_biomes(
   335	                biome_coords::from_chunk(chunk_x),
   336	                quart_y,
   337	                biome_coords::from_chunk(chunk_z),
   338	                |test_cell_x, test_cell_z, biome| {
   339	                    let dx = (quart_x - test_cell_x) as f64;
   340	                    let dz = (quart_z - test_cell_z) as f64;
   341	                    let distance = dx.hypot(dz);
   342	
   343	                    if distance <= HEIGHT_BLENDING_RANGE_CELLS as f64 && distance < closest_distance
   344	                    {
   345	                        closest_biome = Some(biome);
   346	                        closest_distance = distance;
   347	                    }
   348	                },
   349	            );
   350	        }


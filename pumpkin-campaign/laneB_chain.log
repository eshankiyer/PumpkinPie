    44	   private static final int CELL_HORIZONTAL_MAX_INDEX_INSIDE = QUARTS_PER_SECTION - 1;
    45	   private static final int CELL_HORIZONTAL_MAX_INDEX_OUTSIDE = QUARTS_PER_SECTION;
    46	   private static final int CELL_COLUMN_INSIDE_COUNT = 2 * CELL_HORIZONTAL_MAX_INDEX_INSIDE + 1;
    47	   private static final int CELL_COLUMN_OUTSIDE_COUNT = 2 * CELL_HORIZONTAL_MAX_INDEX_OUTSIDE + 1;
    48	   private static final int CELL_COLUMN_COUNT = CELL_COLUMN_INSIDE_COUNT + CELL_COLUMN_OUTSIDE_COUNT;
    49	   private final LevelHeightAccessor areaWithOldGeneration;
    50	   private static final List<Block> SURFACE_BLOCKS = List.of(
    51	      Blocks.PODZOL,
    52	      Blocks.GRAVEL,
    53	      Blocks.GRASS_BLOCK,
    54	      Blocks.STONE,
    55	      Blocks.COARSE_DIRT,
    56	      Blocks.SAND,
    57	      Blocks.RED_SAND,
    58	      Blocks.MYCELIUM,
    59	      Blocks.SNOW_BLOCK,

    32	impl Blender {
    33	    /// Installs the old-chunk carving exclusion used by vanilla's
    34	    /// `Blender.addAroundOldChunksCarvingMaskFilter` (`Blender.java:320-346`). The
    35	    /// generation cache is the Rust equivalent of the vanilla world-generation region.
    36	    pub fn add_around_old_chunks_carving_mask_filter<C: ProtoChunkCache>(cache: &mut C) {
    37	        let center = cache.get_center_chunk();
    38	        let center_x = center.x;
    39	        let center_z = center.z;
    40	        let mut old_chunks = Vec::new();
    41	
    42	        if let Some(data) = &center.blending_data {
    43	            let radius_y = (data.max_y - data.min_y) as f64 / 2.0;
    44	            old_chunks.push((0.0, 0.0, data.min_y as f64 + radius_y, radius_y));
    45	        }
    46	
    47	        for offset_x in -1..=1 {
    48	            for offset_z in -1..=1 {
    49	                if offset_x == 0 && offset_z == 0 {
    50	                    continue;
    51	                }
    52	
    53	                if let Some(data) = cache
    54	                    .get_chunk(center_x + offset_x, center_z + offset_z)
    55	                    .and_then(|chunk| chunk.blending_data.as_ref())
    56	                {
    57	                    let radius_y = (data.max_y - data.min_y) as f64 / 2.0;
    58	                    old_chunks.push((
    59	                        offset_x as f64 * 16.0,
    60	                        offset_z as f64 * 16.0,
    61	                        data.min_y as f64 + radius_y,
    62	                        radius_y,
    63	                    ));
    64	                }
    65	            }
    66	        }
    67	
    68	        if old_chunks.is_empty() {
    69	            return;
    70	        }
    71	
    72	        cache
    73	            .get_center_chunk_mut()
    74	            .carving_mask
    75	            .set_additional_mask(old_chunk_carving_mask_filter(old_chunks));
    76	    }

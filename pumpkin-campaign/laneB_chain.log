   239	/// Carvers always run on the legacy LCG, whatever the dimension's noise settings say about
   240	/// `legacy_random_source`: `NoiseBasedChunkGenerator.applyCarvers`
   241	/// (`NoiseBasedChunkGenerator.java:316`) builds its `WorldgenRandom` over a
   242	/// `LegacyRandomSource`, and each tunnel forks a `RandomSource.createThreadLocalInstance`
   243	/// (`CaveWorldCarver.java:144`, `CanyonWorldCarver.java`), which is a
   244	/// `SingleThreadedRandomSource` - the same 48-bit LCG
   245	/// (`RandomSource.java:31-33`, `SingleThreadedRandomSource.java:6-40`).
   246	const fn new_carver_random(seed: u64) -> RandomGenerator {
   247	    RandomGenerator::Legacy(pumpkin_util::random::legacy_rand::LegacyRand::from_seed(
   248	        seed,
   249	    ))
   250	}

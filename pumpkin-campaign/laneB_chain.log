   213	   private double[] getDensityColumn(final ChunkAccess chunk, final int x, final int z, final int height) {
   214	      double[] densities = new double[this.cellCountPerColumn()];
   215	      Arrays.fill(densities, -1.0);
   216	      BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos(x, this.areaWithOldGeneration.getMaxY() + 1, z);
   217	      double last7 = read7(chunk, pos);
   218	
   219	      for (int cellIndex = densities.length - 2; cellIndex >= 0; cellIndex--) {
   220	         double one = read1(chunk, pos);
   221	         double current7 = read7(chunk, pos);
   222	         densities[cellIndex] = (last7 + one + current7) / 15.0;
   223	         last7 = current7;
   224	      }
   225	
   226	      int highestCellWithSurfaceIndex = this.getCellYIndex(Mth.floorDiv(height, 8));
   227	      if (highestCellWithSurfaceIndex >= 0 && highestCellWithSurfaceIndex < densities.length - 1) {
   228	         double inCellIndex = (height + 0.5) % 8.0 / 8.0;
   229	         double amplitudeAboveToMakeSurfaceBeAtHeight = (1.0 - inCellIndex) / inCellIndex;
   230	         double max = Math.max(amplitudeAboveToMakeSurfaceBeAtHeight, 1.0) * 0.25;
   231	         densities[highestCellWithSurfaceIndex + 1] = -amplitudeAboveToMakeSurfaceBeAtHeight / max;
   232	         densities[highestCellWithSurfaceIndex] = 1.0 / max;
   233	      }
   234	
   235	      return densities;
   236	   }

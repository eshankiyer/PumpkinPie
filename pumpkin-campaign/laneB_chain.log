   129	
   130	    let start_x = crate::generation::positions::chunk_pos::start_block_x(chunk_x);
   131	    let start_z = crate::generation::positions::chunk_pos::start_block_z(chunk_z);
   132	    let generation_shape = &generator.settings.shape;
   133	    let horizontal_cell_count = 16 / generation_shape.horizontal_cell_block_count();
   134	
   135	    let horizontal_biome_end = crate::generation::biome_coords::from_block(
   136	        horizontal_cell_count as i32 * generation_shape.horizontal_cell_block_count() as i32,
   137	    );
   138	    let surface_config = SurfaceHeightSamplerBuilderOptions::new(
   139	        crate::generation::biome_coords::from_block(start_x),
   140	        crate::generation::biome_coords::from_block(start_z),
   141	        horizontal_biome_end as usize,
   142	        generation_shape.min_y as i32,
   143	        generation_shape.max_y() as i32,
   144	        generation_shape.vertical_cell_block_count() as usize,
   145	    );
   146	    let surface_height_sampler = SurfaceHeightEstimateSampler::generate(
   147	        &generator.base_router.surface_estimator,
   148	        &surface_config,
   149	    );
   150	    let carver_aquifer = generator.settings.aquifers_enabled.then(|| {
   151	        CarverAquiferSampler::new(
   152	            chunk_x,
   153	            chunk_z,
   154	            &generator.base_router,
   155	            &generator.random_config,
   156	            generator.settings,
   157	        )
   158	    });
   159	
   160	    let mut context = CarvingContext {
   161	        min_y: generator.dimension.min_y as i8,
   162	        height: generator.dimension.logical_height as u16,
   163	        random_config: &generator.random_config,
   164	        surface_noise: &generator.terrain_cache.surface_noise,
   165	        secondary_noise: &generator.terrain_cache.secondary_noise,
   166	        terrain_builder: &generator.terrain_cache.terrain_builder,
   167	        sea_level: generator.settings.sea_level,
   168	        surface_rule: &generator.settings.surface_rule,
   169	        surface_height_sampler,
   170	        carver_aquifer,
   171	    };
   172	
   173	    let mut run = CarveRun {
   174	        ctx: &mut context,
   175	        chunk,
   176	        ids: CarverBlockIds::new(),
   177	    };
   178	
   179	    let cave_carver = cave::CaveCarver;
   180	    let canyon_carver = canyon::CanyonCarver;
   181	
   182	    for dx in -radius..=radius {
   183	        for dz in -radius..=radius {
   184	            let carver_x = chunk_x + dx;
   185	            let carver_z = chunk_z + dz;
   186	            let carver_chunk_pos = Vector2::new(carver_x, carver_z);
   187	
   188	            // In vanilla, carvers are per-biome. Here we use the hardcoded list but
   189	            // maintain the random seed logic.
   190	            for (index, &config) in carvers_to_use.iter().enumerate() {
   191	                let seed = get_large_feature_seed(
   192	                    generator.random_config.seed + index as u64,
   193	                    carver_x,
   194	                    carver_z,
   195	                );
   196	                let mut carver_random = new_carver_random(seed);
   197	
   198	                if should_carve(config, &mut carver_random) {
   199	                    match config.additional {
   200	                        CarverAdditionalConfig::Cave(_) | CarverAdditionalConfig::NetherCave(_) => {
   201	                            cave_carver.carve(
   202	                                config,
   203	                                &mut run,
   204	                                &mut carver_random,
   205	                                &chunk_pos,
   206	                                &carver_chunk_pos,
   207	                            );
   208	                        }
   209	                        CarverAdditionalConfig::Canyon(_) => {
   210	                            canyon_carver.carve(
   211	                                config,
   212	                                &mut run,
   213	                                &mut carver_random,
   214	                                &chunk_pos,
   215	                                &carver_chunk_pos,
   216	                            );
   217	                        }
   218	                    }
   219	                }
   220	            }
   221	        }
   222	    }
   223	}
   224	
   225	fn should_carve(config: &CarverConfig, random: &mut RandomGenerator) -> bool {
   226	    random.next_f32() <= config.probability
   227	}
   228	
   229	fn get_large_feature_seed(seed: u64, chunk_x: i32, chunk_z: i32) -> u64 {
   230	    let mut random = pumpkin_util::random::legacy_rand::LegacyRand::from_seed(seed);
   231	    let x_scale = random.next_i64();
   232	    let z_scale = random.next_i64();
   233	    let seed = seed as i64;
   234	    let result =
   235	        (chunk_x as i64).wrapping_mul(x_scale) ^ (chunk_z as i64).wrapping_mul(z_scale) ^ seed;
   236	    result as u64
   237	}
   238	
   239	/// Carvers always run on the legacy LCG, whatever the dimension's noise settings say about
   240	/// `legacy_random_source`: `NoiseBasedChunkGenerator.applyCarvers`
   241	/// (`NoiseBasedChunkGenerator.java:316`) builds its `WorldgenRandom` over a
   242	/// `LegacyRandomSource`, and each tunnel forks a `RandomSource.createThreadLocalInstance`
   243	/// (`CaveWorldCarver.java:144`, `CanyonWorldCarver.java`), which is a
   244	/// `SingleThreadedRandomSource` - the same 48-bit LCG
   245	/// (`RandomSource.java:31-33`, `SingleThreadedRandomSource.java:6-40`).
   246	const fn new_carver_random(seed: u64) -> RandomGenerator {
   247	    RandomGenerator::Legacy(pumpkin_util::random::legacy_rand::LegacyRand::from_seed(
   248	        seed,
   249	    ))
   250	}
   251	
   252	fn carvers_for_dimension(dimension: &Dimension) -> &'static [&'static CarverConfig] {
   253	    if dimension == &Dimension::OVERWORLD {
   254	        &OVERWORLD_CARVERS
   255	    } else if dimension == &Dimension::THE_NETHER {
   256	        &NETHER_CARVERS
   257	    } else {
   258	        &[]
   259	    }
   260	}
   261	
   262	fn carve_top_material(
   263	    run: &mut CarveRun,
   264	    x: i32,
   265	    carved_y: i32,
   266	    z: i32,
   267	    carved_state: &'static BlockState,
   268	    has_grass: bool,
   269	    overworld: bool,
   270	) {
   271	    if !overworld || !has_grass {
   272	        return;
   273	    }
   274	
   275	    let below_y = carved_y - 1;
   276	    let below_state = run.chunk.get_block_state(&Vector3::new(x, below_y, z));
   277	    if below_state != run.ids.dirt.id {
   278	        return;
   279	    }
   280	
   281	    let steep = steep_material_condition(run.chunk, x, z);
   282	    if let Some(top_material) =
   283	        run.ctx
   284	            .top_material(run.chunk, x, below_y, z, carved_state.is_liquid(), steep)
   285	    {
   286	        run.chunk.set_block_state(x, below_y, z, top_material);
   287	
   288	        schedule_fluid_tick_for_state(run.chunk, x, below_y, z, top_material);
   289	    }
   290	}
   291	
   292	fn overworld_carve_state(
   293	    run: &mut CarveRun,
   294	    config: &CarverConfig,
   295	    x: i32,
   296	    y: i32,
   297	    z: i32,
   298	) -> Option<(&'static BlockState, bool)> {
   299	    let lava_y = config.lava_level.get_y(
   300	        run.chunk.generation_bottom_y() as i16,
   301	        run.chunk.generation_height(),
   302	    );
   303	
   304	    if y <= lava_y {
   305	        return Some((run.ids.lava, false));
   306	    }
   307	
   308	    let Some(aquifer) = run.ctx.carver_aquifer.as_mut() else {
   309	        return Some((run.ids.air, false));
   310	    };
   311	
   312	    let result = aquifer.compute(&Vector3::new(x, y, z), 0.0);
   313	    result
   314	        .state
   315	        .map(|state| (state, result.should_schedule_fluid_update))
   316	}
   317	
   318	fn place_carved_block(
   319	    run: &mut CarveRun,
   320	    pos: Vector3<i32>,
   321	    state: &'static BlockState,
   322	    should_schedule_fluid_update: bool,
   323	    has_grass: bool,
   324	    overworld: bool,
   325	) {
   326	    run.chunk.set_block_state(pos.x, pos.y, pos.z, state);
   327	
   328	    if overworld && should_schedule_fluid_update && state.is_liquid() {
   329	        schedule_fluid_tick_for_state(run.chunk, pos.x, pos.y, pos.z, state);
   330	    }
   331	
   332	    carve_top_material(run, pos.x, pos.y, pos.z, state, has_grass, overworld);
   333	}
   334	
   335	fn schedule_fluid_tick_for_state(
   336	    chunk: &mut ProtoChunk,
   337	    x: i32,
   338	    y: i32,
   339	    z: i32,
   340	    state: &'static BlockState,
   341	) {
   342	    if state.id == pumpkin_data::Block::WATER.default_state.id {
   343	        chunk.schedule_fluid_tick(x, y, z, &Fluid::WATER);
   344	    } else if state.id == pumpkin_data::Block::LAVA.default_state.id {
   345	        chunk.schedule_fluid_tick(x, y, z, &Fluid::LAVA);
   346	    }
   347	}

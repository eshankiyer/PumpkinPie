    51	fn enchantments_for_crafting(stack: &ItemStack) -> Vec<(&'static Enchantment, i32)> {
    52	    if stack.item == &Item::ENCHANTED_BOOK {
    53	        stack
    54	            .get_data_component::<StoredEnchantmentsImpl>()
    55	            .map(|c| c.enchantment.to_vec())
    56	            .unwrap_or_default()
    57	    } else {

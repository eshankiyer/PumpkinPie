   210	    fn get_sideways_state(trunk_state: &BlockState, axis: Axis) -> &'static BlockState {
   211	        let block = Block::from_state_id(trunk_state.id);
   212	        if let Some(props_source) = block.properties(trunk_state.id) {
   213	            let mut props = props_source.to_props();
   214	            let axis_str = match axis {
   215	                Axis::X => "x",
   216	                Axis::Y => "y",
   217	                Axis::Z => "z",
   218	            };
   219	
   220	            if let Some(idx) = props.iter().position(|(k, _)| *k == "axis") {
   221	                props[idx] = ("axis", axis_str);
   222	            } else {
   223	                props.push(("axis", axis_str));
   224	            }
   225	
   226	            let new_state_id = block.from_properties(&props).to_state_id(block);
   227	            return BlockState::from_id(new_state_id);
   228	        }
   229	        BlockState::from_id(trunk_state.id)
   230	    }
   231	}


   554	impl<'a> ServerPacket<'a> for CLightUpdate {
   555	    fn read(bytebuf: &mut &'a [u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
   556	        let chunk_x = bytebuf.get_var_int()?;
   557	        let chunk_z = bytebuf.get_var_int()?;
   558	        let light_data = LightData::read(bytebuf, version)?;
   559	        Ok(Self {
   560	            chunk_x,
   561	            chunk_z,
   562	            light_data,
   563	        })
   564	    }
   565	}

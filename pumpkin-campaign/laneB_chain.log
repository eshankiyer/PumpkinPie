    98	    fn get_state_for_neighbor_update<'a>(
    99	        &'a self,
   100	        args: GetStateForNeighborUpdateArgs<'a>,
   101	    ) -> BlockFuture<'a, BlockStateId> {
   102	        Box::pin(async move {
   103	            if !can_place_at(args.world, args.position) {
   104	                args.world
   105	                    .schedule_block_tick(args.block, *args.position, 1, TickPriority::Normal);

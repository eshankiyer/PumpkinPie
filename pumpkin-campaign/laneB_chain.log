  1123	#[allow(clippy::too_many_arguments)]
  1124	fn write_dynamic_cooking_entry(
  1125	    write: &mut impl Write,
  1126	    display_id: i32,
  1127	    version: JavaMinecraftVersion,
  1128	    group_id: Option<i32>,

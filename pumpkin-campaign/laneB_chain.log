    58	
    59	/// The 2048-byte nibble array a light container serializes to.
    60	pub(super) fn light_container_bytes(container: &LightContainer) -> Vec<u8> {
    61	    match container {
    62	        LightContainer::Full(data) => data.to_vec(),
    63	        LightContainer::Empty(default) => {
    64	            vec![default << 4 | default; LightContainer::ARRAY_SIZE]
    65	        }
    66	    }
    67	}

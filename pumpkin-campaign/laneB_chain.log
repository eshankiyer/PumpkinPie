   181	        // Least-oxidized merge with the single partner when forming a double chest.
   182	        // `getLeastOxidizedChestOfConnectedBlocks` (CopperChestBlock.java:78-95) only
   183	        // unwaxes either side when `isWaxed()` differs; when both sides have the same wax
   184	        // status, the selected block retains that status.
   185	        let mut final_block = chest_block;
   186	        let mut partner = None;
   187	        if r#type != ChestType::Single
   188	            && let Some(props) = partner_props(connected_dir(r#type))
   189	        {
   190	            let neighbor_pos = pos.offset(connected_dir(r#type).to_block_direction().to_offset());
   191	            let neighbor_block = world.get_block(&neighbor_pos);
   192	            partner = Some((neighbor_pos, props));
   193	            let own_unwaxed = Self::unwax_chest(chest_block).to_block();
   194	            let other_unwaxed = Self::unwax_chest(neighbor_block).to_block();
   195	            let own_is_waxed = own_unwaxed.id != chest_block.id;
   196	            let other_is_waxed = other_unwaxed.id != neighbor_block.id;
   197	            let wax_status_differs = own_is_waxed != other_is_waxed;
   198	            let updated_block = if wax_status_differs {
   199	                own_unwaxed
   200	            } else {
   201	                chest_block
   202	            };
   203	            let updated_neighbor = if wax_status_differs {
   204	                other_unwaxed
   205	            } else {
   206	                neighbor_block
   207	            };
   208	            let own = copper_weathering::oxidation_level_of(own_unwaxed).unwrap_or(0);
   209	            let other = copper_weathering::oxidation_level_of(other_unwaxed).unwrap_or(0);
   210	            final_block = if own <= other {
   211	                updated_block
   212	            } else {
   213	                updated_neighbor
   214	            };
   215	        }
   216	
   217	        let mut props = ChestLikeProperties::default(final_block);
   218	        props.facing = facing;
   219	        props.r#type = r#type;
   220	        world
   221	            .set_block_state(
   222	                pos,
   223	                props.to_state_id(final_block),
   224	                BlockFlags::NOTIFY_LISTENERS,
   225	            )
   226	            .await;

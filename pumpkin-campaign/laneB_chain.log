     8	import net.minecraft.core.BlockPos;
     9	import net.minecraft.core.Direction;
    10	import net.minecraft.util.ExtraCodecs;
    11	import net.minecraft.util.RandomSource;
    12	import net.minecraft.util.valueproviders.IntProvider;
    13	import net.minecraft.util.valueproviders.IntProviders;
    14	import net.minecraft.world.level.WorldGenLevel;
    15	import net.minecraft.world.level.block.state.BlockState;
    16	import net.minecraft.world.level.levelgen.feature.TreeFeature;
    17	import net.minecraft.world.level.levelgen.feature.configurations.TreeConfiguration;
    18	import net.minecraft.world.level.levelgen.feature.foliageplacers.FoliagePlacer;
    19	
    20	public class BendingTrunkPlacer extends TrunkPlacer {
    21	   public static final MapCodec<BendingTrunkPlacer> CODEC = RecordCodecBuilder.mapCodec(
    22	      i -> trunkPlacerParts(i)
    23	         .and(
    24	            i.group(
    25	               ExtraCodecs.POSITIVE_INT.optionalFieldOf("min_height_for_leaves", 1).forGetter(c -> c.minHeightForLeaves),
    26	               IntProviders.codec(1, 64).fieldOf("bend_length").forGetter(c -> c.bendLength)
    27	            )
    28	         )
    29	         .apply(i, BendingTrunkPlacer::new)
    30	   );
    31	   private final int minHeightForLeaves;
    32	   private final IntProvider bendLength;
    33	
    34	   public BendingTrunkPlacer(final int baseHeight, final int heightRandA, final int heightRandB, final int minHeightForLeaves, final IntProvider bendLength) {
    35	      super(baseHeight, heightRandA, heightRandB);
    36	      this.minHeightForLeaves = minHeightForLeaves;
    37	      this.bendLength = bendLength;
    38	   }
    39	
    40	   @Override
    41	   protected TrunkPlacerType<?> type() {
    42	      return TrunkPlacerType.BENDING_TRUNK_PLACER;
    43	   }
    44	
    45	   @Override
    46	   public List<FoliagePlacer.FoliageAttachment> placeTrunk(
    47	      final WorldGenLevel level,
    48	      final BiConsumer<BlockPos, BlockState> trunkSetter,
    49	      final RandomSource random,
    50	      final int treeHeight,
    51	      final BlockPos origin,
    52	      final TreeConfiguration config
    53	   ) {
    54	      Direction direction = Direction.Plane.HORIZONTAL.getRandomDirection(random);
    55	      int logHeight = treeHeight - 1;
    56	      BlockPos.MutableBlockPos pos = origin.mutable();
    57	      BlockPos belowPos = pos.below();
    58	      placeBelowTrunkBlock(level, trunkSetter, random, belowPos, config);
    59	      List<FoliagePlacer.FoliageAttachment> foliagePoints = Lists.newArrayList();
    60	
    61	      for (int i = 0; i <= logHeight; i++) {
    62	         if (i + 1 >= logHeight + random.nextInt(2)) {
    63	            pos.move(direction);
    64	         }
    65	
    66	         if (TreeFeature.validTreePos(level, pos)) {
    67	            this.placeLog(level, trunkSetter, random, pos, config);
    68	         }
    69	
    70	         if (i >= this.minHeightForLeaves) {
    71	            foliagePoints.add(new FoliagePlacer.FoliageAttachment(pos.immutable(), 0, false));
    72	         }
    73	
    74	         pos.move(Direction.UP);
    75	      }
    76	
    77	      int dirLength = this.bendLength.sample(random);
    78	
    79	      for (int i = 0; i <= dirLength; i++) {
    80	         if (TreeFeature.validTreePos(level, pos)) {
    81	            this.placeLog(level, trunkSetter, random, pos, config);
    82	         }
    83	
    84	         foliagePoints.add(new FoliagePlacer.FoliageAttachment(pos.immutable(), 0, false));
    85	         pos.move(direction);
    86	      }
    87	
    88	      return foliagePoints;
    89	   }
    90	}

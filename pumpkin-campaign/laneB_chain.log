   245	        assert_eq!(AngerLevel::by_anger(39), AngerLevel::Calm);
   246	        assert_eq!(AngerLevel::by_anger(40), AngerLevel::Agitated);
   247	        assert_eq!(AngerLevel::by_anger(79), AngerLevel::Agitated);
   248	        assert_eq!(AngerLevel::by_anger(80), AngerLevel::Angry);
   249	        assert_eq!(AngerLevel::by_anger(150), AngerLevel::Angry);

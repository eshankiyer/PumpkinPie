   429	    pub async fn set_repair_cost(&mut self, cost: i16) {
   430	        self.repair_cost = cost;
   431	        if let Some(sync_handler) = self.behaviour.sync_handler.as_ref() {
   432	            let (property_id, property_value) =
   433	                WindowProperty::new(Anvil::RepairCost, cost).into_tuple();
   434	            sync_handler
   435	                .update_property(&self.behaviour, property_id as i32, property_value as i32)
   436	                .await;
   437	        }
   438	    }

    43	   @Override
    44	   public final boolean tryStart(final ServerLevel level, final E body, final long timestamp) {
    45	      if (this.hasRequiredMemories(body) && this.checkExtraStartConditions(level, body)) {
    46	         this.status = Behavior.Status.RUNNING;
    47	         int duration = this.minDuration + level.getRandom().nextInt(this.maxDuration + 1 - this.minDuration);
    48	         this.endTimestamp = timestamp + duration;
    49	         this.start(level, body, timestamp);
    50	         return true;
    51	      } else {
    52	         return false;
    53	      }
    54	   }
    55	

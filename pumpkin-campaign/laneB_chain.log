    77	        LightContainer::Full(data) => write.write_slice(data.as_ref())?,
    78	        LightContainer::Empty(default) => {
    79	            let byte = default << 4 | default;
    80	            write.write_slice(&[byte; LightContainer::ARRAY_SIZE])?;
    81	        }
    82	    }
    83	    Ok(())
    84	}

    16	pub struct BendingTrunkPlacer {
    17	    pub min_height_for_leaves: u32,
    18	    pub bend_length: IntProvider,
    19	}
    20	
    21	impl BendingTrunkPlacer {
    22	    #[expect(clippy::too_many_arguments)]
    23	    pub fn generate<T: GenerationCache>(
    24	        &self,
    25	        block_registry: &dyn WorldPortalExt,
    26	        _placer: &TrunkPlacer,
    27	        height: u32,
    28	        start_pos: BlockPos,
    29	        chunk: &mut T,
    30	        random: &mut RandomGenerator,
    31	        below_trunk_provider: &BlockStateProvider,
    32	        trunk_block: &BlockState,
    33	    ) -> (Vec<TreeNode>, Vec<BlockPos>) {
    34	        let direction = BlockDirection::random_horizontal(random);
    35	        let log_height = height as i32 - 1;
    36	        let mut pos = start_pos;
    37	
    38	        TrunkPlacer::set_dirt(
    39	            block_registry,
    40	            chunk,
    41	            random,
    42	            &pos.down(),
    43	            below_trunk_provider,
    44	        );
    45	
    46	        let mut trunk_poses = Vec::new();
    47	        let mut nodes = Vec::new();
    48	
    49	        for i in 0..=log_height {
    50	            if i + 1 >= log_height + random.next_bounded_i32(2) {
    51	                pos = pos.offset(direction.to_offset());
    52	            }
    53	
    54	            if TrunkPlacer::place(chunk, &pos, trunk_block) {
    55	                trunk_poses.push(pos);
    56	            }
    57	
    58	            if i >= self.min_height_for_leaves as i32 {
    59	                nodes.push(TreeNode {
    60	                    center: pos,
    61	                    foliage_radius: 0,
    62	                    giant_trunk: false,
    63	                });
    64	            }
    65	
    66	            pos = pos.up();
    67	        }
    68	
    69	        let dir_length = self.bend_length.get(random);
    70	
    71	        for _ in 0..=dir_length {
    72	            if TrunkPlacer::place(chunk, &pos, trunk_block) {
    73	                trunk_poses.push(pos);
    74	            }
    75	
    76	            nodes.push(TreeNode {
    77	                center: pos,
    78	                foliage_radius: 0,
    79	                giant_trunk: false,
    80	            });
    81	            pos = pos.offset(direction.to_offset());
    82	        }
    83	
    84	        (nodes, trunk_poses)
    85	    }
    86	}

   176	impl LightData {
   177	    #[must_use]
   178	    pub const fn new(
   179	        trust_edges: bool,
   180	        sky_light_mask: BitSet,
   181	        block_light_mask: BitSet,
   182	        empty_sky_light_mask: BitSet,
   183	        empty_block_light_mask: BitSet,
   184	        sky_light_arrays: Vec<Vec<u8>>,
   185	        block_light_arrays: Vec<Vec<u8>>,
   186	    ) -> Self {
   187	        Self {
   188	            trust_edges,
   189	            sky_light_mask,
   190	            block_light_mask,
   191	            empty_sky_light_mask,
   192	            empty_block_light_mask,
   193	            sky_light_arrays,
   194	            block_light_arrays,
   195	        }
   196	    }
   197	
   198	    pub fn from_chunk(
   199	        chunk: &ChunkData,
   200	        version: JavaMinecraftVersion,
   201	    ) -> Result<Self, WritingError> {
   202	        Self::from_chunk_sections(chunk, version, None)
   203	    }
   204	
   205	    /// `changed_sections` is honoured only on the 1.18+ path; pre-1.18 clients have no
   206	    /// incremental section addressing here and always receive the full column.
   207	    #[expect(clippy::too_many_lines)]
   208	    pub fn from_chunk_sections(
   209	        chunk: &ChunkData,
   210	        version: JavaMinecraftVersion,
   211	        changed_sections: Option<&[usize]>,
   212	    ) -> Result<Self, WritingError> {
   213	        let light_engine = chunk
   214	            .light_engine
   215	            .lock()
   216	            .map_err(|_| WritingError::Message("light_engine lock poisoned".into()))?;
   217	
   218	        if version < JavaMinecraftVersion::V_1_18 {
   219	            let base_section = (0 - chunk.section.min_y).max(0) as usize / 16;
   220	            let mut sky_light_mask = 0u64;
   221	            let mut block_light_mask = 0u64;
   222	            let mut sky_light_empty_mask = 0u64;
   223	            let mut block_light_empty_mask = 0u64;
   224	            let mut sky_light_arrays = Vec::new();
   225	            let mut block_light_arrays = Vec::new();
   226	
   227	            // Bit 0: Y = -1 (below world section 0)
   228	            if base_section > 0 && base_section - 1 < light_engine.sky_light.len() {
   229	                match &light_engine.sky_light[base_section - 1] {
   230	                    LightContainer::Full(data) => {
   231	                        sky_light_mask |= 1 << 0;
   232	                        sky_light_arrays.push(data.to_vec());
   233	                    }
   234	                    LightContainer::Empty(val) if *val > 0 => {
   235	                        sky_light_mask |= 1 << 0;
   236	                        sky_light_arrays.push(vec![*val << 4 | *val; 2048]);
   237	                    }
   238	                    LightContainer::Empty(_) => {
   239	                        sky_light_empty_mask |= 1 << 0;
   240	                    }
   241	                }
   242	            } else {
   243	                sky_light_empty_mask |= 1 << 0;
   244	            }
   245	
   246	            if base_section > 0 && base_section - 1 < light_engine.block_light.len() {
   247	                match &light_engine.block_light[base_section - 1] {
   248	                    LightContainer::Full(data) => {
   249	                        block_light_mask |= 1 << 0;
   250	                        block_light_arrays.push(data.to_vec());
   251	                    }
   252	                    LightContainer::Empty(val) if *val > 0 => {
   253	                        block_light_mask |= 1 << 0;
   254	                        block_light_arrays.push(vec![*val << 4 | *val; 2048]);
   255	                    }
   256	                    LightContainer::Empty(_) => {
   257	                        block_light_empty_mask |= 1 << 0;
   258	                    }
   259	                }
   260	            } else {
   261	                block_light_empty_mask |= 1 << 0;
   262	            }
   263	
   264	            // Bits 1..=16: world sections (Y = 0..15)
   265	            for i in 0..16 {
   266	                let bit_index = i + 1;
   267	                let sec_idx = base_section + i;
   268	
   269	                if sec_idx < light_engine.sky_light.len() {
   270	                    match &light_engine.sky_light[sec_idx] {
   271	                        LightContainer::Full(data) => {
   272	                            sky_light_mask |= 1 << bit_index;
   273	                            sky_light_arrays.push(data.to_vec());
   274	                        }
   275	                        LightContainer::Empty(val) if *val > 0 => {
   276	                            sky_light_mask |= 1 << bit_index;
   277	                            sky_light_arrays.push(vec![*val << 4 | *val; 2048]);
   278	                        }
   279	                        LightContainer::Empty(_) => {
   280	                            sky_light_empty_mask |= 1 << bit_index;
   281	                        }
   282	                    }
   283	                } else {
   284	                    sky_light_empty_mask |= 1 << bit_index;
   285	                }
   286	
   287	                if sec_idx < light_engine.block_light.len() {
   288	                    match &light_engine.block_light[sec_idx] {
   289	                        LightContainer::Full(data) => {
   290	                            block_light_mask |= 1 << bit_index;
   291	                            block_light_arrays.push(data.to_vec());
   292	                        }
   293	                        LightContainer::Empty(val) if *val > 0 => {
   294	                            block_light_mask |= 1 << bit_index;
   295	                            block_light_arrays.push(vec![*val << 4 | *val; 2048]);
   296	                        }
   297	                        LightContainer::Empty(_) => {
   298	                            block_light_empty_mask |= 1 << bit_index;
   299	                        }
   300	                    }
   301	                } else {
   302	                    block_light_empty_mask |= 1 << bit_index;
   303	                }
   304	            }
   305	
   306	            // Bit 17: Y = 16 (above world section 15)
   307	            let top_sec = base_section + 16;
   308	            if top_sec < light_engine.sky_light.len() {
   309	                match &light_engine.sky_light[top_sec] {
   310	                    LightContainer::Full(data) => {
   311	                        sky_light_mask |= 1 << 17;
   312	                        sky_light_arrays.push(data.to_vec());
   313	                    }
   314	                    LightContainer::Empty(val) if *val > 0 => {
   315	                        sky_light_mask |= 1 << 17;
   316	                        sky_light_arrays.push(vec![*val << 4 | *val; 2048]);
   317	                    }
   318	                    LightContainer::Empty(_) => {
   319	                        sky_light_empty_mask |= 1 << 17;
   320	                    }
   321	                }
   322	            } else {
   323	                sky_light_empty_mask |= 1 << 17;
   324	            }
   325	
   326	            if top_sec < light_engine.block_light.len() {
   327	                match &light_engine.block_light[top_sec] {
   328	                    LightContainer::Full(data) => {
   329	                        block_light_mask |= 1 << 17;
   330	                        block_light_arrays.push(data.to_vec());
   331	                    }
   332	                    LightContainer::Empty(val) if *val > 0 => {
   333	                        block_light_mask |= 1 << 17;
   334	                        block_light_arrays.push(vec![*val << 4 | *val; 2048]);
   335	                    }
   336	                    LightContainer::Empty(_) => {
   337	                        block_light_empty_mask |= 1 << 17;
   338	                    }
   339	                }
   340	            } else {
   341	                block_light_empty_mask |= 1 << 17;
   342	            }
   343	
   344	            Ok(Self {
   345	                trust_edges: true,
   346	                sky_light_mask: BitSet::from_u64(sky_light_mask),
   347	                block_light_mask: BitSet::from_u64(block_light_mask),
   348	                empty_sky_light_mask: BitSet::from_u64(sky_light_empty_mask),
   349	                empty_block_light_mask: BitSet::from_u64(block_light_empty_mask),
   350	                sky_light_arrays,
   351	                block_light_arrays,
   352	            })
   353	        } else {
   354	            let num_sections = light_engine.sky_light.len();
   355	            // A uniform `Empty(15)` layer is real full data on the wire - only an implicit
   356	            // zero layer is `DataLayer.isEmpty()` (`DataLayer.java:141-143`) - so it belongs
   357	            // in the data mask with a serialized 0xFF array.
   358	            let masks = light_masks_for_sections(&light_engine, changed_sections);
   359	
   360	            let mut sky_light_arrays = Vec::new();
   361	            let mut block_light_arrays = Vec::new();
   362	
   363	            for section_index in 0..num_sections {
   364	                if changed_sections.is_some_and(|sections| !sections.contains(&section_index)) {
   365	                    continue;
   366	                }
   367	
   368	                if light_container_has_data(&light_engine.sky_light[section_index]) {
   369	                    sky_light_arrays.push(light_container_bytes(
   370	                        &light_engine.sky_light[section_index],
   371	                    ));
   372	                }
   373	                if light_container_has_data(&light_engine.block_light[section_index]) {
   374	                    block_light_arrays.push(light_container_bytes(
   375	                        &light_engine.block_light[section_index],
   376	                    ));
   377	                }
   378	            }
   379	
   380	            Ok(Self {
   381	                trust_edges: true,
   382	                sky_light_mask: BitSet::from_u64(masks.sky),
   383	                block_light_mask: BitSet::from_u64(masks.block),
   384	                empty_sky_light_mask: BitSet::from_u64(masks.empty_sky),
   385	                empty_block_light_mask: BitSet::from_u64(masks.empty_block),
   386	                sky_light_arrays,
   387	                block_light_arrays,
   388	            })
   389	        }
   390	    }
   391	
   392	    pub fn write(
   393	        &self,
   394	        mut write: impl Write,
   395	        version: &JavaMinecraftVersion,
   396	    ) -> Result<(), WritingError> {
   397	        // Trust edges (1.16 - 1.19.4; added in 1.16, removed in 1.20)
   398	        if *version >= JavaMinecraftVersion::V_1_16 && *version <= JavaMinecraftVersion::V_1_19_4 {
   399	            write.write_bool(self.trust_edges)?;
   400	        }
   401	
   402	        // Chunk bitmasks
   403	        if *version >= JavaMinecraftVersion::V_1_17 {
   404	            write.write_bitset(&self.sky_light_mask)?;
   405	            write.write_bitset(&self.block_light_mask)?;
   406	            write.write_bitset(&self.empty_sky_light_mask)?;
   407	            write.write_bitset(&self.empty_block_light_mask)?;
   408	        } else {
   409	            write.write_var_int(&VarInt(self.sky_light_mask.as_u64() as i32))?;
   410	            write.write_var_int(&VarInt(self.block_light_mask.as_u64() as i32))?;
   411	            write.write_var_int(&VarInt(self.empty_sky_light_mask.as_u64() as i32))?;
   412	            write.write_var_int(&VarInt(self.empty_block_light_mask.as_u64() as i32))?;
   413	        }
   414	
   415	        // Sky light arrays
   416	        if *version >= JavaMinecraftVersion::V_1_17 {
   417	            write.write_var_int(&VarInt(self.sky_light_arrays.len() as i32))?;
   418	            for array in &self.sky_light_arrays {
   419	                write.write_var_int(&VarInt(array.len() as i32))?;
   420	                write.write_slice(array)?;
   421	            }
   422	        } else {
   423	            let mut array_idx = 0;
   424	            for i in 0..18 {
   425	                if self.sky_light_mask.get_bit(i)
   426	                    && let Some(array) = self.sky_light_arrays.get(array_idx)
   427	                {
   428	                    write.write_var_int(&VarInt(array.len() as i32))?;
   429	                    write.write_slice(array)?;
   430	                    array_idx += 1;
   431	                }
   432	            }
   433	        }
   434	
   435	        // Block light arrays
   436	        if *version >= JavaMinecraftVersion::V_1_17 {
   437	            write.write_var_int(&VarInt(self.block_light_arrays.len() as i32))?;
   438	            for array in &self.block_light_arrays {
   439	                write.write_var_int(&VarInt(array.len() as i32))?;
   440	                write.write_slice(array)?;
   441	            }
   442	        } else {
   443	            let mut array_idx = 0;
   444	            for i in 0..18 {
   445	                if self.block_light_mask.get_bit(i)
   446	                    && let Some(array) = self.block_light_arrays.get(array_idx)
   447	                {
   448	                    write.write_var_int(&VarInt(array.len() as i32))?;
   449	                    write.write_slice(array)?;
   450	                    array_idx += 1;
   451	                }
   452	            }
   453	        }
   454	
   455	        Ok(())
   456	    }
   457	
   458	    pub fn read(bytebuf: &mut &[u8], version: &JavaMinecraftVersion) -> Result<Self, ReadingError> {
   459	        let trust_edges = if *version >= JavaMinecraftVersion::V_1_16
   460	            && *version <= JavaMinecraftVersion::V_1_19_4
   461	        {
   462	            bytebuf.get_bool()?
   463	        } else {
   464	            false
   465	        };
   466	
   467	        let (sky_light_mask, block_light_mask, empty_sky_light_mask, empty_block_light_mask) =
   468	            if *version >= JavaMinecraftVersion::V_1_17 {
   469	                (
   470	                    BitSet::decode(bytebuf)?,
   471	                    BitSet::decode(bytebuf)?,
   472	                    BitSet::decode(bytebuf)?,
   473	                    BitSet::decode(bytebuf)?,
   474	                )
   475	            } else {
   476	                (
   477	                    BitSet::from_u64(bytebuf.get_var_int()?.0 as u64),
   478	                    BitSet::from_u64(bytebuf.get_var_int()?.0 as u64),
   479	                    BitSet::from_u64(bytebuf.get_var_int()?.0 as u64),
   480	                    BitSet::from_u64(bytebuf.get_var_int()?.0 as u64),
   481	                )
   482	            };
   483	
   484	        let sky_light_arrays = if *version >= JavaMinecraftVersion::V_1_17 {
   485	            let count = bytebuf.get_var_int()?.0 as usize;
   486	            let mut arrays = Vec::with_capacity(count);
   487	            for _ in 0..count {
   488	                let len = bytebuf.get_var_int()?.0 as usize;
   489	                let mut buf = vec![0u8; len];
   490	                bytebuf.read_bytes_to_buf(&mut buf)?;
   491	                arrays.push(buf);
   492	            }
   493	            arrays
   494	        } else {
   495	            let mut arrays = Vec::new();
   496	            for i in 0..18 {
   497	                if sky_light_mask.get_bit(i) {
   498	                    let len = bytebuf.get_var_int()?.0 as usize;
   499	                    let mut buf = vec![0u8; len];
   500	                    bytebuf.read_bytes_to_buf(&mut buf)?;
   501	                    arrays.push(buf);
   502	                }
   503	            }
   504	            arrays
   505	        };
   506	
   507	        let block_light_arrays = if *version >= JavaMinecraftVersion::V_1_17 {
   508	            let count = bytebuf.get_var_int()?.0 as usize;
   509	            let mut arrays = Vec::with_capacity(count);
   510	            for _ in 0..count {
   511	                let len = bytebuf.get_var_int()?.0 as usize;
   512	                let mut buf = vec![0u8; len];
   513	                bytebuf.read_bytes_to_buf(&mut buf)?;
   514	                arrays.push(buf);
   515	            }
   516	            arrays
   517	        } else {
   518	            let mut arrays = Vec::new();
   519	            for i in 0..18 {
   520	                if block_light_mask.get_bit(i) {
   521	                    let len = bytebuf.get_var_int()?.0 as usize;
   522	                    let mut buf = vec![0u8; len];
   523	                    bytebuf.read_bytes_to_buf(&mut buf)?;
   524	                    arrays.push(buf);
   525	                }
   526	            }
   527	            arrays
   528	        };
   529	
   530	        Ok(Self {
   531	            trust_edges,
   532	            sky_light_mask,
   533	            block_light_mask,
   534	            empty_sky_light_mask,
   535	            empty_block_light_mask,
   536	            sky_light_arrays,
   537	            block_light_arrays,
   538	        })
   539	    }
   540	}

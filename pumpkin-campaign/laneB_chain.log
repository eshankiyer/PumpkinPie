   101	/// Merges the addition's enchantments into `enchantments`, accumulating the level cost into
   102	/// `price`. Returns `(any_compatible, any_incompatible)`.
   103	///
   104	/// Ports the enchantment-merge half of `AnvilMenu.createResult` (AnvilMenu.java:196-262);
   105	/// split out of `create_result` to keep that function under the workspace line limit.
   106	fn merge_enchantments(
   107	    enchantments: &mut Vec<(&'static Enchantment, i32)>,
   108	    additional: Vec<(&'static Enchantment, i32)>,
   109	    input: &ItemStack,
   110	    using_book: bool,
   111	    infinite_materials: bool,
   112	    price: &mut i32,
   113	) -> (bool, bool) {
   114	    let (mut any_compatible, mut any_incompatible) = (false, false);
   115	
   116	    for (enchantment, level) in additional {
   117	        let current = enchantments
   118	            .iter()
   119	            .find(|(e, _)| *e == enchantment)
   120	            .map_or(0, |(_, l)| *l);
   121	        let mut new_level = if current == level {
   122	            level + 1
   123	        } else {
   124	            level.max(current)
   125	        };
   126	
   127	        let mut compatible = infinite_materials
   128	            || input.item == &Item::ENCHANTED_BOOK
   129	            || enchantment.can_enchant(input.item);
   130	
   131	        for (other, _) in &*enchantments {
   132	            if *other != enchantment && !enchantment.are_compatible(other) {
   133	                compatible = false;
   134	                *price += 1;
   135	            }
   136	        }
   137	
   138	        if compatible {
   139	            any_compatible = true;
   140	            new_level = new_level.min(enchantment.max_level);
   141	
   142	            if let Some(entry) = enchantments.iter_mut().find(|(e, _)| *e == enchantment) {
   143	                entry.1 = new_level;
   144	            } else {
   145	                enchantments.push((enchantment, new_level));
   146	            }
   147	
   148	            let mut fee = i32::try_from(enchantment.anvil_cost).unwrap_or(i32::MAX);
   149	            if using_book {
   150	                fee = (fee / 2).max(1);
   151	            }
   152	            *price += fee * new_level;
   153	            if input.item_count > 1 {
   154	                *price = 40;
   155	            }
   156	        } else {
   157	            any_incompatible = true;
   158	        }
   159	    }
   160	
   161	    (any_compatible, any_incompatible)
   162	}

     1	//! Entity equipment management.
     2	//!
     3	//! This module handles the storage and management of entity equipment slots,
     4	//! such as armor (head, chest, legs, feet) and off-hand items.
     5	//!
     6	//! Equipment is stored separately from the main inventory and is visible on
     7	//! the entity model (armor is rendered on the player, held items are visible
     8	//! in hands).
     9	
    10	use std::collections::HashMap;
    11	
    12	use pumpkin_data::data_component_impl::EquipmentSlot;
    13	use pumpkin_data::item_stack::ItemStack;
    14	
    15	/// Equipment storage for an entity.
    16	///
    17	/// Stores items equipped in armor slots (head, chest, legs, feet) and
    18	/// the off-hand slot. Equipment is separate from the main inventory
    19	/// and affects entity appearance and stats.
    20	///
    21	/// See also: [`EquipmentSlot`](EquipmentSlot)
    22	// EntityEquipment.java
    23	#[derive(Clone, Default)]
    24	pub struct EntityEquipment {
    25	    /// Map of equipment slots to their equipped items.
    26	    ///
    27	    /// Keys are equipment slot types (head, chest, legs, feet, off-hand).
    28	    pub equipment: HashMap<EquipmentSlot, ItemStack>,
    29	}
    30	
    31	impl EntityEquipment {
    32	    /// Creates a new empty equipment storage.
    33	    #[must_use]
    34	    pub fn new() -> Self {
    35	        Self {
    36	            equipment: HashMap::new(),
    37	        }
    38	    }
    39	
    40	    /// Equips an item in a slot, returning the previous item.
    41	    ///
    42	    /// # Arguments
    43	    /// - `slot` - The equipment slot
    44	    /// - `stack` - The item to equip
    45	    ///
    46	    /// # Returns
    47	    /// The previously equipped item, or an empty stack if the slot was empty.
    48	    pub fn put(&mut self, slot: &EquipmentSlot, stack: ItemStack) -> ItemStack {
    49	        self.equipment
    50	            .insert(slot.clone(), stack)
    51	            .unwrap_or_else(|| ItemStack::EMPTY.clone())
    52	    }
    53	
    54	    /// Gets the item in a slot.
    55	    ///
    56	    /// # Returns
    57	    /// The equipped item, or an empty stack if nothing is equipped.
    58	    #[must_use]
    59	    pub fn get(&self, slot: &EquipmentSlot) -> ItemStack {
    60	        self.equipment
    61	            .get(slot)
    62	            .cloned()
    63	            .unwrap_or_else(|| ItemStack::EMPTY.clone())
    64	    }
    65	
    66	    /// Checks if all equipment slots are empty.
    67	    pub fn is_empty(&self) -> bool {
    68	        self.equipment.values().all(ItemStack::is_empty)
    69	    }
    70	
    71	    /// Clears all equipped items.
    72	    pub fn clear(&mut self) {
    73	        self.equipment.clear();
    74	    }
    75	
    76	    // TODO: tick - Equipment updates, durability damage, etc.
    77	}

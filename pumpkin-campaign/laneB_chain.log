   368	#[cfg(test)]
   369	mod tests {
   370	    use super::interaction_shape_at;
   371	    use pumpkin_util::math::position::BlockPos;
   372	
   373	    #[test]
   374	    fn cauldron_interaction_shape_is_the_four_pixel_interior() {
   375	        // `AbstractCauldronBlock.java:28,75-77` selects SHAPE_INSIDE for interaction.
   376	        let shape = interaction_shape_at(&BlockPos::new(3, 64, -2));
   377	        assert_eq!(shape.min.x, 3.125);
   378	        assert_eq!(shape.min.y, 64.0);
   379	        assert_eq!(shape.min.z, -1.875);
   380	        assert_eq!(shape.max.x, 3.875);
   381	        assert_eq!(shape.max.y, 64.25);
   382	        assert_eq!(shape.max.z, -1.125);
   383	    }
   384	}


   228	        // `CopperChestBlock.updateShape` (CopperChestBlock.java:99-114) makes the single
   229	        // partner adopt this block (keeping its own facing/type); mirror that settled state.
   230	        if r#type != ChestType::Single
   231	            && let Some((neighbor_pos, mut neighbor_props)) = partner
   232	        {
   233	            neighbor_props.r#type = match r#type {
   234	                ChestType::Left => ChestType::Right,
   235	                _ => ChestType::Left,
   236	            };

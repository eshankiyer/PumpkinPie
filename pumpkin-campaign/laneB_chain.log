   318	fn place_carved_block(
   319	    run: &mut CarveRun,
   320	    pos: Vector3<i32>,
   321	    state: &'static BlockState,
   322	    should_schedule_fluid_update: bool,
   323	    has_grass: bool,
   324	    overworld: bool,
   325	) {
   326	    run.chunk.set_block_state(pos.x, pos.y, pos.z, state);
   327	
   328	    if overworld && should_schedule_fluid_update && state.is_liquid() {
   329	        schedule_fluid_tick_for_state(run.chunk, pos.x, pos.y, pos.z, state);
   330	    }
   331	
   332	    carve_top_material(run, pos.x, pos.y, pos.z, state, has_grass, overworld);
   333	}
   334	
   335	fn schedule_fluid_tick_for_state(
   336	    chunk: &mut ProtoChunk,
   337	    x: i32,
   338	    y: i32,
   339	    z: i32,
   340	    state: &'static BlockState,
   341	) {
   342	    if state.id == pumpkin_data::Block::WATER.default_state.id {
   343	        chunk.schedule_fluid_tick(x, y, z, &Fluid::WATER);
   344	    } else if state.id == pumpkin_data::Block::LAVA.default_state.id {
   345	        chunk.schedule_fluid_tick(x, y, z, &Fluid::LAVA);
   346	    }
   347	}

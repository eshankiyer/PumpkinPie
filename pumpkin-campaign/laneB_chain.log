   315	   protected void iterateDensities(
   316	      final int minCellX, final int minCellZ, final int fromCellY, final int toCellY, final BlendingData.DensityConsumer densityConsumer
   317	   ) {
   318	      int minCellY = this.getColumnMinY();
   319	      int minYIndex = Math.max(0, fromCellY - minCellY);
   320	      int maxYIndex = Math.min(this.cellCountPerColumn(), toCellY - minCellY);
   321	
   322	      for (int i = 0; i < this.densities.length; i++) {
   323	         double[] densityColumn = this.densities[i];
   324	         if (densityColumn != null) {
   325	            int testCellX = minCellX + getX(i);
   326	            int testCellZ = minCellZ + getZ(i);
   327	
   328	            for (int yIndex = minYIndex; yIndex < maxYIndex; yIndex++) {
   329	               densityConsumer.consume(testCellX, yIndex + minCellY, testCellZ, densityColumn[yIndex] * 0.1);
   330	            }
   331	         }
   332	      }
   333	   }

    69	impl AngerLevel {
    70	    #[must_use]
    71	    pub const fn minimum_anger(self) -> i32 {
    72	        match self {
    73	            Self::Calm => 0,
    74	            Self::Agitated => 40,
    75	            Self::Angry => 80,
    76	        }
    77	    }
    78	
    79	    /// `AngerLevel.byAnger`: highest matching threshold wins (Angry(80) checked before
    80	    /// Agitated(40) before Calm(0)).
    81	    #[must_use]
    82	    pub const fn by_anger(anger: i32) -> Self {
    83	        if anger >= Self::Angry.minimum_anger() {
    84	            Self::Angry
    85	        } else if anger >= Self::Agitated.minimum_anger() {
    86	            Self::Agitated
    87	        } else {
    88	            Self::Calm
    89	        }
    90	    }
    91	
    92	    #[must_use]
    93	    pub const fn is_angry(self) -> bool {
    94	        matches!(self, Self::Angry)
    95	    }

   440	    /// `Brain.addActivity` (`Brain.java:350-373`). This supports construction-time extension of
   441	    /// the existing priority/activity tables without introducing another behavior subsystem.
   442	    pub fn add_activity(
   443	        &mut self,
   444	        activity: Activity,
   445	        behavior_priority_pairs: Vec<(u32, Box<dyn Behavior>)>,
   446	        conditions: Vec<(MemoryKeyId, MemoryStatus)>,
   447	        memories_to_erase_when_stopped: Vec<MemoryKeyId>,

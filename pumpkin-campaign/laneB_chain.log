    57	   }
    58	
    59	   @Override
    60	   public final void tickOrStop(final ServerLevel level, final E body, final long timestamp) {
    61	      if (!this.timedOut(timestamp) && this.canStillUse(level, body, timestamp)) {
    62	         this.tick(level, body, timestamp);
    63	      } else {
    64	         this.doStop(level, body, timestamp);
    65	      }
    66	   }
    67	

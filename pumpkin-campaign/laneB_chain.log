   462	            self.activity_memories_to_erase
   463	                .push((activity, memories_to_erase_when_stopped));
   464	        }
   465	        let mut runtime = self.runtime.lock().unwrap();
   466	        for (priority, behavior) in behavior_priority_pairs {
   467	            runtime
   468	                .behaviors_by_priority
   469	                .entry(priority)
   470	                .or_default()
   471	                .push((activity, behavior));
   472	        }
   473	    }

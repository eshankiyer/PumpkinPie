    87	      for (double height : this.heights) {
    88	         if (height != Double.MAX_VALUE) {
    89	            hasHeight = true;
    90	            break;
    91	         }
    92	      }
    93	
    94	      return new BlendingData.Packed(
    95	         this.areaWithOldGeneration.getMinSectionY(),
    96	         this.areaWithOldGeneration.getMaxSectionY() + 1,
    97	         hasHeight ? Optional.of(DoubleArrays.copy(this.heights)) : Optional.empty()
    98	      );
    99	   }
   100	
   101	   public static @Nullable BlendingData getOrUpdateBlendingData(final WorldGenRegion region, final int chunkX, final int chunkZ) {
   102	      ChunkAccess chunk = region.getChunk(chunkX, chunkZ);
   103	      BlendingData blendingData = chunk.getBlendingData();
   104	      if (blendingData != null && !chunk.getHighestGeneratedStatus().isBefore(ChunkStatus.BIOMES)) {
   105	         blendingData.calculateData(chunk, sideByGenerationAge(region, chunkX, chunkZ, false));
   106	         return blendingData;
   107	      } else {
   108	         return null;
   109	      }
   110	   }
   111	
   112	   public static Set<Direction8> sideByGenerationAge(final WorldGenLevel region, final int chunkX, final int chunkZ, final boolean wantedOldGen) {
   113	      Set<Direction8> sides = EnumSet.noneOf(Direction8.class);
   114	
   115	      for (Direction8 direction8 : Direction8.values()) {
   116	         int testChunkX = chunkX + direction8.getStepX();
   117	         int testChunkZ = chunkZ + direction8.getStepZ();
   118	         if (region.getChunk(testChunkX, testChunkZ).isOldNoiseGeneration() == wantedOldGen) {
   119	            sides.add(direction8);
   120	         }
   121	      }
   122	
   123	      return sides;
   124	   }
   125	
   126	   private void calculateData(final ChunkAccess chunk, final Set<Direction8> newSides) {
   127	      if (!this.hasCalculatedData) {
   128	         if (newSides.contains(Direction8.NORTH) || newSides.contains(Direction8.WEST) || newSides.contains(Direction8.NORTH_WEST)) {
   129	            this.addValuesForColumn(getInsideIndex(0, 0), chunk, 0, 0);
   130	         }
   131	
   132	         if (newSides.contains(Direction8.NORTH)) {
   133	            for (int i = 1; i < QUARTS_PER_SECTION; i++) {
   134	               this.addValuesForColumn(getInsideIndex(i, 0), chunk, 4 * i, 0);
   135	            }
   136	         }
   137	
   138	         if (newSides.contains(Direction8.WEST)) {
   139	            for (int i = 1; i < QUARTS_PER_SECTION; i++) {
   140	               this.addValuesForColumn(getInsideIndex(0, i), chunk, 0, 4 * i);
   141	            }
   142	         }
   143	
   144	         if (newSides.contains(Direction8.EAST)) {
   145	            for (int i = 1; i < QUARTS_PER_SECTION; i++) {
   146	               this.addValuesForColumn(getOutsideIndex(CELL_HORIZONTAL_MAX_INDEX_OUTSIDE, i), chunk, 15, 4 * i);
   147	            }
   148	         }
   149	
   150	         if (newSides.contains(Direction8.SOUTH)) {
   151	            for (int i = 0; i < QUARTS_PER_SECTION; i++) {
   152	               this.addValuesForColumn(getOutsideIndex(i, CELL_HORIZONTAL_MAX_INDEX_OUTSIDE), chunk, 4 * i, 15);
   153	            }
   154	         }
   155	
   156	         if (newSides.contains(Direction8.EAST) && newSides.contains(Direction8.NORTH_EAST)) {
   157	            this.addValuesForColumn(getOutsideIndex(CELL_HORIZONTAL_MAX_INDEX_OUTSIDE, 0), chunk, 15, 0);
   158	         }
   159	
   160	         if (newSides.contains(Direction8.EAST) && newSides.contains(Direction8.SOUTH) && newSides.contains(Direction8.SOUTH_EAST)) {
   161	            this.addValuesForColumn(getOutsideIndex(CELL_HORIZONTAL_MAX_INDEX_OUTSIDE, CELL_HORIZONTAL_MAX_INDEX_OUTSIDE), chunk, 15, 15);
   162	         }
   163	
   164	         this.hasCalculatedData = true;
   165	      }
   166	   }
   167	
   168	   private void addValuesForColumn(final int index, final ChunkAccess chunk, final int blockX, final int blockZ) {
   169	      if (this.heights[index] == Double.MAX_VALUE) {
   170	         this.heights[index] = this.getHeightAtXZ(chunk, blockX, blockZ);
   171	      }
   172	
   173	      this.densities[index] = this.getDensityColumn(chunk, blockX, blockZ, Mth.floor(this.heights[index]));
   174	      this.biomes.set(index, this.getBiomeColumn(chunk, blockX, blockZ));
   175	   }
   176	
   177	   private int getHeightAtXZ(final ChunkAccess chunk, final int blockX, final int blockZ) {
   178	      int height;
   179	      if (chunk.hasPrimedHeightmap(Heightmap.Types.WORLD_SURFACE_WG)) {
   180	         height = Math.min(chunk.getHeight(Heightmap.Types.WORLD_SURFACE_WG, blockX, blockZ), this.areaWithOldGeneration.getMaxY());
   181	      } else {
   182	         height = this.areaWithOldGeneration.getMaxY();
   183	      }
   184	
   185	      int minY = this.areaWithOldGeneration.getMinY();
   186	      BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos(blockX, height, blockZ);
   187	
   188	      while (pos.getY() > minY) {
   189	         if (SURFACE_BLOCKS.contains(chunk.getBlockState(pos).getBlock())) {
   190	            return pos.getY();
   191	         }
   192	
   193	         pos.move(Direction.DOWN);
   194	      }
   195	
   196	      return minY;
   197	   }

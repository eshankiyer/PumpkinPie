   568	    /// Canyons are ravines: tall and narrow. `CanyonWorldCarver.shouldSkip`
   569	    /// (`CanyonWorldCarver.java:152-155`) divides the vertical term by 6, so a carved column
   570	    /// reaches far higher than the ellipsoid is wide, and `yScale` is a constant 3
   571	    /// (`Carvers.java:74`). Carving canyons alone into a solid chunk and measuring the mean
   572	    /// height of each carved column pins that shape down: dropping the `/ 6.0`, or the
   573	    /// `y_scale` multiply, collapses it towards a cave-like blob.
   574	    #[test]
   575	    fn canyon_carves_tall_narrow_columns() {
   576	        with_carve_run_options(Dimension::OVERWORLD, None, false, |run| {
   577	            let bottom = run.chunk.bottom_y() as i32;
   578	            let top = bottom + run.chunk.height() as i32;
   579	            for x in 0..16 {
   580	                for z in 0..16 {
   581	                    for y in bottom..top {
   582	                        run.chunk
   583	                            .set_block_state(x, y, z, Block::STONE.default_state);
   584	                    }
   585	                }
   586	            }
   587	
   588	            let carver = canyon::CanyonCarver;
   589	            let chunk_pos = Vector2::new(run.chunk.x, run.chunk.z);
   590	            let seed = 42u64;
   591	            for dx in -8..=8 {
   592	                for dz in -8..=8 {
   593	                    let carver_pos = Vector2::new(run.chunk.x + dx, run.chunk.z + dz);
   594	                    let mut random = new_carver_random(get_large_feature_seed(
   595	                        seed + 2,
   596	                        carver_pos.x,
   597	                        carver_pos.y,
   598	                    ));
   599	                    if should_carve(&CANYON, &mut random) {
   600	                        carver.carve(&CANYON, run, &mut random, &chunk_pos, &carver_pos);
   601	                    }
   602	                }
   603	            }
   604	
   605	            let mut carved = 0u32;
   606	            let mut columns = 0u32;
   607	            for x in 0..16 {
   608	                for z in 0..16 {
   609	                    let mut column = 0u32;
   610	                    for y in bottom..top {
   611	                        if run.chunk.get_block_state(&Vector3::new(x, y, z))
   612	                            != Block::STONE.default_state.id
   613	                        {
   614	                            column += 1;
   615	                        }
   616	                    }
   617	                    if column > 0 {
   618	                        columns += 1;
   619	                        carved += column;
   620	                    }
   621	                }
   622	            }
   623	
   624	            assert!(carved > 0, "canyon carver removed nothing");
   625	            // Measured 27.02 on this fixed seed. Dropping the `/ 6.0` from `should_skip`
   626	            // takes it to 20.46, so the bound both catches that mutation and leaves room
   627	            // for float noise.
   628	            let mean_height = f64::from(carved) / f64::from(columns);
   629	            assert!(
   630	                mean_height > 24.0,
   631	                "canyon columns are {mean_height:.2} blocks tall on average; a ravine should be far taller than wide"
   632	            );
   633	        });
   634	    }
   635	
   636	    fn set_surface_height(chunk: &mut ProtoChunk, x: i32, z: i32, height: i16) {
   637	        let index = (x & 15) as usize * 16 + (z & 15) as usize;
   638	        chunk.flat_surface_height_map[index] = height;
   639	    }
   640	}


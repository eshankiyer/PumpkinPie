   116	
   117	fn can_place_at(world: &dyn BlockAccessor, block_pos: &BlockPos) -> bool {
   118	    for direction in BlockDirection::horizontal() {
   119	        let (block, state) = world.get_block_and_state(&block_pos.offset(direction.to_offset()));
   120	        if state.is_solid() || block == &Block::LAVA {
   121	            return false;
   122	        }
   123	    }
   124	    let block = world.get_block(&block_pos.down());
   125	    (block == &Block::CACTUS || block.has_tag(&tag::Block::MINECRAFT_SUPPORTS_CACTUS))
   126	        && !world.get_block_state(&block_pos.up()).is_liquid()
   127	}

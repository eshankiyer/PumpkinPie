    44	            props.to_state_id(args.block)
    45	        })
    46	    }
    47	
    48	    /// `BrushableBlock.onPlace` (`BrushableBlock.java:62-65`) schedules the tick that
    49	    /// drives `checkReset`.
    50	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
    51	        Box::pin(async move {
    52	            let entity = BrushableBlockBlockEntity::new(*args.position);
    53	            args.world.add_block_entity(Arc::new(entity));
    54	            args.world.schedule_block_tick(
    55	                args.block,
    56	                *args.position,
    57	                TICK_DELAY,
    58	                TickPriority::Normal,
    59	            );
    60	        })
    61	    }

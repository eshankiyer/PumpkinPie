}

/// `FallingBlockEntity.causeFallDamage`:
/// `Math.min(Mth.floor(fallDistanceInt * this.fallDamagePerDistance), this.fallDamageMax)`.
#[must_use]
pub fn fall_damage_amount(
    fall_distance_int: i32,

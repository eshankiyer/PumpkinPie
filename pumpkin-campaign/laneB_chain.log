   577	
   578	    /// Builds a `ChunkData` whose light arrays are exactly `sky`/`block`.
   579	    fn chunk_with_light(sky: Vec<LightContainer>, block: Vec<LightContainer>) -> ChunkData {
   580	        let sections = sky.len();
   581	        assert_eq!(sections, block.len());
   582	        ChunkData {
   583	            section: ChunkSections::new(sections, 0),
   584	            heightmap: std::sync::Mutex::default(),
   585	            x: 0,
   586	            z: 0,
   587	            block_ticks: ChunkTickScheduler::default(),
   588	            fluid_ticks: ChunkTickScheduler::default(),
   589	            pending_block_entities: std::sync::Mutex::default(),
   590	            light_engine: std::sync::Mutex::new(ChunkLight {
   591	                sky_light: sky.into_boxed_slice(),
   592	                block_light: block.into_boxed_slice(),
   593	            }),
   594	            light_populated: std::sync::atomic::AtomicBool::new(true),
   595	            status: ChunkStatus::Full,
   596	            blending_data: None,
   597	            unknown_nbt: pumpkin_nbt::compound::NbtCompound::new(),
   598	            dirty: std::sync::atomic::AtomicBool::new(false),
   599	            inhabited_time: std::sync::atomic::AtomicU64::new(0),
   600	            custom_data: std::sync::Mutex::new(pumpkin_nbt::compound::NbtCompound::new()),
   601	        }
   602	    }
   603	
   604	    fn serialize(chunk: &ChunkData) -> Vec<u8> {
   605	        let mut out = Vec::new();
   606	        CLightUpdate::from_chunk(chunk, JavaMinecraftVersion::V_26_2)
   607	            .unwrap()
   608	            .write_packet_data(&mut out, &JavaMinecraftVersion::V_26_2)
   609	            .unwrap();
   610	        out
   611	    }
   612	
   613	    fn serialize_sections(chunk: &ChunkData, sections: &[usize]) -> Vec<u8> {
   614	        let mut out = Vec::new();
   615	        CLightUpdate::sections(chunk, sections, JavaMinecraftVersion::V_26_2)
   616	            .unwrap()
   617	            .write_packet_data(&mut out, &JavaMinecraftVersion::V_26_2)
   618	            .unwrap();
   619	        out
   620	    }
   621	
   622	    /// The client's nibble layout, per `DataLayer.java`:
   623	    ///
   624	    /// ```java
   625	    /// getIndex(x, y, z) { return y << 8 | z << 4 | x; }
   626	    /// getByteIndex(i)   { return i >> 1; }
   627	    /// getNibbleIndex(i) { return i & 1; }
   628	    /// get(i) -> data[getByteIndex(i)] >> 4 * getNibbleIndex(i) & 15
   629	    /// ```
   630	    ///
   631	    /// So `y` is slowest-varying and `x` fastest, index parity 0 is the LOW nibble, and each
   632	    /// section is `4096 / 2 = 2048` bytes (`DataLayer.java:11`, `SIZE`). The packet framing is
   633	    /// from <https://minecraft.wiki/w/Java_Edition_protocol>: four `BitSet`s (sky, block,
   634	    /// empty sky, empty block), then a prefixed array of sky light arrays - "There is 1 array
   635	    /// for each bit set to true in the sky light mask, starting with the lowest value" - then
   636	    /// the same for block light, each inner array length 2048.
   637	    ///
   638	    /// This asserts the byte at the exact protocol offset rather than reading the code. Point
   639	    /// chosen with x != z != y so that BOTH a transposed index formula and a swapped nibble
   640	    /// parity move the answer:
   641	    ///   correct:    idx = 2*256 + 3*16 + 1 = 561 -> byte 280, HIGH nibble  -> 0xA0
   642	    ///   transposed: idx = 1*256 + 3*16 + 2 = 306 -> byte 153, LOW nibble
   643	    #[test]
   644	    fn sky_light_nibble_lands_at_the_offset_the_client_reads() {
   645	        let mut lit = LightContainer::new_filled(0);
   646	        lit.set(1, 2, 3, 0xA);
   647	        let chunk = chunk_with_light(vec![lit], vec![LightContainer::new_empty(0)]);
   648	        // chunk_x (1) + chunk_z (1) + 4 BitSets of one long each (4 * (1 + 8)) = 38
   649	        // + sky array count VarInt (1) + inner array length VarInt(2048) (2) = 41
   650	        let sky_array_start: usize = 1 + 1 + 4 * (1 + 8) + 1 + 2;
   651	        let bytes = serialize(&chunk);
   652	
   653	        // VarInt(2048) is 0x80 0x10; assert the framing before trusting the offset.
   654	        assert_eq!(
   655	            &bytes[sky_array_start - 3..sky_array_start],
   656	            &[1, 0x80, 0x10]
   657	        );

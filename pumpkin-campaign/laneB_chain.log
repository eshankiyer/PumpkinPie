    60	    /// Scans straight up from the beacon for an opaque, non-bedrock block.
    61	    fn beam_clear(&self, world: &World) -> bool {
    62	        let top_y = world.dimension.min_y + world.dimension.height;
    63	        let mut pos = self.position.up();
    64	
    65	        while pos.0.y < top_y {
    66	            let block = world.get_block(&pos);
    67	            if block.id != pumpkin_data::Block::BEDROCK.id {
    68	                let state = world.get_block_state(&pos);
    69	                if state.opacity >= 15 {
    70	                    return false;
    71	                }
    72	            }
    73	            pos = pos.up();
    74	        }
    75	
    76	        true
    77	    }

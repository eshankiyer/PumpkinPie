   222	    /// `Warden.getActiveAnger` (called through `AngerManagement.getActiveAnger`).
   223	    #[must_use]
   224	    pub fn active_anger(&self, current_target: Option<Uuid>) -> i32 {
   225	        current_target.map_or(self.highest_anger, |uuid| {
   226	            self.by_suspect.get(&uuid).map_or(0, |s| s.anger)
   227	        })
   228	    }
   229	
   230	    /// `AngerManagement.getTopSuspect` + `getActiveEntity`, filtered by `valid` (vanilla's
   231	    /// `this.filter`, i.e. `Warden::canTargetEntity`).
   232	    #[must_use]
   233	    pub fn top_suspect(&self, valid: impl Fn(Uuid) -> bool) -> Option<Uuid> {
   234	        self.suspects.iter().find(|u| valid(**u)).copied()
   235	    }
   236	}

    86	    pub fn of<C: ProtoChunkCache>(cache: &C) -> Self {
    87	        let center_chunk = cache.get_center_chunk();
    88	        let center_x = center_chunk.x;
    89	        let center_z = center_chunk.z;
    90	
    91	        let mut height_and_biome_data = FxHashMap::default();
    92	        let mut density_data = FxHashMap::default();

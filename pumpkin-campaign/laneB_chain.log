    69	) {
    70	    let component = if stack.item == &Item::ENCHANTED_BOOK {
    71	        DataComponent::StoredEnchantments
    72	    } else {
    73	        DataComponent::Enchantments
    74	    };
    75	    stack.patch.retain(|(id, _)| *id != component);

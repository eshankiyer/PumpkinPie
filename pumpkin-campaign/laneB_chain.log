   334	/// Vanilla `BigDripleafBlock.placeWithRandomHeight` (`BigDripleafBlock.java:89-108`).
   335	///
   336	/// Grows a column of `nextInt(2, 5)` blocks up from `stem_bottom_pos`, stems underneath
   337	/// with a single leaf on top, stopping early where `canGrowInto` fails. Called from small
   338	/// dripleaf bone meal growth (`SmallDripleafBlock.performBonemeal`,
   339	/// `SmallDripleafBlock.java:125-133`).
   340	pub async fn place_with_random_height(
   341	    world: &Arc<World>,
   342	    stem_bottom_pos: &BlockPos,
   343	    facing: HorizontalFacing,
   344	) {
   345	    let desired_height = rand::rng().random_range(2..=5);
   346	    let mut height = 0u32;
   347	    let mut pos = *stem_bottom_pos;
   348	    while height < desired_height && can_grow_into(world, &pos) {
   349	        height += 1;
   350	        pos = pos.up();
   351	    }

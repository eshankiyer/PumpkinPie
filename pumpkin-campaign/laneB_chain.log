    77	pub trait BlockEntity: Any + Send + Sync {
    78	    fn write_nbt<'a>(
    79	        &'a self,
    80	        nbt: &'a mut NbtCompound,
    81	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>>;
    82	    fn from_nbt(nbt: &NbtCompound, position: BlockPos) -> Self
    83	    where
    84	        Self: Sized;
    85	    fn tick<'a>(&'a self, _world: &'a Arc<World>) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
    86	        Box::pin(async {})
    87	    }
    88	    fn resource_location(&self) -> &'static str;
    89	    fn get_position(&self) -> BlockPos;
    90	
    91	    /// Atomically takes the pending loot-table key and seed from this block entity.
    92	    ///
    93	    /// Returns `Some((key, seed))` if a deferred loot table was set, clearing it in the
    94	    /// process. Returns `None` for entities that do not support loot tables, or if the
    95	    /// loot has already been generated.
    96	    fn take_loot_table(&self) -> Option<(String, i64)> {
    97	        None
    98	    }
    99	
   100	    /// Returns `true` if this block entity has a pending deferred loot table that has
   101	    /// not yet been unpacked. Does not consume the loot table.
   102	    fn has_loot_table(&self) -> bool {
   103	        false
   104	    }
   105	
   106	    fn write_internal<'a>(
   107	        &'a self,
   108	        nbt: &'a mut NbtCompound,
   109	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>> {
   110	        Box::pin(async move {
   111	            nbt.put_string("id", self.resource_location().to_string());
   112	            let position = self.get_position();
   113	            nbt.put_int("x", position.0.x);
   114	            nbt.put_int("y", position.0.y);
   115	            nbt.put_int("z", position.0.z);
   116	            self.write_nbt(nbt).await;
   117	        })
   118	    }
   119	    fn get_id(&self) -> u32 {
   120	        let name = self
   121	            .resource_location()
   122	            .split(':')
   123	            .next_back()
   124	            .unwrap_or("");
   125	        pumpkin_data::block_properties::BLOCK_ENTITY_TYPES
   126	            .iter()
   127	            .position(|block_entity_name| *block_entity_name == name)
   128	            .unwrap_or(0) as u32
   129	    }
   130	
   131	    /// Mirrors `BlockEntity.isValidBlockState`: the NBT type must belong to the
   132	    /// block state currently occupying the position.
   133	    fn is_valid_block_state(&self, block_state: BlockStateId) -> bool {
   134	        let block_entity_type = pumpkin_data::BlockState::from_id(block_state).block_entity_type;
   135	        block_entity_type != u16::MAX && block_entity_type == self.get_id() as u16
   136	    }
   137	
   138	    /// Obtain NBT data for sending to the client in `ChunkData`
   139	    fn chunk_data_nbt(&self) -> Option<NbtCompound> {
   140	        None
   141	    }
   142	
   143	    /// Obtain the client update tag with the block state available when vanilla
   144	    /// derives state-dependent fields.
   145	    fn chunk_data_nbt_with_state(&self, _block_state: BlockStateId) -> Option<NbtCompound> {
   146	        self.chunk_data_nbt()
   147	    }
   148	
   149	    /// Obtain block actor NBT for fields Bedrock does not include in its block state.
   150	    fn bedrock_block_actor_data(&self, _state_id: BlockStateId) -> Option<NbtCompound> {
   151	        None
   152	    }
   153	
   154	    fn get_inventory(self: Arc<Self>) -> Option<Arc<dyn Inventory>> {
   155	        None
   156	    }
   157	    fn set_block_state(&mut self, _block_state: BlockStateId) {}
   158	    fn on_block_replaced<'a>(
   159	        self: Arc<Self>,
   160	        world: Arc<World>,
   161	        position: BlockPos,
   162	    ) -> Pin<Box<dyn Future<Output = ()> + Send + 'a>>
   163	    where
   164	        Self: 'a,
   165	    {
   166	        Box::pin(async move {
   167	            if let Some(inventory) = self.get_inventory() {
   168	                // Assuming scatter_inventory is an async method on World
   169	                world.scatter_inventory(&position, &inventory).await;
   170	            }
   171	        })
   172	    }
   173	    fn is_dirty(&self) -> bool {
   174	        false
   175	    }
   176	
   177	    fn clear_dirty(&self) {
   178	        // Default implementation does nothing
   179	        // Override in implementations that have a dirty flag
   180	    }
   181	
   182	    fn as_any(&self) -> &dyn Any;
   183	    fn to_property_delegate(self: Arc<Self>) -> Option<Arc<dyn PropertyDelegate>> {
   184	        None
   185	    }
   186	    fn to_experience_container(self: Arc<Self>) -> Option<Arc<dyn ExperienceContainer>> {
   187	        None
   188	    }
   189	}

   126	fn resolve_item_tag(tag: &str, version: JavaMinecraftVersion) -> Option<Vec<&'static Item>> {
   127	    let tag = tag.strip_prefix('#').unwrap_or(tag);
   128	    let full_tag = if tag.contains(':') {
   129	        Cow::Borrowed(tag)
   130	    } else {
   131	        Cow::Owned(format!("minecraft:{tag}"))
   132	    };
   133	
   134	    let item_names =
   135	        pumpkin_data::tag::get_registry_key_tags(version, pumpkin_data::tag::RegistryKey::Item)
   136	            .and_then(|map| map.get(full_tag.as_ref()))
   137	            .map(|t| t.0)
   138	            .or_else(|| {
   139	                pumpkin_data::tag::get_tag_values(
   140	                    pumpkin_data::tag::RegistryKey::Item,
   141	                    full_tag.as_ref(),
   142	                )
   143	            })?;
   144	
   145	    let mut items = Vec::new();
   146	    for name in item_names {
   147	        let key = name.strip_prefix("minecraft:").unwrap_or(name);
   148	        if let Some(item) = Item::from_registry_key(key) {
   149	            items.push(item);
   150	        }
   151	    }
   152	    if items.is_empty() { None } else { Some(items) }
   153	}

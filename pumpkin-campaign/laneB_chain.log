   488	    // --- tick -------------------------------------------------------------------------
   489	
   490	    /// `Brain.tick` (`Brain.java:384-389`): expire memories, tick sensors, start every
   491	    /// non-running behavior whose activity is active and whose memory gate holds, then tick
   492	    /// every running behavior.
   493	    ///
   494	    /// `game_time` is the caller's tick timestamp; see `Mob::tick` for which clock is used and
   495	    /// why it is not vanilla's `level.getGameTime()`.
   496	    pub async fn tick(&self, mob: &dyn Mob, game_time: i64) {
   497	        self.memory.lock().unwrap().tick_expiry();
   498	
   499	        // Take the runtime out of its mutex so sensor `.await`s hold no lock. The memory half
   500	        // deliberately stays behind, live, accepting writes from damage/game-event code that
   501	        // lands during this window.
   502	        let mut runtime = RuntimeTakeGuard::new(&self.runtime);
   503	
   504	        for sensor in &mut runtime.sensors {
   505	            sensor.tick(mob, self).await;
   506	        }
   507	        runtime.start_each_non_running_behavior(mob, self, game_time);
   508	        runtime.tick_each_running_behavior(mob, self, game_time);
   509	    }
   510	
   511	    /// `Brain.stopAll` (`Brain.java:401-407`).
   512	    pub fn stop_all(&self, mob: &dyn Mob, game_time: i64) {
   513	        let mut runtime = RuntimeTakeGuard::new(&self.runtime);
   514	        for behaviors in runtime.behaviors_by_priority.values_mut() {
   515	            for (_, behavior) in behaviors.iter_mut() {
   516	                if behavior.status() == BehaviorStatus::Running {
   517	                    behavior.do_stop(mob, self, game_time);
   518	                }
   519	            }
   520	        }
   521	    }
   522	}

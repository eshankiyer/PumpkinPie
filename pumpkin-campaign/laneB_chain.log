   143	    /// CopperChestBlock.java:118-120) and both halves converging on the least oxidized
   144	    /// variant (`getLeastOxidizedChestOfConnectedBlocks`, CopperChestBlock.java:78-95).
   145	    async fn replace_copper_block_with_chest(
   146	        world: &Arc<World>,
   147	        pos: &BlockPos,
   148	        copper_block: &Block,
   149	        facing: HorizontalFacing,
   150	    ) {
   151	        let chest_block = Self::copper_chest_for(copper_block);
   152	
   153	        let partner_props = |dir: HorizontalFacing| -> Option<ChestLikeProperties> {
   154	            let neighbor_pos = pos.offset(dir.to_block_direction().to_offset());
   155	            let neighbor_block = world.get_block(&neighbor_pos);
   156	            if !neighbor_block.has_tag(&tag::Block::MINECRAFT_COPPER_CHESTS) {
   157	                return None;
   158	            }
   159	            let props = ChestLikeProperties::from_state_id(
   160	                world.get_block_state_id(&neighbor_pos),
   161	                neighbor_block,
   162	            );
   163	            (props.r#type == ChestType::Single && props.facing == facing).then_some(props)
   164	        };
   165	
   166	        let connected_dir = |r#type: ChestType| -> HorizontalFacing {
   167	            match r#type {
   168	                ChestType::Left => facing.rotate_clockwise(),
   169	                _ => facing.rotate_counter_clockwise(),
   170	            }
   171	        };
   172	
   173	        let r#type = if partner_props(facing.rotate_clockwise()).is_some() {
   174	            ChestType::Left
   175	        } else if partner_props(facing.rotate_counter_clockwise()).is_some() {
   176	            ChestType::Right
   177	        } else {
   178	            ChestType::Single
   179	        };

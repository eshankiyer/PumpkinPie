   975	/// Writes just the `RecipeDisplay` for a dynamic (data-pack) crafting recipe --
   976	/// the counterpart to [`write_recipe_display`] for `OwnedCraftingRecipe`.
   977	pub fn write_dynamic_recipe_display(
   978	    write: &mut impl Write,
   979	    version: JavaMinecraftVersion,
   980	    crafting_table: &Item,
   981	    recipe: &crate::codec::recipe::OwnedCraftingRecipe,
   982	) -> Result<(), WritingError> {
   983	    match recipe {
   984	        crate::codec::recipe::OwnedCraftingRecipe::Shaped {
   985	            pattern,
   986	            key,
   987	            result,
   988	            ..
   989	        } => {
   990	            let height = pattern.len() as i32;
   991	            let width = pattern.first().map_or(0, String::len) as i32;
   992	
   993	            write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPED))?;
   994	            write.write_var_int(&VarInt(width))?;
   995	            write.write_var_int(&VarInt(height))?;
   996	            write.write_var_int(&VarInt(width * height))?;
   997	            for row in pattern {
   998	                for ch in row.chars() {
   999	                    if ch == ' ' {
  1000	                        write_empty_slot_display(write, version)?;
  1001	                    } else if let Some((_, ingredient)) = key.iter().find(|(k, _)| *k == ch) {
  1002	                        write_dynamic_ingredient_slot_display(write, ingredient, version)?;
  1003	                    } else {
  1004	                        write_empty_slot_display(write, version)?;
  1005	                    }
  1006	                }
  1007	            }
  1008	            write_dynamic_result_slot_display(write, result, version)?;
  1009	            write_item_slot_display(write, crafting_table, version)?;
  1010	        }
  1011	        crate::codec::recipe::OwnedCraftingRecipe::Shapeless {
  1012	            ingredients,
  1013	            result,
  1014	            ..
  1015	        } => {
  1016	            write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPELESS))?;
  1017	            write.write_var_int(&VarInt(ingredients.len() as i32))?;
  1018	            for ing in ingredients {
  1019	                write_dynamic_ingredient_slot_display(write, ing, version)?;
  1020	            }
  1021	            write_dynamic_result_slot_display(write, result, version)?;
  1022	            write_item_slot_display(write, crafting_table, version)?;
  1023	        }
  1024	        crate::codec::recipe::OwnedCraftingRecipe::Dye {
  1025	            target,
  1026	            dye,
  1027	            result,
  1028	            ..
  1029	        }
  1030	        | crate::codec::recipe::OwnedCraftingRecipe::Imbue {
  1031	            source: target,
  1032	            material: dye,
  1033	            result,
  1034	            ..
  1035	        } => {
  1036	            write.write_var_int(&VarInt(RECIPE_DISPLAY_SHAPELESS))?;
  1037	            write.write_var_int(&VarInt(2))?;
  1038	            write_dynamic_ingredient_slot_display(write, target, version)?;
  1039	            write_dynamic_ingredient_slot_display(write, dye, version)?;
  1040	            write_dynamic_result_slot_display(write, result, version)?;
  1041	            write_item_slot_display(write, crafting_table, version)?;
  1042	        }
  1043	    }
  1044	    Ok(())
  1045	}

   319	/// Vanilla `BigDripleafBlock.place` (`BigDripleafBlock.java:110-113`): places a leaf with
   320	/// `facing`, waterlogged when the target position holds water.
   321	async fn place_leaf(world: &Arc<World>, pos: &BlockPos, facing: HorizontalFacing) {
   322	    let mut dripleaf_props = BigDripleafLikeProperties::default(&Block::BIG_DRIPLEAF);
   323	    dripleaf_props.facing = facing;
   324	    dripleaf_props.waterlogged = world.get_block(pos) == &Block::WATER;
   325	    world
   326	        .set_block_state(
   327	            pos,
   328	            dripleaf_props.to_state_id(&Block::BIG_DRIPLEAF),
   329	            BlockFlags::NOTIFY_ALL,
   330	        )
   331	        .await;
   332	}
   333	
   334	/// Vanilla `BigDripleafBlock.placeWithRandomHeight` (`BigDripleafBlock.java:89-108`).
   335	///
   336	/// Grows a column of `nextInt(2, 5)` blocks up from `stem_bottom_pos`, stems underneath
   337	/// with a single leaf on top, stopping early where `canGrowInto` fails. Called from small
   338	/// dripleaf bone meal growth (`SmallDripleafBlock.performBonemeal`,
   339	/// `SmallDripleafBlock.java:125-133`).
   340	pub async fn place_with_random_height(
   341	    world: &Arc<World>,
   342	    stem_bottom_pos: &BlockPos,
   343	    facing: HorizontalFacing,
   344	) {
   345	    let desired_height = rand::rng().random_range(2..=5);
   346	    let mut height = 0u32;
   347	    let mut pos = *stem_bottom_pos;
   348	    while height < desired_height && can_grow_into(world, &pos) {
   349	        height += 1;
   350	        pos = pos.up();
   351	    }
   352	
   353	    // Stems occupy every position below the topmost one; the leaf sits at the top
   354	    // (`BigDripleafBlock.java:101-107`). With `height == 0` nothing grows.
   355	    let mut current = *stem_bottom_pos;
   356	    for _ in 1..height {
   357	        place_stem(world, &current, facing).await;
   358	        current = current.up();
   359	    }
   360	    if height > 0 {
   361	        place_leaf(world, &current, facing).await;
   362	    }
   363	}

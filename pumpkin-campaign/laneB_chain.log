   194	    }
   195	    let tick_delay = match tilt {
   196	        Tilt::None => -1,
   197	        Tilt::Unstable | Tilt::Partial => 10,
   198	        Tilt::Full => 100,
   199	    };
   200	    if tick_delay != -1 {
   201	        world.schedule_block_tick(
   202	            &Block::BIG_DRIPLEAF,
   203	            *pos,
   204	            tick_delay as u8,
   205	            pumpkin_world::tick::TickPriority::Normal,
   206	        );
   207	    }

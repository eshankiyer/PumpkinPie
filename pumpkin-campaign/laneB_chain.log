   296	    fn handle_precipitation<'a>(
   297	        &'a self,
   298	        args: HandlePrecipitationArgs<'a>,
   299	    ) -> BlockFuture<'a, ()> {
   300	        Box::pin(async move {
   301	            if !should_handle_precipitation(args.precipitation) {
   302	                return;
   303	            }
   304	
   305	            let new_state_id = match (args.block.id, args.precipitation) {
   306	                (BlockId::CAULDRON, Precipitation::Rain) => Block::WATER_CAULDRON.default_state.id,
   307	                (BlockId::CAULDRON, Precipitation::Snow) => {
   308	                    Block::POWDER_SNOW_CAULDRON.default_state.id
   309	                }
   310	                (BlockId::WATER_CAULDRON, Precipitation::Rain)
   311	                | (BlockId::POWDER_SNOW_CAULDRON, Precipitation::Snow) => {
   312	                    let mut props =
   313	                        WaterCauldronLikeProperties::from_state_id(args.state_id, args.block);
   314	                    if props.level >= 3 {
   315	                        return;
   316	                    }
   317	                    props.level += 1;
   318	                    props.to_state_id(args.block)
   319	                }
   320	                _ => return,
   321	            };
   322	
   323	            args.world
   324	                .set_block_state(args.position, new_state_id, BlockFlags::NOTIFY_ALL)
   325	                .await;
   326	            emit_game_event(

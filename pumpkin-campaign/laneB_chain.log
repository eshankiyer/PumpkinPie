    24	pub struct CauldronBlock;
    25	
    26	/// `AbstractCauldronBlock.getInteractionShape` (`AbstractCauldronBlock.java:28,75-77`) returns
    27	/// the twelve-by-four-by-twelve interior column for every cauldron variant.
    28	pub(crate) fn interaction_shape_at(position: &BlockPos) -> BoundingBox {
    29	    BoundingBox::new_array(
    30	        [2.0 / 16.0, 0.0, 2.0 / 16.0],
    31	        [14.0 / 16.0, 4.0 / 16.0, 14.0 / 16.0],
    32	    )
    33	    .shift(position.0.to_f64())
    34	}

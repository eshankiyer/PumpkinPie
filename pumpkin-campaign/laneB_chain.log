  1047	fn write_dynamic_crafting_entry(
  1048	    write: &mut impl Write,
  1049	    display_id: i32,
  1050	    version: JavaMinecraftVersion,
  1051	    group_id: Option<i32>,
  1052	    flags: u8,
  1053	    crafting_table: &Item,
  1054	    recipe: &crate::codec::recipe::OwnedCraftingRecipe,
  1055	) -> Result<(), WritingError> {
  1056	    write.write_var_int(&VarInt(display_id))?;
  1057	    write_dynamic_recipe_display(write, version, crafting_table, recipe)?;
  1058	
  1059	    match recipe {
  1060	        crate::codec::recipe::OwnedCraftingRecipe::Shaped {
  1061	            category,
  1062	            pattern,
  1063	            key,
  1064	            ..
  1065	        } => {
  1066	            write_optional_var_int(write, group_id)?;
  1067	            write.write_var_int(&VarInt(crafting_category(category)))?;
  1068	
  1069	            let mut slots: Vec<&crate::codec::recipe::OwnedRecipeIngredient> = Vec::new();
  1070	            for row in pattern {
  1071	                for ch in row.chars() {
  1072	                    if ch != ' '
  1073	                        && let Some((_, ing)) = key.iter().find(|(k, _)| *k == ch)
  1074	                    {
  1075	                        slots.push(ing);
  1076	                    }
  1077	                }
  1078	            }
  1079	            write.write_bool(true)?; // present
  1080	            write.write_var_int(&VarInt(slots.len() as i32))?;
  1081	            for ing in slots {
  1082	                write_dynamic_ingredient_holderset(write, ing, version)?;
  1083	            }
  1084	        }
  1085	        crate::codec::recipe::OwnedCraftingRecipe::Shapeless {
  1086	            category,
  1087	            ingredients,
  1088	            ..
  1089	        } => {
  1090	            write_optional_var_int(write, group_id)?;
  1091	            write.write_var_int(&VarInt(crafting_category(category)))?;
  1092	
  1093	            write.write_bool(true)?;
  1094	            write.write_var_int(&VarInt(ingredients.len() as i32))?;
  1095	            for ing in ingredients {
  1096	                write_dynamic_ingredient_holderset(write, ing, version)?;
  1097	            }
  1098	        }
  1099	        crate::codec::recipe::OwnedCraftingRecipe::Dye {
  1100	            category,
  1101	            target,
  1102	            dye,
  1103	            ..
  1104	        }
  1105	        | crate::codec::recipe::OwnedCraftingRecipe::Imbue {
  1106	            category,
  1107	            source: target,
  1108	            material: dye,
  1109	            ..
  1110	        } => {
  1111	            write_optional_var_int(write, group_id)?;
  1112	            write.write_var_int(&VarInt(crafting_category(category)))?;
  1113	            write.write_bool(true)?;
  1114	            write.write_var_int(&VarInt(2))?;
  1115	            write_dynamic_ingredient_holderset(write, target, version)?;
  1116	            write_dynamic_ingredient_holderset(write, dye, version)?;
  1117	        }
  1118	    }
  1119	    write.write_u8(flags)?;
  1120	    Ok(())
  1121	}

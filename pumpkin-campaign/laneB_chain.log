   630	        // `Slot.safeClone` (`Slot.java:125-128`) does not manufacture an AIR stack when the
   631	        // source slot is empty.
   632	        let clone = super::clone_stack_for_creative(&ItemStack::EMPTY.clone());
   633	        assert!(clone.is_empty());

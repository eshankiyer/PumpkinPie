  1123	#[allow(clippy::too_many_arguments)]
  1124	fn write_dynamic_cooking_entry(
  1125	    write: &mut impl Write,
  1126	    display_id: i32,
  1127	    version: JavaMinecraftVersion,
  1128	    group_id: Option<i32>,
  1129	    flags: u8,
  1130	    station: &Item,
  1131	    cooking: &crate::codec::recipe::OwnedCookingRecipe,
  1132	    book_category: i32,
  1133	) -> Result<(), WritingError> {
  1134	    write.write_var_int(&VarInt(display_id))?;
  1135	    write.write_var_int(&VarInt(RECIPE_DISPLAY_FURNACE))?;

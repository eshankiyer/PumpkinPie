   252	fn carvers_for_dimension(dimension: &Dimension) -> &'static [&'static CarverConfig] {
   253	    if dimension == &Dimension::OVERWORLD {
   254	        &OVERWORLD_CARVERS
   255	    } else if dimension == &Dimension::THE_NETHER {
   256	        &NETHER_CARVERS
   257	    } else {
   258	        &[]
   259	    }
   260	}

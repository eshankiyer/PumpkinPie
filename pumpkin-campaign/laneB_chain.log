    20	impl CherryTrunkPlacer {
    21	    #[expect(clippy::too_many_arguments)]
    22	    pub fn generate<T: GenerationCache>(
    23	        &self,
    24	        block_registry: &dyn WorldPortalExt,
    25	        placer: &TrunkPlacer,
    26	        height: u32,
    27	        start_pos: BlockPos,
    28	        chunk: &mut T,
    29	        random: &mut RandomGenerator,
    30	        below_trunk_provider: &BlockStateProvider,
    31	        trunk_state: &BlockState,
    32	    ) -> (Vec<TreeNode>, Vec<BlockPos>) {
    33	        TrunkPlacer::set_dirt(
    34	            block_registry,
    35	            chunk,
    36	            random,
    37	            &start_pos.down(),
    38	            below_trunk_provider,
    39	        );
    40	
    41	        let mut logs = Vec::new();
    42	
    43	        let first_branch_offset =
    44	            (height as i32 - 1 + self.start_offset_from_top.get(random)).max(0);
    45	        let second_branch_start_offset_from_top = UniformIntProvider::new(
    46	            self.start_offset_from_top.min_inclusive,
    47	            self.start_offset_from_top.max_inclusive - 1,
    48	        );
    49	        let mut second_branch_offset =
    50	            (height as i32 - 1 + second_branch_start_offset_from_top.get(random)).max(0);
    51	
    52	        if second_branch_offset >= first_branch_offset {
    53	            second_branch_offset += 1;
    54	        }
    55	
    56	        let branch_count = self.count.get(random);
    57	        let has_middle_branch = branch_count == 3;
    58	        let has_both_side_branches = branch_count >= 2;
    59	
    60	        let trunk_height = if has_middle_branch {
    61	            height
    62	        } else if has_both_side_branches {
    63	            (first_branch_offset.max(second_branch_offset) + 1) as u32
    64	        } else {
    65	            (first_branch_offset + 1) as u32
    66	        };
    67	
    68	        for y in 0..trunk_height {
    69	            let pos = start_pos.up_height(y as i32);
    70	            if TrunkPlacer::place(chunk, &pos, trunk_state) {
    71	                logs.push(pos);
    72	            }
    73	        }
    74	
    75	        let mut nodes = Vec::new();
    76	        if has_middle_branch {
    77	            nodes.push(TreeNode {
    78	                center: start_pos.up_height(trunk_height as i32),
    79	                foliage_radius: 0,
    80	                giant_trunk: false,
    81	            });
    82	        }
    83	
    84	        let directions = [
    85	            BlockPos::new(0, 0, -1), // North
    86	            BlockPos::new(0, 0, 1),  // South
    87	            BlockPos::new(-1, 0, 0), // West
    88	            BlockPos::new(1, 0, 0),  // East
    89	        ];
    90	        let branch_direction = directions[random.next_bounded_i32(4) as usize];
    91	
    92	        let (node1, logs1) = self.generate_branch(
    93	            placer,
    94	            height,
    95	            start_pos,
    96	            chunk,
    97	            random,
    98	            trunk_state,
    99	            branch_direction,
   100	            first_branch_offset,
   101	            first_branch_offset < trunk_height as i32 - 1,
   102	        );
   103	        nodes.push(node1);
   104	        logs.extend(logs1);
   105	
   106	        if has_both_side_branches {
   107	            let opposite_direction = BlockPos::new(-branch_direction.0.x, 0, -branch_direction.0.z);
   108	            let (node2, logs2) = self.generate_branch(
   109	                placer,
   110	                height,
   111	                start_pos,
   112	                chunk,
   113	                random,
   114	                trunk_state,
   115	                opposite_direction,
   116	                second_branch_offset,
   117	                second_branch_offset < trunk_height as i32 - 1,
   118	            );
   119	            nodes.push(node2);
   120	            logs.extend(logs2);
   121	        }
   122	
   123	        (nodes, logs)
   124	    }
   125	
   126	    #[expect(clippy::too_many_arguments)]
   127	    fn generate_branch<T: GenerationCache>(
   128	        &self,
   129	        _placer: &TrunkPlacer,
   130	        tree_height: u32,
   131	        origin: BlockPos,
   132	        chunk: &mut T,
   133	        random: &mut RandomGenerator,
   134	        trunk_state: &BlockState,
   135	        branch_direction: BlockPos,
   136	        offset_from_origin: i32,
   137	        middle_continues_upwards: bool,
   138	    ) -> (TreeNode, Vec<BlockPos>) {
   139	        let mut logs = Vec::new();
   140	        let mut log_pos = origin.up_height(offset_from_origin);
   141	
   142	        let branch_end_pos_offset = tree_height as i32 - 1 + self.end_offset_from_top.get(random);
   143	        let extend_branch_away_from_trunk =
   144	            middle_continues_upwards || branch_end_pos_offset < offset_from_origin;
   145	        let distance_to_trunk =
   146	            self.horizontal_length.get(random) + i32::from(extend_branch_away_from_trunk);
   147	
   148	        let branch_end_pos = origin
   149	            .add(
   150	                branch_direction.0.x * distance_to_trunk,
   151	                0,
   152	                branch_direction.0.z * distance_to_trunk,
   153	            )
   154	            .up_height(branch_end_pos_offset);
   155	
   156	        let steps_horizontally = if extend_branch_away_from_trunk { 2 } else { 1 };
   157	
   158	        let axis = if branch_direction.0.x != 0 {
   159	            Axis::X
   160	        } else {
   161	            Axis::Z
   162	        };
   163	        let sideways_state = Self::get_sideways_state(trunk_state, axis);
   164	
   165	        for _ in 0..steps_horizontally {
   166	            log_pos = log_pos.add(branch_direction.0.x, 0, branch_direction.0.z);
   167	            if TrunkPlacer::place(chunk, &log_pos, sideways_state) {
   168	                logs.push(log_pos);
   169	            }
   170	        }
   171	
   172	        let vertical_direction = if branch_end_pos.0.y > log_pos.0.y {
   173	            1
   174	        } else {
   175	            -1
   176	        };
   177	
   178	        loop {
   179	            let distance = log_pos.manhattan_distance(branch_end_pos);
   180	
   181	            if distance == 0 {
   182	                return (
   183	                    TreeNode {
   184	                        center: branch_end_pos.up(),
   185	                        foliage_radius: 0,
   186	                        giant_trunk: false,
   187	                    },
   188	                    logs,
   189	                );
   190	            }
   191	
   192	            let chance_to_grow_vertically =
   193	                (branch_end_pos.0.y - log_pos.0.y).abs() as f32 / distance as f32;
   194	            let grow_vertically = random.next_f32() < chance_to_grow_vertically;
   195	
   196	            if grow_vertically {
   197	                log_pos = log_pos.up_height(vertical_direction);
   198	                if TrunkPlacer::place(chunk, &log_pos, trunk_state) {
   199	                    logs.push(log_pos);
   200	                }
   201	            } else {
   202	                log_pos = log_pos.add(branch_direction.0.x, 0, branch_direction.0.z);
   203	                if TrunkPlacer::place(chunk, &log_pos, sideways_state) {
   204	                    logs.push(log_pos);
   205	                }
   206	            }
   207	        }
   208	    }
   209	
   210	    fn get_sideways_state(trunk_state: &BlockState, axis: Axis) -> &'static BlockState {
   211	        let block = Block::from_state_id(trunk_state.id);
   212	        if let Some(props_source) = block.properties(trunk_state.id) {
   213	            let mut props = props_source.to_props();
   214	            let axis_str = match axis {
   215	                Axis::X => "x",
   216	                Axis::Y => "y",
   217	                Axis::Z => "z",
   218	            };
   219	
   220	            if let Some(idx) = props.iter().position(|(k, _)| *k == "axis") {
   221	                props[idx] = ("axis", axis_str);
   222	            } else {
   223	                props.push(("axis", axis_str));
   224	            }
   225	
   226	            let new_state_id = block.from_properties(&props).to_state_id(block);
   227	            return BlockState::from_id(new_state_id);
   228	        }
   229	        BlockState::from_id(trunk_state.id)
   230	    }
   231	}


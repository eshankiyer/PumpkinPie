    85	impl BlockBehaviour for BlastFurnaceBlock {
    86	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
    87	        Box::pin(async move {
    88	            if let Some(block_entity) = args.world.get_block_entity(args.position)
    89	                && let Some(inventory) = block_entity.clone().get_inventory()
    90	                && let Some(property_delegate) = block_entity.clone().to_property_delegate()
    91	                && let Some(experience_container) = block_entity.to_experience_container()
    92	            {
    93	                args.player
    94	                    .increment_interaction_stat(
    95	                        pumpkin_data::statistic::StatisticCategory::Custom,
    96	                        pumpkin_data::statistic::CustomStatistic::InteractWithBlastFurnace as i32,
    97	                        1,
    98	                    )
    99	                    .await;
   100	                let blasting_furnace_screen_factory = BlastingFurnaceScreenFactory::new(
   101	                    inventory,
   102	                    property_delegate,
   103	                    experience_container,
   104	                );
   105	                args.player
   106	                    .open_handled_screen(&blasting_furnace_screen_factory, Some(*args.position))
   107	                    .await;
   108	            }
   109	            crate::block::registry::BlockActionResult::Consume
   110	        })
   111	    }
   112	
   113	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   114	        Box::pin(async move {
   115	            let mut props = FurnaceLikeProperties::default(args.block);
   116	            props.facing = args
   117	                .player
   118	                .living_entity
   119	                .entity
   120	                .get_horizontal_facing()
   121	                .opposite();
   122	
   123	            props.to_state_id(args.block)
   124	        })
   125	    }
   126	
   127	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   128	        Box::pin(async move {
   129	            let blasting_furnace_block_entity = BlastingFurnaceBlockEntity::new(*args.position);
   130	            args.world
   131	                .add_block_entity(Arc::new(blasting_furnace_block_entity));
   132	        })
   133	    }
   134	
   135	    fn broken<'a>(&'a self, args: BrokenArgs<'a>) -> BlockFuture<'a, ()> {
   136	        Box::pin(async move {
   137	            // Extract and drop accumulated XP as orbs before removing the block entity
   138	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   139	                && let Some(experience_container) = block_entity.to_experience_container()
   140	            {
   141	                let xp = experience_container.extract_experience();
   142	                if xp > 0 {
   143	                    let pos = args.position.to_f64();
   144	                    ExperienceOrbEntity::spawn(args.world, pos, xp as u32).await;
   145	                }
   146	            }
   147	            args.world.remove_block_entity(args.position);
   148	        })
   149	    }

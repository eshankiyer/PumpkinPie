    99	    fn get_start_and_end_pos(&self, player: &Player) -> (Vector3<f64>, Vector3<f64>) {
   100	        let start_pos = player.eye_position();
   101	        let (yaw, pitch) = player.rotation();
   102	        let (yaw_rad, pitch_rad) = (f64::from(yaw.to_radians()), f64::from(pitch.to_radians()));
   103	        let block_interaction_range = 4.5; // This is not the same as the block_interaction_range in the
   104	        // player entity.
   105	        let direction = Vector3::new(
   106	            -yaw_rad.sin() * pitch_rad.cos() * block_interaction_range,
   107	            -pitch_rad.sin() * block_interaction_range,
   108	            pitch_rad.cos() * yaw_rad.cos() * block_interaction_range,
   109	        );
   110	
   111	        let end_pos = start_pos.add(&direction);
   112	        (start_pos, end_pos)
   113	    }

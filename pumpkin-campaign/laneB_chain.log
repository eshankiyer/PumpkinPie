  1390	impl ClientPacket for CRecipeBookAddSubset<'_> {
  1391	    fn write_packet_data(
  1392	        &self,
  1393	        write: impl Write,
  1394	        version: &JavaMinecraftVersion,
  1395	    ) -> Result<(), WritingError> {
  1396	        let mut write = write;
  1397	        let mut writer = SubsetWriter {
  1398	            wanted: self
  1399	                .entries
  1400	                .iter()
  1401	                .map(|entry| (entry.display_id, *entry))
  1402	                .collect(),
  1403	            stations: Stations::resolve()?,
  1404	            version: *version,
  1405	            // Entries go into a scratch buffer first so the leading count can never
  1406	            // disagree with the number of entries that actually got written.
  1407	            body: Vec::new(),
  1408	            written: 0,
  1409	            display_id: 0,
  1410	            group_ids: HashMap::new(),
  1411	            next_group_id: 0,
  1412	        };
  1413	
  1414	        writer.write_crafting()?;
  1415	        writer.write_cooking()?;
  1416	
  1417	        write.write_var_int(&VarInt(writer.written))?;
  1418	        write.write_slice(&writer.body)?;
  1419	        write.write_bool(self.replace)?;
  1420	        Ok(())
  1421	    }
  1422	}

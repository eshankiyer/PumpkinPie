    89	   public static void placeWithRandomHeight(final LevelAccessor level, final RandomSource random, final BlockPos stemBottomPos, final Direction facing) {
    90	      int desiredHeight = Mth.nextInt(random, 2, 5);
    91	      BlockPos.MutableBlockPos pos = stemBottomPos.mutable();
    92	      int height = 0;
    93	
    94	      while (height < desiredHeight && canPlaceAt(level, pos)) {
    95	         height++;
    96	         pos.move(Direction.UP);
    97	      }
    98	
    99	      int leafY = stemBottomPos.getY() + height - 1;
   100	      pos.setY(stemBottomPos.getY());
   101	
   102	      while (pos.getY() < leafY) {
   103	         BigDripleafStemBlock.place(level, pos, level.getFluidState(pos), facing);
   104	         pos.move(Direction.UP);
   105	      }
   106	
   107	      place(level, pos, level.getFluidState(pos), facing);
   108	   }

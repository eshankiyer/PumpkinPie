    71	impl BlockBehaviour for CauldronBlock {
    72	    fn on_entity_collision<'a>(&'a self, args: OnEntityCollisionArgs<'a>) -> BlockFuture<'a, ()> {
    73	        Box::pin(async move {
    74	            let entity = args.entity.get_entity();
    75	            match args.block.id {
    76	                BlockId::LAVA_CAULDRON => {
    77	                    if !entity.entity_type.fire_immune
    78	                        && !entity.fire_immune.load(Ordering::Relaxed)
    79	                    {
    80	                        args.entity.set_on_fire_for(15.0);
    81	                        args.entity.damage(args.entity, 4.0, DamageType::LAVA).await;
    82	                    }
    83	                }
    84	                BlockId::WATER_CAULDRON | BlockId::POWDER_SNOW_CAULDRON => {
    85	                    if entity.fire_ticks.load(Ordering::Relaxed) > 0 {
    86	                        lower_fill_level(args.world, args.position, args.block).await;
    87	                    }
    88	                    entity.extinguish();
    89	                }
    90	                _ => {}
    91	            }
    92	        })
    93	    }
    94	
    95	    #[allow(clippy::too_many_lines)]
    96	    fn use_with_item<'a>(
    97	        &'a self,
    98	        args: UseWithItemArgs<'a>,
    99	    ) -> BlockFuture<'a, BlockActionResult> {
   100	        Box::pin(async move {
   101	            let item_id = args.item_stack.item.id;
   102	            let block_id = args.block.id;
   103	            let gamemode = args.player.gamemode.load();
   104	
   105	            // Filling empty cauldron with buckets
   106	            if block_id == BlockId::CAULDRON {
   107	                if item_id == Item::WATER_BUCKET.id {
   108	                    if !fire_cauldron_change(
   109	                        args.world,
   110	                        *args.position,
   111	                        0,
   112	                        3,
   113	                        crate::plugin::block::cauldron_level_change::CauldronChangeReason::BucketEmpty,
   114	                        Some(args.player.clone()),
   115	                    )
   116	                    .await
   117	                    {
   118	                        return BlockActionResult::Pass;
   119	                    }
   120	                    let state_id = Block::WATER_CAULDRON
   121	                        .from_properties(&[("level", "3")])
   122	                        .to_state_id(&Block::WATER_CAULDRON);
   123	                    args.world
   124	                        .set_block_state(args.position, state_id, BlockFlags::NOTIFY_ALL)
   125	                        .await;
   126	                    args.world.play_sound(
   127	                        Sound::ItemBucketEmpty,
   128	                        SoundCategory::Blocks,
   129	                        &args.position.to_f64(),
   130	                    );
   131	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   132	                    args.player
   133	                        .inventory
   134	                        .offer_or_drop_stack(ItemStack::new(1, &Item::BUCKET), args.player.as_ref())
   135	                        .await;
   136	                    return BlockActionResult::Success;
   137	                } else if item_id == Item::LAVA_BUCKET.id {
   138	                    args.world
   139	                        .set_block_state(
   140	                            args.position,
   141	                            Block::LAVA_CAULDRON.default_state.id,
   142	                            BlockFlags::NOTIFY_ALL,
   143	                        )
   144	                        .await;
   145	                    args.world.play_sound(
   146	                        Sound::ItemBucketEmptyLava,
   147	                        SoundCategory::Blocks,
   148	                        &args.position.to_f64(),
   149	                    );
   150	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   151	                    args.player
   152	                        .inventory
   153	                        .offer_or_drop_stack(ItemStack::new(1, &Item::BUCKET), args.player.as_ref())
   154	                        .await;
   155	                    return BlockActionResult::Success;
   156	                } else if item_id == Item::POWDER_SNOW_BUCKET.id {
   157	                    let state_id = Block::POWDER_SNOW_CAULDRON
   158	                        .from_properties(&[("level", "3")])
   159	                        .to_state_id(&Block::POWDER_SNOW_CAULDRON);
   160	                    args.world
   161	                        .set_block_state(args.position, state_id, BlockFlags::NOTIFY_ALL)
   162	                        .await;
   163	                    args.world.play_sound(
   164	                        Sound::ItemBucketEmptyPowderSnow,
   165	                        SoundCategory::Blocks,
   166	                        &args.position.to_f64(),
   167	                    );
   168	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   169	                    args.player
   170	                        .inventory
   171	                        .offer_or_drop_stack(ItemStack::new(1, &Item::BUCKET), args.player.as_ref())
   172	                        .await;
   173	                    return BlockActionResult::Success;
   174	                } else if item_id == Item::POTION.id {
   175	                    let state_id = Block::WATER_CAULDRON
   176	                        .from_properties(&[("level", "1")])
   177	                        .to_state_id(&Block::WATER_CAULDRON);
   178	                    args.world
   179	                        .set_block_state(args.position, state_id, BlockFlags::NOTIFY_ALL)
   180	                        .await;
   181	                    args.world.play_sound(
   182	                        Sound::ItemBottleEmpty,
   183	                        SoundCategory::Blocks,
   184	                        &args.position.to_f64(),
   185	                    );
   186	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   187	                    args.player
   188	                        .inventory
   189	                        .offer_or_drop_stack(
   190	                            ItemStack::new(1, &Item::GLASS_BOTTLE),
   191	                            args.player.as_ref(),
   192	                        )
   193	                        .await;
   194	                    return BlockActionResult::Success;
   195	                }
   196	            }
   197	
   198	            // Collecting fluid from full cauldrons into empty bucket
   199	            if item_id == Item::BUCKET.id {
   200	                let state_id = args.world.get_block_state_id(args.position);
   201	                let (filled_item, sound) = if block_id == BlockId::WATER_CAULDRON {
   202	                    let props = WaterCauldronLikeProperties::from_state_id(state_id, args.block);
   203	                    if props.level == 3 {
   204	                        (Some(&Item::WATER_BUCKET), Sound::ItemBucketFill)
   205	                    } else {
   206	                        (None, Sound::ItemBucketFill)
   207	                    }
   208	                } else if block_id == BlockId::LAVA_CAULDRON {
   209	                    (Some(&Item::LAVA_BUCKET), Sound::ItemBucketFillLava)
   210	                } else if block_id == BlockId::POWDER_SNOW_CAULDRON {
   211	                    let props = WaterCauldronLikeProperties::from_state_id(state_id, args.block);
   212	                    if props.level == 3 {
   213	                        (
   214	                            Some(&Item::POWDER_SNOW_BUCKET),
   215	                            Sound::ItemBucketFillPowderSnow,
   216	                        )
   217	                    } else {
   218	                        (None, Sound::ItemBucketFillPowderSnow)
   219	                    }
   220	                } else {
   221	                    (None, Sound::ItemBucketFill)
   222	                };
   223	
   224	                if let Some(result_item) = filled_item {
   225	                    args.world
   226	                        .set_block_state(
   227	                            args.position,
   228	                            Block::CAULDRON.default_state.id,
   229	                            BlockFlags::NOTIFY_ALL,
   230	                        )
   231	                        .await;
   232	                    args.world
   233	                        .play_sound(sound, SoundCategory::Blocks, &args.position.to_f64());
   234	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   235	                    args.player
   236	                        .inventory
   237	                        .offer_or_drop_stack(ItemStack::new(1, result_item), args.player.as_ref())
   238	                        .await;
   239	                    return BlockActionResult::Success;
   240	                }
   241	            }
   242	
   243	            // Adding water bottle to non-full water cauldron
   244	            if block_id == BlockId::WATER_CAULDRON && item_id == Item::POTION.id {
   245	                let state_id = args.world.get_block_state_id(args.position);
   246	                let props = WaterCauldronLikeProperties::from_state_id(state_id, args.block);
   247	                if props.level < 3 {
   248	                    let next_level_str = match props.level {
   249	                        1 => "2",
   250	                        _ => "3",
   251	                    };
   252	                    let new_state_id = Block::WATER_CAULDRON
   253	                        .from_properties(&[("level", next_level_str)])
   254	                        .to_state_id(&Block::WATER_CAULDRON);
   255	                    args.world
   256	                        .set_block_state(args.position, new_state_id, BlockFlags::NOTIFY_ALL)
   257	                        .await;
   258	                    args.world.play_sound(
   259	                        Sound::ItemBottleEmpty,
   260	                        SoundCategory::Blocks,
   261	                        &args.position.to_f64(),
   262	                    );
   263	                    args.item_stack.decrement_unless_creative(gamemode, 1);
   264	                    args.player
   265	                        .inventory
   266	                        .offer_or_drop_stack(
   267	                            ItemStack::new(1, &Item::GLASS_BOTTLE),
   268	                            args.player.as_ref(),
   269	                        )
   270	                        .await;
   271	                    return BlockActionResult::Success;
   272	                }
   273	            }
   274	
   275	            BlockActionResult::PassToDefaultBlockAction
   276	        })
   277	    }
   278	
   279	    fn get_comparator_output<'a>(
   280	        &'a self,
   281	        args: GetComparatorOutputArgs<'a>,
   282	    ) -> BlockFuture<'a, Option<u8>> {
   283	        Box::pin(async move {
   284	            match args.block.id {
   285	                BlockId::WATER_CAULDRON | BlockId::POWDER_SNOW_CAULDRON => {
   286	                    let state_id = args.world.get_block_state_id(args.position);
   287	                    let props = WaterCauldronLikeProperties::from_state_id(state_id, args.block);
   288	                    Some(props.level)
   289	                }
   290	                BlockId::LAVA_CAULDRON => Some(3),
   291	                _ => Some(0),
   292	            }
   293	        })
   294	    }
   295	
   296	    fn handle_precipitation<'a>(
   297	        &'a self,
   298	        args: HandlePrecipitationArgs<'a>,
   299	    ) -> BlockFuture<'a, ()> {
   300	        Box::pin(async move {
   301	            if !should_handle_precipitation(args.precipitation) {
   302	                return;
   303	            }
   304	
   305	            let new_state_id = match (args.block.id, args.precipitation) {
   306	                (BlockId::CAULDRON, Precipitation::Rain) => Block::WATER_CAULDRON.default_state.id,
   307	                (BlockId::CAULDRON, Precipitation::Snow) => {
   308	                    Block::POWDER_SNOW_CAULDRON.default_state.id
   309	                }
   310	                (BlockId::WATER_CAULDRON, Precipitation::Rain)
   311	                | (BlockId::POWDER_SNOW_CAULDRON, Precipitation::Snow) => {
   312	                    let mut props =
   313	                        WaterCauldronLikeProperties::from_state_id(args.state_id, args.block);
   314	                    if props.level >= 3 {
   315	                        return;
   316	                    }
   317	                    props.level += 1;
   318	                    props.to_state_id(args.block)
   319	                }
   320	                _ => return,
   321	            };
   322	
   323	            args.world
   324	                .set_block_state(args.position, new_state_id, BlockFlags::NOTIFY_ALL)
   325	                .await;
   326	            emit_game_event(
   327	                args.world,
   328	                GameEvent::BlockChange,
   329	                args.position.to_centered_f64(),
   330	                GameEventContext::none(),
   331	            )
   332	            .await;
   333	        })
   334	    }
   335	}
   336	
   337	fn should_handle_precipitation(precipitation: Precipitation) -> bool {
   338	    match precipitation {
   339	        Precipitation::Rain => rng().random::<f32>() < 0.05,
   340	        Precipitation::Snow => rng().random::<f32>() < 0.1,
   341	    }
   342	}
   343	
   344	async fn lower_fill_level(world: &Arc<World>, position: &BlockPos, block: &Block) {
   345	    let state_id = world.get_block_state_id(position);
   346	    let level = WaterCauldronLikeProperties::from_state_id(state_id, block).level;
   347	
   348	    let new_state_id = if level <= 1 {
   349	        Block::CAULDRON.default_state.id
   350	    } else {
   351	        let mut props = WaterCauldronLikeProperties::default(&Block::WATER_CAULDRON);
   352	        props.level = level - 1;
   353	        props.to_state_id(&Block::WATER_CAULDRON)
   354	    };
   355	
   356	    world
   357	        .set_block_state(position, new_state_id, BlockFlags::NOTIFY_ALL)
   358	        .await;
   359	    emit_game_event(
   360	        world,
   361	        GameEvent::BlockChange,
   362	        position.to_centered_f64(),
   363	        GameEventContext::none(),
   364	    )
   365	    .await;
   366	}

   167	impl Brain {
   168	    /// `Brain(memoryTypes, sensorTypes, activities, ...)` (`Brain.java:71-100`): registers the
   169	    /// memories each sensor writes and each behavior requires, installs the activity tables,
   170	    /// then sets `CORE` as the core activity set and runs the default activity.
   171	    #[must_use]
   172	    pub fn new(sensors: Vec<Box<dyn Sensor>>, activities: Vec<ActivityData>) -> Self {
   173	        let mut store = MemoryStore::new();
   174	        for sensor in &sensors {
   175	            for id in sensor.requires() {
   176	                store.register(*id);
   177	            }
   178	        }
   179	
   180	        let mut behaviors_by_priority: BehaviorsByPriority = BTreeMap::new();
   181	        let mut activity_requirements = Vec::new();
   182	        let mut activity_memories_to_erase = Vec::new();
   183	
   184	        for activity_data in activities {
   185	            let ActivityData {
   186	                activity,
   187	                behavior_priority_pairs,
   188	                conditions,
   189	                memories_to_erase_when_stopped,
   190	            } = activity_data;
   191	
   192	            for (id, _) in &conditions {
   193	                store.register(*id);
   194	            }
   195	            activity_requirements.push((activity, conditions));
   196	            if !memories_to_erase_when_stopped.is_empty() {
   197	                activity_memories_to_erase.push((activity, memories_to_erase_when_stopped));
   198	            }
   199	
   200	            for (priority, behavior) in behavior_priority_pairs {

   357	impl CarvedPumpkinBlock {
   358	    async fn spawn_copper_golem(args: &PlacedArgs<'_>, down_pos: BlockPos, copper_block: &Block) {
   359	        let weather_state = Self::weather_state_from_copper(copper_block);
   360	        let cleared = [*args.position, down_pos];
   361	        for pos in cleared {
   362	            let destroyed = if pos == down_pos {
   363	                copper_block.default_state.id
   364	            } else {
   365	                args.block.default_state.id
   366	            };
   367	            args.world
   368	                .set_block_state(
   369	                    &pos,
   370	                    Block::AIR.default_state.id,
   371	                    BlockFlags::NOTIFY_LISTENERS,
   372	                )
   373	                .await;
   374	            args.world.sync_world_event(
   375	                WorldEvent::ParticlesDestroyBlock,
   376	                pos,
   377	                destroyed.as_u16().into(),
   378	            );
   379	        }
   380	
   381	        // `trySpawnGolem` (CarvedPumpkinBlock.java:85-92) + `spawnGolemInWorld`
   382	        // (:107-117): spawnPos is `copperGolemMatch.getBlock(0, 0, 0)`, and
   383	        // `getBlock`'s "down" index counts from the pattern's top row - row 0 of
   384	        // `aisle("^", "#")` is the pumpkin cell, not the copper cell below it -
   385	        // so the golem snaps to the pumpkin's own position via
   386	        // `snapTo(x+0.5, y+0.05, z+0.5)` (:109), not the copper block's.
   387	        let spawn_pos = Vector3::new(
   388	            f64::from(args.position.0.x) + 0.5,
   389	            f64::from(args.position.0.y) + 0.05,
   390	            f64::from(args.position.0.z) + 0.5,
   391	        );
   392	        let entity = Entity::new(args.world.clone(), spawn_pos, &EntityType::COPPER_GOLEM);
   393	        let golem = CopperGolemEntity::new(entity);
   394	        // `CopperGolem.spawn(weatherState)` (CopperGolem.java:365-368).
   395	        golem.set_weather_state(weather_state);
   396	        args.world.play_sound(
   397	            pumpkin_data::sound::Sound::EntityCopperGolemSpawn,
   398	            pumpkin_data::sound::SoundCategory::Neutral,
   399	            &spawn_pos,
   400	        );
   401	        args.world.spawn_entity(golem).await;
   402	
   403	        let facing = WallTorchLikeProperties::from_state_id(args.state_id, args.block).facing;
   404	        Self::replace_copper_block_with_chest(args.world, &down_pos, copper_block, facing).await;
   405	        Self::update_pattern_blocks(args.world, &cleared).await;
   406	    }
   407	}


   360	
   361	    /// Applies the second-slot item to `result`: either material repair or enchantment merge,
   362	    /// matching `AnvilMenu.createResult`'s addition-item branch (AnvilMenu.java:130-236).
   363	    /// Returns `true` if the combination is invalid and the caller should reset to empty.
   364	    fn apply_addition_item(
   365	        &mut self,
   366	        input: &ItemStack,
   367	        addition: &ItemStack,
   368	        result: &mut ItemStack,
   369	        enchantments: &mut Vec<(&'static Enchantment, i32)>,
   370	        price: &mut i32,
   371	        player: &dyn InventoryPlayer,
   372	    ) -> bool {
   373	        let using_book = addition
   374	            .get_data_component::<StoredEnchantmentsImpl>()
   375	            .is_some();
   376	
   377	        if result.is_damageable() && input.is_valid_repair_item(addition) {
   378	            let mut repair_amount = result
   379	                .get_damage()
   380	                .min(result.get_max_damage().unwrap_or(0) / 4);
   381	            if repair_amount <= 0 {
   382	                return true;
   383	            }
   384	
   385	            let mut count = 0;
   386	            while repair_amount > 0 && count < addition.item_count {
   387	                let result_damage = result.get_damage() - repair_amount;
   388	                result.set_damage(result_damage);
   389	                *price += 1;
   390	                repair_amount = result
   391	                    .get_damage()
   392	                    .min(result.get_max_damage().unwrap_or(0) / 4);
   393	                count += 1;
   394	            }
   395	            self.repair_item_count_cost = i32::from(count);
   396	        } else {
   397	            if !using_book && (result.item != addition.item || !result.is_damageable()) {
   398	                return true;
   399	            }
   400	
   401	            if result.is_damageable() && !using_book {
   402	                let remaining1 = input.get_max_damage().unwrap_or(0) - input.get_damage();
   403	                let remaining2 = addition.get_max_damage().unwrap_or(0) - addition.get_damage();
   404	                let additional = remaining2 + result.get_max_damage().unwrap_or(0) * 12 / 100;
   405	                let remaining = remaining1 + additional;
   406	                let result_damage = (result.get_max_damage().unwrap_or(0) - remaining).max(0);
   407	                if result_damage < result.get_damage() {
   408	                    result.set_damage(result_damage);
   409	                    *price += 2;
   410	                }
   411	            }
   412	
   413	            let (any_compatible, any_incompatible) = merge_enchantments(
   414	                enchantments,
   415	                enchantments_for_crafting(addition),
   416	                input,
   417	                using_book,
   418	                player.has_infinite_materials(),
   419	                price,
   420	            );
   421	
   422	            if any_incompatible && !any_compatible {
   423	                return true;
   424	            }
   425	        }
   426	        false
   427	    }

    44	    /// at `top_pos`, along either horizontal axis for the iron base.
    45	    pub fn can_spawn_golem(world: &Arc<World>, top_pos: &BlockPos) -> bool {
    46	        let head = *top_pos;
    47	        let below = head.down();
    48	        // Snow golem base `" ", "#", "#"`: two snow blocks under the open head spot.
    49	        if world.get_block(&below) == &Block::SNOW_BLOCK
    50	            && world.get_block(&below.down()) == &Block::SNOW_BLOCK
    51	        {
    52	            return true;
    53	        }
    54	
    55	        // Copper golem base `" ", "#"`: any `minecraft:copper` block directly below.
    56	        if world
    57	            .get_block(&below)
    58	            .has_tag(&tag::Block::MINECRAFT_COPPER)
    59	        {
    60	            return true;
    61	        }
    62	
    63	        // Iron golem base `"~ ~", "###", "~#~"`: three iron across `below`, one centred
    64	        // beneath it, and air beside the head and beside the waist (`'~'` is the air
    65	        // predicate per the builder at CarvedPumpkinBlock.java:176).
    66	        if world.get_block(&below) != &Block::IRON_BLOCK
    67	            || world.get_block(&below.down()) != &Block::IRON_BLOCK
    68	        {
    69	            return false;
    70	        }
    71	        let is_iron = |pos: &BlockPos| world.get_block(pos) == &Block::IRON_BLOCK;
    72	        let is_air = |pos: &BlockPos| world.get_block_state(pos).is_air();
    73	        for (left, right) in [
    74	            (BlockDirection::North, BlockDirection::South),
    75	            (BlockDirection::East, BlockDirection::West),
    76	        ] {
    77	            let arm_l = below.offset(left.to_offset());
    78	            let arm_r = below.offset(right.to_offset());
    79	            if is_iron(&arm_l)
    80	                && is_iron(&arm_r)
    81	                && is_air(&head.offset(left.to_offset()))
    82	                && is_air(&head.offset(right.to_offset()))
    83	                && is_air(&arm_l.down())
    84	                && is_air(&arm_r.down())
    85	            {
    86	                return true;
    87	            }
    88	        }
    89	        false
    90	    }

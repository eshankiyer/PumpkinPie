   121	pub fn carve(chunk: &mut ProtoChunk, generator: &VanillaGenerator) {
   122	    // Vanilla applyCarvers uses a range of 8 chunks (17x17 area)
   123	    let radius = 8;
   124	    let chunk_x = chunk.x;
   125	    let chunk_z = chunk.z;
   126	    let chunk_pos = Vector2::new(chunk_x, chunk_z);
   127	
   128	    let carvers_to_use = carvers_for_dimension(&generator.dimension);
   129	
   130	    let start_x = crate::generation::positions::chunk_pos::start_block_x(chunk_x);
   131	    let start_z = crate::generation::positions::chunk_pos::start_block_z(chunk_z);
   132	    let generation_shape = &generator.settings.shape;
   133	    let horizontal_cell_count = 16 / generation_shape.horizontal_cell_block_count();
   134	
   135	    let horizontal_biome_end = crate::generation::biome_coords::from_block(
   136	        horizontal_cell_count as i32 * generation_shape.horizontal_cell_block_count() as i32,
   137	    );
   138	    let surface_config = SurfaceHeightSamplerBuilderOptions::new(
   139	        crate::generation::biome_coords::from_block(start_x),
   140	        crate::generation::biome_coords::from_block(start_z),
   141	        horizontal_biome_end as usize,
   142	        generation_shape.min_y as i32,
   143	        generation_shape.max_y() as i32,
   144	        generation_shape.vertical_cell_block_count() as usize,
   145	    );
   146	    let surface_height_sampler = SurfaceHeightEstimateSampler::generate(
   147	        &generator.base_router.surface_estimator,
   148	        &surface_config,
   149	    );
   150	    let carver_aquifer = generator.settings.aquifers_enabled.then(|| {
   151	        CarverAquiferSampler::new(
   152	            chunk_x,
   153	            chunk_z,
   154	            &generator.base_router,
   155	            &generator.random_config,
   156	            generator.settings,
   157	        )
   158	    });
   159	
   160	    let mut context = CarvingContext {
   161	        min_y: generator.dimension.min_y as i8,
   162	        height: generator.dimension.logical_height as u16,
   163	        random_config: &generator.random_config,
   164	        surface_noise: &generator.terrain_cache.surface_noise,
   165	        secondary_noise: &generator.terrain_cache.secondary_noise,
   166	        terrain_builder: &generator.terrain_cache.terrain_builder,
   167	        sea_level: generator.settings.sea_level,
   168	        surface_rule: &generator.settings.surface_rule,
   169	        surface_height_sampler,
   170	        carver_aquifer,
   171	    };
   172	
   173	    let mut run = CarveRun {
   174	        ctx: &mut context,
   175	        chunk,
   176	        ids: CarverBlockIds::new(),
   177	    };
   178	
   179	    let cave_carver = cave::CaveCarver;
   180	    let canyon_carver = canyon::CanyonCarver;
   181	
   182	    for dx in -radius..=radius {
   183	        for dz in -radius..=radius {
   184	            let carver_x = chunk_x + dx;
   185	            let carver_z = chunk_z + dz;
   186	            let carver_chunk_pos = Vector2::new(carver_x, carver_z);
   187	
   188	            // In vanilla, carvers are per-biome. Here we use the hardcoded list but
   189	            // maintain the random seed logic.
   190	            for (index, &config) in carvers_to_use.iter().enumerate() {
   191	                let seed = get_large_feature_seed(
   192	                    generator.random_config.seed + index as u64,
   193	                    carver_x,
   194	                    carver_z,
   195	                );
   196	                let mut carver_random = new_carver_random(seed);
   197	
   198	                if should_carve(config, &mut carver_random) {
   199	                    match config.additional {
   200	                        CarverAdditionalConfig::Cave(_) | CarverAdditionalConfig::NetherCave(_) => {
   201	                            cave_carver.carve(
   202	                                config,
   203	                                &mut run,
   204	                                &mut carver_random,
   205	                                &chunk_pos,
   206	                                &carver_chunk_pos,
   207	                            );
   208	                        }
   209	                        CarverAdditionalConfig::Canyon(_) => {
   210	                            canyon_carver.carve(
   211	                                config,
   212	                                &mut run,
   213	                                &mut carver_random,
   214	                                &chunk_pos,
   215	                                &carver_chunk_pos,
   216	                            );
   217	                        }
   218	                    }
   219	                }
   220	            }
   221	        }
   222	    }
   223	}
   224	
   225	fn should_carve(config: &CarverConfig, random: &mut RandomGenerator) -> bool {
   226	    random.next_f32() <= config.probability
   227	}
   228	
   229	fn get_large_feature_seed(seed: u64, chunk_x: i32, chunk_z: i32) -> u64 {
   230	    let mut random = pumpkin_util::random::legacy_rand::LegacyRand::from_seed(seed);
   231	    let x_scale = random.next_i64();
   232	    let z_scale = random.next_i64();
   233	    let seed = seed as i64;
   234	    let result =
   235	        (chunk_x as i64).wrapping_mul(x_scale) ^ (chunk_z as i64).wrapping_mul(z_scale) ^ seed;
   236	    result as u64
   237	}

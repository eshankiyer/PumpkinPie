   306	async fn place_stem(world: &Arc<World>, pos: &BlockPos, facing: HorizontalFacing) {
   307	    let mut stem_props = BigDripleafStemLikeProperties::default(&Block::BIG_DRIPLEAF_STEM);
   308	    stem_props.facing = facing;
   309	    stem_props.waterlogged = world.get_block(pos) == &Block::WATER;
   310	    world
   311	        .set_block_state(
   312	            pos,
   313	            stem_props.to_state_id(&Block::BIG_DRIPLEAF_STEM),
   314	            BlockFlags::NOTIFY_ALL,

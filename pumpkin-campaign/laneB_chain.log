    36	impl BlockMetadata for CauldronBlock {
    37	    fn ids() -> Box<[BlockId]> {
    38	        [
    39	            BlockId::CAULDRON,
    40	            BlockId::WATER_CAULDRON,
    41	            BlockId::LAVA_CAULDRON,
    42	            BlockId::POWDER_SNOW_CAULDRON,
    43	        ]
    44	        .into()
    45	    }
    46	}
    47	
    48	async fn fire_cauldron_change(
    49	    world: &std::sync::Arc<crate::world::World>,
    50	    pos: pumpkin_util::math::position::BlockPos,
    51	    old_level: i32,
    52	    new_level: i32,
    53	    reason: crate::plugin::block::cauldron_level_change::CauldronChangeReason,
    54	    entity: Option<std::sync::Arc<dyn crate::entity::EntityBase>>,
    55	) -> bool {
    56	    let mut event = crate::plugin::block::cauldron_level_change::CauldronLevelChangeEvent {
    57	        block_pos: pos,
    58	        world: world.clone(),
    59	        old_level,
    60	        new_level,
    61	        reason,
    62	        entity,
    63	        cancelled: false,
    64	    };
    65	    if let Some(server) = world.server.upgrade() {
    66	        server.plugin_manager.fire(&server, &mut event).await;
    67	    }
    68	    !event.cancelled
    69	}

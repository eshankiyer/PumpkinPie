   124	        }
   125	    }
   126	
   127	    if include_padding {
   128	        let above_world_bit = num_sections + 1;
   129	        masks.empty_sky |= 1 << above_world_bit;
   130	        masks.empty_block |= 1 << above_world_bit;
   131	    }
   132	    masks
   133	}

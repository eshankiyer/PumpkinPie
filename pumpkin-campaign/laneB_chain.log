   475	impl ScreenHandler for AnvilScreenHandler {
   476	    /// Port of `ItemCombinerMenu.stillValid` (`ItemCombinerMenu.java:110-112`) with
   477	    /// `AnvilMenu.isValidBlock` (`AnvilMenu.java:65-67`), which accepts any block in the
   478	    /// `minecraft:anvil` tag - so a chipped or damaged anvil keeps the menu open.
   479	    fn container_access(&self) -> crate::screen_handler::ContainerAccess {
   480	        crate::screen_handler::ContainerAccess::Block(|block| {
   481	            pumpkin_data::tag::Taggable::has_tag(block, &pumpkin_data::tag::Block::MINECRAFT_ANVIL)
   482	        })
   483	    }
   484	
   485	    fn as_any(&self) -> &dyn Any {
   486	        self
   487	    }
   488	
   489	    fn as_any_mut(&mut self) -> &mut dyn Any {
   490	        self
   491	    }
   492	
   493	    fn get_behaviour(&self) -> &ScreenHandlerBehaviour {
   494	        &self.behaviour
   495	    }
   496	
   497	    fn get_behaviour_mut(&mut self) -> &mut ScreenHandlerBehaviour {
   498	        &mut self.behaviour
   499	    }
   500	
   501	    fn on_closed<'a>(&'a mut self, player: &'a dyn InventoryPlayer) -> ScreenHandlerFuture<'a, ()> {
   502	        Box::pin(async move {
   503	            self.default_on_closed(player).await;
   504	            self.inventory.on_close().await;
   505	            // Drop inputs from anvil
   550	                slot.mark_dirty().await;
   551	
   552	                // `ItemCombinerMenu.quickMoveStack` calls `slot.onTake` once the result
   553	                // count changes. Preserve the anvil's XP/input consumption and recompute
   554	                // its output after that callback.
   555	                if slot_index == 2 {
   556	                    self.on_take(player).await;
   557	                    self.create_result(player).await;
   558	                    self.send_content_updates().await;
   559	                }
   560	            }
   561	
   562	            stack_left
   563	        })
   564	    }
   565	
   566	    fn on_slot_click<'a>(
   567	        &'a mut self,
   568	        slot_index: i32,
   569	        button: i32,
   570	        action_type: pumpkin_protocol::java::server::play::SlotActionType,
   571	        player: &'a dyn InventoryPlayer,
   572	    ) -> ScreenHandlerFuture<'a, ()> {
   573	        Box::pin(async move {
   574	            // `AbstractContainerMenu.doClick` only calls `slot.onTake` after `slot.tryRemove`
   575	            // actually removed the stack (AbstractContainerMenu.java:420-464), reached only via
   576	            // the `slot.mayPickup(player)` branch. `may_pickup` mirrors that gate; the actual
   577	            // removal is left to `internal_on_slot_click` (now that `AnvilResultSlot::can_insert`
   578	            // matches `mayPlace == false`, that call only removes the slot's stack, never a
   579	            // mismatched-item swap), and `on_take` fires afterward only if the count dropped.
   580	            let mut prev_result_count = 0;
   581	            if slot_index == 2 {
   582	                let result_slot = self.get_behaviour().slots[2].clone();
   583	                if result_slot.has_stack().await {
   584	                    if !self.may_pickup(player) {
   585	                        self.send_content_updates().await;
   586	                        return;
   587	                    }
   588	                    prev_result_count = result_slot.get_cloned_stack().await.item_count;
   589	                }
   590	            }
   591	
   592	            let was_quick_move =
   593	                action_type == pumpkin_protocol::java::server::play::SlotActionType::QuickMove;
   594	            self.internal_on_slot_click(slot_index, button, action_type, player)
   595	                .await;
   596	
   597	            // `QuickMove` is excluded: `internal_on_slot_click` routes it into our own
   598	            // `quick_move` override, which already calls `on_take` itself on a successful
   599	            // take. Calling it again here would charge XP and wipe the inputs a second time.
   600	            if slot_index == 2 && prev_result_count > 0 && !was_quick_move {
   601	                let new_count = self.get_behaviour().slots[2]
   602	                    .get_cloned_stack()
   603	                    .await
   604	                    .item_count;
   605	                if new_count < prev_result_count {
   606	                    self.on_take(player).await;
   607	                }
   608	            }
   609	
   610	            if slot_index == 0 || slot_index == 1 || slot_index == 2 {
   611	                self.create_result(player).await;
   612	                self.send_content_updates().await;
   613	            }
   614	        })
   615	    }
   616	}

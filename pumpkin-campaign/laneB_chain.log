   240	    /// Checks if this slot can be modified by the player.
   241	    ///
   242	    /// Mojang name: `allowModification`
   243	    fn allow_modification<'a>(&'a self, player: &'a dyn InventoryPlayer) -> BoxFuture<'a, bool> {
   244	        // Default implementation logic:
   245	        Box::pin(async move {
   246	            self.can_insert(&self.get_cloned_stack().await).await
   247	                && self.can_take_items(player).await
   248	        })
   249	    }
   250	
   251	    /// Tries to take a stack in the given range.
   252	    ///
   253	    /// Returns `None` if can't take items or if slot is empty.
   254	    /// For result slots, cannot take partial stacks.
   255	    ///
   256	    /// Mojang name: `tryRemove`
   257	    fn try_take_stack_range<'a>(
   258	        &'a self,
   259	        min: u8,
   260	        max: u8,
   261	        player: &'a dyn InventoryPlayer,
   262	    ) -> BoxFuture<'a, Option<ItemStack>> {
   263	        // Default implementation logic:
   264	        Box::pin(async move {
   265	            if !self.can_take_items(player).await {
   266	                return None;
   267	            }
   268	            if !self.allow_modification(player).await
   269	                && self.get_cloned_stack().await.item_count > max
   270	            {
   271	                // If the slot is not allowed to be modified, we cannot take a partial stack from it.
   272	                return None;
   273	            }
   274	            let min = min.min(max);
   275	            let stack = self.take_stack(min).await;
   276	
   277	            if stack.is_empty() {
   278	                None
   279	            } else {
   280	                if self.get_cloned_stack().await.is_empty() {
   281	                    self.set_stack_prev(ItemStack::EMPTY.clone(), stack.clone())
   282	                        .await;
   283	                }
   284	
   285	                Some(stack)
   286	            }
   287	        })
   288	    }
   289	
   290	    /// Safely tries to take a stack of items from the slot.
   291	    ///
   292	    /// Returns an empty stack if can't take. Triggers callbacks.
   293	    ///
   294	    /// Mojang name: `safeTake`
   295	    fn safe_take<'a>(
   296	        &'a self,
   297	        min: u8,
   298	        max: u8,
   299	        player: &'a dyn InventoryPlayer,
   300	    ) -> BoxFuture<'a, ItemStack> {
   301	        Box::pin(async move {
   302	            let stack = self.try_take_stack_range(min, max, player).await;
   303	
   304	            if let Some(stack) = &stack {
   305	                self.on_take_item(player, stack).await;
   306	            }
   307	
   308	            stack.unwrap_or_else(|| ItemStack::EMPTY.clone())
   309	        })
   310	    }
   311	
   312	    /// Inserts a stack into this slot.
   313	    ///
   314	    /// Returns any leftover items that couldn't fit.
   315	    fn insert_stack(&self, stack: ItemStack) -> BoxFuture<'_, ItemStack> {
   316	        // Default implementation logic:
   317	        Box::pin(async move {
   318	            let stack_item_count = stack.item_count;
   319	            self.insert_stack_count(stack, stack_item_count).await
   320	        })
   321	    }
   322	
   323	    /// Inserts a specific count from a stack.
   324	    ///
   325	    /// Returns any leftover items.
   326	    fn insert_stack_count(&self, mut stack: ItemStack, count: u8) -> BoxFuture<'_, ItemStack> {
   327	        // Default implementation logic:
   328	        Box::pin(async move {
   329	            if !stack.is_empty() && self.can_insert(&stack).await {
   330	                let mut stack_self = self.get_stack().await;
   331	                // `Slot.safeInsert` (`Slot.java:137-140`) computes the headroom as a signed
   332	                // int and bails when it is not positive. Doing the subtraction on `u8`
   333	                // underflows whenever the slot already holds more items than the incoming
   334	                // stack's own max size allows -- e.g. shift-clicking ender pearls (max 16)
   335	                // onto a slot holding 64 cobblestone -- which panics in debug builds.
   336	                let headroom = self
   337	                    .get_max_item_count_for_stack(&stack)
   338	                    .await
   339	                    .saturating_sub(stack_self.item_count);
   340	                let min_count = count.min(stack.item_count).min(headroom);
   341	
   342	                if min_count != 0 {
   343	                    if stack_self.is_empty() {
   344	                        self.set_stack(stack.split(min_count)).await;
   345	                    } else if stack.are_items_and_components_equal(&stack_self) {
   346	                        stack.decrement(min_count);
   347	                        stack_self.increment(min_count);
   348	                        self.set_stack(stack_self).await;
   349	                    }
   350	                }
   351	            }
   352	            if stack.is_empty() {
   353	                ItemStack::EMPTY.clone()
   354	            } else {
   355	                stack
   356	            }
   357	        })
   358	    }
   359	}

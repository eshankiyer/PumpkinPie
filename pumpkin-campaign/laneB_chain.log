   401	   public record Packed(int minSection, int maxSection, Optional<double[]> heights) {
   402	      private static final Codec<double[]> DOUBLE_ARRAY_CODEC = Codec.DOUBLE.listOf().xmap(Doubles::toArray, Doubles::asList);
   403	      public static final Codec<BlendingData.Packed> CODEC = RecordCodecBuilder.<BlendingData.Packed>create(
   404	            i -> i.group(
   405	                  Codec.INT.fieldOf("min_section").forGetter(BlendingData.Packed::minSection),
   406	                  Codec.INT.fieldOf("max_section").forGetter(BlendingData.Packed::maxSection),
   407	                  DOUBLE_ARRAY_CODEC.lenientOptionalFieldOf("heights").forGetter(BlendingData.Packed::heights)
   408	               )
   409	               .apply(i, BlendingData.Packed::new)
   410	         )
   411	         .validate(BlendingData.Packed::validateArraySize);
   412	
   413	      private static DataResult<BlendingData.Packed> validateArraySize(final BlendingData.Packed blendingData) {
   414	         return blendingData.heights.isPresent() && ((double[])blendingData.heights.get()).length != BlendingData.CELL_COLUMN_COUNT
   415	            ? DataResult.error(() -> "heights has to be of length " + BlendingData.CELL_COLUMN_COUNT)
   416	            : DataResult.success(blendingData);
   417	      }
   418	   }

     4	pub struct BlendingData {
     5	    pub min_y: i32,
     6	    pub max_y: i32,
     7	    // Heights at quart positions (16x16 per chunk)
     8	    pub heights: Vec<f64>,
     9	    // Densities at quart positions (16x16 per chunk, but at what Y levels? 1.18+ uses 4 blocks quart)
    10	    // Simplified: only store for current chunk's Y levels
    11	    pub densities: Vec<f64>,
    12	    // Biomes at quart positions (16x16 per chunk)
    13	    pub biomes: Vec<&'static Biome>,
    14	}
    15	
    16	impl BlendingData {
    17	    #[must_use]
    18	    pub fn get_height(&self, cell_x: i32, _cell_y: i32, cell_z: i32) -> f64 {
    19	        if !(0..16).contains(&cell_x) || !(0..16).contains(&cell_z) {
    20	            return f64::MAX;
    21	        }
    22	        self.heights[(cell_z * 16 + cell_x) as usize]
    23	    }
    24	
    25	    #[must_use]
    26	    pub fn get_density(&self, cell_x: i32, cell_y: i32, cell_z: i32) -> f64 {
    27	        if !(0..16).contains(&cell_x) || !(0..16).contains(&cell_z) {
    28	            return f64::MAX;
    29	        }
    30	        let cell_count_y = (self.max_y - self.min_y) / 8;
    31	        if !(0..cell_count_y).contains(&cell_y) {
    32	            return f64::MAX;
    33	        }
    34	        let index = (cell_y * 16 * 16 + cell_z * 16 + cell_x) as usize;
    35	        if index < self.densities.len() {
    36	            self.densities[index]
    37	        } else {
    38	            f64::MAX
    39	        }
    40	    }
    41	
    42	    pub fn iterate_heights<F>(&self, quart_x: i32, quart_z: i32, mut consumer: F)
    43	    where
    44	        F: FnMut(i32, i32, f64),
    45	    {
    46	        for z in 0..16 {
    47	            for x in 0..16 {
    48	                let h = self.heights[z * 16 + x];
    49	                if h != f64::MAX {
    50	                    consumer(quart_x + x as i32, quart_z + z as i32, h);
    51	                }
    52	            }
    53	        }
    54	    }
    55	
    56	    pub fn iterate_densities<F>(
    57	        &self,
    58	        quart_x: i32,
    59	        quart_z: i32,
    60	        min_cell_y: i32,
    61	        max_cell_y: i32,
    62	        mut consumer: F,
    63	    ) where
    64	        F: FnMut(i32, i32, i32, f64),
    65	    {
    66	        let cell_count_y = (self.max_y - self.min_y) / 8;
    67	        for cell_y in min_cell_y..=max_cell_y {
    68	            if (0..cell_count_y).contains(&cell_y) {
    69	                for z in 0..16 {
    70	                    for x in 0..16 {
    71	                        let index = (cell_y * 16 * 16 + z * 16 + x) as usize;
    72	                        if index < self.densities.len() {
    73	                            let d = self.densities[index];
    74	                            if d != f64::MAX {
    75	                                consumer(quart_x + x, cell_y, quart_z + z, d);
    76	                            }
    77	                        }
    78	                    }
    79	                }
    80	            }
    81	        }
    82	    }
    83	
    84	    pub fn iterate_biomes<F>(&self, quart_x: i32, _quart_y: i32, quart_z: i32, mut consumer: F)
    85	    where
    86	        F: FnMut(i32, i32, &'static Biome),
    87	    {
    88	        for z in 0..16 {
    89	            for x in 0..16 {
    90	                let biome = self.biomes[z * 16 + x];
    91	                consumer(quart_x + x as i32, quart_z + z as i32, biome);
    92	            }
    93	        }
    94	    }
    95	}

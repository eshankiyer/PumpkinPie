   262	fn carve_top_material(
   263	    run: &mut CarveRun,
   264	    x: i32,
   265	    carved_y: i32,
   266	    z: i32,
   267	    carved_state: &'static BlockState,
   268	    has_grass: bool,
   269	    overworld: bool,
   270	) {
   271	    if !overworld || !has_grass {
   272	        return;
   273	    }
   274	
   275	    let below_y = carved_y - 1;
   276	    let below_state = run.chunk.get_block_state(&Vector3::new(x, below_y, z));
   277	    if below_state != run.ids.dirt.id {
   278	        return;
   279	    }
   280	
   281	    let steep = steep_material_condition(run.chunk, x, z);
   282	    if let Some(top_material) =
   283	        run.ctx
   284	            .top_material(run.chunk, x, below_y, z, carved_state.is_liquid(), steep)
   285	    {
   286	        run.chunk.set_block_state(x, below_y, z, top_material);
   287	
   288	        schedule_fluid_tick_for_state(run.chunk, x, below_y, z, top_material);
   289	    }
   290	}
   291	
   292	fn overworld_carve_state(
   293	    run: &mut CarveRun,
   294	    config: &CarverConfig,
   295	    x: i32,
   296	    y: i32,
   297	    z: i32,
   298	) -> Option<(&'static BlockState, bool)> {
   299	    let lava_y = config.lava_level.get_y(
   300	        run.chunk.generation_bottom_y() as i16,
   301	        run.chunk.generation_height(),
   302	    );
   303	
   304	    if y <= lava_y {
   305	        return Some((run.ids.lava, false));
   306	    }
   307	
   308	    let Some(aquifer) = run.ctx.carver_aquifer.as_mut() else {
   309	        return Some((run.ids.air, false));
   310	    };
   311	
   312	    let result = aquifer.compute(&Vector3::new(x, y, z), 0.0);
   313	    result
   314	        .state
   315	        .map(|state| (state, result.should_schedule_fluid_update))
   316	}
   317	
   318	fn place_carved_block(
   319	    run: &mut CarveRun,
   320	    pos: Vector3<i32>,
   321	    state: &'static BlockState,
   322	    should_schedule_fluid_update: bool,
   323	    has_grass: bool,
   324	    overworld: bool,
   325	) {
   326	    run.chunk.set_block_state(pos.x, pos.y, pos.z, state);
   327	
   328	    if overworld && should_schedule_fluid_update && state.is_liquid() {
   329	        schedule_fluid_tick_for_state(run.chunk, pos.x, pos.y, pos.z, state);
   330	    }
   331	
   332	    carve_top_material(run, pos.x, pos.y, pos.z, state, has_grass, overworld);
   333	}
   334	
   335	fn schedule_fluid_tick_for_state(
   336	    chunk: &mut ProtoChunk,
   337	    x: i32,
   338	    y: i32,
   339	    z: i32,
   340	    state: &'static BlockState,
   341	) {
   342	    if state.id == pumpkin_data::Block::WATER.default_state.id {
   343	        chunk.schedule_fluid_tick(x, y, z, &Fluid::WATER);
   344	    } else if state.id == pumpkin_data::Block::LAVA.default_state.id {
   345	        chunk.schedule_fluid_tick(x, y, z, &Fluid::LAVA);
   346	    }
   347	}

   199	   private static double read1(final ChunkAccess chunk, final BlockPos.MutableBlockPos pos) {
   200	      return isGround(chunk, pos.move(Direction.DOWN)) ? 1.0 : -1.0;
   201	   }
   202	
   203	   private static double read7(final ChunkAccess chunk, final BlockPos.MutableBlockPos pos) {
   204	      double sum = 0.0;
   205	
   206	      for (int i = 0; i < 7; i++) {
   207	         sum += read1(chunk, pos);
   208	      }
   209	
   210	      return sum;
   211	   }

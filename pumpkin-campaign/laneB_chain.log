   440	    /// `ItemCombinerMenu.mayPickup` (`AnvilMenu.mayPickup`, AnvilMenu.java:70-72).
   441	    fn may_pickup(&self, player: &dyn InventoryPlayer) -> bool {
   442	        (player.has_infinite_materials()
   443	            || player.experience_level() >= i32::from(self.repair_cost))
   444	            && self.repair_cost > 0
   445	    }
   446	
   447	    /// `AnvilMenu.onTake` (AnvilMenu.java:74-115), minus the block-damage effect (see module
   448	    /// docs).
   449	    async fn on_take(&mut self, player: &dyn InventoryPlayer) {
   450	        if !player.has_infinite_materials() {
   451	            player
   452	                .add_experience_levels(-i32::from(self.repair_cost))
   453	                .await;
   454	        }
   455	
   456	        if self.repair_item_count_cost > 0 {
   457	            let addition = self.inventory.get_stack(1).await;
   458	            if !addition.is_empty() && i32::from(addition.item_count) > self.repair_item_count_cost
   459	            {
   460	                let mut shrunk = addition;
   461	                shrunk.decrement(u8::try_from(self.repair_item_count_cost).unwrap_or(u8::MAX));
   462	                self.inventory.set_stack(1, shrunk).await;
   463	            } else {
   464	                self.inventory.set_stack(1, ItemStack::EMPTY.clone()).await;
   465	            }
   466	        } else if !self.only_renaming {
   467	            self.inventory.set_stack(1, ItemStack::EMPTY.clone()).await;
   468	        }
   469	
   470	        self.set_repair_cost(0).await;
   471	        self.inventory.set_stack(0, ItemStack::EMPTY.clone()).await;
   472	    }
   473	}

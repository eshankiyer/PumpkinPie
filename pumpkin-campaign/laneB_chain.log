    20	impl BlockBehaviour for CactusBlock {
    21	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
    22	        Box::pin(async move {
    23	            if !can_place_at(args.world.as_ref(), args.position) {
    24	                args.world
    25	                    .break_block(args.position, None, BlockFlags::empty())
    26	                    .await;
    27	            }
    28	        })
    29	    }
    30	
    31	    fn random_tick<'a>(&'a self, args: RandomTickArgs<'a>) -> BlockFuture<'a, ()> {
    32	        Box::pin(async move {
    33	            let block_up = args.position.up();
    34	            if args.world.get_block_state(&block_up).is_air() {
    35	                let state = args.world.get_block_state(args.position);
    36	                let mut props = CactusLikeProperties::from_state_id(state.id, args.block);
    37	                let age = props.age;
    38	                let mut i = 1;
    39	                while args.world.get_block(&args.position.down_height(i)) == &Block::CACTUS {
    40	                    i += 1;
    41	                    if i == 3 && age == 15 {
    42	                        return;
    43	                    }
    44	                }
    45	
    46	                if age == 8 && can_place_at(args.world.as_ref(), &block_up) {
    47	                    let d = if i >= 3 { 0.25 } else { 0.1 };
    48	                    if rand::rng().random_range(0.0..1.0) <= d {
    49	                        args.world
    50	                            .set_block_state(
    51	                                &block_up,
    52	                                Block::CACTUS_FLOWER.default_state.id,
    53	                                BlockFlags::NOTIFY_ALL,
    54	                            )
    55	                            .await;
    56	                    }
    57	                } else if age == 15 && i < 3 {
    58	                    args.world
    59	                        .set_block_state(
    60	                            &block_up,
    61	                            Block::CACTUS.default_state.id,
    62	                            BlockFlags::NOTIFY_ALL,
    63	                        )
    64	                        .await;
    65	                    let mut new_props = CactusLikeProperties::default(&Block::CACTUS);
    66	                    new_props.age = 0;
    67	                    args.world
    68	                        .set_block_state(
    69	                            args.position,
    70	                            new_props.to_state_id(&Block::CACTUS),
    71	                            BlockFlags::SKIP_BLOCK_ENTITY_REPLACED_CALLBACK,
    72	                        )
    73	                        .await;
    74	                    args.world.update_neighbor(&block_up, &Block::CACTUS).await;
    75	                }
    76	                if age < 15 {
    77	                    props.age = age + 1;
    78	                    args.world
    79	                        .set_block_state(
    80	                            args.position,
    81	                            props.to_state_id(&Block::CACTUS),
    82	                            BlockFlags::SKIP_BLOCK_ENTITY_REPLACED_CALLBACK,
    83	                        )
    84	                        .await;
    85	                }
    86	            }
    87	        })
    88	    }

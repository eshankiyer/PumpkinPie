   103	/// Port of `AngerManagement`. See module doc comment for the uuid-vs-liveness scope
   104	/// reduction.
   105	#[derive(Default)]
   106	pub struct AngerManagement {
   107	    suspects: Vec<Uuid>,
   108	    by_suspect: HashMap<Uuid, Suspect>,
   109	    highest_anger: i32,
   110	}
   111	
   112	impl AngerManagement {
   113	    #[must_use]
   114	    pub fn new() -> Self {
   115	        Self::default()
   116	    }
   117	
   118	    /// `AngerManagement.increaseAnger`. Note vanilla's exact clamp order: the per-suspect
   119	    /// anger is clamped to `MAX_ANGER` first via `computeInt`, but if this is a *newly seen*
   120	    /// suspect, any leftover anger carried over from the (here-unimplemented) uuid side-map
   121	    /// is added back on top *without* re-clamping. This port has no side-map, so that branch
   122	    /// never adds anything — but the clamp-then-conditionally-add structure is kept as
   123	    /// written in `AngerManagement.java` rather than collapsed, so a future add of the
   124	    /// side-map doesn't silently reintroduce over-clamping.
   125	    pub fn increase_anger(&mut self, uuid: Uuid, is_player: bool, increment: i32) -> i32 {
   126	        let new_suspect = !self.by_suspect.contains_key(&uuid);
   127	        let entry = self.by_suspect.entry(uuid).or_insert(Suspect {
   128	            anger: 0,
   129	            is_player,
   130	        });
   131	        entry.anger = (entry.anger + increment).min(MAX_ANGER);
   132	        let anger = entry.anger;
   133	        if new_suspect {
   134	            // No uuid side-map carried anger to add here (see doc comment above); vanilla
   135	            // would add it here, unclamped, after this point and before the `put`.
   136	            self.suspects.push(uuid);
   137	        }
   138	        self.sort_and_update_highest();
   139	        anger
   140	    }
   141	
   142	    /// `AngerManagement.clearAnger`
   143	    pub fn clear_anger(&mut self, uuid: Uuid) {
   144	        self.by_suspect.remove(&uuid);
   145	        self.suspects.retain(|u| *u != uuid);
   146	        self.sort_and_update_highest();
   147	    }
   148	
   149	    /// `AngerManagement.tick`, minus the uuid side-map decay (see module doc comment).
   150	    /// `valid` mirrors vanilla's `validEntity` predicate (`Warden::canTargetEntity`) plus the
   151	    /// liveness check vanilla does inline (`entity.getRemovalReason() == null`) — the caller
   152	    /// is expected to fold both into one predicate since this module has no entity access.
   153	    pub fn tick(&mut self, valid: impl Fn(Uuid) -> bool) {
   154	        let mut suspects = std::mem::take(&mut self.suspects);
   155	        let mut by_suspect = std::mem::take(&mut self.by_suspect);
   156	        suspects.retain(|uuid| {
   157	            let Some(suspect) = by_suspect.get_mut(uuid) else {
   158	                return false;
   159	            };
   160	            if suspect.anger > 1 && valid(*uuid) {
   161	                suspect.anger -= 1;
   162	                true
   163	            } else {
   164	                by_suspect.remove(uuid);
   165	                false
   166	            }
   167	        });
   168	        self.suspects = suspects;
   169	        self.by_suspect = by_suspect;
   170	        self.sort_and_update_highest();
   171	    }
   172	
   173	    /// `AngerManagement.sortAndUpdateHighestAnger` + `Sorter.compare`. Ported branch-for-branch
   174	    /// rather than as "max over all suspects": vanilla only explicitly assigns `highestAnger`
   175	    /// when exactly one suspect remains; for 0 suspects it stays 0 (no comparisons happen),
   176	    /// and for >=2 suspects it is a side effect of the comparator visiting pairs during the
   177	    /// sort (in practice this ends up being the max anger among all suspects, since any
   178	    /// correct sort compares every element at least once, but it is *computed* as a
   179	    /// comparator side channel, not a separate reduction — kept faithful to the original
   180	    /// control flow here in case future edits change the sort algorithm's comparison count).
   181	    fn sort_and_update_highest(&mut self) {
   182	        let mut suspects = std::mem::take(&mut self.suspects);
   183	        let by_suspect = &self.by_suspect;
   184	        let mut highest = 0;
   185	        suspects.sort_by(|a, b| {
   186	            let anger_a = by_suspect.get(a).map_or(0, |s| s.anger);
   187	            let anger_b = by_suspect.get(b).map_or(0, |s| s.anger);
   188	            highest = highest.max(anger_a).max(anger_b);
   189	
   190	            let angry_a = AngerLevel::by_anger(anger_a).is_angry();
   191	            let angry_b = AngerLevel::by_anger(anger_b).is_angry();
   192	            if angry_a != angry_b {
   193	                return if angry_a {
   194	                    Ordering::Less
   195	                } else {
   196	                    Ordering::Greater
   197	                };
   198	            }
   199	
   200	            let player_a = by_suspect.get(a).is_some_and(|s| s.is_player);
   201	            let player_b = by_suspect.get(b).is_some_and(|s| s.is_player);
   202	            if player_a != player_b {
   203	                return if player_a {
   204	                    Ordering::Less
   205	                } else {
   206	                    Ordering::Greater
   207	                };
   208	            }
   209	
   210	            anger_b.cmp(&anger_a)
   211	        });
   212	        self.suspects = suspects;
   213	        self.highest_anger = if self.suspects.len() == 1 {
   214	            self.by_suspect
   215	                .get(&self.suspects[0])
   216	                .map_or(0, |s| s.anger)
   217	        } else {
   218	            highest
   219	        };
   220	    }

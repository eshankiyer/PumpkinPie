    63	    /// `BrushableBlock.tick` (`BrushableBlock.java:82-92`). The `Fallable` half of the
    64	    /// vanilla tick (turning into a `FallingBlockEntity` over air) is not modelled here.
    65	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
    66	        Box::pin(async move {
    67	            if let Some(be) = args.world.get_block_entity(args.position)
    68	                && let Some(brush_be) = be.as_any().downcast_ref::<BrushableBlockBlockEntity>()
    69	            {
    70	                let game_time = args.world.get_world_age().await;
    71	                brush_be.check_reset(args.world, game_time).await;
    72	            }
    73	        })
    74	    }
    75	
    76	    fn broken<'a>(&'a self, args: BrokenArgs<'a>) -> BlockFuture<'a, ()> {
    77	        Box::pin(async move {
    78	            if let Some(be) = args.world.get_block_entity(args.position)
    79	                && let Some(brush_be) = be.as_any().downcast_ref::<BrushableBlockBlockEntity>()
    80	                && let Some(contained) = brush_be.take_item().await
    81	            {
    82	                args.world.drop_stack(args.position, contained).await;

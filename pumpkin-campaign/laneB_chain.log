    69	   private BlendingData(final int minSection, final int maxSection, final Optional<double[]> heights) {
    70	      this.heights = heights.orElseGet(() -> Util.make(new double[CELL_COLUMN_COUNT], i -> Arrays.fill(i, Double.MAX_VALUE)));
    71	      this.densities = new double[CELL_COLUMN_COUNT][];
    72	      ObjectArrayList<List<Holder<Biome>>> biomes = new ObjectArrayList<>(CELL_COLUMN_COUNT);
    73	      biomes.size(CELL_COLUMN_COUNT);
    74	      this.biomes = biomes;
    75	      int minY = SectionPos.sectionToBlockCoord(minSection);

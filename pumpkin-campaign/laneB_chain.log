  1137	    write_any_fuel_slot_display(write, version)?;
  1138	    write_dynamic_result_slot_display(write, &cooking.result, version)?;
  1139	    write_item_slot_display(write, station, version)?;
  1140	    write.write_var_int(&VarInt(cooking.cooking_time))?;
  1141	    write.write_f32_be(cooking.experience)?;
  1142	    write_optional_var_int(write, group_id)?;
  1143	    write.write_var_int(&VarInt(book_category))?;
  1144	    write.write_bool(true)?;
  1145	    write.write_var_int(&VarInt(1))?;
  1146	    write_dynamic_ingredient_holderset(write, &cooking.ingredient, version)?;

    13	pub struct CherryTrunkPlacer {
    14	    pub count: IntProvider,
    15	    pub horizontal_length: IntProvider,
    16	    pub start_offset_from_top: UniformIntProvider,
    17	    pub end_offset_from_top: IntProvider,
    18	}

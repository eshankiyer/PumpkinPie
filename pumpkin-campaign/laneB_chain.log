   524	impl BrainRuntime {
   525	    /// `Brain.startEachNonRunningBehavior` (`Brain.java:409-424`).
   526	    ///
   527	    /// Every stopped behavior in every active activity gets a `try_start`, in ascending
   528	    /// priority order. There is no early exit and no per-control exclusion: two behaviors can
   529	    /// both start in the same tick.
   530	    fn start_each_non_running_behavior(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   531	        for behaviors in self.behaviors_by_priority.values_mut() {
   532	            for (activity, behavior) in behaviors.iter_mut() {
   533	                if !self.active_activities.contains(activity) {
   534	                    continue;
   535	                }
   536	                if behavior.status() == BehaviorStatus::Stopped {
   537	                    behavior.try_start(mob, brain, game_time);
   538	                }
   539	            }
   540	        }
   541	    }
   542	
   543	    /// `Brain.tickEachRunningBehavior` (`Brain.java:426-432`).
   544	    fn tick_each_running_behavior(&mut self, mob: &dyn Mob, brain: &Brain, game_time: i64) {
   545	        for behaviors in self.behaviors_by_priority.values_mut() {
   546	            for (_, behavior) in behaviors.iter_mut() {
   547	                if behavior.status() == BehaviorStatus::Running {
   548	                    behavior.tick_or_stop(mob, brain, game_time);
   549	                }
   550	            }
   551	        }
   552	    }
   553	}

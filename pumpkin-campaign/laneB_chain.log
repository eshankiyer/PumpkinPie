   353	    // Stems occupy every position below the topmost one; the leaf sits at the top
   354	    // (`BigDripleafBlock.java:101-107`). With `height == 0` nothing grows.
   355	    let mut current = *stem_bottom_pos;
   356	    for _ in 1..height {
   357	        place_stem(world, &current, facing).await;
   358	        current = current.up();
   359	    }
   360	    if height > 0 {
   361	        place_leaf(world, &current, facing).await;
   362	    }
   363	}

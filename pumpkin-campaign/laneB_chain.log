   233	            result.remove(DataComponents.CUSTOM_NAME);
   234	         }
   235	
   236	         int finalPrice = price <= 0 ? 0 : (int)Mth.clamp(tax + price, 0L, 2147483647L);
   237	         this.cost.set(finalPrice);
   238	         if (price <= 0) {
   239	            result = ItemStack.EMPTY;
   240	         }
   241	
   242	         if (namingCost == price && namingCost > 0) {
   243	            if (this.cost.get() >= 40) {
   244	               this.cost.set(39);
   245	            }
   246	
   247	            this.onlyRenaming = true;
   248	         }
   249	
   250	         if (this.cost.get() >= 40 && !this.player.hasInfiniteMaterials()) {
   251	            result = ItemStack.EMPTY;
   252	         }
   253	
   254	         if (!result.isEmpty()) {
   255	            int baseCost = result.getOrDefault(DataComponents.REPAIR_COST, 0);
   256	            if (baseCost < addition.getOrDefault(DataComponents.REPAIR_COST, 0)) {
   257	               baseCost = addition.getOrDefault(DataComponents.REPAIR_COST, 0);
   258	            }
   259	
   260	            if (namingCost != price || namingCost == 0) {
   261	               baseCost = calculateIncreasedRepairCost(baseCost);
   262	            }
   263	
   264	            result.set(DataComponents.REPAIR_COST, baseCost);
   265	            EnchantmentHelper.setEnchantments(result, enchantments.toImmutable());
   266	         }
   267	
   268	         this.resultSlots.setItem(0, result);
   269	         this.broadcastChanges();
   270	      } else {
   271	         this.resultSlots.setItem(0, ItemStack.EMPTY);
   272	         this.cost.set(0);
   273	      }
   274	   }
   275	
   276	   public static int calculateIncreasedRepairCost(final int baseCost) {
   277	      return (int)Math.min(baseCost * 2L + 1L, 2147483647L);
   278	   }
   279	
   280	   public boolean setItemName(final String name) {
   281	      String validatedName = validateName(name);
   282	      if (validatedName != null && !validatedName.equals(this.itemName)) {
   283	         this.itemName = validatedName;
   284	         if (this.getSlot(2).hasItem()) {
   285	            ItemStack itemStack = this.getSlot(2).getItem();
   286	            if (StringUtil.isBlank(validatedName)) {
   287	               itemStack.remove(DataComponents.CUSTOM_NAME);
   288	            } else {
   289	               itemStack.set(DataComponents.CUSTOM_NAME, Component.literal(validatedName));
   290	            }
   291	         }
   292	
   293	         this.createResult();
   294	         return true;
   295	      } else {
   296	         return false;
   297	      }
   298	   }
   299	
   300	   private static @Nullable String validateName(final String name) {
   301	      String filteredName = StringUtil.filterText(name);
   302	      return filteredName.length() <= 50 ? filteredName : null;
   303	   }
   304	
   305	   public int getCost() {
   306	      return this.cost.get();
   307	   }
   308	}

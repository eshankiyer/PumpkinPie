   414	        for z in start_z..end_z {
   415	            for x in start_x..end_x {
   416	                let top_y = source_heights[&(x, z)];
   417	
   418	                let north_top = source_heights.get(&(x, z - 1)).copied().unwrap_or(top_y);
   419	                let south_top = source_heights.get(&(x, z + 1)).copied().unwrap_or(top_y);
   420	                let west_top = source_heights.get(&(x - 1, z)).copied().unwrap_or(top_y);
   421	                let east_top = source_heights.get(&(x + 1, z)).copied().unwrap_or(top_y);

   687	    ) -> EntityBaseFuture<'a, bool> {
   688	        Box::pin(async move {
   689	            let ate = self.handle_eating(player, item_stack).await;
   690	            if ate {
   691	                item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   692	            }
   693	            ate
   694	        })

   697	    /// Whether this species can currently show an inventory screen. Non-chested horses have
   698	    /// nothing to show (saddle/armor are equipment-slot-only here, see the module doc comment),
   699	    /// so the default is a no-op; `AbstractChestedHorse::chested_mob_interact` overrides this
   700	    /// path with the real chest-inventory screen.
   701	    fn open_custom_inventory_screen<'a>(
   702	        &'a self,
   703	        _player: &'a Arc<Player>,
   704	    ) -> EntityBaseFuture<'a, ()> {
   705	        Box::pin(async {})
   706	    }
   707	
   708	    /// `AbstractHorse.mobInteract` (`AbstractHorse.java:644-669`), shared by Horse, `ZombieHorse`
   709	    /// and (post-tame-gate) `SkeletonHorse` -- the species' own `mobInteract` overrides in
   710	    /// vanilla reduce to this exact dispatch once their food/mad early-returns are inlined (see
   711	    /// the per-species files for the trace showing why).
   712	    fn abstract_horse_mob_interact<'a>(
   713	        &'a self,
   714	        player: &'a Arc<Player>,
   715	        item_stack: &'a mut ItemStack,
   716	    ) -> EntityBaseFuture<'a, bool>
   717	    where
   718	        Self: Sized,
   719	    {
   720	        Box::pin(async move {
   721	            let mob_entity = self.get_mob_entity();
   722	            let entity = &mob_entity.living_entity.entity;
   723	            let is_vehicle = !entity.passengers.lock().await.is_empty();
   724	
   725	            if is_vehicle || self.is_baby() {
   726	                return mob_entity
   727	                    .mob_interact(player, item_stack, self.can_be_leashed())
   728	                    .await;
   729	            }
   730	
   731	            if self.is_tamed() && player.get_entity().is_sneaking() {
   732	                self.open_custom_inventory_screen(player).await;
   733	                return true;
   734	            }
   735	
   736	            if !item_stack.is_empty() {
   737	                if self.is_food(item_stack) {
   738	                    return self.fed_food(player, item_stack).await;
   739	                }
   740	
   741	                if !self.is_tamed() {
   742	                    self.make_mad();
   743	                    return true;
   744	                }
   745	
   746	                let body_armor = {
   747	                    let equipment = mob_entity.living_entity.entity_equipment.lock().await;
   748	                    equipment.get(&EquipmentSlot::BODY)
   749	                };
   750	                if is_valid_body_armor_item(item_stack, entity.entity_type) && body_armor.is_empty()
   751	                {
   752	                    equip_body_armor_item(mob_entity, player, item_stack).await;
   753	                    return true;
   754	                }
   755	
   756	                if saddle_equip_on_interact(item_stack, entity.entity_type)
   757	                    && !AbstractHorse::is_saddled(self).await
   758	                    && self.can_use_saddle_slot()
   759	                {
   760	                    self.equip_saddle(player, item_stack).await;
   761	                    return true;
   762	                }
   763	            }
   764	
   765	            self.do_player_ride(player).await;
   766	            true
   767	        })
   768	    }
   769	
   770	    /// `AbstractHorse.addAdditionalSaveData` (`AbstractHorse.java:788-793`, minus `Owner`/`Tame`
   771	    /// which `MobEntity`'s generic owner persistence already handles) plus the randomized
   772	    /// attribute base values (see the module doc comment on `randomize_attributes`).
   773	    fn write_horse_nbt(&self, nbt: &mut NbtCompound) {
   774	        let data = self.horse_data();
   775	        nbt.put_bool("EatingHaystack", data.get_flag(FLAG_EATING));
   776	        nbt.put_bool("Bred", data.get_flag(FLAG_BRED));
   777	        nbt.put_int("Temper", data.temper.load(Relaxed));
   778	
   779	        let attributes = self
   780	            .get_mob_entity()
   781	            .living_entity
   782	            .attributes
   783	            .read()
   784	            .unwrap();
   785	        if let Some(a) = attributes.get(&pumpkin_data::attributes::Attributes::MAX_HEALTH.id) {
   786	            nbt.put_double("PumpkinHorseMaxHealth", a.base_value);
   787	        }
   788	        if let Some(a) = attributes.get(&pumpkin_data::attributes::Attributes::MOVEMENT_SPEED.id) {
   789	            nbt.put_double("PumpkinHorseSpeed", a.base_value);
   790	        }
   791	        if let Some(a) = attributes.get(&pumpkin_data::attributes::Attributes::JUMP_STRENGTH.id) {
   792	            nbt.put_double("PumpkinHorseJumpStrength", a.base_value);
   793	        }
   794	    }
   795	
   796	    fn read_horse_nbt(&self, nbt: &NbtCompound) {
   797	        let data = self.horse_data();
   798	        data.set_flag(FLAG_EATING, nbt.get_bool("EatingHaystack").unwrap_or(false));
   799	        data.set_flag(FLAG_BRED, nbt.get_bool("Bred").unwrap_or(false));
   800	        data.temper
   801	            .store(nbt.get_int("Temper").unwrap_or(0), Relaxed);
   802	
   803	        let mut attributes = self
   804	            .get_mob_entity()
   805	            .living_entity
   806	            .attributes
   807	            .write()
   808	            .unwrap();
   809	        if let Some(v) = nbt.get_double("PumpkinHorseMaxHealth")
   810	            && let Some(a) =
   811	                attributes.get_mut(&pumpkin_data::attributes::Attributes::MAX_HEALTH.id)
   812	        {
   813	            a.base_value = v;
   814	            a.dirty.store(true, Relaxed);
   815	        }
   816	        if let Some(v) = nbt.get_double("PumpkinHorseSpeed")
   817	            && let Some(a) =
   818	                attributes.get_mut(&pumpkin_data::attributes::Attributes::MOVEMENT_SPEED.id)
   819	        {
   820	            a.base_value = v;
   821	            a.dirty.store(true, Relaxed);
   822	        }
   823	        if let Some(v) = nbt.get_double("PumpkinHorseJumpStrength")
   824	            && let Some(a) =
   825	                attributes.get_mut(&pumpkin_data::attributes::Attributes::JUMP_STRENGTH.id)
   826	        {
   827	            a.base_value = v;
   828	            a.dirty.store(true, Relaxed);
   829	        }
   830	        drop(attributes);
   831	
   832	        let max_health = self.get_mob_entity().living_entity.get_max_health();
   833	        if self.get_mob_entity().living_entity.health.load() > max_health {
   834	            self.get_mob_entity().living_entity.health.store(max_health);
   835	        }
   836	    }
   837	}

   253	
   254	   public boolean add(int slot, final ItemStack itemStack) {
   255	      if (itemStack.isEmpty()) {
   256	         return false;
   257	      }
   258	
   259	      try {
   260	         if (itemStack.isDamaged()) {
   261	            if (slot == -1) {
   262	               slot = this.getFreeSlot();
   263	            }
   264	
   265	            if (slot >= 0) {
   266	               this.items.set(slot, itemStack.copyAndClear());
   267	               this.items.get(slot).setPopTime(5);
   268	               return true;
   269	            } else if (this.player.hasInfiniteMaterials()) {
   270	               itemStack.setCount(0);
   271	               return true;
   272	            } else {
   273	               return false;
   274	            }
   275	         } else {
   276	            int lastSize;
   277	            do {
   278	               lastSize = itemStack.getCount();
   279	               if (slot == -1) {
   280	                  itemStack.setCount(this.addResource(itemStack));
   281	               } else {
   282	                  itemStack.setCount(this.addResource(slot, itemStack));
   283	               }
   284	            } while (!itemStack.isEmpty() && itemStack.getCount() < lastSize);
   285	
   286	            if (itemStack.getCount() == lastSize && this.player.hasInfiniteMaterials()) {
   287	               itemStack.setCount(0);
   288	               return true;
   289	            } else {
   290	               return itemStack.getCount() < lastSize;
   291	            }
   292	         }
   293	      } catch (Throwable t) {
   294	         CrashReport report = CrashReport.forThrowable(t, "Adding item to inventory");
   295	         CrashReportCategory category = report.addCategory("Item being added");
   296	         category.setDetail("Item ID", Item.getId(itemStack.getItem()));
   297	         category.setDetail("Item data", itemStack.getDamageValue());
   298	         category.setDetail("Item name", () -> itemStack.getHoverName().getString());
   299	         throw new ReportedException(report);
   300	      }
   301	   }

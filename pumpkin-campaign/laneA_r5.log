   224	      if (this.hasRemainingSpaceForItem(this.getItem(this.selected), newItemStack)) {
   225	         return this.selected;
   226	      }
   227	
   228	      if (this.hasRemainingSpaceForItem(this.getItem(40), newItemStack)) {
   229	         return 40;
   230	      }
   231	
   232	      for (int i = 0; i < this.items.size(); i++) {
   233	         if (this.hasRemainingSpaceForItem(this.items.get(i), newItemStack)) {

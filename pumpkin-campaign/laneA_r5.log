    95	#[pumpkin_block("minecraft:dispenser")]
    96	pub struct DispenserBlock;
    97	
    98	type DispenserLikeProperties = pumpkin_data::block_properties::DispenserLikeProperties;
    99	
   100	struct DispenseContext<'a> {
   101	    world: &'a Arc<World>,
   102	    position: &'a BlockPos,
   103	    facing: Facing,
   104	}
   105	
   106	impl<'a> DispenseContext<'a> {
   107	    const fn new(args: &OnScheduledTickArgs<'a>, facing: Facing) -> Self {
   108	        Self {
   109	            world: args.world,
   110	            position: args.position,
   111	            facing,
   112	        }
   113	    }
   114	}
   115	
   116	fn triangle<R: Rng>(rng: &mut R, min: f64, max: f64) -> f64 {
   117	    (rng.random::<f64>() - rng.random::<f64>()).mul_add(max, min)
   118	}
   119	
   120	const fn to_normal(facing: Facing) -> Vector3<f64> {
   121	    match facing {
   122	        Facing::North => Vector3::new(0., 0., -1.),
   123	        Facing::East => Vector3::new(1., 0., 0.),
   124	        Facing::South => Vector3::new(0., 0., 1.),
   125	        Facing::West => Vector3::new(-1., 0., 0.),
   126	        Facing::Up => Vector3::new(0., 1., 0.),
   127	        Facing::Down => Vector3::new(0., -1., 0.),
   128	    }
   129	}
   130	
   131	const fn to_data3d(facing: Facing) -> i32 {
   132	    match facing {
   133	        Facing::North => 2,
   134	        Facing::East => 5,
   135	        Facing::South => 3,
   136	        Facing::West => 4,
   137	        Facing::Up => 1,
   138	        Facing::Down => 0,
   139	    }
   140	}
   141	
   142	impl BlockBehaviour for DispenserBlock {
   143	    fn normal_use<'a>(&'a self, args: NormalUseArgs<'a>) -> BlockFuture<'a, BlockActionResult> {
   144	        Box::pin(async move {
   145	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   146	                && let Some(inventory) = block_entity.get_inventory()
   147	            {
   148	                args.player
   149	                    .open_handled_screen(&DispenserScreenFactory(inventory), Some(*args.position))
   150	                    .await;
   151	            }
   152	            BlockActionResult::Success
   153	        })
   154	    }
   155	
   156	    fn on_place<'a>(&'a self, args: OnPlaceArgs<'a>) -> BlockFuture<'a, BlockStateId> {
   157	        Box::pin(async move {
   158	            let mut props = DispenserLikeProperties::default(args.block);
   159	            props.facing = args.player.get_entity().get_facing().opposite();
   160	            props.to_state_id(args.block)
   161	        })
   162	    }
   163	
   164	    fn placed<'a>(&'a self, args: PlacedArgs<'a>) -> BlockFuture<'a, ()> {
   165	        Box::pin(async move {
   166	            let dispenser_block_entity = DispenserBlockEntity::new(*args.position);
   167	            args.world
   168	                .add_block_entity(Arc::new(dispenser_block_entity));
   169	        })
   170	    }
   171	
   172	    fn on_neighbor_update<'a>(&'a self, args: OnNeighborUpdateArgs<'a>) -> BlockFuture<'a, ()> {
   173	        Box::pin(async move {
   174	            let powered = block_receives_redstone_power(args.world, args.position).await
   175	                || block_receives_redstone_power(args.world, &args.position.up()).await;
   176	
   177	            let mut props = DispenserLikeProperties::from_state_id(
   178	                args.world.get_block_state(args.position).id,
   179	                args.block,
   180	            );
   181	
   182	            if powered && !props.triggered {
   183	                args.world
   184	                    .schedule_block_tick(args.block, *args.position, 4, TickPriority::Normal);
   185	                props.triggered = true;
   186	                args.world
   187	                    .set_block_state(
   188	                        args.position,
   189	                        props.to_state_id(args.block),
   190	                        BlockFlags::NOTIFY_LISTENERS,
   191	                    )
   192	                    .await;
   193	            } else if !powered && props.triggered {
   194	                props.triggered = false;
   195	                args.world
   196	                    .set_block_state(
   197	                        args.position,
   198	                        props.to_state_id(args.block),
   199	                        BlockFlags::NOTIFY_LISTENERS,
   200	                    )
   201	                    .await;
   202	            }
   203	        })
   204	    }
   205	
   206	    fn on_scheduled_tick<'a>(&'a self, args: OnScheduledTickArgs<'a>) -> BlockFuture<'a, ()> {
   207	        Box::pin(async move {
   208	            if let Some(block_entity) = args.world.get_block_entity(args.position) {
   209	                let Some(dispenser) = block_entity.as_any().downcast_ref::<DispenserBlockEntity>()
   210	                else {
   211	                    return;
   212	                };
   213	
   214	                if let Some((slot_index, mut item)) = dispenser.get_random_slot().await {
   215	                    let props = DispenserLikeProperties::from_state_id(
   216	                        args.world.get_block_state(args.position).id,
   217	                        args.block,
   218	                    );
   219	                    let ctx = DispenseContext::new(&args, props.facing);
   220	                    Self::dispense(&ctx, dispenser, &mut item).await;
   221	                    dispenser.set_stack(slot_index, item).await;
   222	                } else {
   223	                    args.world
   224	                        .sync_world_event(WorldEvent::SoundDispenserFail, *args.position, 0);
   225	                }
   226	            }
   227	        })
   228	    }
   229	
   230	    fn get_comparator_output<'a>(
   231	        &'a self,
   232	        args: GetComparatorOutputArgs<'a>,
   233	    ) -> BlockFuture<'a, Option<u8>> {
   234	        Box::pin(async move {
   235	            if let Some(block_entity) = args.world.get_block_entity(args.position)
   236	                && let Some(inventory) = block_entity.get_inventory()
   237	            {
   238	                Some(crate::block::calculate_comparator_output(inventory.as_ref()).await)
   239	            } else {
   240	                None
   241	            }
   242	        })
   243	    }
   244	}

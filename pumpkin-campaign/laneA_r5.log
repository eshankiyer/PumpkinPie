    70	struct DispenserScreenFactory(Arc<dyn Inventory>);
    71	
    72	impl ScreenHandlerFactory for DispenserScreenFactory {
    73	    fn create_screen_handler<'a>(
    74	        &'a self,
    75	        sync_id: u8,
    76	        player_inventory: &'a Arc<PlayerInventory>,
    77	        _player: &'a dyn InventoryPlayer,
    78	    ) -> BoxFuture<'a, Option<SharedScreenHandler>> {
    79	        Box::pin(async move {
    80	            let handler = create_generic_3x3(sync_id, player_inventory, self.0.clone()).await;
    81	            let screen_handler_arc = Arc::new(Mutex::new(handler));
    82	
    83	            Some(screen_handler_arc as SharedScreenHandler)
    84	        })
    85	    }
    86	
    87	    fn get_display_name(&self) -> TextComponent {
    88	        pumpkin_macros::translate_cross!(
    89	            translation::java::CONTAINER_DISPENSER,
    90	            translation::bedrock::CONTAINER_DISPENSER
    91	        )
    92	    }
    93	}

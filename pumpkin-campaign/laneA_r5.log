   341	   @Override
   342	   protected void playStepSound(final BlockPos pos, final BlockState blockState) {
   343	      if (!blockState.liquid()) {
   344	         BlockState aboveState = this.level().getBlockState(pos.above());
   345	         SoundType soundType = blockState.getSoundType();
   346	         if (aboveState.is(Blocks.SNOW)) {
   347	            soundType = aboveState.getSoundType();
   348	         }
   349	
   350	         if (this.isVehicle() && this.canGallop) {
   351	            this.gallopSoundCounter++;
   352	            if (this.gallopSoundCounter > 5 && this.gallopSoundCounter % 3 == 0) {
   353	               this.playGallopSound(soundType);
   354	            } else if (this.gallopSoundCounter <= 5) {
   355	               this.playSound(SoundEvents.HORSE_STEP_WOOD, soundType.getVolume() * 0.15F, soundType.getPitch());
   356	            }
   357	         } else if (this.isWoodSoundType(soundType)) {
   358	            this.playSound(SoundEvents.HORSE_STEP_WOOD, soundType.getVolume() * 0.15F, soundType.getPitch());
   359	         } else {
   360	            this.playSound(this.isBaby() ? SoundEvents.HORSE_STEP_BABY : SoundEvents.HORSE_STEP, soundType.getVolume() * 0.15F, soundType.getPitch());
   361	         }
   362	      }
   363	   }

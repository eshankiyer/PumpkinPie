  5974	            }
  5975	        }
  5976	
  5977	        for (slot_index, equipment_slot) in slot_pairs {
  5978	            let stack = self.inventory().get_stack(slot_index).await;
  5979	            if stack.get_enchantment_level(&Enchantment::MENDING) > 0 && stack.get_damage() > 0 {

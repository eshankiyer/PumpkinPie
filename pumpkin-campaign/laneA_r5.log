   223	        let equipment = self.living_entity.entity_equipment.lock().await;
   224	        let equipped_items: Vec<_> = equipment.equipment.values().cloned().collect();
   225	        drop(equipment);
   226	
   227	        for mut stack in equipped_items {
   228	            if stack.is_empty() {
   229	                continue;
   230	            }
   231	            let dropped = stack.clone();
   232	            stack.clear();
   233	            drop(stack);
   234	            entity
   235	                .world
   236	                .load()
   237	                .drop_stack(&entity.block_pos.load(), dropped)
   238	                .await;
   239	        }
   240	
   241	        //let name = entity.custom_name.unwrap_or(entity.get_name());
   242	
   243	        //TODO: i am stupid! let armor_stand_item = ItemStack::new_with_component(1, &Item::ARMOR_STAND, vec![(DataComponent::CustomName, self.get_custom_name())]);
   244	        let armor_stand_item = ItemStack::new(1, &Item::ARMOR_STAND);
   245	        entity
   246	            .world
   247	            .load()
   248	            .drop_stack(&entity.block_pos.load(), armor_stand_item)
   249	            .await;
   250	
   251	        Self::on_break(entity);
   252	    }

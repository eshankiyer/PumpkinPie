   283	        //let scan_start = Instant::now();
   284	
   285	        let center_x = cache.x + (cache.size / 2);
   286	        let center_z = cache.z + (cache.size / 2);
   287	        let start_x = center_x * 16 - 1;
   288	        let start_z = center_z * 16 - 1;
   289	        let end_x = start_x + 18;
   290	        let end_z = start_z + 18;
   291	
   292	        let bottom_y = cache.bottom_y() as i32;
   293	        let max_y = bottom_y + cache.height() as i32;
   294	
   295	        // Pre-allocate with exact size needed
   296	        let capacity = ((end_x - start_x) * (end_z - start_z)) as usize;
   297	        let mut source_heights =
   298	            FastHashMap::with_capacity_and_hasher(capacity, rustc_hash::FxBuildHasher);
   299	
   300	        // Process in Z-outer, X-inner order for better cache locality
   301	        for z in start_z..end_z {
   302	            let chunk_z = z >> 4;
   303	            let local_z = (z & 15) as usize;
   304	
   305	            for x in start_x..end_x {
   306	                let chunk_x = x >> 4;
   307	                let local_x = (x & 15) as usize;
   308	
   309	                let source_y = Self::lowest_source_y(cache, x, z, bottom_y, max_y);
   310	                source_heights.insert((x, z), source_y);
   311	
   312	                // Get chunk index once per column
   313	                let rel_x = chunk_x - cache.x;
   314	                let rel_z = chunk_z - cache.z;
   315	
   316	                if rel_x < 0 || rel_x >= cache.size || rel_z < 0 || rel_z >= cache.size {
   317	                    continue;
   318	                }
   319	
   320	                let chunk_idx = (rel_x * cache.size + rel_z) as usize;
   321	
   322	                // Fill every direct-sky source node with 15 immediately.
   323	                for y in source_y.max(bottom_y)..max_y {
   324	                    let section_idx = ((y - bottom_y) >> 4) as usize;
   325	                    let local_y = (y & 15) as usize;
   326	
   327	                    // Direct array access - skip all function call overhead
   328	                    match &mut cache.chunks[chunk_idx] {
   329	                        Chunk::Proto(c) => {
   330	                            if section_idx < c.light.sky_light.len() {
   331	                                c.light.sky_light[section_idx].set(local_x, local_y, local_z, 15);
   332	                            }
   333	                        }
   334	                        Chunk::Level(c) => {
   335	                            let mut light_engine = c
   336	                                .light_engine
   337	                                .lock()
   338	                                .unwrap_or_else(std::sync::PoisonError::into_inner);
   339	                            if section_idx < light_engine.sky_light.len() {
   340	                                light_engine.sky_light[section_idx]
   341	                                    .set(local_x, local_y, local_z, 15);
   342	                            }
   343	                        }
   344	                    }
   345	                }
   346	
   347	                // Attenuate from the first non-source block downward.
   348	                let mut light: i32 = 15;
   349	
   350	                if source_y > bottom_y {
   351	                    for y in (bottom_y..source_y).rev() {
   352	                        let section_idx = ((y - bottom_y) >> 4) as usize;
   353	                        let local_y = (y & 15) as usize;
   354	
   355	                        // Get block opacity
   356	                        let state = {
   357	                            let pos_vec = Vector3::new(x, y, z);
   358	                            cache.get_block_state(&pos_vec).to_state()
   359	                        };
   360	                        let above_state = if y + 1 >= max_y {
   360	                        let above_state = if y + 1 >= max_y {
   361	                            Block::AIR.default_state
   362	                        } else {
   363	                            let pos_vec = Vector3::new(x, y + 1, z);
   364	                            cache.get_block_state(&pos_vec).to_state()
   365	                        };
   366	
   367	                        // The direct column is blocked either by ordinary light
   368	                        // dampening or by the pair of voxel faces that closes
   369	                        // the edge. Vanilla's `SkyLightEngine` checks both
   370	                        // (`LightEngine.shapeOccludes` and
   371	                        // `ChunkSkyLightSources.isEdgeOccluded`).
   372	                        if pumpkin_data::light_shape_occludes(
   373	                            above_state,
   374	                            state,
   375	                            BlockDirection::Down,
   376	                        ) {
   377	                            light = 0;
   378	                        } else {
   379	                            light = light.saturating_sub(i32::from(state.opacity.max(1)));
   380	                        }
   381	
   382	                        // Set the light value directly
   383	                        let light_val = if light <= 0 { 0 } else { light as u8 };
   384	
   385	                        match &mut cache.chunks[chunk_idx] {
   386	                            Chunk::Proto(c) => {
   387	                                if section_idx < c.light.sky_light.len() {
   388	                                    c.light.sky_light[section_idx]
   389	                                        .set(local_x, local_y, local_z, light_val);
   390	                                }
   391	                            }
   392	                            Chunk::Level(c) => {
   393	                                let mut light_engine = c
   394	                                    .light_engine
   395	                                    .lock()
   396	                                    .unwrap_or_else(std::sync::PoisonError::into_inner);
   397	                                if section_idx < light_engine.sky_light.len() {
   398	                                    light_engine.sky_light[section_idx]
   399	                                        .set(local_x, local_y, local_z, light_val);
   400	                                }
   401	                            }
   402	                        }

   167	pub fn sync_read_items_from_nbt(nbt: &NbtCompound, stacks: &mut [ItemStack]) {
   168	    if let Some(inventory_list) = nbt.get_list("Items") {
   169	        for tag in inventory_list {
   170	            if let Some(item_compound) = tag.extract_compound()
   171	                && let Some(slot_byte) = item_compound.get_byte("Slot")
   172	            {
   173	                let slot = slot_byte as usize;
   174	                if slot < stacks.len()
   175	                    && let Some(item_stack) = ItemStack::read_item_stack(item_compound)
   176	                {
   177	                    stacks[slot] = item_stack;
   178	                }
   179	            }
   180	        }
   181	    }
   182	}
   183	
   184	pub fn sync_write_items_to_nbt(items: &[ItemStack], nbt: &mut NbtCompound) {
   185	    let mut slots = Vec::new();
   186	    for (i, stack) in items.iter().enumerate() {
   187	        if !stack.is_empty() {
   188	            let mut item_nbt = NbtCompound::new();
   189	            item_nbt.put_byte("Slot", i as i8);
   190	            stack.write_item_stack(&mut item_nbt);
   191	            slots.push(NbtTag::Compound(item_nbt));
   192	        }
   193	    }
   194	    if !slots.is_empty() {
   195	        nbt.put_list("Items", slots);
   196	    }
   197	}

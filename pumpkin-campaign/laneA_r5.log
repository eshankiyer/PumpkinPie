  8042	impl MessageCache {
  8043	    /// Not used for caching seen messages. Only for non-indexed signatures from senders.
  8044	    pub fn cache_signatures(&mut self, signatures: &[Box<[u8]>]) {
  8045	        for sig in signatures.iter().rev() {
  8046	            if self.full_cache.contains(sig) {
  8047	                continue;
  8048	            }
  8049	            // If the cache is maxed, and someone sends a signature older than the oldest in cache, ignore it
  8050	            if self.full_cache.len() < MAX_CACHED_SIGNATURES as usize {
  8051	                self.full_cache.push_back(sig.clone()); // Recipient never saw this message so it must be older than the oldest in cache
  8052	            }
  8053	        }
  8054	    }
  8055	
  8056	    /// Adds a seen signature to `last_seen` and `full_cache`.
  8057	    pub fn add_seen_signature(&mut self, signature: &[u8]) {
  8058	        if self.last_seen.0.len() >= MAX_PREVIOUS_MESSAGES as usize {
  8059	            self.last_seen.0.remove(0);
  8060	        }
  8061	        self.last_seen.0.push(signature.into());
  8062	        // This probably doesn't need to be a loop, but better safe than sorry
  8063	        while self.full_cache.len() >= MAX_CACHED_SIGNATURES as usize {
  8064	            self.full_cache.pop_back();
  8065	        }
  8066	        self.full_cache.push_front(signature.into()); // Since recipient saw this message it will be most recent in cache
  8067	    }
  8068	}

   168	   public static @Nullable BlockEntity loadStatic(final BlockPos pos, final BlockState state, final CompoundTag tag, final HolderLookup.Provider registries) {
   169	      BlockEntityType<?> type = tag.read("id", TYPE_CODEC).orElse(null);
   170	      if (type == null) {
   171	         LOGGER.error("Skipping block entity with invalid type: {}", tag.get("id"));
   172	         return null;
   173	      }
   174	
   175	      BlockEntity entity;
   176	      try {
   177	         entity = type.create(pos, state);
   178	      } catch (Throwable t) {
   179	         LOGGER.error("Failed to create block entity {} for block {} at position {} ", type, pos, state, t);
   180	         return null;
   181	      }
   182	
   183	      try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(entity.problemPath(), LOGGER)) {
   184	         entity.loadWithComponents(TagValueInput.create(reporter, registries, tag));
   185	         return entity;
   186	      } catch (Throwable t) {
   187	         LOGGER.error("Failed to load data for block entity {} for block {} at position {}", type, pos, state, t);
   188	         return null;
   189	      }
   190	   }

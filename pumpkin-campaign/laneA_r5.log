   469	#[derive(Copy, Clone, Default, Debug)]
   470	pub(crate) enum EntitySelectorParserSuggestions {
   471	    #[default]
   472	    Nothing,
   473	
   474	    Selector,
   475	    OpenOptions,
   476	    OptionsKeyOrClose,
   477	    Name,
   478	    OptionsKey,
   479	    OptionsNextOrClose,
   480	    NameOrSelector,
   481	    Sort,
   482	    Gamemode,
   483	}
   484	
   485	impl EntitySelectorParserSuggestions {
   486	    pub fn fill_suggestions(
   487	        self,
   488	        mut builder: SuggestionsBuilder,
   489	        names: impl FnOnce(SuggestionsBuilder) -> SuggestionsBuilder,
   490	        parser: &EntitySelectorParser,
   491	    ) -> Suggestions {
   492	        match self {
   493	            Self::Nothing => {}
   494	            Self::Selector => {
   495	                let mut sub = builder.create_offset(builder.start.saturating_sub(1));
   496	                sub = Self::fill_selector_suggestions(sub);
   497	                builder = builder.append(sub);
   498	            }
   499	            Self::OpenOptions => {
   500	                builder = builder.suggest("[");
   501	            }
   502	            Self::OptionsKeyOrClose => {
   503	                builder = builder.suggest("]");
   504	                builder = EntitySelectorOption::suggest_names(parser, builder);
   505	            }
   506	            Self::Name => {
   507	                let mut sub = builder.create_offset(parser.start_position);
   508	                sub = names(sub);
   509	                builder = builder.append(sub);
   510	            }
   511	            Self::OptionsKey => builder = EntitySelectorOption::suggest_names(parser, builder),
   512	            Self::OptionsNextOrClose => {
   513	                builder = builder.suggest(",");
   514	                builder = builder.suggest("]");
   515	            }
   516	            Self::NameOrSelector => {
   517	                builder = names(builder);
   518	                if parser.allows_selector_variable {
   519	                    builder = Self::fill_selector_suggestions(builder);
   520	                }
   521	            }
   522	            Self::Sort => {
   523	                builder =
   524	                    builder.filter_and_suggest(&["nearest", "furthest", "random", "arbitrary"]);
   525	            }
   526	            Self::Gamemode => {
   527	                let mut prefix = builder.remaining_lowercase();
   528	                let mut add_normal = !parser.has_flag(Flags::GAMEMODE_NOT_EQUALS_SET);
   529	                let mut add_inverted = true;
   530	
   531	                if !prefix.is_empty() {
   532	                    // ! is an ASCII character, so this is fine.
   533	                    if prefix.as_bytes()[0] == b'!' {
   534	                        add_normal = false;
   535	                        prefix = &prefix[1..];
   536	                    } else {
   537	                        add_inverted = false;
   538	                    }
   539	                }
   540	
   541	                let mut suggestions: Vec<SuggestionText> =
   542	                    Vec::with_capacity(GameMode::VALUES.len() * 2);
   543	                for gamemode in GameMode::VALUES {
   544	                    if gamemode.name().starts_with(prefix) {
   545	                        if add_inverted {
   546	                            suggestions.push(format!("!{}", gamemode.name()).into());
   547	                        }
   548	                        if add_normal {
   549	                            suggestions.push(gamemode.name().into());
   550	                        }
   551	                    }
   552	                }
   553	                for suggestion in suggestions {
   554	                    builder = builder.suggest(suggestion);
   555	                }
   556	            }
   557	        }
   558	
   559	        builder.build()
   560	    }

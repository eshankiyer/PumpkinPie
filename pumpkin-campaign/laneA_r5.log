   347	/// Mirrors vanilla `AbstractHorse` (Horse.java's superclass). Species implement this to get
   348	/// taming, feeding, saddling, breeding-attribute-inheritance and `randomizeAttributes` for free.
   349	///
   350	/// Deliberately `Animal`-bound (not just `Mob`) since vanilla's `AbstractHorse` itself extends
   351	/// `Animal`; this also means the required `Animal::is_food` impl species already carry for the
   352	/// generic baby-growth path doubles as the horse-specific food-tag check here.
   353	pub trait AbstractHorse: Animal {
   354	    fn horse_data(&self) -> &AbstractHorseData;
   355	
   356	    fn max_temper(&self) -> i32 {
   357	        100
   358	    }
   359	
   360	    /// `AbstractHorse.getTemper`.
   361	    fn get_temper(&self) -> i32 {
   362	        self.horse_data().temper.load(Relaxed)
   363	    }
   364	
   365	    /// `AbstractHorse.modifyTemper` (`AbstractHorse.java:247-250`).
   366	    fn modify_temper(&self, amount: i32) -> i32 {
   367	        let temper = (self.get_temper() + amount).clamp(0, self.max_temper());
   368	        self.horse_data().temper.store(temper, Relaxed);
   369	        temper
   370	    }
   371	
   372	    /// `AbstractHorse.isMobControlled`, default `false`. `ZombieHorseEntity` is the only
   373	    /// current override (a non-player mob riding counts as "in control").
   374	    fn is_mob_controlled(&self) -> BoxFuture<'_, bool> {
   375	        Box::pin(async { false })
   376	    }
   377	
   378	    fn can_perform_rearing(&self) -> bool {
   379	        true
   380	    }
   381	
   382	    /// `AbstractHorse.canEatGrass`; llamas override this to `false`.
   383	    fn can_eat_grass(&self) -> bool {
   384	        true
   385	    }
   386	
   387	    /// Server-side portion of `AbstractHorse.aiStep` and `tick`: start haystack
   388	    /// eating beneath the horse and expire the 20-tick standing pose.
   389	    fn tick_horse_ai(&self) -> EntityBaseFuture<'_, ()> {
   390	        Box::pin(async move {
   391	            let data = self.horse_data();
   392	            if data.stand_counter.load(Relaxed) > 0 && data.stand_counter.fetch_sub(1, Relaxed) <= 1
   393	            {
   394	                self.clear_standing();
   395	            }
   396	
   397	            let entity = self.get_entity();
   398	            let is_vehicle = !entity.passengers.lock().await.is_empty();
   399	            if self.can_eat_grass()
   400	                && !data.get_flag(FLAG_EATING)
   401	                && !is_vehicle
   402	                && self.get_random().random_range(0..300) == 0
   403	                && entity
   404	                    .world
   405	                    .load()
   406	                    .get_block(&entity.block_pos.load().down())
   407	                    .id
   408	                    == Block::GRASS_BLOCK.id
   409	            {
   410	                data.set_flag(FLAG_EATING, true);
   411	            }
   412	
   413	            if data.get_flag(FLAG_EATING) && data.eating_counter.fetch_add(1, Relaxed) + 1 > 50 {
   414	                data.eating_counter.store(0, Relaxed);
   415	                data.set_flag(FLAG_EATING, false);

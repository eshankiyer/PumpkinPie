    35	    /// Gets a template by `name`, loading it from embedded resources if not cached.
    36	    ///
    37	    /// Returns the loaded template wrapped in an `Arc`, or `None` if the template
    38	    /// doesn't exist or failed to load.
    39	    pub fn get(&self, name: &str) -> Option<Arc<StructureTemplate>> {
    40	        let name = name.strip_prefix("minecraft:").unwrap_or(name);
    41	
    42	        // Check cache first
    43	        if let Some(template) = self.cache.get(name) {
    44	            return Some(Arc::clone(&template));
    45	        }
    46	
    47	        // Try to load the template
    48	        let bytes = Self::load_template_bytes(name)?;
    49	
    50	        match StructureTemplate::from_nbt_bytes(bytes) {
    51	            Ok(template) => {
    52	                let arc = Arc::new(template);
    53	                self.cache.insert(name.to_owned(), Arc::clone(&arc));
    54	                Some(arc)
    55	            }
    56	            Err(e) => {
    57	                tracing::error!("Failed to load template '{}': {}", name, e);
    58	                None
    59	            }
    60	        }
    61	    }

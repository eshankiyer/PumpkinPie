   335	   public boolean primeTime(final boolean imminent) {
   336	      if (!this.explosionData.isEmpty()
   337	         && this.isAlive()
   338	         && this.level() instanceof ServerLevel serverLevel
   339	         && serverLevel.getGameRules().get(GameRules.TNT_EXPLODES)
   340	         && !this.isPrimed()) {
   341	         int fuse = this.explosionData.get().fuse();
   342	         int fuseTime = imminent ? PrimedTnt.getRandomShortFuse(fuse, this.getRandom()) : fuse;
   343	         this.setInvulnerable(true);
   344	         this.setFuse(fuseTime);

   112	/// Clears or counts matching stacks in an async inventory, preserving the
   113	/// `ContainerHelper.clearOrCountMatchingItems` ordering and amount semantics
   114	/// (ContainerHelper.java:48-80).
   115	async fn clear_inventory(
   116	    inventory: &dyn Inventory,
   117	    item: &ItemPredicate,
   118	    amount_to_remove: i32,
   119	) -> i32 {
   120	    let counting_only = amount_to_remove == 0;
   121	    let mut remaining = amount_to_remove;
   122	    let mut count = 0;
   123	
   124	    for slot in 0..inventory.size() {
   125	        let stack = inventory.get_stack(slot).await;
   126	        if stack.is_empty() || !item.test_item_stack(&stack) {
   127	            continue;
   128	        }

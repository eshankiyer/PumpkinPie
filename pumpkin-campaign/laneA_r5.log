   608	    /// A 3x3 cache of freshly generated proto chunks holding a synthetic ocean:
   609	    /// stone from the world bottom up to `seabed_y`, water from `seabed_y + 1`
   610	    /// up to `surface_y`, open air above.
   611	    fn ocean_cache(seabed_y: i32, surface_y: i32) -> Cache {
   612	        let world_gen = get_world_gen(
   613	            Seed(42),
   614	            Dimension::OVERWORLD,
   615	            false,
   616	            Vec::new(),
   617	            String::new(),
   618	        );
   619	
   620	        let mut chunks = Vec::new();
   621	        for dx in -1..=1 {
   622	            for dz in -1..=1 {
   623	                let mut proto = ProtoChunk::new(dx, dz, &world_gen);
   624	                let bottom = proto.bottom_y() as i32;
   625	                for x in (dx * 16)..(dx * 16 + 16) {
   626	                    for z in (dz * 16)..(dz * 16 + 16) {
   627	                        for y in bottom..=seabed_y {
   628	                            proto.set_block_state(x, y, z, Block::STONE.default_state);
   629	                        }
   630	                        for y in (seabed_y + 1)..=surface_y {
   631	                            proto.set_block_state(x, y, z, Block::WATER.default_state);
   632	                        }
   633	                    }
   634	                }
   635	                chunks.push(Chunk::Proto(Box::new(proto)));
   636	            }
   637	        }
   638	
   639	        Cache {
   640	            x: -1,
   641	            z: -1,
   642	            size: 3,
   643	            chunks,
   644	        }
   645	    }
   646	
   647	    /// Vanilla: water's `getLightBlock` is 1, and the sky light engine charges
   648	    /// `max(1, opacity)` per step except straight down through a block that
   649	    /// propagates sky light (which water does not). So a water column loses
   650	    /// exactly one level per block: 15 in the air above the surface, 14 at the
   651	    /// topmost water block, and 0 fifteen blocks below that. A deep ocean floor
   652	    /// is genuinely pitch black. See <https://minecraft.wiki/w/Light>
   653	    /// ("Sunlight ... decreases by one level for each block of water").
   654	    #[test]
   655	    fn sky_light_attenuates_one_level_per_water_block() {
   656	        let surface_y = 62;
   657	        let seabed_y = 20;
   658	        let mut cache = ocean_cache(seabed_y, surface_y);
   659	        let mut engine = LightEngine::new();
   660	        engine.initialize_light(&mut cache, &LightingEngineConfig::Default, true);
   661	
   662	        let at = |cache: &Cache, y: i32| get_sky_light(cache, BlockPos(Vector3::new(8, y, 8)));
   663	
   664	        // Open air above the ocean surface.
   665	        assert_eq!(at(&cache, surface_y + 1), 15, "air above the water surface");
   666	
   667	        // One level per water block, down to darkness.
   668	        for depth in 0..=14i32 {
   669	            let y = surface_y - depth;
   670	            assert_eq!(
   671	                at(&cache, y),
   672	                14 - depth as u8,
   673	                "water at y={y} (depth {depth} below the surface)"
   674	            );
   675	        }
   676	
   677	        // Fifteen blocks below the surface and everything under it is dark,
   678	        // including the ocean floor.
   679	        for y in (seabed_y..=(surface_y - 15)).rev() {
   680	            assert_eq!(at(&cache, y), 0, "deep water / ocean floor at y={y}");
   681	        }
   682	    }
   683	
   684	    /// Non-vacuity: the assertions above are not "everything is 0" or
   685	    /// "everything is 15". A shallow pool lets a measurable, non-zero level
   686	    /// reach the floor, and the value there is the depth-derived one.
   687	    #[test]
   688	    fn shallow_water_leaves_a_measurable_level_on_the_floor() {
   689	        let surface_y = 62;
   690	        let seabed_y = 57; // 5 water blocks: 58..=62
   691	        let mut cache = ocean_cache(seabed_y, surface_y);
   692	        let mut engine = LightEngine::new();
   693	        engine.initialize_light(&mut cache, &LightingEngineConfig::Default, true);
   694	
   695	        let at = |cache: &Cache, y: i32| get_sky_light(cache, BlockPos(Vector3::new(8, y, 8)));
   696	
   697	        assert_eq!(at(&cache, surface_y + 1), 15);
   698	        assert_eq!(at(&cache, 62), 14);
   699	        assert_eq!(at(&cache, 58), 10, "lowest water block above the floor");
   700	        assert_eq!(at(&cache, seabed_y), 0, "opaque stone floor");
   701	    }
   702	
   703	    #[test]
   704	    fn deep_enclosed_block_stays_dark_without_a_world_surface_heightmap() {
   705	        let mut cache = cache_from_heightmapless_disk_chunks();
   706	        let mut engine = LightEngine::new();
   707	        engine.initialize_light(&mut cache, &LightingEngineConfig::Default, true);
   708	
   709	        // Sections -4..=3 are solid stone, so y = 0 is buried under 64 blocks of
   710	        // it with no sky access. A missing `WORLD_SURFACE` heightmap used to
   711	        // make `get_top_y` answer `min_y - 1`, i.e. "this column is empty", and
   712	        // the producer then filled the whole column with 15 - straight through
   713	        // the stone and out into neighbouring chunks.
   714	        for pos in [
   715	            BlockPos(Vector3::new(8, 0, 8)),
   716	            BlockPos(Vector3::new(0, -60, 0)),
   717	            BlockPos(Vector3::new(15, 32, 15)),
   718	        ] {
   719	            assert_eq!(
   720	                get_sky_light(&cache, pos),
   721	                0,
   722	                "enclosed position {pos:?} must be dark"
   723	            );
   724	        }
   725	
   726	        // The same run must still light open sky above the terrain, so the
   727	        // assertions above are not just "everything is 0".
   728	        assert_eq!(get_sky_light(&cache, BlockPos(Vector3::new(8, 100, 8))), 15);
   729	    }

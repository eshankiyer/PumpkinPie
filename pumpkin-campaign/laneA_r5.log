   742	   private void playerPush(final Player player) {
   743	      if (this.hasBodyItem()) {
   744	         Entity pusher = player.isPassenger() ? player.getRootVehicle() : player;
   745	         Vec3 cubeToPusher = this.position().subtract(pusher.position());
   746	         double pusherFeetPosition = pusher.getY();
   747	         double sulfurCubeBottomPosition = this.getY();
   748	         double sulfurCubeTopPosition = sulfurCubeBottomPosition + this.getBbHeight();
   749	         double pusherTopPosition = pusherFeetPosition + pusher.getBbHeight();
   750	         if (cubeToPusher.horizontalDistance() < 1.3F && pusherFeetPosition <= sulfurCubeTopPosition && pusherTopPosition > sulfurCubeBottomPosition) {
   751	            double knockback = Math.max(0.0, 1.0 - this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE));
   752	            Vec3 pushDirection = cubeToPusher.horizontal().normalize().scale(knockback);
   753	            float pushSpeedScale = player.isPassenger() ? 0.16F : 0.3F;
   754	            double playerSpeed = player.getKnownSpeed().length() * 2.0 * pushSpeedScale;
   755	            playerSpeed = Mth.clamp(playerSpeed, 0.0, 0.5);
   756	            Vec3 pushVelocity = new Vec3(pushDirection.x, this.onGround() ? knockback * 0.3F : 0.0, pushDirection.z).scale(playerSpeed);
   757	            this.needsSync = true;
   758	            float push_sound_threshold = this.soundSettings.pushSoundImpulseThreshold();
   759	            if (pushVelocity.lengthSqr() > push_sound_threshold * push_sound_threshold && this.pushSoundCooldown <= 0) {
   760	               this.pushSoundCooldown = (int)(this.soundSettings.pushSoundCooldown() * 20.0F);
   761	               this.playSound(this.soundSettings.pushSound().value());
   762	            }
   763	
   764	            this.addDeltaMovement(pushVelocity);
   765	            this.applyContactDamage(player);
   766	         }
   767	      }
   768	   }

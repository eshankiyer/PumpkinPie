   829	   @Override
   830	   public void knockback(final double power, double xd, double zd, final DamageSource source, final float damage, final boolean comesFromEffect) {
   831	      if (source.getEntity() != null && this.hasBodyItem()) {
   832	         float horizontalHitAngleScale = 1.6F;
   833	         float verticalHitAngleScale = 0.5F;
   834	         float verticalPositionAngleScale = 0.8F;
   835	         float horizontalPower = this.knockbackModifier.horizontalPower();
   836	         float verticalPower = this.knockbackModifier.verticalPower();
   837	         float originalHorizontalPower = horizontalPower;
   838	         float originalVerticalPower = verticalPower;
   839	         Holder<SoundEvent> hitSound = this.soundSettings.hitSound();
   840	         Vec2 originalAngle = new Vec2((float)xd, (float)zd);
   841	         Vec2 newAngle = this.applyHorizontalHitAngleScale(
   842	            1.6F, originalAngle, source.getEntity().getEyePosition(), source.getEntity().getLookAngle().normalize(), this.getBoundingBox().getCenter()
   843	         );
   844	         Vec2 newPower = this.applyVerticalHitAnglePowerTransfer(
   845	            0.5F,
   846	            horizontalPower,
   847	            verticalPower,
   848	            source.getEntity().getEyePosition(),
   849	            source.getEntity().getLookAngle().normalize(),
   850	            this.getBoundingBox().getCenter(),
   851	            this.getBbHeight()
   852	         );
   853	         horizontalPower = newPower.x;
   854	         verticalPower = newPower.y;
   855	         newPower = this.applyVerticalPositionAnglePowerRotation(
   856	            0.8F, horizontalPower, verticalPower, originalHorizontalPower, originalVerticalPower, source.getEntity().position(), this.position()
   857	         );
   858	         horizontalPower = newPower.x;
   859	         verticalPower = newPower.y;
   860	         xd = newAngle.x;
   861	         zd = newAngle.y;
   862	         float powerMultiplier = Mth.sqrt(damage) * (comesFromEffect ? (float)power * 0.25F : 1.0F);
   863	         horizontalPower *= powerMultiplier;
   864	         verticalPower *= powerMultiplier;
   865	         double knockBackResistance = this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE);
   866	         horizontalPower *= (float)(1.0 - knockBackResistance);
   867	         verticalPower *= (float)(1.0 - knockBackResistance);
   868	         this.needsSync = true;
   869	         Vec3 deltaMovement = this.getDeltaMovement();
   870	         horizontalPower *= 0.4F;
   871	         horizontalPower = Mth.clamp(horizontalPower, -128.0F, 128.0F);
   872	         verticalPower = Mth.clamp(verticalPower, -128.0F, 128.0F);
   873	         Vec3 horizontalKnockback = new Vec3(xd, 0.0, zd).normalize().scale(horizontalPower);
   874	         this.setDeltaMovement(deltaMovement.x - horizontalKnockback.x, deltaMovement.y + verticalPower * 1.2, deltaMovement.z - horizontalKnockback.z);
   875	         this.playSound(hitSound.value());
   876	      } else {
   877	         super.knockback(power, xd, zd, source, damage, comesFromEffect);
   878	      }
   879	   }

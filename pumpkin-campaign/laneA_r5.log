   590	    /// `AbstractHorse.handleEating`: the default wheat/sugar/hay/apple/mushroom/carrot/golden
   591	    /// carrot/golden apple table (`AbstractHorse.java:423-493`). Species with a different food
   592	    /// table (Llama, out of scope here) override this instead of extending it.
   593	    fn handle_eating<'a>(
   594	        &'a self,
   595	        player: &'a Arc<Player>,
   596	        item_stack: &'a ItemStack,
   597	    ) -> EntityBaseFuture<'a, bool> {
   598	        Box::pin(async move {
   599	            let id = item_stack.item.id;
   600	            let (heal, age_up_seconds, temper): (f32, i32, i32) = if id == Item::WHEAT.id {
   601	                (2.0, 20, 3)
   602	            } else if id == Item::SUGAR.id {
   603	                (1.0, 30, 3)
   604	            } else if id == Item::HAY_BLOCK.id {
   605	                (20.0, 180, 0)
   606	            } else if id == Item::APPLE.id {
   607	                (3.0, 60, 3)
   608	            } else if id == Item::RED_MUSHROOM.id {
   609	                (3.0, 0, 3)
   610	            } else if id == Item::CARROT.id {
   611	                (3.0, 60, 3)
   612	            } else if id == Item::GOLDEN_CARROT.id {
   613	                (4.0, 60, 5)
   614	            } else if id == Item::GOLDEN_APPLE.id || id == Item::ENCHANTED_GOLDEN_APPLE.id {
   615	                (10.0, 240, 10)
   616	            } else {
   617	                return false;
   618	            };
   619	
   620	            let mut item_used = false;
   621	            let is_golden = id == Item::GOLDEN_CARROT.id
   622	                || id == Item::GOLDEN_APPLE.id
   623	                || id == Item::ENCHANTED_GOLDEN_APPLE.id;
   624	
   625	            let mob_entity = self.get_mob_entity();
   626	            if is_golden
   627	                && self.can_fall_in_love()
   628	                && self.is_tamed()
   629	                && !self.is_baby()
   630	                && !mob_entity.is_in_love()
   631	            {
   632	                item_used = true;
   633	                mob_entity.set_love_ticks(600, Some(player.gameprofile.id));
   634	                let entity = &mob_entity.living_entity.entity;
   635	                entity.world.load().send_entity_status(
   636	                    entity,
   637	                    pumpkin_data::entity::EntityStatus::InLoveHearts,
   638	                    Some(pumpkin_protocol::bedrock::server::actor_event::ActorEventType::InLoveHearts),
   639	                );
   640	            }
   641	
   642	            let living = &mob_entity.living_entity;
   643	            if living.health.load() < living.get_max_health() && heal > 0.0 {
   644	                living.heal(heal);
   645	                item_used = true;
   646	            }
   647	
   648	            if self.is_baby() && age_up_seconds > 0 {
   649	                let entity = self.get_entity();
   650	                let world = entity.world.load();
   651	                let pos = entity.pos.load();
   652	                world.spawn_particle(
   653	                    pos + Vector3::new(0.0, f64::from(entity.height()) * 0.5, 0.0),
   654	                    Vector3::new(0.5, 0.5, 0.5),
   655	                    1.0,
   656	                    7,
   657	                    Particle::HappyVillager,
   658	                );
   659	                let new_age = (entity.age.load(Relaxed) + age_up_seconds * 20).min(0);
   660	                entity.age.store(new_age, Relaxed);
   661	                item_used = true;
   662	            }
   663	
   664	            if temper > 0
   665	                && (item_used || !self.is_tamed())
   666	                && self.horse_data().temper.load(Relaxed) < self.max_temper()
   667	            {
   668	                let new_temper =
   669	                    (self.horse_data().temper.load(Relaxed) + temper).clamp(0, self.max_temper());
   670	                self.horse_data().temper.store(new_temper, Relaxed);
   671	                item_used = true;
   672	            }
   673	
   674	            if item_used {
   675	                self.horse_data().set_flag(FLAG_EATING, true);
   676	            }
   677	
   678	            item_used
   679	        })
   680	    }

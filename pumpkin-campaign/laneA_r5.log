   226	            Self::Y => coordinate_option_impl!(parser, pos, y),
   227	            Self::Z => coordinate_option_impl!(parser, pos, z),
   228	            Self::Dx => coordinate_option_impl!(parser, delta, x),
   229	            Self::Dy => coordinate_option_impl!(parser, delta, y),
   230	            Self::Dz => coordinate_option_impl!(parser, delta, z),
   231	            Self::XRotation => rotation_option_impl!(parser, x),

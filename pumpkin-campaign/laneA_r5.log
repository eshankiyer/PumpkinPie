   831	   private void setOffspringAttribute(
   832	      final AgeableMob partner, final AbstractHorse baby, final Holder<Attribute> attribute, final double attributeRangeMin, final double attributeRangeMax
   833	   ) {
   834	      double newValue = createOffspringAttribute(
   835	         this.getAttributeBaseValue(attribute), partner.getAttributeBaseValue(attribute), attributeRangeMin, attributeRangeMax, this.random
   836	      );
   837	      baby.getAttribute(attribute).setBaseValue(newValue);
   838	   }
   839	
   840	   public static double createOffspringAttribute(
   841	      double parentAValue, double parentBValue, final double attributeRangeMin, final double attributeRangeMax, final RandomSource random
   842	   ) {
   843	      if (attributeRangeMax <= attributeRangeMin) {
   844	         throw new IllegalArgumentException("Incorrect range for an attribute");
   845	      } else {
   846	         parentAValue = Mth.clamp(parentAValue, attributeRangeMin, attributeRangeMax);
   847	         parentBValue = Mth.clamp(parentBValue, attributeRangeMin, attributeRangeMax);
   848	         double margin = 0.15 * (attributeRangeMax - attributeRangeMin);
   849	         double range = Math.abs(parentAValue - parentBValue) + margin * 2.0;
   850	         double average = (parentAValue + parentBValue) / 2.0;
   851	         double babyQuality = (random.nextDouble() + random.nextDouble() + random.nextDouble()) / 3.0 - 0.5;
   852	         double newValue = average + range * babyQuality;
   853	         if (newValue > attributeRangeMax) {
   854	            double difference = newValue - attributeRangeMax;
   855	            return attributeRangeMax - difference;
   856	         } else if (newValue < attributeRangeMin) {
   857	            double difference = attributeRangeMin - newValue;
   858	            return attributeRangeMin + difference;
   859	         } else {
   860	            return newValue;
   861	         }
   862	      }
   863	   }

    88	pub(crate) async fn equip_saddle_item(
    89	    mob_entity: &MobEntity,
    90	    player: &Arc<Player>,
    91	    item_stack: &mut ItemStack,
    92	) {
    93	    let equip_sound = item_stack
    94	        .get_data_component::<EquippableImpl>()
    95	        .map_or(IdOr::Id(Sound::ItemArmorEquipGeneric), |equippable| {
    96	            equippable.equip_sound.clone()
    97	        });
    98	    let new_stack = item_stack.split_unless_creative(player.gamemode.load(), 1);
    99	    {
   100	        let mut equipment = mob_entity.living_entity.entity_equipment.lock().await;
   101	        equipment.put(&EquipmentSlot::SADDLE, new_stack.clone());
   102	    };
   103	    mob_entity
   104	        .living_entity
   105	        .equipment_drop_chances
   106	        .lock()
   107	        .await
   108	        .insert(EquipmentSlot::SADDLE, 1.0);
   109	    mob_entity
   110	        .living_entity
   111	        .send_equipment_changes(&[(EquipmentSlot::SADDLE, new_stack)]);
   112	
   113	    let entity = &mob_entity.living_entity.entity;
   114	    let world = entity.world.load();
   115	    world.play_sound_event(&equip_sound, SoundCategory::Neutral, &entity.pos.load());
   116	}

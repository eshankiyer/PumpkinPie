   436	   @Override
   437	   protected InteractionResult mobInteract(final Player player, final InteractionHand hand) {
   438	      ItemStack heldItem = player.getItemInHand(hand);
   439	      if (this.isBaby()) {
   440	         if (this.isFood(heldItem) && this.canAgeUp()) {
   441	            int age = this.getAge();
   442	            this.usePlayerItem(player, hand, heldItem);
   443	            this.ageUp(getSpeedUpSecondsWhenFeeding(-age), true);
   444	            this.playEatingSound();
   445	            return InteractionResult.SUCCESS;
   446	         } else {
   447	            return super.mobInteract(player, hand);
   448	         }
   449	      } else {
   450	         if (this.isPrimed()) {
   451	            return InteractionResult.PASS;
   452	         }
   453	
   454	         if (!this.canExplode() || !heldItem.is(Items.FLINT_AND_STEEL) && !heldItem.is(Items.FIRE_CHARGE)) {
   455	            if (heldItem.is(Items.SHEARS) && this.readyForShearing()) {
   456	               if (this.level() instanceof ServerLevel level) {
   457	                  ItemStack itemStackToShear = this.getItemBySlot(EquipmentSlot.BODY);
   458	                  this.shear(level, SoundSource.PLAYERS, heldItem);
   459	                  this.gameEvent(GameEvent.SHEAR, player);
   460	                  heldItem.hurtAndBreak(1, player, hand.asEquipmentSlot());
   461	                  CriteriaTriggers.PLAYER_SHEARED_EQUIPMENT.trigger((ServerPlayer)player, itemStackToShear, this);
   462	               }
   463	
   464	               return InteractionResult.SUCCESS;
   465	            } else if (isSwallowableItem(heldItem)) {
   466	               boolean itWorked = this.equipItem(heldItem);
   467	               if (itWorked) {
   468	                  heldItem.consume(1, player);
   469	                  this.gameEvent(GameEvent.ENTITY_INTERACT);
   470	               }
   470	               }
   471	
   472	               return itWorked ? InteractionResult.SUCCESS_SERVER : InteractionResult.PASS;
   473	            } else {
   474	               return Bucketable.bucketMobPickup(player, hand, this).orElse(super.mobInteract(player, hand));
   475	            }
   476	         } else if (this.level() instanceof ServerLevel serverLevel && !serverLevel.getGameRules().get(GameRules.TNT_EXPLODES)) {
   477	            player.sendOverlayMessage(Component.translatable("block.minecraft.tnt.disabled"));
   478	            return InteractionResult.PASS;
   479	         } else {
   480	            this.primeTime(false);
   481	            if (heldItem.is(Items.FLINT_AND_STEEL)) {
   482	               heldItem.hurtAndBreak(1, player, hand.asEquipmentSlot());
   483	            } else {
   484	               heldItem.consume(1, player);
   485	            }
   486	
   487	            player.awardStat(Stats.ITEM_USED.get(heldItem.getItem()));
   488	            return InteractionResult.SUCCESS_SERVER;
   489	         }
   490	      }
   491	   }
   492	
   493	   public boolean equipItem(final ItemStack heldItem) {
   494	      if (this.isBaby()) {
   495	         return false;
   496	      }
   497	
   498	      if (this.hasBodyItem()) {
   499	         Item swallowedItem = this.getItemBySlot(EquipmentSlot.BODY).getItem();
   500	         if (heldItem.is(swallowedItem)) {
   501	            return false;
   502	         }
   503	
   504	         Vec3 equipmentSpawnOffset = this.getAttachments().getAverage(EntityAttachment.PASSENGER);
   505	         if (this.level() instanceof ServerLevel serverLevel) {
   506	            this.spawnAtLocation(serverLevel, this.getItemBySlot(EquipmentSlot.BODY), equipmentSpawnOffset);
   507	         }
   508	      }
   509	
   510	      if (!this.level().isClientSide()) {
   511	         ItemStack swallowedItem = this.getItemBySlot(EquipmentSlot.BODY);
   512	         this.setItemSlotAndDropWhenKilled(EquipmentSlot.BODY, heldItem.copyWithCount(1));
   513	         if (!swallowedItem.isEmpty()) {
   514	            Map<EquipmentSlot, ItemStack> lastEquipmentItems = Util.makeEnumMap(EquipmentSlot.class, slot -> ItemStack.EMPTY);
   515	            lastEquipmentItems.put(EquipmentSlot.BODY, swallowedItem);
   516	            this.collectEquipmentChanges(lastEquipmentItems);
   517	         }
   518	      }
   519	
   520	      this.playSound(this.getAbsorbSound());
   521	      return true;
   522	   }

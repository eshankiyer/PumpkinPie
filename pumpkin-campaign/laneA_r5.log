   171	    /// Adds a stack to any available slot, prioritizing stacking with existing items.
   172	    async fn add_stack(&self, stack: ItemStack) -> usize {
   173	        let mut slot_index = self.get_occupied_slot_with_room_for_stack(&stack).await;
   174	
   175	        if slot_index == -1 {
   176	            slot_index = self.get_empty_slot().await;
   177	        }
   178	
   179	        if slot_index == -1 {
   180	            stack.item_count as usize
   181	        } else {
   182	            self.add_stack_to_slot(slot_index as usize, stack).await
   183	        }
   184	    }
   185	
   186	    /// Adds a stack to a specific slot.
   187	    ///
   188	    /// Returns the number of items that couldn't fit.
   189	    async fn add_stack_to_slot(&self, slot: usize, stack: ItemStack) -> usize {
   190	        if slot >= Self::MAIN_SIZE {
   191	            if let Some(slot_type) = self.equipment_slots.get(&slot) {
   192	                let mut equipment = self.entity_equipment.lock().await;
   193	                let current = equipment.get(slot_type);
   194	                if current.is_empty() {
   195	                    equipment.put(slot_type, stack);
   196	                    return 0;
   197	                }
   198	            }
   199	            return stack.item_count as usize;
   200	        }
   201	
   202	        let mut inv = self.main_inventory.write().await;
   203	        let mut stack_count = stack.item_count;
   204	        let self_stack = &mut inv[slot];
   205	
   206	        if self_stack.is_empty() {
   207	            *self_stack = stack.copy_with_count(0);
   208	        }
   209	
   210	        let count_left = self_stack.get_max_stack_size() - self_stack.item_count;
   211	        let count_min = stack_count.min(count_left);
   212	
   213	        if count_min != 0 {
   214	            stack_count -= count_min;
   215	            self_stack.increment(count_min);
   216	        }
   217	        stack_count as usize
   218	    }
   219	
   220	    /// Finds an empty slot in the inventory.
   221	    ///
   222	    /// # Returns
   223	    /// The slot index or -1 if inventory is full.
   224	    async fn get_empty_slot(&self) -> i16 {
   225	        let inv = self.main_inventory.read().await;
   226	        for (i, stack) in inv.iter().enumerate() {
   227	            if stack.is_empty() {
   228	                return i as i16;
   229	            }
   230	        }
   231	        -1
   232	    }
   233	
   234	    /// Checks if a stack can be added to an existing stack.
   235	    fn can_stack_add_more(existing_stack: &ItemStack, stack: &ItemStack) -> bool {
   236	        !existing_stack.is_empty()
   237	            && existing_stack.are_items_and_components_equal(stack)
   238	            && existing_stack.is_stackable()
   239	            && existing_stack.item_count < existing_stack.get_max_stack_size()
   240	    }
   241	
   242	    /// Finds a slot with the same item type that has room for more items.
   243	    ///
   244	    /// Checks selected slot, off-hand, then other slots.
   245	    async fn get_occupied_slot_with_room_for_stack(&self, stack: &ItemStack) -> i16 {
   246	        let selected = self.get_selected_slot() as usize;
   247	        let inv = self.main_inventory.read().await;
   248	        if Self::can_stack_add_more(&inv[selected], stack) {
   249	            return selected as i16;
   250	        }
   251	
   252	        let off_hand = self.off_hand_item().await;
   253	        if Self::can_stack_add_more(&off_hand, stack) {
   254	            return Self::OFF_HAND_SLOT as i16;
   255	        }
   256	
   257	        for (i, item) in inv.iter().enumerate() {
   258	            if Self::can_stack_add_more(item, stack) {
   259	                return i as i16;
   260	            }
   261	        }
   262	
   263	        -1
   264	    }
   265	
   266	    /// Inserts a stack into any available slot.
   267	    ///
   268	    /// # Arguments
   269	    /// - `stack` - The stack to insert (modified in place)
   270	    ///
   271	    /// # Returns
   272	    /// `true` if any items were inserted, `false` otherwise.
   273	    pub async fn insert_stack_anywhere(&self, stack: &mut ItemStack) -> bool {
   274	        self.insert_stack(-1, stack).await
   275	    }
   276	
   277	    /// Inserts a stack into a specific slot or any slot.
   278	    ///
   279	    /// # Arguments
   280	    /// - `slot` - The slot index, or -1 for any slot
   281	    /// - `stack` - The stack to insert (modified in place)
   282	    ///
   283	    /// # Returns
   284	    /// `true` if any items were inserted, `false` otherwise.
   285	    pub async fn insert_stack(&self, slot: i16, stack: &mut ItemStack) -> bool {
   286	        if stack.is_empty() {
   287	            return false;
   288	        }
   289	
   290	        let mut i;
   291	
   292	        loop {
   293	            i = stack.item_count;
   294	            if slot == -1 {
   295	                stack.set_count(self.add_stack(stack.clone()).await as u8);
   296	            } else {
   297	                stack.set_count(self.add_stack_to_slot(slot as usize, stack.clone()).await as u8);
   298	            }
   299	
   300	            if stack.is_empty() || stack.item_count >= i {
   301	                break;
   302	            }
   303	        }
   304	
   305	        stack.item_count < i
   306	    }
   307	
   308	    /// Finds the first slot containing a matching stack.
   309	    ///
   310	    /// # Returns
   311	    /// The slot index or -1 if not found.
   312	    pub async fn get_slot_with_stack(&self, stack: &ItemStack) -> i16 {
   313	        let inv = self.main_inventory.read().await;
   314	        for (i, item) in inv.iter().enumerate() {
   315	            if !item.is_empty() && item.are_items_and_components_equal(stack) {
   316	                return i as i16;
   317	            }
   318	        }
   319	        -1
   320	    }

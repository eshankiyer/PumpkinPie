   230	        let origin = Vector3::new(
   231	            self.position.0.x + *self.pos_x.lock().await,
   232	            self.position.0.y + *self.pos_y.lock().await,
   233	            self.position.0.z + *self.pos_z.lock().await,
   234	        );

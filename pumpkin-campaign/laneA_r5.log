   642	   @Override
   643	   public InteractionResult mobInteract(final Player player, final InteractionHand hand) {
   644	      if (this.isVehicle() || this.isBaby()) {
   645	         return super.mobInteract(player, hand);
   646	      }
   647	
   648	      if (this.isTamed() && player.isSecondaryUseActive()) {
   649	         this.openCustomInventoryScreen(player);
   650	         return InteractionResult.SUCCESS;
   650	         return InteractionResult.SUCCESS;
   651	      }
   652	
   653	      ItemStack itemStack = player.getItemInHand(hand);
   654	      if (!itemStack.isEmpty()) {
   655	         InteractionResult interactionResult = itemStack.interactLivingEntity(player, this, hand);
   656	         if (interactionResult.consumesAction()) {
   657	            return interactionResult;
   658	         }
   659	
   660	         if (this.isEquippableInSlot(itemStack, EquipmentSlot.BODY) && !this.isWearingBodyArmor()) {
   661	            this.equipBodyArmor(player, itemStack);
   662	            return InteractionResult.SUCCESS;
   663	         }
   664	      }
   665	
   666	      this.doPlayerRide(player);
   667	      return InteractionResult.SUCCESS;
   668	   }

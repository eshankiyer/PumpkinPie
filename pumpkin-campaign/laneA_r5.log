   118	pub(crate) async fn equip_body_armor_item(
   119	    mob_entity: &MobEntity,
   120	    player: &Arc<Player>,
   121	    item_stack: &mut ItemStack,
   122	) {
   123	    let equip_sound = item_stack
   124	        .get_data_component::<EquippableImpl>()
   125	        .map_or(IdOr::Id(Sound::ItemArmorEquipGeneric), |equippable| {
   126	            equippable.equip_sound.clone()
   127	        });
   128	    let new_stack = item_stack.split_unless_creative(player.gamemode.load(), 1);
   129	    let mut equipment = mob_entity.living_entity.entity_equipment.lock().await;
   130	    equipment.put(&EquipmentSlot::BODY, new_stack.clone());
   131	    drop(equipment);
   132	    mob_entity
   133	        .living_entity
   134	        .equipment_drop_chances
   135	        .lock()
   136	        .await
   137	        .insert(EquipmentSlot::BODY, 1.0);
   138	    mob_entity
   139	        .living_entity
   140	        .send_equipment_changes(&[(EquipmentSlot::BODY, new_stack)]);
   141	
   142	    let entity = &mob_entity.living_entity.entity;
   143	    let world = entity.world.load();
   144	    world.play_sound_event(&equip_sound, SoundCategory::Neutral, &entity.pos.load());

   421	
   422	   protected boolean handleEating(final Player player, final ItemStack itemStack) {
   423	      boolean itemUsed = false;
   424	      float heal = 0.0F;
   425	      int ageUp = 0;
   426	      int temper = 0;
   427	      if (itemStack.is(Items.WHEAT)) {
   428	         heal = 2.0F;
   429	         ageUp = 20;
   430	         temper = 3;
   430	         temper = 3;
   431	      } else if (itemStack.is(Items.SUGAR)) {
   432	         heal = 1.0F;
   433	         ageUp = 30;
   434	         temper = 3;
   435	      } else if (itemStack.is(Items.HAY_BLOCK)) {
   436	         heal = 20.0F;
   437	         ageUp = 180;
   438	      } else if (itemStack.is(Items.APPLE)) {
   439	         heal = 3.0F;
   440	         ageUp = 60;
   441	         temper = 3;
   442	      } else if (itemStack.is(Items.RED_MUSHROOM)) {
   443	         heal = 3.0F;
   444	         ageUp = 0;
   445	         temper = 3;
   446	      } else if (itemStack.is(Items.CARROT)) {
   447	         heal = 3.0F;
   448	         ageUp = 60;
   449	         temper = 3;
   450	      } else if (itemStack.is(Items.GOLDEN_CARROT)) {
   451	         heal = 4.0F;
   452	         ageUp = 60;
   453	         temper = 5;
   454	         if (!this.level().isClientSide() && this.isTamed() && this.getAge() == 0 && !this.isInLove()) {
   455	            itemUsed = true;
   456	            this.setInLove(player);
   457	         }
   458	      } else if (itemStack.is(Items.GOLDEN_APPLE) || itemStack.is(Items.ENCHANTED_GOLDEN_APPLE)) {
   459	         heal = 10.0F;
   460	         ageUp = 240;
   461	         temper = 10;
   462	         if (!this.level().isClientSide() && this.isTamed() && this.getAge() == 0 && !this.isInLove()) {
   463	            itemUsed = true;
   464	            this.setInLove(player);
   465	         }
   466	      }
   467	
   468	      if (this.getHealth() < this.getMaxHealth() && heal > 0.0F) {
   469	         this.heal(heal);
   470	         itemUsed = true;
   471	      }
   472	
   473	      if (this.isBaby() && ageUp > 0 && !this.isAgeLocked()) {
   474	         this.level().addParticle(ParticleTypes.HAPPY_VILLAGER, this.getRandomX(1.0), this.getRandomY() + 0.5, this.getRandomZ(1.0), 0.0, 0.0, 0.0);
   475	         if (!this.level().isClientSide()) {
   476	            this.ageUp(ageUp);
   477	            itemUsed = true;
   478	         }
   479	      }
   480	
   481	      if (temper > 0 && (itemUsed || !this.isTamed()) && this.getTemper() < this.getMaxTemper() && !this.level().isClientSide()) {
   482	         this.modifyTemper(temper);
   483	         itemUsed = true;
   484	      }
   485	
   486	      if (itemUsed) {
   487	         this.eating();
   488	         this.gameEvent(GameEvent.EAT);
   489	      }
   490	
   491	      return itemUsed;
   492	   }

   366	   @Override
   367	   protected @Nullable Map<EquipmentSlot, ItemStack> collectEquipmentChanges(final Map<EquipmentSlot, ItemStack> lastEquipmentItems) {
   368	      ItemStack previous = lastEquipmentItems.get(EquipmentSlot.BODY);
   369	      ItemStack current = this.getItemBySlot(EquipmentSlot.BODY);
   370	      if (this.equipmentHasChanged(previous, current)) {
   371	         if (!current.isEmpty()) {
   372	            this.removeAllGoals(g -> true);
   373	            this.setSpeed(0.0F);
   374	         } else {
   375	            this.registerGoals();
   376	         }
   377	
   378	         for (SulfurCubeArchetype archetype : this.matchingArchetypes(previous)) {
   379	            for (SulfurCubeArchetype.AttributeEntry mod : archetype.attributeModifiers()) {
   380	               AttributeInstance attr = this.getAttribute(mod.attribute());
   381	               if (attr != null) {
   382	                  attr.removeModifier(mod.modifier());
   383	               }
   384	            }
   385	         }
   386	
   387	         this.floatsInLiquids = false;
   388	         this.explosionData = Optional.empty();
   389	         this.contactDamages.clear();
   390	         this.knockbackModifier = SulfurCubeArchetype.DEFAULT_KNOCKBACK_MODIFIERS;
   391	         this.soundSettings = SulfurCubeArchetype.DEFAULT_SOUND_SETTINGS;
   392	
   393	         for (SulfurCubeArchetype archetype : this.matchingArchetypes(current)) {
   394	            if (archetype.buoyant()) {
   395	               this.floatsInLiquids = true;
   396	            }
   397	
   398	            if (archetype.explosion().isPresent()) {
   399	               this.explosionData = archetype.explosion();
   400	            }
   401	
   402	            if (archetype.contactDamage().isPresent()) {
   403	               this.contactDamages.add(archetype.contactDamage().get());
   404	            }
   405	
   406	            this.knockbackModifier = archetype.knockbackModifiers();
   407	            this.soundSettings = archetype.soundSettings();
   408	
   409	            for (SulfurCubeArchetype.AttributeEntry mod : archetype.attributeModifiers()) {
   410	               AttributeInstance attr = this.getAttribute(mod.attribute());
   411	               if (attr != null) {
   412	                  attr.addOrUpdateTransientModifier(mod.modifier());
   413	               }
   414	            }
   415	         }
   416	      }
   417	
   418	      return super.collectEquipmentChanges(lastEquipmentItems);
   419	   }

   447	    fn damage_with_context<'a>(
   448	        &'a self,
   449	        caller: &'a dyn EntityBase,
   450	        _amount: f32,
   451	        damage_type: DamageType,
   452	        _position: Option<Vector3<f64>>,
   453	        source: Option<&'a dyn EntityBase>,
   454	        cause: Option<&'a dyn EntityBase>,
   455	    ) -> EntityBaseFuture<'a, bool> {

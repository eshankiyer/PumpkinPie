   326	   private void primeWhenOnPoweredPosition() {
   327	      if (this.level() instanceof ServerLevel level && this.canExplode()) {
   328	         BlockPos here = BlockPos.containing(this.position());
   329	         if (level.getBestOwnOrNeighbourSignal(here) != 0) {
   330	            this.primeTime(false);
   331	         }
   332	      }
   333	   }
   334	
   335	   public boolean primeTime(final boolean imminent) {
   336	      if (!this.explosionData.isEmpty()
   337	         && this.isAlive()
   338	         && this.level() instanceof ServerLevel serverLevel
   339	         && serverLevel.getGameRules().get(GameRules.TNT_EXPLODES)
   340	         && !this.isPrimed()) {
   341	         int fuse = this.explosionData.get().fuse();
   342	         int fuseTime = imminent ? PrimedTnt.getRandomShortFuse(fuse, this.getRandom()) : fuse;
   343	         this.setInvulnerable(true);
   344	         this.setFuse(fuseTime);
   345	         this.entityData.set(MAX_FUSE, fuseTime);
   346	         this.makeSound(SoundEvents.TNT_PRIMED);
   347	         this.gameEvent(GameEvent.PRIME_FUSE);
   348	         return true;
   349	      } else {
   350	         return false;
   351	      }
   352	   }

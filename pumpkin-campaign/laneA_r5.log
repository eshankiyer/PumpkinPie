   301	   private static Optional<BoundingBox> calculateEnclosingBoundingBox(final BlockPos pos, final Stream<BlockPos> relatedCorners) {
   302	      Iterator<BlockPos> iterator = relatedCorners.iterator();
   303	      if (!iterator.hasNext()) {
   304	         return Optional.empty();
   305	      }
   306	
   307	      BlockPos firstCorner = iterator.next();
   308	      BoundingBox result = new BoundingBox(firstCorner);
   309	      if (iterator.hasNext()) {
   310	         iterator.forEachRemaining(result::encapsulate);
   311	      } else {
   312	         result.encapsulate(pos);
   313	      }
   314	
   315	      return Optional.of(result);
   316	   }

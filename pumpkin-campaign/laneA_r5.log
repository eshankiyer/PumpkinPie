   697	    /// Whether this species can currently show an inventory screen. Non-chested horses have
   698	    /// nothing to show (saddle/armor are equipment-slot-only here, see the module doc comment),
   699	    /// so the default is a no-op; `AbstractChestedHorse::chested_mob_interact` overrides this
   700	    /// path with the real chest-inventory screen.
   701	    fn open_custom_inventory_screen<'a>(
   702	        &'a self,
   703	        _player: &'a Arc<Player>,
   704	    ) -> EntityBaseFuture<'a, ()> {
   705	        Box::pin(async {})
   706	    }
   707	
   708	    /// `AbstractHorse.mobInteract` (`AbstractHorse.java:644-669`), shared by Horse, `ZombieHorse`
   709	    /// and (post-tame-gate) `SkeletonHorse` -- the species' own `mobInteract` overrides in
   710	    /// vanilla reduce to this exact dispatch once their food/mad early-returns are inlined (see
   711	    /// the per-species files for the trace showing why).
   712	    fn abstract_horse_mob_interact<'a>(
   713	        &'a self,
   714	        player: &'a Arc<Player>,
   715	        item_stack: &'a mut ItemStack,
   716	    ) -> EntityBaseFuture<'a, bool>
   717	    where
   718	        Self: Sized,
   719	    {
   720	        Box::pin(async move {
   721	            let mob_entity = self.get_mob_entity();
   722	            let entity = &mob_entity.living_entity.entity;
   723	            let is_vehicle = !entity.passengers.lock().await.is_empty();
   724	
   725	            if is_vehicle || self.is_baby() {
   726	                return mob_entity
   727	                    .mob_interact(player, item_stack, self.can_be_leashed())
   728	                    .await;
   729	            }
   730	
   731	            if self.is_tamed() && player.get_entity().is_sneaking() {
   732	                self.open_custom_inventory_screen(player).await;
   733	                return true;
   734	            }
   735	
   736	            if !item_stack.is_empty() {
   737	                if self.is_food(item_stack) {
   738	                    return self.fed_food(player, item_stack).await;
   739	                }
   740	
   741	                if !self.is_tamed() {
   742	                    self.make_mad();
   743	                    return true;
   744	                }
   745	
   746	                let body_armor = {
   747	                    let equipment = mob_entity.living_entity.entity_equipment.lock().await;
   748	                    equipment.get(&EquipmentSlot::BODY)
   749	                };
   750	                if is_valid_body_armor_item(item_stack, entity.entity_type) && body_armor.is_empty()
   751	                {
   752	                    equip_body_armor_item(mob_entity, player, item_stack).await;
   753	                    return true;
   754	                }
   755	
   756	                if saddle_equip_on_interact(item_stack, entity.entity_type)
   757	                    && !AbstractHorse::is_saddled(self).await
   758	                    && self.can_use_saddle_slot()
   759	                {
   760	                    self.equip_saddle(player, item_stack).await;
   760	                    self.equip_saddle(player, item_stack).await;
   761	                    return true;
   762	                }
   763	            }
   764	
   765	            self.do_player_ride(player).await;
   766	            true
   767	        })
   768	    }

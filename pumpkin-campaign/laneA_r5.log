    29	    fn find_parent(mob: &dyn Mob) -> Option<Arc<dyn EntityBase>> {
    30	        let mob_entity = mob.get_mob_entity();
    31	        let entity = &mob_entity.living_entity.entity;
    32	        let pos = entity.pos.load();
    33	        let my_type = entity.entity_type;
    34	        let world = entity.world.load();
    35	
    36	        let nearby = world.get_nearby_entities(pos, SEARCH_RADIUS);
    37	        let mut closest: Option<(f64, Arc<dyn EntityBase>)> = None;
    38	
    39	        for candidate in nearby.values() {
    40	            let c_entity = candidate.get_entity();
    41	            if c_entity.entity_type != my_type {
    42	                continue;
    43	            }
    44	            if c_entity.age.load(Relaxed) < 0 {
    45	                continue;
    46	            }
    47	            let c_pos = c_entity.pos.load();
    48	            if (pos.y - c_pos.y).abs() > SEARCH_Y_RANGE {
    49	                continue;
    50	            }
    51	            let dist_sq = pos.squared_distance_to_vec(&c_pos);
    52	            if closest.as_ref().is_none_or(|(d, _)| dist_sq <= *d) {
    53	                closest = Some((dist_sq, candidate.clone()));
    54	            }
    55	        }
    56	
    57	        let (dist_sq, closest_entity) = closest?;
    58	        if dist_sq < MIN_DISTANCE_SQ {
    59	            return None;
    60	        }
    61	        Some(closest_entity)
    62	    }
    63	}

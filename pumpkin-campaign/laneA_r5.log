   280	   public final void applyComponents(final DataComponentMap prototype, final DataComponentPatch patch) {
   281	      final Set<DataComponentType<?>> implicitComponents = new HashSet<>();
   282	      implicitComponents.add(DataComponents.BLOCK_ENTITY_DATA);
   283	      implicitComponents.add(DataComponents.BLOCK_STATE);
   284	      final DataComponentMap fullView = PatchedDataComponentMap.fromPatch(prototype, patch);
   285	      this.applyImplicitComponents(new DataComponentGetter() {
   286	         @Override
   287	         public <T> @Nullable T get(final DataComponentType<? extends T> type) {
   288	            implicitComponents.add(type);
   289	            return fullView.get(type);
   290	         }
   291	
   292	         @Override
   293	         public <T> T getOrDefault(final DataComponentType<? extends T> type, final T defaultValue) {
   294	            implicitComponents.add(type);
   295	            return fullView.getOrDefault(type, defaultValue);
   296	         }
   297	      });
   298	      DataComponentPatch newPatch = patch.forget(implicitComponents::contains);
   299	      this.components = newPatch.split().added();
   300	   }

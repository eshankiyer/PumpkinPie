   323	    /// SulfurCube.java:918-920 (`setcubeMobHealth`): `4 * actualSize`.
   324	    const fn max_health_for_size(size: i32) -> i32 {
   325	        4 * size
   326	    }
   327	
   328	    /// SulfurCube.java:664-666 (`getSplitCount`).
   329	    const fn split_count_for_fuse(fuse: i32) -> i32 {
   330	        if fuse >= 0 { 0 } else { 2 }
   331	    }

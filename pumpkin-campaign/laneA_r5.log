   452	    /// Returns whether this option can be used by the provided [`EntitySelectorParser`].
   453	    pub const fn can_use(self, parser: &EntitySelectorParser) -> bool {
   454	        match self {
   455	            Self::Name => !parser.has_flag(Flags::NAME_EQUALS_SET),
   456	            Self::Distance => parser.distance.is_none(),
   457	            Self::Level => parser.experience_level.is_none(),
   458	            Self::X => parser.pos.x.is_none(),
   459	            Self::Y => parser.pos.y.is_none(),
   460	            Self::Z => parser.pos.z.is_none(),
   461	            Self::Dx => parser.delta.x.is_none(),
   462	            Self::Dy => parser.delta.y.is_none(),
   463	            Self::Dz => parser.delta.z.is_none(),
   464	            Self::XRotation => parser.rotation.x.is_none(),
   465	            Self::YRotation => parser.rotation.y.is_none(),
   466	            Self::Limit => !parser.is_current_entity && !parser.has_flag(Flags::LIMIT_SET),
   467	            Self::Sort => !parser.is_current_entity && !parser.has_flag(Flags::SORT_SET),
   468	            Self::Gamemode => !parser.has_flag(Flags::GAMEMODE_EQUALS_SET),
   469	            Self::Team => !parser.has_flag(Flags::TEAM_EQUALS_SET),
   470	            Self::Type => parser.entity_type.is_none(),
   471	            Self::Scores => !parser.has_flag(Flags::SCORES_SET),
   472	            Self::Advancements => !parser.has_flag(Flags::ADVANCEMENTS_SET),
   473	            Self::Tag | Self::Nbt | Self::Predicate => true,
   474	        }
   475	    }
   476	
   477	    pub fn suggest_names(
   478	        parser: &EntitySelectorParser,
   479	        mut builder: SuggestionsBuilder,
   480	    ) -> SuggestionsBuilder {
   481	        for option in Self::VALUES {
   482	            let lower_prefix = builder.remaining_lowercase();
   483	            if option.name().starts_with(lower_prefix) && option.can_use(parser) {
   484	                let key = format!("argument.entity.options.{}.description", option.name());
   485	                builder = builder.suggest_with_tooltip(
   486	                    format!("{}=", option.name()),
   487	                    TextComponent::translate_cross(key.clone(), key, []),
   488	                );
   489	            }
   490	        }
   491	        builder
   492	    }
   493	}


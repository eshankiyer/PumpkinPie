  4362	    /// fan multiple riders out sideways in vehicle-local space. Crucially, this is a server-side
  4363	    /// position update: rider collision, interaction, fall, and nested-vehicle state now move
  4364	    /// with the vehicle even before individual boat/minecart/mob seat data is ported.
  4365	    async fn position_rider(
  4366	        &self,
  4367	        passenger: &Arc<dyn EntityBase>,
  4368	        passenger_index: usize,
  4369	        passenger_count: usize,
  4370	    ) {

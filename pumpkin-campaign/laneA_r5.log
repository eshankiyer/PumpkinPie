   366	      return soundType == SoundType.WOOD
   367	         || soundType == SoundType.NETHER_WOOD
   368	         || soundType == SoundType.STEM
   369	         || soundType == SoundType.CHERRY_WOOD
   370	         || soundType == SoundType.BAMBOO_WOOD;

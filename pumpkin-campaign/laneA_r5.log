   385	   private void causeDamage(final ServerLevel level, final DamageSource source, final float dmg) {
   386	      float health = this.getHealth();
   387	      health -= dmg;
   388	      if (health <= 0.5F) {
   389	         this.brokenByAnything(level, source);
   390	         this.kill(level);
   391	      } else {
   392	         this.setHealth(health);
   393	         this.gameEvent(GameEvent.ENTITY_DAMAGE, source.getEntity());
   394	      }
   395	   }

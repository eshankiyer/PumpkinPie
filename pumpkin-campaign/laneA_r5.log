    47	pub(crate) fn is_valid_saddle_item(stack: &ItemStack, entity_type: &EntityType) -> bool {
    48	    stack
    49	        .get_data_component::<EquippableImpl>()
    50	        .is_some_and(|equippable| {
    51	            *equippable.slot == EquipmentSlot::SADDLE
    52	                && equippable
    53	                    .allowed_entities
    54	                    .as_ref()
    55	                    .is_none_or(|allowed| match allowed {
    56	                        IDSet::Tag(tag) => entity_type.is_tagged_with(tag).unwrap_or(false),
    57	                        IDSet::IDs(ids) => ids.iter().any(|allowed| allowed.id == entity_type.id),
    58	                    })
    59	        })
    60	}

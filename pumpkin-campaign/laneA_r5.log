   147	pub(crate) async fn mount_player(mob_entity: &MobEntity, player: &Arc<Player>) {
   148	    if !player.get_entity().can_start_riding().await {
   149	        return;
   150	    }
   151	
   152	    let entity = &mob_entity.living_entity.entity;
   153	    let world = entity.world.load();
   154	    let Some(vehicle) = world.get_entity_by_id(entity.entity_id) else {
   155	        return;
   156	    };
   157	    let Some(passenger) = world.get_player_by_id(player.entity_id()) else {
   158	        return;
   159	    };
   160	    entity
   161	        .add_passenger(vehicle, passenger as Arc<dyn EntityBase>)
   162	        .await;
   163	}

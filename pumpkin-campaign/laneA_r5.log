   534	                    entity.kill(caller).await;
   535	                    return true;
   536	                }
   537	            }
   538	
   539	            let time = world.level_time.lock().await.query_gametime();
   540	
   541	            if time - self.last_hit_time.load(Ordering::Relaxed) > 5 && !always_kills {
   542	                world.send_entity_status(entity, EntityStatus::ArmorstandWobble, None);
   543	                world.play_sound(
   544	                    Sound::EntityArmorStandHit,
   545	                    SoundCategory::Neutral,
   546	                    &entity.block_pos.load().to_f64(),
   547	                );
   548	                self.last_hit_time.store(time, Ordering::Relaxed);
   549	            } else {
   550	                Self::spawn_break_particles(entity);
   551	                world.play_sound(
   552	                    Sound::EntityArmorStandBreak,
   553	                    SoundCategory::Neutral,
   554	                    &entity.block_pos.load().to_f64(),
   555	                );
   556	                self.break_and_drop_items().await;
   557	                entity.kill(caller).await;
   558	            }
   559	
   560	            true
   561	        })
   562	    }

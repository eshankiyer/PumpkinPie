    74	    /// Fast non-blocking count of an item across all main inventory slots.
    75	    pub fn count_item(&self, item: &'static Item) -> u32 {
    76	        let mut total = 0u32;
    77	        if let Ok(inv) = self.main_inventory.try_read() {
    78	            for stack in inv.iter() {
    79	                if stack.get_item().id == item.id {
    80	                    total += u32::from(stack.item_count);
    81	                }
    82	            }
    83	        }
    84	        total
    85	    }

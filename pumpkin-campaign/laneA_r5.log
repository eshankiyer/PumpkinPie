   572	impl Control for SulfurCubeMoveControl {}
   573	
   574	impl MoveControlTrait for SulfurCubeMoveControl {
   575	    fn tick(&mut self, mob: &dyn Mob) {
   576	        let Some(cube) = self.cube.upgrade() else {
   577	            return;
   578	        };
   579	
   580	        // SulfurCube.java:949-960 (`SulfurCubeMobMoveControl`): movement is suppressed
   581	        // entirely while the body slot holds a swallowed item.
   582	        if futures::executor::block_on(cube.has_body_item()) {
   583	            return;
   584	        }
   585	
   586	        let mob_entity = mob.get_mob_entity();
   587	        let living_entity = &mob_entity.living_entity;
   588	        let entity = &living_entity.entity;
   589	
   590	        let current_yaw = entity.yaw.load();
   591	        let new_yaw = SulfurCubeEntity::rot_lerp(current_yaw, cube.target_yaw.load(), 90.0);
   592	        entity.yaw.store(new_yaw);
   593	        entity.head_yaw.store(new_yaw);
   594	        entity.body_yaw.store(new_yaw);
   595	
   596	        // the slime-style move control this mirrors calls setSpeed(speedModifier * MOVEMENT_SPEED) like the
   597	        // base MoveControl, so the forward input carries the attribute too.
   598	        let speed_modifier = cube.speed_modifier.load();
   599	        let scaled_speed = living_entity.speed_for_modifier(speed_modifier);
   600	        let mut movement_input = Vector3::new(0.0, 0.0, 0.0);
   601	
   602	        let on_ground = entity.on_ground.load(Ordering::Relaxed);
   603	
   604	        if on_ground {
   605	            if speed_modifier > 0.0 {
   606	                let current_delay = cube.jump_delay.load(Ordering::Relaxed);
   607	                if current_delay <= 0 {
   608	                    let next_delay = SulfurCubeEntity::get_jump_delay();
   609	                    cube.jump_delay.store(next_delay, Ordering::Relaxed);
   610	                    mob_entity.jump_requested.store(true, Ordering::SeqCst);
   611	                    let world = entity.world.load();
   612	                    world.play_sound_fine(
   613	                        cube.get_jump_sound(),
   614	                        SoundCategory::Neutral,
   615	                        &entity.pos.load(),
   616	                        cube.get_sound_volume(),
   617	                        cube.get_sound_pitch(),
   618	                    );
   619	                    movement_input.z = scaled_speed;
   620	                } else {
   621	                    cube.jump_delay.store(current_delay - 1, Ordering::Relaxed);
   622	                }
   623	            }
   624	        } else if speed_modifier > 0.0 {
   625	            movement_input.z = scaled_speed;

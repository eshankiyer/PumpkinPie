   333	    /// Vanilla `SulfurCube.ageBoundaryReached` (`SulfurCube.java:706-710`) restores the
   334	    /// adult cube size when a baby reaches age zero. The shared ageable clock updates age,
   335	    /// but does not know this species-specific size rule.
   336	    fn age_boundary_reached(&self) {
   337	        if !self.is_baby() {
   338	            self.set_size(2, true);
   339	        }
   340	    }
   341	}

   278	   @Override
   279	   public boolean hurtServer(final ServerLevel level, final DamageSource source, final float damage) {
   280	      if (this.isRemoved()) {
   281	         return false;
   282	      }
   283	
   284	      if (!level.getGameRules().get(GameRules.MOB_GRIEFING) && source.getEntity() instanceof Mob) {
   285	         return false;
   286	      }
   287	
   288	      if (source.is(DamageTypeTags.BYPASSES_INVULNERABILITY)) {
   289	         this.kill(level);
   290	         return false;
   291	      }
   292	
   293	      if (this.isInvulnerableTo(level, source) || this.invisible || this.isMarker()) {
   294	         return false;
   295	      }
   296	
   297	      if (source.is(DamageTypeTags.IS_EXPLOSION)) {
   298	         this.brokenByAnything(level, source);
   299	         this.kill(level);
   300	         return false;
   301	      }
   302	
   303	      if (source.is(DamageTypeTags.IGNITES_ARMOR_STANDS)) {
   304	         if (this.isOnFire()) {
   305	            this.causeDamage(level, source, 0.15F);
   306	         } else {
   307	            this.igniteForSeconds(5.0F);
   308	         }
   309	
   310	         return false;
   311	      } else if (source.is(DamageTypeTags.BURNS_ARMOR_STANDS) && this.getHealth() > 0.5F) {
   312	         this.causeDamage(level, source, 4.0F);
   313	         return false;
   314	      } else {
   315	         boolean allowIncrementalBreaking = source.is(DamageTypeTags.CAN_BREAK_ARMOR_STAND);
   316	         boolean shouldKill = source.is(DamageTypeTags.ALWAYS_KILLS_ARMOR_STANDS);
   317	         if (!allowIncrementalBreaking && !shouldKill) {
   318	            return false;
   319	         } else if (source.getEntity() instanceof Player player && !player.getAbilities().mayBuild) {
   320	            return false;
   321	         } else {
   322	            if (source.isCreativePlayer()) {
   323	               this.playBrokenSound();
   324	               this.showBreakingParticles();
   325	               this.kill(level);
   326	               return true;
   327	            }
   328	
   329	            long time = level.getGameTime();
   330	            if (time - this.lastHit > 5L && !shouldKill) {
   331	               level.broadcastEntityEvent(this, (byte)32);
   332	               this.gameEvent(GameEvent.ENTITY_DAMAGE, source.getEntity());
   333	               this.lastHit = time;
   334	            } else {
   335	               this.brokenByPlayer(level, source);
   336	               this.showBreakingParticles();
   337	               this.kill(level);
   338	            }
   339	
   340	            return true;
   341	         }
   342	      }
   343	   }

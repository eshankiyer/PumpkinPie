   468	    fn mob_player_collision<'a>(
   469	        &'a self,
   470	        _player: &'a Arc<Player>,
   471	    ) -> crate::entity::EntityBaseFuture<'a, ()> {
   472	        // SulfurCube.java:222-224 (`isDealsDamage`): peaceful mob, no contact damage.
   473	        Box::pin(async move {})
   474	    }
   475	
   476	    fn mob_interact<'a>(
   477	        &'a self,
   478	        player: &'a Arc<Player>,
   479	        item_stack: &'a mut ItemStack,
   480	    ) -> crate::entity::EntityBaseFuture<'a, bool> {
   481	        Box::pin(async move {
   482	            if self.is_baby() {
   483	                if is_food_item(item_stack) && self.can_age_up() {
   484	                    let age = self.get_age();
   485	                    item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   486	                    self.age_up(Self::get_speed_up_seconds_when_feeding(-age), true);
   487	                    self.age_boundary_reached();
   488	                    self.play_sound(Sound::EntitySmallSulfurCubeEat);
   489	                    return true;
   490	                }
   491	                return self
   492	                    .entity
   493	                    .mob_interact(player, item_stack, self.can_be_leashed())
   494	                    .await;
   495	            }
   496	
   497	            if item_stack.item.id == Item::SHEARS.id && self.has_body_item().await {
   498	                self.shear().await;
   499	                return true;
   500	            }
   501	
   502	            if self.can_hold_item(item_stack).await {
   503	                let equipped = self.equip_item(item_stack).await;
   504	                if equipped {
   505	                    item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   506	                }
   507	                return equipped;
   508	            }
   509	
   510	            self.entity
   511	                .mob_interact(player, item_stack, self.can_be_leashed())
   512	                .await
   513	        })
   514	    }
   515	
   516	    fn post_tick(&self) -> crate::entity::EntityBaseFuture<'_, ()> {
   517	        Box::pin(async move {
   518	            if self.entity.living_entity.dead.load(Ordering::Relaxed)
   519	                && self.get_size() > 1
   520	                && self
   521	                    .has_split
   522	                    .compare_exchange(false, true, Ordering::Relaxed, Ordering::Relaxed)
   523	                    .is_ok()
   524	            {
   525	                let size = self.get_size();
   526	                let world = self.entity.living_entity.entity.world.load();
   527	                let pos = self.entity.living_entity.entity.pos.load();
   528	                let half_size = size / 2;
   529	                let count = self.get_split_count();
   530	
   531	                let width = self
   532	                    .entity
   533	                    .living_entity
   534	                    .entity
   535	                    .entity_dimension
   536	                    .load()
   537	                    .width;
   538	                let xz_offset = width / 2.0;
   539	
   540	                for i in 0..count {
   541	                    let xd = ((i % 2) as f32 - 0.5) * xz_offset;
   542	                    let zd = ((i / 2) as f32 - 0.5) * xz_offset;
   543	
   544	                    let new_pos = Vector3::new(pos.x + xd as f64, pos.y + 0.5, pos.z + zd as f64);
   545	                    let new_entity = Entity::new(world.clone(), new_pos, &EntityType::SULFUR_CUBE);
   546	                    let cube = Self::new(new_entity);
   547	                    cube.set_size(half_size, true);
   548	                    cube.set_baby(true);
   549	                    cube.entity
   550	                        .living_entity
   551	                        .entity
   552	                        .yaw
   553	                        .store(rand::random_range(0.0..360.0));
   554	                    world.spawn_entity(cube).await;
   555	                }
   556	            }
   557	        })
   558	    }
   559	}

   523	            if current_light > 0 {
   524	                self.block_light
   525	                    .decrease_queue
   526	                    .push_back((pos, current_light));
   527	                set_block_light(cache, pos, 0);
   528	            }
   529	        }
   530	
   531	        // Increase Logic
   532	        if new_luminance > 0 {
   533	            set_block_light(cache, pos, new_luminance);
   534	            if self.block_light.visited.insert(pos) {
   535	                self.block_light.queue.push_back(PropagationEntry { pos });
   536	            }
   537	        }
   538	    }

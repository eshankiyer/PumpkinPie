   356	         case CLOCKWISE_90 -> northWestCorner.offset(structureSize.getZ() - 1, 0, 0);
   357	         case CLOCKWISE_180 -> northWestCorner.offset(structureSize.getX() - 1, 0, structureSize.getZ() - 1);
   358	         case COUNTERCLOCKWISE_90 -> northWestCorner.offset(0, 0, structureSize.getX() - 1);
   359	      };
   360	   }

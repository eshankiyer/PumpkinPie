   349	   public BlockPos getStartCorner() {
   350	      Vec3i structureSize = this.getSize();
   351	      Rotation rotation = this.getRotation();
   352	      BlockPos northWestCorner = this.getStructurePos();
   353	
   354	      return switch (rotation) {

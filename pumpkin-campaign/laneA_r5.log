   307	   public void placeItemBackInInventory(final ItemStack itemStack, final boolean shouldSendSetSlotPacket) {
   308	      while (!itemStack.isEmpty()) {
   309	         int slot = this.getSlotWithRemainingSpace(itemStack);
   310	         if (slot == -1) {
   311	            slot = this.getFreeSlot();
   312	         }
   313	
   314	         if (slot == -1) {
   315	            this.player.drop(itemStack, false);
   316	            break;
   317	         }
   318	
   319	         int slotHasSpaceFor = itemStack.getMaxStackSize() - this.getItem(slot).getCount();
   320	         if (this.add(slot, itemStack.split(slotHasSpaceFor)) && shouldSendSetSlotPacket && this.player instanceof ServerPlayer serverPlayer) {
   321	            serverPlayer.connection.send(this.createInventoryUpdatePacket(slot));
   322	         }
   323	      }
   324	   }

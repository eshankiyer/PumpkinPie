   965	   private @Nullable Vec3 getDismountLocationInDirection(final Vec3 direction, final LivingEntity passenger) {
   966	      double targetX = this.getX() + direction.x;
   967	      double targetY = this.getBoundingBox().minY;
   968	      double targetZ = this.getZ() + direction.z;
   969	      BlockPos.MutableBlockPos targetBlockPos = new BlockPos.MutableBlockPos();
   970	
   971	      for (Pose dismountPose : passenger.getDismountPoses()) {
   972	         targetBlockPos.set(targetX, targetY, targetZ);
   973	         double dismountJumpLimit = this.getBoundingBox().maxY + 0.75;
   974	
   975	         do {
   976	            double blockFloorHeight = this.level().getBlockFloorHeight(targetBlockPos);
   977	            if (targetBlockPos.getY() + blockFloorHeight > dismountJumpLimit) {
   978	               break;
   979	            }
   980	
   981	            if (DismountHelper.isBlockFloorValid(blockFloorHeight)) {
   982	               AABB poseCollisionBox = passenger.getLocalBoundsForPose(dismountPose);
   983	               Vec3 location = new Vec3(targetX, targetBlockPos.getY() + blockFloorHeight, targetZ);
   984	               if (DismountHelper.canDismountTo(this.level(), passenger, poseCollisionBox.move(location))) {
   985	                  passenger.setPose(dismountPose);
   986	                  return location;
   987	               }
   988	            }
   989	
   990	            targetBlockPos.move(Direction.UP);
   991	         } while (targetBlockPos.getY() < dismountJumpLimit);
   992	      }
   993	
   994	      return null;
   995	   }

   889	    /// `AbstractChestedHorse.setChest` + `createInventory`: replaces the backing inventory,
   890	    /// preserving any existing stacks in the overlapping slot range.
   891	    fn set_chest(&self, value: bool) -> EntityBaseFuture<'_, ()> {
   892	        Box::pin(async move {
   893	            self.chested_data().has_chest.store(value, Relaxed);
   894	            let new_size = if value {
   895	                usize::from(self.get_inventory_columns()) * 3
   896	            } else {
   897	                0
   898	            };
   899	
   900	            let mut slot = self.chested_data().inventory.lock().await;
   900	            let mut slot = self.chested_data().inventory.lock().await;
   901	            let old = slot.clone();
   902	            let new_inventory = Arc::new(SimpleInventory::new(new_size));
   903	            let max = old.size().min(new_inventory.size());
   904	            for i in 0..max {
   905	                let stack = old.get_stack(i).await;
   906	                if !stack.is_empty() {
   907	                    new_inventory.set_stack(i, stack).await;
   908	                }
   909	            }
   910	            *slot = new_inventory;
   911	        })
   912	    }
   913	
   914	    fn open_chest_inventory<'a>(&'a self, player: &'a Arc<Player>) -> EntityBaseFuture<'a, ()> {
   915	        Box::pin(async move {
   916	            let inventory = self.chested_data().inventory.lock().await.clone();
   917	            player
   918	                .open_handled_screen(
   919	                    &HorseChestScreenFactory(inventory as Arc<dyn Inventory>),
   920	                    None,
   921	                )
   922	                .await;
   923	        })
   924	    }
   925	
   926	    /// `AbstractChestedHorse.mobInteract` (`AbstractChestedHorse.java:143-167`).
   927	    fn chested_mob_interact<'a>(
   928	        &'a self,
   929	        player: &'a Arc<Player>,
   930	        item_stack: &'a mut ItemStack,
   931	    ) -> EntityBaseFuture<'a, bool>
   932	    where
   933	        Self: Sized,
   934	    {
   935	        Box::pin(async move {
   936	            let mob_entity = self.get_mob_entity();
   937	            let entity = &mob_entity.living_entity.entity;
   938	            let is_vehicle = !entity.passengers.lock().await.is_empty();
   939	            let should_open_inventory =
   940	                !self.is_baby() && self.is_tamed() && player.get_entity().is_sneaking();
   941	            let baby_with_dandelion =
   942	                self.is_baby() && item_stack.item.id == Item::GOLDEN_DANDELION.id;
   943	
   944	            if is_vehicle || should_open_inventory || baby_with_dandelion {
   945	                if should_open_inventory && !is_vehicle {
   946	                    self.open_chest_inventory(player).await;
   947	                    return true;
   948	                }
   949	                return mob_entity
   950	                    .mob_interact(player, item_stack, self.can_be_leashed())
   951	                    .await;
   952	            }
   953	
   954	            if !item_stack.is_empty() {
   955	                if self.is_food(item_stack) {
   956	                    return self.fed_food(player, item_stack).await;
   957	                }
   958	
   959	                if !self.is_tamed() {
   960	                    self.make_mad();
   961	                    return true;
   962	                }
   963	
   964	                if !self.has_chest() && item_stack.item.id == Item::CHEST.id {
   965	                    self.set_chest(true).await;
   966	                    self.play_chest_equips_sound();
   967	                    item_stack.decrement_unless_creative(player.gamemode.load(), 1);
   968	                    return true;
   969	                }
   970	            }
   971	
   972	            self.abstract_horse_mob_interact(player, item_stack).await
   973	        })
   974	    }
   975	
   976	    fn write_chested_horse_nbt(&self, nbt: &mut NbtCompound) {
   977	        nbt.put_bool("ChestedHorse", self.has_chest());
   978	    }
   979	
   980	    fn read_chested_horse_nbt<'a>(&'a self, nbt: &'a NbtCompound) -> EntityBaseFuture<'a, ()> {
   981	        Box::pin(async move {
   982	            let has_chest = nbt.get_bool("ChestedHorse").unwrap_or(false);
   983	            self.set_chest(has_chest).await;
   984	        })
   985	    }
   986	}

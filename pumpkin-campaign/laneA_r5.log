   472	pub struct LightEngine {
   473	    block_light: BlockLightPropagator,
   474	    sky_light: SkyLightPropagator,
   475	}
   476	
   477	impl LightEngine {
   478	    #[must_use]
   479	    pub fn new() -> Self {
   480	        Self {
   481	            block_light: BlockLightPropagator::new(),
   482	            sky_light: SkyLightPropagator::new(),
   483	        }
   484	    }
   485	
   486	    pub fn initialize_light(
   487	        &mut self,
   488	        cache: &mut Cache,
   489	        config: &LightingEngineConfig,
   490	        has_skylight: bool,
   491	    ) {
   492	        if *config != LightingEngineConfig::Default {
   493	            return;
   494	        }
   495	
   496	        let should_skip = {
   497	            let center_chunk = cache.get_center_chunk();
   498	            center_chunk.stage >= crate::chunk_system::chunk_state::StagedChunkEnum::Lighting
   499	        };
   500	        if should_skip {
   501	            return;
   502	        }
   503	
   504	        if has_skylight {
   505	            self.sky_light.convert_light(cache);
   506	        }
   507	        self.block_light.propagate_light(cache);
   508	
   509	        self.block_light.clear();
   510	        self.sky_light.clear();
   511	    }
   512	
   513	    pub fn update_block_light(
   514	        &mut self,
   515	        cache: &mut Cache,
   516	        pos: BlockPos,
   517	        old_luminance: u8,
   518	        new_luminance: u8,
   519	    ) {
   520	        // Decrease Logic
   521	        if old_luminance > new_luminance {
   522	            let current_light = get_block_light(cache, pos);
   523	            if current_light > 0 {
   524	                self.block_light
   525	                    .decrease_queue
   526	                    .push_back((pos, current_light));
   527	                set_block_light(cache, pos, 0);
   528	            }
   529	        }
   530	
   531	        // Increase Logic
   532	        if new_luminance > 0 {
   533	            set_block_light(cache, pos, new_luminance);
   534	            if self.block_light.visited.insert(pos) {
   535	                self.block_light.queue.push_back(PropagationEntry { pos });
   536	            }
   537	        }
   538	    }
   539	
   540	    pub fn run_light_updates(&mut self, cache: &mut Cache) {
   541	        if !self.block_light.decrease_queue.is_empty() {
   542	            self.block_light.process_decrease_queue(cache);
   543	        }
   544	        if !self.block_light.queue.is_empty() {
   545	            self.block_light.propagate(cache);
   546	            self.block_light.visited.clear();
   547	        }
   548	        if !self.sky_light.decrease_queue.is_empty() {
   549	            self.sky_light.process_decrease_queue(cache);
   550	        }
   551	        if !self.sky_light.queue.is_empty() {
   552	            self.sky_light.propagate(cache);
   553	            self.sky_light.visited.clear();
   554	        }
   555	    }
   556	}
   557	
   558	impl Default for LightEngine {
   559	    fn default() -> Self {
   560	        Self::new()
   561	    }
   562	}

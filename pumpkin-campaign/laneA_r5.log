   308	    fn rot_lerp(start: f32, end: f32, max_step: f32) -> f32 {
   309	        let mut diff = (end - start).rem_euclid(360.0);
   310	        if diff > 180.0 {
   311	            diff -= 360.0;
   312	        }
   313	        start + diff.clamp(-max_step, max_step)
   314	    }

   839	/// `AbstractHorse.setOffspringAttribute` (`AbstractHorse.java:835-840`).
   840	///
   841	/// Applied to a freshly spawned baby's attribute base value. `range_min`/`range_max` are the
   842	/// species' randomize-attribute bounds (the same bounds `generate_max_health`/`generate_speed`/
   843	/// `generate_jump_strength` roll within).
   844	pub fn apply_offspring_attribute(
   845	    baby: &dyn Mob,
   846	    attribute: &'static pumpkin_data::attributes::Attributes,
   847	    parent_a_value: f64,
   848	    parent_b_value: f64,
   849	    range_min: f64,
   850	    range_max: f64,
   851	    random: &mut impl RngExt,
   852	) {
   853	    let new_value =
   854	        create_offspring_attribute(parent_a_value, parent_b_value, range_min, range_max, random);
   855	    let mut attributes = baby
   856	        .get_mob_entity()
   857	        .living_entity
   858	        .attributes
   859	        .write()
   860	        .unwrap();
   861	    if let Some(a) = attributes.get_mut(&attribute.id) {
   862	        a.base_value = new_value;
   863	        a.dirty.store(true, Relaxed);
   864	    }
   865	}

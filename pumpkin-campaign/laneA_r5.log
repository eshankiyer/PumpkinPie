   242	   @Override
   243	   public boolean hurtServer(final ServerLevel level, final DamageSource source, final float damage) {
   244	      if (this.hasBodyItem()) {
   245	         if (this.canExplode() && !this.isPrimed()) {
   246	            Entity sourceEntity = source.getDirectEntity();
   247	            if (source.is(DamageTypeTags.IS_FIRE) || sourceEntity instanceof AbstractArrow projectile && projectile.isOnFire()) {
   248	               this.primeTime(false);
   249	            } else if (source.is(DamageTypeTags.IS_EXPLOSION)) {
   250	               this.primeTime(true);
   250	               this.primeTime(true);
   251	            }
   252	         }
   253	
   254	         if (source.is(DamageTypeTags.SULFUR_CUBE_WITH_BLOCK_IMMUNE_TO)) {
   255	            if (!source.is(DamageTypeTags.NO_KNOCKBACK)) {
   256	               this.dealDefaultKnockback(source, damage, true);
   257	            }
   258	
   259	            return true;
   260	         }
   261	      }
   262	
   263	      return super.hurtServer(level, source, damage);
   264	   }

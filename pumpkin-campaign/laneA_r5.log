   751	   @Override
   752	   protected Vec3 getRiddenInput(final Player controller, final Vec3 selfInput) {
   753	      if (this.onGround() && this.playerJumpPendingScale == 0.0F && this.isStanding() && !this.allowStandSliding) {
   754	         return Vec3.ZERO;
   755	      }
   756	
   757	      float sideways = controller.xxa * 0.5F;
   758	      float forward = controller.zza;
   759	      if (forward <= 0.0F) {
   760	         forward *= 0.25F;
   761	      }
   762	
   763	      return new Vec3(sideways, 0.0, forward);

   272	      BlockPos corner2 = new BlockPos(pos.getX() + 80, this.level.getMaxY(), pos.getZ() + 80);
   273	      Stream<BlockPos> relatedCorners = this.getRelatedCorners(corner1, corner2);
   274	      return calculateEnclosingBoundingBox(pos, relatedCorners).filter(bb -> {
   275	         int deltaX = bb.maxX() - bb.minX();
   276	         int deltaY = bb.maxY() - bb.minY();

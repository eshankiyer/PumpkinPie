   317	    /// primed (`isPrimed`, always false here since the archetype/explosion system is
   318	    /// deferred).
   319	    fn get_split_count(&self) -> i32 {
   320	        Self::split_count_for_fuse(self.fuse.load(Ordering::Relaxed))
   321	    }

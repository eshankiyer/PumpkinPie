   361	impl NBTStorage for SulfurCubeEntity {
   362	    fn write_nbt<'a>(&'a self, nbt: &'a mut NbtCompound) -> NbtFuture<'a, ()> {
   363	        Box::pin(async move {
   364	            self.entity.living_entity.write_nbt(nbt).await;
   365	            nbt.put_int("Size", self.get_size() - 1);
   366	            nbt.put_bool("wasOnGround", self.was_on_ground.load(Ordering::Relaxed));
   367	            self.write_ageable_nbt(nbt);
   368	            nbt.put_int("pickup_timer", self.pickup_timer.load(Ordering::Relaxed));
   369	            nbt.put_bool("from_bucket", self.from_bucket.load(Ordering::Relaxed));
   370	            nbt.put_int("fuse", self.fuse.load(Ordering::Relaxed));
   371	        })
   372	    }
   373	
   374	    fn read_nbt_non_mut<'a>(&'a self, nbt: &'a NbtCompound) -> NbtFuture<'a, ()> {
   375	        Box::pin(async move {
   376	            self.entity.living_entity.read_nbt_non_mut(nbt).await;
   377	            self.set_size(nbt.get_int("Size").unwrap_or(0) + 1, false);
   378	            self.was_on_ground.store(
   379	                nbt.get_bool("wasOnGround").unwrap_or(false),
   380	                Ordering::Relaxed,
   381	            );
   382	            self.read_ageable_nbt(nbt);
   383	            self.pickup_timer
   384	                .store(nbt.get_int("pickup_timer").unwrap_or(0), Ordering::Relaxed);
   385	            self.from_bucket.store(
   386	                nbt.get_bool("from_bucket").unwrap_or(false),
   387	                Ordering::Relaxed,
   388	            );
   389	            self.fuse
   390	                .store(nbt.get_int("fuse").unwrap_or(-1), Ordering::Relaxed);
   391	        })
   392	    }
   393	}

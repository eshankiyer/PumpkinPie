   290	
   291	   private void tickFuse() {
   292	      if (this.fuse > 0) {
   293	         this.fuse--;
   294	      }
   295	
   296	      if (!this.explosionData.isEmpty()) {
   297	         if (this.fuse == 0) {
   298	            this.dropLeash();
   299	            this.dead = true;
   300	            if (this.level() instanceof ServerLevel level) {
   301	               if (level.getGameRules().get(GameRules.TNT_EXPLODES)) {
   302	                  Level.ExplosionInteraction explosionInteraction = level.getGameRules().get(GameRules.MOB_GRIEFING)
   303	                     ? Level.ExplosionInteraction.TNT
   304	                     : Level.ExplosionInteraction.NONE;
   305	                  level.explode(
   306	                     this,
   307	                     Explosion.getDefaultDamageSource(this.level(), this),
   308	                     this.getPortalCooldown() > 0 ? PrimedTnt.USED_PORTAL_DAMAGE_CALCULATOR : null,
   309	                     this.getX(),
   310	                     this.getY(0.0625),
   311	                     this.getZ(),
   312	                     this.explosionData.get().power(),
   313	                     this.explosionData.get().causesFire(),
   314	                     explosionInteraction
   315	                  );
   316	               }
   317	
   318	               this.triggerOnDeathMobEffects(level, Entity.RemovalReason.KILLED);
   319	            }
   320	
   321	            this.discard();
   322	         }
   323	      }
   324	   }

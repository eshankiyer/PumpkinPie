   643	         BlockPos probePos = this.blockPosition();
   644	         int brightestLight = Integer.MIN_VALUE;
   645	
   646	         for (BlockPos pos : BlockPos.betweenClosed(BlockPos.containing(box.minX, box.minY, box.minZ), BlockPos.containing(box.maxX, box.maxY, box.maxZ))) {
   647	            int blockBrightness = Math.max(this.level().getBrightness(LightLayer.BLOCK, pos), this.level().getBrightness(LightLayer.SKY, pos));
   648	            if (blockBrightness == 15) {
   649	               return Vec3.atCenterOf(pos);
   650	            }
   651	
   652	            if (blockBrightness > brightestLight) {
   653	               brightestLight = blockBrightness;
   654	               probePos = pos.immutable();
   655	            }
   656	         }
   657	
   658	         return Vec3.atCenterOf(probePos);
   659	      } else {
   660	         return super.getLightProbePosition(partialTickTime);
   661	      }
   662	   }

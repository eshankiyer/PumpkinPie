   401	        1.0
   402	    }
   403	
   404	    /// `set_size` runs from `new` and from NBT load, both before the entity has any viewers,
   405	    /// so its broadcast reaches nobody. This is the first point at which nearby players
   406	    /// exist. Chains the baby flag from `Mob`'s default so overriding does not drop it.
   407	    fn mob_init_data_tracker(&self) -> crate::entity::EntityBaseFuture<'_, ()> {
   408	        Box::pin(async move {
   409	            self.send_size_meta_data(self.get_size());
   410	            if self.is_baby() {
   411	                self.entity.living_entity.entity.send_meta_data(
   412	                    &[Metadata::new(tracked_data::sulfur_cube::BABY_ID, true)],
   413	                    None,
   414	                );
   415	            }
   416	        })
   417	    }
   418	
   419	    fn mob_tick<'a>(
   420	        &'a self,
   421	        _caller: &'a Arc<dyn EntityBase>,
   422	    ) -> crate::entity::EntityBaseFuture<'a, ()> {
   423	        Box::pin(async move {
   424	            let was_baby = self.is_baby();
   425	            self.ageable_ai_step();
   426	            if was_baby && !self.is_baby() {
   427	                self.age_boundary_reached();
   428	            }
   429	
   430	            self.o_squish.store(self.squish.load());
   431	            self.squish
   432	                .store(self.squish.load() + (self.target_squish.load() - self.squish.load()) * 0.5);
   433	
   434	            if self.pickup_timer.load(Ordering::Relaxed) > 0 {
   435	                self.pickup_timer.fetch_sub(1, Ordering::Relaxed);
   436	            }
   437	
   438	            let on_ground = self
   439	                .entity
   440	                .living_entity
   441	                .entity
   442	                .on_ground
   443	                .load(Ordering::Relaxed);
   444	            let was_on_ground = self.was_on_ground.load(Ordering::Relaxed);
   445	
   446	            if on_ground && !was_on_ground {
   447	                let world = self.entity.living_entity.entity.world.load();
   448	                world.play_sound_fine(
   449	                    self.get_squish_sound(),
   450	                    SoundCategory::Neutral,
   451	                    &self.entity.living_entity.entity.pos.load(),
   452	                    self.get_sound_volume(),
   453	                    ((rand::random_range(0.0..1.0) - rand::random_range(0.0..1.0)) * 0.2 + 1.0)
   454	                        / 0.8,
   455	                );
   456	
   457	                self.target_squish.store(-0.5);
   458	            } else if !on_ground && was_on_ground {
   459	                self.target_squish.store(1.0);
   460	            }
   461	
   462	            self.was_on_ground.store(on_ground, Ordering::Relaxed);
   463	            self.target_squish.store(self.target_squish.load() * 0.6);
   464	            self.speed_modifier.store(0.0);
   465	        })
   466	    }

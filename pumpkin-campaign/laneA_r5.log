   155	   private int propagateIncreases() {
   156	      int count;
   157	      for (count = 0; !this.increaseQueue.isEmpty(); count++) {
   158	         long fromNode = this.increaseQueue.dequeueLong();
   159	         long increaseData = this.increaseQueue.dequeueLong();
   160	         int fromLevel = this.storage.getStoredLevel(fromNode);
   161	         int fromTargetLevel = LightEngine.QueueEntry.getFromLevel(increaseData);
   162	         if (LightEngine.QueueEntry.isIncreaseFromEmission(increaseData) && fromLevel < fromTargetLevel) {
   163	            this.storage.setStoredLevel(fromNode, fromTargetLevel);
   164	            fromLevel = fromTargetLevel;
   165	         }
   166	
   167	         if (fromLevel == fromTargetLevel) {
   168	            this.propagateIncrease(fromNode, increaseData, fromLevel);
   169	         }
   170	      }
   171	
   172	      return count;
   173	   }

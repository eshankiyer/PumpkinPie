   457	            let entity = self.get_entity();
   458	            if entity.is_removed() {
   459	                return false;
   460	            }
   461	
   462	            let world = entity.world.load();
   463	
   464	            let mob_griefing_gamerule = {
   465	                let game_rules = &world.level_info.load().game_rules;
   466	                game_rules.mob_griefing
   467	            };
   468	
   469	            if !mob_griefing_gamerule && source.is_some_and(|source| source.get_player().is_none())
   470	            {
   471	                return false;
   472	            }
   473	
   474	            let bypasses_invulnerability =
   475	                damage_type == DamageType::OUT_OF_WORLD || damage_type == DamageType::GENERIC_KILL;
   476	
   477	            if bypasses_invulnerability {
   478	                entity.kill(caller).await;
   479	                return false;
   480	            }
   481	
   482	            if entity.is_invulnerable_to(&damage_type).await
   483	                || self.is_invisible()
   484	                || self.is_marker()
   485	            {
   486	                return false;
   487	            }
   488	
   489	            let is_explosion = damage_type == DamageType::FIREWORKS
   490	                || damage_type == DamageType::EXPLOSION
   491	                || damage_type == DamageType::PLAYER_EXPLOSION
   492	                || damage_type == DamageType::BAD_RESPAWN_POINT;
   493	
   494	            if is_explosion {
   495	                self.break_and_drop_items().await;
   496	                entity.kill(caller).await;
   497	                return false;
   498	            }
   499	
   500	            // Vanilla ignites instead of damaging; no health field exists here to chip
   501	            // for the already-on-fire case, so that sub-case is a no-op.
   502	            if damage_type.has_tag(&tag::DamageType::MINECRAFT_IGNITES_ARMOR_STANDS) {
   503	                entity.set_on_fire_for(5.0);
   504	                return false;
   505	            }
   506	
   507	            if damage_type.has_tag(&tag::DamageType::MINECRAFT_BURNS_ARMOR_STANDS) {
   508	                return false;
   509	            }
   510	
   511	            let can_break = damage_type == DamageType::PLAYER_EXPLOSION
   512	                || damage_type == DamageType::PLAYER_ATTACK
   513	                || damage_type == DamageType::SPEAR
   514	                || damage_type == DamageType::MACE_SMASH;
   515	
   516	            let always_kills = damage_type == DamageType::ARROW
   517	                || damage_type == DamageType::TRIDENT
   518	                || damage_type == DamageType::FIREBALL
   519	                || damage_type == DamageType::WITHER_SKULL
   520	                || damage_type == DamageType::WIND_CHARGE;
   521	
   522	            if !can_break && !always_kills {
   523	                return false;
   524	            }
   525	
   526	            let attacker = cause.or(source);
   527	            if let Some(attacker) = attacker
   528	                && let Some(player) = attacker.get_player()
   529	            {
   530	                if !player.abilities.lock().await.allow_modify_world {

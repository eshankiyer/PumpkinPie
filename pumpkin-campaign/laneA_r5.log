   204	    }
   205	
   206	    /// SulfurCube.java:493-522 (`equipItem`).
   207	    async fn equip_item(&self, item_stack: &ItemStack) -> bool {
   208	        if self.is_baby() {
   209	            return false;
   210	        }
   211	
   212	        let equipment = self.entity.living_entity.entity_equipment.clone();
   213	        let body_stack = equipment.lock().await.get(&EquipmentSlot::BODY);
   214	        if !body_stack.is_empty() && body_stack.item.id == item_stack.item.id {
   215	            return false;
   216	        }
   217	
   218	        let previous = {
   219	            let mut equipment = equipment.lock().await;
   220	            equipment.put(&EquipmentSlot::BODY, item_stack.copy_with_count(1))
   221	        };
   222	
   223	        if !previous.is_empty() {
   224	            let entity = &self.entity.living_entity.entity;
   225	            let world = entity.world.load();
   226	            world.drop_stack(&entity.block_pos.load(), previous).await;
   227	        }
   228	
   229	        let new_body = equipment.lock().await.get(&EquipmentSlot::BODY);
   230	        self.entity
   231	            .living_entity
   232	            .send_equipment_changes(&[(EquipmentSlot::BODY, new_body)]);
   233	
   234	        self.play_sound(Sound::EntitySulfurCubeAbsorb);
   235	        true
   236	    }
   237	
   238	    /// SulfurCube.java:607-614 (`shear`).
   239	    async fn shear(&self) {
   240	        let equipment = self.entity.living_entity.entity_equipment.clone();
   241	        let ejected = {
   242	            let mut equipment = equipment.lock().await;
   243	            equipment.put(&EquipmentSlot::BODY, ItemStack::EMPTY.clone())
   244	        };
   245	
   246	        if ejected.is_empty() {
   247	            return;
   248	        }
   249	
   250	        let entity = &self.entity.living_entity.entity;
   251	        let world = entity.world.load();
   252	        world.drop_stack(&entity.block_pos.load(), ejected).await;
   253	
   254	        self.entity
   255	            .living_entity
   256	            .send_equipment_changes(&[(EquipmentSlot::BODY, ItemStack::EMPTY.clone())]);
   257	
   258	        self.play_sound(Sound::EntitySulfurCubeEject);
   259	        self.pickup_timer.store(100, Ordering::Relaxed);
   260	    }
   260	    }

   771	   protected void executeRidersJump(final float amount, final Vec3 input) {
   772	      double impulse = this.getJumpPower(amount);
   773	      Vec3 movement = this.getDeltaMovement();
   774	      this.setDeltaMovement(movement.x, impulse, movement.z);
   775	      this.needsSync = true;
   776	      if (input.z > 0.0) {
   777	         float sin = Mth.sin(this.getYRot() * (float) (Math.PI / 180.0));
   778	         float cos = Mth.cos(this.getYRot() * (float) (Math.PI / 180.0));
   779	         this.setDeltaMovement(this.getDeltaMovement().add(-0.4F * sin * amount, 0.0, 0.4F * cos * amount));
   780	      }
   781	   }

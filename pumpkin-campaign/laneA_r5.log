   223	        let rotation = match self.rotation.lock().await.as_str() {
   224	            "CLOCKWISE_90" => Rotation::Clockwise90,
   225	            "CLOCKWISE_180" => Rotation::Rotate180,
   226	            "COUNTERCLOCKWISE_90" => Rotation::CounterClockwise90,
   227	            _ => Rotation::None,
   228	        };

   491	   public BoundingBoxRenderable.RenderableBox getRenderableBox() {
   492	      BlockPos pos = this.getStructurePos();
   493	      Vec3i size = this.getStructureSize();
   494	      int xOrigin = pos.getX();
   495	      int zOrigin = pos.getZ();
   496	      int y0 = pos.getY();
   497	      int y1 = y0 + size.getY();
   498	      int xDiff;
   499	      int zDiff;
   500	      switch (this.mirror) {
   501	         case LEFT_RIGHT:
   502	            xDiff = size.getX();
   503	            zDiff = -size.getZ();
   504	            break;
   505	         case FRONT_BACK:
   506	            xDiff = -size.getX();
   507	            zDiff = size.getZ();
   508	            break;
   509	         default:
   510	            xDiff = size.getX();
   511	            zDiff = size.getZ();
   512	      }
   513	
   514	      int x0;
   515	      int z0;
   516	      int x1;
   517	      int z1;
   518	      switch (this.rotation) {
   519	         case CLOCKWISE_90:
   520	            x0 = zDiff < 0 ? xOrigin : xOrigin + 1;
   521	            z0 = xDiff < 0 ? zOrigin + 1 : zOrigin;
   522	            x1 = x0 - zDiff;
   523	            z1 = z0 + xDiff;
   524	            break;
   525	         case CLOCKWISE_180:
   526	            x0 = xDiff < 0 ? xOrigin : xOrigin + 1;
   527	            z0 = zDiff < 0 ? zOrigin : zOrigin + 1;
   528	            x1 = x0 - xDiff;
   529	            z1 = z0 - zDiff;
   530	            break;
   531	         case COUNTERCLOCKWISE_90:
   532	            x0 = zDiff < 0 ? xOrigin + 1 : xOrigin;
   533	            z0 = xDiff < 0 ? zOrigin : zOrigin + 1;
   534	            x1 = x0 + zDiff;
   535	            z1 = z0 - xDiff;
   536	            break;
   537	         default:
   538	            x0 = xDiff < 0 ? xOrigin + 1 : xOrigin;
   539	            z0 = zDiff < 0 ? zOrigin + 1 : zOrigin;
   540	            x1 = x0 + xDiff;
   541	            z1 = z0 + zDiff;
   542	      }
   543	
   544	      return BoundingBoxRenderable.RenderableBox.fromCorners(x0, y0, z0, x1, y1, z1);
   545	   }

   377	
   378	   public void processStructureBoundary(final Consumer<BlockPos> action) {
   379	      AABB bounds = this.getStructureBounds();
   380	      boolean hasCeiling = !this.getTestHolder().map(h -> h.value().skyAccess()).orElse(false);
   381	      BlockPos low = BlockPos.containing(bounds.minX, bounds.minY, bounds.minZ).offset(-1, -1, -1);
   382	      BlockPos high = BlockPos.containing(bounds.maxX, bounds.maxY, bounds.maxZ);
   383	      BlockPos.betweenClosedStream(low, high)
   384	         .forEach(
   385	            blockPos -> {
   386	               boolean isNonCeilingEdge = blockPos.getX() == low.getX()
   387	                  || blockPos.getX() == high.getX()
   388	                  || blockPos.getZ() == low.getZ()
   389	                  || blockPos.getZ() == high.getZ()
   390	                  || blockPos.getY() == low.getY();
   391	               boolean isCeiling = blockPos.getY() == high.getY();
   392	               if (isNonCeilingEdge || isCeiling && hasCeiling) {
   393	                  action.accept(blockPos);
   394	               }
   395	            }
   396	         );
   397	   }

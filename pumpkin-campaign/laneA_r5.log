   565	    /// `AbstractHorse.doPlayerRide`, using `Entity::add_passenger` the same way
   566	    /// `HappyGhastEntity::try_mount` does (see that file for the established mounting pattern).
   567	    fn do_player_ride<'a>(&'a self, player: &'a Arc<Player>) -> EntityBaseFuture<'a, ()> {
   568	        Box::pin(async move {
   569	            self.horse_data().set_flag(FLAG_EATING, false);
   570	            self.clear_standing();
   571	
   572	            if !player.get_entity().can_start_riding().await {
   573	                return;
   574	            }
   575	
   576	            let entity = self.get_entity();
   577	            let world = entity.world.load();
   578	            let Some(passenger) = world.get_player_by_id(player.entity_id()) else {
   579	                return;
   580	            };
   581	            let Some(vehicle) = world.get_entity_by_id(entity.entity_id) else {
   582	                return;
   583	            };
   584	            entity
   585	                .add_passenger(vehicle, passenger as Arc<dyn EntityBase>)
   586	                .await;
   587	        })
   588	    }

    92	                Box::new(SulfurCubeSearchForItemsGoal::new(mob_arc.clone())),
    93	            );
    94	            goal_selector.add_goal(
    95	                4,
    96	                Box::new(SulfurCubeRandomDirectionGoal::new(mob_arc.clone())),
    97	            );
    98	            goal_selector.add_goal(
    99	                5,
   100	                Box::new(SulfurCubeKeepOnJumpingGoal::new(mob_arc.clone())),
   101	            );
   102	        };
   103	
   104	        mob_arc.set_size(2, true);
   105	
   106	        mob_arc
   107	    }
   108	
   109	    pub fn set_size(&self, size: i32, update_health: bool) {
   110	        let actual_size = size.clamp(1, 127);
   111	        let entity = &self.entity.living_entity.entity;
   112	        let size_changed = entity.data.swap(actual_size, Ordering::Relaxed) != actual_size;
   113	
   114	        let living_entity = &self.entity.living_entity;
   115	        living_entity.set_attribute_base(
   116	            &Attributes::MAX_HEALTH,
   117	            f64::from(Self::max_health_for_size(actual_size)),
   118	        );
   119	        living_entity.set_attribute_base(
   120	            &Attributes::MOVEMENT_SPEED,
   121	            f64::from(0.2 + 0.1 * actual_size as f32),
   122	        );
   123	
   124	        if update_health {
   125	            let max_health = living_entity.get_attribute_value(&Attributes::MAX_HEALTH) as f32;
   126	            living_entity.health.store(max_health);
   127	        }
   128	
   129	        let scaled_dimensions = EntityDimensions {
   130	            width: entity.entity_type.dimension[0] * actual_size as f32,
   131	            height: entity.entity_type.dimension[1] * actual_size as f32,
   132	            eye_height: entity.entity_type.eye_height * actual_size as f32,
   133	            fixed: false,
   134	        };
   135	        entity.base_dimension.store(scaled_dimensions);
   136	        entity.entity_dimension.store(scaled_dimensions);
   137	
   138	        let pos = entity.pos.load();
   139	        let new_bb = BoundingBox::new_from_pos(pos.x, pos.y, pos.z, &scaled_dimensions);
   140	        entity.bounding_box.store(new_bb);
   141	
   142	        // SulfurCube.java:678-683 (setSize): shrinking to size 1 forces the baby flag.
   143	        if update_health && actual_size == 1 && !self.is_baby() {
   144	            self.set_baby(true);
   145	        }
   146	
   147	        // Vanilla `AbstractCubeMob.setSize` writes the size into synched entity data, which
   148	        // only broadcasts when the value actually changed. Without this the client keeps the
   149	        // default size of 1 and renders/collides at the wrong scale.
   150	        if size_changed {
   151	            self.send_size_meta_data(actual_size);
   152	        }
   153	    }
   154	
   155	    /// Broadcasts the cube-scoped size tracker. Split out so `mob_init_data_tracker` can
   156	    /// publish the size at spawn time, when `set_size` ran before the entity had any viewers.
   157	    fn send_size_meta_data(&self, size: i32) {
   158	        self.entity.living_entity.entity.send_meta_data(
   159	            &[Metadata::new(
   160	                tracked_data::sulfur_cube::ID_SIZE,
   161	                VarInt(size),
   162	            )],
   163	            None,
   164	        );
   165	    }

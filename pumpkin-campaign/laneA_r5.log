   109	    /// Finds the lowest direct-sky source in a column, matching
   110	    /// `ChunkSkyLightSources.findLowestSourceY`. A source begins immediately
   111	    /// above the first opaque or shape-occluded vertical edge.
   112	    fn lowest_sky_source_y(
   113	        level: &Arc<Level>,
   114	        pos: &BlockPos,
   115	        replacement: Option<(&BlockPos, &'static pumpkin_data::BlockState)>,
   116	    ) -> i32 {
   117	        let world_gen = level.world_gen.load();
   118	        let dimension = world_gen.dimension();
   119	        let min_y = dimension.min_y;
   120	        let max_y = min_y + dimension.height;
   121	        let mut top_state = Block::AIR.default_state;
   122	        let mut top_y = max_y;
   123	
   124	        for y in (min_y..max_y).rev() {
   125	            let current_pos = BlockPos::new(pos.0.x, y, pos.0.z);
   126	            let state = replacement
   127	                .filter(|(replacement_pos, _)| **replacement_pos == current_pos)
   128	                .map_or_else(
   129	                    || Self::state_for_lighting(level, &current_pos),
   130	                    |(_, replacement_state)| replacement_state,
   131	                );
   132	
   133	            if state.opacity != 0
   134	                || pumpkin_data::light_shape_occludes(top_state, state, BlockDirection::Down)
   135	            {
   136	                return top_y;
   137	            }
   138	
   139	            top_state = state;
   140	            top_y = y;
   141	        }
   142	
   143	        // No edge was occluded: every block in the world is a direct-sky
   144	        // source, just as ChunkSkyLightSources represents this below-world
   145	        // sentinel.
   146	        min_y - 1
   147	    }

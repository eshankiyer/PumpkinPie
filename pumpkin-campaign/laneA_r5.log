   576	   @Override
   577	   public void tick() {
   578	      super.tick();
   579	      if (this.mouthCounter > 0 && ++this.mouthCounter > 30) {
   580	         this.mouthCounter = 0;
   581	         this.setFlag(64, false);
   582	      }
   583	
   584	      if (this.standCounter > 0 && --this.standCounter <= 0) {
   585	         this.clearStanding();
   586	      }
   587	
   588	      if (this.tailCounter > 0 && ++this.tailCounter > 8) {
   589	         this.tailCounter = 0;
   590	      }
   591	
   592	      if (this.sprintCounter > 0) {
   593	         this.sprintCounter++;
   594	         if (this.sprintCounter > 300) {
   595	            this.sprintCounter = 0;
   596	         }
   597	      }
   598	
   599	      this.eatAnimO = this.eatAnim;
   600	      if (this.isEating()) {
   601	         this.eatAnim = this.eatAnim + ((1.0F - this.eatAnim) * 0.4F + 0.05F);
   602	         if (this.eatAnim > 1.0F) {
   603	            this.eatAnim = 1.0F;
   604	         }
   605	      } else {
   606	         this.eatAnim = this.eatAnim + ((0.0F - this.eatAnim) * 0.4F - 0.05F);
   607	         if (this.eatAnim < 0.0F) {
   608	            this.eatAnim = 0.0F;
   609	         }
   610	      }
   611	
   612	      this.standAnimO = this.standAnim;
   613	      if (this.isStanding()) {
   614	         this.eatAnim = 0.0F;
   615	         this.eatAnimO = this.eatAnim;
   616	         this.standAnim = this.standAnim + ((1.0F - this.standAnim) * 0.4F + 0.05F);
   617	         if (this.standAnim > 1.0F) {
   618	            this.standAnim = 1.0F;
   619	         }
   620	      } else {
   621	         this.allowStandSliding = false;
   622	         this.standAnim = this.standAnim + ((0.8F * this.standAnim * this.standAnim * this.standAnim - this.standAnim) * 0.6F - 0.05F);
   623	         if (this.standAnim < 0.0F) {
   624	            this.standAnim = 0.0F;
   625	         }
   626	      }
   627	
   628	      this.mouthAnimO = this.mouthAnim;
   629	      if (this.getFlag(64)) {
   630	         this.mouthAnim = this.mouthAnim + ((1.0F - this.mouthAnim) * 0.7F + 0.05F);
   631	         if (this.mouthAnim > 1.0F) {
   632	            this.mouthAnim = 1.0F;
   633	         }
   634	      } else {
   635	         this.mouthAnim = this.mouthAnim + ((0.0F - this.mouthAnim) * 0.7F - 0.05F);
   636	         if (this.mouthAnim < 0.0F) {
   637	            this.mouthAnim = 0.0F;
   638	         }
   639	      }
   640	   }

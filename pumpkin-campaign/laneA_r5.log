   423	                // We must check up to the highest neighbor to catch the "air sources"
   424	                // `source_y` is a boundary, not an inclusive block coordinate.
   425	                // Keep the scan half-open so a source at `max_y` never causes
   426	                // a probe or enqueue outside the generation height limit.
   427	                let max_check_y = top_y
   428	                    .max(north_top)
   429	                    .max(south_top)
   430	                    .max(west_top)
   431	                    .max(east_top)
   432	                    .saturating_add(1)
   433	                    .min(max_y);
   434	
   435	                if max_check_y < bottom_y {
   436	                    continue;
   437	                }
   438	
   439	                for y in (bottom_y..max_check_y).rev() {
   440	                    let pos = BlockPos(Vector3::new(x, y, z));
   441	                    let light = get_sky_light(cache, pos);
   442	
   443	                    // Use continue, or only break if we are safely below all possible side-light
   444	                    if light == 0 {
   445	                        if y <= top_y {
   446	                            break;
   447	                        }
   448	                        continue;
   449	                    }
   450	
   451	                    let is_at_surface = y == top_y;
   452	                    let below_neighbor =
   453	                        y < north_top || y < south_top || y < west_top || y < east_top;
   454	
   455	                    if (is_at_surface || below_neighbor) && self.visited.insert(pos) {
   456	                        self.queue.push_back(PropagationEntry { pos });
   457	                    }
   458	                }
   459	            }
   460	        }
   461	
   462	        //let propagate_start = Instant::now();
   463	
   464	        self.propagate(cache);
   465	
   466	        //let propagate_elapsed = propagate_start.elapsed();
   467	        //let scan_elapsed = scan_start.elapsed();
   468	        //log::info!("Sky light timing - Scan: {:?}, Propagate: {:?}", scan_elapsed, propagate_elapsed);
   469	    }

   121	    ///
   122	    /// # Arguments
   123	    ///
   124	    /// * `reader`: The [`StringReader`] to use while parsing the entity selector.
   125	    /// * `allow_selectors`: Whether to allow selector variables (like `@s` or `@p`).
   126	    pub fn new(reader: &'b mut StringReader<'a>, allow_selectors: bool) -> Self {
   127	        Self {
   128	            reader,
   129	            max_selected: 0,
   130	            distance: None,
   131	            experience_level: None,
   132	            pos: Vector3::default(),
   133	            delta: Vector3::default(),
   134	            rotation: Vector2::default(),
   135	            predicates: vec![],
   136	            order: Order::Arbitrary,
   137	            player_name: None,
   138	            entity_uuid: None,
   139	            entity_type: None,
   140	            start_position: 0,
   141	            allows_selector_variable: allow_selectors,
   142	            uses_selector_variable: false,
   143	            includes_entities: false,
   144	            is_current_entity: false,
   145	            flags: Flags::empty(),
   146	            suggestions: EntitySelectorParserSuggestions::Nothing,
   147	        }
   148	    }
   149	
   150	    fn selector(mut self) -> EntitySelector {
   151	        // We finalize our predicates.
   152	        if let Some(x) = self.rotation.x {
   153	            self.predicates
   154	                .push(EntitySelectorPredicate::Rotation(x, RotationType::Yaw));
   155	        }
   156	        if let Some(y) = self.rotation.y {
   157	            self.predicates
   158	                .push(EntitySelectorPredicate::Rotation(y, RotationType::Pitch));
   159	        }
   160	        if let Some(level) = self.experience_level {
   161	            self.predicates
   162	                .push(EntitySelectorPredicate::ExperienceLevel(level));
   163	        }
   164	
   165	        let bounding_box =
   166	            if self.delta.x.is_none() && self.delta.y.is_none() && self.delta.z.is_none() {
   167	                if let Some(distance) = self.distance
   168	                    && let Some(max) = distance.max()
   169	                {
   170	                    Some(BoundingBox::new(
   171	                        Vector3::new(-max, -max, -max),
   172	                        Vector3::new(max + 1.0, max + 1.0, max + 1.0),
   173	                    ))
   174	                } else {
   175	                    None
   176	                }
   177	            } else {
   178	                Some(Self::create_bounding_box(Vector3::new(
   179	                    self.delta.x.unwrap_or(0.0),
   180	                    self.delta.y.unwrap_or(0.0),
   181	                    self.delta.z.unwrap_or(0.0),
   182	                )))
   183	            };
   184	
   185	        let position_function =
   186	            if self.pos.x.is_none() && self.pos.y.is_none() && self.pos.z.is_none() {
   187	                PositionFunction::Identity
   188	            } else {
   189	                PositionFunction::OverrideWithParser(self.pos)
   190	            };
   191	
   192	        EntitySelector {
   193	            max_selected: self.max_selected,
   194	            includes_entities: self.includes_entities,
   195	            predicates: self.predicates,
   196	            distance: self.distance,
   197	            position_function,
   198	            bounding_box,
   199	            order: self.order,
   200	            is_current_entity: self.is_current_entity,
   201	            player_name: self.player_name,
   202	            entity_uuid: self.entity_uuid,
   203	            entity_type: self.entity_type,
   204	            uses_selector_variable: self.uses_selector_variable,
   205	            is_world_limited: self.flags.contains(Flags::WORLD_LIMITED),
   206	        }
   207	    }
   208	
   209	    fn create_bounding_box(pos: Vector3<f64>) -> BoundingBox {
   210	        BoundingBox::new(
   211	            Vector3::new(pos.x.min(0.0), pos.y.min(0.0), pos.z.min(0.0)),
   212	            Vector3::new(
   213	                pos.x.max(0.0) + 1.0,
   214	                pos.y.max(0.0) + 1.0,
   215	                pos.z.max(0.0) + 1.0,
   216	            ),
   217	        )
   218	    }

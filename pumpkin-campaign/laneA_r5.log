   322	    /// Finds an empty hotbar slot to swap an item to.
   323	    ///
   324	    /// First looks for empty slots, then slots without enchantments, and finally
   325	    /// falls back to the currently selected slot.
   326	    ///
   327	    /// Vanilla: `Inventory.getSuitableHotbarSlot` (Inventory.java:162-178).
   328	    async fn get_swappable_hotbar_slot(&self) -> usize {
   329	        let inv = self.main_inventory.read().await;
   330	        let selected_slot = self.get_selected_slot() as usize;
   331	        for i in 0..Self::HOTBAR_SIZE {
   332	            let check_index = (i + selected_slot) % Self::HOTBAR_SIZE;
   333	            if inv[check_index].is_empty() {
   334	                return check_index;
   335	            }
   336	        }
   337	
   338	        // Second vanilla pass (Inventory.java:170-175): when the whole hotbar is
   339	        // occupied, prefer replacing a non-enchanted item over the selected one.
   340	        for i in 0..Self::HOTBAR_SIZE {
   341	            let check_index = (i + selected_slot) % Self::HOTBAR_SIZE;
   342	            if !inv[check_index].has_enchantments() {
   343	                return check_index;
   344	            }
   345	        }
   346	
   347	        selected_slot
   348	    }
   349	
   350	    /// Swaps an item stack with an item on the hotbar.
   351	    ///
   352	    /// Finds an empty hotbar slot and places the stack there.
   353	    pub async fn swap_stack_with_hotbar(&self, stack: ItemStack) {
   354	        let swappable = self.get_swappable_hotbar_slot().await;
   355	        self.set_selected_slot(swappable as u8);
   356	        let selected = self.get_selected_slot() as usize;
   357	        let mut inv = self.main_inventory.write().await;
   358	
   359	        if let Some(empty_slot) = inv.iter().position(ItemStack::is_empty)
   360	            && !inv[selected].is_empty()
   361	        {
   362	            inv[empty_slot] = inv[selected].clone();
   363	        }
   364	
   365	        inv[selected] = stack;
   366	    }

   212	      int toAdd = Math.min(count, maxToAdd);
   213	      if (toAdd == 0) {
   214	         return count;
   215	      }
   216	
   217	      count -= toAdd;
   218	      itemStackInSlot.grow(toAdd);
   219	      itemStackInSlot.setPopTime(5);
   220	      return count;
   221	   }

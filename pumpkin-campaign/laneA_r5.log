   291	   private Stream<BlockPos> getRelatedCorners(final BlockPos corner1, final BlockPos corner2) {
   292	      return BlockPos.betweenClosedStream(corner1, corner2)
   293	         .filter(pos -> this.level.getBlockState(pos).is(Blocks.STRUCTURE_BLOCK))
   294	         .map(this.level::getBlockEntity)
   295	         .filter(e -> e instanceof StructureBlockEntity)
   296	         .map(e -> (StructureBlockEntity)e)
   297	         .filter(input -> input.mode == StructureMode.CORNER && Objects.equals(this.structureName, input.structureName))
   298	         .map(BlockEntity::getBlockPos);
   299	   }

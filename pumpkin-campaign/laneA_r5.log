   186	   @Override
   187	   public InteractionResult interact(final Player player, final InteractionHand hand, final Vec3 location) {
   188	      ItemStack itemStack = player.getItemInHand(hand);
   189	      if (this.isMarker() || itemStack.is(Items.NAME_TAG)) {
   190	         return super.interact(player, hand, location);
   191	      }
   192	
   193	      if (player.isSpectator()) {
   194	         return InteractionResult.SUCCESS;
   195	      }
   196	
   197	      if (player.level().isClientSide()) {
   198	         return InteractionResult.SUCCESS_SERVER;
   199	      }
   200	
   201	      EquipmentSlot itemInHandSlot = this.getEquipmentSlotForItem(itemStack);
   202	      if (itemStack.isEmpty()) {
   203	         EquipmentSlot clickedSlot = this.getClickedSlot(location);
   204	         EquipmentSlot targetSlot = this.isDisabled(clickedSlot) ? itemInHandSlot : clickedSlot;
   205	         if (this.hasItemInSlot(targetSlot) && this.swapItem(player, targetSlot, itemStack, hand)) {
   206	            return InteractionResult.SUCCESS_SERVER;
   207	         }
   208	      } else {
   209	         if (this.isDisabled(itemInHandSlot)) {
   210	            return InteractionResult.FAIL;
   210	            return InteractionResult.FAIL;
   211	         }
   212	
   213	         if (itemInHandSlot.getType() == EquipmentSlot.Type.HAND && !this.showArms()) {
   214	            return InteractionResult.FAIL;
   215	         }
   216	
   217	         if (this.swapItem(player, itemInHandSlot, itemStack, hand)) {
   218	            return InteractionResult.SUCCESS_SERVER;
   219	         }
   220	      }
   221	
   222	      return super.interact(player, hand, location);
   223	   }
   224	
   225	   private EquipmentSlot getClickedSlot(final Vec3 location) {
   226	      EquipmentSlot slotClicked = EquipmentSlot.MAINHAND;
   227	      boolean small = this.isSmall();
   228	      double clickYPosition = location.y / (this.getScale() * this.getAgeScale());
   229	      EquipmentSlot feet = EquipmentSlot.FEET;
   230	      if (clickYPosition >= 0.1 && clickYPosition < 0.1 + (small ? 0.8 : 0.45) && this.hasItemInSlot(feet)) {
   231	         slotClicked = EquipmentSlot.FEET;
   232	      } else if (clickYPosition >= 0.9 + (small ? 0.3 : 0.0) && clickYPosition < 0.9 + (small ? 1.0 : 0.7) && this.hasItemInSlot(EquipmentSlot.CHEST)) {
   233	         slotClicked = EquipmentSlot.CHEST;
   234	      } else if (clickYPosition >= 0.4 && clickYPosition < 0.4 + (small ? 1.0 : 0.8) && this.hasItemInSlot(EquipmentSlot.LEGS)) {
   235	         slotClicked = EquipmentSlot.LEGS;
   236	      } else if (clickYPosition >= 1.6 && this.hasItemInSlot(EquipmentSlot.HEAD)) {
   237	         slotClicked = EquipmentSlot.HEAD;
   238	      } else if (!this.hasItemInSlot(EquipmentSlot.MAINHAND) && this.hasItemInSlot(EquipmentSlot.OFFHAND)) {
   239	         slotClicked = EquipmentSlot.OFFHAND;
   240	      }
   241	
   242	      return slotClicked;
   243	   }
   244	
   245	   private boolean isDisabled(final EquipmentSlot slot) {
   246	      return (this.disabledSlots & 1 << slot.getFilterBit(0)) != 0 || slot.getType() == EquipmentSlot.Type.HAND && !this.showArms();
   247	   }
   248	
   249	   private boolean swapItem(final Player player, final EquipmentSlot slot, final ItemStack playerItemStack, final InteractionHand hand) {
   250	      ItemStack itemStack = this.getItemBySlot(slot);
   251	      if (!itemStack.isEmpty() && (this.disabledSlots & 1 << slot.getFilterBit(8)) != 0) {
   252	         return false;
   253	      }
   254	
   255	      if (itemStack.isEmpty() && (this.disabledSlots & 1 << slot.getFilterBit(16)) != 0) {
   256	         return false;
   257	      }
   258	
   259	      if (player.hasInfiniteMaterials() && itemStack.isEmpty() && !playerItemStack.isEmpty()) {
   260	         this.setItemSlot(slot, playerItemStack.copyWithCount(1));
   261	         return true;
   262	      }
   263	
   264	      if (playerItemStack.isEmpty() || playerItemStack.getCount() <= 1) {
   265	         this.setItemSlot(slot, playerItemStack);
   266	         player.setItemInHand(hand, itemStack);
   267	         return true;
   268	      }
   269	
   270	      if (!itemStack.isEmpty()) {
   271	         return false;
   272	      }
   273	
   274	      this.setItemSlot(slot, playerItemStack.split(1));
   275	      return true;
   276	   }

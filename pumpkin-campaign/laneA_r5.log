   295	/// `AbstractHorse.createOffspringAttribute`.
   296	#[must_use]
   297	pub fn create_offspring_attribute(
   298	    parent_a: f64,
   299	    parent_b: f64,
   300	    range_min: f64,
   301	    range_max: f64,
   302	    random: &mut impl RngExt,
   303	) -> f64 {
   304	    assert!(range_max > range_min, "Incorrect range for an attribute");
   305	
   306	    let a = parent_a.clamp(range_min, range_max);
   307	    let b = parent_b.clamp(range_min, range_max);
   308	    let margin = 0.15 * (range_max - range_min);
   309	    let range = (a - b).abs() + margin * 2.0;
   310	    let average = f64::midpoint(a, b);
   311	    let quality = (random.random_range(0.0..1.0)
   312	        + random.random_range(0.0..1.0)
   313	        + random.random_range(0.0..1.0))
   314	        / 3.0
   315	        - 0.5;
   316	    let value = average + range * quality;
   317	
   318	    if value > range_max {
   319	        range_max - (value - range_max)
   320	    } else if value < range_min {
   321	        range_min + (range_min - value)
   322	    } else {
   323	        value
   324	    }
   325	}

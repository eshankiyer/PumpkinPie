    87	    /// Fast non-blocking check if the main inventory contains a given item.
    88	    pub fn contains_item(&self, item: &'static Item) -> bool {
    89	        if let Ok(inv) = self.main_inventory.try_read() {
    90	            for stack in inv.iter() {
    91	                if !stack.is_empty() && stack.get_item().id == item.id {
    92	                    return true;
    93	                }
    94	            }
    95	        }
    96	        false
    97	    }

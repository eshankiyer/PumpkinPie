   592	                    .expect("test chunk must parse");
   593	                chunks.push(Chunk::Proto(Box::new(ProtoChunk::from_chunk_data(
   594	                    &chunk_data,
   595	                    &world_gen,
   596	                ))));
   597	            }
   598	        }
   599	
   600	        Cache {
   601	            x: -1,
   602	            z: -1,
   603	            size: 3,
   604	            chunks,
   605	        }
   606	    }

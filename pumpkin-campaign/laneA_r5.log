    93	            goal_selector.add_goal(4, Box::new(FollowParentGoal::new(1.0)));
    94	            goal_selector.add_goal(6, Box::new(WanderAroundGoal::new_water_avoiding(0.7)));
    95	            goal_selector.add_goal(
    96	                7,
    97	                LookAtEntityGoal::with_default(mob_weak, &EntityType::PLAYER, 6.0),
    98	            );
    99	            goal_selector.add_goal(8, Box::new(RandomLookAroundGoal::default()));
   100	            goal_selector.add_goal(9, AmbientStandGoal::new(horse_weak));
   101	        };

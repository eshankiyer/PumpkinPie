    83	
    84	            // `AbstractHorse.java:134-151` (`registerGoals`/`addBehaviourGoals`, base
    85	            // `addBehaviourGoals` applies to Horse/Donkey/Mule): 0 float, 1 run-around-like-crazy
    86	            // (and, at the same priority, 1 panic-when-ridden deferred, no rider-tracking
    87	            // infra), 2 breed, 3 tempt, 4 follow parent, 6 water-avoiding wander, 7 look at
    88	            // player, 8 random look around, 9 random stand.
    89	            goal_selector.add_goal(0, Box::new(SwimGoal::default()));
    90	            goal_selector.add_goal(1, RunAroundLikeCrazyGoal::new(horse_weak.clone(), 1.2));

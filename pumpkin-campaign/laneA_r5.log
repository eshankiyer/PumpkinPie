  1036	            light_engine
  1037	                .block_light
  1038	                .get(section_idx)?
  1039	                .get(
  1040	                    relative.x as usize,
  1041	                    (relative.y - chunk.section.min_y) as usize % 16,
  1042	                    relative.z as usize,
  1043	                )

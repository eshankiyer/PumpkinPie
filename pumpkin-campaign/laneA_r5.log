   475	/// Splits a structure name into `(namespace, path)`, defaulting the namespace to `minecraft`
   476	/// (matching `Identifier`'s default namespace), and rejects anything that isn't safe to join
   477	/// into a filesystem path - both segments restricted to the resource-location charset
   478	/// (`[a-z0-9_.-]` for namespace, additionally `/` for path), no empty segments, and no `..`
   479	/// path component. Mirrors the intent of vanilla's `FileUtil.validatePath`, called from
   480	/// `TemplatePathFactory.createAndValidatePathToStructure`.
   481	fn split_structure_identifier(name: &str) -> Option<(String, String)> {
   482	    let (namespace, path) = name.strip_prefix("minecraft:").map_or_else(
   483	        || name.split_once(':').unwrap_or(("minecraft", name)),
   484	        |rest| ("minecraft", rest),
   485	    );
   486	
   487	    let valid_namespace_char =
   488	        |c: char| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '.' || c == '-';
   489	    let valid_path_char = |c: char| valid_namespace_char(c) || c == '/';
   490	
   491	    if namespace.is_empty() || !namespace.chars().all(valid_namespace_char) {
   492	        return None;
   493	    }
   494	    if path.is_empty() || !path.chars().all(valid_path_char) {
   495	        return None;
   496	    }
   497	    if path
   498	        .split('/')
   499	        .any(|segment| segment.is_empty() || segment == "..")
   500	    {
   501	        return None;
   502	    }
   503	
   504	    Some((namespace.to_string(), path.to_string()))
   505	}

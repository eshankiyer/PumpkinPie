   770	   private Vec2 applyHorizontalHitAngleScale(
   771	      final float horizontalAngleScale, final Vec2 originalAngle, final Vec3 attackerPosition, final Vec3 attackerAimDirection, final Vec3 targetCenter
   772	   ) {
   773	      Vec3 attackerToTarget = targetCenter.subtract(attackerPosition).normalize();
   774	      float angleDiff = (float)Math.atan2(
   775	         attackerAimDirection.x * attackerToTarget.z - attackerAimDirection.z * attackerToTarget.x,
   776	         attackerAimDirection.x * attackerToTarget.x + attackerAimDirection.z * attackerToTarget.z
   777	      );
   778	      return originalAngle.rotate(angleDiff * horizontalAngleScale);
   779	   }
   780	
   781	   private Vec2 applyVerticalHitAnglePowerTransfer(
   782	      final float verticalHitAngleScale,
   783	      final float horizontalPower,
   784	      final float verticalPower,
   785	      final Vec3 attackerPosition,
   786	      final Vec3 attackerAimDirection,
   787	      final Vec3 targetCenteredPosition,
   788	      final float targetHeight
   789	   ) {
   790	      float targetHalfHeight = 0.5F * targetHeight;
   791	      Vec3 targetTopPos = targetCenteredPosition.add(0.0, targetHalfHeight, 0.0);
   792	      Vec3 tagetBottomPos = targetCenteredPosition.add(0.0, -targetHalfHeight, 0.0);
   793	      Vec3 attackerToTargetTop = targetTopPos.subtract(attackerPosition).normalize();
   794	      Vec3 attackerToTargetBottom = tagetBottomPos.subtract(attackerPosition).normalize();
   795	      float verticalHitAngleFactor = (float)Mth.clampedMap(attackerAimDirection.y, attackerToTargetTop.y, attackerToTargetBottom.y, -1.0, 1.0);
   796	      float transferredPowerRatio = Math.abs(verticalHitAngleFactor * verticalHitAngleScale);
   797	      if (verticalHitAngleFactor < 0.0F) {
   798	         transferredPowerRatio = -transferredPowerRatio;
   799	      }
   800	
   801	      float px = horizontalPower * (1.0F - transferredPowerRatio);
   802	      float py = verticalPower * (1.0F + transferredPowerRatio);
   803	      return new Vec2(px, py);
   804	   }
   805	
   806	   private Vec2 applyVerticalPositionAnglePowerRotation(
   807	      final float verticalPositionAngleScale,
   808	      final float horizontalPower,
   809	      final float verticalPower,
   810	      final float originalHorizontalPower,
   811	      final float originalVerticalPower,
   812	      final Vec3 attackerFeetPosition,
   813	      final Vec3 targetFeetPosition
   814	   ) {
   815	      Vec3 attackerFeetToTargetFeet = targetFeetPosition.subtract(attackerFeetPosition);
   816	      float verticalPositionAngle = (float)Math.atan2(-attackerFeetToTargetFeet.y, attackerFeetToTargetFeet.horizontalDistance());
   817	      Vec2 powerBeforeRotation = new Vec2(horizontalPower, verticalPower);
   818	      Vec2 rotatedPower = powerBeforeRotation.rotate(-verticalPositionAngle * verticalPositionAngleScale);
   819	      float horizontalRatio = originalHorizontalPower > 0.0F ? Mth.abs(rotatedPower.x) / originalHorizontalPower : 0.0F;
   820	      float verticalRatio = originalVerticalPower > 0.0F ? Mth.abs(rotatedPower.y) / originalVerticalPower : 0.0F;
   821	      float maxRatio = Math.max(horizontalRatio, verticalRatio);
   822	      if (maxRatio > 1.0F) {
   823	         rotatedPower = rotatedPower.scale(1.0F / maxRatio);
   824	      }
   825	
   826	      return rotatedPower;
   827	   }

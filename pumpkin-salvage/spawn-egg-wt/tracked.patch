+    /// `Bee.isHiveValid`: the remembered position must still resolve to a beehive block entity
+    /// and remain within vanilla's 48-block limit.
+    fn is_hive_valid(&self, world: &World) -> bool {
+        let Some(hive_pos) = self.hive_pos.load() else {
+            return false;
+        };
+        let bee_pos = self.mob_entity.living_entity.entity.block_pos.load();
+        let dx = i64::from(hive_pos.0.x - bee_pos.0.x);
+        let dy = i64::from(hive_pos.0.y - bee_pos.0.y);
+        let dz = i64::from(hive_pos.0.z - bee_pos.0.z);
+        if dx * dx + dy * dy + dz * dz >= 48 * 48 {
+            return false;
+        }
+        world
+            .get_block_entity(&hive_pos)
+            .is_some_and(|entity| entity.as_any().is::<BeehiveBlockEntity>())
+    }
+
+    fn increment_crops_grown_since_pollination(&self) {
+        self.crops_grown_since_pollination.fetch_add(1, Relaxed);

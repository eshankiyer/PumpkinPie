+/// `Bee.BeeGrowCropGoal`.
+pub struct BeeGrowCropGoal {
+    bee: Weak<BeeEntity>,
+}
+
+impl BeeGrowCropGoal {
+    #[must_use]
+    pub const fn new(bee: Weak<BeeEntity>) -> Self {
+        Self { bee }
+    }
+
+    fn can_grow(block: &Block, state: &BlockState) -> Option<pumpkin_data::BlockStateId> {
+        if !block.has_tag(&tag::Block::MINECRAFT_BEE_GROWABLES) {
+            return None;
+        }
+
+        if block.id == Block::CAVE_VINES.id {
+            return None;
+        }
+        if block.id == Block::CAVE_VINES_PLANT.id {
+            let props = block.properties(state.id)?.to_props();
+            if props
+                .iter()
+                .any(|(name, value)| *name == "berries" && *value == "true")
+            {
+                return None;
+            }
+            let new_props: Vec<(&str, &str)> = props
+                .iter()
+                .map(|(name, value)| {
+                    if *name == "berries" {
+                        (*name, "true")
+                    } else {
+                        (*name, *value)
+                    }
+                })
+                .collect();
+            return Some(block.from_properties(&new_props).to_state_id(block));
+        }
+
+        let props = block.properties(state.id)?.to_props();
+        let age = props
+            .iter()
+            .find(|(name, _)| *name == "age")
+            .and_then(|(_, value)| value.parse::<u8>().ok())?;
+        if block.id == Block::PITCHER_CROP.id {
+            return None;
+        }
+        let max_age = match block.id {
+            id if id == Block::BEETROOTS.id || id == Block::SWEET_BERRY_BUSH.id => 3,
+            id if id == Block::TORCHFLOWER_CROP.id => 1,
+            _ => 7,
+        };
+        if age >= max_age {
+            return None;
+        }
+
+        let next_age = (age + 1).to_string();
+        let new_props: Vec<(&str, &str)> = props
+            .iter()
+            .map(|(name, value)| {
+                if *name == "age" {
+                    (*name, next_age.as_str())
+                } else {
+                    (*name, *value)
+                }
+            })
+            .collect();
+        Some(block.from_properties(&new_props).to_state_id(block))
+    }
+}
+
+impl Goal for BeeGrowCropGoal {
+    fn can_start<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
+        Box::pin(async move {
+            let Some(bee) = self.bee.upgrade() else {
+                return false;
+            };
+            if bee.persistent_anger.is_angry()
+                || bee.crops_grown_since_pollination.load(Relaxed) >= 10
+                || mob.get_random().random::<f32>() < 0.3
+            {
+                return false;
+            }
+            bee.has_nectar() && bee.is_hive_valid(&mob.get_entity().world.load())
+        })
+    }
+
+    fn should_continue<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, bool> {
+        self.can_start(mob)
+    }
+
+    fn tick<'a>(&'a mut self, mob: &'a dyn Mob) -> GoalFuture<'a, ()> {
+        Box::pin(async move {
+            let Some(bee) = self.bee.upgrade() else {
+                return;
+            };
+            if mob.get_random().random_range(0..30) != 0 {
+                return;
+            }
+
+            let world = mob.get_entity().world.load_full();
+            let origin = mob.get_entity().block_pos.load();
+            for distance in 1..=2 {
+                let target = BlockPos::new(origin.0.x, origin.0.y - distance, origin.0.z);
+                let (block, state) = world.get_block_and_state_id(&target);
+                let state = BlockState::from_id(state);
+                let Some(new_state_id) = Self::can_grow(block, &state) else {
+                    continue;
+                };
+
+                if block.id == Block::CAVE_VINES_PLANT.id {
+                    world
+                        .set_block_state(&target, new_state_id, BlockFlags::NOTIFY_LISTENERS)
+                        .await;
+                }
+                world.broadcast_to_chunk(
+                    target.chunk_position(),
+                    &CWorldEvent::new(2011, target, 15, false),
+                );
+                world
+                    .set_block_state(&target, new_state_id, BlockFlags::NOTIFY_ALL)
+                    .await;
+                bee.increment_crops_grown_since_pollination();
+            }
+        })
+    }
+
+    fn should_run_every_tick(&self) -> bool {
+        true
+    }
+
+    fn controls(&self) -> Controls {
+        Controls::MOVE
+    }
+}

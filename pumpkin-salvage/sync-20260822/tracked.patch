 impl JavaClient {
     pub fn handle_set_game_rule(&self, player: &Player, packet: &SSetGameRule<'_>) {
         if player.permission_lvl.load() < PermissionLvl::Two {
+            warn!(
+                "Player {} tried to set game rules without required permissions",
+                player.gameprofile.name
+            );

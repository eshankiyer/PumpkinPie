From bb52fe4eb0617b919ebcda0ade64f5184a7566ae Mon Sep 17 00:00:00 2001
From: "Eshan I." <79593316+eshankiyer@users.noreply.github.com>
Date: Fri, 31 Jul 2026 13:20:53 -0400
Subject: [PATCH] fix(crafting): preserve decorated pot decorations

---
 pumpkin-codegen/src/item.rs                   | 20 ++++++-
 pumpkin-data/src/data_component_impl/basic.rs | 26 ++++++++-
 pumpkin-data/src/data_component_impl/mod.rs   |  1 +
 pumpkin-data/src/generated/item.rs            | 12 ++++-
 .../src/crafting/crafting_screen_handler.rs   | 54 ++++++++++++++++++-
 5 files changed, 107 insertions(+), 6 deletions(-)

diff --git a/pumpkin-codegen/src/item.rs b/pumpkin-codegen/src/item.rs
index eab3964..fc445b6 100644
--- a/pumpkin-codegen/src/item.rs
+++ b/pumpkin-codegen/src/item.rs
@@ -817,8 +817,24 @@ impl ToTokens for ItemComponents {
         if self.piercing_weapon.is_some() {
             tokens.extend(quote! { (PiercingWeapon, &PiercingWeaponImpl), });
         }
-        if self.pot_decorations.is_some() {
-            tokens.extend(quote! { (PotDecorations, &PotDecorationsImpl), });
+        if let Some(decorations) = &self.pot_decorations
+            && let Some(decorations) = decorations.as_array()
+            && decorations.len() == 4
+        {
+            let decorations = decorations
+                .iter()
+                .map(|decoration| decoration.as_str())
+                .collect::<Option<Vec<_>>>();
+            if let Some(decorations) = decorations {
+                let decorations = decorations
+                    .iter()
+                    .map(|decoration| LitStr::new(decoration, Span::call_site()));
+                tokens.extend(quote! {
+                    (PotDecorations, &PotDecorationsImpl {
+                        decorations: [#(Cow::Borrowed(#decorations)),*],
+                    }),
+                });
+            }
         }
         if self.potion_contents.is_some() {
             tokens.extend(quote! {
diff --git a/pumpkin-data/src/data_component_impl/basic.rs b/pumpkin-data/src/data_component_impl/basic.rs
index 1cceb55..aa24024 100644
--- a/pumpkin-data/src/data_component_impl/basic.rs
+++ b/pumpkin-data/src/data_component_impl/basic.rs
@@ -225,8 +225,32 @@ impl DataComponentImpl for BannerPatternsImpl {
 }
 
 #[derive(Clone, Debug, Hash, PartialEq, Eq)]
-pub struct PotDecorationsImpl;
+pub struct PotDecorationsImpl {
+    pub decorations: [Cow<'static, str>; 4],
+}
+impl PotDecorationsImpl {
+    pub fn read_data(data: &NbtTag) -> Option<Self> {
+        let decorations = data.extract_list()?;
+        let decorations: Vec<_> = decorations
+            .iter()
+            .map(|tag| {
+                tag.extract_string()
+                    .map(|value| Cow::Owned(value.to_string()))
+            })
+            .collect::<Option<_>>()?;
+        let decorations = decorations.try_into().ok()?;
+        Some(Self { decorations })
+    }
+}
 impl DataComponentImpl for PotDecorationsImpl {
+    fn write_data(&self) -> NbtTag {
+        NbtTag::List(
+            self.decorations
+                .iter()
+                .map(|decoration| NbtTag::String(decoration.to_string().into_boxed_str()))
+                .collect(),
+        )
+    }
     default_impl!(PotDecorations);
 }
 

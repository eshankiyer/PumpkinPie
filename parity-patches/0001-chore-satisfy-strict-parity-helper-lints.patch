From 7e687069ab67583ef748e767393c520b0478058d Mon Sep 17 00:00:00 2001
From: "Eshan I." <79593316+eshankiyer@users.noreply.github.com>
Date: Fri, 31 Jul 2026 11:44:03 -0400
Subject: [PATCH] chore: satisfy strict parity helper lints

---
 pumpkin/src/entity/area_effect_cloud.rs | 4 ++--
 pumpkin/src/entity/living.rs            | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/pumpkin/src/entity/area_effect_cloud.rs b/pumpkin/src/entity/area_effect_cloud.rs
index 987c744..20de6ab 100644
--- a/pumpkin/src/entity/area_effect_cloud.rs
+++ b/pumpkin/src/entity/area_effect_cloud.rs
@@ -18,7 +18,7 @@ struct ParticleMeta<'a> {
     data: &'a [u8],
 }
 
-fn application_scale(_distance: f64, _radius: f64) -> f32 {
+const fn application_scale(_distance: f64, _radius: f64) -> f32 {
     1.0
 }
 
@@ -325,7 +325,7 @@ impl EntityBase for AreaEffectCloudEntity {
 
                 {
                     let reapplication_map = self.reapplication_map.lock().await;
-                    if !can_reapply(&*reapplication_map, ent_id) {
+                    if !can_reapply(&reapplication_map, ent_id) {
                         continue;
                     }
                 }
diff --git a/pumpkin/src/entity/living.rs b/pumpkin/src/entity/living.rs
index f7ac73f..59405b4 100644
--- a/pumpkin/src/entity/living.rs
+++ b/pumpkin/src/entity/living.rs
@@ -2810,7 +2810,7 @@ impl EntityBase for LivingEntity {
     }
 }
 
-fn should_replace_effect(current: &Effect, candidate: &Effect) -> bool {
+const fn should_replace_effect(current: &Effect, candidate: &Effect) -> bool {
     candidate.amplifier > current.amplifier
         || (candidate.amplifier == current.amplifier && candidate.duration > current.duration)
 }
-- 
